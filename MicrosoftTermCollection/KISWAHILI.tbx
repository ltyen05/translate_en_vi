ipe it quickly, lifting your finger off the screen, in the direction you want.</descrip></descripGrp><ntig><termGrp><term id="1808999">flick</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2020724">papaso</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33697_1808999_2120701"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To put your finger on a touchscreen and then swipe it quickly, lifting your finger off the screen, in the direction you want.</descrip></descripGrp><ntig><termGrp><term id="1808999">flick</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2120701">papasa</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33700_1809907_2062517"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Skype feature that allows users to call directly from Skype to landlines and mobile phones.</descrip></descripGrp><ntig><termGrp><term id="1809907">call phones</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2062517">piga simu</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammatic