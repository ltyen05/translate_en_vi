43000"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A technology that allows for the installation and use of multiple user-interface languages.</descrip></descripGrp><ntig><termGrp><term id="1598626">Multilingual User Interface</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1643000">kiolesura cha Mtumiaji cha Lugha anuwai</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31309_1598627_1642754"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A UI element that enables users to locate and select files.</descrip></descripGrp><ntig><termGrp><term id="1598627">file picker</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1642754">kitwaa faili</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3131_12131_533012"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The &lt;&gt; characters.</descrip></descripGrp><ntig><termGrp><term id="12131">angle brackets</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="533012">vibano pembe</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammati