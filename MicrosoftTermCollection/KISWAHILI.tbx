</termEntry><termEntry id="3305_203182_2184315"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The video format with the same resolution as traditional television.</descrip></descripGrp><ntig><termGrp><term id="203182">SD</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2184315">SD</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33075_1749609_2738171"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A computer that enables internal users to share audio and video data with external users.</descrip></descripGrp><ntig><termGrp><term id="1749609">A/V Edge server</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2738171">Seva ya A/V Edge</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33083_1754526_1758502"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The automatic display of photos in Windows Photos in a grid-like pattern based on metadata from the photos that are connected to the user's account.</descrip></descripGrp><ntig><termGrp><term id="1754526">photo mix</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1758502">mchanganyiko wa picha</term><termNote type="geographicalUsage">KEN, TZA</