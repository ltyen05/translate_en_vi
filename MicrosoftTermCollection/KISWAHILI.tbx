to click on an embedded image to see any of the following: a high resolution version of it, a link to where the image was found, as well as related images.</descrip></descripGrp><ntig><termGrp><term id="2244846">Detail view</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2262663">Mwonekano wa maelezo</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38604_2244850_2351038"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The button on the Sway home page that allows the user to begin using sway.</descrip></descripGrp><ntig><termGrp><term id="2244850">Get Started!</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2351038">Anzilishi!</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38605_2244852_2262657"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Sway button that allows users to create a bulleted list out of their text.</descrip></descripGrp><ntig><termGrp><term id="2244852">Bulleted list</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2262657">Orodha ya matobo</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</term