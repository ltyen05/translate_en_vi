14_139328_533869"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Web Storage System content class defines the intent or purpose of an item along with the names of properties that are intended for items in this class.</descrip></descripGrp><ntig><termGrp><term id="139328">content class</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="533869">Mfumo wavu maudhui</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5115_334561_2118826"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The status notification that the device is in the process of dialing a phone number.</descrip></descripGrp><ntig><termGrp><term id="334561">Dialing</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2118826">Inapigaji simu</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5117_262544_1389485"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A visual effect that imparts a quality of translucency to windows.</descrip></descripGrp><ntig><termGrp><term id="262544">glass</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1389485">kioo cha dirisha</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote ty