term id="2325079">Kichujio cha Haraka</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39856_2312654_2360956"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Outlook feature that allows users to sort and display email based on predefined criteria.</descrip></descripGrp><ntig><termGrp><term id="2312654">Quick Filter</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2360956">Vichujio vya Haraka kwa orodha ya ujumbe</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39856_2357846_2325079"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Outlook feature that allows users to sort and display email based on predefined criteria.</descrip></descripGrp><ntig><termGrp><term id="2357846">Quick Filters for message list</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2325079">Kichujio cha Haraka</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39856_2357846_2360956"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Outlook feature that allows users to sort and display email based on predefined criteria.</descrip></descripGrp><ntig><termGrp><term id="2357846">Quick Filters for message list</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2360956">Vichujio vya Haraka kwa orodha ya ujumbe</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39857_2312655_2325064"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Outlook feature that intelligently presorts email across all email accounts.</descrip></descripGrp><ntig><termGrp><term id="2312655">Focused Inbox</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2325064">Kisanduku pokezi Lengwa</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39858_2312656_2325069"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The menu selection that allows users to move emails from the focused inbox into the Other category.</descrip></descripGrp><ntig><termGrp><term id="2312656">Move to Non-Focused Inbox</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2325069">Sogeza hadi kwenye Kisanduku pokezi Kisicholengwa</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39864_2322624_2325958"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The wireless personal area network technology, launched in 2010 and marketed as Bluetooth Smart, used for transmitting data over distances as much as 100 meters. Cost and power consumption are low while maintaining a communication range similar to Bluetooth BR/EDR, the other widely-used version of Bluetooth</descrip></descripGrp><ntig><termGrp><term id="2322624">Bluetooth Smart</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2325958">Bluetooth Smart</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39866_2315181_2320916"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Bluetooth Low Energy device that sends static information, such as location or ID, to devices within its area.</descrip></descripGrp><ntig><termGrp><term id="2315181">beacon</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2320916">kioleza</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3987_141789_1918371"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A placeholder text that included the field character, field type, and instructions, and that that shows where specified information from a data source will appear such that the elements in a field that generate a field's result.</descrip></descripGrp><ntig><termGrp><term id="141789">field code</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1918371">msimbo wa uga</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39877_2315966_2320937"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature for maps of the interior of some public places, such as the businesses inside a mall, or the gates, businesses, and other services inside an airport.</descrip></descripGrp><ntig><termGrp><term id="2315966">venue map</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2320937">ramani ya ukumbi</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39878_2316274_2320938"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Of, pertaining to, or characteristic of apps or services made available in an enterprise to help with particular business and process needs.</descrip></descripGrp><ntig><termGrp><term id="2316274">line-of-business</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2320938">kitengo cha biashara</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39878_2316274_2320940"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Of, pertaining to, or characteristic of apps or services made available in an enterprise to help with particular business and process needs.</descrip></descripGrp><ntig><termGrp><term id="2316274">line-of-business</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2320940">Kitengo Cha Biashara</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39878_2316275_2320938"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Of, pertaining to, or characteristic of apps or services made available in an enterprise to help with particular business and process needs.</descrip></descripGrp><ntig><termGrp><term id="2316275">LOB</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2320938">kitengo cha biashara</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39878_2316275_2320940"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Of, pertaining to, or characteristic of apps or services made available in an enterprise to help with particular business and process needs.</descrip></descripGrp><ntig><termGrp><term id="2316275">LOB</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2320940">Kitengo Cha Biashara</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39880_2320100_2322375"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app for PC and Surface Hub that helps you connect a phone or PC to the Surface Hub display, or to another PC. On Surface Hub, it also allows you to switch between devices that are connected to the Surface Hub.​</descrip></descripGrp><ntig><termGrp><term id="2320100">Connect</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2322375">Unganisha</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39881_2320112_2322482"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mode in which the UI on the screen slides downward so that the user can reach items that normally would be near the top of the screen with one hand.</descrip></descripGrp><ntig><termGrp><term id="2320112">one-handed use</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2322482">kutumia mkono mmoja</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39882_2320437_2322381"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app for purchasing cellular data that is packaged with cellular enabled Dell devices that include a Microsoft SIM card.</descrip></descripGrp><ntig><termGrp><term id="2320437">Dell NetReady</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2322381">Dell NetReady</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39889_2321509_2329003"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The collection of TV shows that are in the top N% of ratings.</descrip></descripGrp><ntig><termGrp><term id="2321509">Top-rated TV shows</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2329003">Maonyesho ya TV yaliyokadiriwa bora</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39890_2321510_2322389"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The collection of items emphasized to the customer through placement on the site.</descrip></descripGrp><ntig><termGrp><term id="2321510">Featured collections</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2322389">Mikusanyiko iliyoangaziwa</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39891_2321511_2325276"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To make your search results more relevant by excluding unwanted and extraneous items.</descrip></descripGrp><ntig><termGrp><term id="2321511">refine</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2325276">safisha</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39892_2321518_2325275"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows customers to temporarily connect to available free Wi-Fi hotspots in order to find and buy Wi-Fi services from the Windows Store.</descrip></descripGrp><ntig><termGrp><term id="2321518">paid Wi-Fi services</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2325275">huduma zinazolipiwa za Wi-Fi</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39932_2323787_2334745"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To create a sway.</descrip></descripGrp><ntig><termGrp><term id="2323787">sway</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2334745">sway</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39933_2323799_2331048"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that lets users link their inbox for one email account with an inbox for another account, so they can see the messages from both accounts in a single place.</descrip></descripGrp><ntig><termGrp><term id="2323799">Linked Inboxes</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2331048">Vikasha Pokezi Vilivyounganishwa</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39934_2323812_2331047"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The OneNote toolbar designed to help individuals with learning differences or who are looking for literacy assistance.</descrip></descripGrp><ntig><termGrp><term id="2323812">Learning Tools for OneNote</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGr