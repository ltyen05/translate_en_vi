erm id="534826">wasilisha</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5071_119170_1399207"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A character used to align lines and columns on screen and in print. Although a tab is visually indistinguishable from a series of blank spaces in most programs, the tab character and the space character are different to a computer. A tab is a single character and therefore can be added, deleted, or overtyped with a single keystroke.</descrip></descripGrp><ntig><termGrp><term id="119170">tab character</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1399207">kibambo tabo</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5072_138277_1396811"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In a shared file, information that is maintained about changes made in past editing sessions. The information includes the name of the person who made each change, when the change was made, and what data was changed.</descrip></descripGrp><ntig><termGrp><term id="138277">change history</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1396811">historia ya mabadiliko</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5074_307449_1952979"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A normalized value assigned to an email message that indicates, based on the characteristics of the message, the likelihood that the message is spam and that is persisted with the message when the message is sent to other Exchange servers.</descrip></descripGrp><ntig><termGrp><term id="307449">spam confidence level</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1952979">SCL</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5074_307449_1952997"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A normalized value assigned to an email message that indicates, based on the characteristics of the message, the likelihood that the message is spam and that is persisted with the message when the message is sent to other Exchange servers.</descrip></descripGrp><ntig><termGrp><term id="307449">spam confidence level</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1952997">kiwango cha ujasiri cha barua taka</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5074_307468_1952979"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A normalized value assigned to an email message that indicates, based on the characteristics of the message, the likelihood that the message is spam and that is persisted with the message when the message is sent to other Exchange servers.</descrip></descripGrp><ntig><termGrp><term id="307468">SCL</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1952979">SCL</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5074_307468_1952997"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A normalized value assigned to an email message that indicates, based on the characteristics of the message, the likelihood that the message is spam and that is persisted with the message when the message is sent to other Exchange servers.</descrip></descripGrp><ntig><termGrp><term id="307468">SCL</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1952997">kiwango cha ujasiri cha barua taka</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5077_1546384_533585"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A portion of a software window bounded by and separated from other portions by vertical or horizontal bars and having a separate function.</descrip></descripGrp><ntig><termGrp><term id="1546384">window pane</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular<