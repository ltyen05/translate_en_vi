mber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20928_760019_1389055"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Automatic display adjustment that changes the brightness of your PC screen (laptop and desktop) using light environment information provided by the ambient light sensor.</descrip></descripGrp><ntig><termGrp><term id="760019">adaptive brightness</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1389055">uangavu wa kujitohoa</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20936_760098_2118875"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A radio navigation system developed by the U.S. Department of Defense that uses a constellation of 24 earth satellites, which are monitored by ground-based control stations, to provide precise, continuous worldwide positioning and timing information.</descrip></descripGrp><ntig><termGrp><term id="760098">Global Positioning System</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2118875">GPS</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20936_760099_2118875"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A radio navigation system developed by the U.S. Department of Defense that uses a constellation of 24 earth satellites,