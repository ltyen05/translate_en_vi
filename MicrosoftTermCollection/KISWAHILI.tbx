ry id="13372_413712_1389302"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A symbol that is displayed beside a paragraph in outline view. You can use the symbol to display or hide subordinate levels of text and to reorganize text quickly.</descrip></descripGrp><ntig><termGrp><term id="413712">outline symbol</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1389302">alama ya ufupisho</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13374_359204_1389423"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A complete Web site stored in a named subdirectory of the top-level Web site.</descrip></descripGrp><ntig><termGrp><term id="359204">subsite</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1389423">tovuti ya ndani</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13396_2037690_534480"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A proxy server installed by a trojan on a machine providing what appears to be an uninterrupted Internet connection while allowing unauthorized access to an affected machine.</descrip></descripGrp><ntig><termGrp><term id="2037690">trojan proxy server</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lan