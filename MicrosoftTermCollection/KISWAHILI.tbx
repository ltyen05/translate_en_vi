rs in a run have the same directional properties.</descrip></descripGrp><ntig><termGrp><term id="1508864">run</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1918849">endesha</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29481_1508936_1918850"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A reading order and alignment setting that is commonly used in controls that display text. When you select the Context setting, the reading order is determined by the first strong character (not a numeral or special character) that you type.</descrip></descripGrp><ntig><termGrp><term id="1508936">Context</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1918850">Muktadha</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29483_1508938_1918851"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In an outline, to change a heading to body text or to a lower heading level: for example, to change from Heading 5 to Heading 6.</descrip></descripGrp><ntig><termGrp><term id="1508938">demote</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1918851">shusha</term><termNote type="geographicalUsage">KEN, TZA</termNote><