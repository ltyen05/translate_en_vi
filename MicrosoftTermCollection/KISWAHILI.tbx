34029"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To go back to a previous state by reversing the effects of one or more commands.</descrip></descripGrp><ntig><termGrp><term id="168784">undo</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="534029">tendua</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5279_95225_1399102"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A sequence of 25 letters and numbers. To activate some software, you must enter a product key during the activation process.</descrip></descripGrp><ntig><termGrp><term id="95225">product key</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1399102">ufunguo bidhaa</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="528_67425_533414"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The location where the user is currently directing input.</descrip></descripGrp><ntig><termGrp><term id="67425">input focus</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="533414">mlengo ingizo</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</t