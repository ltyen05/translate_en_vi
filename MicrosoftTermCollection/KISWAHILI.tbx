Number">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49869_2819450_2822475"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Status of a Microsoft Managed Desktop device if it meets all of these criteria: synced with Intune in the last 5 days AND at least 6 hours powered on and connected to Internet AND at least 2 hours continuously powered on and connected to Internet.</descrip></descripGrp><ntig><termGrp><term id="2819450">active</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2822475">amilifu</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49870_2819451_2822480"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A minimum or starting point used for comparisons.</descrip></descripGrp><ntig><termGrp><term id="2819451">baseline</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2822480">mstari msingi</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49871_2819453_2822512"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A summary page in Microsoft 365 admin center showing all scores for your organization side by side.</descrip></descripGrp><ntig><termGrp><term id="2819453">score overview</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></n