nder">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13113_359266_1952996"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of moving an item to the Deleted Items folder.</descrip></descripGrp><ntig><termGrp><term id="359266">soft delete</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1952996">Futa polepole</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13121_359689_1389434"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A OneNote item that has been marked with a note tag.</descrip></descripGrp><ntig><termGrp><term id="359689">tagged note</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1389434">dokezo lenye tabo</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13142_111591_1399160"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A configuration parameter that controls the behavior of a service, application, feature, function, or a run-time environment.</descrip></descripGrp><ntig><termGrp><term id="111591">setting</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1399160">mpangilio</term><termNote t