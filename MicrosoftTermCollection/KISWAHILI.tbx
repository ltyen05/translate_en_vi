rip type="definition">A type of telephone number that is linked to a specific locality, such as with a country code.</descrip></descripGrp><ntig><termGrp><term id="2816516">geographic number</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2820613">nambari ya jiografia</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49802_2816517_2820605"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of backing up data to a remote, cloud-based server.</descrip></descripGrp><ntig><termGrp><term id="2816517">cloud backup</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2820605">chelezo ya wingu</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49803_2816518_2820606"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A service that backs up data to the cloud.</descrip></descripGrp><ntig><termGrp><term id="2816518">cloud backup service</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2820606">huduma ya chelezo ya wingu</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49804_2816519_2820607"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A connected experience that is optional, more precisely, it is not covered by the organization's license with Microsoft, but is instead licensed directly to the user.</descrip></descripGrp><ntig><termGrp><term id="2816519">cloud-backed service</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2820607">huduma iliyochelezwa kwa wingu</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49804_2816519_2820620"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A connected experience that is optional, more precisely, it is not covered by the organization's license with Microsoft, but is instead licensed directly to the user.</descrip></descripGrp><ntig><termGrp><term id="2816519">cloud-backed service</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2820620">tajiriba ya hiari iliyounganishwa</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49804_2816520_2820607"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A connected experience that is optional, more precisely, it is not covered by the organization's license with Microsoft, but is instead licensed directly to the user.</descrip></descripGrp><ntig><termGrp><term id="2816520">optional connected experience</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2820607">huduma iliyochelezwa kwa wingu</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49804_2816520_2820620"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A connected experience that is optional, more precisely, it is not covered by the organization's license with Microsoft, but is instead licensed directly to the user.</descrip></descripGrp><ntig><termGrp><term id="2816520">optional connected experience</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2820620">tajiriba ya hiari iliyounganishwa</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49805_2816521_2820616"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Measures of service quality of a network as seen by the customer.</descrip></descripGrp><ntig><termGrp><term id="2816521">network performance</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2820616">utendaji wa mtandao</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49806_2816522_2820601"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature of Microsoft Teams that assesses the Office 365 tenant environment and identifies the most common configurations that may need to be updated or modified, and creates a Service management team with channels for each workload.</descrip></descripGrp><ntig><termGrp><term id="2816522">Advisor for Teams</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2820601">Kishauri</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49806_2816522_2820603"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature of Microsoft Teams that assesses the Office 365 tenant environment and identifies the most common configurations that may need to be updated or modified, and creates a Service management team with channels for each workload.</descrip></descripGrp><ntig><termGrp><term id="2816522">Advisor for Teams</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2820603">Kishauri cha Teams</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49806_2816698_2820601"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature of Microsoft Teams that assesses the Office 365 tenant environment and identifies the most common configurations that may need to be updated or modified, and creates a Service management team with channels for each workload.</descrip></descripGrp><ntig><termGrp><term id="2816698">Advisor</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2820601">Kishauri</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49806_2816698_2820603"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature of Microsoft Teams that assesses the Office 365 tenant environment and identifies the most common configurations that may need to be updated or modified, and creates a Service management team with channels for each workload.</descrip></descripGrp><ntig><termGrp><term id="2816698">Advisor</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2820603">Kishauri cha Teams</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49808_2816676_2820627"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Microsoft Teams, as part of Teams rollout done with Advisor for Teams, a workload is a set of features and settings that is used to deploy a specific collection of functions. Workloads are comprised of channels to complete the deployment of the functions.</descrip></descripGrp><ntig><termGrp><term id="2816676">workload</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2820627">kazi</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49810_2816681_2820625"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To convert a phone number to a different format, by using a set of rules.</descrip></descripGrp><ntig><termGrp><term id="2816681">translate</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2820625">tafsiri</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49811_2816684_2820615"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In the Microsoft 365 Admin Center, a specific network architecture design change that is recommended to improve user experience related to network connectivity to Office 365.</descrip></descripGrp><ntig><termGrp><term id="2816684">network insight</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2820615">vilivyomo vya mtandao</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49812_2816685_2820617"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In the Microsoft 365 Admin Center, a score that shows how network connectivity impacts user experience allowing for comparison of different user location network connections.</descrip></descripGrp><ntig><termGrp><term id="2816685">network performance score</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2820617">alama ya utendaji wa mtandao</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49812_2816685_2820618"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In the Microsoft 365 Admin Center, a score that shows how network connectivity impacts user experience allowing for comparison of different user location network connections.</descrip></descripGrp><ntig><termGrp><term id="2816685">network performance score</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2820618">alama ya mtandao</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49812_2816686_2820617"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In the Microsoft 365 Admin Center, a score that shows how network connectivity impacts user experience allowing for comparison of different user location network connections.</descrip></descripGrp><ntig><termGrp><term id="2816686">network score</term><termNote type=