apisho la Jumla</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="47731_2685869_2688935"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To make the background obscure while the speaker's image remains clear during a video call or video meeting.</descrip></descripGrp><ntig><termGrp><term id="2685869">blur</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2688935">weka ukungu</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="47732_2685870_2688936"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A live-video effect that blurs a user's background and focuses only on his/her face.</descrip></descripGrp><ntig><termGrp><term id="2685870">background blur</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2688936">ukungu wa mandharinyuma</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4775_187907_1918449"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A character that is entered by pressing the SPACEBAR on the keyboard and that typically appears on the screen as a blank space.</descrip></descripGrp>