ig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2434707">sans serif</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4293_37521_533195"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The state of an expression or a variable (for example, when a result can be either true or false, or equal or not equal).</descrip></descripGrp><ntig><termGrp><term id="37521">condition</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="533195">sharti</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4296_309439_534564"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A World Wide Web version of Windows Client Help.</descrip></descripGrp><ntig><termGrp><term id="309439">Windows Assistance Online</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="534564">Msaada wa Mtandaoni wa Windows</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4296_309439_534565"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A World Wide Web version of Windows Client Help.</descrip></descripGrp><ntig><termGrp><term id="309439">Windows