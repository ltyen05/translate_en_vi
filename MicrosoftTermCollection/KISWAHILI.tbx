re.</descrip></descripGrp><ntig><termGrp><term id="2842119">CME</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2844976">Uondoaji Ulioratibiwa wa Programu-hasidi</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50256_2842122_2842662"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An industry group where technology companies with mature security response processes come together to solve cross-industry problems and advance security across the ecosystem. (Microsoft was a founding member.)</descrip></descripGrp><ntig><termGrp><term id="2842122">Industry Consortium for the Advancement of Security on the Internet</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2842662">Industry Consortium for the Advancement of Security on the Internet</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50268_2843747_2846645"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Zero Trust access policy that limits user access with Just-In-Time and Just-Enough Access (JIT/JEA) risk-based adaptive polices and data protection to protect both data and productivity</descrip></descripGrp><ntig><termGrp><term id="2843747">least privileged access</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2846645">ufikiaji kidogo wa faida</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50269_2843748_2846631"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A special telephone number used for participating in conference calls.</descrip></descripGrp><ntig><termGrp><term id="2843748">dial-in number</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2846631">nambari maalum ya kupiga</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50269_2844095_2846631"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A special telephone number used for participating in conference calls.</descrip></descripGrp><ntig><termGrp><term id="2844095">dial in number</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2846631">nambari maalum ya kupiga</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50270_2843760_2846667"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The overall security status of an enterprise’s software and hardware, networks, services, and information.</descrip></descripGrp><ntig><termGrp><term id="2843760">security posture</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2846667">mkao wa usalama</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50273_2843779_2846602"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A class of security tools that assures a continuous process of cloud security improvement and adaptation to reduce the likelihood of a successful attack, including use cases for compliance monitoring, DevOps integration, incident response, risk assessment, and risk visualization.</descrip></descripGrp><ntig><termGrp><term id="2843779">cloud security posture management</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2846602">usimamiaji wa mkao wa usalama wa wingu</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50273_2843779_2846620"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A class of security tools that assures a continuous process of cloud security improvement and adaptation to reduce the likelihood of a successful attack, including use cases for compliance monitoring, DevOps integration, incident response, risk assessment, and risk visualization.</descrip></descripGrp><ntig><termGrp><term id="2843779">cloud security posture management</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2846620">CSPM</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50273_2843780_2846602"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A class of security tools that assures a continuous process of cloud security improvement and adaptation to reduce the likelihood of a successful attack, including use cases for compliance monitoring, DevOps integration, incident response, risk assessment, and risk visualization.</descrip></descripGrp><ntig><termGrp><term id="2843780">CSPM</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2846602">usimamiaji wa mkao wa usalama wa wingu</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50273_2843780_2846620"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A class of security tools that assures a continuous process of cloud security improvement and adaptation to reduce the likelihood of a successful attack, including use cases for compliance monitoring, DevOps integration, incident response, risk assessment, and risk visualization.</descrip></descripGrp><ntig><termGrp><term id="2843780">CSPM</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2846620">CSPM</term><termNote type