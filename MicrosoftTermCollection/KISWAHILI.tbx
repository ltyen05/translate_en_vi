">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49787_2816024_2817176"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An office organization system which involves multiple workers using a single physical work station or surface during different time periods.</descrip></descripGrp><ntig><termGrp><term id="2816024">hot-desking</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2817176">wafanyakazi anuwai kwa dawati la zamu</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49787_2816024_2817177"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An office organization system which involves multiple workers using a single physical work station or surface during different time periods.</descrip></descripGrp><ntig><termGrp><term id="2816024">hot-desking</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2817177">wafanyakazi-anuwai kwa dawati la zamu</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49788_2816025_2817183"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A service that protects against harmful links (URLs) in incoming emails.</descrip></descripGrp><ntig><termGrp><term id="2816025">URL threat protection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2817183">ulinzi wa vitisho vya URL</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49789_2816026_2817179"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Sample content used to train a classifier.</descrip></descripGrp><ntig><termGrp><term id="2816026">seed content</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2817179">maudhui ya sampuli</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49794_2816264_2820611"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To factor a number means to break it up into numbers that can be multiplied together to get the original number. EXAMPLES: 6 = 3 x 2 so, factors of 6 are 3 and 2; 9 = 3 x 3 so, factors of 9 are 3 and 3.</descrip></descripGrp><ntig><termGrp><term id="2816264">factor</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2820611">namba kamilifu</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntr