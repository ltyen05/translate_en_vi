US"><descripGrp><descrip type="definition">Any temporary storage space used within or in conjunction with a computer, such as RAM or a USB flash drive.</descrip></descripGrp><ntig><termGrp><term id="79535">memory</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1389263">kumbukumbu</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2400_1030794_1816583"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A microcomputer designed for use by one person at a time. Personal computers do not need to share the processing, disk, and printer resources of another computer.</descrip></descripGrp><ntig><termGrp><term id="1030794">single-user computer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1816583">Kompyuta</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2400_1030794_1816611"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A microcomputer designed for use by one person at a time. Personal computers do not need to share the processing, disk, and printer resources of another computer.</descrip></descripGrp><ntig><termGrp><term id="1030794">single-user computer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1816611">kompyuta ya kibinafsi</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2400_91272_1816583"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A microcomputer designed for use by one person at a time. Personal computers do not need to share the processing, disk, and printer resources of another computer.</descrip></descripGrp><ntig><termGrp><term id="91272">PC</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1816583">Kompyuta</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2400_91272_1816611"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A microcomputer designed for use by one person at a time. Personal computers do not need to share the processing, disk, and printer resources of another computer.</descrip></descripGrp><ntig><termGrp><term id="91272">PC</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1816611">kompyuta ya kibinafsi</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2400_91273_1816583"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A microcomputer designed for use by one person at a time. Personal computers do not need to share the processing, disk, and printer resources of another computer.</descrip></descripGrp><ntig><termGrp><term id="91273">personal computer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1816583">Kompyuta</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2400_91273_1816611"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A microcomputer designed for use by one person at a time. Personal computers do not need to share the processing, disk, and printer resources of another computer.</descrip></descripGrp><ntig><termGrp><term id="91273">personal computer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1816611">kompyuta ya kibinafsi</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24002_1093138_1997403"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A UI or media segment that can display on top of or play concurrently with another UI or media segment.</descrip></descripGrp><ntig><termGrp><term id="1093138">overlay</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1997403">tandazo</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24016_1093171_2591211"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A powerful stand-alone computer of the sort used in computer-aided design and other applications requiring a high-end, usually expensive, machine with considerable calculating or graphics capability.</descrip></descripGrp><ntig><termGrp><term id="1093171">workstation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2591211">kituo cha kazi</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24039_1097320_2638736"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">On retailer websites, a collection of desired products or items a customer saves to their user account for future reference.</descrip></descripGrp><ntig><termGrp><term id="1097320">wish list</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2638736">orodha ya matamanio</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24043_1097333_2511202"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Software that provides a common application programming interface (API). Applications written using that API will run in the same computer systems as the middleware.</descrip></descripGrp><ntig><termGrp><term id="1097333">middleware</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2511202">programu unganishi</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2405_2020064_2020710"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The amount of battery power left on the system.</descrip></descripGrp><ntig><termGrp><term id="2020064">battery level</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2020710">chaji ya betri</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2405_2020064_2020711"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The amount of battery power left on the system.</descrip></descripGrp><ntig><termGrp><term id="2020064">battery level</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2020711">kiwango cha betri</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2405_236972_2020710"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The amount of battery power left on the system.</descrip></descripGrp><ntig><termGrp><term id="236972">battery charge</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2020710">chaji ya betri</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2405_236972_2020711"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The amount of battery power left on the system.</descrip></descripGrp><ntig><termGrp><term id="236972">battery charge</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2020711">kiwango cha betri</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24051_1097914_2027665"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To return to a stable condition after some error has occurred. A program recovers from an error by stabilizing itself and resuming execution of instructions without user intervention.</descrip></descripGrp><ntig><termGrp><term id="1097914">recover</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2027665">rejesha</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24057_1098418_1918740"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of statistics that indicates the degree to which a service meets performance, usage, and other demands for the service.</descrip></descripGrp><ntig><termGrp><term id="1098418">service quality metrics</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1918740">metriki za ubora wa huduma</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2407_73729_1397056"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In programming, the order and sequence of input and output.</descrip></descripGrp><ntig><termGrp><term id="73729">layout</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1397056">mpangilio</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24076_1098449_2688753"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The time during which a program is running. In most interactive programs, a session is the time during which the program accepts input and processes information.</descrip></descripGrp><ntig><termGrp><term id="1098449">session</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml