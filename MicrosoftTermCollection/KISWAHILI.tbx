gSet xml:lang="en-US"><descripGrp><descrip type="definition">To perform an action that entails pressing a finger or the tip of a pen to the screen, holding it down until a mouse icon or menu appears, and then lifting the finger or pen. Pressing and holding is equivalent to right-clicking with a mouse.</descrip></descripGrp><ntig><termGrp><term id="214141">press and hold</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2118989">bonyeza na ushikilie</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13996_184176_1389453"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Part of the Office Center feature that allows users to set various security and privacy options, and to see currently enforced security and privacy rules.</descrip></descripGrp><ntig><termGrp><term id="184176">Trust Center</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1389453">Kituo cha Imani</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14003_62649_1397007"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To move the pointer over a UI element for a specified duration with the intent of interacting with that element.</descrip></descripGrp><ntig><termGrp><term id="62649">hover</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumb