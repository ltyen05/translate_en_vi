ermNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39964_2673850_2500934"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The enterprise-wide hyper-scale repository for big data analytic workloads which allows you to capture data of any size, type, and ingestion speed in one single place for operational and exploratory analytics.</descrip></descripGrp><ntig><termGrp><term id="2673850">ADLS</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2500934">Azure Data Lake Store</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39964_2673850_2500935"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The enterprise-wide hyper-scale repository for big data analytic workloads which allows you to capture data of any size, type, and ingestion speed in one single place for operational and exploratory analytics.</descrip></descripGrp><ntig><termGrp><term id="2673850">ADLS</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2500935">Data Lake Store</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="400_236964_1396763"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature of Windows Vista that gives the user quick access to useful information on their computer, such as calendar appointments and the latest email message even when the computer is in standby mode or hibernating, media playback control when the computer is off, and other application notifications.</descrip></descripGrp><ntig><termGrp><term id="236964">auxiliary display</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1396763">uonyesho saidizi</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40026_2326216_2331046"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature in Exchange Online Protection that delivers an email without its attachments, scans the attachments for viruses, and then reattaches the attachments to the mail in the inbox.</descrip></descripGrp><ntig><termGrp><term id="2326216">Dynamic Email Delivery</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2331046">Uwezo wa Uwasilishaji wa Barua</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40027_2326225_2340125"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app that allows users to collect Word, PowerPoint, Excel, Office Mix, and PDF documents as well as sways and publish them on the website, docs.com, where others can view, download or share them or comment on them.</descrip></descripGrp><ntig><termGrp><term id="2326225">Docs.com</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2340125">Docs.com</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40030_2327887_2638717"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The web-based interface that is included as part of specialized Windows devices and used by developers to manage device services remotely.</descrip></descripGrp><ntig><termGrp><term id="2327887">Windows Device Portal</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2638717">Kituo cha Vifaa</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40030_2327887_2638735"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The web-based interface that is included as part of specialized Windows devices and used by developers to manage device services remotely.</descrip></descripGrp><ntig><termGrp><term id="2327887">Windows Device Portal</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2638735">Kituo cha Vifaa vya Windows</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40030_2635486_2638717"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The web-based interface that is included as part of specialized Windows devices and used by developers to manage device services remotely.</descrip></descripGrp><ntig><termGrp><term id="2635486">Device Portal</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2638717">Kituo cha Vifaa</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40030_2635486_2638735"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The web-based interface that is included as part of specialized Windows devices and used by developers to manage device services remotely.</descrip></descripGrp><ntig><termGrp><term id="2635486">Device Portal</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2638735">Kituo cha Vifaa vya Windows</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40031_2338749_2339938"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The standalone 3D scanning app available in the Windows Store.​​</descrip></descripGrp><ntig><termGrp><term id="2338749">3D Scan</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2339938">3D Scan</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40032_2328169_2328313"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature of the 3D Scanner app that allows users to take 3D selfies.​</descrip></descripGrp><ntig><termGrp><term id="2328169">3D Selfie</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2328313">Kujipiga Picha ya 3D</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40033_2328170_2328306"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A 3D printing format that allows design applications to send 3D models to other applications, platforms, services, and printers.​</descrip></descripGrp><ntig><termGrp><term id="2328170">3MF</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2328306">3MF</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40034_2328171_2328318"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The rectangular boundaries of the object to be scanned.​​</descrip></descripGrp><ntig><termGrp><term id="2328171">boundary cube</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2328318">mche mraba wa mpaka</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40035_2328172_2328319"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that simulates a body scanning booth by using a turntable in combination with the Kinect.​​​</descrip></descripGrp><ntig><termGrp><term id="2328172">scanning booth</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2328319">ofisi ya uchanganuzi</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40036_2328173_2328320"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A circular revolving platform where you can place an object for 3D scanning.​​</descrip></descripGrp><ntig><termGrp><term id="2328173">turntable</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2328320">jedwali la mgeuzo</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40037_2328194_2328308"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The multi-app package for Windows 10 that includes the Messaging app for SMS, instant messaging, and Skype chat, and the Skype video app for VoIP video and audio calling.</descrip></descripGrp><ntig><termGrp><term id="2328194">Messaging + Skype</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2328308">Ujumbe Mfupi + Skype</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40039_2329141_2330510"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To add a previously banned person to a contact list again, so a user can receive calls or instant messages from the person.</descrip></descripGrp><ntig><termGrp><term id="2329141">unblock</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2330510">ruhusu</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40040_2329142_2330509"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Text message sent to an electronic device to notify the receiver of something because the receiver has requested notification or accepted an offer to be notified about something.</descrip></descripGrp><ntig><termGrp><term id="2329142">SMS alert</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2330509">Taarifa ya SMS</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40041_2329143_2330508"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Skype call hosted by one user where lots of other users can join and participate in</descrip></descripGrp><ntig><termGrp><term id="2329143">Skypecast</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2330508">Skypecast</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40043_2329145_2330506"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application that can be installed on any mobile or landline in any supported country. It provides users with numbers that let them call friends, family and colleagues abroad from any mobile or landline while avoiding international calling charges.</descrip></descripGrp><ntig><termGrp><term id="2329145">Skype to Go</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2330506">Skype to Go</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40044_2329146_2330505"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A web-based meeting scheduling and management tool. With Skype for Business Web Scheduler, you can create new meetings, change your existing meetings, and send invitations using your favorite email program.</descrip></descripGrp><ntig><termGrp><term id="2329146">Skype for Business Web Scheduler</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2330505">Skype for Business Web Scheduler</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40045_2329147_2330504"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An add-on for Skype for Business Online that provides phone capabilities.</descrip></descripGrp><ntig><termGrp><term id="2329147">Skype for Business Online Phone Add-on</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2330504">Nyongeza ya Simu ya Skype for Business Online</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40046_2329148_2330503"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Skype for Business app for use on mobile devices</descrip></descripGrp><ntig><termGrp><term id="2329148">Skype for Business Mobile app</term><termNote 