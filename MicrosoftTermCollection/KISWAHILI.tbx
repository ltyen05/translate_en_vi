361087"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A library that contains your video files.</descrip></descripGrp><ntig><termGrp><term id="2360428">video library</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2361087">maktaba ya video</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40705_2360433_2365822"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The collection title for songs that are in the top N% of sales.</descrip></descripGrp><ntig><termGrp><term id="2360433">Top-selling songs</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2365822">Nyimbo zinazouzwa zaidi</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40706_2360434_2361073"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The category in Windows Store Movies &amp; TV section that shows the movies and TV shows purchased and rented by you as well as your videos in Movies &amp; TV app.</descrip></descripGrp><ntig><termGrp><term id="2360434">My movies &amp; TV</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2361073">Filamu na Televisheni yangu</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type