 of a cell in a worksheet that does not change when the address is copied to a new cell.</descrip></descripGrp><ntig><termGrp><term id="652439">absolute reference</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="532968">rejeo seli kuntu</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7245_299913_1389287"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The folder that contains any .one files that have been sent to you as an email message attachment.</descrip></descripGrp><ntig><termGrp><term id="299913">Notes E-mailed To Me</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1389287">madokezo nilitumwa kwenye barua pepe</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7246_116666_1389417"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To transfer into a store or storage location.</descrip></descripGrp><ntig><termGrp><term id="116666">store</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1389417">hifadhi</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelec