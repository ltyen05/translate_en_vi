3730"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A business that is legally recognized as both a person and as separate from its owners.</descrip></descripGrp><ntig><termGrp><term id="2708748">corporation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2713730">shirika</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48080_2712293_2724134"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft owned telecommunication software that allows users to make calls using devices connected to the internet for PSTN calling as well as calling other internet connected devices with the software installed.</descrip></descripGrp><ntig><termGrp><term id="2712293">Skype</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2724134">Skype</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48081_2712305_2737691"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A sequence of numbers that users can dial on a device to establish a call with another device.</descrip></descripGrp><ntig><termGrp><term id="2712305">phone number</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2737691">nambar