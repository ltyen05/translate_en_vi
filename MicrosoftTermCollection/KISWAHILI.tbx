<descrip type="definition">The automated Outlook Support feature analyzes a user's Outlook and diagnoses what is wrong with it.</descrip></descripGrp><ntig><termGrp><term id="2365481">Troubleshooting</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2369954">Utatuzi</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41789_2365488_2369947"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office 365 portal that contains Office 365 security and compliance features.</descrip></descripGrp><ntig><termGrp><term id="2365488">Office 365 Security &amp; Compliance Center</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2369947">Kituo cha Usalama na Uzingatiaji cha Office 365</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41796_2365514_2366818"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A clock in the World Clock app that displays the current local time in any city in the world. You can have multiple clocks to display the local times from cities around the world.</descrip></descripGrp><ntig><termGrp><term id="2365514">world clock</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="23668