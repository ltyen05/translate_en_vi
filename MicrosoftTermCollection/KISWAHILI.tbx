ch other.</descrip></descripGrp><ntig><termGrp><term id="63276">IRP</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1397041">IRP</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11707_237298_1918510"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables the user to create, manage and apply standardized citations and references in a document.</descrip></descripGrp><ntig><termGrp><term id="237298">Reference Builder</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1918510">Kijenzi cha Kurejelea</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11709_86813_1397124"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A program file used to connect to a particular database. Each database program, such as Access or dBASE, or database management system, such as SQL Server, requires a different driver.</descrip></descripGrp><ntig><termGrp><term id="86813">ODBC driver</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1397124">kiendeshaji cha ODBC</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1171_13558_1918273"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A technical article, written and distributed by Microsoft, that provides additional information about a Microsoft product or a fix for a known issue.</descrip></descripGrp><ntig><termGrp><term id="13558">application note</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1918273">dokezo la programu</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11712_307435_1952836"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows access to SharePoint documents and sites and documents on shares inside of a corporate network through Outlook Web Access when it is used remotely.</descrip></descripGrp><ntig><termGrp><term id="307435">LinkAccess</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1952836">UfikiajiKiungo</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11717_343653_1397080"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To find.</descrip></descripGrp><ntig><termGrp><term id="343653">locate</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><lan