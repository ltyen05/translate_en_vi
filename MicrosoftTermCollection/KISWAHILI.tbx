et xml:lang="en-US"><descripGrp><descrip type="definition">The service for administrators to detect anomalous or high-risk user activity, discover 3rd-party cloud apps that are being used in their organization that have similar functionality to Office 365, and block 3rd-party application's access to Office 365 information.</descrip></descripGrp><ntig><termGrp><term id="2558359">Cloud App Security</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2740117">Usalama wa Programu ya Wingu</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4531_168151_534025"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To add a special visual or sound effect to text or an object. For example, you can have your text bullet points fly in from the left, one word at a time, or hear the sound of applause when a picture is uncovered.</descrip></descripGrp><ntig><termGrp><term id="168151">animate</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="534025">huisha</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4544_140325_533882"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A connection that specifies the name, type, location, and, optionally, other information about a database file or server.</descrip></descripGrp><ntig><termGrp><term id="140325">database connection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="533882">muunganisho hazinadata</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4544_683602_533882"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A connection that specifies the name, type, location, and, optionally, other information about a database file or server.</descrip></descripGrp><ntig><termGrp><term id="683602">data connection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="533882">muunganisho hazinadata</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4548_30603_533145"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A combination of any of the character formatting options identified by a style name.</descrip></descripGrp><ntig><termGrp><term id="30603">character style</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="533145">mtindo kibambo</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45540_2567657_2568228"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An automatically downloaded add-on for the inbox Microsoft Photos app that provides additional content such as music tracks, special effects, and sample videos to use when creating videos in the Photos app.</descrip></descripGrp><ntig><termGrp><term id="2567657">Photos Add-on</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2568228">Programu jalizi ya Picha</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45541_2567793_2707010"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Threat management feature available from the Office 365 Security &amp; Compliance Center to simulate attacks, focusing on breaching accounts, data extraction, elevation of privilege, and data modification/deletion, to assess user practices related to security.</descrip></descripGrp><ntig><termGrp><term id="2567793">Attack Simulator</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2707010">Kiigaji cha mashambulizi</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45541_2567793_2707011"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Threat management feature available from the Office 365 Security &amp; Compliance Center to simulate attacks, focusing on breaching accoun