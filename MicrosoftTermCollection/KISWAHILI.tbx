 type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33713_1814225_2062526"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A phone number allocated for the Skype user, allowing the user to call pre-configured landlines or mobile phones. A type of Skype To Go number.</descrip></descripGrp><ntig><termGrp><term id="1814225">Direct Dial number</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2062526">Nambari ya Upigaji wa Moja kwa moja</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33714_1814228_2062523"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A message asking to add or adding a Skype user to another user's contact list.</descrip></descripGrp><ntig><termGrp><term id="1814228">contact request</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2062523">ombi la mwasiliani</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33716_1814230_2062531"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A voice call with up to 25 participants in Skype.</descrip></descripGrp><ntig><termGrp><term id="1814230">group call</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><nti