p><term id="303757">tabbed browsing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1399209">uvinjari vichupo</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9399_186186_1918446"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A notification bar warning the user about data that is blocked in the loaded file. Trust Bars can be for information only (non-actionable) or actionable.</descrip></descripGrp><ntig><termGrp><term id="186186">Trust Bar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1918446">Upau Aminifu</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="94_397174_1952848"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mail-enabled Active Directory user that represents a user outside the Exchange organization. Each mail user has an external email address. A mail user is similar to a mail contact, except that a mail user has Active Directory logon credentials and can access resources.</descrip></descripGrp><ntig><termGrp><term id="397174">mail user</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1952848">mtumiaji wa barua</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partO