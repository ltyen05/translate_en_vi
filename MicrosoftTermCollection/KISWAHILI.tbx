US"><descripGrp><descrip type="definition">An email report that provides the same details as a Summary report, plus additional details such as recipient status, message ID, and original client IP address.</descrip></descripGrp><ntig><termGrp><term id="2689355">Enhanced summary report</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2691369">Ripoti ya muhtasari iliyoboreshwa</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="47781_2689380_2691376"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An email report that provides the same details as an Enhanced summary report, plus comprehensive routing and message event details.</descrip></descripGrp><ntig><termGrp><term id="2689380">Extended report</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2691376">Ripoti iliyopanuliwa</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="47782_2689383_2691377"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A report on the internal controls of a company related to financial reporting, security, availability, processing integrity, confidentiality, and privacy, and that can only be conducted by independent certified public accounting firms.</descrip></descripGrp><ntig><termGrp><term id="2689383">Service Organization Controls report</term><termNote type=