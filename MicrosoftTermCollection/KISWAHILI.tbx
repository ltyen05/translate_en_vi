Set xml:lang="en-US"><descripGrp><descrip type="definition">A control designed to contain content such as placeholder or sample text or images that is updated by the user, or pre-defined lists of items from which users can select.</descrip></descripGrp><ntig><termGrp><term id="494725">content control</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1447855">udhibiti wa maudhui</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19436_659694_2772160"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An object that can contain one or more child objects.</descrip></descripGrp><ntig><termGrp><term id="659694">container</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2772160">mtungi</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19436_763338_2772160"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An object that can contain one or more child objects.</descrip></descripGrp><ntig><termGrp><term id="763338">container element</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2772160">mtungi</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="gram