ludes authenticating users with both on-premises and cloud-hosted Office services, single sign-on authentication (including against third party identity providers) so that passwords are not sent directly to Office 365, and multi-factor authentication.</descrip></descripGrp><ntig><termGrp><term id="2168877">modern authentication</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2213820">uhalalishaji wa kisasa</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3789_90732_533586"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of query that, when you run it, prompts for values (criteria) to use to select the records for the result set so that the same query can be used to retrieve different result sets.</descrip></descripGrp><ntig><termGrp><term id="90732">parameter query</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="533586">ulizo parameta</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37890_2168878_2325074"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The API that enables developers to create, read, update, and delete objects and relationships between them in an Office graph.</descrip></descripGrp><ntig><termGrp><term id="2168878">Office Graph API</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2325074">API ya Office Graph</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="379_102150_1527999"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Not in the immediate vicinity, as a computer or other device located in another place (room, building, or city) and accessible through some type of cable or communications link.</descrip></descripGrp><ntig><termGrp><term id="102150">remote</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1527999">kwa mbali</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="379_764630_1527999"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Not in the immediate vicinity, as a computer or other device located in another place (room, building, or city) and accessible through some type of cable or communications link.</descrip></descripGrp><ntig><termGrp><term id="764630">distant</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1527999">kwa mbali</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></lang