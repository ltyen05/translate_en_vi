><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42205_2389315_2389588"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To use or play a product for a short time for free, without having to purchase it.</descrip></descripGrp><ntig><termGrp><term id="2389315">preview</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2389588">hakiki</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42206_2389316_2389559"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A short display of a product for free without having to purchase it.</descrip></descripGrp><ntig><termGrp><term id="2389316">preview</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2389559">uhakiki</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42207_2389317_2389551"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The act of being charged money for a particular service.</descrip></descripGrp><ntig><termGrp><term id="2389317">billing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><lan