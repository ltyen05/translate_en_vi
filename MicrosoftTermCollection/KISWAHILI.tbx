asy retrieval and sorting.</descrip></descripGrp><ntig><termGrp><term id="748512">Tags</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1389092">Kategoria</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20861_748512_1389435"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows the user to apply custom or default markers to items (e.g. Outlook messages or OneNote content) in order to categorize information for easy retrieval and sorting.</descrip></descripGrp><ntig><termGrp><term id="748512">Tags</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1389435">Lebo</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20861_748513_1389092"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows the user to apply custom or default markers to items (e.g. Outlook messages or OneNote content) in order to categorize information for easy retrieval and sorting.</descrip></descripGrp><ntig><termGrp><term id="748513">Categories</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1389092">Kategoria</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partO