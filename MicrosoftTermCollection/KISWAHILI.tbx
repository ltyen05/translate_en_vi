ent implications and associations.</descrip></descripGrp><ntig><termGrp><term id="118391">synonym</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="533727">kisawe</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42210_2389354_2389560"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Windows Camera mode in which the Camera app automatically adjusts image capture settings such as exposure, ISO, sensitivity, white balance and more.</descrip></descripGrp><ntig><termGrp><term id="2389354">Auto</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2389560">Otomatiki</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42212_2389893_2420949"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A series of points with color and varying thickness that resembles physical ink on a digital screen.</descrip></descripGrp><ntig><termGrp><term id="2389893">ink</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2420949">wino</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSe