r">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25810_1217801_1376663"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The link to the list of contacts from your mail and messenger accounts.</descrip></descripGrp><ntig><termGrp><term id="1217801">People</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1376663">Watu</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25811_1217802_1376664"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The link to Windows Live Hotmail.</descrip></descripGrp><ntig><termGrp><term id="1217802">Mail</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1376664">Barua</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25813_1217804_1376665"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The link to the list of more links to other Microsoft sites.</descrip></descripGrp><ntig><termGrp><term id="1217804">More</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1376665">Zaidi</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25814_1217805_1376666"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The link to the online calendar on Windows Live Calendar.</descrip></descripGrp><ntig><termGrp><term id="1217805">Calendar</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1376666">Kalenda</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25815_1217807_1376667"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The link to the online shared event organiser on Windows Live Events.</descrip></descripGrp><ntig><termGrp><term id="1217807">Events</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1376667">Matukio</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25816_1217808_1376668"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The link to the online communities on Windows Live Groups.</descrip></descripGrp><ntig><termGrp><term id="1217808">Groups</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1376668">Vikundi</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25817_1217809_1376669"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The link to the user's personal online space, with blog functionality, photo albums, and lists, on Windows Live Spaces.</descrip></descripGrp><ntig><termGrp><term id="1217809">Spaces</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1376669">Nafasi</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25819_1217811_1376671"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The link to the Windows Live site where users can register their mobile phone and find information about the Windows Live for Mobile services.</descrip></descripGrp><ntig><termGrp><term id="1217811">Mobile</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1376671">Simu Jongefu</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25820_1217812_1376672"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The link to the site to download client versions of Windows Live products such as Windows Live Mail, Windows Live Messenger, etc.</descrip></descripGrp><ntig><termGrp><term id="1217812">Downloads</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1376672">Vipakuaji</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25821_1217813_1376673"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The link to the overview page of all Windows Live, MSN, and Microsoft products on offer.</descrip></descripGrp><ntig><termGrp><term id="1217813">All services</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1376673">Huduma zote</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25822_1217817_1376674"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The link to the page where users enter information for the methods by which they can be contacted, such as Messenger, home phone, mobile phone, and email.</descrip></descripGrp><ntig><termGrp><term id="1217817">Contact info</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1376674">Maelezo za mwasiliani</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25825_1217869_1918782"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An option that enables the user to see the different parts of a nested formula evaluated in the order the formula is calculated.</descrip></descripGrp><ntig><termGrp><term id="1217869">Evaluate Formula</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1918782">Tathmini Fomula</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25837_1217966_1952771"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Outlook Live feature in the Web management interface that enables migration of the contents of user mailboxes from an on-premises IMAP messaging system to Outlook Live (or Exchange Online).</descrip></descripGrp><ntig><termGrp><term id="1217966">Email Migration</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1952771">Uhamishaji wa Barua pepe</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2584_235070_534264"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A photo organizer used to view, manage, and edit digital pictures.</descrip></descripGrp><ntig><termGrp><term id="235070">Windows Photo Gallery</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="534264">Kichanja cha Picha cha Windows</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2584_725946_534264"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A photo organizer used to view, manage, and edit digital pictures.</descrip></descripGrp><ntig><termGrp><term id="725946">Photo Gallery</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="534264">Kichanja cha Picha cha Windows</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25844_1218374_1952947"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The domain name of the Outlook Live domain that you are configuring with Outlook Live Directory Sync (OLSync)(previously known as GALSync 2010). When you deploy OLSync, you manually enter at least one provisioning domain, for example, student.contoso.edu, during the ILM 2007 configuration process. The provisioning domain must be an accepted domain in your Outlook Live deployment.</descrip></descripGrp><ntig><termGrp><term id="1218374">provisioning domain</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1952947">kikoa cha utoaji</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25845_1218375_1952673"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A domain or a person that an end user doesn't want to receive email messages from. Messages received from any email address or domain listed in the users' Blocked Senders list are sent directly to the user's Junk E-Mail folder.</descrip></descripGrp><ntig><termGrp><term id="1218375">blocked sender</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1952673">mtumaji aliyezuiwa</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25846_1218376_1952859"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Active Directory security principal object that has at least one associated SMTP address</descrip></descripGrp><ntig><termGrp><term id="1218376">mail-enabled user</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1952859">mtumiaji aliyewezeshewa barua</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25847_1218377_1952815"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The administrator user interface in Outlook Live used to import new users with a CSV file.</descrip></descripGrp><ntig><termGrp><term id="1218377">Import users</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1952815">Leta watumiaji</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25848_1218378_1952720"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A comma separated value (CSV) file used to provision many new users at one time.</descrip></descripGrp><ntig><termGrp><term id="1218378">CSV import file</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1952720">Faili ya kuleta CSV</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25849_1218379_1952814"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of provisioning new users using a CSV file.</descrip></descripGrp><ntig><termGrp><term id="1218379">import process</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1952814">mchakato wa kuleta</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25850_1218380_1953059"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The administrative boundary in which members of an Exchange 2010 role group can make changes. For the Outlook Live hosted service, the write scope is the entire Outlook Live organization. For on-premises implementations of Microsoft Exchange Server 2010, write scopes may be smaller in breadth, such as those defined by a specific organizational unit or a database.</descrip></descripGrp><ntig><termGrp><term id="1218380">write scope</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1953059">uwezo wa kuandika</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25851_1218381_1952749"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The role group that gives users the permissions needed to use Multi-Mailbox Search.</descrip></descripGrp><ntig><termGrp><term id="1218381">Discovery Management</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1952749">Usimamiaji Utambuaji</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25852_1218382_1952807"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The role group that gives users the permissions to reset passwords for users and manage settings on the Options page for users' Outlook Live account. To help troubleshoot user issues, members can also view, but not modify, all mailboxes, public groups, and external contacts in the organization.</descrip></descripGrp><ntig><termGrp><term id="1218382">Help Desk</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1952807">Eneo la Msaada</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25853_1218383_1952952"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The role group that gives users the permissions to create and manage mailboxes, public groups, and external contacts. Members can also import new users, track messages sent and received by users, and manage Exchange ActiveSync settings for the organization.</descrip></descripGrp><ntig><termGrp><term id="1218383">Recipient Management</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1952952">Usimamiaji wapokeaji</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25854_1218384_1952954"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The role group that gives users permissions to create and manage organization-wide rules, also known as transport rules. Members of the role group can also track messages sent and received by users.</descrip></descripGrp><ntig><termGrp><term id="1218384">Records Management</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1952954">Usimamiaji Rekodi</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25855_1218385_1953031"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The role group that gives users the permissions to manage Unified Messaging (UM) server configurations, UM properties on mailboxes, UM prompts, and UM auto attendant configuration.</descrip></descripGrp><ntig><termGrp><term id="1218385">UM Management</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1953031">Usimamiaji UM</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25856_1218386_1953042"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The administrator role group that gives users permissions to view, but not modify, all mailboxes, public groups, and external contacts in the organization. Members can also view settings for role assignment policies, transport rules, and supervision policies.</descrip></descripGrp><ntig><termGrp><term id="1218386">View-Only Organization Management</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1953042">Usimamiaji Shirika la Ona Tu</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25857_1218387_1952976"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A domain or a person that a user wants to always receive email messages from. Users add recipients and domains to the Safe Senders list.</descrip></descripGrp><ntig><termGrp><term id="1218387">safe sender</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1952976">mtumaji salama</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25858_1218388_1952897"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in Exchange 2010 and Outlook Live that enables users to search the mailboxes in their organization for email and other message types that contain specific keywords. The results of a search are then copied to a mailbox that you have specified so that you can review, organize, and export the search results.</descrip></descripGrp><ntig><termGrp><term id="1218388">Multi-Mailbox Search</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1952897">Utafutaji wa kisanduku cha barua-Anuwai</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25859_1218389_1953036"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An item that can't be indexed for a mailbox search using Multi-Mailbox Search. This includes unrecognized message types and messages that contain attachments that are encrypted or have an unrecognized format.</descrip></descripGrp><ntig><termGrp><term id="1218389">unsearchable item</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1953036">kipengee kisichoweza kutafutwa</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25860_1218390_1952800"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A person who is assigned the ability to approve and reject any messages sent to a public group or a dynamic distribution group.</descrip></descripGrp><ntig><termGrp><term id="1218390">group moderator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1952800">msimamizi wa kikundi</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25862_1223075_1952972"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of resource mailbox that is assigned to a meeting location such as a conference room, auditorium, or training room. Room mailboxes can be included as resources in meeting requests, providing a simple and efficient way of organizing meetings for an organization.</descrip></descripGrp><ntig><termGrp><term id="1223075">room mailbox</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1952972">kisanduku cha barua cha chumba</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25865_1223099_2729204"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A notice sent to employees of an organization instructing them to preserve all documents that may be relevant to a legal case.</descrip></descripGrp><ntig><termGrp><term id="1223099">legal hold</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2729204">shikilio la kisheria</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25865_1223099_2729206"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A notice sent to employees of an organization instructing them to preserve all documents that may be relevant to a legal case.</descrip></descripGrp><ntig><termGrp><term id="1223099">legal hold</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2729206">shikilia madai</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25865_2726542_2729204"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A notice sent to employees of an organization instructing them to preserve all documents that may be relevant to a legal case.</descrip></descripGrp><ntig><termGrp><term id="2726542">litigation hold</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2729204">shikilio la kisheria</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25865_2726542_2729206"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A notice sent to employees of an organization instructing them to preserve all documents that may be relevant to a legal case.</descrip></descripGrp><ntig><termGrp><term id="2726542">litigation hold</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2729206">shikilia madai</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25869_1224269_1953009"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Elevated credentials that have rights to access objects that ordinary users without elevated credentials can't access.</descrip></descripGrp><ntig><termGrp><term id="1224269">super-user credentials</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1953009">hati tambulishi zilizotumiwa sana</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2587_318778_532892"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The — character, based on the width of an uppercase M and used primarily to set off sentence elements.</descrip></descripGrp><ntig><termGrp><term id="318778">EM DASH</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="532892">deshi</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2587_988_532892"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The — character, based on the width of an uppercase M and used primarily to set off sentence elements.</descrip></descripGrp><ntig><termGrp><term id="988">em dash</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="532892">deshi</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25870_1224270_1952932"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A subscription that gathers messages from POP3 mailboxes and delivers the messages to a designated Outlook Live mailbox so that the Outlook Live end user can centralize their email accounts and only have to check one mailbox.</descrip></descripGrp><ntig><termGrp><term id="1224270">POP subscription</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1952932">Usajili wa POP</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25871_1224271_1952768"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Windows Live ID created in a domain, and using the domain name, before the domain was enrolled in Outlook Live. After the Windows Live ID is imported into the Outlook Live domain, it is subject to the security and privacy policies of the organization.</descrip></descripGrp><ntig><termGrp><term id="1224271">unmanaged Windows Live ID</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1952768">EASI ID</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25871_1224271_1952770"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Windows Live ID created in a domain, and using the domain name, before the domain was enrolled in Outlook Live. After the Windows Live ID is imported into the Outlook Live domain, it is subject to the security and privacy policies of the organization.</descrip></descripGrp><ntig><termGrp><term id="1224271">unmanaged Windows Live ID</term><termNote type="partOfSpeech">Noun</termNote