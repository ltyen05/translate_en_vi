 in the matching field or fields of many records in the related table.</descrip></descripGrp><ntig><termGrp><term id="87506">one-to-many relationship</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1389293">uhusiano baina ya moja na nyingi</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7376_1146759_533360"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A class of computer programs in which one or more users interact with the computer as a form of entertainment.</descrip></descripGrp><ntig><termGrp><term id="1146759">video game</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="533360">mchezo</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7376_57639_533360"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A class of computer programs in which one or more users interact with the computer as a form of entertainment.</descrip></descripGrp><ntig><termGrp><term id="57639">game</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="533360">mchezo</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote ty