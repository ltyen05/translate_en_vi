ch">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1954426">Kitufe cha Microsoft Office</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20659_739397_2118984"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A series of digital-media files that users can subscribe to online, that are sent to their computers or mobile devices and that can then be accessed on demand on the users' reader.</descrip></descripGrp><ntig><termGrp><term id="739397">podcast</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2118984">podikasti</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20673_741964_1952961"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mailbox that represents conference rooms and company equipment. Resource mailboxes can be included as resources in meeting requests, providing a simple and efficient way to utilize resources for an organization. The user account that is associated with a resource mailbox is disabled.</descrip></descripGrp><ntig><termGrp><term id="741964">resource mailbox</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1952961">kisanduku cha barua cha nyenzo</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20675_743746_1528031"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To monitor an email conversation or newsgroup thread. The headers for messages in a watched conversation appear in a different color, which makes them easier to find in a message list.</descrip></descripGrp><ntig><termGrp><term id="743746">watch</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1528031">tazama</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20683_745706_1389118"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An option on the Views menu in File Explorer that shows the most appropriate details for the file type in a flexible layout rather than only showing the details associated with the column headers in the view.</descrip></descripGrp><ntig><termGrp><term id="745706">Content</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1389118">Yaliyomo</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20689_2356132_2358938"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature in Control Panel that provides the user with a single point of entry for tasks and notifications related to security and general PC software maintenance.</descrip></descripGrp><ntig><termGrp><term id="2356132">Security and Maintenance</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2358938">Usalama na Matengenezo</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20695_746372_1389057"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A gallery that allows users to create a quick rule to move mail to a selected folder based on the sender, recipients, or conversation of the currently selected email message without opening the full Create Rule dialog.</descrip></descripGrp><ntig><termGrp><term id="746372">Always Move gallery</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1389057">Kichanja cha Kuhamisha Kila Mara</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20697_777440_1389216"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of computers on a home network that can share pictures, music, videos, documents, and printers. A homegroup is created by using the HomeGroup feature; it is protected with a password.</descrip></descripGrp><ntig><termGrp><term id="777440">homegroup</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1389216">kikundi nyumbani</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20698_782774_1389219"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A password that helps prevent unauthorized access to homegroup files and printers.</descrip></descripGrp><ntig><termGrp><term id="782774">homegroup password</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1389219">nywila ya kikundi nyumbani</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20702_746417_1389085"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A digital or paper format pack that usually consists of a proof of purchase, the description of the licensing terms and policies, and number of client access licenses (CALs) purchased in this pack.</descrip></descripGrp><ntig><termGrp><term id="746417">CAL pack</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1389085">furushi la CAL</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20703_746420_1389102"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An action that removes redundant messages from an email conversation to reduce information overload and improve readability.</descrip></descripGrp><ntig><termGrp><term id="746420">Clean Up</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1389102">Safisha</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20704_746421_1389082"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A fork within a conversation, where more than one reply was made to a single email and caused a split in the conversation.</descrip></descripGrp><ntig><termGrp><term id="746421">branch</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1389082">tawi</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20707_1805810_2062532"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An instant message session with multiple parties, exchanged via IM (not through your mobile operator).</descrip></descripGrp><ntig><termGrp><term id="1805810">group conversation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2062532">sogoa ya kikundi</term><termNote type="geographicalUsage">KEN, TZ