4417_1918334"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file (or component within another file) that contains Automation standard descriptions of exposed objects, properties, and methods.</descrip></descripGrp><ntig><termGrp><term id="124417">type library</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1918334">aiana ya maktaba</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="406_22638_1952674"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A portion of content within an email or Internet newsgroups, that follows the header and contains the content of the message.</descrip></descripGrp><ntig><termGrp><term id="22638">body</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1952674">kiini</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40602_2357666_2359741"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application that provides step counts, workouts, sleep quality data and a web dashboard to give insights into physical activity benefits to the user’s overall health.</descrip></descripGrp><ntig><termGrp><term id="2357666">Microsoft Health</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><t