59"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A private team that is hidden from the list of suggested teams and not displayed in search results.</descrip></descripGrp><ntig><termGrp><term id="2797730">non-discoverable private team</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2799559">timu ya faragha isiyotambulika</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49372_2797736_2799536"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A member of a Microsoft Teams' team who can control content in a channel.</descrip></descripGrp><ntig><termGrp><term id="2797736">channel moderator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2799536">mratibu wa kituo</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49373_2797737_2799562"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A team in Microsoft Teams where every member of an organization is a team member.</descrip></descripGrp><ntig><termGrp><term id="2797737">org-wide team</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2799562">timu ya shirika nzima</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">No