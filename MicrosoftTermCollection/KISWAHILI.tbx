 type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31118_1630222_1642749"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method of starting the computer that speeds boot time by ending the user session and hibernating the computer, rather than shutting down all running services.</descrip></descripGrp><ntig><termGrp><term id="1630222">fast startup</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1642749">uwashaji wa haraka</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31152_1597055_1750611"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A small amount of executable code contained in the master boot record that scans the partition table for the active partition, finds the starting sector of the active partition, loads a copy of the boot sector from the active partition into memory, and transfers control to the executable code in the boot sector.</descrip></descripGrp><ntig><termGrp><term id="1597055">master boot code</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1750611">msimbo mkuu wa uwashaji</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3117_109079_533675"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Protection of a computer system and its data from harm or loss.</descrip></descripGrp><ntig><termGrp><term id="109079">security</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="533675">usalama</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3117_747373_533675"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Protection of a computer system and its data from harm or loss.</descrip></descripGrp><ntig><termGrp><term id="747373">network security</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="533675">usalama</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3127_140864_1918367"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A phone number format for dialing internal, operator, or emergency numbers by a computer.</descrip></descripGrp><ntig><termGrp><term id="140864">dialable format</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1918367">umbizo la kupiga simu</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31293_1598403_1642173"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A runtime environment for Windows Store apps that's designed to minimize app impact on the computer by placing runtime restrictions on what apps can do.</descrip></descripGrp><ntig><termGrp><term id="1598403">app container</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1642173">programu-tumizi ya kontena</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31294_1627809_1684237"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A filtering feature that monitors downloaded apps for malware or unknown reputation.</descrip></descripGrp><ntig><termGrp><term id="1627809">Windows SmartScreen</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1684237">Windows SmartScreen</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31295_1598405_1642207"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature of Windows that includes a set of maintenance tasks that run automatically when the user's PC is idle.</descrip></descripGrp><ntig><termGrp><term id="1598405">Automatic Maintenance</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1642207">matengenezo otomatiki</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31296_1598406_1642485"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature of BitLocker that enables IT pros to encrypt a disk before a user begins to use it.</descrip></descripGrp><ntig><termGrp><term id="1598406">BitLocker encrypted installation</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1642485">Usakinishaji usimbaji fiche wa BitLocker</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31297_1598407_1642477"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A BitLocker extension that adds management capabilities to BitLocker.</descrip></descripGrp><ntig><termGrp><term id="1598407">BitLocker Enterprise</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1642477">kampuni kubwa ya BitLocker</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31298_1598408_1642471"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature of BitLocker that allows unlocking of an OS volume using a key received over the network.</descrip></descripGrp><ntig><termGrp><term id="1598408">BitLocker network unlock</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1642471">Fungua mtandao wa BitLocker</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31298_1757881_1642471"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature of BitLocker that allows unlocking of an OS volume using a key received over the network.</descrip></descripGrp><ntig><termGrp><term id="1757881">BitLocker Network Unlock</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1642471">Fungua mtandao wa BitLocker</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31298_1757883_1642471"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature of BitLocker that allows unlocking of an OS volume using a key received over the network.</descrip></descripGrp><ntig><termGrp><term id="1757883">Network Unlock</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1642471">Fungua mtandao wa BitLocker</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31299_1598409_1642879"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Hyper-V technology that runs on the Windows Client operating system, rather than Windows Server.</descrip></descripGrp><ntig><termGrp><term id="1598409">Client Hyper-V</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1642879">Client Hyper-V</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31304_1598622_1643022"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ability for IT pros to define how users access a system based on dynamic qualities, such as a user's location or role.</descrip></descripGrp><ntig><termGrp><term id="1598622">dynamic access control</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1643022">dhibiti uwezo wa ufikivu</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31305_1598623_1642748"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Windows feature designed to help users avoid data loss by automatically saving versions of files and copies of deleted files so that users can recover them.</descrip></descripGrp><ntig><termGrp><term id="1598623">File History</term><termNote type="partOfSpeech">ProperNoun</termNo