finition">An app that enables members of a Language community to provide translation and language-related feedback about features. The app is currently available only for Windows Desktop.</descrip></descripGrp><ntig><termGrp><term id="2506886">Language Community app</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2509909">Programu ya Jumuiya ya Lugha</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44587_2506888_2509913"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A request to gather and send language feedback using quests in Feedback Hub and the Language Community app.​</descrip></descripGrp><ntig><termGrp><term id="2506888">language quest</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2509913">ombi la lugha</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4459_148656_1447703"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The slide that stores information about the design template applied, including font styles, placeholder sizes and positions, background design, and color schemes.</descrip></descripGrp><ntig><termGrp><term id="148656">slide master</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term