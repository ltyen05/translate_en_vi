ry><termEntry id="8250_5650_532962"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A device that is added to the base computer system to increase functionality, such as audio, networking, graphics, or SCSI controller.</descrip></descripGrp><ntig><termGrp><term id="5650">add-on</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="532962">kifaa cha nyongeza</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8251_170244_2528815"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Microsoft program that invites customers to provide Microsoft with more detailed information about how the software is used including the type and frequency of errors, software and hardware performance, and feature usage. This information is anonymous and voluntary, and is used strictly for the purposes of software development.</descrip></descripGrp><ntig><termGrp><term id="170244">Customer Experience Improvement Program</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2528815">Programu ya Kuboresha Uzoefu wa Mteja</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8251_170245_2528815"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Microsoft program that invites customers to provide Microsoft with more detailed information about how the softwar