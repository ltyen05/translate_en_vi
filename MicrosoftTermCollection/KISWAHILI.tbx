</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5686_7497_532979"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A device, such as a disk drive, printer, modem, or joystick, that is connected to a computer and is controlled by the computer's microprocessor.</descrip></descripGrp><ntig><termGrp><term id="7497">peripheral</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="532979">kipembezo</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5688_41879_1396863"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To modify or assemble hardware or software to suit the needs or preferences of the user.</descrip></descripGrp><ntig><termGrp><term id="41879">customize</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1396863">geuza kukufaa</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5695_127476_2576782"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The macro-language version of Visual Basic that is used to program many Windows applications and is included with several Microsoft applications.</descrip></des