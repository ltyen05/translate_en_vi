definition">The enterprise-wide hyper-scale repository for big data analytic workloads which allows you to capture data of any size, type, and ingestion speed in one single place for operational and exploratory analytics.</descrip></descripGrp><ntig><termGrp><term id="2325976">Data Lake Store</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2500935">Data Lake Store</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39964_2673308_2500934"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The enterprise-wide hyper-scale repository for big data analytic workloads which allows you to capture data of any size, type, and ingestion speed in one single place for operational and exploratory analytics.</descrip></descripGrp><ntig><termGrp><term id="2673308">Azure Data Lake Storage</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2500934">Azure Data Lake Store</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39964_2673308_2500935"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The enterprise-wide hyper-scale repository for big data analytic workloads which allows you to capture data of any size, type, and ingestion speed in one single place for operational and exploratory analytics.</descrip></descripGrp><ntig><termGrp><