n of system administration tasks across multiple platforms.</descrip></descripGrp><ntig><termGrp><term id="2353123">PowerShell Core</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2353219">PowerShell Core</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40511_2353386_2354227"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The group of add-ons for Office 2016 that includes one or more of the following: proofing tools, an LIP, a language pack, and/or a spellchecker.</descrip></descripGrp><ntig><termGrp><term id="2353386">Office 2016 Language Accessory Pack</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2354227">Office 2016 Language Accessory Pack</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40521_2353984_2356032"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A free feature that allows setting up online business meetings using work email. The feature is part of Skype for Business experience and has multiple online entry-points (e.g. Skype.com).</descrip></descripGrp><ntig><termGrp><term id="2353984">Skype Meetings</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2356032">Mikutano ya Skype</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40523_2354097_2355441"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Big Data Analysis Generic Enabler reference implementation (GEri) intended to deploy means for analyzing both batch and stream data and get insights on such a data.</descrip></descripGrp><ntig><termGrp><term id="2354097">Cosmos</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2355441">Cosmos</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40524_2354098_2355444"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A query expressed in the native SQL dialect of the database of choice.</descrip></descripGrp><ntig><termGrp><term id="2354098">native database query</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2355444">ulizo asili la hifadhidata</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40524_2354098_2355445"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A query expressed in the native SQL dialect of the database of choice.</descrip></descripGrp><ntig><ter