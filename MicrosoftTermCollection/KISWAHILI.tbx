r">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12349_26421_1396797"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of temporarily storing recently accessed information in a special memory subsystem for quicker access.</descrip></descripGrp><ntig><termGrp><term id="26421">caching</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1396797">kuhifadhi muda</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12359_235413_534267"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A modular unit of code that acts as part of a larger system or structure.</descrip></descripGrp><ntig><termGrp><term id="235413">component</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="534267">kijenzi</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1236_42543_1918285"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file consisting of data in the form of text, numbers, or graphics, as distinct from a program file of commands and instructions.</descrip></descripGrp><ntig><termGrp><term id="42543">data file</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1918285">faili ya data</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12362_464497_1953037"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">User's perception about the utility usability and desirability of a product as they integrate it into their lives and their family system. The user experience will be the differentiator that drives adoption and use of hardware software and services.</descrip></descripGrp><ntig><termGrp><term id="464497">user experience</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1953037">uzoefu wa mtumiaji</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12363_121418_1918329"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In an online forum, such as a newsgroup, a series of messages or articles in which replies to a message are nested directly under it instead of arranged in chronological or alphabetical order.</descrip></descripGrp><ntig><termGrp><term id="121418">threaded discussion</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1918329">majadiliano ya mtungo</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp><