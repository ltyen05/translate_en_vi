g></langSet></termEntry><termEntry id="8276_182566_534065"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Microsoft Web site that provides customers with access to a database of articles written by Microsoft Support professionals.</descrip></descripGrp><ntig><termGrp><term id="182566">Microsoft Knowledge Base</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="534065">Msingi wa Maaarifa wa Microsoft</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8279_143597_1918387"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A movie clip that plays when the user opens a Web page, or when the pointer rests on a movie image, or in both instances, depending on the object's settings. Not all Web browsers support inline movies.</descrip></descripGrp><ntig><termGrp><term id="143597">inline movie</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1918387">filamu ya mstari wa ndani</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="828_178555_2735327"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An item that is frequently accessed when using Business Contact Manager for Outlook and that is often listed on the Business Tools menu.</descrip></descripGrp><ntig><termGrp><term id="178555">business tool</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2735327">zana ya biashara</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8283_153889_1396958"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A derivative of the file allocation table (FAT) file system. FAT32 supports smaller cluster sizes and larger volumes than FAT, which results in more efficient space allocation on FAT32 volumes.</descrip></descripGrp><ntig><termGrp><term id="153889">FAT32</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1396958">FAT32</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8286_2119323_1399187"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A unique set of letters or numbers that identifies a wireless network. For a computer or device to connect to a wireless network, it must supply that network’s SSID. An SSID can be up to 32 characters.</descrip></descripGrp><ntig><termGrp><term id="2119323">Service Set Identifier</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1399187">SSID</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="gram