></descripGrp><ntig><termGrp><term id="141204">drop lines</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="533894">mistari kunjuzi</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49748_2815101_2836346"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that provides a dedicated cache solution that complements Delivery Optimization distributed peer-to-peer system.</descrip></descripGrp><ntig><termGrp><term id="2815101">Connected Cache</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2836346">Kache Iliyounganishwa</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49754_2815537_2815823"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The offer for Microsoft 365 that includes business services—email, file storage and sharing, Office Online, meetings and IM, and more. Office applications not included.</descrip></descripGrp><ntig><termGrp><term id="2815537">Office 365 E1</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2815823">Office 365 E1</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotS