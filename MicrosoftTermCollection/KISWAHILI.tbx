<termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2487091">#ZUILIWA!</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44245_2485904_2487716"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A website that customers can go to for help with Microsoft products.</descrip></descripGrp><ntig><termGrp><term id="2485904">Microsoft Support</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2487716">Auni ya Microsoft</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4425_232401_1918480"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Calendar, time status and user defined labels are indicated by colors and patterns.</descrip></descripGrp><ntig><termGrp><term id="232401">free/busy time</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1918480">saa huru/inayoshughulika</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44250_2486129_2494002"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In mixed reality, an app view in which the app takes over the full display and becomes the only app you see.</descrip></descripGrp><ntig><termGrp><term id="2486129">immersive view</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2494002">mwonekano mzima</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44253_2486136_2494010"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Windows Mixed Reality​, the desktop app that allows the user to manage their mixed reality headset, get status on their mixed reality hardware, see a live stream of what's visible in the headset, and complete system setup.​</descrip></descripGrp><ntig><termGrp><term id="2486136">Mixed Reality Portal</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2494010">Kitovu cha Mixed Reality</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44259_2486144_2494017"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The mixed reality experience built into Windows that powers a compatible virtual reality headset or head-mounted display.</descrip></descripGrp><ntig><termGrp><term id="2486144">Windows Mixed Reality</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2494017">Windows Mixed Reality</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44260_2486898_2488542"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A conclusion of a business interaction.</descrip></descripGrp><ntig><termGrp><term id="2486898">close</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2488542">funga</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44261_2486899_2488550"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A record of a meeting.</descrip></descripGrp><ntig><termGrp><term id="2486899">meeting log</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2488550">rekodi ya mkutano</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44262_2486900_2488548"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A record of a call</descrip></descripGrp><ntig><termGrp><term id="2486900">call log</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2488548">rekodi ya simu</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4427_297178_1396786"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Software that changes browser settings, such as the home page, without adequate consent.</descrip></descripGrp><ntig><termGrp><term id="297178">browser modifier</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1396786">kigeuza kivinjari</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44282_2488643_2490517"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft app that intercepts HTTP links to Office documents when users click on them and gives the link to the Word, Excel or PowerPoint app to open.</descrip></descripGrp><ntig><termGrp><term id="2488643">Microsoft Office Helper</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2490517">Kisaidizi cha Microsoft Office</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44283_2488671_2490584"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The area in Outlook Customer Manager where the most important deals and information on those deals are displayed.</descrip></descripGrp><ntig><termGrp><term id="2488671">Focused</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2490584">Lengwa</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44290_2488792_2496964"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The field in Outlook Customer Manager that holds the negotiable amount the provider will receive for a deal and which is finalized once the deal is closed.</descrip></descripGrp><ntig><termGrp><term id="2488792">Deal amount</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2496964">Kiwango cha mkataba</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44291_2488793_2490581"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The field in Outlook Customer Manager that records the number of deals that did not go through as well as their sum.</descrip></descripGrp><ntig><termGrp><term id="2488793">Deals lost</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2490581">Mikataba iliyopotea</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44292_2488794_2490582"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The field in Outlook Customer Manager that records the number of deals that were accepted and completed as well as their sum.</descrip></descripGrp><ntig><termGrp><term id="2488794">Deals won</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2490582">Mikataba iliyofaulu</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44293_2488795_2490580"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The field in Outlook Customer Manager that records the number of deals have not been finalized (won or lost), as well as their sum.</descrip></descripGrp><ntig><termGrp><term id="2488795">Deals active</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2490580">Mikataba amilifu</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44315_2489135_2496965"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The offer for students and educators that includes the Universal Windows Platform versions of Excel, PowerPoint, and Word, and that allows shared computer activation.</descrip></descripGrp><ntig><termGrp><term id="2489135">Office 365 Education Cart</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2496965">Toroli ya Office 365 Education</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44329_2489211_2590049"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The application available on devices you manage with Intune which is used to access company data to perform common tasks like enrolling devices, installing apps, and locating information for assistance from your IT department.</descrip></descripGrp><ntig><termGrp><term id="2489211">Intune Company Portal</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2590049">Intune Company Portal</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44329_2489211_2590113"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The application available on devices you manage with Intune which is used to access company data to perform common tasks like enrolling devices, installing apps, and locating information for assistance from your IT department.</descrip></descripGrp><ntig><termGrp><term id="2489211">Intune Company Portal</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2590113">Company Portal</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44329_2490036_2590049"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The application available on devices you manage with Intune which is used to access company data to perform common tasks like enrolling devices, installing apps, and locating information for assistance from your IT department.</descrip></descripGrp><ntig><termGrp><term id="2490036">Company Portal</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2590049">Intune Company Portal</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44329_2490036_2590113"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The application available on devices you manage with Intune which is used to access company data to perform common tasks like enrolling devices, installing apps, and locating information for assistance from your IT department.</descrip></descripGrp><ntig><termGrp><term id="2490036">Company Portal</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2590113">Company Portal</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44349_2490693_2498697"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Outlook feature that allows users to select a later time to automatically deliver emails and where said emails are stored in the Drafts folder until the time selected for sending.​</descrip></descripGrp><ntig><termGrp><term id="2490693">Send Later</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2498697">Tuma Baadaye</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44350_2490694_2503899"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The value that Excel returns when a formula returns an array of values and one or more of the cells it would spill to already has content.</descrip></descripGrp><ntig><termGrp><term id="2490694">#NOSPILL!</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2503899">#HAKUNA KUMWAGIKA!</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44351_2490695_2498692"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The value that Excel returns when a function tried to connect to a network resource or a remote service but failed.​​</descrip></descripGrp><ntig><termGrp><term id="2490695">#CONNECT!</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2498692">#UNGANISHA</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44352_2490696_2503905"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Excel cell capability that allows a cell to place array values in neighboring blank cells.</descrip></descripGrp><ntig><termGrp><term id="2490696">Spill</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2503905">Mwagika</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44355_2493977_2509922"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A container for a collection of configuration settings file with extension .ppkg. Provisioning packages are simple enough that with a short set of written instructions, a student or non-technical employee can use them to configure their device.</descrip></descripGrp><ntig><termGrp><term id="2493977">provisioning package</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2509922">kifurushi cha mipangilio ya usanidi</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44356_2493981_2509932"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The academic disciplines of science, technology, engineering and mathematics, used when addressing education policy and curriculum choices in schools.</descrip></descripGrp><ntig><termGrp><term id="2493981">STEM</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2509932">STEM</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44357_2493985_2509914"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collaborative work space, tool, app, or program for making, learning, exploring and sharing. It can refer to a literal space or place, or to digital environments where people are encouraged to create and share with a community.</descrip></descripGrp><ntig><termGrp><term id="2493985">makerspace</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2509914">nafasi ya watengenezaji</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44358_2493987_2509905"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A test with important consequences for the test taker or which is the basis of a major decision.</descrip></descripGrp><ntig><termGrp