_1389209"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Formatting applied to a heading. Microsoft Office Word has nine different built-in styles: Heading 1 through Heading 9.</descrip></descripGrp><ntig><termGrp><term id="232840">heading style</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1389209">mtindo wa kichwa</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6703_397177_1952855"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mail-enabled Active Directory user object that has mailbox attributes.</descrip></descripGrp><ntig><termGrp><term id="397177">mailbox user</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1952855">mtumiaji wa kisanduku cha barua</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6707_307425_1952776"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A zone of non-communication between distinct departments of a business or organization to prevent conflicts of interest that might result in the inappropriate release of sensitive information.</descrip></descripGrp><ntig><termGrp><term id="307425">ethical wall</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1952776">ukuta wa maadili</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6708_29444_533135"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To align objects or text around a point located in the middle of a line, page, or other defined area; in effect, to position items an equal distance from each margin or border.</descrip></descripGrp><ntig><termGrp><term id="29444">center</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="533135">weka kati</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6711_251891_2686141"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To give a unique cardinal position to each entry, as in stack rank.</descrip></descripGrp><ntig><termGrp><term id="251891">rank</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2686141">kadiria</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6711_542928_2686141"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To give a unique cardinal position to each entry, as in stack rank.</descrip></descripGrp><ntig><termGrp><term id="542928">prioritize</term><