0_179395_534045"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To manipulate an interface element, such as a toolbar or panel, in order to align it with the edge of another interface element, typically a window or pane.</descrip></descripGrp><ntig><termGrp><term id="179395">dock</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="534045">egesha</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4961_118452_1399201"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An error in the grammatical structure of the code or expression.</descrip></descripGrp><ntig><termGrp><term id="118452">syntax error</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1399201">kosa la kisintaksi</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4963_67684_1397027"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">When referring to hardware, to physically connect the device to your computer, to load device drivers onto your computer, and to configure device properties and settings.</descrip></descripGrp><ntig><termGrp><term id="67684">install</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1397027">sakinisha</term><ter