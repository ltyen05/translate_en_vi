 menu</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="533206">menyu mkato</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5002_545694_533207"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A menu that is related to the active window or item, accessible by right-clicking the mouse.</descrip></descripGrp><ntig><termGrp><term id="545694">contextual menu</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="533207">menyu ibukizi</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50021_2832808_2834692"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A student section in a Class Notebook that contains course materials distributed to students by the teacher.</descrip></descripGrp><ntig><termGrp><term id="2832808">Handouts</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2834692">Machapisho</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50047_2834194_2834690"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An effect applied to the background of a design, image or video call where the background is obscured but the speaker's image remains clear.</descrip></descripGrp><ntig><termGrp><term id="2834194">blur</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2834690">ukungu</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50047_2849656_2834690"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An effect applied to the background of a design, image or video call where the background is obscured but the speaker's image remains clear.</descrip></descripGrp><ntig><termGrp><term id="2849656">background blur</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2834690">ukungu</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5008_139790_1918359"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A modal, custom pop-up form that asks users for additional information or to display a message.</descrip></descripGrp><ntig><termGrp><term id="139790">custom dialog box</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1918359">kisanduku dadisi maalum</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50089_2834942_2836361"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in Outlook for mobile that helps users listen, triage and reply to emails while on the go (such as when travelling in a car).</descrip></descripGrp><ntig><termGrp><term id="2834942">Play My Emails</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2836361">Cheza Barua pepe Zangu</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50090_2834944_2836355"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in Excel for the web that enables users to create, run and record automated scripts in Excel and use them across platforms. By creating an Office Script, users can create background tasks that run automatically in the cloud and update their spreadsheet automatically, enabling information to continuously be up-to-date with no action required on the user's part. This helps users to run their businesses more efficiently anytime and anywhere - without needed coding knowledge.</descrip></descripGrp><ntig><termGrp><term id="2834944">Office Scripts</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2836355">Hati za Office</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50091_2834946_2836343"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Set of audit features and capabilities offered within our Microsoft 365 E3 SKU. These include providing audit logs of high-level events to help compliance reporting needs and additional features from new non-Office 365 products such as Microsoft Defender Advanced Threat Protection.</descrip></descripGrp><ntig><termGrp><term id="2834946">Audit</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2836343">Ukaguzi</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50092_2834947_2836345"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A template within Advanced eDiscovery that enables compliance officers to monitor communications for certain roles within the organization, making it easier to meet regulatory requirements or internal policies.</descrip></descripGrp><ntig><termGrp><term id="2834947">Communication compliance</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2836345">Uzingatiaji wa mawasiliano</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50093_2834948_2836344"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Office 365 feature that calls out a person’s most important to-dos and consolidates them in one convenient email to help the person better prepare for the day ahead (or specific part of the day/week depending on the settings for receiving email).</descrip></descripGrp><ntig><termGrp><term id="2834948">Briefing</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2836344">Kifupi</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50094_2834949_2836347"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Microsoft Teams, a digital bulletin board where you can pin notes, ideas, and inspiration to share in your team space.</descrip></descripGrp><ntig><termGrp><term id="2834949">Corkboard</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2836347">Ubao</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50095_2834950_2836359"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of features that work across tenant (and hybrid) boundaries, including cross-tenant people search, cross-tenant identity and data migration and data migration to/from on-premises deployments.</descrip></descripGrp><ntig><termGrp><term id="2834950">Organization Relationships</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2836359">Uhusiano wa Shirika</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50096_2834951_2836351"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An offering/program that gives end users the ability to get the full Microsoft Teams experience that their company may already have for other licensed users in their organization.</descrip></descripGrp><ntig><termGrp><term id="2834951">Microsoft Teams Exploratory</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2836351">Uchunguzi wa Microsoft Teams</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50097_2834952_2836348"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature within the Microsoft 365 security portfolio that helps prevent inappropriate or accidental copying or sharing of sensitive information that lives on endpoints (i.e. devices, specifically Windows 10 devices).</descrip></descripGrp><ntig><termGrp><term id="2834952">Endpoint Data Loss Prevention</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2836348">Uzuiaji wa Kupoteza Data ya Eneo la mwisho</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50098_2834953_2836368"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature within Microsoft Outlook and Microsoft Teams that helps users quickly close the loop on an e-mail, either by sending a quick response or by taking a suggested action, such as scheduling a meeting, creating a task, sending a file etc.</descrip></descripGrp><ntig><termGrp><term id="2834953">Suggested Actions</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2836368">Hatua Zilizopendekezwa</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50099_2834954_2836353"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A device-based license of Office 365 that will allow commercial IT admins to assign an Office 365 ProPlus license to a device rather than to a user with an AAD identity. This solution provides a device-based subscription model that mirrors the user-based subscription model in ease of management and sign-in.</descrip></descripGrp><ntig><termGrp><term id="2834954">Office 365 ProPlus (device)</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2836353">Office 365 ProPlus (kifaa)</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="501_140730_1918363"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The range of cells that you select to hold the summarized data in a consolidation. The destination area can be on the same worksheet as the source data or on a different worksheet. A worksheet can contain only one consolidation.</descrip></descripGrp><ntig><termGrp><term id="140730">destination area</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1918363">eneo la mfikio</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50100_2834955_2836364"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature within Microsoft Teams that helps a teacher make a Reading Assignment, lets the student record themselves reading, and then submit to the teacher for miscue analysis. Additionally, the computer will “listen” to the person read, and then gives computer generated “miscue analysis” feedback automatically to the teacher.</descrip></descripGrp><ntig><termGrp><term id="2834955">Reading Progress</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2836364">Maendeleo ya Usomaji</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50101_2834956_2836367"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The name of a podcast that will provide stories and advice from experts in the trenches, and give listeners access to the best of security analytics, security personalities, and security researchers.</descrip></descripGrp><ntig><termGrp><term id="2834956">Security Unlocked</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2836367">Usalama Umefunguliwa</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50102_2834957_2836342"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application mounting capability for MSIX packaged apps whereby apps are mounted to a device/virtual machine (VM) from a remote file server location and all data transfer happens over the Azure's back end.</descrip></descripGrp><ntig><termGrp><term id="2834957">MSIX app attach</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2836342">kuambatisha programu</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50102_2834957_2836352"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application mounting capability for MSIX packaged apps whereby apps are mounted to a device/virtual machine (VM) from a remote file server location and all data transfer happens over the Azure's back end.</descrip></descripGrp><ntig><termGrp><term id="2834957">MSIX app attach</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2836352">Kuambatisha programu ya MSIX</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50102_2834958_2836342"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application mounting capability for MSIX packaged apps whereby apps are mounted to a device/virtual machine (VM) from a remote file server location and all data transfer happens over the Azure's back end.</descrip></descripGrp><ntig><termGrp><term id="2834958">app attach</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2836342">kuambatisha programu</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50102_2834958_2836352"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application mounting capability for MSIX packaged apps whereby apps are mounted to a device/virtual machine (VM) from a remote file server location and all data transfer happens over the Azure's back end.</descrip></descripGrp><ntig><termGrp><term id="2834958">app attach</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2836352">Kuambatisha programu ya MSIX</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50103_2834961_2836349"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A service offering that enables enterprise customers to become the controller (GDPR) for Windows diagnostic data collected from devices enrolled under this service. With this service, data will be governed by Microsoft’s Online Services Terms, and stored in a high compliance boundary, separate from Windows diagnostic data that Microsoft collects as controller.</descrip></descripGrp><ntig><termGrp><term id="2834961">Enterprise Data Processor Service for Windows</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2836349">Huduma ya Kichakataji cha Data ya Kampuni Kubwa kwa Windows</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50105_2834963_2836366"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Office 365 feature that detects when a reply-all or conversation mail storm is brewing in your mail service and temporarily blocks subsequent reply-alls to the thread while issuing a bounce back message (NDR) to the sender who is attempting to reply all. After a "cool down" period (e.g. 2 to 4 hours), the feature will remove the block and allow emails on the thread again (some exceptions can be made during the cool down).</descrip></descripGrp><ntig><termGrp><term id="2834963">Reply-All Storm Protection</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2836366">Ulinzi Mkubwa wa Kujibu Wote</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50115_2835484_2839501"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A page in the Office 365 Security &amp; Compliance Center where the user can turn on audit logging and search the unified audit log to view user and administrator activity in the Office 365 organization.</descrip></descripGrp><ntig><termGrp><term id="2835484">Audit log search</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2839501">Utafutaji wa kumbukumbu za ukaguzi</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50116_2835485_2839504"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To tap a device screen twice and on the second tap, hold one's finger or stylus in place.</descrip></descripGrp><ntig><termGrp><term id="2835485">double tap and hold</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2839504">donoa mara mbili na ushikilie</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50117_2835490_2839548"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A regular telephone number meant for a single user to receive and place calls. User numbers can be assigned to any PSTN Calling user.</descrip></descripGrp><ntig><termGrp><term id="2835490">user number</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2839548">nambari ya mtumiaji</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50118_2835492_2839539"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Skype telephone number that is used for audio conferencing, auto attendants, or a call queue</descrip></descripGrp><ntig><termGrp><term id="2835492">service number</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2839539">nambari ya huduma</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50122_2835501_2839524"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Chat running during the meeting and related to the meeting topic.</descrip></descripGrp><ntig><termGrp><term id="2835501">meeting chat</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2839524">gumzo la mkutano</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50124_2835509_2839509"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A civic address--with an optional place</descrip></descripGrp><ntig><termGrp><term id="2835509">emergency location</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2839509">eneo la dharura</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50124_2835509_2839513"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A civic address--with an optional place</descrip></descripGrp><ntig><termGrp><term id="2835509">emergency location</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2839513">eneo la majibu ya dharura</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50124_2835509_2839517"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A civic address--with an optional place</descrip></descripGrp><ntig><termGrp><term id="2835509">emergency location</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2839517">ERL</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50124_2835527_2839509"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A civic address--with an optional place</descrip></descripGrp><ntig><termGrp><term id="2835527">emergency response location</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2839509">eneo la dharura</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50124_2835527_2839513"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A civic address--with an optional place</descrip></descripGrp><ntig><termGrp><term id="2835527">emergency response location</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2839513">eneo la majibu ya dharura</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50124_2835527_2839517"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A civic address--with an optional place</descrip></descripGrp><ntig><termGrp><term id="2835527">emergency response location</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2839517">ERL</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50124_2835531_2839509"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A civic address--with an optional place</descrip></descripGrp><ntig><termGrp><term id="2835531">ERL</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2839509">eneo la dharura</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50124_2835531_2839513"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A civic address--with an optional place</descrip></descripGrp><ntig><termGrp><term id="2835531">ERL</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2839513">eneo la majibu ya dharura</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50124_2835531_2839517"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A civic address--with an optional place</descrip></descripGrp><ntig><termGrp><term id="2835531">ERL</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2839517">ERL</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50125_2835510_2839508"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A civic address--the physical or street address of a place of business for your organization that is used to route emergency calls to the appropriate dispatch authorities and to assist in locating the emergency caller.</descrip></descripGrp><ntig><termGrp><term id="2835510">emergency address</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2839508">anwani ya dharura</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50127_2835544_2841528"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The public organizations whose job is to take quick action to deal with emergencies when they occur, especially the fire brigade, the police, and the ambulance service.</descrip></descripGrp><ntig><termGrp><term id="2835544">emergency services</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2841528">huduma za dharura</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50128_2835552_2839515"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A function - when enabled, Teams retrieves policy and location information from the service and includes that information as part of the emergency call.</descrip></descripGrp><ntig><termGrp><term id="2835552">enhanced emergency services</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2839515">huduma za dhurura zilizoboreshwa</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50130_2835555_2839546"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A measured employee that interacts with other collaborators in meetings and with email.</descrip></descripGrp><ntig><termGrp><term id="2835555">time investor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2839546">mwekezaji wa muda</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50131_2835558_2839523"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The employees to whom your Workplace Analytics administrator assigned licenses during setup. After license assignment, Workplace Analytics extracts Office 365 data about meetings, email, unscheduled calls, and instant messages for these people. If you are an analyst or limited analyst, this is the population that you can analyze within Workplace Analytics. The number of measured employees can help determine whether you have good data coverage for analysis.</descrip></descripGrp><ntig><termGrp><term id="2835558">measured employee</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2839523">mwajiriwa aliye na leseni</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50132_2835563_2839506"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A number that identifies an emergency location.</descrip></descripGrp><ntig><termGrp><term id="2835563">Emergency Location Identification Number</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2839506">ELIN</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50132_2835563_2839511"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A number that identifies an emergency location.</descrip></descripGrp><ntig><termGrp><term id="2835563">Emergency Location Identification Number</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2839511">Nambari ya Utambulisho ya Eneo la Dharura</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50132_2835565_2839506"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A number that identifies an emergency location.</descrip></descripGrp><ntig><termGrp><term id="2835565">ELIN</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2839506">ELIN</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50132_2835565_2839511"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A number that identifies an emergency location.</descrip></descripGrp><ntig><termGrp><term id="2835565">ELIN</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2839511">Nambari ya Utambulisho ya Eneo la Dharura</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50133_2835566_2839552"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The time between the person's first email or meeting and the last email or meeting in a day, counted from Monday to Friday, with a minimum of four hours and a maximum of 16 hours per day.</descrip></descripGrp><ntig><termGrp><term id="2835566">workweek span</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2839552">kipindi cha wiki ya kazi</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50134_2835567_2839502"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A number that translates into the value of the emergency dial string.</descrip></descripGrp><ntig><termGrp><term id="2835567">dial mask</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2839502">barakoa ya upigaji</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50136_2835569_2839518"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Non-scheduled business time periods that last less than two hours.</descrip></descripGrp><ntig><termGrp><term id="2835569">fragmented hours</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2839518">saa zilizogawanywa</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50138_2835571_2839525"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Typically a floor, building, wing, or office number. Place is associated with an emergency address to give a more exact location within a building.</descrip></descripGrp><ntig><termGrp><term id="2835571">place</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2839525">eneo</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50139_2835572_2839534"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An emergency address that is assigned to each Calling Plan user; it is sometimes referred to as a static emergency address or address of record.</descrip></descripGrp><ntig><termGrp><term id="2835572">registered address</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2839534">anwani iliyosajiliwa</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5015_358327_1397115"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of taking a single-table database and breaking it into a set of smaller, related tables, with each table focused on a single topic or grouping of information.</descrip></descripGrp><ntig><termGrp><term id="358327">normalization</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1397115">uchambuaji</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50150_2836048_2839498"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The speed at which an object rotates or revolves relative to another position, such as with respect to the x, y, and z axes. It is measured with a gyrometer.</descrip></descripGrp><ntig><termGrp><term id="2836048">angular velocity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2839498">kasi ya kipembe</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50151_2836049_2839521"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A sensor that measures angular velocity.</descrip></descripGrp><ntig><termGrp><term id="2836049">gyrometer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2839521">Mita ya giro</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50152_2836052_2839496"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A sensor that returns G-force values with respect to the x, y, and z axes.</descrip></descripGrp><ntig><termGrp><term id="2836052">accelerometer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2839496">mita ya kuzidisha mwendo</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50153_2836056_2839520"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Gravitational force equivalent - A measurement of the type of force per unit mass – typically acceleration – that causes a perception of weight.</descrip></descripGrp><ntig><termGrp><term id="2836056">G-force</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2839520">Nguvu za uvutano</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50156_2836765_2841858"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A search carried out on the audit log to view user and administrator activity in an Office 365 organization, for example, to find if a user viewed a specific document or purged an item from their mailbox.</descrip></descripGrp><ntig><termGrp><term id="2836765">audit log search</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2841858">utafutaji wa batli ya ukaguzi</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50158_2836783_2851678"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Microsoft's multilingual machine translation cloud service, offering both text and speech translation, which is integrated across multiple consumer, developer, and enterprise products.</descrip></descripGrp><ntig><termGrp><term id="2836783">Microsoft Translator</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2851678">Mtafsiri wa Microsoft</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50159_2836785_2851688"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Microsoft Translator app designed for use by teachers, students and parents in education. Used for language translation but also for students who are deaf or hard of hearing, dyslexic, or having trouble taking notes.</descrip></descripGrp><ntig><termGrp><term id="2836785">Translator for Education</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2851688">Mtafsiri kwa Elimu</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50187_2838775_2841863"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An approach to machine translation that uses an artificial neural network to predict the likelihood of a sequence of words, typically modeling entire sentences in a single integrated model.</descrip></descripGrp><ntig><termGrp><term id="2838775">neural machine translation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2841863">tafsiri ya mashine ya neva</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50187_2838775_2841864"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An approach to machine translation that uses an artificial neural network to predict the likelihood of a sequence of words, typically modeling entire sentences in a single integrated model.</descrip></descripGrp><ntig><termGrp><term id="2838775">neural machine translation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2841864">NMT</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50187_2839428_2841863"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An approach to machine translation that uses an artificial neural network to predict the likelihood of a sequence of words, typically modeling entire sentences in a single integrated model.</descrip></descripGrp><ntig><termGrp><term id="2839428">NMT</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2841863">tafsiri ya mashine ya neva</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50187_2839428_2841864"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An approach to machine translation that uses an artificial neural network to predict the likelihood of a sequence of words, typically modeling entire sentences in a single integrated model.</descrip></descripGrp><ntig><termGrp><term id="2839428">NMT</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2841864">NMT</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50188_2839431_2841854"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in Excel that records actions performed on an Excel sheet and saves them to a script. Henceforth, the actions can be performed automatically by running the script.</descrip></descripGrp><ntig><termGrp><term id="2839431">Action Recorder</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2841854">Rekoda ya Kitendo</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50189_2839432_2841867"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Name of an Excel dialog used to start the the Action Recorder.</descrip></descripGrp><ntig><termGrp><term id="2839432">Record Actions</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2841867">Rekodi Vitendo</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50190_2839434_2841860"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Name of a feature in Excel that allows users to edit scripts.</descrip></descripGrp><ntig><termGrp><term id="2839434">Code Editor</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2841860">Kihariri cha Msimbo</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50194_2839796_2841856"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tool used to set a Yammer network to native mode, to address any network incompatibilities, to provide information on the quantity and usage of private unlisted groups in the network, and other functions.</descrip></descripGrp><ntig><termGrp><term id="2839796">Alignment Tool</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2841856">Zana ya Mpangilio</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50195_2839821_2841855"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A report that provides information about the quantity and usage of external groups, files previously uploaded in private messages, the activity of network guests, and other information a Yammer network.</descrip></descripGrp><ntig><termGrp><term id="2839821">Alignment Report</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2841855">Ripoti ya Mpangilio</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50196_2839890_2841859"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An entity that shares the controller role with another entity to ensure GDPR compliance.</descrip></descripGrp><ntig><termGrp><term id="2839890">co-controller</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2841859">mdhibiti mwenza</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50196_2839890_2841862"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An entity that shares the controller role with another entity to ensure GDPR compliance.</descrip></descripGrp><ntig><termGrp><term id="2839890">co-controller</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2841862">mdhibiti wa pamoja</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammati