art voice nav</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2119062">anza uabiri sauti</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35723_2067029_2119062"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The option that provides driving or walking directions to the user where the app provides both spoken and visual instructions at the right time for the user to act on those instructions.</descrip></descripGrp><ntig><termGrp><term id="2067029">turn-by-turn</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2119062">anza uabiri sauti</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35724_2067030_2118786"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A camera option that enables users to capture moving subjects by snapping multiple photos on shutter press and allowing the user to pick the best one or just accept the photo recommended by the software.</descrip></descripGrp><ntig><termGrp><term id="2067030">burst mode</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2118786">modi ya mpasuko</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpee