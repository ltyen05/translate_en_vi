descripGrp><ntig><termGrp><term id="1231848">Bing</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1376678">Bing</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25905_1231849_1376679"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Windows Mobile header link that opens a menu that contains more options.</descrip></descripGrp><ntig><termGrp><term id="1231849">Do more</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1376679">Kutenda zaidi</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25906_1231850_1376680"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The link to the website where customers add computers (both PCs and Macs), mobile phones, and digital photo frames so they can access their synced folders and connect remotely to their devices.</descrip></descripGrp><ntig><termGrp><term id="1231850">Devices</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1376680">Vifaa</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural<