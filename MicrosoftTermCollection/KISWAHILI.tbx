The feature set that integrates data protection at the platform level so as to protect corporate data against inadvertent disclosure to unauthorized users and public services through email, social media and public cloud. It includes encryption of enterprise data when it enters the device or is created on the device, such that data stays protected against disclosure to applications and endpoints outside enterprise control.</descrip></descripGrp><ntig><termGrp><term id="2405212">Windows Information Protection</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2405751">Kilinzi cha Maelezo ya Windows</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4050_95643_533636"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A standard set of formats and procedures that enable computers to exchange information.</descrip></descripGrp><ntig><termGrp><term id="95643">protocol</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="533636">itifaki</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40502_2353112_2353220"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app that consumers can use to send feedback to the Windows team, to check for responses to that feedback, and to get news about the latest updates.</descrip></descripGrp><ntig><termGrp><term id="2353112">Windows Feedback Hub</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2353220">Kitovu cha Majibu ya Windows</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40502_2353112_2353221"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app that consumers can use to send feedback to the Windows team, to check for responses to that feedback, and to get news about the latest updates.</descrip></descripGrp><ntig><termGrp><term id="2353112">Windows Feedback Hub</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2353221">Kitovu cha Majibu</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40502_2353113_2353220"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app that consumers can use to send feedback to the Windows team, to check for responses to that feedback, and to get news about the latest updates.</descrip></descripGrp><ntig><termGrp><term id="2353113">Feedback Hub</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2353220">Kitovu cha Majibu ya Windows</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="gramma