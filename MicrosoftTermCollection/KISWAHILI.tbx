ermGrp><term id="232419">secondary calendar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="1918485">kalenda ya upili</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9067_3665_532950"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A software package that replaces an existing version of a product or a feature with a newer and/or more powerful or sophisticated version of the same product or feature. The upgrade process typically leaves existing customer data and preferences intact while replacing the existing software with the newer version.</descrip></descripGrp><ntig><termGrp><term id="3665">upgrade</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="532950">sombezo</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9067_3665_532951"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A software package that replaces an existing version of a product or a feature with a newer and/or more powerful or sophisticated version of the same product or feature. The upgrade process typically leaves existing customer data and preferences intact while replacing the existing software with the newer version.</descrip></descripGrp><ntig><termGrp><term id="3665">upgrade</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Sing