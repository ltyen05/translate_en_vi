Note type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37779_2157426_2346302"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An image file type in which a very short video is followed by a transition to a still image. The combination of video and still image captures the essence of the moment.</descrip></descripGrp><ntig><termGrp><term id="2157426">living image</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2346302">taswira hai</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37780_2157427_2177839"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A photo that illustrates motion by blurring together multiple frames of a short video to create the effect of motion in the still image.</descrip></descripGrp><ntig><termGrp><term id="2157427">motion focus</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2177839">ulengaji mwendo</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37781_2157428_2177341"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The top level view in File Explorer that shows the user's most frequently used and most recently used files and folders or folders pinned by the user for quick access.</descrip></descri