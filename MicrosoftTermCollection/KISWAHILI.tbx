siness data, allows users to respond and interact with the data, and provides an aggregation framework on the data.</descrip></descripGrp><ntig><termGrp><term id="2509123">Kaizala Action</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2657937">Kaizala Kitendo</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44609_2643390_2657932"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A structured message that captures business data, allows users to respond and interact with the data, and provides an aggregation framework on the data.</descrip></descripGrp><ntig><termGrp><term id="2643390">Action</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2657932">Kitendo</term><termNote type="geographicalUsage">KEN, TZA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44609_2643390_2657937"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A structured message that captures business data, allows users to respond and interact with the data, and provides an aggregation framework on the data.</descrip></descripGrp><ntig><termGrp><term id="2643390">Action</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sw"><ntig><termGrp><term id="2657937">Kaizala Kitendo</term><termNote type="geographicalUsage">KE