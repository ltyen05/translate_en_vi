ammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2420196">Explorador del Graph</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42683_2420215_2421991"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Excel function which looks in a particular column of a table for a column lookup value and in a particular row for a row lookup value, and when both are found, returns the value in the cell at the intersection of the row and column.</descrip></descripGrp><ntig><termGrp><term id="2420215">VHLOOKUP</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2421991">BUSCARVH</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42684_2420713_2421605"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft To-do feature that allows users to choose different backgrounds and that gives them the choice of paying for additional background options.</descrip></descripGrp><ntig><termGrp><term id="2420713">Theme</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2421605">Tema</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</ter