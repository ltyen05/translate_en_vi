efinition">A message generated by Microsoft Dynamics CRM when an event occurs, or a message created by a CRM user.</descrip></descripGrp><ntig><termGrp><term id="1567770">post</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1586272">missatge</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="30899_1567771_1586250"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Part of a post that refers to a Microsoft Dynamics CRM record.</descrip></descripGrp><ntig><termGrp><term id="1567771">mention</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1586250">menció</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="30900_1567772_1586201"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To track content, people, or entities by adding them to a list of things for which you would like to surface updates about changes and activities.</descrip></descripGrp><ntig><termGrp><term id="1567772">follow</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1586201">seguir</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNum