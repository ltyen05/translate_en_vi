ular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1143724">instal·lació personalitzada</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11926_41721_1143724"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of installation that allows the user to specify certain installation settings and options, such as which components will be installed.</descrip></descripGrp><ntig><termGrp><term id="41721">custom install</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1143724">instal·lació personalitzada</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11936_23875_1546121"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The amount of light that is emitted by a computer monitor or picture displayed on the monitor.</descrip></descripGrp><ntig><termGrp><term id="23875">brightness</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1546121">brillantor</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11940_298006_327307"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The application that is used to open an attachment for Attachment Previewing.</descrip></descripGrp><ntig><termGrp><term id="298006">Attachment Previewer</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="327307">Visualitzador previ de fitxers adjunts</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11947_65138_1555436"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In an environment capable of displaying multiple on-screen windows, any window other than the one currently being used for work. An inactive window can be partially or entirely hidden behind another window, and it remains inactive until the user selects it.</descrip></descripGrp><ntig><termGrp><term id="65138">inactive window</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1555436">finestra no activa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11961_180264_1381850"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A trust relationship between two or more SIP domains that permits users in separate organizations to communicate in real time across network boundaries.</descrip></descripGrp><ntig><termGrp><term id="180264">federation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1381850">federació</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11973_157418_1143725"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An attempt to run a memory operation that the underlying page protection does not allow. An access violation applies to memory operations, but does not apply when the security manager checks user-mode access rights to objects.</descrip></descripGrp><ntig><termGrp><term id="157418">access violation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1143725">infracció d'accés</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11974_148915_2095195"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Visual Basic for Applications (VBA) procedure that carries out an operation, but unlike a Function procedure, does not return a value.</descrip></descripGrp><ntig><termGrp><term id="148915">Sub procedure</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2095195">procediment Sub</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11975_124844_2857345"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The language developed by Grady Booch, Ivar Jacobson, and Jim Rumbaugh of Rational Software that can be used for specifying, building, and documenting software and non-software systems, such as business models.</descrip></descripGrp><ntig><termGrp><term id="124844">UML</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2857345">Unified Modeling Language</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11975_124844_2857346"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The language developed by Grady Booch, Ivar Jacobson, and Jim Rumbaugh of Rational Software that can be used for specifying, building, and documenting software and non-software systems, such as business models.</descrip></descripGrp><ntig><termGrp><term id="124844">UML</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2857346">UML</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11975_124845_2857345"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The language developed by Grady Booch, Ivar Jacobson, and Jim Rumbaugh of Rational Software that can be used for specifying, building, and documenting software and non-software systems, such as business models.</descrip></descripGrp><ntig><termGrp><term id="124845">Unified Modeling Language</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2857345">Unified Modeling Language</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11975_124845_2857346"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The language developed by Grady Booch, Ivar Jacobson, and Jim Rumbaugh of Rational Software that can be used for specifying, building, and documenting software and non-software systems, such as business models.</descrip></descripGrp><ntig><termGrp><term id="124845">Unified Modeling Language</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2857346">UML</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11976_185681_1381849"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An item on the right-click menu for the Communicator icon that appears in the Windows taskbar that signs the user out of Communicator and closes all open Communicator windows and dialog boxes.</descrip></descripGrp><ntig><termGrp><term id="185681">Exit</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1381849">Surt</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11984_210509_1271595"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The tool used to create an expression. It includes a list of common expressions that you can select from to define the properties you want to target.</descrip></descripGrp><ntig><termGrp><term id="210509">Expression Builder</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1271595">Generador d'expressions</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11991_39848_512457"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To duplicate data and reproduce it in another part of a document, in a different file or memory location, or in a different medium.</descrip></descripGrp><ntig><termGrp><term id="39848">copy</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="512457">copiar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11999_233421_1143726"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A directory that you can use to store names, email addresses, fax numbers, and distribution lists.</descrip></descripGrp><ntig><termGrp><term id="233421">Address Book</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig>