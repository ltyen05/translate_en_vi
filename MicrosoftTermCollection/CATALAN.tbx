ammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1297_85711_1546161"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An advanced file system designed for use specifically with the Windows NT operating system. It supports long filenames, full security access control, file system recovery, extremely large storage media, and various features for the Windows NT POSIX subsystem. It also supports object-oriented applications by treating all files as objects with user-defined and system-defined attributes.</descrip></descripGrp><ntig><termGrp><term id="85711">NTFS file system</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1546161">NTFS</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13004_112592_2723281"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To bind an identity, such as a network login, hardware ID, or certificate, to a message, file, or other piece of digitally encoded information.</descrip></descripGrp><ntig><termGrp><term id="112592">sign</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2723281">signar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13007_111882_1143862"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A color that is mixed with black. A 10-percent shade is one part of the original color and nine parts black.</descrip></descripGrp><ntig><termGrp><term id="111882">shade</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1143862">ombra</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13016_346958_1143863"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature of partial control parents get over the accounts and devices of their children helping them supervise how their children behave online and letting them restrict what their children see.</descrip></descripGrp><ntig><termGrp><term id="346958">parental controls</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1143863">controls parentals</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13018_475236_1307842"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A pricing method that determines the unit price of the product is calculated as a percent markup of the current cost or standard cost that was entered in the Current Cost field on the Product form.</descrip></descripGrp><ntig><termGrp><term id="475236">percent markup</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1307842">per