rmGrp></ntig></langSet></termEntry><termEntry id="46601_2621936_2623524"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft 365 portal that contains Microsoft 365 security and compliance features.</descrip></descripGrp><ntig><termGrp><term id="2621936">Security &amp; Compliance Center</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2623524">Centre de seguretat i compliment</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46602_2621937_2623519"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The dashboard in the Microsoft 365 admin center where admins can manage desktop related workloads, policy controls, user groups, software updates, device enrolment, as well as where they can update analytics.</descrip></descripGrp><ntig><termGrp><term id="2621937">Device Management</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2623519">Administració de dispositius</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46602_2621937_2692402"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The dashboard in the Microsoft 365 admin center where admins can manage desktop related workloads, policy controls, user groups, software updates, device enrolment, as well as where they can update analytics.</descrip></descripGrp><ntig><termGrp><term id="2621937">Device Management</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2692402">Administració de dispositius del Microsoft 365</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46602_2690753_2623519"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The dashboard in the Microsoft 365 admin center where admins can manage desktop related workloads, policy controls, user groups, software updates, device enrolment, as well as where they can update analytics.</descrip></descripGrp><ntig><termGrp><term id="2690753">Microsoft 365 device management</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2623519">Administració de dispositius</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46602_2690753_2692402"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The dashboard in the Microsoft 365 admin center where admins can manage desktop related workloads, policy controls, user groups, software updates, device enrolment, as well as where they can update analytics.</descrip></descripGrp><ntig><termGrp><term id="2690753">Microsoft 365 device management</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2692402">Administració de dispositius del Microsoft 365</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46603_2621938_2623525"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Device Management dashboard that provides admins with aggregated device insights, which enables them to identify health patterns related to performance degradation, policy conflicts, login choices etc., so that they can assist in support and helpdesk scenarios.</descrip></descripGrp><ntig><termGrp><term id="2621938">Device Health</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2623525">Estat del dispositiu</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46604_2685859_2686590"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Device Management portal that provides admins with a guided workflow experience to help them adopt a faster update cadence by reducing the number of tests necessary to validate apps, drivers, add-ins, and macros.</descrip></descripGrp><ntig><termGrp><term id="2685859">Desktop Analytics</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2686590">Anàlisi d'escriptori</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46617_2623853_2625016"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To move an email into a user's inbox from quarantine.</descrip></descripGrp><ntig><termGrp><term id="2623853">release</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2625016">alliberar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46618_2623854_2625015"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A cyber attack where an intruder engages with the targeted system to gather information about vulnerabilities or steal login information.</descrip></descripGrp><ntig><termGrp><term id="2623854">reconnaissance</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2625015">reconeixement</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46620_2623856_2624159"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An attack where an attacker attempts to log in into all accounts across a specific domain using only one password, thus avoiding being locked out of any one account.</descrip></descripGrp><ntig><termGrp><term id="2623856">password spray attack</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</t