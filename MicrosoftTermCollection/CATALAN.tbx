mNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37889_2168877_2171777"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of authentication mechanisms which includes authenticating users with both on-premises and cloud-hosted Office services, single sign-on authentication (including against third party identity providers) so that passwords are not sent directly to Office 365, and multi-factor authentication.</descrip></descripGrp><ntig><termGrp><term id="2168877">modern authentication</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2171777">autenticació moderna</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3789_90732_2094811"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of query that, when you run it, prompts for values (criteria) to use to select the records for the result set so that the same query can be used to retrieve different result sets.</descrip></descripGrp><ntig><termGrp><term id="90732">parameter query</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2094811">consulta de paràmetres</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37890_2168878_2171781"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The API that enables developers to create, re