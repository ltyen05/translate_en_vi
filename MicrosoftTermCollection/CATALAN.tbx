ographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28794_1496272_1955229"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A part of the Bing search engine dedicated to music.</descrip></descripGrp><ntig><termGrp><term id="1496272">Bing Music</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1955229">Música del Bing</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28795_1496276_1955237"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A part of the Bing search engine dedicated to weather.</descrip></descripGrp><ntig><termGrp><term id="1496276">Bing Weather</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1955237">El temps del Bing</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28805_1496323_2681319"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A systematic organization of classes.</descrip></descripGrp><ntig><termGrp><term id="1496323">classification</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2681319">classificació</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28817_3128889_3128905"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The site program for Microsoft partners.</descrip></descripGrp><ntig><termGrp><term id="3128889">Microsoft AI Cloud Partner Program</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3128905">Microsoft AI Cloud Partner Program</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28835_1496380_2330306"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Microsoft partner who is associated with one or more companies and authorized to provide certain administrative tasks for said companies. A delegated administrator may be the same or different than a customer’s subscription advisor. Referred to within Microsoft as a “delegated administrator partner (DAP).”</descrip></descripGrp><ntig><termGrp><term id="1496380">delegated administrator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2330306">admin. delegat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28835_1496380_2330307"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Microsoft partner who is associated with one or more companies and authorized to provide certain administrative tasks for said companies. A delegated administrator may be the same or different than a customer’s subscription advisor. Referred to within Microsoft as a “delegated administrator partner (DAP).”</descrip></descripGrp><ntig><termGrp><term id="1496380">delegated administrator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2330307">administrador delegat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28835_2259813_2330306"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Microsoft partner who is associated with one or more companies and authorized to provide certain administrative tasks for said companies. A delegated administrator may be the same or different than a customer’s subscription advisor. Referred to within Microsoft as a “delegated administrator partner (DAP).”</descrip></descripGrp><ntig><termGrp><term id="2259813">delegated admin</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2330306">admin. delegat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28835_2259813_2330307"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Microsoft partner who is