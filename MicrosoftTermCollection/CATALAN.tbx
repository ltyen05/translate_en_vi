:lang="en-US"><descripGrp><descrip type="definition">Chat running during the meeting and related to the meeting topic.</descrip></descripGrp><ntig><termGrp><term id="2835501">meeting chat</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2838698">xat de la reunió</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50124_2835509_2838677"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A civic address--with an optional place</descrip></descripGrp><ntig><termGrp><term id="2835509">emergency location</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2838677">ubicació d'emergència</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50124_2835509_2838682"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A civic address--with an optional place</descrip></descripGrp><ntig><termGrp><term id="2835509">emergency location</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2838682">ubicació de resposta d'emergència</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></term