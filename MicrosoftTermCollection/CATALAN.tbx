ngular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5606_51615_2829999"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mathematical statement that indicates equality with the use of an equal sign (=) between two expressions. In programming languages, assignment statements are written in equation form.</descrip></descripGrp><ntig><termGrp><term id="51615">equation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2829999">equació</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5607_318742_1144360"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user’s assessment of how good they think a particular piece of content or product is.</descrip></descripGrp><ntig><termGrp><term id="318742">rating</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1144360">classificació del contingut</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56078_3152915_3153025"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The fourth day of the Islamic holiday that marks the end of Ramadan.</descrip></descripGrp><ntig><termGrp><term id="3152915">Eid al Fitr (4th Day)</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3153025">Eid-ul-Fitr (4t dia)</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56079_3152916_3153028"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The fifth day  of the Islamic holiday that marks the end of Ramadan.</descrip></descripGrp><ntig><termGrp><term id="3152916">Eid al Fitr (5th Day)</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3153028">Eid-ul-Fitr (5è dia)</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5608_264890_325439"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A template that outlines a strategic approach for product development. By understanding your business position in the marketplace, establishing product infrastructure, and a knowledge of your targets and competitors, this template establishes a framework to begin product development.</descrip></descripGrp><ntig><termGrp><term id="264890">Product Development Planning</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="325439">Planificació del desenvolupament d'un producte</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56080_3152917_3153030"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The second day of the two-day holiday that commemorates the formation of the United Arab Emirates.</descrip></descripGrp><ntig><termGrp><term id="3152917">National Day (2nd Day)</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3153030">Diada Nacional (2n dia)</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56081_3153497_3153506"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature within Dynamics 365 Supply Chain Management designed for companies engaged in international trade of goods. It helps them monitor and adhere to both internal policies and external regulations. The solution lets them express these rules, even complex ones, by using formulas that are similar to the formulas in Microsoft Excel. It guarantees that these rules are consistently followed during the entire sales and fulfillment procedure.</descrip></descripGrp><ntig><termGrp><term id="3153497">Export Control</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3153506">Control d'exportació</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56082_3153688_3153815"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The version of Microsoft Teams used in workplace and education contexts.</descrip></descripGrp><ntig><termGrp><term id="3153688">Microsoft Teams (work or school)</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3153815">Microsoft Teams (laboral o acadèmic)</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56082_3153688_3153816"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The version of Microsoft Teams used in workplace and education contexts.</descrip></descripGrp><ntig><termGrp><term id="3153688">Microsoft Teams (work or school)</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3153816">Teams (laboral o acadèmic)</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56082_3153689_3153815"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The version of Microsoft Teams used in workplace and education contexts.</descrip></descripGrp><ntig><termGrp><term id="3153689">Teams (work or school)</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3153815">Microsoft Teams (laboral o acadèmic)</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNum