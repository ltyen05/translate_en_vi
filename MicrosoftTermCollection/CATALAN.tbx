tion">A domain that is engaged in a trust relationship with another domain, which is also called a federation. This relationship is between two federation servers, and allows a system to provide controlled access to its resources or services to a user that belongs to another security realm without requiring the user to authenticate directly to the system and without the two systems sharing a database of user identities or passwords.</descrip></descripGrp><ntig><termGrp><term id="1926326">trusted domain</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2118102">domini de confiança</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26365_1273680_1367586"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A conversation that you are currently having, as opposed to a past conversation.</descrip></descripGrp><ntig><termGrp><term id="1273680">current conversation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1367586">conversa actual</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2638_557741_1322053"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An element of workflow logic that specifies the event or task that should be performed by the workflow jobs started by the workflow.</descrip></descripGrp><ntig><termGrp><term id="557741">workflow action</term><termNot