Grp><term id="1637192">task path</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1663920">camí de tasques</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32157_1637193_1663902"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A streamlined process for sharing Office documents with others.</descrip></descripGrp><ntig><termGrp><term id="1637193">simplified sharing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1663902">ús compartit simplificat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32159_1637282_1663896"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A website that provides content and resources to help developers create custom solutions for SharePoint Foundation, SharePoint Server and SharePoint Designer.</descrip></descripGrp><ntig><termGrp><term id="1637282">SharePoint Developer Center</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1663896">Centre per a desenvolupadors del SharePoint</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32160_1637588_1663837"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process that converts a PDF file to flowing text and document elements that are native to the application being used.</descrip></descripGrp><ntig><termGrp><term id="1637588">PDF reflow</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1663837">redistribució de PDF</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32161_1637594_1663942"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SharePoint shared service that aggregates tasks that systems such as SharePoint, Project Server, and Exchange assign to users.</descrip></descripGrp><ntig><termGrp><term id="1637594">Work Management Service</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1663942">Servei d'administració de feina</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32162_1637597_1663943"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A component of the Work Management Service that synchronizes tasks with systems outside of SharePoint, such as an Exchange mailbox, to enable task management in Outlook.</descrip></descripGrp><ntig><termGrp><term id="1637597">Work Management Task Sync</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1663943">Sincronització de tasques d'administració de feina</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32164_1637809_1663862"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A touch-friendly, contextual control that presents commands in a circular arrangement.</descrip></descripGrp><ntig><termGrp><term id="1637809">radial menu</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1663862">menú circular</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32165_1637810_1663897"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A security model in which Project Server permissions are derived from SharePoint.</descrip></descripGrp><ntig><termGrp><term id="1637810">SharePoint integrated permission model</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1663897">model de permisos integrats del SharePoint</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32166_1637811_1663851"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A security model in which permissions are assigned directly in Project Server using global and category permissions.</descrip></descripGrp><ntig><termGrp><term id="1637811">Project Server permission model</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1663851">model de permisos del Project Server</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32167_1637812_1663904"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A gallery of HTML code snippets for common components that can be customized and added to SharePoint designs.</descrip></descripGrp><ntig><termGrp><term id="1637812">Snippet Gallery</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1663904">Galeria de fragments</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32168_1637813_1662834"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A callout that is invoked through contextual UI to display reference data, such as definitions and synonyms, for the word selected.</descrip></descripGrp><ntig><termGrp><term id="1637813">definitions callout</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1662834">crida de definicions</term><termNote type="geographicalUsage">ESP</termNote><ter