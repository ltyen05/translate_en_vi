ubjecte a</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19881_690307_760873"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To request payment for products and/or services sold.</descrip></descripGrp><ntig><termGrp><term id="690307">bill</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="760873">facturar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19882_690312_760874"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The provisions applicable to invoicing.</descrip></descripGrp><ntig><termGrp><term id="690312">billing terms</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="760874">condicions de facturació</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19883_690314_760875"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The failure to perform an obligation.</descrip></descripGrp><ntig><termGrp><term id="690314">breach of an obligation</term><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="760875">incompliment d'una obligació</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19884_690315_760876"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The failure to perform any of the obligations under a contract.</descrip></descripGrp><ntig><termGrp><term id="690315">breach of contract</term><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="760876">incompliment de contracte</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19885_690320_760880"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">When referring to a Microsoft volume licensing program, the option to obtain perpetual licenses for products licensed on a subscription basis under an agreement or enrollment.</descrip></descripGrp><ntig><termGrp><term id="690320">buy-out option</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="760880">opció de compra completa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19886_690322_760886"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A formal request for a remedy or to uphold a right.</descrip></descripGrp><ntig><termGrp><term id="690322">claim</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="760886">reclamació</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19887_690324_760887"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To make a formal request for a remedy or to uphold a right.</descrip></descripGrp><ntig><termGrp><term id="690324">claim</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="760887">reclamar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19888_690605_760889"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">When referring to a Microsoft volume licensing agreement, any product Microsoft makes available for license for a fee.</descrip></descripGrp><ntig><termGrp><term id="690605">commercial product</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="760889">producte comercial</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19889_690606_760892"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The adherence to the terms and conditions of a Microsoft license agreement, e.g., having sufficient licenses or having ordered sufficient licenses to permit all usage of a product.</descrip></descripGrp><ntig><termGrp><term id="690606">compliance</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="760892">compliment</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1989_48436_1537162"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An area of storage that is formatted with a file system and has an identifier to access it.</descrip></descripGrp><ntig><termGrp><term id="48436">drive</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1537162">unitat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19890_690607_760893"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Substantiation that terms and conditions of a Microsoft license agreement are being or were adhered to, e.g. substantiation that a customer has sufficient licenses or has ordered sufficient licenses to permit all usage of a product.</descrip></descripGrp><ntig><termGrp><term id="690607">compliance verification</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="760893">verificació del compliment</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19891_690608_760896"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Knowledge that a party to an agreement may not disclose, unless such disclosure is permitted pursuant to the confidentiality provisions of that agreement.</descrip></descripGrp><ntig><termGrp><term id="690608">confidential information</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="760896">informació confidencial</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19892_690609_760897"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The quality of confidential information.</descrip></descripGrp><ntig><termGrp><term id="690609">confidentiality</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="760897">confidencialitat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19893_690610_760898"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Losses that are an indirect but foreseeable consequence of an act.</descrip></descripGrp><ntig><termGrp><term id="690610">consequential damages</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="760898">danys conseqüencials</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19894_690611_760903"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An individual designated as the go-to person for all matters pertaining to the administration of an agreement or a specific part of an agreement.</descrip></descripGrp><ntig><termGrp><term id="690611">contact</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="760903">contacte</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19895_690612_761083"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft entity entering into the agreement.</descrip></descripGrp><ntig><termGrp><term id="690612">Microsoft contracting affiliate</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761083">filial de Microsoft contractant</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19896_690613_760904"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The rights given to the creator of an original work, such as a text, a piece of art or a computer program, which is fixed on a tangible medium, to reproduce or to authorize the reproduction of that original work.</descrip></descripGrp><ntig><termGrp><term id="690613">copyright</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="760904">propietat intel·lectual</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19897_690614_760906"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In reference to a Microsoft volume licensing agreement, a license that allows customers to access Microsoft Windows Server, Microsoft Exchange Server, Microsoft SharePoint Portal Server, and Microsoft Systems Management Server through a single device.</descrip></descripGrp><ntig><termGrp><term id="690614">core CAL</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="760906">Core CAL</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19898_690615_760913"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The person or entity with whom Microsoft enters into an agreement to license products or sell services.</descrip></descripGrp><ntig><termGrp><term id="690615">customer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="760913">client</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19899_690616_760919"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The date on which an agreement is renewed.</descrip></descripGrp><ntig><termGrp><term id="690616">date of renewal</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="760919">data de pròrroga</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19900_690617_760922"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">When referring to a Microsoft volume licensing agreement, the primary customer contact who will receive all notices from Microsoft unless it informs Microsoft otherwise.</descrip></descripGrp><ntig><termGrp><term id="690617">default administrator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="760922">administrador predeterminat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19901_690618_760935"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A client access license that allows users to access Microsoft server software through a single device.</descrip></descripGrp><ntig><termGrp><term id="690618">device CAL</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="760935">CAL de dispositiu</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19902_690619_760936"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Losses that flow directly and immediately from an act.</descrip></descripGrp><ntig><termGrp><term id="690619">direct damages</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="760936">danys directes</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19903_690620_760942"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To show visual output on a screen.</descrip></descripGrp><ntig><termGrp><term id="690620">display</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="760942">mostrar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19904_690622_760944"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To supply licenses to resellers or customers and end users.</descrip></descripGrp><ntig><termGrp><term id="690622">distribute</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="760944">distribuir</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19905_690623_760945"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The splitting-off and sale of certain assets or business interests of a company.</descrip></descripGrp><ntig><termGrp><term id="690623">divestiture</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="760945">desinversió</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19906_690624_760949"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The consequences of an agreement terminating.</descrip></descripGrp><ntig><termGrp><term id="690624">effect of termination</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="760949">efecte de la resolució</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19907_690625_760950"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The date on which an agreement enters into force and becomes applicable. Typically the date on which Microsoft accepts the agreement.</descrip></descripGrp><ntig><termGrp><term id="690625">effective date</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="760950">data d'entrada en vigor</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19908_690626_760956"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The date on which an agreement ends.</descrip></descripGrp><ntig><termGrp><term id="690626">end date</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="760956">data final</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19909_690627_760960"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An entity that has entered into an enrollment with Microsoft.</descrip></descripGrp><ntig><termGrp><term id="690627">enrolled affiliate</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="760960">filial inscrita</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19910_690628_760961"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In reference to Microsoft volume licensing, a document signed by a volume licensing customer which provides the basic information for the acquisition of licenses under a specific program. An enrollment is typically entered into either by a customer that has an agreement with Microsoft for that specific program, or one of its affiliates.</descrip></descripGrp><ntig><termGrp><term id="690628">enrollment</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="760961">inscripció</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19911_690629_760962"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The length of time an enrollment remains in effect.</descrip></descripGrp><ntig><termGrp><term id="690629">enrollment term</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="760962">període d'inscripció</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19912_690630_760963"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To accept the terms of and become a party to an agreement.</descrip></descripGrp><ntig><termGrp><term id="690630">enter into an agreement</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="760963">celebrar un contracte</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19913_690631_760964"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In reference to a Microsoft volume licensing agreement, a company or public sector entity that has entered into a licensing agreement with Microsoft and the affiliates it chooses to include within the scope of that license agreement. Customer will define the scope of its enterprise in the relevant volume licensing agreement or enrollment.</descrip></descripGrp><ntig><termGrp><term id="690631">enterprise</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="760964">empresa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19914_690632_760974"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A distinct economic unit with economic or legal existence separate from those who manage it.</descrip></descripGrp><ntig><termGrp><term id="690632">entity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="760974">entitat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19914_690632_761058"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A distinct economic unit with economic or legal existence separate from those who manage it.</descrip></descripGrp><ntig><termGrp><term id="690632">entity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761058">persona jurídica</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19914_692590_760974"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A distinct economic unit with economic or legal existence separate from those who manage it.</descrip></descripGrp><ntig><termGrp><term id="692590">legal entity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="760974">entitat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19914_692590_761058"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A distinct economic unit with economic or legal existence separate from those who manage it.</descrip></descripGrp><ntig><termGrp><term id="692590">legal entity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761058">persona jurídica</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19915_690633_760978"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The only means to obtain redress for an infringement or to impose or safeguard a right.</descrip></descripGrp><ntig><termGrp><term id="690633">exclusive remedy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="760978">únic remei</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19916_690634_760979"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The coming to an end of an agreement.</descrip></descripGrp><ntig><termGrp><term id="690634">expiration</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="760979">expiració</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19917_690635_760980"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The date on which the term of an agreement expires.</descrip></descripGrp><ntig><termGrp><term id="690635">expiration date</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="760980">data d'expiració</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19918_690636_760981"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The jurisdiction governing the exportation of Microsoft products.</descrip></descripGrp><ntig><termGrp><term id="690636">export jurisdiction</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="760981">jurisdicció en matèria d'exportacions</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1992_108620_1770094"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A program that searches for key words in documents, databases, Internet content or other files.</descrip></descripGrp><ntig><termGrp><term id="108620">search engine</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1770094">motor de cerca</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19920_690656_760987"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">When referring to a court, the court that hands down the definitive judgment in relation to a dispute; also the judgment or decision given.</descrip></descripGrp><ntig><termGrp><term id="690656">final adjudication</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="760987">sentència ferma i definitiva</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19921_690659_760991"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">When used in an agreement, events beyond the parties' control that may prevent or delay performance of the contract by one or both parties.</descrip></descripGrp><ntig><termGrp><term id="690659">force majeure</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="760991">força major</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19922_690660_760993"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A false statement made by a party prior to the conclusion of a contract, where that party did not believe in the truthfulness of the statement and used it to persuade the other party to enter into the contract.</descrip></descripGrp><ntig><termGrp><term id="690660">fraudulent misrepresentation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="760993">falsa manifestació fraudulenta</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19923_690661_760995"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">When referring to a Microsoft volume licensing agreement, the supply of volume licensing software media.</descrip></descripGrp><ntig><termGrp><term id="690661">fulfillment</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="760995">subministrament</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19924_690662_760996"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A license that relates to the complete version of a software product and not an upgrade or an update.</descrip></descripGrp><ntig><termGrp><term id="690662">full license</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="760996">llicència completa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19925_690663_761005"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An entity organized within the national/regional or local public administration of a country/region or state.</descrip></descripGrp><ntig><termGrp><term id="690663">government entity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761005">entitat pública</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19926_690664_761019"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">When referring to the terms of a contract, where a provision is not explicitly agreed to by the parties but is automatically imposed by a statute or is imposed by a court to implement the intent of the parties.</descrip></descripGrp><ntig><termGrp><term id="690664">implied</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761019">implícit</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19927_690665_761024"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In conformity to or in alignment with something.</descrip></descripGrp><ntig><termGrp><term id="690665">in accordance with</term><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761024">d'acord amb</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19928_690666_761026"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">By means of written communication.</descrip></descripGrp><ntig><termGrp><term id="690666">in writing</term><termNote type="partOfSpeech">Adverb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761026">per escrit</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19929_690667_761027"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Commercially reasonable charges that flow from the other party's breach of contract e.g. the cost to a seller of stopping delivery of goods or the cost to a buyer of storing goods following breach by the other party.</descrip></descripGrp><ntig><termGrp><term id="690667">incidental damages</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761027">danys incidentals</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19930_690668_761031"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Losses under a contract that do not flow directly and immediately from an act.</descrip></descripGrp><ntig><termGrp><term id="690668">indirect damages</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761031">danys indirectes</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19931_690669_761034"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An act that violates an intellectual property right.</descrip></descripGrp><ntig><termGrp><term id="690669">infringement</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761034">infracció de drets</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19932_690671_761035"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">When referring to a Microsoft volume licensing agreement, the first order for licenses submitted by the customer along with its volume licensing agreement or enrollment.</descrip></descripGrp><ntig><termGrp><term id="690671">initial order</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761035">comanda inicial</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19933_690672_761039"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The amount due as one of several payments, the total sum of which will make up the full price of a product, license or service.</descrip></descripGrp><ntig><termGrp><term id="690672">installments of the price</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761039">terminis del preu</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19934_690673_761049"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A court's power, right or authority to rule on a matter.</descrip></descripGrp><ntig><termGrp><term id="690673">jurisdiction</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761049">jurisdicció</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19935_690674_761052"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An offering that may be purchased under Microsoft Volume Licensing agreements that covers both the license for a Microsoft software product ordered and Software Assurance coverage for that product.</descrip></descripGrp><ntig><termGrp><term id="690674">L&amp;SA</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761052">L&amp;SA (Llicència i Software Assurance)</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19935_690674_761064"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An offering that may be purchased under Microsoft Volume Licensing agreements that covers both the license for a Microsoft software product ordered and Software Assurance coverage for that product.</descrip></descripGrp><ntig><termGrp><term id="690674">L&amp;SA</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761064">Llicència i Software Assurance</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19935_690681_761052"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An offering that may be purchased under Microsoft Volume Licensing agreements that covers both the license for a Microsoft software product ordered and Software Assurance coverage for that product.</descrip></descripGrp><ntig><termGrp><term id="690681">License and Software Assurance</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761052">L&amp;SA (Llicència i Software Assurance)</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19935_690681_761064"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An offering that may be purchased under Microsoft Volume Licensing agreements that covers both the license for a Microsoft software product ordered and Software Assurance coverage for that product.</descrip></descripGrp><ntig><termGrp><term id="690681">License and Software Assurance</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761064">Llicència i Software Assurance</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19936_690675_761055"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of rules that govern a society and that may be enforced.</descrip></descripGrp><ntig><termGrp><term id="690675">laws and regulations</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761055">lleis i reglaments</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19937_690676_761056"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To convey, pursuant to a contract, the right to use real or personal property or services over a limited amount of time and for some form of payment.</descrip></descripGrp><ntig><termGrp><term id="690676">lease</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761056">llogar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19939_690678_761060"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To grant the right to use property or money on the assumption that it will be eventually returned or paid back.</descrip></descripGrp><ntig><termGrp><term id="690678">lend</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761060">prestar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19940_690679_761061"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The state or attribute of being liable i.e. legally obligated, responsible or accountable.</descrip></descripGrp><ntig><termGrp><term id="690679">liability</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761061">responsabilitat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19941_690680_761063"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To grant a person or entity the right to use a software product, as described in the terms of the license agreement.</descrip></descripGrp><ntig><termGrp><term id="690680">license</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761063">llicenciar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19948_692523_761066"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The conveyance to a person or entity of the right to use software in a particular way, as described in the terms of the license agreement.</descrip></descripGrp><ntig><termGrp><term id="692523">license grant</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761066">concessió de llicències</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19949_692527_761069"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A restriction on liability agreed to by the parties to an agreement or imposed by law.</descrip></descripGrp><ntig><termGrp><term id="692527">limitation of liability</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761069">limitació de responsabilitat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19950_692529_761070"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A warranty applicable to a product that is subject to certain restrictions, which are agreed to by the parties to an agreement or imposed by law.</descrip></descripGrp><ntig><termGrp><term id="692529">limited product warranty</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761070">garantia limitada per als productes</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19951_692533_761074"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Breach of an obligation by a party which is substantial enough to relieve the other party of its continued performance of the contract and giving it the right to terminate and sue for damages.</descrip></descripGrp><ntig><termGrp><term id="692533">material breach of an obligation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761074">incompliment greu d'una obligació</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19952_692534_761078"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">When applicable to a product sold, a standard of quality that would be reasonably expected by a person in that trade.</descrip></descripGrp><ntig><termGrp><term id="692534">merchantability</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761078">satisfacció</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19953_692535_761079"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The combination of two or more companies into a single new company.</descrip></descripGrp><ntig><termGrp><term id="692535">merger</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761079">fusió</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19954_692536_761080"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Microsoft employee who is the primary contact for the business relationship between the customer and Microsoft.</descrip></descripGrp><ntig><termGrp><term id="692536">Microsoft account manager</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761080">gestor de comptes de Microsoft</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19955_692537_761082"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">When referring to a Microsoft volume licensing agreement, an approved manufacturer and supplier of Microsoft volume licensing software media.</descrip></descripGrp><ntig><termGrp><term id="692537">Microsoft approved fulfillment source</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761082">font de subministrament aprovada per Microsoft</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19956_692538_1546540"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Microsoft volume licensing contract available for small and mid-sized companies that provides a license grant on a subscription basis.</descrip></descripGrp><ntig><termGrp><term id="692538">Open Value Subscription Agreement</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1546540">Contracte d'Open Value Subscription</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19957_692539_761113"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft volume licensing contract available for small and mid-sized companies that provides a license grant on a perpetual basis.</descrip></descripGrp><ntig><termGrp><term id="692539">Open Value Agreement</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761113">Contracte Open Value</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19958_692542_761090"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The copying or appropriation of information, an idea, a creation or any other item which is not protected by any exclusive intellectual or other property right, where the plaintiff has made a considerable investment of time and money to create the item, the defendant has appropriated it at no or very little cost, and the appropriation has allowed the defendant to compete unfairly and to cause some injury to the plaintiff.</descrip></descripGrp><ntig><termGrp><term id="692542">misappropriation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761090">violació de secrets empresarials</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19959_692543_761091"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The customer contact who will receive communication concerning registration for Microsoft Developer Network products ordered under a volume licensing agreement.</descrip></descripGrp><ntig><termGrp><term id="692543">MSDN contact</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761091">contacte per a MSDN</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1996_237386_327287"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of creating/receiving, organizing, retaining, preserving, and accessing time-registered, fixed-content information that an organization generates or receives and must retain and manage throughout its complete lifecycle for business purposes.</descrip></descripGrp><ntig><termGrp><term id="237386">records management</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="327287">gestió de registres</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19960_692544_761094"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The legal name of the entity referred to.</descrip></descripGrp><ntig><termGrp><term id="692544">name of entity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761094">nom de l'entitat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19961_692545_761097"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Culpable carelessness; failure to meet the standard of care in doing something or in failing to do something that a reasonably prudent person would exercise in the same or similar circumstances.</descrip></descripGrp><ntig><termGrp><term id="692545">negligence</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761097">negligència</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19962_692554_761102"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The quality or state of being non-exclusive.</descrip></descripGrp><ntig><termGrp><term id="692554">non-exclusivity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761102">absència d'exclusivitat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19963_692557_761103"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Where an act does not violate an intellectual property right.</descrip></descripGrp><ntig><termGrp><term id="692557">non-infringing</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761103">absència d'infracció</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19964_692558_761104"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A software product where Microsoft does not own the related intellectual property rights.</descrip></descripGrp><ntig><termGrp><term id="692558">non-Microsoft product</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761104">producte que no és de Microsoft</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19965_692559_761105"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Formal notifications provided by one party to a contract to the other party relating to an event impacting the contract or its performance.</descrip></descripGrp><ntig><termGrp><term id="692559">notices</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761105">notificacions</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19966_692561_761106"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The customer contact who receives formal notifications relating to the customer's contract with Microsoft and who has the right to connect to various websites in order to administer that contract.</descrip></descripGrp><ntig><termGrp><term id="692561">notices and online access contact</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761106">contacte per a notificacions i accés online</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19967_692563_761107"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">For a party to a contract, to provide formal notice to the other party of an event impacting the contract or its performance.</descrip></descripGrp><ntig><termGrp><term id="692563">notify</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761107">notificar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19968_692564_761108"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A legal duty to do something.</descrip></descripGrp><ntig><termGrp><term id="692564">obligation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761108">obligació</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19969_692565_761110"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A connection to the Internet or an intranet.</descrip></descripGrp><ntig><termGrp><term id="692565">online access</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761110">accés online</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19970_692566_761116"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To make a request for the supply of software licenses based on specified terms.</descrip></descripGrp><ntig><termGrp><term id="692566">order</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761116">sol·licitar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19971_692568_761122"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The set of rights over property, including the right to use and manage it and to decide how it shall be used.</descrip></descripGrp><ntig><termGrp><term id="692568">ownership</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761122">titularitat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19972_692571_761124"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A natural person or legal entity that forms one side of an agreement with another person or entity.</descrip></descripGrp><ntig><termGrp><term id="692571">party</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761124">part</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19973_2903617_761130"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A license right that is permanent and is intended to last indefinitely.</descrip></descripGrp><ntig><termGrp><term id="2903617">perpetual</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761130">llicència perpètua</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19973_692573_761130"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A license right that is permanent and is intended to last indefinitely.</descrip></descripGrp><ntig><termGrp><term id="692573">perpetual license</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761130">llicència perpètua</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19974_692575_761131"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An injury to an individual person.</descrip></descripGrp><ntig><termGrp><term id="692575">personal injury</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761131">danys corporals</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19975_692576_761134"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A core software product available under a Microsoft Enterprise or Open Value Agreement which, if licensed, must be standardized across all desktops included under the agreement; platform products include the Microsoft Operating System, Office and CALs, - the edition depends on the Volume Licensing Program.</descrip></descripGrp><ntig><termGrp><term id="692576">platform product</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761134">producte de plataforma</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19976_692579_761136"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">When referring to Microsoft volume licensing agreements, a category of applicable prices for resellers or customers, depending on the number of licenses ordered, purchased or forecasted under an agreement.</descrip></descripGrp><ntig><termGrp><term id="692579">price level</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761136">nivell de preus</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="gram