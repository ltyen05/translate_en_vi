2898941_2008366"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A unique bank registration number that a bank uses to identify itself.</descrip></descripGrp><ntig><termGrp><term id="2898941">bank routing code</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2008366">codi bancari</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11859_2898941_2008425"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A unique bank registration number that a bank uses to identify itself.</descrip></descripGrp><ntig><termGrp><term id="2898941">bank routing code</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2008425">número de trànsit bancari</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11860_182783_1276281"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The documents that are created with specific information about products and/or services and given to customers to help increase sales.</descrip></descripGrp><ntig><termGrp><term id="182783">sales literature</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1276281">documentació de vendes</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11862_237303_327298"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of property that allows authors to specify the values of several properties with a single property. For instance, the 'font' property is a shorthand property for setting 'font-style', 'font-variant', 'font-weight', 'font-size', 'line-height', and 'font-family' all at once.</descrip></descripGrp><ntig><termGrp><term id="237303">shorthand property</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="327298">propietat abreviada</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11864_184585_1381783"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A field label for the identifier of a conference that is conducted through a conferencing service provider.</descrip></descripGrp><ntig><termGrp><term id="184585">Conference ID</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1381783">ID de conferència</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1187_142174_2094984"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file containing data, where each field has a fixed width.</descrip></descripGrp><ntig><termGrp><term id="142174">fixed-width text file</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2094984">fitxer de text d'amplària fixa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11872_51841_1548076"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A keyboard key that sends the escape (ESC) character to the computer. Often this key moves the user back one level in the menu structure or exits the program.</descrip></descripGrp><ntig><termGrp><term id="51841">ESC key</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1548076">tecla Esc</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11873_94938_761140"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A customer's right to control how and to what extent their personal information is collected and used and with whom it is shared.</descrip></descripGrp><ntig><termGrp><term id="94938">privacy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761140">privacitat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11884_123946_1963697"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A logical relationship established between domains to allow pass-through authentication, in which a trusting domain honors the logon authentications of a trusted domain.</descrip></descripGrp><ntig><termGrp><term id="123946">trust relationship</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1963697">relació de confiança</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11886_1995807_2009364"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An identification number that is issued by a tax authority to indicate that a company is not required to pay sales tax.</descrip></descripGrp><ntig><termGrp><term id="1995807">exempt ID</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2009364">ID exempt</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11886_235021_2009364"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An identification number that is issued by a tax authority to indicate that a company is not required to pay sales tax.</descrip></descripGrp><ntig><termGrp><term id="235021">tax exempt number</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><la