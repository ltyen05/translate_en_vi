descripGrp><ntig><termGrp><term id="777477">restricted account</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1097837">compte restringit</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21442_777482_1098395"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An abstract grouping of similar transition effects.</descrip></descripGrp><ntig><termGrp><term id="777482">transition style</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1098395">estil de transició</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21443_1133579_1166038"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A full-page UI view that exposes file-level functionality in Office applications. This is a companion feature to the Office Ribbon and helps users discover and use the features that fall outside of the authoring features on the Ribbon.</descrip></descripGrp><ntig><termGrp><term id="1133579">Backstage view</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1166038">visualització Backstage</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNot