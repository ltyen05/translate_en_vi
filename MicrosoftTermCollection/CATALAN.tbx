pe="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2213652">saldo</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2301_616949_2368666"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An amount that is the difference between the sum of debit entries and the sum of credit entries entered into an account during a financial period.</descrip></descripGrp><ntig><termGrp><term id="616949">balance</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2368666">balanç del compte</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2301_616949_2368686"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An amount that is the difference between the sum of debit entries and the sum of credit entries entered into an account during a financial period.</descrip></descripGrp><ntig><termGrp><term id="616949">balance</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2368686">balanç</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23055_1057442_2520700"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of transistor in which the flow of current between the source and the drain is modulated by the electric field around the gate electrode. FETs are used as amplifiers, oscillators, and switches and are characterized by an extremely high input impedance (resistance) that makes them particularly suitable for amplification of very small signals. Types of FETs include the junction FET and the metal-oxide semiconductor FET (MOSFET).</descrip></descripGrp><ntig><termGrp><term id="1057442">FET</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2520700">FET</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23055_1057443_2520700"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of transistor in which the flow of current between the source and the drain is modulated by the electric field around the gate electrode. FETs are used as amplifiers, oscillators, and switches and are characterized by an extremely high input impedance (resistance) that makes them particularly suitable for amplification of very small signals. Types of FETs include the junction FET and the metal-oxide semiconductor FET (MOSFET).</descrip></descripGrp><ntig><termGrp><term id="1057443">field-effect transistor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2520700">FET</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2306_210486_364137"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The formal name for Word 12 file format. This format has an open, royalty-free specification, and is the technology licensed to external parties. This license is the subject in the messaging points where “Open, royalty-free license” is discussed.</descrip></descripGrp><ntig><termGrp><term id="210486">Word XML Format</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="364137">Format XML del Word</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23068_1057655_1098278"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Web analytics report that identifies terms that should become Best Bets.</descrip></descripGrp><ntig><termGrp><term id="1057655">Best Bet Suggestions report</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1098278">informe de suggeriments d'opcions més probables</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23069_1057656_1098279"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Web analytics report that identifies the Best Bet terms and how they are utilized by the system.</descrip></descripGrp><ntig><termGrp><term id="1057656">Best Bet Usage report</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1098279">informe d'ús d'opcions més probables</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23092_1058116_1098305"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that ensures that all components of a file are preserved, even if they are supported only by the rich client and not viewable in Web Companions.</descrip></descripGrp><ntig><termGrp><term id="1058116">Document Integrity</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1098305">Integritat del document</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23093_1058130_1231844"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that simplifies the task of creating new SharePoint data. It makes it easier for users to enter free-form information or add photos, Web Parts or files to a SharePoint page.</descrip></descripGrp><ntig><termGrp><term id="1058130">Web Edit</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1231844">Edició web</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2314_117926_1550697"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To change between states or modes.</descrip></descripGrp><ntig><termGrp><term id="117926">switch</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1550697">canviar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23154_1060415_2520705"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A common type of field-effect transistor in which a layer of silicon dioxide insulates the metal gate from the semiconductor current channel. MOSFETs have extremely high input impedance and therefore require almost no driving power. They are used in many audio applications, including high-gain amplifier circuits. Like all metal-oxide semiconductor (MOS) devices, MOSFETs are easily damaged by static electricity.</descrip></descripGrp><ntig><termGrp><term id="1060415">MOSFET</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2520705">MOSFET</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23154_1060416_2520705"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A common type of field-effect transistor in which a layer of silicon dioxide insulates the metal gate from the semiconductor current channel. MOSFETs have extremely high input impedance and therefore require almost no driving power. They are used in many audio applications, including high-gain amplifier circuits. Like all metal-oxide semiconductor (MOS) devices, MOSFETs are easily damaged by static electricity.</descrip></descripGrp><ntig><termGrp><term id="1060416">metal-oxide semiconductor field-effect transistor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2520705">MOSFET</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23155_1060417_1098324"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A team site template that provides group collaboration capabilities based on standard business practices. Integrated functions include a group calendar, Whereabouts, Announcements, Phone Call Memo, and Schedule and Reservations.</descrip></descripGrp><ntig><termGrp><term id="1060417">Group Work Site</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1098324">Lloc de grup de treball</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23155_1060942_1098324"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A team site template that provides group collaboration capabilities based on standard business practices. Integrated functions include a group calendar, Whereabouts, Announcements, Phone Call Memo, and Schedule and Reservations.</descrip></descripGrp><ntig><termGrp><term id="1060942">GroupBoard Workspace</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1098324">Lloc de grup de treball</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2316_138366_2735660"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A format that can be applied to selected text characters.</descrip></descripGrp><ntig><termGrp><term id="138366">character formatting</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2735660">format de caràcters</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23160_1060428_1098325"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that collects and logs SharePoint health indicators and usage metrics for analysis and reporting purposes.</descrip></descripGrp><ntig><termGrp><term id="1060428">Usage and Health Data Collection</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1098325">Compilació de dades d'utilització i estat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23172_1060958_1097895"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A company that provides servers, Internet connectivity, and other associated facilities needed to publish websites.</descrip></descripGrp><ntig><termGrp><term id="1060958">website host</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1097895">proveïdor de serveis d'internet</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23173_1060960_1097893"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mobile phone that can view web content by connecting directly to the Internet.</descrip></descripGrp><ntig><termGrp><term id="1060960">web-enabled mobile phone</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1097893">telèfon mòbil habilitat per a Internet</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23174_1060963_1097883"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The heading for information about the time at which something was added, changed, or re-posted.</descrip></descripGrp><ntig><termGrp><term id="1060963">updated</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1097883">actualització</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23175_1060964_1097882"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A number used as a unique identifier for each Windows Live ID holder. This number is disclosed to residents of the European Union to comply with EU privacy regulations.</descrip></descripGrp><ntig><termGrp><term id="1060964">unique ID</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1097882">Identificador únic</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23176_1060968_1097876"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An adjustment made to improve working order or efficiency.</descrip></descripGrp><ntig><termGrp><term id="1060968">tune-up</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1097876">ajustament</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23177_1060970_1097870"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A customizable page that launches with Windows Live Messenger and features a summary of news and weather, allows a customer to preview their Windows Live Mail inbox and search the Internet.</descrip></descripGrp><ntig><termGrp><term id="1060970">Today page</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1097870">pàgina Avui</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23178_1060971_1097869"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The title of the window in which the Windows Live Messenger Today page is displayed.</descrip></descripGrp><ntig><termGrp><term id="1060971">Today</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1097869">Avui</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23179_1060972_1097868"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The part of a message header that contains the email addresses of the primary recipients of an email message.</descrip></descripGrp><ntig><termGrp><term id="1060972">To line</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1097868">Línia "Per a"</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23180_1060974_1097867"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A text box where someone enters the email addresses of the primary recipients of an email message.</descrip></descripGrp><ntig><termGrp><term id="1060974">To box</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1097867">Quadre "Per a"</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23181_1060975_1097856"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">One of the two unlabeled keys located just below the display area on a mobile phone. These keys are called "soft" because their functions change to fit the context. Labels in the lower part of the mobile screen tell users what the soft keys do.</descrip></descripGrp><ntig><termGrp><term id="1060975">soft key</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1097856">tecla variable</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23181_1060976_1097856"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">One of the two unlabeled keys located just below the display area on a mobile phone. These keys are called "soft" because their functions change to fit the context. Labels in the lower part of the mobile screen tell users what the soft keys do.</descrip></descripGrp><ntig><termGrp><term id="1060976">softkey</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1097856">tecla variable</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23182_1060977_1097855"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature of Windows Live Toolbar that provides additional information for particular kinds of text someone selects.</descrip></descripGrp><ntig><termGrp><term id="1060977">Smart Menus</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1097855">Menús intel·ligents</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23183_1060978_1097851"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The button allowing the user to reveal or conceal information on a screen, such as webpage modules or details about a person.</descrip></descripGrp><ntig><termGrp><term id="1060978">show/hide</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1097851">Mostra/amaga</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23184_1060982_1098292"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of features that enables users to improve the quality of their images with just one or two clicks. Galleries help the user optimize characteristics such as brightness, contrast, color, and sharpness.</descrip></descripGrp><ntig><termGrp><term id="1060982">Corrections</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1098292">Correccions</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23185_1060986_1097848"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The button that enables someone to simultaneously send the messages they have composed and retrieve the new messages they've received.</descrip></descripGrp><ntig><termGrp><term id="1060986">Send/Receive</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1097848">Envia/rep</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23186_1060988_1097841"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A fraudulent business scheme; a swindle.</descrip></descripGrp><ntig><termGrp><term id="1060988">scam</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1097841">estafa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23187_1060992_1097909"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in Live Search that provides answers to basic search queries, such as "What is the population of Mumbai?"</descrip></descripGrp><ntig><termGrp><term id="1060992">Instant Answers</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1097909">Respostes instantànies</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23200_1062908_1098291"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables Tablet PC users to convert an ink drawing to a standard OfficeArt shape, which can be formatted with colors and effects exactly as if it were inserted using “Insert Shape.”</descrip></descripGrp><ntig><termGrp><term id="1062908">Convert to Shape</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1098291">convertir en forma</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23201_1062909_1098369"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables presenters to capture all the elements of a live presentation, including narration, slides, mouse clicks, A/V playback, and laser pointer highlights. The user can select which presentation aspects to record.</descrip></descripGrp><ntig><termGrp><term id="1062909">Record Slide Show</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1098369">Enregistrar presentació de diapositives</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23214_1064085_1649522"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A map view created from aerial photos that shows buildings, roads, and geographical features.</descrip></descripGrp><ntig><termGrp><term id="1064085">aerial view</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1649522">visualització aèria</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23214_1064085_1821417"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A map view created from aerial photos that shows buildings, roads, and geographical features.</descrip></descripGrp><ntig><termGrp><term id="1064085">aerial view</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1821417">vista aèria</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2323_61200_3042587"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to the base-16 number system represented by the digits 0 through 9 and the uppercase or lowercase letters A (equivalent to decimal 10) through F (equivalent to decimal 15). Hexadecimal values are commonly used in HTML code to identify colors.</descrip></descripGrp><ntig><termGrp><term id="61200">hex</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3042587">hexadecimal</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2323_61201_3042587"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to the base-16 number system represented by the digits 0 through 9 and the uppercase or lowercase letters A (equivalent to decimal 10) through F (equivalent to decimal 15). Hexadecimal values are commonly used in HTML code to identify colors.</descrip></descripGrp><ntig><termGrp><term id="61201">hexadecimal</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3042587">hexadecimal</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23243_1064712_1230158"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A form of Launcher that scrolls from right to left and displays both a strip of smaller application icon images on the sides, and a single larger application preview image in the center.</descrip></descripGrp><ntig><termGrp><term id="1064712">filmstrip</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1230158">tira d'imatges</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2328_21412_1768906"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To associate two pieces of information with one another.</descrip></descripGrp><ntig><termGrp><term id="21412">bind</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1768906">enllaçar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23319_1072508_2431239"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The XML-based vector image format for two-dimensional graphics that supports interactivity and animation and that maintains an image's appearance regardless of screen size or print size.</descrip></descripGrp><ntig><termGrp><term id="1072508">Scalable Vector Graphics</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2431239">SVG</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23319_1072508_2497719"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The XML-based vector image format for two-dimensional graphics that supports interactivity and animation and that maintains an image's appearance regardless of screen size or print size.</descrip></descripGrp><ntig><termGrp><term id="1072508">Scalable Vector Graphics</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2497719">Gràfic vectorial escalable</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23319_1072509_2431239"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The XML-based vector image format for two-dimensional graphics that supports interactivity and animation and that maintains an image's appearance regardless of screen size or print size.</descrip></descripGrp><ntig><termGrp><term id="1072509">SVG</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2431239">SVG</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23319_1072509_2497719"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The XML-based vector image format for two-dimensional graphics that supports interactivity and animation and that maintains an image's appearance regardless of screen size or print size.</descrip></descripGrp><ntig><termGrp><term id="1072509">SVG</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2497719">Gràfic vectorial escalable</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23331_1073321_1098367"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A slide show mode that displays content in a manageable window that can be resized and features navigation buttons. This mode is optimized for reviewing presentations, allowing users to get the full experience, complete with animations and media, while performing other tasks, such as taking notes.</descrip></descripGrp><ntig><termGrp><term id="1073321">Reading View</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1098367">Visualització de lectura</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23333_1087526_1098334"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows users to easily add links to content within other content (e.g. pages, sections, section groups) and provides quick navigation through these links. The feature operates in the same manner that links work in wikis.</descrip></descripGrp><ntig><termGrp><term id="1087526">linking</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1098334">enllaç</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23334_1073349_1098400"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that highlights new or changed content in a shared notebook that the user has not yet read.</descrip></descripGrp><ntig><termGrp><term id="1073349">Unread Changes</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1098400">modificacions no llegides</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23336_1073640_1098273"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that identifies the author of unread new or changed content in a shared notebook.</descrip></descripGrp><ntig><termGrp><term id="1073640">Author Marks</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1098273">Marques d'autor</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23355_1074783_1098283"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Web Part that implements Web chart controls to visually display information in a variety of chart types in SharePoint.</descrip></descripGrp><ntig><termGrp><term id="1074783">Chart Web Part</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1098283">element web gràfic</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23361_1074891_2072372"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The combination of hardware (touchscreen or touchpad) and software elements that provides a way to control programs by touching multiple points on the screen simultaneously.</descrip></descripGrp><ntig><termGrp><term id="1074891">multi-touch</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2072372">multitàctil</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23373_1075911_1098290"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Macintosh utility that allows basic system settings to be customized. In Macintosh computers running System 6, a cdev is a utility program placed in the system folder. Keyboard and mouse cdevs are preinstalled. Other cdevs are provided with software packages and utilities. In System 7, cdevs are called control panels.</descrip></descripGrp><ntig><termGrp><term id="1075911">cdev</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1098290">dispositiu del tauler de control</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23373_1075916_1098290"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Macintosh utility that allows basic system settings to be customized. In Macintosh computers running System 6, a cdev is a utility program placed in the system folder. Keyboard and mouse cdevs are preinstalled. Other cdevs are provided with software packages and utilities. In System 7, cdevs are called control panels.</descrip></descripGrp><ntig><termGrp><term id="1075916">control panel device</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1098290">dispositiu del tauler de control</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23377_1075958_1098338"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A system table that captures failures and other events for Access Services.</descrip></descripGrp><ntig><termGrp><term id="1075958">logging table</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1098338">taula d'enregistrament</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23386_1077181_2714365"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A virtual object that is similar in shape to playing cards.</descrip></descripGrp><ntig><termGrp><term id="1077181">card</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2714365">targeta</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="234_237832_1549286"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An object created using drawing tools or commands.</descrip></descripGrp><ntig><termGrp><term id="237832">shape</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1549286">forma</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23402_1078950_2917187"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A technology that includes systems, services, and standards for the interactive delivery of streaming video to multimedia clients such as digital set-top boxes.</descrip></descripGrp><ntig><termGrp><term id="1078950">video on demand</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2917187">VoD</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23402_1078952_2917187"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A technology that includes systems, services, and standards for the interactive delivery of streaming video to multimedia clients such as digital set-top boxes.</descrip></descripGrp><ntig><termGrp><term id="1078952">VOD</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2917187">VoD</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23403_1080482_1821055"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A predefined collection of audio files (for example, songs) from a CD or digital download.</descrip></descripGrp><ntig><termGrp><term id="1080482">album</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1821055">àlbum</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23413_1080643_1098260"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that allows administration of Access services through an administration interface and PowerShell scripts.</descrip></descripGrp><ntig><termGrp><term id="1080643">Access Services Administration</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1098260">Administració de serveis d'Access</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2342_138389_1136475"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The entire chart and all its elements.</descrip></descripGrp><ntig><termGrp><term id="138389">chart area</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1136475">àrea del gràfic</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23423_1081688_1359777"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Windows 9x, Windows NT, and Windows 2000, a handle to a Registry key in which configuration information is stored. Each key leads to sub-keys containing configuration information that, in earlier versions of Windows, was stored in .ini files. For example, the handle key HKEY_CURRENT_USERControl Panel leads to the subkey for the Windows Desktop.</descrip></descripGrp><ntig><termGrp><term id="1081688">HKEY</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1359777">HKEY</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23423_1081689_1359777"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Windows 9x, Windows NT, and Windows 2000, a handle to a Registry key in which configuration information is stored. Each key leads to sub-keys containing configuration information that, in earlier versions of Windows, was stored in .ini files. For example, the handle key HKEY_CURRENT_USERControl Panel leads to the subkey for the Windows Desktop.</descrip></descripGrp><ntig><termGrp><term id="1081689">hkey handle</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1359777">HKEY</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2343_210468_364121"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The web service exposed by the web front-end that allows a client program to execute queries.</descrip></descripGrp><ntig><termGrp><term id="210468">Query Service</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="364121">Servei de consulta</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23436_1081889_2857318"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A drawing that is meant to show how something works; it generally includes the relations between parts.</descrip></descripGrp><ntig><termGrp><term id="1081889">diagram</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2857318">diagrama</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23459_1082196_1336220"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Audio and video on a call that are exchanged before the recipient accepts the call. Examples include announcements, requests for input, and caller voice commands.</descrip></descripGrp><ntig><termGrp><term id="1082196">early media</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1336220">elements multimèdia inicials</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2346_15363_2738344"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To link one entity to another for a specific purpose.</descrip></descripGrp><ntig><termGrp><term id="15363">assign</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2738344">assignar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23462_1082215_1537130"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The street address or geographical coordinates of a user, and (by way of extensions) of the user’s computer or devices.</descrip></descripGrp><ntig><termGrp><term id="1082215">location</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1537130">ubicació</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23469_1082336_2745234"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A character used in synchronous (timed) communications that enables the sending and receiving devices to maintain the same timing.</descrip></descripGrp><ntig><termGrp><term id="1082336">SYN</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2745234">SYN</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23469_1082337_2745234"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A character used in synchronous (timed) communications that enables the sending and receiving devices to maintain the same timing.</descrip></descripGrp><ntig><termGrp><term id="1082337">synchronous idle character</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2745234">SYN</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23478_1082601_2520712"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A solid-state circuit component, usually with three leads, in which a voltage or a current controls the flow of another current. The transistor can serve many functions, including those of amplifier, switch, and oscillator, and is a fundamental component of almost all modern electronics.</descrip></descripGrp><ntig><termGrp><term id="1082601">transistor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2520712">transistor</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23478_1082602_2520712"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A solid-state circuit component, usually with three leads, in which a voltage or a current controls the flow of another current. The transistor can serve many functions, including those of amplifier, switch, and oscillator, and is a fundamental component of almost all modern electronics.</descrip></descripGrp><ntig><termGrp><term id="1082602">transfer resistor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2520712">transistor</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23513_1086437_1098274"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To save the user's work on a continuous basis, so that it is not necessary to save manually.</descrip></descripGrp><ntig><termGrp><term id="1086437">automatically save</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1098274">desar automàticament</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23520_2781049_1355886"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The suite of web-based productivity offerings from Office.</descrip></descripGrp><ntig><termGrp><term id="2781049">Office on the web</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1355886">Office Web Apps</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23520_2781049_2783101"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The suite of web-based productivity offerings from Office.</descrip></descripGrp><ntig><termGrp><term id="2781049">Office on the web</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2783101">Microsoft Office al web</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Mascul