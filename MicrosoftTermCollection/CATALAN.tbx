/langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1857513">icona expressiva</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22665_1053565_1963592"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An email message that is sent by a notification activity.</descrip></descripGrp><ntig><termGrp><term id="1053565">notification message</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1963592">missatge de notificació</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22668_1053572_1963593"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A part of a schema that defines the representation of a resource in ILM "2".</descrip></descripGrp><ntig><termGrp><term id="1053572">object type</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1963593">tipus d'objecte</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2267_318112_380846"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A server built upon and integrated with the Microsoft Windows SharePoint Services platform to enable Web-based use of InfoPath form templates, by rendering editable