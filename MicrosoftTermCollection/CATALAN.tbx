 options.</descrip></descripGrp><ntig><termGrp><term id="88413">option set</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1375823">conjunt d'opcions</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7759_495127_512440"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A presentation of information about a contact, including presence status and activity.</descrip></descripGrp><ntig><termGrp><term id="495127">contact card</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="512440">targeta de contacte</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7764_1975517_1981896"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A hard disk that contains a small amount of solid-state nonvolatile memory which, when used as a cache, can realize significant benefits such as faster booting, extended battery life, and a more rugged PC.</descrip></descripGrp><ntig><termGrp><term id="1975517">hybrid drive</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1981896">unitat híbrida</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7764_314130_1981896"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A hard disk that contains a small amount of solid-state nonvolatile memory which, when used as a cache, can realize significant benefits such as faster booting, extended battery life, and a more rugged PC.</descrip></descripGrp><ntig><termGrp><term id="314130">hybrid hard disk</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1981896">unitat híbrida</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7764_366903_1981896"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A hard disk that contains a small amount of solid-state nonvolatile memory which, when used as a cache, can realize significant benefits such as faster booting, extended battery life, and a more rugged PC.</descrip></descripGrp><ntig><termGrp><term id="366903">hybrid disk</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1981896">unitat híbrida</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7774_233477_608844"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The interval that is used to delay a response in a tarpitting scenario.</descrip></descripGrp><ntig><termGrp><term id="233477">tarpitting interval</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="608844">interval del fre de correu brossa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7781_179526_1143555"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A control (composed of a text box and spin button control) that allows a user to adjust a value from a limited range of possible values.</descrip></descripGrp><ntig><termGrp><term id="179526">spin box</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1143555">quadre de rotació</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7785_120062_1550723"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The bar that contains the 'Start' button and appears by default at the bottom of the desktop. You can click the taskbar buttons to switch between programs. You can also hide the taskbar, move it to the sides or top of the desktop, and customize it in other ways.</descrip></descripGrp><ntig><termGrp><term id="120062">taskbar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1550723">barra de tasques</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7785_2785563_1550723"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The bar that contains the 'Start' button and appears by default at the bottom of the desktop. You can click the taskbar buttons to switch between programs. You can also hide the taskbar, move it to the sides or top of the desktop, and customize it in other ways.</descrip></descripGrp><ntig><termGrp><term id="2785563">task bar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1550723">barra de tasques</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7793_265354_325457"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A wizard that will help users to define a custom task for their workflow. Custom Task can be used to collect information from workflow participants. That information will be stored in the Tasks list for the site and can be used later in the workflow via workflow lookup.</descrip></descripGrp><ntig><termGrp><term id="265354">Custom Task Wizard</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="325457">Auxiliar de tasques personalitzades</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7795_122231_2859387"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A bundl