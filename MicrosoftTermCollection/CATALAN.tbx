ngSet></termEntry><termEntry id="34328_1991438_2913406"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Games and other applications that are served and run directly from the Xbox Live service, typically with an additional fee to play.</descrip></descripGrp><ntig><termGrp><term id="1991438">Arcade</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2913406">Arcade</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34329_1991439_2913925"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Games that are created by the Xbox community and downloaded from the Xbox Live service, typically with a fee to play the full game.</descrip></descripGrp><ntig><termGrp><term id="1991439">Indie Games</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2913925">Jocs independents</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34330_1991440_2917448"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An area of Xbox Live that caters to a particular style of gameplay. Four zones exist: pro, recreation, family, and underground.</descrip></descripGrp><ntig><termGrp><term id="1991440">Xbox Live Gamer Zone</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2917448">Zona de joc de l'Xbox Live</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34331_1991441_2917455"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of players on Xbox Live that can play games and chat together.</descrip></descripGrp><ntig><termGrp><term id="1991441">Xbox Live Party</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2917455">Grup de l'Xbox Live</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34333_1991443_2543071"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Brand name of the games offering from Xbox.</descrip></descripGrp><ntig><termGrp><term id="1991443">Xbox Games</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2543071">Xbox Games</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34335_1991445_2543088"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application for Windows 8, Windows Phone, and other portable devices that connects phones, PCs, and tablets with your Xbox 360 console.</descrip></descripGrp><ntig><termGrp><term id="1991445">Xbox SmartGlass</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2543088">Xbox SmartGlass</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34335_1991445_2543089"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application for Windows 8, Windows Phone, and other portable devices that connects phones, PCs, and tablets with your Xbox 360 console.</descrip></descripGrp><ntig><termGrp><term id="1991445">Xbox SmartGlass</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2543089">Complement de l'Xbox SmartGlass</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34335_2432221_2543088"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application for Windows 8, Windows Phone, and other portable devices that connects phones, PCs, and tablets with your Xbox 360 console.</descrip></descripGrp><ntig><termGrp><term id="2432221">Xbox SmartGlass Companion</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2543088">Xbox SmartGlass</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34335_2432221_2543089"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application for Windows 8, Windows Phone, and other portable devices that connects phones, PCs, and tablets with your Xbox 360 console.</descrip></descripGrp><ntig><termGrp><term id="2432221">Xbox SmartGlass Companion</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2543089">Complement de l'Xbox SmartGlass</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34337_1991447_2915865"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Xbox Live account.</descrip></descripGrp><ntig><termGrp><term id="1991447">membership</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2915865">subscripció</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34338_1991448_2915909"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Code used to restrict access, entered using a combination of controller button and trigger presses.</descrip></descripGrp><ntig><termGrp><term id="1991448">passcode</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2915909">clau d'accés</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34339_1991449_2916011"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Xbox Live account security feature in which Xbox sends a one-time code to a customer's preference of contact options (email, text message, or phone), allowing them to return the code to verify their identity.</descrip></descripGrp><ntig><termGrp><term id="1991449">security check</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2916011">comprovació de seguretat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34340_1991450_2915959"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To make a transaction in which Microsoft Points are exchanged.</descrip></descripGrp><ntig><termGrp><term id="1991450">redeem</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2915959">bescanviar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34341_1991451_2915962"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To extend an Xbox Live membership.</descrip></descripGrp><ntig><termGrp><term id="1991451">renew</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2915962">renovar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34342_1991452_2917442"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Membership code that is purchased or won through offers, contests, events, and so on.</descrip></descripGrp><ntig><termGrp><term id="1991452">Xbox Live code</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2917442">codi de l'Xbox Live</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34344_1991454_2917447"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Basic level of Xbox Live membership.</descrip></descripGrp><ntig><termGrp><term id="1991454">Xbox Live Free membership</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2917447">Subscripció gratuïta a l'Xbox Live</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34345_1991455_2913930"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The controller-free gaming experience from Xbox.</descrip></descripGrp><ntig><termGrp><term id="1991455">Kinect</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2913930">Kinect</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34346_1991456_2543019"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Kinect device.</descrip></descripGrp><ntig><termGrp><term id="1991456">Kinect sensor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2543019">sensor del Kinect</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34346_1991456_2916014"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Kinect device.</descrip></descripGrp><ntig><termGrp><term id="1991456">Kinect sensor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2916014">sensor</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34346_2013412_2543019"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Kinect device.</descrip></descripGrp><ntig><termGrp><term id="2013412">sensor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2543019">sensor del Kinect</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34346_2013412_2916014"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Kinect device.</descrip></descripGrp><ntig><termGrp><term id="2013412">sensor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2916014">sensor</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34347_1991457_2913411"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The automatic angle adjustment function of the Kinect sensor.</descrip></descripGrp><ntig><termGrp><term id="1991457">auto-tilt</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2913411">inclinació automàtica</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34348_1991458_2913463"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The infrared camera component of the Kinect sensor.</descrip></descripGrp><ntig><termGrp><term id="1991458">depth sensor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2913463">sensor de profunditat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34349_1991459_2917185"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The RGB camera component of the Kinect sensor.</descrip></descripGrp><ntig><termGrp><term id="1991459">video sensor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2917185">sensor de vídeo</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34350_1991460_2913478"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The entire area that the sensor can "see," including walls, furniture, and other obstructions.</descrip></descripGrp><ntig><termGrp><term id="1991460">field of view</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2913478">camp de visió</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34351_1991461_2543034"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The area within the Kinect sensor's field of view is able to detect a person or in which a player moves.</descrip></descripGrp><ntig><termGrp><term id="1991461">play space</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2543034">àrea de joc</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34352_1991462_2913475"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Facial identification used by the sensor to recognize a player.</descrip></descripGrp><ntig><termGrp><term id="1991462">facial recognition</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2913475">reconeixement facial</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34353_1991463_2913856"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A motion made by a player that's intended to be tracked by the sensor.</descrip></descripGrp><ntig><termGrp><term id="1991463">gesture</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2913856">gest</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34354_1991464_2913899"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In-game gesture that invokes the Kinect Guide.</descrip></descripGrp><ntig><termGrp><term id="1991464">guide gesture</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2913899">gest de la guia</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34355_1991465_2913933"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Biometric recognition of a player by the system, through the use of the Kinect sensor and software.</descrip></descripGrp><ntig><termGrp><term id="1991465">Kinect ID</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2913933">ID del Kinect</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34356_1991466_2913900"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The visual progress indicator that appears in the corner of the screen when a player performs the guide gesture. Because the icon is only visible when cued by the guide gesture, use only when necessary to specifically call out its functionality, as in an instructional demo, for example.</descrip></descripGrp><ntig><termGrp><term id="1991466">guide icon</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2913900">ico de la guia</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34357_1991467_2913902"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The icon that appears when a player is detected in the play space, prompting a wave to engage with Kinect. Once engaged, a hand pointer appears, which serves as a mechanism for navigation and object manipulation.</descrip></descripGrp><ntig><termGrp><term id="1991467">hand icon</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2913902">ico de mà</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34358_1991468_2915868"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The icon that is present when the Kinect microphone is available to accept voice commands.</descrip></descripGrp><ntig><termGrp><term id="1991468">microphone icon</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2915868">icona de micròfon</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34359_1991469_2917134"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Spoken input that's intended to be received and interpreted by the sensor as input.</descrip></descripGrp><ntig><termGrp><term id="1991469">speech</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2917134">veu</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34360_1991470_2917154"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The detection and following of a person's movements by the sensor.</descrip></descripGrp><ntig><termGrp><term id="1991470">tracking</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2917154">seguiment</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34361_1991471_2917191"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Vocal input that's used by the sensor to identify a player.</descrip></descripGrp><ntig><termGrp><term id="1991471">voice</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2917191">veu</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34362_1991472_2917194"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The panel that appears in the Xbox Dashboard when the Kinect sensor recognizes the voice command "Xbox".</descrip></descripGrp><ntig><termGrp><term id="1991472">voice bar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2917194">barra de veu</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34363_1991473_2917179"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Video communication with another player on Xbox Live, using the Kinect sensor. Formerly video chat.</descrip></descripGrp><ntig><termGrp><term id="1991473">Video Kinect</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2917179">Video Kinect</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34364_1991474_2913931"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Kinect based guide that appears over a game and allows for social interactions (friends, invites, chat, etc.).</descrip></descripGrp><ntig><termGrp><term id="1991474">Kinect Guide</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2913931">Guia del Kinect</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34365_1991475_2913939"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Kinect based troubleshooter that helps users with common problems related to the play space, lighting, speech/audio, setup, and hardware errors.</descrip></descripGrp><ntig><termGrp><term id="1991475">Kinect Tuner</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2913939">Configurador del Kinect</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34366_1991476_2913484"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Disc used for playing games.</descrip></descripGrp><ntig><termGrp><term id="1991476">game disc</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2913484">disc de joc</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34367_1991477_2913449"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To make a permanent attachment between a wireless controller and the console.</descrip></descripGrp><ntig><termGrp><term id="1991477">connect</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2913449">connectar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNot