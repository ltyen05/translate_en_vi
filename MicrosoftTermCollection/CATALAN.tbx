termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8290_14790_2699092"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A message that appears in a newsgroup, public folder, or other forum, such as Facebook or Twitter, accessible by a number of individuals.</descrip></descripGrp><ntig><termGrp><term id="14790">post</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2699092">article</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8290_1513907_2079101"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A message that appears in a newsgroup, public folder, or other forum, such as Facebook or Twitter, accessible by a number of individuals.</descrip></descripGrp><ntig><termGrp><term id="1513907">discussion entry</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2079101">publicació</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8290_1513907_2699092"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A message that appears in a newsgroup, public folder, or other forum, such as Facebook or Twitter, accessible by a number of individuals.</descrip></descripGrp><ntig><termGrp><term id="1513907">discussion entry</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2699092">article</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8291_182217_2626560"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">User-defined text (descriptive or instructional including input masks and formatting rules) specific to a database or database object. The text is stored in the database as a property of the database or object.</descrip></descripGrp><ntig><termGrp><term id="182217">extended property</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2626560">propietat ampliada</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8292_314061_1517232"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The meaning of data as it is intended to be interpreted by people.</descrip></descripGrp><ntig><termGrp><term id="314061">info</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1517232">informació</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8292_66163_1517232"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The meaning of data as it is intended to be interpreted by people.</descrip></descripGrp><ntig><termGrp><term id="66163">information</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1517232">informació</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8299_307430_608865"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A rule issued by the U.S. Department of Health and Human Services to implement the privacy requirements of the Health Insurance Portability and Accountability Act (HIPAA), a federal law that provides rights and protections for participants and beneficiaries in group health plans. The rule establishes national standards for the protection of certain health information, including standards addressing the use and disclosure of individuals’ health information and standards for individuals' privacy rights to understand and control how their health information is used.</descrip></descripGrp><ntig><termGrp><term id="307430">HIPAA Privacy Rule</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="608865">Directriu de privadesa HIPAA</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="832_1176946_1546102"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Having two components, alternatives, or outcomes. The binary number system has 2 as its base, so values are expressed as combinations of two digits, 0 and 1. These two digits can represent the logical values true and false as well as numerals, and they can be represented in an electronic device by the two states on and off, recognized as two voltage levels. Therefore, the binary number system is at the heart of digital computing.</descrip></descripGrp><ntig><termGrp><term id="1176946">base 2</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1546102">binari</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="832_21220_1546102"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Having two components, alternatives, or outcomes. The binary number system has 2 as its base, so values are expressed as combinations of two digits, 0 and 1. These two digits can represent the logical values true and false as well as numerals, and they can be represented in an electronic device by the two states on and off, recognized as two voltage levels. Therefore, the binary number system is at the heart of digital computing.</descrip></descripGrp><ntig><termGrp><term id="21220">binary</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1546102">binari</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8320_346966_1546376"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To safeguard a resource from attack or loss.</descrip></descripGrp><ntig><termGrp><term id="346966">protect</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1546376">protegir</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8324_184639_1381832"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The device that Lync and Communicator uses by default when the user places a call (either PBX telephone phone or computer through a VOIP connection).</descrip></descripGrp><ntig><termGrp><term id="184639">default device</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1381832">Dispositiu per defecte</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8333_397163_411043"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A hierarchy of folders in the Exchange store very similar in structure to the standard file system. A single folder can contain child folders, which, in turn, can contain other child folders.</descrip></descripGrp><ntig><termGrp><term id="397163">folder tree</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="411043">arbre de carpetes</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8337_147809_2095164"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A module that includes code for all event procedures triggered by events occurring on a specific report or its controls.</descrip></descripGrp><ntig><termGrp><term id="147809">report module</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2095164">mòdul de l'informe</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8343_307439_608877"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A proxy server that accepts connection requests from anyone anywhere and forwards the traffic as if it has originated from the local hosts.</descrip></descripGrp><ntig><termGrp><term id="307439">open proxy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="608877">servidor intermediari obert</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8356_116839_1550688"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to a formatting style in which characters are crossed out by horizontal line.</descrip></descripGrp><ntig><termGrp><term id="116839">strikethrough</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1550688">ratllat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8360_233481_608837"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of rules that are applied to email messages. These rules govern how messages are processed and stored, based on a set of requirements. The requirements are typically based on regulatory requirements for an industry or geographic region.</descrip></descripGrp><ntig><termGrp><term id="233481">Message Policy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="608837">norma de gestió de missatges</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8365_211347_3025936"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A graphical user-interface tool used to design and implement business processes.</descrip></descripGrp><ntig><termGrp><term id="211347">Orchestration Designer</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3025936">Dissenyador d'orquestracions</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8369_226552_1098263"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that notifies a user when there is a change to posted content, workflow status, or when other user-defined criteria are met.</descrip></descripGrp><ntig><termGrp><term id="226552">alert</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1098263">avís</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8374_129238_2457008"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application that displays or otherwise outputs a file in the same way as the application that created the file. An example of a viewer is a program to display the images stored in GIF or JPEG files.</descrip></descripGrp><ntig><termGrp><term id="129238">viewer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2457008">visualitzador</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8377_33870_2094926"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A segment of Visual Basic code that defines the beginning and end of a procedure.</descrip></descripGrp><ntig><termGrp><term id="33870">code stub</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2094926">codi auxiliar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8391_143066_1555390"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A non-printing line or point that can be used to help position or align objects or text.</descrip></descripGrp><ntig><termGrp><term id="143066">guide</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1555390">guia</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8394_1376083_1275922"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An individual who is interested in doing business or who currently does business with your organization. A contact may or may not be part of a larger organization (account).</descrip></descripGrp><ntig><termGrp><term id="1376083">business contact</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1275922">contacte</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8394_182466_1275922"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An individual who is interested in doing business or who cur