Set></termEntry><termEntry id="19339_652974_2857890"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The set of Windows features that provides parents and individuals with the ability to customize key aspects of the online experience in order to protect their children and/or themselves.</descrip></descripGrp><ntig><termGrp><term id="652974">Family Safety</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2857890">Microsoft Family Safety</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19340_652975_722786"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A product's settings that enable customers to determine how people who also use the product may interact with them.</descrip></descripGrp><ntig><termGrp><term id="652975">communication preferences</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="722786">preferències de comunicació</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19341_652981_722788"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To add a video to a blog entry by entering the embed code for the video.</descrip></descripGrp><ntig><termGrp><term id="652981">embed a video</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang