ammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52032_2929999_2947218"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The New Zealand holiday celebrated on February 6 that commemorates the signing of the Treaty of Waitangi in 1840, signed by representatives of the British Crown and Maori chiefs and often considered to be New Zealand's founding document.</descrip></descripGrp><ntig><termGrp><term id="2929999">Waitangi Day</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2947218">Dia de Waitangi</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52033_2930000_2947219"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The day on which Waitangi Day is celebrated if the official holiday itself falls on a weekend.</descrip></descripGrp><ntig><termGrp><term id="2930000">Waitangi Day Bank Holiday</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2947219">Festiu del Dia de Waitangi</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52034_2930002_2930787"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The version of SharePoint Server that a customer can run on-premises, for which Microsoft will provide ongoing support and updates for as long as the subscription is current/valid.</descrip></descripGrp><ntig><termGrp><term id="2930002">SharePoint Server Subscription Edition</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2930787">Edició de subscripció del SharePoint Server</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52035_2930004_2930788"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The version of the Skype for Business Server software that a customer can run on-premises, where ongoing support and updates are provided for as long as the subscription is valid.</descrip></descripGrp><ntig><termGrp><term id="2930004">Skype for Business Server Subscription Edition</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2930788">Edició de subscripció de l'Skype for Business Server</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52037_2930006_2930785"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The 2021 edition of the on-premises Project Standard solution.</descrip></descripGrp><ntig><termGrp><term id="2930006">Project Standard 2021</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2930785">Project Standard 2021</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52038_2930007_2930781"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The 2021 edition of the on-premises Project Professional solution.</descrip></descripGrp><ntig><termGrp><term id="2930007">Project Professional 2021</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2930781">Project Professional 2021</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52039_2930008_2930782"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The 2021 edition of the on-premises Project server solution.</descrip></descripGrp><ntig><termGrp><term id="2930008">Project Server 2021</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2930782">Project Server 2021</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52041_2930010_2930771"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Microsoft’s 1st party PSTN calling services, currently available in 18 markets and one way to enable PSTN calling in Teams (Direct Routing and Operator Connect being the alternatives).</descrip></descripGrp><ntig><termGrp><term id="2930010">Microsoft Teams Calling Plans</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2930771">Plans de trucades del Microsoft Teams</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52041_2930010_2948706"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Microsoft’s 1st party PSTN calling services, currently available in 18 markets and one way to enable PSTN calling in Teams (Direct Routing and Operator Connect being the alternatives).</descrip></descripGrp><ntig><termGrp><term id="2930010">Microsoft Teams Calling Plans</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2948706">Plans de trucades del Teams</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52041_2947844_2930771"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Microsoft’s 1st party PSTN calling services, currently available in 18 markets and one way to enable PSTN calling in Teams (Direct Routing and Operator Connect being the alternatives).</descrip></descripGrp><ntig><termGrp><term id="2947844">Teams Calling Plans</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2930771">Plans de trucades del Microsoft Teams</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52041_2947844_2948706"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Microsoft’s 1st party PSTN calling services, currently available in 18 markets and one way to enable PSTN calling in Teams (Direct Routing and Operator Connect being the alternatives).</descrip></descripGrp><ntig><termGrp><term id="2947844">Teams Calling Plans</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2948706">Plans de trucades del Teams</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52042_2930011_2930774"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The overall telephony workload for Microsoft Teams, including the core cloud-based call control system that is used to replace traditional PBXs, and enables key calling capabilities.</descrip></descripGrp><ntig><termGrp><term id="2930011">Microsoft Teams Phone</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2930774">Telèfon del Microsoft Teams</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52042_2930011_2949504"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The overall telephony workload for Microsoft Teams, including the core cloud-based call control system that is used to replace traditional PBXs, and enables key calling capabilities.</descrip></descripGrp><ntig><termGrp><term id="2930011">Microsoft Teams Phone</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2949504">Telèfon del Teams</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52042_2947840_2930774"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The overall telephony workload for Microsoft Teams, including the core cloud-based call control system that is used to replace traditional PBXs, and enables key calling capabilities.</descrip></descripGrp><ntig><termGrp><term id="2947840">Teams Phone</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2930774">Telèfon del Microsoft Teams</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52042_2947840_2949504"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The overall telephony workload for Microsoft Teams, including the core cloud-based call control system that is used to replace traditional PBXs, and enables key calling capabilities.</descrip></descripGrp><ntig><termGrp><term id="2947840">Teams Phone</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2949504">Telèfon del Teams</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52043_2930012_2930746"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that appears in the Excel home tab, powered by AI, that helps people analyze their data by providing summaries, visual and significant trends and insights, and allows Natural Language Queries about the data.</descrip></descripGrp><ntig><termGrp><term id="2930012">Analyze Data</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2930746">Anàlisi de dades</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52044_2930013_2930753"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The service of expert assistance that helps very small businesses get the most out of their Microsoft 365 subscription, including migration help, end-user support, and personalized advice from small business specialists.</descrip></descripGrp><ntig><termGrp><term id="2930013">Business Assist for Microsoft 365</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2930753">Assistència empresarial per al Microsoft 365</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52046_2930015_2930773"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The category name for a group of features that enable collaboration with external users in Microsoft Teams.</descrip></descripGrp><ntig><termGrp><term id="2930015">Microsoft Teams Connect</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2930773">Connexions del Microsoft Teams</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52046_2930015_3060142"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The category name for a group of features that enable collaboration with external users in Microsoft Teams.</descrip></descripGrp><ntig><termGrp><term id="2930015">Microsoft Teams Connect</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3060142">Connexions del Teams</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52046_3059193_2930773"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The category name for a group of features that enable collaboration with external users in Microsoft Teams.</descrip></descripGrp><ntig><termGrp><term id="3059193">Teams Connect</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2930773">Connexions del Microsoft Teams</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52046_3059193_3060142"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The category name for a group of features that enable collaboration with external users in Microsoft Teams.</descrip></descripGrp><ntig><termGrp><term id="3059193">Teams Connect</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3060142">Connexions del Teams</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52048_2930017_2930775"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The version of Office perpetual for Consumer and SMB that includes the traditional suite of classic apps such as Word, Excel, PowerPoint, and other apps, sold as a one-time purchase without any major feature updates.</descrip></descripGrp><ntig><termGrp><term id="2930017">Office 2021</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2930775">Office 2021</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52049_2930018_2930778"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The service that allows customers to configure operator dial-in phone numbers on a Microsoft Audio Conferencing bridge and provides customers the ability to maintain their existing operator contracts and relationships as they migrate to the cloud, diversify their PSTN infrastructure to include multiple operators, expand dial-in coverage and enterprise-grade reliability and support.</descrip></descripGrp><ntig><termGrp><term id="2930018">Operator Connect Conferencing</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2930778">Conferències amb connexió amb operador</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52050_2930019_2930761"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The version of the Exchange Server software that a customer can run on-premises, for which Microsoft provides ongoing support and updates for as long as the subscription is current/valid.</descrip></descripGrp><ntig><termGrp><term id="2930019">Microsoft Exchange Server Subscription Edition</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2930761">Edició de subscripció del Microsoft Exchange Server</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52051_2930020_2930759"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Teams, the feature that moves all video feeds to the top of the meeting window, allowing more natural eye contact with meeting attendees.</descrip></descripGrp><ntig><termGrp><term id="2930020">Gallery at top</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2930759">Galeria a la part superior</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52052_2930022_2930786"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The option in Presenter Mode in which the content is shown as a visual aid above the presenter's shoulder, like a television reporter.</descrip></descripGrp><ntig><termGrp><term id="2930022">Reporter</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2930786">Reporter</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52054_2930025_2930770"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The service that enables IT managed secure control and customization by allowing customers to bring consistent organizational experiences and have enhanced control and management across the organization.</descrip></descripGrp><ntig><termGrp><term id="2930025">Microsoft Teams Advanced Management</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2930770">Administració avançada del Microsoft Teams</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52055_2930026_2930780"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The PowerPoint experience with features exclusive to Microsoft Teams, in which users can see their notes, upcoming slides, audience member videos and chat, and more.</descrip></descripGrp><ntig><termGrp><term id="2930026">PowerPoint Live</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2930780">PowerPoint en directe</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52057_2930028_2930757"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The capability that makes it easy to plan and schedule quality, feature, and driver updates through powerful, cloud-based controls and leverages cloud capabilities to protect commercial customers from update-related issues through automatic pilot rings, ML-based issue detection, and tenant monitoring.</descrip></descripGrp><ntig><termGrp><term id="2930028">deployment service</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2930757">servei d'implementació</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5206_421002_1963390"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To associate data with a specified location in memory.</descrip></descripGrp><ntig><termGrp><term id="421002">map</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1963390">assignar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52067_2931691_2932073"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The capability of Windows to adapt the way your colors render based on the type of content you consume and/or the environment you are in (dark vs bright, or an environment of a specific color - e.g. a coffee shop with green walls or a theatre with a predominance of red).</descrip></descripGrp><ntig><termGrp><term id="2931691">adaptive color</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2932073">color adaptatiu</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52069_2932124_2934305"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The 2021 version of Microsoft Office Project Standard that utilizes the LTSC servicing model.</descrip></descripGrp><ntig><termGrp><term id="2932124">Microsoft Office LTSC Project Standard</term><termNote type="partOfSpeech">Prop