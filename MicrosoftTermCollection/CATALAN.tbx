ig><termGrp><term id="2427819">More Syllables</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2368573">Síl·labes</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41785_2427819_2429669"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Learning Tools feature that separates the syllables of each word with a dot.</descrip></descripGrp><ntig><termGrp><term id="2427819">More Syllables</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2429669">Més síl·labes</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41786_2365471_2368589"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Learning Tools feature that highlights verbs and their subordinate clauses.</descrip></descripGrp><ntig><termGrp><term id="2365471">Comprehension mode</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2368589">mode Comprensió</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41787_2365479_2368574"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The menu item that takes users to a site that helps them troubleshoot, diagnose and fix problems, search help articles, and communicate directly with support.</descrip></descripGrp><ntig><termGrp><term id="2365479">Support</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2368574">Assistència tècnica</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41788_2365481_2368571"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The automated Outlook Support feature analyzes a user's Outlook and diagnoses what is wrong with it.</descrip></descripGrp><ntig><termGrp><term id="2365481">Troubleshooting</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2368571">Detecció d'errors</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41789_2365488_2368577"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office 365 portal that contains Office 365 security and compliance features.</descrip></descripGrp><ntig><termGrp><term id="2365488">Office 365 Security &amp; Compliance Center</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2368577">Centre de seguretat i compliment de l'Office 365</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41796_2365514_2366704"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A clock in the World Clock app that displays the current local time in any city in the world. You can have multiple clocks to display the local times from cities around the world.</descrip></descripGrp><ntig><termGrp><term id="2365514">world clock</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2366704">rellotge mundial</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41797_2365557_2367040"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The add-in to share Excel data and insights to a single location quickly.</descrip></descripGrp><ntig><termGrp><term id="2365557">Power BI Publisher for Excel</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2367040">Power BI Publisher per a l'Excel</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41798_2366156_2368572"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An account for an organization which has its data stor