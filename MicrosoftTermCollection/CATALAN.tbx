f two types of hardware that are connected by an RS-232-C serial connection, the other being a Data Terminal Equipment (DTE) device.</descrip></descripGrp><ntig><termGrp><term id="338560">DCE</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1137762">DCE</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43243_2447290_3128373"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The button that you select to accept the contents of the dialog.</descrip></descripGrp><ntig><termGrp><term id="2447290">OK</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3128373">D'acord</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43243_3128054_3128373"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The button that you select to accept the contents of the dialog.</descrip></descripGrp><ntig><termGrp><term id="3128054">OK</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3128373">D'acord</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43257_2450114_2451974"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A target error margin for recall that is used to estimate number of additional files necessary needed for review.</descrip></descripGrp><ntig><termGrp><term id="2450114">assessment target</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2451974">objectiu d'avaluació</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43258_2450131_2453385"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A percentage of files that need to be reviewed, which can be defined by the user of Advanced eDiscovery.</descrip></descripGrp><ntig><termGrp><term id="2450131">cut-off point</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2453385">llindar de fitxers</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43259_2450137_2452003"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Advanced eDiscovery view where detailed interim cumulative results can be viewed after each Relevance training cycle.</descrip></descripGrp><ntig><termGrp><term id="2450137">Detailed Results</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2452003">Resultats detallats</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43261_2450561_2451988"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process where an expert labels each file and issue within a sample as relevant, not relevant, or an item that should be skipped as part of Advanced eDiscovery Relevance training.</descrip></descripGrp><ntig><termGrp><term id="2450561">tagging</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2451988">etiquetatge</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43262_2450562_2451990"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Advanced eDiscovery panel where users can tag files and issues as relevant, not relevant, or where they can choose to skip it.</descrip></descripGrp><ntig><termGrp><term id="2450562">Tagging panel</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2451990">Tauler d'etiquetatge</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43263_2450563_2451994"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A margin of error for the recall value that is used to estimate the number of files that need to be reviewed by Advanced eDiscovery.</descrip></descripGrp><ntig><termGrp><term id="2450563">target error margin</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2451994">marge d'error objectiu</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43264_2450798_2453391"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Advanced eDiscovery mode that allows users to process new file loads after other file loads were already started, see a comparison of the loads, and decide if they want to merge the new loads with the existing ones or split them.</descrip></descripGrp><ntig><termGrp><term id="2450798">Catch-up</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2453391">Posada al dia</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43265_2450799_2453361"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Advanced eDiscovery option that allows users to continue Relevance training, treating new loads and old loads like the same set of files.</descrip></descripGrp><ntig><termGrp><term id="2450799">Merge loads</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2453361">Combina les compilacions</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43266_2450800_2453354"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Advanced eDiscovery option that allows users to perform Relevance training on new file loads separately from old file loads.</descrip></descripGrp><ntig><termGrp><term id="2450800">Split loads</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2453354">Separa les compilacions</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43267_2450801_2453421"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Advanced eDiscovery mode that allows users to incorporate a new load with existing loads using Catch-up and which triggers any new necessary Relevance training.</descrip></descripGrp><ntig><termGrp><term id="2450801">Rolling loads</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2453421">Compilacions addicionals</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43268_2450802_2453135"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Advanced eDiscovery feature that allows users to select a set of parameters that will determine which files are exported in a batch.</descrip></descripGrp><ntig><termGrp><term id="2450802">Export batch</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2453135">Lot d'exportació</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43269_2450812_2452002"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file that is in its original file type.</descrip></descripGrp><ntig><termGrp><term id="2450812">native file</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2452002">fitxer natiu</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43270_2450813_2452000"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A phase in e-discovery where native files are prepared to be loaded into a document review platform, metadata is extracted from files, and data culling techniques are employed.</descrip></descripGrp><ntig><termGrp><term id="2450813">processing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2452000">processament</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</t