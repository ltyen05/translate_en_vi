rip></descripGrp><ntig><termGrp><term id="2844769">notice template</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2849732">plantilla d'avís</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50336_2844806_2849599"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A validation of a partner’s capability to deliver high-fidelity services in a specific solution area. Advanced specializations are customer-facing labels displayed on a partner’s business profile in the Partner Directory, enabling partners to showcase their differentiated skills.</descrip></descripGrp><ntig><termGrp><term id="2844806">advanced specialization</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2849599">especialització avançada</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50337_2844818_2849653"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A validation of a partner’s broad technical capability in a Microsoft product or technology.</descrip></descripGrp><ntig><termGrp><term id="2844818">competency</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2849653">competència</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</