></termGrp></ntig></langSet></termEntry><termEntry id="49803_2816518_2818677"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A service that backs up data to the cloud.</descrip></descripGrp><ntig><termGrp><term id="2816518">cloud backup service</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2818677">servei de còpia de seguretat al núvol</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49804_2816519_2818678"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A connected experience that is optional, more precisely, it is not covered by the organization's license with Microsoft, but is instead licensed directly to the user.</descrip></descripGrp><ntig><termGrp><term id="2816519">cloud-backed service</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2818678">servei amb còpia al núvol</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49804_2816519_2818694"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A connected experience that is optional, more precisely, it is not covered by the organization's license with Microsoft, but is instead licensed directly to the user.</descrip></descripGrp><ntig><termGrp><term id="2816519">cloud-backed service</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2818694">experiència connectada opcional</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49804_2816520_2818678"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A connected experience that is optional, more precisely, it is not covered by the organization's license with Microsoft, but is instead licensed directly to the user.</descrip></descripGrp><ntig><termGrp><term id="2816520">optional connected experience</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2818678">servei amb còpia al núvol</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49804_2816520_2818694"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A connected experience that is optional, more precisely, it is not covered by the organization's license with Microsoft, but is instead licensed directly to the user.</descrip></descripGrp><ntig><termGrp><term id="2816520">optional connected experience</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2818694">experiència connectada opcional</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49805_2816521_2818689"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Measures of service quality of a network as seen by the customer.</descrip></descripGrp><ntig><termGrp><term id="2816521">network performance</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2818689">rendiment de la xarxa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49806_2816522_2818666"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature of Microsoft Teams that assesses the Office 365 tenant environment and identifies the most common configurations that may need to be updated or modified, and creates a Service management team with channels for each workload.</descrip></descripGrp><ntig><termGrp><term id="2816522">Advisor for Teams</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2818666">Assessor</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49806_2816522_2818674"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature of Microsoft Teams that assesses the Office 365 tenant environment and identifies the most common configurations that may need to be updated or modified, and creates a Service management team with channels for each workload.</descrip></descripGrp><ntig><termGrp><term id="2816522">Advisor for Teams</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2818674">Assessor per al Teams</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49806_2816698_2818666"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature of Microsoft Teams that assesses the Office 365 tenant environment and identifies the most common configurations that may need to be updated or modified, and creates a Service management team with channels for each workload.</descrip></descripGrp><ntig><termGrp><term id="2816698">Advisor</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2818666">Assessor</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49806_2816698_2818674"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature of Microsoft Teams that assesses the Office 365 tenant environment and identifies the most common configurations that may need to be updated or modified, and creates a Service management team with channels for each workload.</descrip></descripGrp><ntig><termGrp><term id="2816698">Advisor</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2818674">Assessor per al Teams</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49808_2816676_2818700"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Microsoft Teams, as part of Teams rollout done with Advisor for Teams, a workload is a set of features and settings that is used to deploy a specific collection of functions. Workloads are comprised of channels to complete the deployment of the functions.</descrip></descripGrp><ntig><termGrp><term id="2816676">workload</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2818700">càrrega de treball</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49810_2816681_2818698"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To convert a phone number to a different format, by using a set of rules.</descrip></descripGrp><ntig><termGrp><term id="2816681">translate</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2818698">convertir</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49811_2816684_2818688"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In the Microsoft 365 Admin Center, a specific network architecture design change that is recommended to improve user experien