></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1963355">descobriment legal</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20136_702323_1963387"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Extra information displayed to a user while they are composing an email message. MailTips are displayed in an InfoBar, similar to the banner that appears saying "This message has not been sent." MailTips reveal anything that might be unexpected about the delivery or audience of the message, such as recipient validity or Out of Office status or whether the message might not be delivered.</descrip></descripGrp><ntig><termGrp><term id="702323">MailTip</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1963387">Informació sobre correu</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20139_702327_1963384"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A template that automatically populates multiple mailbox properties when a mailbox is created in the service. A mailbox plan also assigns default permissions to the corresponding user account.</descrip></descripGrp><ntig><termGrp><term id="702327">mailbox plan</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1963384">pla de bústia de correu</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2014_94646_2145102"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In computing, to send information to a printer.</descrip></descripGrp><ntig><termGrp><term id="94646">print</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2145102">imprimir</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20141_703430_1963646"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A policy that specifies the length of time during which items such as data, documents, builds, and releases are to be retained.</descrip></descripGrp><ntig><termGrp><term id="703430">retention policy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1963646">política de preservació</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20143_703432_1963663"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of Exchange features, organization-wide resource limits, and permissions that are automatically configured or applied when a new hosted organization is provisioned in the service.</descrip></descripGrp><ntig><termGrp><term id="703432">service plan</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1963663">pla de serveis</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20151_705248_1963208"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The button that stops the task in progress and returns to the previous state.</descrip></descripGrp><ntig><termGrp><term id="705248">Cancel</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1963208">Cancel·la</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20154_705260_1963625"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The act of supplying and configuring computing resources.</descrip></descripGrp><ntig><termGrp><term id="705260">provisioning</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1963625">aprovisionament</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20159_707781_1821189"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A communication technology based on short range (4cm or less) wireless data exchange.</descrip></descripGrp><ntig><termGrp><term id="707781">near field communication</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1821189">comunicació de camp proper</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20159_707781_1821194"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A communication technology based on short range (4cm or less) wireless data exchange.</descrip></descripGrp><ntig><termGrp><term id="707781">near field communication</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1821194">NFC</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20159_707782_1821189"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A communication technology based on short range (4cm or less) wireless data exchange.</descrip></descripGrp><ntig><termGrp><term id="707782">NFC</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1821189">comunicació de camp proper</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20159_707782_1821194"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A communication technology based on short range (4cm or less) wireless data exchange.</descrip></descripGrp><ntig><termGrp><term id="707782">NFC</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1821194">NFC</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2017_139881_2094767"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A field in the row or column area that contains custom groups as its items.</descrip></descripGrp><ntig><termGrp><term id="139881">custom group field</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2094767">camp de grup personalitzat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20178_717322_1097354"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A navigation bar item that links to billing-related information.</descrip></descripGrp><ntig><termGrp><term id="717322">Billing</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1097354">Facturació</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20181_726173_1179026"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A piece or slice of a Web page that users can directly subscribe to from the browser. The browser checks if the piece of the web has updates, and indicates to the user when there are new updates available. Users can preview the piece of the Web before navigating to the full Web page.</descrip></descripGrp><ntig><termGrp><term id="726173">Web Slice</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1179026">Web Slice</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20189_718449_2159970"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature of Hyper-V that allows a running virtual machine to be managed remotely through an interactive session.</descrip></descripGrp><ntig><termGrp><term id="718449">Virtual Machine Connection</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2159970">Connexió a la màquina virtual</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20194_718467_1359812"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A plug-in that users download to run a Silverlight-based application in their browser. This term also refers to the component embedded in a Web page that renders Silverlight content.</descrip></descripGrp><ntig><termGrp><term id="718467">Silverlight plug-in</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1359812">complement del Silverlight</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20195_718470_1359811"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to a type or member that accesses secure resources and can only be used by fully trusted code in the .NET Framework.</descrip></descripGrp><ntig><termGrp><term id="718470">security-critical</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1359811">crític per a la seguretat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20198_718937_2717932"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to a software feature or programming object that is outdated and should not be used. A deprecated item is currently supported for backward compatibility, but it might become obsolete and unsupported in the future.</descrip></descripGrp><ntig><termGrp><term id="718937">deprecated</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2717932">obsolet</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="202_30582_2145133"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of characters treated as a unit and interpreted by a computer as text rather than numbers. A character string can contain any sequence of elements from a given character set, such as letters, numbers, control characters, and extended ASCII characters.</descrip></descripGrp><ntig><termGrp><term id="30582">character string</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2145133">cadena de caràcters</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20202_719546_2766783"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To stop displaying an application’s active window on screen while leaving the application running.</descrip></descripGrp><ntig><termGrp><term id="719546">hide</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2766783">amagar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20203_719548_2717644"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A record of changes to an item after it was created.</descrip></descripGrp><ntig><termGrp><term id="719548">history</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2717644">historial</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20204_719701_2717669"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A unique element of data within a field.</descrip></descripGrp><ntig><termGrp><term id="719701">item</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2717669">element</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20213_719725_1308231"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of subsystems and interfaces that form a common structure from which a stream of derivative products can be efficiently developed and produced. A given product may have platform deliverables (building blocks) from several areas that define its implementation.</descrip></descripGrp><ntig><termGrp><term id="719725">platform</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1308231">plataforma</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20222_719746_1979084"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The window that displays solutions, projects, and files, as well as access to the commands that pertain to them.</descrip></descripGrp><ntig><termGrp><term id="719746">Solution Explorer</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1979084">Explorador de solucions</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2023_136809_2735653"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A link that specifies a full path to a resource, such that the destination of the link doesn’t change based on where it is linking from.</descrip></descripGrp><ntig><termGrp><term id="136809">absolute link</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2735653">enllaç absolut</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2025_93650_1963616"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The POP protocol that is used to retrieve email and that supports download-and-delete from a remote mailbox.</descrip></descripGrp><ntig><termGrp><term id="93650">POP3</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1963616">POP3</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2025_93650_362915"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The POP protocol that is used to retrieve email and that supports download-and-delete from a remote mailbox.</descrip></descripGrp><ntig><termGrp><term id="93650">POP3</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="362915">Protocol d'oficina de correus versió 3</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2025_93651_1963616"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The POP protocol that is used to retrieve email and that supports download-and-delete from a remote mailbox.</descrip></descripGrp><ntig><termGrp><term id="93651">Post Office Protocol version 3</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1963616">POP3</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2025_93651_362915"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The POP protocol that is used to retrieve email and that supports download-and-delete from a remote mailbox.</descrip></descripGrp><ntig><termGrp><term id="93651">Post Office Protocol version 3</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="362915">Protocol d'oficina de correus versió 3</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20262_724432_1097721"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The computer that manages the OneCare settings for all computers in a OneCare circle.</descrip></descripGrp><ntig><termGrp><term id="724432">hub PC</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1097721">ordinador concentrador</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20262_724433_1097721"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The computer that manages the OneCare settings for all computers in a OneCare circle.</descrip></descripGrp><ntig><termGrp><term id="724433">hub computer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1097721">ordinador concentrador</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20263_724434_1097863"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A computer that receives an action specified by the OneCare administrator. For example, a computer that is the designated the place for file backup would be considered to be the "target PC" of the backup function.</descrip></descripGrp><ntig><termGrp><term id="724434">target PC</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1097863">ordinador de destinació</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20268_724469_760831"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">When referring to a warranty, pertaining to the goods that are sold or licensed in their present condition, with all existing faults.</descrip></descripGrp><ntig><termGrp><term id="724469">as-is</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="760831">tal qual</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20269_724470_760833"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">When referring to the use of licensed products, the misuse or any departure from the reasonable use of such products.</descrip></descripGrp><ntig><termGrp><term id="724470">abuse</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="760833">abús</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20270_724471_760839"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A contract to carry out services or to sell goods/licenses to a client.</descrip></descripGrp><ntig><termGrp><term id="724471">account</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="760839">compte</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20271_724472_760842"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To recognize the factual existence, validity or truth of something.</descrip></descripGrp><ntig><termGrp><term id="724472">acknowledge</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="760842">reconèixer</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20272_724473_760843"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The recognition of the factual existence, validity or truth of something.</descrip></descripGrp><ntig><termGrp><term id="724473">acknowledgement</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="760843">reconeixement</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20273_724474_760848"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">When referring to the Microsoft Enterprise and Enterprise Subscription programs, any product other than an enterprise product that a customer chooses to license under its enrollment.</descrip></descripGrp><ntig><termGrp><term id="724474">additional product</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="760848">producte addicional</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20274_724475_760847"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">When referring to a Microsoft licensing program other than the Enterprise Agreement or Enterprise Subscription Agreement, a new product or a new enterprise product licensed during the term of the customer's agreement or enrollment.</descrip></descripGrp><ntig><termGrp><term id="724475">additional product</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="760847">producte addicional</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20275_724476_760860"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The price to be paid each year.</descrip></descripGrp><ntig><termGrp><term id="724476">annual price</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="760860">preu anual</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20276_724477_760863"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The tax imposed by the relevant taxing authority in relation to a given income, property or transaction.</descrip></descripGrp><ntig><termGrp><term id="724477">applicable tax</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="760863">impost aplicable</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20277_724478_760864"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A form of dispute resolution carried out by one or more neutral and independent third parties selected by the parties to the dispute rather than a court.</descrip></descripGrp><ntig><termGrp><term id="724478">arbitration</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="760864">arbitratge</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20278_724479_760865"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The primary rules that parties may adopt when conducting an arbitration at the Singapore International Arbitration Centre and that will apply to their arbitration.</descrip></descripGrp><ntig><termGrp><term id="724479">Arbitration Rules of the Singapore International Arbitration Centre</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="760865">Regles d'Arbitratge del Centre d'Arbitratge Internacional de Singapur</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20279_724481_760866"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To transfer rights or property from one person to.</descrip></descripGrp><ntig><termGrp><term id="724481">assign</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="760866">cedir</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20280_724482_760867"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">When referring to the Microsoft Open License program, the unique number allocated to the Open License customer that is valid for 24 months following the issuance of the number and under which the customer and its affiliates may order licenses under the Open License program.</descrip></descripGrp><ntig><termGrp><term id="724482">authorization number</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="760867">número d'autorització</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20281_724483_760877"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">When appearing in the name or header of a Microsoft Volume Licensing Agreement, an indication that the agreement is applicable to a private sector entity.</descrip></descripGrp><ntig><termGrp><term id="724483">Business</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="760877">Business</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20282_724485_760878"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Microsoft umbrella contract setting out the core terms and conditions that apply to volume licensing and services agreements entered into under it.</descrip></descripGrp><ntig><termGrp><term id="724485">Business and Services Agreement</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="760878">Contracte Marc de Negocis i Serveis</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20283_1509635_760879"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A division of a company, either a profit or cost center, that has a certain degree of autonomy and is responsible for a particular range of products or brands or for specific administrative functions.</descrip></descripGrp><ntig><termGrp><term id="1509635">operating division</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="760879">unitat de negoci</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20283_724486_760879"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A division of a company, either a profit or cost center, that has a certain degree of autonomy and is responsible for a particular range of products or brands or for specific administrative functions.</descrip></descripGrp><ntig><termGrp><term id="724486">business unit</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="760879">unitat de negoci</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20284_724487_1510133"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The act of subscribing to product media in CD/DVD format.</descrip></descripGrp><ntig><termGrp><term id="724487">CD/DVD-ROM subscription</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1510133">CD/DVD-ROM subscription</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20285_724489_760884"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A permanent international commercial arbitration institution located in Beijing, China, which resolves international economic and trade disputes by arbitration.</descrip></descripGrp><ntig><termGrp><term id="724489">China International Economic and Trade Arbitration Commission</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="760884">Comissió d'Arbitratge Comercial i Econòmic Internacional de la Xina</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20286_724490_760885"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The jurisdiction chosen by the parties to an agreement for the purpose of resolving disputes relating to that agreement.</descrip></descripGrp><ntig><termGrp><term id="724490">choice of jurisdiction</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="760885">elecció de jurisdicció</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20287_724491_760891"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">When referring to Microsoft Volume Licensing Programs, an option available to license products on all desktops in the customer's company.</descrip></descripGrp><ntig><termGrp><term id="724491">company-wide option</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="760891">opció per a tota la companyia</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20288_724494_760894"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">When referring to Microsoft Volume Licensing Programs, a copy of a product that may be used without any charge.</descrip></descripGrp><ntig><termGrp><term id="724494">complimentary copy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="760894">còpia gratuïta</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20289_724495_760899"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of combining or uniting a number of things into a more effective entity, and, specifically, combining two or more companies to create a new single company.</descrip></descripGrp><ntig><termGrp><term id="724495">consolidation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="760899">concentració</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20290_724496_760900"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">When used in the Business and Services Agreement, a New Zealand Act that sets out guarantees that goods and services must meet when sold to consumers e.g. a retailer or services provider.</descrip></descripGrp><ntig><termGrp><term id="724496">Consumer Guarantees Act</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="760900">Llei de Garanties dels Consumidors</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20291_724497_760901"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">When used in the Business and Services Agreement, a Malaysian Act setting out guarantees that goods and services must meet when sold to consumers.</descrip></descripGrp><ntig><termGrp><term id="724497">Consumer Protection Act</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="760901">Llei de Protecció de Consumidors</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20292_724498_760902"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The means available to consumers to obtain redress for or to prevent the violation of a right or to impose or safeguard a right.</descrip></descripGrp><ntig><termGrp><term id="724498">consumer remedies</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="760902">accions dels consumidors</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20293_724499_760908"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">When referring to a license right, pertaining to the right to use a product in any language.</descrip></descripGrp><ntig><termGrp><term id="724499">cross-language</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="760908">entre idiomes</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20294_724500_760910"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To set right any breaches of the contract or to remedy legal defects.</descrip></descripGrp><ntig><termGrp><term id="724500">cure</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="760910">reparar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20295_724503_760912"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">When referring to the Microsoft Enterprise and Enterprise Subscription programs, a platform of desktop products (Windows Upgrade, Office and Server CALs) selected by the customer from those available under the Enterprise and Professional Desktops and that are standardized across all desktops included under the agreement.</descrip></descripGrp><ntig><termGrp><term id="724503">custom desktop</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="760912">desktop personalitzat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20296_724504_760907"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">When referring to the Microsoft Enterprise and Enterprise Subscription programs, a list of license prices and other pricing terms and conditions agreed to between the customer and Microsoft for a specific direct enrollment.</descrip></descripGrp><ntig><termGrp><term id="724504">customer price sheet</term><termNote type="partOfSpeech">Noun</termNote><termN