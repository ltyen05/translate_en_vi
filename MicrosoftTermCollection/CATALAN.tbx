g="ca"><ntig><termGrp><term id="2913455">tapa del port del comandament de joc</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34371_1991481_2913465"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The console disc drive.</descrip></descripGrp><ntig><termGrp><term id="1991481">disc drive</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2913465">unitat de disc</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34372_1991482_2913466"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The console disc tray.</descrip></descripGrp><ntig><termGrp><term id="1991482">disc tray</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2913466">safata de disc</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34373_1991483_2913469"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The console disc tray eject button.</descrip></descripGrp><ntig><termGrp><term id="1991483">eject button</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2913469">botó d'expulsió</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34374_1991484_2913470"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Ethernet port on the back of the console.</descrip></descripGrp><ntig><termGrp><term id="1991484">Ethernet port</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2913470">port Ethernet</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34375_1991485_2913904"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The section of the console where the hard drive is attached.</descrip></descripGrp><ntig><termGrp><term id="1991485">hard drive bay</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2913904">compartiment de disc dur</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34376_1991486_2913906"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The cover that protects the hard drive bay in the absence of an attached hard drive.</descrip></descripGrp><ntig><termGrp><term id="1991486">hard drive bay cover</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2913906">tapa de compartiment de disc dur</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34377_1991487_2913907"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The plug that connects the hard drive to the console.</descrip></descripGrp><ntig><termGrp><term id="1991487">hard drive connector</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2913907">connector de disc dur</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34378_1991488_2913908"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The HDMI port on the back of the Xbox 360 console.</descrip></descripGrp><ntig><termGrp><term id="1991488">HDMI AV port</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2913908">port AV HDMI</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34379_1991489_2913926"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The sensor on the console that receives infrared signals (for example, from a remote control).</descrip></descripGrp><ntig><termGrp><term id="1991489">infrared sensor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2913926">sensor d'infrarrojos</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34380_1991490_2915927"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The component on the power supply cord that pulls the right amount of electricity from a wall outlet and converts the AC current to DC current.</descrip></descripGrp><ntig><termGrp><term id="1991490">power supply</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2915927">font d'alimentació</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34381_1991491_2915929"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The console power supply cable that runs from the power supply to the console.</descrip></descripGrp><ntig><termGrp><term id="1991491">power supply cord</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2915929">cable de la font d'alimentació</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34382_1991492_2917326"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Xbox 360 console.</descrip></descripGrp><ntig><termGrp><term id="1991492">Xbox 360 console</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2917326">consola de joc Xbox 360</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34383_1991493_2917378"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Replaceable cover for the front of the Xbox 360 console.</descrip></descripGrp><ntig><termGrp><term id="1991493">Xbox 360 Faceplate</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2917378">carcassa frontal Xbox 360</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34384_1991494_2913401"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The battery pack that powers the wireless controller. Accepts only AA batteries.</descrip></descripGrp><ntig><termGrp><term id="1991494">AA battery pack</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2913401">bateria AA</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34385_1991495_2913410"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Audio input on the controller.</descrip></descripGrp><ntig><termGrp><term id="1991495">audio jack</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2913410">connector d'àudio</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34386_1991496_2913432"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The port on the controller into which the play-charge cable is connected.</descrip></descripGrp><ntig><termGrp><term id="1991496">charge port</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2913432">port de càrrega</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34387_1991497_2913434"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The action of pressing the stick downward.</descrip></descripGrp><ntig><termGrp><term id="1991497">click</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2913434">clic</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="gra