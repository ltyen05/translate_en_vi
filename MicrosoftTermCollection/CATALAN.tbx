lected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2042_166734_3026397"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file containing objects and their associated functions and data that is linked into your application when the executable file is built.</descrip></descripGrp><ntig><termGrp><term id="166734">static library</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3026397">biblioteca estàtica</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20420_724644_761179"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">When referring to Microsoft Volume Licensing Programs, a unique number allocated to the reseller by the relevant regional operations center.</descrip></descripGrp><ntig><termGrp><term id="724644">reseller public customer number</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761179">número de public customer del revenedor</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20421_724645_761184"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Microsoft volume licensing contract available for large companies and government organizations that provides a license grant on a perpetual basis and where the customer forecasts its purchases over that term of the agreement.</descrip></descripGrp><ntig><termGrp><term id="724645">Select Agreement</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761184">Contracte Select</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20422_724646_761185"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An enrollment entered into by a Select customer - either an entity that has entered into a Select Agreement or one of its affiliates.</descrip></descripGrp><ntig><termGrp><term id="724646">Select Enrollment</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761185">Inscripció Select</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20423_724647_761186"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Microsoft volume licensing program available to large companies and government organizations that provides a license grant on a perpetual basis and where the customer forecasts its purchases over that term of the Select Agreement.</descrip></descripGrp><ntig><termGrp><term id="724647">Select License</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761186">Select License</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20424_724648_761187"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An enrollment entered into by a Select customer and a vendor engaged by the Select customer to lease-finance its acquisitions under the enrollment, or to manage information and data systems assets that include software licenses on behalf of the Select customer.</descrip></descripGrp><ntig><termGrp><term id="724648">Select Outsourcer Enrollment</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761187">Inscripció Select Outsourcer</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20425_724649_761188"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A form completed by a Select Agreement customer indicating its forecasted purchase of licenses under the Select program during the term of the Select Agreement.</descrip></descripGrp><ntig><termGrp><term id="724649">Select Volume Forecast Form</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761188">Formulari de previsió de volum Select</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20426_724650_761189"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">When referring to Microsoft licensing and partner programs, the template questionnaire provided by Microsoft that the customer or partner would complete when conducting an internal audit.</descrip></descripGrp><ntig><termGrp><term id="724650">self-audit questionnaire</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761189">qüestionari d'auto-auditoria</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20427_724651_761190"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A form of risk management where an enterprise or organization establishes a reserve to protect itself from future loss rather than purchasing insurance.</descrip></descripGrp><ntig><termGrp><term id="724651">self-insurance</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761190">auto-assegurança</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20428_724660_761192"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">When referring to the clause of a contract, a provision that maintains the rest of the contract in effect if any other provision is held to be illegal, invalid or unenforceable. If possible the contract will avoid total invalidity by severing the illegal, invalid or unenforceable provisions so that the rest of the contract will remain in effect.</descrip></descripGrp><ntig><termGrp><term id="724660">severability</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761192">conservació</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20429_724661_761193"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The act of sending goods or a group of goods shipped.</descrip></descripGrp><ntig><termGrp><term id="724661">shipment</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761193">enviament</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2043_87960_1546176"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In mathematics, an action performed on a set of entities that produces a new entity. Examples of mathematical operations are addition and subtraction.</descrip></descripGrp><ntig><termGrp><term id="87960">operation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1546176">operació</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20430_724662_761195"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A single license available for sale in retail shops.</descrip></descripGrp><ntig><termGrp><term id="724662">single retail license</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761195">llicència individual de minorista</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20431_724663_761196"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Commercial Code in effect in Slovakia.</descrip></descripGrp><ntig><termGrp><term id="724663">Slovak Commercial Code</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761196">Codi de comerç Eslovac</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20432_724664_761201"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">When referring to Microsoft Volume Licensing Programs, the extent of Software Assurance rights and benefits that cover licenses included under a volume licensing agreement.</descrip></descripGrp><ntig><termGrp><term id="724664">software assurance coverage</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761201">cobertura de software assurance</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20433_724665_761205"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tax collected on the issue or transfer of securities. It was originally a tax collected by stamping the instruments that gave effect to a transaction.</descrip></descripGrp><ntig><termGrp><term id="724665">stamp tax</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761205">impost sobre el timbre</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20434_724666_761207"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The body of law derived from Acts passed by a legislative authority.</descrip></descripGrp><ntig><termGrp><term id="724666">statutory law</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761207">legislació</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20435_724667_761210"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Liability based on the breach of an absolute obligation to meet a certain standard or make something safe, where negligence or fault does not need to be proved.</descrip></descripGrp><ntig><termGrp><term id="724667">strict liability</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761210">responsabilitat objectiva</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20436_724668_761211"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An individual or organization that carries out work on behalf of another company or person.</descrip></descripGrp><ntig><termGrp><term id="724668">subcontractor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761211">subcontractista</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20437_724669_761212"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A license granted by a licensee or sublicensee covering some or all of the rights granted to it under the initial license acquired by it.</descrip></descripGrp><ntig><termGrp><term id="724669">sublicense</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761212">subllicència</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20438_724670_761215"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To take the place of.</descrip></descripGrp><ntig><termGrp><term id="724670">supersede</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761215">substituir</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20439_724671_761216"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">When referring to Microsoft Volume Licensing Programs, contact details provided by the customer of additional persons in its organization that shall receive information and notices under the agreement, in addition to the contacts already listed in the agreement.</descrip></descripGrp><ntig><termGrp><term id="724671">Supplemental Contact Information</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761216">informació de contacte complementària</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20440_724672_761217"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">When referring to Microsoft Volume Licensing Programs, the form that a customer completes to provide Supplemental Contact Information.</descrip></descripGrp><ntig><termGrp><term id="724672">Supplemental Contact Information Form</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761217">formulari d'informació de contacte complementària</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20441_724673_761220"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tax or duty imposed by a government on certain types of goods when they are imported into a country/region, and sometimes on goods exported.</descrip></descripGrp><ntig><termGrp><term id="724673">tariff</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761220">aranzel</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20442_724674_761222"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A monetary amount that may be set against an entity or individual's tax liability.</descrip></descripGrp><ntig><termGrp><term id="724674">tax credit</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761222">crèdit fiscal</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20443_724675_761223"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to products, activities and employee or corporate income that are not subject to tax.</descrip></descripGrp><ntig><termGrp><term id="724675">tax exempt</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761223">exempció fiscal</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20444_724676_761230"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A geographic area.</descrip></descripGrp><ntig><termGrp><term id="724676">territory</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761230">territori</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20445_724677_761234"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Australian Act relating to the conduct of trade.</descrip></descripGrp><ntig><termGrp><term id="724677">Trade Practices Act</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761234">Llei de Pràctiques Comercials</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20446_724678_761241"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A court or any other body set up to settle disputes.</descrip></descripGrp><ntig><termGrp><term id="724678">tribunal</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761241">tribunal</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20447_724679_761244"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">When referring to software, a full copy of a software product.</descrip></descripGrp><ntig><termGrp><term id="724679">true and complete copy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761244">còpia exacta i completa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20448_724680_761245"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">When referring to the Microsoft Enterprise program, an annual count of the number of qualified desktops, users, and additional products that have been added to the customer's organization during the year and for which licenses must be ordered going forward.</descrip></descripGrp><ntig><termGrp><term id="724680">true-up</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761245">"true up"</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20449_724681_761246"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">When referring to the Microsoft Enterprise program, the annual order placed by the customer to cover the qualified desktops, users and additional products included in its true-up count.</descrip></descripGrp><ntig><termGrp><term id="724681">true-up order</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761246">comanda "true up"</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20451_724682_761247"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">When referring to the Microsoft Enterprise program, the price or reference price applicable to the annual true-up orders.</descrip></descripGrp><ntig><termGrp><term id="724682">true-up price</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761247">preu "true up"</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20452_724683_761248"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Not connected as an affiliate.</descrip></descripGrp><ntig><termGrp><term id="724683">unaffiliated</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761248">que no és filial</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20453_724684_761249"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The arbitration rules of the United Nations Commission on International Trade Law.</descrip></descripGrp><ntig><termGrp><term id="724684">UNCITRAL Arbitration Rules</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761249">Regles d'Arbitratge d'UNCITRAL</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20454_724685_761250"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The full operating system license that gives the right to and must be purchased at the same time as or prior to an operating system upgrade license.</descrip></descripGrp><ntig><termGrp><term id="724685">underlying desktop operating system license</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761250">llicència de sistema operatiu de sobretaula subjacent</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20455_724686_761251"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The full license that gives the right to and must be purchased at the same time as or prior to an upgrade license.</descrip></descripGrp><ntig><termGrp><term id="724686">underlying license</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761251">llicència subjacent</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20456_724687_761252"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">When referring to a contract, pertaining to an agreement or clause that, even if it is valid, cannot be enforced.</descrip></descripGrp><ntig><termGrp><term id="724687">unenforceable</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761252">inexigible</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20457_724688_761253"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A model statute in the United States (enacted by most states) which sets out the definition of what constitutes a trade secret.</descrip></descripGrp><ntig><termGrp><term id="724688">Uniform Trade Secrets Act</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761253">Llei Uniforme de Secrets Empresarials</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20458_724689_761254"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The act of using a product that does not conform with or is not permitted by the law.</descrip></descripGrp><ntig><termGrp><term id="724689">unlawful use</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761254">ús il·lícit</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20459_724690_761255"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">When referring to the Microsoft Enterprise volume licensing program, a form submitted by the customer to Microsoft to confirm there is no change to the number of Qualified Desktops, Qualified Users, and/or Additional Products run since the last anniversary of its enrollment.</descrip></descripGrp><ntig><termGrp><term id="724690">update statement</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761255">declaració d'actualització</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2046_61898_1136472"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A successful retrieval of a record matching a query.</descrip></descripGrp><ntig><termGrp><term id="61898">hit</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1136472">ocurrència</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20460_724691_761258"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A legacy Microsoft volume licensing offering giving the right to upgrade a product licensed under the agreement/enrollment.</descrip></descripGrp><ntig><termGrp><term id="724691">upgrade advantage</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761258">Upgrade Advantage</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20462_724692_761259"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The amount and extent of upgrade rights that cover licenses included under a volume licensing agreement.</descrip></descripGrp><ntig><termGrp><term id="724692">upgrade coverage</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761259">cobertura d'actualitzacions</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termN