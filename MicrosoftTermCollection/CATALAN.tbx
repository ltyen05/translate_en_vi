381856"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A call to a call group that rings the group owner and call group simultaneously. When a member of the group answers the call, the other members get a notification with the status of the call.</descrip></descripGrp><ntig><termGrp><term id="748234">group call</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1381856">trucada de grup</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20854_748237_1382136"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user's work day hours as specified in Microsoft Office Outlook by the day of the week and the start and end times.</descrip></descripGrp><ntig><termGrp><term id="748237">working hours</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1382136">horari laboral</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20855_748246_1382094"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To create an indication that the user has an incoming call.</descrip></descripGrp><ntig><termGrp><term id="748246">ring</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1382094">trucar</term><termNote type="geographicalUsage">ESP</termNot