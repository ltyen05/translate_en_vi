><descripGrp><descrip type="definition">A URL that is based on a query using the Document ID rather than the physical location of the item.</descrip></descripGrp><ntig><termGrp><term id="773460">Document ID Lookup URL</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1098304">URL de cerca per ID de document</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21371_773461_1098307"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A special type of folder that enables users to manage a deliverable or work product spanning multiple documents as a single entity.</descrip></descripGrp><ntig><termGrp><term id="773461">document set</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1098307">conjunt de documents</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21372_773462_1098308"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SharePoint document library where users can upload files that are then routed automatically to the correct library or folder in the site based upon rules defined by the site administrator.</descrip></descripGrp><ntig><termGrp><term id="773462">Drop Off Library</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1098308">biblioteca d'encaminament</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21402_775135_1821078"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A radio network that provides coverage for cellular telephone communications.</descrip></descripGrp><ntig><termGrp><term id="775135">cellular network</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1821078">xarxa mòbil</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21402_775136_1821078"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A radio network that provides coverage for cellular telephone communications.</descrip></descripGrp><ntig><termGrp><term id="775136">cellular</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1821078">xarxa mòbil</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21407_776107_1547600"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To copy driver binaries, install services, and add registry keys for one or more drivers from a driver package onto a system, without the context of a specific device. A system can be booted from reflected drivers, however full device installation may still be required in order to enable full driver functionality.</descrip></descripGrp><ntig><termGrp><term id="776107">reflect</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1547600">reflectir</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21416_776728_1097700"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of account that allows customers to use a limited set of Windows Live services without signing up for a new email address or providing an existing alternate one. The ID that is created can't be used to send or receive email. A customer with this account type can only reset their password if they subsequently add an alternate email address to their account.</descrip></descripGrp><ntig><termGrp><term id="776728">limited account</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1097700">compte limitat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21430_3007378_3010604"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Snipping Tool, a tool to draw an irregular line, such as a circle or a triangle, around an object that you want to capture.</descrip></descripGrp><ntig><termGrp><term id="3007378">Free-form mode</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3010604">Mode de forma lliure</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21430_777464_3010604"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Snipping Tool, a tool to draw an irregular line, such as a circle or a triangle, around an object that you want to capture.</descrip></descripGrp><ntig><termGrp><term id="777464">Free-form Snip</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3010604">Mode de forma lliure</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21431_3007379_3010605"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Snipping Tool, a tool to capture the entire screen, similar to pressing PRINT SCREEN.</descrip></descripGrp><ntig><termGrp><term id="3007379">Full-screen mode</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3010605">Mode de pantalla sencera</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21431_777465_3010605"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Snipping Tool, a tool to capture the entire screen, similar to pressing PRINT SCREEN.</descrip></descripGrp><ntig><termGrp><term id="777465">Full-screen Snip</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3010605">Mode de pantalla sencera</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21438_3007380_3010606"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Snipping Tool, a tool to draw a precise line, or rectangle, around an object that you want to capture.</descrip></descripGrp><ntig><termGrp><term id="3007380">Rectangle mode</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3010606">Mode de rectangle</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21438_777472_3010606"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Snipping Tool, a tool to draw a precise line, or rectangle, around an object that you want to capture.</descrip></descripGrp><ntig><termGrp><term id="777472">Rectangular Snip</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3010606">Mode de rectangle</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="gra