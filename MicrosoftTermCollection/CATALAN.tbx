</ntig></langSet></termEntry><termEntry id="42551_2410363_2411872"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft tablet computer, announced to the public in October 2015.</descrip></descripGrp><ntig><termGrp><term id="2410363">Surface Pro 4</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2411872">Surface Pro 4</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42559_2410619_2412663"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The PowerPoint capability to load a Zoom enabled file on an operating system that does not support Zoom editing or features and view the presentation.</descrip></descripGrp><ntig><termGrp><term id="2410619">Zoom Playback</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2412663">Reproducció de visualització prèvia</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4256_140753_2094779"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file that a linked or embedded object is inserted into, or that data is saved to.</descrip></descripGrp><ntig><termGrp><term id="140753">destination file</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2094779">fitx