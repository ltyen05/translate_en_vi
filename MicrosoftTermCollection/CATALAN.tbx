Entry><termEntry id="14888_125493_1098404"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An address that uniquely identifies a location on the Internet. A URL is usually preceded by http://, as in http://www.microsoft.com. A URL can contain more detail, such as the name of a page of hypertext, often with the file name extension .html or .htm.</descrip></descripGrp><ntig><termGrp><term id="125493">web address</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1098404">adreça web</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14888_125493_722526"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An address that uniquely identifies a location on the Internet. A URL is usually preceded by http://, as in http://www.microsoft.com. A URL can contain more detail, such as the name of a page of hypertext, often with the file name extension .html or .htm.</descrip></descripGrp><ntig><termGrp><term id="125493">web address</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="722526">adreça d'Internet</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14889_87410_2094806"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An object that supports the OLE protocol for object linking and embedding.</descrip></descripGrp><ntig><termGrp><term id="87410">OLE object</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2094806">objecte OLE</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14890_359641_1182866"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The mechanism by which a system or application event triggers either an instant or an animated change in one or more properties.</descrip></descripGrp><ntig><termGrp><term id="359641">trigger</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1182866">disparador</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14890_494343_1182866"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The mechanism by which a system or application event triggers either an instant or an animated change in one or more properties.</descrip></descripGrp><ntig><termGrp><term id="494343">event trigger</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1182866">disparador</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14893_397167_411163"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A filtering list that is used by the Connection Filter agent in Exchange Server 2007. IP addresses on the IP Allow list are considered "safe" and are exempted from processing by other anti-spam agents.</descrip></descripGrp><ntig><termGrp><term id="397167">IP Allow list</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="411163">Llista d'adreces IP permeses</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14895_397169_411165"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A third-party hardware device or product that connects a legacy PBX to a LAN. An IP/VoIP gateway translates or converts TDM or telephony circuit-switched protocols to packet switched protocols that can be used on a VoIP-based network.</descrip></descripGrp><ntig><termGrp><term id="397169">IP/VoIP gateway</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="411165">passarel·la IP/VoIP</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14897_231964_1143904"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In statistical or scientific data, a bar that shows the potential error or degree of uncertainty relative to each data marker in a series.</descrip></descripGrp><ntig><termGrp><term id="231964">error bar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1143904">barra d'error</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14901_152051_1143905"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The points where playback of a file or clip begins and ends. There are two trim points: start trim point and end trim point.</descrip></descripGrp><ntig><termGrp><term id="152051">trim points</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1143905">punts de tall</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14905_318357_1143907"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The &gt; character.</descrip></descripGrp><ntig><termGrp><term id="318357">greater than sign</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1143907">símbol major que</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14905_318422_1143907"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The &gt; character.</descrip></descripGrp><ntig><termGrp><term id="318422">right angle bracket</term><termNote type="pa