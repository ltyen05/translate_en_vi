rp><descrip type="definition">A set of logical rules for adjusting the score of a lead being nurtured by a marketing campaign.</descrip></descripGrp><ntig><termGrp><term id="2482815">lead scoring model</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2497697">model de puntuació del client potencial</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44179_2482820_2497702"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The display window that shows users a variety of relevant data-driven insights and news from their contacts' interactions on social media.</descrip></descripGrp><ntig><termGrp><term id="2482820">social pane</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2497702">subfinestra social</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44180_2482821_2497703"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The field where you enter information about a marketing campaign used to attract or generate a lead.</descrip></descripGrp><ntig><termGrp><term id="2482821">Source Campaign</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2497703">Campanya d'origen</term><termNote type="geographicalUsage">ESP</termNote><