<termGrp><term id="2613232">event group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2614633">grup d'esdeveniments</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46402_2613233_2614634"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A person who has permission to create and manage a broadcast meeting.</descrip></descripGrp><ntig><termGrp><term id="2613233">event group member</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2614634">membre del grup d'esdeveniments</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46403_2613234_2614635"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The menu beneath the compose box, which shows installed compose apps and a link to the app gallery.</descrip></descripGrp><ntig><termGrp><term id="2613234">extensions menu</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2614635">menú d'extensions</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46404_2613235_2614636"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The list of all the user's scheduled meetings.</descrip></descripGrp><ntig><termGrp><term id="2613235">meetings list</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2614636">llista de reunions</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46405_2613236_2614637"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An extension to the functionality of the compose box that lets the user add richly formatted information from other apps and services. Messaging extensions are a set of pre-built, out of the box cards that can be displayed in a new message, chats or on Teams threads. The first three cards will be Polls, Checklists, and Surveys.</descrip></descripGrp><ntig><termGrp><term id="2613236">messaging extension</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2614637">extensió de missatgeria</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46406_2613237_2614640"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A conversation between two people.</descrip></descripGrp><ntig><termGrp><term id="2613237">one-on-one chat</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2614640">xat privat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46407_2613238_2614643"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A 1:1 conversation between two Skype users to discuss sensitive or confidential information.</descrip></descripGrp><ntig><termGrp><term id="2613238">private conversation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2614643">conversa privada</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46408_2613239_2614644"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A scheduled meeting that doesn’t take place in a channel, which only invited people can attend.</descrip></descripGrp><ntig><termGrp><term id="2613239">private meeting</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2614644">reunió privada</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46409_2613240_2614645"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A person who controls the broadcast before, during and after a Microsoft Teams broadcast.</descrip></descripGrp><ntig><termGrp><term i