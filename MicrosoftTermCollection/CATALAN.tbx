partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43799_2470927_2471553"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The lightweight markup language with plain text formatting syntax designed to be converted to HTML and other formats and that is used to format readme files, write messages in online discussion forums, and create rich text using a plain text editor.</descrip></descripGrp><ntig><termGrp><term id="2470927">Markdown</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2471553">Markdown</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43800_2470929_2471554"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Word add-in that converts Markdown documents to Word format for editing and then converts the Word document back to Markdown format, using the Paragraph, Table, List, and Range objects.</descrip></descripGrp><ntig><termGrp><term id="2470929">Markdown editor</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2471554">Markdown editor</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43809_2471187_2497708"><langSet xml:lang="en-US"><descripGrp><descrip type="defi