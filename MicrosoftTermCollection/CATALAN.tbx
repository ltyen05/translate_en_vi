></descripGrp><ntig><termGrp><term id="2619582">Xbox Avatar Editor</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2621070">Editor d'avatars</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46540_2619582_2621080"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Xbox Live feature allowing the user to create and customize their avatars as well as purchase new avatar items like clothes, accessories and more.</descrip></descripGrp><ntig><termGrp><term id="2619582">Xbox Avatar Editor</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2621080">Editor d'avatars de l'Xbox</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46540_2619583_2621070"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Xbox Live feature allowing the user to create and customize their avatars as well as purchase new avatar items like clothes, accessories and more.</descrip></descripGrp><ntig><termGrp><term id="2619583">Avatar Editor</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2621070">Editor d'avatars</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="gram