Loop or a Conditional.</descrip></descripGrp><ntig><termGrp><term id="2895276">Run from here</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2935535">Executa-ho des d'aquí</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51377_2895277_2935536"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The UI option that executes the actions in a step after step manner.</descrip></descripGrp><ntig><termGrp><term id="2895277">Run next action</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2935536">Executa l'acció següent</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51378_2895278_2935540"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The component of the designer that captures sequence of user actions performed in a web browser.</descrip></descripGrp><ntig><termGrp><term id="2895278">Web recorder</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2935540">Enregistrador web</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></term