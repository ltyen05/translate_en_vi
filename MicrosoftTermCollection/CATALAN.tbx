rmNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3176_397159_411038"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The action that an Exchange Server 2007 transport rule takes if a disclaimer cannot be applied to an email message as, for example, when a message is encrypted.</descrip></descripGrp><ntig><termGrp><term id="397159">fallback action</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="411038">acció de restricció</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31776_1621224_1622911"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To move an object, such as a window or an app, into a locked position on the screen.</descrip></descripGrp><ntig><termGrp><term id="1621224">snap</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1622911">acoblar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31783_1623953_1662695"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that identifies a possible question or requested action in an email message and enables the user to take action on it from within the message.</descrip></descripGrp><ntig><termGrp><term id="1623953">Action Items</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1662695">Accions</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31784_1623954_1662713"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that alerts the user before an email message is sent if it detects that an attachment may have been omitted from the message.</descrip></descripGrp><ntig><termGrp><term id="1623954">Attachment Reminder</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1662713">Avís de fitxers adjunts</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31785_1623955_1662753"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A list or library that is shared between site collections.</descrip></descripGrp><ntig><termGrp><term id="1623955">catalog</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1662753">catàleg</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31786_1623956_1662755"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A vertical bar in the margin of a document that shows where changes have been tracked and displays those changes when clicked.</descrip></descripGrp><ntig><termGrp><term id="1623956">change hint</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1662755">indicació de canvis</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31787_1623957_1662757"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">One of the distinct pieces that make up a chart, such as a title, axis, legend, trendline, or error bar.</descrip></descripGrp><ntig><termGrp><term id="1623957">chart element</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1662757">element de gràfic</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31788_1623958_1662765"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A visual indicator that denotes the presence of a comment and opens the comment when clicked.</descrip></descripGrp><ntig><termGrp><term id="1623958">comment hint</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1662765">indicació de comentari</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31789_1623959_1662766"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A pane beside the document that displays all comments made in the document.</descrip></descripGrp><ntig><termGrp><term id="1623959">Comments pane</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1662766">subfinestra Comentaris</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3179_85018_1253815"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Deliveries, exchanges, or distributions of newsgroup articles to and from news servers. Newsfeeds are accomplished through cooperating news servers, which communicate via NNTP through network connections.</descrip></descripGrp><ntig><termGrp><term id="85018">newsfeed</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1253815">canal de continguts de notícies</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3179_85019_1253815"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Deliveries, exchanges, or distributions of newsgroup articles to and from news servers. Newsfeeds are accomplished through cooperating news servers, which communicate via NNTP through network connections.</descrip></descripGrp><ntig><termGrp><term id="85019">news feed</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1253815">canal de continguts de notícies</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31790_1623960_1662782"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A crawl that operates on a continuous basis to scan and index new and modified content from a source.</descrip></descripGrp><ntig><termGrp><term id="1623960">continuous crawl</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1662782">rastreig continu</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31793_1623963_1662820"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An instance of Excel that has minimal UI and that enables a user to insert or edit chart data within the context of a non-Excel Office document.</descrip></descripGrp><ntig><termGrp><term id="1623963">Data Grid</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1662820">Quadrícula de dades</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31794_1623978_1662870"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The categories of assignments for a given class, along with a percentage value that indicates how much each category weighs into the overall grade. Other factors, such as class participation, may also be considered.</descrip></descripGrp><ntig><termGrp><term id="1623978">evaluation criteria</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1662870">criteris d'avaluació</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31795_1623979_1662897"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of refining a search for information by filtering on individual properties or facets of the items being searched.</descrip></descripGrp><ntig><termGrp><term id="1623979">faceted navigation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1662897">navegació per facetes</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31796_1623980_1662901"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Comments about a completed assignment that an educator makes during review and grading and that are available to the student once the grade is posted.</descrip></descripGrp><ntig><termGrp><term id="1623980">feedback</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1662901">comentaris</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31799_1624313_2613715"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A JavaScript API that provides simple and consistent programmatic access to Office documents and applications across Office client environments through common as well as application-specific data types, objects, functions and events.</descrip></descripGrp><ntig><termGrp><term id="1624313">JavaScript API for Office</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2613715">API del JavaScript per a l'Office</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31800_1624314_1662946"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A unit of learning that addresses a portion of the content for a class and may include assignments, materials, and other lessons.</descrip></descripGrp><ntig><termGrp><term id="1624314">lesson</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1662946">lliçó</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31800_2686115_1662946"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A unit of learning that addresses a portion of the content for a class and may include assignments, materials, and other lessons.</descrip></descripGrp><ntig><termGrp><term id="2686115">unit</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1662946">lliçó</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31801_1624315_1662956"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A layout that is updated in real time as an object on the page is moved, resized, or rotated, enabling the user to preview the end result before the action is completed.</descrip></descripGrp><ntig><termGrp><term id="1624315">live layout</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1662956">disposició dinàmica</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31802_1624316_1662961"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An option that turns on change tracking and lets you set a password to prevent unauthorized users from turning it off.</descrip></descripGrp><ntig><termGrp><term id="1624316">Lock Tracking</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><t