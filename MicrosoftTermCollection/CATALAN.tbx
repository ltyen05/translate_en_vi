gSet></termEntry><termEntry id="15026_26543_2063474"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A field defined in a query that displays the result of an expression rather than displaying stored data. The value is recalculated each time a value in the expression changes.</descrip></descripGrp><ntig><termGrp><term id="26543">calculated field</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2063474">camp calculat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15037_36858_1768964"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To create an object, such as an email message.</descrip></descripGrp><ntig><termGrp><term id="36858">compose</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1768964">redactar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15038_415596_2368708"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A node with no child objects represented in the tree.</descrip></descripGrp><ntig><termGrp><term id="415596">leaf</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2368708">node fulla</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15038_73880_2368708"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A node with no child objects represented in the tree.</descrip></descripGrp><ntig><termGrp><term id="73880">leaf node</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2368708">node fulla</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1504_361191_1264765"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A security feature of Windows that allows administrators to perform normal day-to-day tasks while running with a standard user token. If administrator privileges are needed for an operation, the administrator will be notified and asked to provide either consent or credentials, depending on system policy settings.</descrip></descripGrp><ntig><termGrp><term id="361191">Admin Approval Mode</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1264765">AAM</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1504_616487_1264765"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A security feature of Windows that allows administrators to perform normal day-to-day tasks while running with a standard user token. If administrator privileges are needed for an operation, the administrator will be notified and asked to provide either consent or credentials, depending on system policy settings.</descrip></descripGrp><ntig><termGrp><term id="616487">AAM</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1264765">AAM</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1505_14420_1545903"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A value that a function or a method receives from a caller to perform computations.</descrip></descripGrp><ntig><termGrp><term id="14420">argument</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1545903">argument</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1505_14420_2784541"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A value that a function or a method receives from a caller to perform computations.</descrip></descripGrp><ntig><termGrp><term id="14420">argument</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2784541">arg</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1505_2778460_1545903"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A value that a function or a method receives from a caller to perform computations.</descrip></descripGrp><ntig><termGrp><term id="2778460">arg</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1545903">argument</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1505_2778460_2784541"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A value that a function or a method receives from a caller to perform computations.</descrip></descripGrp><ntig><termGrp><term id="2778460">arg</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2784541">arg</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15050_181550_2236881"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of instructions that describe layout and query information for a report. RDL is composed of XML elements that conform to an XML grammar created for Reporting Services.</descrip></descripGrp><ntig><termGrp><term id="181550">Report Definition Language</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2236881">RDL</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15050_181550_2236883"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of instructions that describe layout and query information for a report. RDL is composed of XML elements that conform to an XML grammar created for Reporting Services.</descrip></descripGrp><ntig><termGrp><term id="181550">Report Definition Language</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2236883">Report Definition Language</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15050_181551_2236881"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of instructions that describe layout and query information for a report. RDL is composed of XML elements that conform to an XML grammar created for Reporting Services.</descrip></descripGrp><ntig><termGrp><term id="181551">RDL</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2236881">RDL</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15050_181551_2236883"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of instructions that describe layout and query information for a report. RDL is composed of XML elements that conform to an XML grammar created for Reporting Services.</descrip></descripGrp><ntig><termGrp><term id="181551">RDL</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2236883">Report Definition Language</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15055_116264_1550673"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The condition at a particular time of any of numerous elements of computing--a device, a communications channel, a network station, a program, a bit, or other element--used to report on or to control computer operations.</descrip></descripGrp><ntig><termGrp><term id="116264">state</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1550673">estat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15055_116265_1550673"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The condition at a particular time of any of numerous elements of computing--a device, a communications channel, a network station, a program, a bit, or other element--used to report on or to control computer operations.</descrip></descripGrp><ntig><termGrp><term id="116265">status</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1550673">estat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15063_412982_1275619"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables the use of color, icons, or bars to help illustrate trends or show different values in a data range.</descrip></descripGrp><ntig><termGrp><term id="412982">data visualization</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1275619">visualització de les dades</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15073_413295_608895"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Exchange Server 2007 server role that provides routing within a single organizational network by using the Active Directory directory service site. Deployed inside the Active Directory forest, computers that have the Hub Transport server role installed handle all mail flow inside the organization, apply transport rules, apply journal rules, and deliver messages to recipients' mailboxes. Messages that are sent to the Internet are relayed by the Hub Transport server to the Edge Transport server role that is deployed in the perimeter network. Messages that are received from the Internet are processed by the Edge Transport server before they are relayed to the Hub Transport server. The Hub Transport server role stores all its configuration information in Active Directory. This information includes transport rules settings, journal rule settings, and connector configurations.</descrip></descripGrp><ntig><termGrp><term id="413295">Hub Transport server role</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="608895">funció del servidor Transport del concentrador</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15075_186215_364190"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An alternate URL mapping that Windows SharePoint Services preserves in the mapping table. It is the URL a user would see, but is not a URL that IIS would give to WSS.</descrip></descripGrp><ntig><termGrp><term id="186215">alternate access mapping</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="364190">assignació alternativa d'accés</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15076_413296_608897"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Exchange Server 2007 server role that provides email storage and advanced scheduling services for Microsoft Office Outlook users. The Mailbox server role also includes public folders, which provide a foundation for workflow, document sharing, and other forms of collaboration.</descrip></descripGrp><ntig><termGrp><term id="413296">Mailbox server role</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="608897">funció del servidor Bústia de correu</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1508_44527_2456883"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To refuse, object, block, or oppose the state of a resource or process.</descrip></descripGrp><ntig><termGrp><term id="44527">deny</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2456883">denegar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15086_5913_1143910"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An integrated proofing tool used to search on common words and display synonyms.</descrip></descripGrp><ntig><termGrp><term id="5913">thesaurus</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1143910">diccionari de sinònims</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15088_140956_2094780"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A control that appears dimmed on a form or data access page. A disabled control cannot get the focus and will not respond to mouse clicks.</descrip></descripGrp><ntig><termGrp><term id="140956">disabled control</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2094780">control inhabilitat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1509_101960_1547606"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The likelihood of a computer system or device continuing to function over a given period of time and under specified conditions.</descrip></descripGrp><ntig><termGrp><term id="101960">reliability</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1547606">fiabilitat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15094_347947_1143912"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A control on a form that contains other controls in a table format and that repeats as needed. Users can insert multiple rows when filling out the form.</descrip></descripGrp><ntig><termGrp><term id="347947">repeating table</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1143912">taula de repetició</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15098_322615_1143913"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Web site based on the Document Workspace template that workspace members use for discussing, editing, and working together on a document.</descrip></descripGrp><ntig><termGrp><term id="322615">Document Workspace</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1143913">lloc Àrea de treball del document</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15098_361653_1143913"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Web site based on the Document Workspace template that workspace members use for discussing, editing, and working together on a document.</descrip></descripGrp><ntig><termGrp><term id="361653">Document Workspace site</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1143913">lloc Àrea de treball del document</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1510_264861_325422"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of individual strokes in the Unicode Standard used to compose Chinese/Japanese/Korean (CJK) ideographs.</descrip></descripGrp><ntig><termGrp><term id="264861">CJK Strokes</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="325422">Traços CJK</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1512_106435_1097838"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to the absence of a requirement to pay the original owner of music, images, software, or other content for the right to use, edit, or distribute their content.</descrip></descripGrp><ntig><termGrp><term id="106435">royalty free</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1097838">sense cànons</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15125_415472_1098264"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A special visual or sound effect added to text or an object. For instance, a user can have the text bullet points fly in from the left, one word at a time, or hear the sounds of applause when a picture is uncovered.</descrip></descripGrp><ntig><termGrp><term id="415472">animation effect</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1098264">efecte d'animació</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15128_475201_1283633"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The account or contact with which a business unit conducts a business transaction.</descrip></descripGrp><ntig><termGrp><term id="475201">customer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1283633">client</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15132_565851_2767889"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A person, real or legal that regularly provides goods or services to another company.</descrip></descripGrp><ntig><termGrp><term id="565851">partner</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2767889">associat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15136_493916_2579534"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The practice of penetrating system security by tricking individuals into divulging passwords and information about network vulnerabilities. Often done by calling the individual on phone and pretending to be another employee of company with a computer-related question.</descrip></descripGrp><ntig><termGrp><term id="493916">social engineering</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2579534">enginyeria social</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15139_362562_1963293"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A data type consisting of a 32-bit unsigned integer.</descrip></descripGrp><ntig><termGrp><term id="362562">DWORD</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1963293">DWORD</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15139_48746_1963293"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A data type consisting of a 32-bit unsigned integer.</descrip></descripGrp><ntig><termGrp><term id="48746">dword</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1963293">DWORD</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15144_346594_1143914"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The time for which a dry or alkaline cell is able to produce an electric current before it needs to be replaced.</descrip></descripGrp><ntig><termGrp><term id="346594">battery life</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></n