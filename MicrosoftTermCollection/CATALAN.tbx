ry id="51027_2881998_2882154"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An insight card available out of the box with Dynamics 365 Sales.</descrip></descripGrp><ntig><termGrp><term id="2881998">base card</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2882154">targeta base</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51028_2881999_2882155"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An intention of a user or buyer during the process of purchasing a product or service.</descrip></descripGrp><ntig><termGrp><term id="2881999">buying intent</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2882155">intenció de compra</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51029_2882000_2882156"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Sales Hub tab available under activities for leads and opportunities. When a customer call regarding a lead or opportunity is processed in Conversation Intelligence, the Call Insights tab displays the information on the summary of the call.</descrip></descripGrp><ntig><termGrp><term id="2882000">Call Insights</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2882156">Informació detallada de la trucada</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51030_2882001_2882157"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Dynamics 365 Sales Insights, optimization of insight cards that are important and their promotion to display at the top.</descrip></descripGrp><ntig><termGrp><term id="2882001">card ranking</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2882157">classificació de la targeta</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51031_2882002_2882158"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Dynamics 365 Sales Insights feature that provides a better insight about customer conversations through Relationship analytics, Talking points and Who knows whom features.</descrip></descripGrp><ntig><termGrp><term id="2882002">Connection insights</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2882158">Informació detallada de la connexió</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51032_2882003_2882159"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Dynamics 365 Sales Insights feature that uses analytics and data science to gather data from sellers’ call recordings and Dynamics 365 Sales. It is designed to help sales managers and sellers in their day-to-day job, providing the tools they need to track their sales performance in calls with leads and customers.</descrip></descripGrp><ntig><termGrp><term id="2882003">Conversation Intelligence</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2882159">Informació sobre converses</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51033_2882004_2882160"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A common metrics used to measure customer satisfaction through customer surveys. It measures the ease of an experience, and correlates with customer loyalty.</descrip></descripGrp><ntig><termGrp><term id="2882004">Customer Effort Score</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2882160">Puntuació d'esforç del client</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51034_2882005_2882161"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Dynamics 365 app that allows users to collaborate more effectively using Microsoft Teams.</descrip></descripGrp><ntig><termGrp><term id="2882005">Dynamics 365 app for Teams</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2882161">Aplicació Dynamics 365 per al Teams</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51035_2882006_2882152"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Dynamics 365 Sales Insights feature that offers the seller a competitive advantage by surfacing relevant and actionable insights and by automating mundane tasks. This gives time back to sellers and, in turn, increases productivity across the entire sales organization.</descrip></descripGrp><ntig><termGrp><term id="2882006">Dynamics 365 Assistant</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2882152">Ajudant</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51035_2882006_2882162"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Dynamics 365 Sales Insights feature that offers the seller a competitive advantage by surfacing relevant and actionable insights and by automating mundane tasks. This gives time back to sellers and, in turn, increases productivity across the entire sales organization.</descrip></descripGrp><ntig><termGrp><term id="2882006">Dynamics 365 Assistant</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2882162">Ajudant del Dynamics 365</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51035_2882042_2882152"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Dynamics 365 Sales Insights feature that offers the seller a competitive advantage by surfacing relevant and actionable insights and by automating mundane tasks. This gives time back to sellers and, in turn, increases productivity across the entire sales organization.</descrip></descripGrp><ntig><termGrp><term id="2882042">Assistant</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2882152">Ajudant</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51035_2882042_2882162"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Dynamics 365 Sales Insights feature that offers the seller a competitive advantage by surfacing relevant and actionable insights and by automating mundane tasks. This gives time back to sellers and, in turn, increases productivity across the entire sales organization.</descrip></descripGrp><ntig><termGrp><term id="2882042">Assistant</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2882162">Ajudant del Dynamics 365</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51036_2882007_2882163"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The portal where users can interact with their peers and Microsoft Dynamics 365 experts. They can get answers to their questions by posting questions in the forums, starting discussions, reading informative blog articles, and watching how-to videos.</descrip></descripGrp><ntig><termGrp><term id="2882007">Dynamics 365 Community</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2882163">Comunitat del Dynamics 365</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51037_2882008_2882164"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The SOAP endpoint used mainly to retrieve data and metadata from MSCRM Organization.</descrip></descripGrp><ntig><termGrp><term id="2882008">Dynamics 365 Organization service</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2882164">Servei d'organització del Dynamics 365</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51038_2882009_2882165"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The portal solutions that extend Dynamics 365 Customer Engagement apps to internal and external audiences such as communities, customers, partners, and employees.</descrip></descripGrp><ntig><termGrp><term id="2882009">Dynamics 365 Portals</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2882165">Portals del Dynamics 365</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51039_2882010_2882166"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The enhanced email experience in Dynamics 365 Sales and other model-driven apps that allows users to compose an email without leaving the record they are working on.</descrip></descripGrp><ntig><termGrp><term id="2882010">enhanced email</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2882166">correu electrònic millorat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51040_2882011_2882167"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An entity that enables users to provide feedback and ratings for entity records.</descrip></descripGrp><ntig><termGrp><term id="2882011">feedback entity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2882167">entitat de comentaris</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51041_2882012_2882168"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of a survey question that allows survey designers to combine several question types together into a table.</descrip></descripGrp><ntig><termGrp><term id="2882012">grid question</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2882168">pregunta de la quadrícula</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51042_2882013_2882169"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A virtual card that helps keep users up to date with their work in Dynamics 365 Sales, letting them know when they need to follow-up on an email, attend a meeting, and more. Insight cards are displayed throughout the application to provide relevant information for the context users are working in.</descrip></descripGrp><ntig><termGrp><term id="2882013">insight card</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2882169">targeta d'informació</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51043_2882014_2882170"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An answer associated with the survey response.</descrip></descripGrp><ntig><termGrp><term id="2882014">linked answer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2882170">resposta enllaçada</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51044_2882015_2882171"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of the survey question where the categories created are the answers given to a previous/other question.</descrip></descripGrp><ntig><termGrp><term id="2882015">linked question</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2882171">pregunta enllaçada</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51045_2882016_2882172"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Dynamics 365 Sales Insights, a JSON file containing call recording metadata that is uploaded together with the corresponding audio file to the call recording repository.</descrip></descripGrp><ntig><termGrp><term id="2882016">metadata file</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2882172">fitxer de metadades</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51046_2882017_2882173"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Dynamics 365 Sales Insights feature that provides users with suggestions for actions based on customer-related activities. When a user creates an activity, such as appointment, email, phone call, task, note, post, or custom activities, the notes analysis feature analyzes the descriptions provided in these activities and gives them intelligent suggestions. With these suggestions, users can take actions, such as creating a meeting request and adding a contact.</descrip></descripGrp><ntig><termGrp><term id="2882017">Notes analysis</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2882173">Anàlisis de notes</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51047_2882018_2882174"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The insight card flagging the receipt of an email concerning an open opportunity with negative sentiment which can put the opportunity at risk.</descrip></descripGrp><ntig><termGrp><term id="2882018">Opportunity at risk</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2882174">Oportunitat en risc</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51048_2882019_2882175"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A product associated with the opportunity.</descrip></descripGrp><ntig><termGrp><term id="2882019">opportunity product</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2882175">producte d'oportunitat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51049_2882020_2882176"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method of delivering experiences unique to each individual. It enables marketers to observe customer behavior, and with every action taken, build a profile of customer preferences. Predictive intelligence uses algorithms to deliver content based on estimates of what the customer wants or needs.</descrip></descripGrp><ntig><termGrp><term id="2882020">predictive intelligence</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2882176">intel·ligència predictiva</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51050_2882021_2882177"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Dynamics 365 Sales Insights feature that provides a scoring model to generate scores for leads that are available for a user in their pipeline. Using these scores, users can identify and prioritize leads that have more chances of converting into opportunities.</descrip></descripGrp><ntig><termGrp><term id="2882021">Predictive lead scoring</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2882177">puntuació de clients potencials predictiva</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51051_2882022_2882178"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Dynamics 365 Sales Insights feature that uses a predictive machine learning model to calculate a score for all open opportunities. The score helps salespeople prioritize opportunities, achieve higher opportunity qualification rates, and reduce the time that it takes to qualify an opportunity.</descrip></descripGrp><ntig><termGrp><term id="2882022">Predictive opportunity scoring</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2882178">puntuació d'oportunitats predictiva</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51052_2882023_2882179"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A score calculated by the predictive machine learning model for all open opportunities. It helps salespeople prioritize opportunities, achieve higher opportunity qualification rates, and reduce the time that it takes to qualify an opportunity.</descrip></descripGrp><ntig><termGrp><term id="2882023">predictive score</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2882179">puntuació predictiva</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51053_2882024_2882180"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Dynamics 365 Sales Insights feature that helps salespeople focus on generating revenue instead of spending their time updating Dynamics 365 Sales data and logging every customer-related activity. In addition to activity suggestions based on capturing emails and meetings, premium auto capture also provides suggestions for creating new contacts.</descrip></descripGrp><ntig><termGrp><term id="2882024">premium auto capture</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2882180">captura automàtica prèmium</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51054_2882025_2882181"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A sales price of an item.</descrip></descripGrp><ntig><termGrp><term id="2882025">price per unit</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2882181">preu per unitat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51055_2882026_2882182"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Several individual goods or services that are sold to consumers as one combined package.</descrip></descripGrp><ntig><termGrp><term id="2882026">product bundle</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2882182">paquet de productes</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51056_2882027_2882183"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A participant in the Partner Program who provides a customer referral for a successful relationship.</descrip></descripGrp><ntig><termGrp><term id="2882027">referral partner</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2882183">associat de referència</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51057_2882028_2882184"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Overall health and trend of each of your business relationships.</descrip></descripGrp><ntig><termGrp><term id="2882028">relationship health</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2882184">estat de la relació</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51058_2882029_2882185"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process of asking respondents additional questions in a survey, based on previous responses. A response route consists of conditions and actions. Responses are evaluated based on conditions specified. When a specific condition is met, the response route runs an action that corresponds to that outcome.</descrip></descripGrp><ntig><termGrp><term id="2882029">response routing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2882185">encaminament de respostes</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51059_2882030_2882186"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Dynamics 365 Sales Insights feature that aims to help inside sellers sell smarter. Building a strong pipeline, offering context, and surfacing automated recommendations throughout a sales sequence, helps to transform the sales process.</descrip></descripGrp><ntig><termGrp><term id="2882030">Sales acceleration</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2882186">Acceleració de vendes</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51060_2882031_2882187"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Dynamics 365 Sales Insights feature that provides a tailored experience for sellers by minimizing the time they spend on their search for the best next customer to reach out to. The Sales accelerator gathers information from multiple sources and lets sellers focus on how to best approach their customers. It helps sellers to sell smartly, by building a strong and prioritized pipeline, offering context, and surfacing automated recommendations throughout a sales sequence that helps to speed the sales process.</descrip></descripGrp><ntig><termGrp><term id="2882031">Sales accelerator</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2882187">Accelerador de vendes</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51061_2882032_2882188"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app built on the Unified Interface framework that uses responsive web design principles to provide an optimal viewing and interaction experience for any screen size, device, or orientation. The Sales Hub app is optimized to work on mobile devices as well as desktops.</descrip></descripGrp><ntig><termGrp><term id="2882032">Sales Hub</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2882188">Centre de vendes</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51062_2882033_2882189"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A measure, on average, how satisfied or unsatisfied customers are with a product or service.</descrip></descripGrp><ntig><termGrp><term id="2882033">satisfaction rating</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2882189">valoració de satisfacció</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51063_2882034_2882190"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Voice of the Customer feature that provides a simple and intuitive experience for survey designers to add, remove, and modify survey pages, sections, questions, and answers.</descrip></descripGrp><ntig><termGrp><term id="2882034">Survey Designer</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2882190">Dissenyador d'enquestes</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51064_2882035_2882191"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Dynamics 365 Sales Insights feature that helps users in an organization to quickly establish communications with customers by providing a mechanism to automatically identify conversation starters from their emails. The conservation starters include topics that are related to sports, vacation, family, and entertainment.</descrip></descripGrp><ntig><termGrp><term id="2882035">Talking points</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2882191">Punts de conversa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51065_2882036_2882192"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Dynamics 365 Sales Insights option that shows the average time top sellers spend talking instead of listening to customers compared to the rest of the sales team.</descrip></descripGrp><ntig><termGrp><term id="2882036">talk-to-listen ratio</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2882192">relació entre parla i escolta</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51066_2882037_2882193"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The section in the LinkedIn Sales Navigator Lead control that shows information about a LinkedIn member profile, like name, headline, and more. Additionally, it provides capabilities to message or save the person as a lead in Sales Navigator.</descrip></descripGrp><ntig><termGrp><term id="2882037">Top Card</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2882193">Targeta superior</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51067_2882038_2882194"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A term customers are mentioning most often during the sales calls. Using tracked keywords, sellers can identify new sales opportunities that are related to them.</descrip></descripGrp><ntig><termGrp><term id="2882038">tracked keyword</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2882194">paraula clau amb seguiment</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51068_2882039_2882197"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of links used for navigation based on location on the webpage.</descrip></descripGrp><ntig><termGrp><term id="2882039">web link set</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2882197">conjunt d'enllaços web</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51069_2882040_2882198"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Dynamics 365 Sales Insights feature that provides sales representatives with details such as names and email addresses of their colleagues who know the lead. With these details, they can contact their colleagues for help in getting introduced to a lead and increase the chances of a positive outcome during the interaction.</descrip></descripGrp><ntig><termGrp><term id="2882040">Who Knows Whom</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2882198">Qui coneix qui</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51070_2882041_2882199"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Percentage of opportunities historically won by the seller.</descrip></descripGrp><ntig><termGrp><term id="2882041">win rate</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2882199">taxa d'èxit</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51076_2884323_2885393"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The visual in which report authors can add and tailor dynamic, interactive narratives to reports that are automatically generated by Power BI.</descrip></descripGrp><ntig><termGrp><term id="2884323">Smart narrative</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2885393">Narrativa intel·ligent</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51077_2884324_2885392"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A free Power BI licensing option.</descrip></descripGrp><ntig><termGrp><term id="2884324">Power BI free license</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2885392">llicència gratuïta del Power BI</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51078_2884325_2885394"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in Power BI Desktop that allows you to control whether the table data is cached in-memory for reports.</descrip></descripGrp><ntig><termGrp><term id="2884325">storage mode</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2885394">mode d'emmagatzematge</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51079_2884326_2885391"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To increase the visibility and encourage the use of reliable, high-quality dataflows and datasets by promoting or certifying them.</descrip></descripGrp><ntig><termGrp><term id="2884326">endorse</term><termNote type="partOfSpeech">Verb</termNote><termNo