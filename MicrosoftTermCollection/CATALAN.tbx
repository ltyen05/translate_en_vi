.ETS</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2985529">FORECAST.ETS</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52417_2955629_2985530"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Statistical Excel function that returns a confidence interval for the forecast value at the specified target date.</descrip></descripGrp><ntig><termGrp><term id="2955629">FORECAST.ETS.CONFINT</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2985530">FORECAST.ETS.CONFINT</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52418_2955630_2985531"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Statistical Excel function that returns the length of the repetitive pattern Excel detects for the specified time series.</descrip></descripGrp><ntig><termGrp><term id="2955630">FORECAST.ETS.SEASONALITY</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2985531">FORECAST.ETS.SEASONALITY</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</term