r">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2913228">Sud-est del Brasil</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5125_237307_327281"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A form that can be opened and filled in via a web browser.</descrip></descripGrp><ntig><termGrp><term id="237307">Web-enabled InfoPath form</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="327281">Formulari de l'InfoPath habilitat per al web</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5127_340084_1555449"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To add new text, objects or cells without overwriting existing data.</descrip></descripGrp><ntig><termGrp><term id="340084">insert</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1555449">inserir</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5128_319431_1555469"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to characters that are evenly slanted to the right or in the direction of text flow.</descrip></descripGrp><ntig><termGrp><term id="319431">italic</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1555469">cursiva</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5129_415567_1150903"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An action or occurrence to which a program might respond. Examples include state changes, data transfers, key presses, and mouse movements.</descrip></descripGrp><ntig><termGrp><term id="415567">program event</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1150903">incidència</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5129_415567_1963623"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An action or occurrence to which a program might respond. Examples include state changes, data transfers, key presses, and mouse movements.</descrip></descripGrp><ntig><termGrp><term id="415567">program event</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1963623">esdeveniment de programa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5129_51961_1150903"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An action or occurrence to which a program might respond. Examples include state changes, data transfers, key presses, and mouse movements.</descrip></descripGrp><ntig><termGrp><term id="51961">event</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1150903">incidència</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5129_51961_1963623"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An action or occurrence to which a program might respond. Examples include state changes, data transfers, key presses, and mouse movements.</descrip></descripGrp><ntig><termGrp><term id="51961">event</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1963623">esdeveniment de programa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51296_2890797_2891333"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A measure ranging from 0 to 1 that indicates how similar two values are.</descrip></descripGrp><ntig><termGrp><term id="2890797">similarity score</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2891333">puntuació de similitud</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51297_2890887_2935532"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The browser created for WinAutomation process to deliver the most accurate automation scheme based on user's web interaction history.</descrip></descripGrp><ntig><termGrp><term id="2890887">Automation Browser</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2935532">Navegador d'automatització</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51298_2890888_2935537"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A capability for inspecting a text aiming at identifying the prevalent emotional opinion within the text, especially to determine if the writer's attitude is positive, negative, or neutral.</descrip></descripGrp><ntig><termGrp><term id="2890888">sentiment analysis</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2935537">anàlisi de l'opinió</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51300_2890891_2935539"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The concept of letting software robots perform actions, tasks, and processes that involves a web browser or web application.</descrip></descripGrp><ntig><termGrp><term id="2890891">Web Automation</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2935539">Automatització web</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51301_2891089_2891595"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Slovenian national holiday celebrated on June 25 to commemorate Slovenia's declaration of independence from Yugoslavia in 1991.</descrip></descripGrp><ntig><termGrp><term id="2891089">Statehood Day</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2891595">Dia de l'Estat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51302_2891211_2891606"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The national holiday in Bosnia and Herzegovina celebrated on November 25 to commemorate the day in 1943 on which ZAVNOBiH, the Anti-Fascist Council of Bosnia and Herzegovina, adopted a resolution to declare the country/region an equal community of Muslims, Serbs, and Croats.</descrip></descripGrp><ntig><termGrp><term id="2891211">Statehood Day (Bosnia and Herzegovina)</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2891606">Dia de l'Estat (Bòsnia i Hercegovina)</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51303_2891233_2891548"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Czech national holiday celebrated on September 28 to commemorate the day in 935 on which St. Wenceslas, patron of the Czech state, was murdered by his brother.</descrip></descripGrp><ntig><termGrp><term id="2891233">Czech Statehood Day (St. Wenceslas Day)</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2891548">Dia de l'Estat Txec (Sant Venceslau)</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51304_2891239_2891562"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Argentinian national holiday celebrated on June 20 to commemorate the Argentine flag and its creator, Manuel Belgrano.</descrip></descripGrp><ntig><termGrp><term id="2891239">Flag Day</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2891562">Dia de la Bandera</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51305_2891254_2891573"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The supplementary holiday day that may be granted during years in which Argentina's Flag Day occurs on a Tuesday or a Thursday and is used to create a four-day weekend.</descrip></descripGrp><ntig><termGrp><term id="2891254">Flag Day (bridge)</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2891573">Dia de la Bandera (pont)</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51306_2891255_2891567"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Mexican national holiday celebrated on February 24 to commemorate past and current flags of Mexico.</descrip></descripGrp><ntig><termGrp><term id="2891255">Flag Day</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2891567">Dia de la Bandera</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51307_2891256_2891571"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The national holiday in Poland celebrated on May 2 to commemorate the raising of the Polish flag over the Victory Column at the end of the Battle of Berlin in 1945.</descrip></descripGrp><ntig><termGrp><term id="2891256">Flag Day</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2891571">Dia de la Bandera</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51308_2891257_2891576"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Azerbaijan national holiday celebrated on November 9 to commemorate the adoption of the Flag of Azerbaijan on November 9, 1918.</descrip></descripGrp><ntig><termGrp><term id="2891257">National Flag Day</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2891576">Dia de la Bandera Nacional</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51309_2891258_2892055"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The day on which the Azerbaijan National Flag Day is celebrated if the official holiday itself falls on a weekend.</descrip></descripGrp><ntig><termGrp><term id="2891258">National Flag Day (Observed)</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2892055">Dia de la Bandera Nacional (traslladat)</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5131_159863_1143946"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of detecting and splitting video content into separate clips. Clips are created by Windows Movie Maker when there is a significant change from one frame to another.</descrip></descripGrp><ntig><termGrp><term id="159863">clip creation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1143946">creació de clips</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51323_2892217_2893862"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To prevent a UI element such as an error, notification, button, or a visual feature such as line numbers or page margins, from appearing to the end user.</descrip></descripGrp><ntig><termGrp><term id="2892217">suppress</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2893862">suspendre</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51330_2893119_2893858"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Implies that the artifact (object or activity) or some of its characteristics deviate from what is considered ‘normal’; typically a statistical outlier.</descrip></descripGrp><ntig><termGrp><term id="2893119">anomalous</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2893858">anòmal</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51331_2893120_2893863"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A number calculated to let the customer know how vulnerable devices in their organization are.</descrip></descripGrp><ntig><termGrp><term id="2893120">exposure score</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2893863">puntuació d'exposició</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51336_2893893_2907265"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of tools that helps you create, reuse, and share Adaptive Cards.</descrip></descripGrp><ntig><termGrp><term id="2893893">templating</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2907265">creació de plantilles</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51338_2893964_2894016"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Microsoft 365 Teams background effect that is limited only to uploading the user's own images.</descrip></descripGrp><ntig><termGrp><term id="2893964">custom background</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2894016">fons personalitzat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51339_2893965_2894015"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Xbox Live matchmaking service that groups players based on user information and the request for any users who want to play together.</descrip></descripGrp><ntig><termGrp><term id="2893965">SmartMatch</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2894015">SmartMatch</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51341_2894028_2894381"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">​The next iteration of the Authenticator app in which users can save and automatically fill passwords, addresses, and payment info on mobile devices and computers (via browser extension).</descrip></descripGrp><ntig><termGrp><term id="2894028">Microsoft Autofill</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2894381">Emplenament automàtic del Windows</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51343_2894031_2894380"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature of the Windows Clock app that allows the user to set a timer for a period of focus time.</descrip></descripGrp><ntig><termGrp><term id="2894031">Focus sessions</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2894380">Sessions de productivitat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51347_2894037_2894383"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The possibility for a person to input text in Windows with their voice (aka dictation).</descrip></descripGrp><ntig><termGrp><term id="2894037">voice typing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2894383">escriptura mitjançant la veu</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51349_2894217_2894364"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The international holiday celebrated on March 8 that honors women and is commemorated in various ways around the world, including as a public holiday, a day of protest, or as a celebration of womanhood.</descrip></descripGrp><ntig><termGrp><term id="2894217">International Women's Day</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2894364">Dia internacional de les dones</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51350_2894218_2894366"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Vietnamese public holiday celebrated on April 30 to commemorate the day in 1975 when North Vietnamese and Việt Cộng forces captured Saigon (now Ho Chi Minh City), signaling the end of the Vietnam War and the beginning of the reunification process.</descrip></descripGrp><ntig><termGrp><term id="2894218">Reunification Day</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2894366">Dia de la reunificació</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51351_2894219_2894369"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The day on which the Vietnamese holiday Reunification Day is celebrated if the official holiday itself falls on a weekend.</descrip></descripGrp><ntig><termGrp><term id="2894219">Reunification Day (Observed)</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2894369">Dia de la reunificació (traslladat)</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51352_2894246_2895175"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An account from a social identity provider, such as Facebook or Google.</descrip></descripGrp><ntig><termGrp><term id="2894246">social account</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2895175">compte de xarxa social</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51364_2894612_3024573"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The transport layer network protocol based on User Datagram Protocol (UDP), which can improve the performance of web applications that currently use TCP.</descrip></descripGrp><ntig><termGrp><term id="2894612">QUIC</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3024573">QUIC</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51369_2894964_2895107"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The tool that allows customers to compare their EOP policies settings against Microsoft's recommended settings for EOP and Office 365 ATP security.</descrip></descripGrp><ntig><termGrp><term id="2894964">Configuration Analyzer</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termG