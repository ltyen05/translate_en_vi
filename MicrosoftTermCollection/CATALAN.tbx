eprovision phone numbers and (eventually) acquire/obtain capabilities from certified Carriers, all through the Teams Admin Center.</descrip></descripGrp><ntig><termGrp><term id="2926577">Operator Connect</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2927184">Connexió amb operador</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51983_2926579_2927173"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The tab in Microsoft Teams that allows the user to create, manage, and share approval requests such as stakeholder authorizations, customer signatures, or manager acknowledgements.</descrip></descripGrp><ntig><termGrp><term id="2926579">Approvals</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2927173">Aprovacions</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51984_2926583_2927176"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Teams, the way to present in which only the shared content itself is shown.</descrip></descripGrp><ntig><termGrp><term id="2926583">Content only</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2927176">Només contingut</term><termNote type="geographicalUsage">ESP</termNote><termNo