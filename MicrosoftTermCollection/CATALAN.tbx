ality Video</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2052510">Vídeo en alta qualitat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33718_1814245_2052513"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The status that appears when a user is signed in to his/her account but elects to appear as if they are offline to any contacts, but that also allows him/her to receive IMs.</descrip></descripGrp><ntig><termGrp><term id="1814245">Invisible</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2052513">Invisible</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3372_359704_1098296"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A data type used to hold date and time information.</descrip></descripGrp><ntig><termGrp><term id="359704">Date/Time</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1098296">Data/hora</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3372_359704_1098297"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A data type used to hold date and time information.</descrip></descripGrp><ntig><termGrp><term id="359704">Date/Time</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1098297">datetime</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3372_374687_1098296"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A data type used to hold date and time information.</descrip></descripGrp><ntig><termGrp><term id="374687">datetime</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1098296">Data/hora</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3372_374687_1098297"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A data type used to hold date and time information.</descrip></descripGrp><ntig><termGrp><term id="374687">datetime</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1098297">datetime</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33720_1814248_2052519"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The status that indicates a user is signed out of his/her account and that he/she is not able to receive calls or IMs.</descrip></descripGrp><ntig><termGrp><term id="1814248">Offline</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2052519">Desconnectat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33721_1814249_2052520"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The status that indicates a user is signed in to his/her account.</descrip></descripGrp><ntig><termGrp><term id="1814249">Online</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2052520">Connectat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33722_1814262_2052546"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Skype product that allows a user to call directly to Skype from landlines and mobile phones.</descrip></descripGrp><ntig><termGrp><term id="1814262">Skype Number</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2052546">Número de Skype</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="gr