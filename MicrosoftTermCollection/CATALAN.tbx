st often in machine or assembly language. Most programs consist of two types of statements: declarations and instructions.</descrip></descripGrp><ntig><termGrp><term id="67901">instruction</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1555456">instrucció</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14498_359990_2094776"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A query (SQL statement) that removes rows matching the criteria you specify from one or more tables.</descrip></descripGrp><ntig><termGrp><term id="359990">delete query</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2094776">consulta de supressió</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="145_235054_722510"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A filter that helps to identify fraudulent Web sites and protect against personal data theft.</descrip></descripGrp><ntig><termGrp><term id="235054">Phishing Filter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="722510">filtre de pesca</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote ty