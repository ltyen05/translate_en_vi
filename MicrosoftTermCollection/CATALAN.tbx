bleshooting, and maintenance tools.</descrip></descripGrp><ntig><termGrp><term id="310984">Windows Recovery Environment</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1766962">Windows RE</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15705_311011_1766962"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A special version of Windows Preinstallation Environment (Windows PE) that includes diagnostic, troubleshooting, and maintenance tools.</descrip></descripGrp><ntig><termGrp><term id="311011">WinRE</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1766962">Windows RE</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15714_185126_515205"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process that enables the user to integrate their PBX phone with Lync or Communicator, so they can place and receive calls from these products.</descrip></descripGrp><ntig><termGrp><term id="185126">phone integration</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="515205">integració amb el telèfon</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine<