lNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2740246">Supervisió</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48468_2738468_2740237"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft 365 compliance center view that allows users to search, investigate, and take action on data-related incidents such as a data breach, data spillage, or needing to search for and purge messages that contain a harmful attachment.</descrip></descripGrp><ntig><termGrp><term id="2738468">Data investigations</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2740237">Investigacions de dades</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48469_2738471_2740238"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft 365 compliance center view that allows users to respond to a data subject request and create data subject request cases.</descrip></descripGrp><ntig><termGrp><term id="2738471">Data subject requests</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2740238">Sol·licituds de titular de les dades</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48472_2739176_2742205"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A piece of targeted information that is meant to change an individual's perception on something in a way that is untrue such that the shift will cause harm.</descrip></descripGrp><ntig><termGrp><term id="2739176">weaponized information</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2742205">informació enganyosa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48474_2739487_2742117"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A condition under which a policy is triggered.</descrip></descripGrp><ntig><termGrp><term id="2739487">policy trigger</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2742117">disparador de norma</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48482_2741337_2742282"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to authentication means that do not require a password.</descrip></descripGrp><ntig><termGrp><term id="2741337">password-less</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2742282">sense contrasenya</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48482_2917812_2742282"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to authentication means that do not require a password.</descrip></descripGrp><ntig><termGrp><term id="2917812">passwordless</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2742282">sense contrasenya</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48485_2741340_2742283"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A means of authentication in which key-based authentication is used to enable a user credential that is tied to a device and the users are not required to provide a password.</descrip></descripGrp><ntig><termGrp><term id="2741340">password-less authentication</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2742283">autenticació sense contrasenya</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48485_2917816_2742283"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A means of authentication in which key-based authentication is used to enable a user credential that is tied to a device and the users are not required to provide a password.</descrip></descripGrp><ntig><termGrp><term id="2917816">passwordless authentication</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2742283">autenticació sense contrasenya</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48488_2741343_2742292"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The security model that requires authentication and encryption of each access request as though it originates from an open network. Principles include segmentation, to make it harder for attackers to move through the network, and restricting user access to the minimum amount needed to do their job.</descrip></descripGrp><ntig><termGrp><term id="2741343">Zero Trust</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2742292">Confiança zero</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4849_184188_364166"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The collection of custom properties for a shape.</descrip></descripGrp><ntig><termGrp><term id="184188">shape data</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="364166">Dades de formes</ter