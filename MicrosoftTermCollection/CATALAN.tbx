</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2362371">Ofertes de música</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40698_2360417_2362395"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The category in Windows Store music section that shows the user's music in Groove Music app.</descrip></descripGrp><ntig><termGrp><term id="2360417">My music</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2362395">La meva música</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40699_2360422_2362515"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The movie or TV show label assigned to a movie or TV show that has not been rated by the Motion Picture Association of America (MPAA).</descrip></descripGrp><ntig><termGrp><term id="2360422">Unrated</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2362515">Pendent de classificació</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40700_2360425_2362425"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The view that shows the recent items you have played.</descrip></descripGrp><ntig><termGrp><term id="2360425">Recent plays</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2362425">Reproduccions recents</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40701_2360426_2362437"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A pass that provides access to all current and future episodes of a TV show season, usually sold at a discount price.</descrip></descripGrp><ntig><termGrp><term id="2360426">season pass</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2362437">passi de temporada</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40703_2360428_2362532"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A library that contains your video files.</descrip></descripGrp><ntig><termGrp><term id="2360428">video library</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2362532">biblioteca de vídeos</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40705_2360433_2362449"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The collection title for songs that are in the top N% of sales.</descrip></descripGrp><ntig><termGrp><term id="2360433">Top-selling songs</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2362449">Les cançons més venudes</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40706_2360434_2362377"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The category in Windows Store Movies &amp; TV section that shows the movies and TV shows purchased and rented by you as well as your videos in Movies &amp; TV app.</descrip></descripGrp><ntig><termGrp><term id="2360434">My movies &amp; TV</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2362377">Les meves pel·lícules i els meus programes</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40707_2360435_2362420"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To order an item that is currently not available.</descrip></descripGrp><ntig><termGrp><term id="2360435">pre-order</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2362420">comprar per endavant</term><termNote type="geographica