age">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37237_2110741_2147899"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Visio Pro for Office 365 offer for government organizations that is hosted in the government cloud environment.</descrip></descripGrp><ntig><termGrp><term id="2110741">Visio Pro for Office 365 for Government</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2147899">Visio Pro per a l'Office 365 per al sector públic</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37238_2111532_2147783"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The offer for government organizations for Lync Online (Plan 1) that is hosted in the commercial cloud environment.</descrip></descripGrp><ntig><termGrp><term id="2111532">Lync Online (Plan 1) (Government Pricing)</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2147783">Lync Online (pla 1) (preu per al sector públic)</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37239_2111533_2147787"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The offer for government organizations for Lync Online (Plan 2) that is hosted in the commercial cloud environment.</descrip></descripGrp><ntig><termGrp><term id="2111533">Lync Online (Plan 2) (Government Pricing)</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2147787">Lync Online (pla 2) (preu per al sector públic)</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37240_2113073_2137314"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The transient, contextual UI element that appears near to the user’s focus and appears as an ellipsis within a square.</descrip></descripGrp><ntig><termGrp><term id="2113073">Mini Toolbar Indicator</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2137314">Indicador de la minibarra d'eines</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37242_2113075_2137328"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A callout in a UI that contains help information for a new feature, is context-sensitive, and contains information in the form of text, graphics, or animations.</descrip></descripGrp><ntig><termGrp><term id="2113075">Teaching callout</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2137328">Crida d'informació d'ajuda</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37244_2113077_2137315"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The filter in the context of a particular channel that shows only the videos uploaded or owned by the user who is currently logged in.</descrip></descripGrp><ntig><termGrp><term id="2113077">My videos</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2137315">Els meus vídeos</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37249_2113090_2137381"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user account and associated credentials that is used to access Microsoft’s and 3rd parties’ business services, such as Office 365. Work or school accounts are usually assigned to end users by their organization (work, school, non-profit) and managed by the admin. However, some business services like Yammer support work or school accounts that were created by end users, without IT involvement. We sometimes refer to these accounts as “viral” AAD accounts but we don’t use this term externally. Work or school accounts are stored in Azure Active Directory (AAD) and managed by Microsoft on behalf of the organization. One of the key difference with a Microsoft account is that users don’t own the account and will typically loose access to it if they leave the organization. Other aspects like password policies are imposed by admins.</descrip></descripGrp><ntig><termGrp><term id="2113090">work or school account</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2137381">compte laboral o acadèmic</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3725_129780_1321901"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A software implementation of a computer that emulates a complete hardware system, from processor to network card, in a self-contained, isolated software environment, enabling the simultaneous operation of otherwise incompatible operating systems.</descrip></descripGrp><ntig><termGrp><term id="129780">virtual machine</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1321901">màquina virtual</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3725_129781_1321901"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A software implementation of a computer that emulates a complete hardware system, from processor to network card, in a self-contained, isolated software environment, enabling the simultaneous operation of otherwise incompatible operating systems.</descrip></descripGrp><ntig><termGrp><term id="129781">VM</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1321901">màquina virtual</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37250_2113091_2137383"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user account and associated credentials that is used to access Microsoft’s and 3rd parties’ business services, such as Office 365. Work or school accounts are usually assigned to end users by their organization (work, school, non-profit) and managed by the admin. However, some business services like Yammer support work or school accounts that were created by end users, without IT involvement. We sometimes refer to these accounts as “viral” AAD accounts but we don’t use this term externally. Work or school accounts are stored in Azure Active Directory (AAD) and managed by Microsoft on behalf of the organization. One of the key difference with a Microsoft account is that users don’t own the account and will typically loose access to it if they leave the organization. Other aspects like password policies are imposed by admins.</descrip></descripGrp><ntig><termGrp><term id="2113091">work account</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2137383">compte laboral</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37255_2113318_2118099"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Terminal Services session.</descrip></descripGrp><ntig><termGrp><term id="2113318">TS session</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2118099">sessió del Terminal Services</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37255_2113318_2118103"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Terminal Services session.</descrip></descripGrp><ntig><termGrp><term id="2113318">TS session</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2118103">sessió del TS</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37255_2113319_2118099"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Terminal Services session.</descrip></descripGrp><ntig><termGrp><term id="2113319">Terminal Services session</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2118099">sessió del Terminal Services</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37255_2113319_2118103"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Terminal Services session.</descrip></descripGrp><ntig><termGrp><term id="2113319">Terminal Services session</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2118103">sessió del TS</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3726_142929_2095049"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of user accounts in a workgroup, identified by group name and personal ID (PID). Permissions assigned to a group apply to all users in the group.</descrip></descripGrp><ntig><termGrp><term id="142929">group account</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2095049">compte de grup</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37261_2113977_2116692"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The button that takes the user to the previous item or page.</descrip></descripGrp><ntig><termGrp><term id="2113977">Back button</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2116692">botó Enrere</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37262_2113979_2116714"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The button pressed to updat