611381">afinador de taula</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26503_1275392_2717649"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To have as an element.</descrip></descripGrp><ntig><termGrp><term id="1275392">include</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2717649">incloure</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26508_1275542_1963200"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of logging available to capture information about mailbox searches that includes information about the search and who performed it.</descrip></descripGrp><ntig><termGrp><term id="1275542">basic logging</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1963200">registre bàsic</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26509_1275544_1963316"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of logging available to capture information about mailbox searches that includes information about all results that meet the search criteria.</descrip></descripGrp><ntig><termGrp><term id="1275544">full logging</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1963316">registre complet</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26510_1275547_1963204"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A window that serves as an interface between the user and the browser.</descrip></descripGrp><ntig><termGrp><term id="1275547">browser window</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1963204">finestra del navegador</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26511_1275548_1963205"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A role group that ships by default as opposed to a customized role group that a admin would customize specifically for the needs of their organization</descrip></descripGrp><ntig><termGrp><term id="1275548">built-in role group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1963205">grup de funcions integrat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26513_1275552_1963338"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Identity Lifecycle Management (ILM) component that consists of properties, rules, and rule extensions that determine how an object is processed and that provides services to client computers or organizations that connect from remote locations.</descrip></descripGrp><ntig><termGrp><term id="1275552">hosted management agent</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1963338">agent d'administració allotjat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26514_1275570_1335729"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The tooltip for the Close button.</descrip></descripGrp><ntig><termGrp><term id="1275570">Close</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1335729">Tanca</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26515_1275576_1963385"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An instance of a multi-mailbox search.</descrip></descripGrp><ntig><termGrp><term id="1275576">mailbox search</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1963385">cerca en bústies de correu</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26522_1275648_1963595"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The messaging system that an administrator runs on their own servers in their own company as compared to a messaging system that is run in the cloud (hosted).</descrip></descripGrp><ntig><termGrp><term id="1275648">on-premises messaging system</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1963595">sistema de missatgeria local</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26524_1275651_1963617"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An account that can receive mail using the POP3 protocol.</descrip></descripGrp><ntig><termGrp><term id="1275651">POP-enabled account</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1963617">compte habilitat per a POP</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26525_1275652_1963621"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The email address that appears in the E-Mail Options section of the user's mailbox in the Web management interface for Outlook Live.</descrip></descripGrp><ntig><termGrp><term id="1275652">primary e-mail address</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1963621">adreça electrònica principal</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26526_1275654_1963635"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An object that represents a user or resource in Outlook, generally a mail message addressee.</descrip></descripGrp><ntig><termGrp><term id="1275654">recipient object</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1963635">objecte de destinatari</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26527_1275656_1963637"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The domain that an administrator has registered with a domain registrar.</descrip></descripGrp><ntig><termGrp><term id="1275656">registered domain</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1963637">domini registrat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26529_1275659_1963676"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process by which a user presses and holds a key on their mobile phone keypad to dial a specific phone number.</descrip></descripGrp><ntig><termGrp><term id="1275659">speed dialing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1963676">marcatge abreujat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26530_1275661_1963290"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The settings, related to the domain, a user needs to configure to get messaging up and running.</descrip></descripGrp><ntig><termGrp><term id="1275661">domain settings</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1963290">configuració del domini</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26531_1275663_1336575"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To transfer a call to a holding point instead of holding the call at the phone device.</descrip></descripGrp><ntig><termGrp><term id="1275663">park</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1336575">aparcar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26535_1275693_1336692"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To answer a call by dialing the associated number on the network where it has been parked.</descrip></descripGrp><ntig><termGrp><term id="1275693">retrieve</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1336692">recuperar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26536_1275694_1816879"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that transfers a call back to the person who parked it, after a specified amount of time, so a caller doesn't remain on hold indefinitely.</descrip></descripGrp><ntig><termGrp><term id="1275694">ringback</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1816879">devolució de trucada</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26537_1275696_1336496"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A number assigned to a parked call by the call park server.</descrip></descripGrp><ntig><termGrp><term id="1275696">orbit</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1336496">òrbita</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26538_1275697_1336688"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An additional phone number with a distinct ring tone that cannot be forwarded. A private line allows a person who delegates calls to have a direct, confidential line.</descrip></descripGrp><ntig><termGrp><term id="1275697">private line</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1336688">línia privada</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26539_1275698_1336215"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A microphone and speaker combination configured by the user in Lync and Office Communicator.</descrip></descripGrp><ntig><termGrp><term id="1275698">custom device</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1336215">dispositiu personalitzat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26545_1275963_1336633"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An option on the Transfer button that lets you park a call.</descrip></descripGrp><ntig><termGrp><term id="1275963">Parking Lot</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1336633">Aparcament</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26546_1275964_1336317"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables phone users to report disturbing calls to the system administrator. When the user selects to report a malicious call, data from the last call received is captured and sent to the system administrator.</descrip></descripGrp><ntig><termGrp><term id="1275964">malicious call reporting</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1336317">informe de trucades malicioses</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26549_1275967_2726487"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The client-side SharePoint Server control that allows users to search for and select valid user accounts for people, groups, and claims in their organization to grant permission to items such as lists, libraries, or SharePoint sites.</descrip></descripGrp><ntig><termGrp><term id="1275967">People Picker</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2726487">Selector de persones</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26555_1276173_1555376"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A prewritten formula that simplifies the process of entering calculations and enables the user to use formulas that might be difficult to build from scratch.</descrip></descripGrp><ntig><termGrp><term id="1276173">function</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1555376">funció</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26558_1276179_2048518"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of Human Interaction Proof challenge, which plays an audio file decipherable only by a person. The audio file might seem faint or mixed with background voices and noise. This is intentional to ensure a person, not an automated program, completes the HIP challenge.</descrip></descripGrp><ntig><termGrp><term id="1276179">audio challenge</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2048518">verificació d'àudio</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26585_1280041_1963609"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user who doesn't file mailbox items regularly.</descrip></descripGrp><ntig><termGrp><term id="1280041">piler</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1963609">acumulador</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26585_1280041_1963610"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user who doesn't file mailbox items regularly.</descrip></descripGrp><ntig><termGrp><term id="1280041">piler</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1963610">usuari acumulador</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26585_1346186_1963609"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user who doesn't file mailbox items regularly.</descrip></descripGrp><ntig><termGrp><term id="1346186">piler user</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1963609">acumulador</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26585_1346186_1963610"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user who doesn't file mailbox items regularly.</descri