68100">MK</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39435_2290443_2330310"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A UI component that filters all items, tiles, charts, and streams in the dashboard if the filter criteria matches.</descrip></descripGrp><ntig><termGrp><term id="2290443">global filter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2330310">filtre global</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39436_2290509_2330342"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A section in the service desk dashboard that displays the visualizations, for example, charts and graphs.</descrip></descripGrp><ntig><termGrp><term id="2290509">Visual Filters</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2330342">Filtres visuals</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39437_2290512_2330326"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A pane in the Service Desk  that is easily accessible by a CSR and provides the CSR with key information related to the primary record in t