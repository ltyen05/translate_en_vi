ular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2336313">tarifa de connexió</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40075_2329177_2336312"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A telephone call in which the calling party wants to place a call at the called party's expense.</descrip></descripGrp><ntig><termGrp><term id="2329177">collect call</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2336312">trucada de pagament a destinació</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40076_2329178_2336311"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Collaborative editing of documents, for instance, work on a Microsoft Word document, PowerPoint presentation or Excel spreadsheet.</descrip></descripGrp><ntig><termGrp><term id="2329178">Co-editing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2336311">coedició</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40077_2329179_2336310"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A window for sending text messages.</de