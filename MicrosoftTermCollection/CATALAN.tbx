finition">The filter that users can apply to a photo or video clip to give it a classic look. This is also the name of a theme that applies this filter along with a related text style and music. It evokes a simple, classic, and elegant look and feel.</descrip></descripGrp><ntig><termGrp><term id="2549940">Classic</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2552490">Clàssic</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45146_2549941_2552452"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The filter that users can apply to a photo or video clip to give it a slightly whitened, lightened, or bleached effect.</descrip></descripGrp><ntig><termGrp><term id="2549941">Blanch</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2552452">Pàl·lid</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45147_2549942_2552608"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The black and white filter that users can apply to a photo or video clip.</descrip></descripGrp><ntig><termGrp><term id="2549942">Portrait</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2552608">Retrat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45148_2549943_2552572"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The black and white filter that users can apply to a photo or video clip. This filter has deeper blacks and whiter whites than other filters.</descrip></descripGrp><ntig><termGrp><term id="2549943">Inky</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2552572">Tintat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45149_2549945_2552623"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The filter that users can apply to a photo or video clip, which gives it an effect of muted late evening light.</descrip></descripGrp><ntig><termGrp><term id="2549945">Twilight</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2552623">Capvespre</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45150_2549970_2552564"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The filter that users can apply to a photo or video clip, which intensifies the red and orange tones in the image.</descrip></descripGrp><ntig><termGrp><term id="2549970">Energy</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2552564">Energia</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45151_2549985_2552570"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The filter that users can apply to a photo or video clip, which intensifies the blue tones in the image.</descrip></descripGrp><ntig><termGrp><term id="2549985">Iceberg</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2552570">Iceberg</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45152_2550010_2552579"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The filter that users can apply to a photo or video clip, which intensifies the green tones in the image.</descrip></descripGrp><ntig><termGrp><term id="2550010">Kelly</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2552579">Verd Kelly</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45153_2550035_2552484"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The filter that users can apply to a photo or video clip, which intensifies the colors.</descrip></descripGrp><ntig><termGrp><term id="2550035">Brassy</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2552484">Contrastat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45154_2550036_2552525"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The filter that users can apply to a photo or video clip, which gives it a slightly rough and worn out quality.</descrip></descripGrp><ntig><termGrp><term id="2550036">Denim</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2552525">Denim</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45155_2550037_2552524"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The filter that users can apply to a photo or video clip, which sharpens the image and keeps colors intact.</descrip></descripGrp><ntig><termGrp><term id="2550037">Clean</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2552524">Precís</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masc