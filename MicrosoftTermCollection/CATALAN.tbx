/termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19979_692582_761143"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The value or quality improvement of the features, operations, functions, or capability supported by a program or program component.</descrip></descripGrp><ntig><termGrp><term id="692582">product functionality enhancement</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761143">millora en la funcionalitat del producte</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19979_694707_760957"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The value or quality improvement of the features, operations, functions, or capability supported by a program or program component.</descrip></descripGrp><ntig><termGrp><term id="694707">enhancement</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="760957">millora</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19979_694707_761143"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The value or quality improvement of the features, operations, functions, or capability supported by a program or program component.</descrip></descripGrp><ntig><termGrp><term id="694707">enhancement</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761143">millora en la funcionalitat del producte</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19980_692583_761148"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The original receipt or other document which confirms payment.</descrip></descripGrp><ntig><termGrp><term id="692583">proof of payment</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761148">justificant de pagament</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19981_692584_761151"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To acquire something by buying it.</descrip></descripGrp><ntig><termGrp><term id="692584">purchase</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761151">adquirir</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19982_692585_761153"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">When used in a Microsoft volume licensing agreement, a personal desktop computer, portable computer, workstation, or a similar device that is used by and for the benefit of an organization that has entered into a volume licensing agreement with Microsoft to run products under that agreement. Qualified desktops do not include computers designated as a server, any system dedicated to run only line-of-business software, or any system running an embedded operating system (for example, Microsoft Windows).</descrip></descripGrp><ntig><termGrp><term id="692585">qualified desktop</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761153">desktop qualificat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19983_692588_761154"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">When referring to a Microsoft volume licensing agreement, any person who is authorized to access a copy of server software licensed by a customer that has entered into a volume licensing enrollment with Microsoft.</descrip></descripGrp><ntig><termGrp><term id="692588">qualified user</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761154">usuari qualificat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19984_692592_761155"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To be eligible for something by meeting a specific requirement or condition.</descrip></descripGrp><ntig><termGrp><term id="692592">qualify</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761155">susceptible de</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19985_692593_761161"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">When referring to a license, to assign a license right to another entity or person.</descrip></descripGrp><ntig><termGrp><term id="692593">reassign</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761161">reassignar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19986_692594_761164"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To remove all software and data from a computer and return it to a pre-saved image.</descrip></descripGrp><ntig><termGrp><term id="692594">re-image</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761164">substituir còpies</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19987_692596_761165"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The rights relating to the re-imaging of Microsoft software licensed under a volume licensing agreement.</descrip></descripGrp><ntig><termGrp><term id="692596">re-imaging rights</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761165">drets a substituir còpies</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19989_693619_761166"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To pay back.</descrip></descripGrp><ntig><termGrp><term id="693619">reimburse</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761166">reemborsar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1999_1359036_1367583"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A list of entities such as people, groups, or organizations with whom users communicate.</descrip></descripGrp><ntig><termGrp><term id="1359036">Contacts list</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1367583">Llista de contactes</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Fem