rules that define the steps necessary to automate specific business processes, tasks, or sets of actions to be performed on Microsoft Dynamics CRM records.</descrip></descripGrp><ntig><termGrp><term id="1703365">workflow</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1724748">flux de treball</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32789_1703368_1816863"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Functionality supplied by the Web Conferencing service such as data sharing, and uploading documents and PowerPoint presentations, by using whiteboards and desktop sharing.</descrip></descripGrp><ntig><termGrp><term id="1703368">web conferencing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1816863">conferència web</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3279_59527_2418003"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In a drawing program, to transform a number of objects into a group.</descrip></descripGrp><ntig><termGrp><term id="59527">group</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2418003">agrupar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32793_2043316_2045825"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A component that sits inside the CRM deployment and delivers messages received at an endpoint to the target organization.</descrip></descripGrp><ntig><termGrp><term id="2043316">Microsoft Dynamics CRM Listener for Microsoft Azure</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2045825">Oient del Microsoft Dynamics CRM per al Microsoft Azure</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32794_1703373_1816837"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A server running Windows Server that meets specified hardware requirements, and that has Lync Server Registrar and Mediation Server software installed on it. Like Survivable Branch Appliances, this device can provide voice mail survivability for branch users during a WAN outage.</descrip></descripGrp><ntig><termGrp><term id="1703373">Survivable Branch Server</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1816837">Servidor de branca amb funcions de supervivència</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32795_1703374_1724729"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A wall in Dynamics CRM for conversations that are marked as being able to be seen by the entire organization.</descrip></descripGrp><ntig><termGrp><term id="1703374">Public Conversations</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1724729">Converses públiques</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32802_1703963_1724692"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Creating relationships between an email activity and other records by using the information from email headers.</descrip></descripGrp><ntig><termGrp><term id="1703963">correlation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1724692">correlació</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32803_1703964_1724691"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Keeping a record of chat conversations in CRM, which occur through Lync.</descrip></descripGrp><ntig><termGrp><term id="1703964">conversation tracking</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1724691">seguiment de converses</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32804_1703967_1724699"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in Microsoft Dynamics CRM that allows users to connect to the email service of their choice from CRM.</descrip></descripGrp><ntig><termGrp><term id="1703967">Email Connector</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1724699">Connector de correu electrònic</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32805_1703968_1708198"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To remove the mapping from a folder to OneDrive.</descrip></descripGrp><ntig><termGrp><term id="1703968">unlink</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1708198">desenllaçar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3282_1172831_1303441"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of products and technologies that allow users in an organization to create, manage, and build their own collaborative Web sites and make them available throughout their organizations.</descrip></descripGrp><ntig><termGrp><term id="1172831">SharePoint Products</term><termNote ty