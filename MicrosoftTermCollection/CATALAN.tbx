e d'Enterprise Subscription</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20329_724549_1546381"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An enrollment signed under an Enterprise Subscription Agreement by the entity that signed the Enterprise Subscription Agreement or one of its affiliates.</descrip></descripGrp><ntig><termGrp><term id="724549">Enterprise Subscription Enrollment</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1546381">Inscripció Enterprise Subscription</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20330_724550_760973"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The terms and conditions that make up the full agreement between the parties, to the exclusion of any other terms and conditions.</descrip></descripGrp><ntig><termGrp><term id="724550">entire agreement</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="760973">contracte complet</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20331_724551_760975"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The price provided by the manufacturer as the retail price of products licensed or sold through a distribution channel. This is recommended only - actual prices are determined between the customer and the direct seller.</descrip></descripGrp><ntig><termGrp><term id="724551">estimated retail price</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="760975">ERP</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20331_724551_760976"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The price provided by the manufacturer as the retail price of products licensed or sold through a distribution channel. This is recommended only - actual prices are determined between the customer and the direct seller.</descrip></descripGrp><ntig><termGrp><term id="724551">estimated retail price</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="760976">preu minorista estimat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20331_724719_760975"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The price provided by the manufacturer as the retail price of products licensed or sold through a distribution channel. This is recommended only - actual prices are determined between the customer and the direct seller.</descrip></descripGrp><ntig><termGrp><term id="724719">ERP</term><termNote t