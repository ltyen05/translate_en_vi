reators Collection</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2548224">Col·lecció dels creadors</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45119_2547322_2917444"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The program that opens Xbox Live to all developers allowing them to rapidly and directly publish their games on Xbox One or Windows 10 through a short and simplified certification process.</descrip></descripGrp><ntig><termGrp><term id="2547322">Xbox Live Creators Program</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2917444">Programa de creadors de l'Xbox Live</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45119_3110283_2917444"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The program that opens Xbox Live to all developers allowing them to rapidly and directly publish their games on Xbox One or Windows 10 through a short and simplified certification process.</descrip></descripGrp><ntig><termGrp><term id="3110283">Creators Program</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2917444">Programa de creadors de l'Xbox Live</term><termNote type="geographicalUsage">ESP</ter