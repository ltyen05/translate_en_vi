ities resulting in disclosure, modification, destruction, or other compromise of customer data.</descrip></descripGrp><ntig><termGrp><term id="3096553">customer data breach</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3097198">violació de les dades del client</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54302_3096554_3097204"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An issue that has potential to result in a customer data breach, including violations of security policies, acceptable use policies, or standard security practices.</descrip></descripGrp><ntig><termGrp><term id="3096554">security incident</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3097204">incident de seguretat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54303_3096555_3097200"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The mitigation of violations of security policies and recommended practices.</descrip></descripGrp><ntig><termGrp><term id="3096555">incident handling</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3097200">gestió d'incidents</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54304_3096556_3097202"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A security incident that involves the accidental or unauthorized exposure or alteration of customer content and end-user identifiable information (EUII) in Microsoft 365 services.</descrip></descripGrp><ntig><termGrp><term id="3096556">privacy issue</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3097202">problema de privadesa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54312_3097234_3098551"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An observable change to the normal behavior of a system, environment, process, workflow or person; any observable occurrence in a system or network.</descrip></descripGrp><ntig><termGrp><term id="3097234">security event</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3098551">incidència de seguretat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54313_3097235_3098549"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An automated notification resulting from a detection.</descrip></descripGrp><ntig><termGrp><term id="3097235">security alert</term><ter