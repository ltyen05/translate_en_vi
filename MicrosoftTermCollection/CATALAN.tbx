ermGrp><term id="1908771">Office 365 Enterprise E2</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2150419">Office 365 Enterprise E2</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33846_1908773_2150422"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A limited-day trial for an Office 365 online subscription for businesses that need full productivity, communication and collaboration tools with the familiar Office suite, including Office Web Apps.</descrip></descripGrp><ntig><termGrp><term id="1908773">Office 365 Enterprise E3 Trial</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2150422">Prova de l'Office 365 Enterprise E3</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33847_1908774_2150423"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Office 365 subscription for businesses that need productivity, communications and collaboration tools including the familiar desktop Office and compliance features like data loss prevention and archiving. Also includes Skype for Business Plus CAL, enabling customers to get Enterprise Voice on-premises.</descrip></descripGrp><ntig><termGrp><term id="1908774">Office 365 Enterprise E4</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2150423">Office 365 Enterprise E4</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33848_1908775_2150425"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A limited-day trial for an Office 365 online subscription for businesses that need full productivity, communication and collaboration tools with the familiar Office suite, including Office Web Apps and on-premises server rights to information protection and enterprise voice capabilities.</descrip></descripGrp><ntig><termGrp><term id="1908775">Office 365 Enterprise E4 Trial</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2150425">Prova de l'Office 365 Enterprise E4</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33868_1933055_1973806"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A workflow that is synchronous and starts immediately.</descrip></descripGrp><ntig><termGrp><term id="1933055">operational workflow</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1973806">flux de treball operatiu</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33869_1933056_1973809"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A workflow that is asynchronous or that starts at a later time, but does not have to wait for a previous workflow to finish.</descrip></descripGrp><ntig><termGrp><term id="1933056">post-operational workflow</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1973809">flux de treball postoperatiu</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33871_1933171_2405547"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The SharePoint application that enables users to interact with the SharePoint social network of their organization.</descrip></descripGrp><ntig><termGrp><term id="1933171">SharePoint Newsfeed</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2405547">SharePoint Newsfeed</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33872_1933262_1953139"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A computer that has properties both of a tablet and a laptop.</descrip></descripGrp><ntig><termGrp><term id="1933262">convertible</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="195