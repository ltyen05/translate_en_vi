ged, or moved. The cursor is named for its I shape.</descrip></descripGrp><ntig><termGrp><term id="63352">I-beam</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2095058">cursor en I</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10912_63353_2095058"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mouse cursor used by many applications, such as word processors, when in text-editing mode. The I-beam cursor indicates sections of the document where text can be inserted, deleted, changed, or moved. The cursor is named for its I shape.</descrip></descripGrp><ntig><termGrp><term id="63353">I-beam pointer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2095058">cursor en I</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10916_338545_1770093"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To store data in such a way that it can be retrieved later by the same security support component, and only by that security support component.</descrip></descripGrp><ntig><termGrp><term id="338545">seal</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1770093">segellar</term><termNote type="geographicalUsage">ESP</termNote><termNote type