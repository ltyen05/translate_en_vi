ommonly interpreted as simply one trillion bytes.</descrip></descripGrp><ntig><termGrp><term id="211565">TB</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1137747">terabyte</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4071_211565_1550725"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A measurement used for high-capacity data storage. One terabyte equals 240, or 1,099,511,627,776, bytes, although it is commonly interpreted as simply one trillion bytes.</descrip></descripGrp><ntig><termGrp><term id="211565">TB</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1550725">TB</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40741_2361902_2847247"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The federated authentication protocol that allows a user who has logged in after authenticating from a central identity provider not to have to login or need to authenticate again from the service provider he or she wants to use.</descrip></descripGrp><ntig><termGrp><term id="2361902">SAML-P</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2847247">SAML</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40741_2361912_2847247"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The federated authentication protocol that allows a user who has logged in after authenticating from a central identity provider not to have to login or need to authenticate again from the service provider he or she wants to use.</descrip></descripGrp><ntig><termGrp><term id="2361912">Security Assertion Markup Language</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2847247">SAML</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40741_2840599_2847247"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The federated authentication protocol that allows a user who has logged in after authenticating from a central identity provider not to have to login or need to authenticate again from the service provider he or she wants to use.</descrip></descripGrp><ntig><termGrp><term id="2840599">SAML</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2847247">SAML</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40745_2362004_2365226"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The area in a Lync meeting where content is presented.</descrip></descripGrp><ntig><termGrp><term id="2362004">content stage</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2365226">zona de contingut</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40746_2362005_2365217"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In a Lync desktop sharing session, the owner of the session can give everyone in the session control, which means that participants can then work together in the same file or desktop and see each other’s changes immediately. Participants can "request," "take," "release," and "give back" control. Only one person can be "in control" at a time.</descrip></descripGrp><ntig><termGrp><term id="2362005">control</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2365217">control</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40748_2362007_2365220"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A named collection of contacts in the Contacts list.</descrip></descripGrp><ntig><termGrp><term id="2362007">group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2365220">grup</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40749_2362008_2365227"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To remove yourself from a conference call that will continue without you.</descrip></descripGrp><ntig><termGrp><term id="2362008">leave call</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2365227">sortir de la trucada</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40751_2362010_2365231"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To rejoin a window back into an original window which it had been popped out from previously.</descrip></descripGrp><ntig><termGrp><term id="2362010">pop in</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2365231">fixar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40752_2362011_2365232"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To separate an area of a UI into a new window.</descrip></descripGrp><ntig><termGrp><term id="2362011">pop out</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2365232">separar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40753_2362012_2365225"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows someone to share documents or applications with others. The user may also choose to give another person control of an application or the user's computer.</descrip></descripGrp><ntig><termGrp><term id="2362012">program sharing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2365225">ús compartit del programa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40755_2362014_2365223"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The team responsible for administering use of a multiuser computer system, communications system, or both. A system administrator performs such duties as assigning user accounts and passwords, establishing security access levels, allocating storage space, and watching for unauthorized access.</descrip></descripGrp><ntig><termGrp><term id="2362014">support team</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2365223">equip de suport tècnic</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40756_2362015_2365222"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to contacts who are currently Offline.</descrip></descripGrp><ntig><termGrp><term id="2362015">unavailable</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2365222">no disponible</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40757_2362016_2365230"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Viewing the presentation asynchronously from what the presenter is presenting (i.e. "Presenter View").</descrip></descripGrp><ntig><termGrp><term id="2362016">view privately</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2365230">visualitzar en privat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40759_2362895_2365903"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The top level container for all the metadata an organization will store. A catalog contains Users and Assets.</descrip></descripGrp><ntig><termGrp><term id="2362895">catalog</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2365903">catàleg</term><termNote type="geographicalUsage">ESP<