termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2063484">administració de dispositius mòbils</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35592_2042112_2046351"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A partially completed diagram that includes shapes and tips to help the user get started in Visio. A user can select from three diagrams at startup.</descrip></descripGrp><ntig><termGrp><term id="2042112">Starter Diagram</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2046351">Diagrama inicial</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35606_2042664_2046343"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that manages the ability to share various components of the Office 365 site (such as Outlook calendars, SharePoint sites, and Lync meetings) with visitors or external users.</descrip></descripGrp><ntig><termGrp><term id="2042664">External sharing</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2046343">Ús compartit extern</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35607_2042666_2046348"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that renders a PDF document as a single or series of pictures in a page.</descrip></descripGrp><ntig><termGrp><term id="2042666">PDF Render</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2046348">Representació de PDF</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35608_2042671_2046349"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables IT administrators to move Personal Folders files (.pst) to a mailbox in Office 365. A .pst file is a data file that stores your messages and other items on your computer.</descrip></descripGrp><ntig><termGrp><term id="2042671">PST import</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2046349">importació de PST</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35609_2106333_2107525"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office 365 subscription for nonprofit organizations that need communication and collaboration tools and the ability to read and do lightweight editing of documents with the Office Online.</descrip></descripGrp><ntig><termGrp><term id="2106333">Office 365 Nonprofit E1</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2107525">Office 365 Nonprofit E1</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3561_168804_1381777"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows a user to share documents or applications with others. The user can also choose to give another person control of an application or the user's computer.</descrip></descripGrp><ntig><termGrp><term id="168804">application sharing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1381777">ús compartit d'aplicacions</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35610_2106334_2107527"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office 365 subscription for nonprofit organizations ​that is the best plan for nonprofit organizations that need full productivity, communication and collaboration tools with the familiar Office suite, including Office Online.</descrip></descripGrp><ntig><termGrp><term id="2106334">Office 365 Nonprofit E3</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2107527">Office 365 Nonprofit E3</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35612_2042970_2063477"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ability to select specific fields for an entity (record type) and specify how they should synchronize between CRM and Exchange, either in both ways or in one direction (from CRM to Exchange or from Exchange to CRM).</descrip></descripGrp><ntig><termGrp><term id="2042970">field-level synchronization</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2063477">sincronització a nivell de camp</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35613_2043345_2063486"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The UI label for the button on the app bar that affixes a tile to your Home screen.</descrip></descripGrp><ntig><termGrp><term id="2043345">Pin to Home</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2063486">Ancora a la pantalla inicial</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35614_2043468_2063480"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An out-of-the-box attribute that can be exported, translated into a specified language, and then imported back into CRM.</descrip></descripGrp><ntig><termGrp><term id="2043468">localizable field</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2063480">camp traduïble</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35616_2043469_2063489"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Status shown for a task that is assigned in Outlook and tracked in CRM, where the task assignment is declined, and the assigner of the task reassigns the task back to himself or herself.</descrip></descripGrp><ntig><termGrp><term id="2043469">Reclaimed</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2063489">Recuperat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35617_2043470_2063475"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In telecommunications, a callback occurs when the originator of a call is immediately called back in a second call as a response.</descrip></descripGrp><ntig><termGrp><term id="2043470">callback</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2063475">resposta de trucada</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote typ