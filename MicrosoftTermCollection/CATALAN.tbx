ws for sending tile updates and notifications to users.</descrip></descripGrp><ntig><termGrp><term id="1635641">WNS</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1953153">WNS</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31641_1635641_1953154"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature of Windows for sending tile updates and notifications to users.</descrip></descripGrp><ntig><termGrp><term id="1635641">WNS</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1953154">Serveis de notificacions de tramesa automàtica del Windows</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31647_1608225_1663895"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The act of checking a visual workflow to ensure that the shapes and connections are valid.</descrip></descripGrp><ntig><termGrp><term id="1608225">shape-level validation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1663895">validació de formes</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</ter