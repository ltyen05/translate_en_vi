rm><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2711_63130_1555422"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The complementary tasks of gathering and distributing data. Input is data that is acquired from a device or entered by the user through a device. Output is data that is sent to a device.</descrip></descripGrp><ntig><termGrp><term id="63130">I/O</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1555422">E/S</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2711_63131_1555422"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The complementary tasks of gathering and distributing data. Input is data that is acquired from a device or entered by the user through a device. Output is data that is sent to a device.</descrip></descripGrp><ntig><termGrp><term id="63131">input/output</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1555422">E/S</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27130_1365513_2344857"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A software component that intermediates requests from client software components and responses from service or server software components that respond to those requests.</descrip></descripGrp><ntig><termGrp><term id="1365513">proxy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2344857">servidor intermediari</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27131_1365515_1382019"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An online action, such as updating a status message, publishing photos, or updating profile info.</descrip></descripGrp><ntig><termGrp><term id="1365515">activity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1382019">activitat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27137_1367505_2344850"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A commercial message that consists of a visual component (text, rich media, etc.) and associated metadata (URLs, placement information, etc.).</descrip></descripGrp><ntig><termGrp><term id="1367505">ad</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2344850">anunci</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2716_145576_2418019"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The quality that defines how much light passes through an object's pixels. If an object is 100 percent opaque, no light passes through it.</descrip></descripGrp><ntig><termGrp><term id="145576">opacity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2418019">opacitat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27161_1367532_2330328"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An operation in a task that progresses an activity towards completion.</descrip></descripGrp><ntig><termGrp><term id="1367532">step</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2330328">pas</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27177_1367710_1382217"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The menu in Hotmail that includes actions a customer may take on the contents of the folder that is currently displayed. Some actions draw context from a selected message. For example, if someone selects a message, they can move all or delete all messages from that sender. If no message is selected, the actions occur at a folder level, such as marking all messages in the folder as read, or deleting all messages in the folder.</descrip></descripGrp><ntig><termGrp><term id="1367710">Sweep</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1382217">Neteja</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27198_1367926_1382085"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A text note provided by a user that is displayed along with his or her presence status.</descrip></descripGrp><ntig><termGrp><term id="1367926">personal note</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1382085">nota personal</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2720_102645_1548082"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The creation of an image containing geometric models, using color and shading to give the image a realistic look. Usually part of a geometric modeling package such as a CAD program, rendering uses mathematics to describe the location of a light source in relation to the object and to calculate the way in which the light would create highlights, shading, and variations in color. The degree of realism can range from opaque, shaded polygons to images approximating photographs in their complexity.</descrip></descripGrp><ntig><termGrp><term id="102645">rendering</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1548082">representació</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27206_1367997_1382117"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An organization or group that is responsible for providing technical support.</descrip></descripGrp><ntig><termGrp><term id="1367997">support team</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1382117">equip de suport tècnic</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27206_1555432_1382117"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An organization or group that is responsible for providing technical support.</descrip></descripGrp><ntig><termGrp><term id="1555432">technical support</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1382117">equip de suport tècnic</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27211_1368002_1382218"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To undertake email cleanup actions in Hotmail via the Sweep menu.</descrip></descripGrp><ntig><termGrp><term id="1368002">sweep</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1382218">netejar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="273_108331_1548237"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A standard Windows control that supports scrolling.</descrip></descripGrp><ntig><termGrp><term id="108331">scroll bar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1548237">barra de desplaçament</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27311_1370396_1382213"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An action considered to have social relevance and that might appear in an activity feed. For example, photo activity and status updates are considered to be socially relevant.</descrip></descripGrp><ntig><termGrp><term id="1370396">social update</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1382213">actualització social</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27311_1375269_1382213"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An action considered to have social relevance and that might appear in an activity feed. For example, photo activity and status updates are considered to be socially relevant.</descrip></descripGrp><ntig><termGrp><term id="1375269">update</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1382213">actualització social</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27327_1370417_2368668"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A rule in an accounting system that controls the valid financial dimension value combinations when the requirements of the financial dimension structure condition are met.</descrip></descripGrp><ntig><termGrp><term id="1370417">account rule</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2368668">regla del compte</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27329_1370420_2368669"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A configuration of the main account financial dimension and other financial dimensions.</descrip></descripGrp><ntig><termGrp><term id="1370420">account structure</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2368669">estructura del compte</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27331_1370422_2368672"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The customary monetary unit of measure that is used to record the monetary value of economic resources in ledger accounts.</descrip></descripGrp><ntig><termGrp><term id="1370422">accounting currency</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2368672">moneda de comptabilitat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27332_1370423_2368675"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A distribution of the financial consequence of an economic transaction to ledger accounts.</descrip></descripGrp><ntig><termGrp><term id="1370423">accounting distribution</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2368675">distribució comptable</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27333_1370424_1374298"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A form that is provided "out of the box" for any entity, or the form that a user sees when they view a record and have options to choose additional forms.</descrip></descripGrp><ntig><termGrp><term id="1370424">default form</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1374298">formulari per defecte</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27335_1370426_2368676"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A real or conceptual economic unit that uses ledger accounts to record and report on its financial and management performance.</descrip></descripGrp><ntig><termGrp><term id="1370426">accounting entity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2368676">entitat comptable</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27346_1370438_2333161"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A fault that occurs when a page sought in the file system cache is not found and must be retrieved from disk.</descrip></descripGrp><ntig><termGrp><term id="1370438">hard fault</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2333161">error greu</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">