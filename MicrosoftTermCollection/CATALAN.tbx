ripGrp><descrip type="definition">The process of granting a person, computer process, or device access to certain information, services or functionality. Authorization is derived from the identity of the person, computer process, or device requesting access, which is verified through authentication.</descrip></descripGrp><ntig><termGrp><term id="325">authorization</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2094754">autorització</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26601_1288500_2684149"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A setting which temporarily suspends the processing of a retention policy and/or managed folder mailbox policy for that mailbox.</descrip></descripGrp><ntig><termGrp><term id="1288500">retention hold</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2684149">suspensió de retenció</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26605_1289182_1770096"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A view for delivering a presentation that displays it as the audience will see it.</descrip></descripGrp><ntig><termGrp><term id="1289182">Slide Show view</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><t