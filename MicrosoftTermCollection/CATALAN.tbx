raphicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20020_693916_761028"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To include contractual terms in an agreement by referring to them.</descrip></descripGrp><ntig><termGrp><term id="693916">incorporate by reference</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761028">incorporar mitjançant referència</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20021_693917_761233"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A wrongful act (not including breach of contract) for which a remedy such as damages may be obtained.</descrip></descripGrp><ntig><termGrp><term id="693917">tort</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761233">responsabilitat extracontractual</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20022_693918_761235"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Information that is not generally known or readily ascertainable to the public, has economic value as a result, and has been subject to reasonable steps under the circumstances to maintain its secrecy.</descrip></descripGrp><ntig><termGrp><term id="693918">trade secret</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761235">secret empresarial</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20023_693978_761237"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The passing of a legal right from one person/entity to another.</descrip></descripGrp><ntig><termGrp><term id="693978">transfer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761237">transmissió</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20024_693979_761238"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To pass a legal right from one person/entity to another.</descrip></descripGrp><ntig><termGrp><term id="693979">transfer</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761238">transmetre</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20025_693981_761239"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The restriction placed on the right to transfer ownership or a license right.</descrip></descripGrp><ntig><termGrp><term id="693981">transfer restriction</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761239">restricció a la transmissió</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20028_693984_761240"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The person to whom ownership or a license right is transferred.</descrip></descripGrp><ntig><termGrp><term id="693984">transferee</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761240">adquirent</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20029_693985_761242"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Agreement on Trade-Related Aspects of Intellectual Property Rights, an annex to the Marrakesh Agreement Establishing the World Trade Organization, signed in Marrakesh, Morocco on 15 April 1994.</descrip></descripGrp><ntig><termGrp><term id="693985">TRIPs agreement</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761242">Acord TRIPS</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20031_693986_761260"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A license to use a software package that replaces an existing version of a product with a newer and/or more powerful or sophisticated version of the same product.</descrip></descripGrp><ntig><termGrp><term id="693986">upgrade license</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761260">llicència d'actualització</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20034_693991_761262"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Usage of a software product.</descrip></descripGrp><ntig><termGrp><term id="693991">use</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761262">ús</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20035_693992_761261"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To make use of a software product.</descrip></descripGrp><ntig><termGrp><term id="693992">use</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761261">utilitzar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20036_693993_760990"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To the advantage of.</descrip></descripGrp><ntig><termGrp><term id="693993">for the benefit of</term><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="760990">en benefici de</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20037_693994_761263"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A right to use a software product.</descrip></descripGrp><ntig><termGrp><term id="693994">use right</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761263">dret d'ús</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20038_693995_761264"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A client access license that allows a unique user to access Microsoft server software from many devices, such as a work computer, a home computer, a laptop, an Internet kiosk, or a personal digital assistant (PDA), without having to acquire a client access license for each device.</descrip></descripGrp><ntig><termGrp><term id="693995">user CAL</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761264">CAL d'usuari</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20039_693998_761268"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Substantiating that terms and conditions of a Microsoft license agreement are being or were adhered to, e.g. checking whether a customer has sufficient licenses or has ordered sufficient licenses to permit all usage of a product.</descrip></descripGrp><ntig><termGrp><term id="693998">verifying compliance</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761268">verificació del compliment</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20040_694004_761272"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To guarantee that something is accurate or truthful.</descrip></descripGrp><ntig><termGrp><term id="694004">warrant</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761272">garantir</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20041_694008_761273"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">When referring to a warranty in a contract, a guarantee provided by a party to a contract e.g. licensor's guarantee that a software product performs as stated in the contract.</descrip></descripGrp><ntig><termGrp><term id="694008">warranty</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761273">garantia</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20042_694010_761277"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Intentional wrongdoing or wrongly failing to do something.</descrip></descripGrp><ntig><termGrp><term id="694010">willful misconduct</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761277">dol</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20043_694013_761278"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An upgrade license for a Microsoft Windows Operating System.</descrip></descripGrp><ntig><termGrp><term id="694013">Windows Desktop Operating System Upgrade</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761278">Actualització del Sistema Operatiu de Sobretaula Windows</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20044_694016_761282"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An agreement to something provided in writing.</descrip></descripGrp><ntig><termGrp><term id="694016">written consent</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761282">consentiment per escrit</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20045_694017_760836"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To connect to the Internet or other network or system.</descrip></descripGrp><ntig><termGrp><term id="694017">access</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="760836">accedir</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20046_694020_760837"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To obtain or make use of differentiated technologies or products.</descrip></descripGrp><ntig><termGrp><term id="694020">access</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="760837">accedir</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20047_694025_760845"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">When referring to a Microsoft licensing agreement, the act of obtaining software licenses.</descrip></descripGrp><ntig><termGrp><term id="694025">acquisition</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="760845">adquisició</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20048_694026_761047"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To issue a bill for items or services that have been purchased.</descrip></descripGrp><ntig><termGrp><term id="694026">invoice</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761047">facturar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20049_694030_761048"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A decision by a court of law that determines the rights and obligations of the parties to an action.</descrip></descripGrp><ntig><termGrp><term id="694030">judgment</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761048">sentència</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20050_694037_761050"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A geographic territory or area of activity over which authority may be exercised.</descrip></descripGrp><ntig><termGrp><term id="694037">jurisdiction</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761050">jurisdicció</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20051_694040_761208"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">When referring to a Microsoft volume licensing agreement, a migration to a higher edition of a Microsoft product, e.g. from a standard edition of a product to an enterprise or professional edition.</descrip></descripGrp><ntig><termGrp><term id="694040">step-up</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761208">migració a l'edició superior</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20052_694044_760835"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The use of differentiated technologies or products.</descrip></descripGrp><ntig><termGrp><term id="694044">access</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="760835">accés</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20053_694053_760955"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An operating system that is a component of a complete device and is expected to function without human intervention to perform one or a few specific tasks.</descrip></descripGrp><ntig><termGrp><term id="694053">embedded operating system</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="760955">sistema operatiu incrustat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20054_694299_1382045"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The part of a telephone that includes a speaker and a voice transmitter and that you hold with your hand up to your ear.</descrip></descripGrp><ntig><termGrp><term id="694299">handset</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1382045">telèfon</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine<