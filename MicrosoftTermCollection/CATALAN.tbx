ich each open document occupies its own window in the UI, though only a single instance of the program application is running.</descrip></descripGrp><ntig><termGrp><term id="1087135">SDI</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1098096">SDI</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23532_1087135_1098386"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A specification according to which each open document occupies its own window in the UI, though only a single instance of the program application is running.</descrip></descripGrp><ntig><termGrp><term id="1087135">SDI</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1098386">interfície SDI</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23533_1087136_1098368"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A view that allows users to read a document or a report, but not to edit it.</descrip></descripGrp><ntig><termGrp><term id="1087136">Reading View</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1098368">Visualització de lectura</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="gram