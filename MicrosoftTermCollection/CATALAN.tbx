termGrp></ntig></langSet></termEntry><termEntry id="51586_2902141_2903137"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A style in Word that shows text with a dotted underline.</descrip></descripGrp><ntig><termGrp><term id="2902141">Smart Hyperlink</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2903137">Hiperenllaç intel·ligent</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51587_2902142_2903138"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A style in Word that shows text as blue with a blue underline.</descrip></descripGrp><ntig><termGrp><term id="2902142">SmartLink</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2903138">Enllaç intel·ligent</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51589_2902145_2903133"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A conceptual container that allows a company administrator to restrict the users and groups that an admin can manage to only those in a specific department, region, or any segment that their organization defines.</descrip></descripGrp><ntig><termGrp><term id="2902145">administrative unit</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2903133"