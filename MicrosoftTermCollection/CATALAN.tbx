ine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4635_318145_1137782"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Any combination of keys that must be pressed sequentially.</descrip></descripGrp><ntig><termGrp><term id="318145">access key</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1137782">tecles d'accés</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4635_72848_1137780"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Any combination of keys that must be pressed sequentially.</descrip></descripGrp><ntig><termGrp><term id="72848">key sequence</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1137780">seqüència de tecles</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4635_72848_1137782"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Any combination of keys that must be pressed sequentially.</descrip></descripGrp><ntig><termGrp><term id="72848">key sequence</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1137782">tecles d'accés</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termN