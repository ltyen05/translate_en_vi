="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32212_1638657_1645161"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The boundary of a physical or rendered object, such as a display screen or window.</descrip></descripGrp><ntig><termGrp><term id="1638657">edge</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1645161">vora</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32213_1638658_1645182"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To transfer data such as files to a device or an app.</descrip></descripGrp><ntig><termGrp><term id="1638658">send</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1645182">enviar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32219_1641030_1662727"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tool that is used to apply formatting to borders in a table.</descrip></descripGrp><ntig><termGrp><term id="1641030">Border Painter</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1662727">Copia la vora</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote t