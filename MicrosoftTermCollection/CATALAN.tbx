e><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22342_1043701_1546336"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A node that makes cached data available to clients needing to retrieve the data.</descrip></descripGrp><ntig><termGrp><term id="1043701">peer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1546336">node del mateix nivell</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22360_1043932_1359813"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To apply a skin to an existing user interface.</descrip></descripGrp><ntig><termGrp><term id="1043932">skin</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1359813">aparença</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22364_1043935_2094925"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A streaming technology that quickly installs Office over the Internet, internal networks, local file systems, or from offline media.</descrip></descripGrp><ntig><termGrp><term id="1043935">Click-to-Run</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2094925">Fer clic i executar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22364_1146100_2094925"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A streaming technology that quickly installs Office over the Internet, internal networks, local file systems, or from offline media.</descrip></descripGrp><ntig><termGrp><term id="1146100">Click-to-Run technology</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2094925">Fer clic i executar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22373_1043951_1098288"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of adding a digital signature to source code and applications published on the Internet. Code signing is intended to provide a level of security and trust to Internet software distribution.</descrip></descripGrp><ntig><termGrp><term id="1043951">code signing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1098288">Firma de codi</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22377_1043959_2707756"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of caching the pages of a Web site on geographically dispersed servers to enable faster delivery of Web pages. When a page is requested at a URL that is content-delivery enabled, the content-delivery network routes the user's request to a cache server closer to the user. Content delivery frequently is used for high-traffic Web sites or for specific high-traffic events.</descrip></descripGrp><ntig><termGrp><term id="1043959">content delivery</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2707756">emmagatzematge de contingut a la memòria cau</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22377_1177098_2707756"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of caching the pages of a Web site on geographically dispersed servers to enable faster delivery of Web pages. When a page is requested at a URL that is content-delivery enabled, the content-delivery network routes the user's request to a cache server closer to the user. Content delivery frequently is used for high-traffic Web sites or for specific high-traffic events.</descrip></descripGrp><ntig><termGrp><term id="1177098">content caching</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2707756">emmagatzematge de contingut a la memòria cau</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22377_1177099_2707756"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of caching the pages of a Web site on geographically dispersed servers to enable faster delivery of Web pages. When a page is requested at a URL that is content-delivery enabled, the content-delivery network routes the user's request to a cache server closer to the user. Content delivery frequently is used for high-traffic Web sites or for specific high-traffic events.</descrip></descripGrp><ntig><termGrp><term id="1177099">content distribution</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2707756">emmagatzematge de contingut a la memòria cau</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2238_184055_364157"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A diagram that shows the relationship of items in a list. It is primarily used when the items are sequential in nature.</descrip></descripGrp><ntig><termGrp><term id="184055">process diagram</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="364157">diagrama de processos</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22388_1044098_1356165"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To apply a marker to content or items (like photos or text) to identify certain types of information.</descrip></descripGrp><ntig><termGrp><term id="1044098">tag</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1356165">etiquetar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22390_1044253_2145210"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A customizable dictionary for each user that is empty by default. Users can add typed or handwritten words to and remove them from the user dictionary.</descrip></descripGrp><ntig><termGrp><term id="1044253">user dictionary</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2145210">diccionari de l'usuari</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22419_1044455_1963193"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An authoritative source for an attribute value that can flow its value to other destination directories and systems.</descrip></descripGrp><ntig><termGrp><term id="1044455">attribute flow</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1963193">flux d'atribut</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22433_1044556_1766944"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A COM-based multimedia platform and infrastructure for digital media in Microsoft Windows. It focuses on content protection, audio and video quality, and interoperability for digital rights management (DRM).</descrip></descripGrp><ntig><termGrp><term id="1044556">Microsoft Media Foundation</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1766944">Media Foundation</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22433_1044556_1766945"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A COM-based multimedia platform and infrastructure for digital media in Microsoft Windows. It focuses on content protection, audio and video quality, and interoperability for digital rights management (DRM).</descrip></descripGrp><ntig><termGrp><term id="1044556">Microsoft Media Foundation</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1766945">Microsoft Media Foundation</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22433_1044558_1766944"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A COM-based multimedia platform and infrastructure for digital media in Microsoft Windows. It focuses o