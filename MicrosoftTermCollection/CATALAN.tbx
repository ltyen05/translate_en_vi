</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42581_2412468_2413870"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A visual effect that occurs when a photo is taken of a fast-moving object.</descrip></descripGrp><ntig><termGrp><term id="2412468">motion blur</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2413870">moviment de la imatge</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42582_2412469_2413872"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that initiates a 2, 5, or 10-second delay for taking a picture.</descrip></descripGrp><ntig><termGrp><term id="2412469">photo timer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2413872">temporitzador fotogràfic</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42582_2905571_2413872"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that initiates a 2, 5, or 10-second delay for taking a picture.</descrip></descripGrp><ntig><termGrp><term id="2905571">timer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2413872">temporitzador fotogràfic</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42583_2412484_2420598"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The online version of Project that is targeted at individual team members.</descrip></descripGrp><ntig><termGrp><term id="2412484">Project Online Essentials</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2420598">Project Online Essentials</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42607_2413500_2417547"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office button that launches a task pane where users can research papers by typing queries to get information such as sources, citations, quotes, and images.</descrip></descripGrp><ntig><termGrp><term id="2413500">Researcher</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2417547">Cercador</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42608_2413506_2417546"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office feature that allows users type queries and find information, sources, citations, quotes, and images, without leaving the application that they are using.</descrip></descripGrp><ntig><termGrp><term id="2413506">Researcher</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2417546">Cercador</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42614_2414369_2415431"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">T​o quickly return to an app, website, or document you were using earlier.</descrip></descripGrp><ntig><termGrp><term id="2414369">jump back</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2415431">saltar cap enrere</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42615_2414370_2415433"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of documents, apps, and websites that, in one click, allows you to pick up your work exactly where you left it earlier, on any device connected with the same Microsoft account.​​</descrip></descripGrp><ntig><termGrp><term id="2414370">jump group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2415433">grup de salts</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42616_2414371_2415429"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To quickly jump to a document or application on another device that is connected to the same Microsoft account.</descrip></descripGrp><ntig><termGrp><term id="2414371">jump</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2415429">saltar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42617_2414373_2415434"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that lets customers reset their network settings back to the Windows defaults.</descrip></descripGrp><ntig><termGrp><term id="2414373">network reset</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2415434">restabliment de la xarxa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42620_2414431_2479051"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To express approval for a certain item.</descrip></descripGrp><ntig><termGrp><term id="2414431">like</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig