32"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A voltage regulator that uses an alternating electrical current to provide a continuously variable output voltage.</descrip></descripGrp><ntig><termGrp><term id="2515738">induction voltage regulator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2516232">regulador de tensió d'inducció</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44683_2515739_2516231"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A voltage regulator that uses an alternating electrical current to provide a continuously variable output voltage.</descrip></descripGrp><ntig><termGrp><term id="2515739">induction regulator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2516231">regulador d'inducció</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44683_2515739_2516232"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A voltage regulator that uses an alternating electrical current to provide a continuously variable output voltage.</descrip></descripGrp><ntig><termGrp><term id="2515739">induction regulator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2516232">regulador de tensió 