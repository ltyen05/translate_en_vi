418"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Microsoft technology designed to help enterprise customers control and protect critical digital information by offering easy-to-use, flexible, and persistent policy expression and enforcement.</descrip></descripGrp><ntig><termGrp><term id="323480">Active Directory Rights Management Services</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2365418">AD RMS</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13586_323482_2365417"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Microsoft technology designed to help enterprise customers control and protect critical digital information by offering easy-to-use, flexible, and persistent policy expression and enforcement.</descrip></descripGrp><ntig><termGrp><term id="323482">AD RMS</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2365417">Active Directory Rights Management Services</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13586_323482_2365418"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Microsoft technology designed to help enterprise customers control and protect critical digital information by offering easy-to-use, flexible, and persistent policy expression and enforcement.</descrip></descripGrp><ntig><termGrp><term id="323482">AD RMS</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2365418">AD RMS</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13587_25017_2485761"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To combine products for sale as a lot. Frequently, operating system software and some widely used applications are bundled with a computer system for sale.</descrip></descripGrp><ntig><termGrp><term id="25017">bundle</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2485761">agrupar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13594_503136_514648"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The presence status that indicates a user hasn't used his/her mouse, keyboard, computer, mobile phone, or communications device for a specified time.</descrip></descripGrp><ntig><termGrp><term id="503136">Inactive</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="514648">Inactiu</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="136_557698_1281825"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A system job that detects duplicate records for one entity.</descrip></descripGrp><ntig><termGrp><term id="557698">Bulk Duplicate Detection</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1281825">Detecció massiva de duplicats</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1360_358369_362926"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An encoding mechanism that converts binary data into printable ASCII characters so that the data can be included in the message body without violating SMTP conventions.</descrip></descripGrp><ntig><termGrp><term id="358369">UUENCODE</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="362926">UUENCODE</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13600_237376_1136227"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The act of exporting objects such as resources, templates, and galleries from a source system and importing them to a destination system. A common application is moving data from a development server to a production server.</descrip></descripGrp><ntig><termGrp><term id="237376">content deployment</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1136227">distribució del contingut</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13605_347939_2094790"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file or set of files that defines the data structure, appearance, and behavior of a form.</descrip></descripGrp><ntig><termGrp><term id="347939">form template</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2094790">plantilla de formulari</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13611_187814_2717936"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To restructure code to make it easier to understand and to maintain, while preserving its functionality.</descrip></descripGrp><ntig><termGrp><term id="187814">refactor</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2717936">refactoritzar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13614_97245_1821233"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Electromagnetic waves longer than about 0.3 mm (frequencies lower than about 1 THz). Radio is used to transmit a wide variety of signals, using various frequency ranges and types of modulation, such as AM and FM broadcasts, microwave relays, and television broadcasts.</descrip></descripGrp><ntig><termGrp><term id="97245">radio</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1821233">ràdio</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1362_360135_2094816"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A view that summarizes and analyzes data in a datasheet or form. You can use different levels of detail or organize data by dragging the fields and items, or by showing and hiding items in the drop-down lists for the fields.</descrip></descripGrp><ntig><termGrp><term id="360135">PivotTable view</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2094816">visualització de taula dinàmica</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1363_149014_2094833"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A report contained within another report.</descrip></descripGrp><ntig><termGrp><term id="149014">subreport</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2094833">subinforme</term><termNo