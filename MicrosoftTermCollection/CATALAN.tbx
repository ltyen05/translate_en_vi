e.</descrip></descripGrp><ntig><termGrp><term id="1496237">Microsoft Windows SharePoint Services</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1963575">Microsoft Windows SharePoint Services</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1254_1496237_1970880"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A family of Microsoft Web-based team collaboration environments that provide the ability to create and access virtual workspaces for managing documents, discussions, lists, surveys and other important contextual information such as team member status and presence.</descrip></descripGrp><ntig><termGrp><term id="1496237">Microsoft Windows SharePoint Services</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1970880">Windows SharePoint Services</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1254_415809_1963575"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A family of Microsoft Web-based team collaboration environments that provide the ability to create and access virtual workspaces for managing documents, discussions, lists, surveys and other important contextual information such as team member status and presence.</descrip></descripGrp><ntig><termGrp><term id="415809">Windows SharePoint Services</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1963575">Microsoft Windows SharePoint Services</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1254_415809_1970880"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A family of Microsoft Web-based team collaboration environments that provide the ability to create and access virtual workspaces for managing documents, discussions, lists, surveys and other important contextual information such as team member status and presence.</descrip></descripGrp><ntig><termGrp><term id="415809">Windows SharePoint Services</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1970880">Windows SharePoint Services</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1254_415810_1963575"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A family of Microsoft Web-based team collaboration environments that provide the ability to create and access virtual workspaces for managing documents, discussions, lists, surveys and other important contextual information such as team member status and presence.</descrip></descripGrp><ntig><termGrp><term id="415810">SharePoint Services</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1963575">Microsoft Windows SharePoint Services</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1254_415810_1970880"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A family of Microsoft Web-based team collaboration environments that provide the ability to create and access virtual workspaces for managing documents, discussions, lists, surveys and other important contextual information such as team member status and presence.</descrip></descripGrp><ntig><termGrp><term id="415810">SharePoint Services</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1970880">Windows SharePoint Services</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1254_639899_1963575"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A family of Microsoft Web-based team collaboration environments that provide the ability to create and access virtual workspaces for managing documents, discussions, lists, surveys and other important contextual information such as team member status and presence.</descrip></descripGrp><ntig><termGrp><term id="639899">WSS</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1963575">Microsoft Windows SharePoint Services</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1254_639899_1970880"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A family of Microsoft Web-based team collaboration environments that provide the ability to create and access virtual workspaces for managing documents, discussions, lists, surveys and other important contextual information such as team member status and presence.</descrip></descripGrp><ntig><termGrp><term id="639899">WSS</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1970880">Windows SharePoint Services</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12544_76022_1143808"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A security group that can be granted rights and permissions only to resources on the computer on which the group is created. Local groups can have any user accounts that are local to the computer as members, as well as users, groups, and computers from a domain to which the computer belongs.</descrip></descripGrp><ntig><termGrp><term id="76022">local group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1143808">grup local</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12551_237304_327302"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A formula syntax that allows the user to refer to list and pivot data in a friendlier way.</descrip></descripGrp><ntig><termGrp><term id="237304">Structured References</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="327302">Referències estructurades</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12557_269335_1143809"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A problem that prevents sync from completing. Sync errors are typically caused by problems with the device, network folder, or other computer you are trying to sync with.</descrip></descripGrp><ntig><termGrp><term id="269335">sync error</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1143809">error de sincronització</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12560_257510_2768110"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An identifier used by two APPC logical units (LUs) to validate security when a session is activated. The security key performs a function similar to that of a password, but at the LU-LU session level rather than at the TP-conversation level.</descrip></descripGrp><ntig><termGrp><term id="257510">security key</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2768110">clau de seguretat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12565_475205_1276390"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In the Microsoft Dynamics CRM user interface, a field in which users type the amount of money designated for a campaign activity.</descrip></descripGrp><ntig><termGrp><term id="475205">Budget Allocated</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1276390">Pressupost assignat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12571_306405_1143857"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A filter effect in Windows Movie Maker.</descrip></descripGrp><ntig><termGrp><term id="306405">Sepia Tone</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1143857">to sèpia</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12578_58758_1143858"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A button on the address bar that enables the user to navigate to the specified location (such as a folder path or web address).</descrip></descripGrp><ntig><termGrp><term id="58758">Go</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1143858">Ves-hi</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12590_15839_1276344"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process whose execution can proceed independently or in the background. Other processes may be started before the asynchronous process has finished.</descrip></descripGrp><ntig><termGrp><term id="15839">asynchronous operation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1276344">operació asíncrona</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12592_77991_1545842"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A person whose work or profession is management.</descrip></descripGrp><ntig><termGrp><term id="77991">manager</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1545842">administrador</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12596_1146761_2094948"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A single unit of data.</descrip></descripGrp><ntig><termGrp><term id="1146761">data element</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2094948">element de dades</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12596_140073_2094948"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A single unit of data.</descrip></descripGrp><ntig><termGrp><term id="140073">data item</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2094948">element de dades</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12597_235370_2451999"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A structured set of activities designed to yield a specified result or output.</descrip></descripGrp><ntig><termGrp><term id="235370">process</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2451999">procés</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12600_183996_364150"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A diagram that shows the hierarchical relationships among objects/nodes (for example, an organization chart).</descrip></descripGrp><ntig><termGrp><term id="183996">hierarchy diagram</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="364150">diagrama de jerarquies</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12607_170582_1143859"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The program that installs or upgrades the Windows operating system.</descrip></descripGrp><ntig><termGrp><term id="170582">Windows Setup</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1143859">Instal·lació del Windows</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12614_397146_411026"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The record of an Edge Transport server that has been subscribed to an Exchange organization and to which the Microsoft Exchange EdgeSync service propagates recipient and configuration data. The Microsoft Exchange EdgeSync service relies on Edge Subscriptions. Also, Edge Subscription is the process that is required to establish an Edge Subscription for a given Edge Transport server.</descrip></descripGrp><ntig><termGrp><term id="397146">Edge Subscription</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="411026">Subscripció Edge</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12625_137177_2094898"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The system administrator's group account that retains full permissions on all databases used by a workgroup. The Setup program automatically adds the default Admin user account to the Admins group.</descrip></descripGrp><ntig><termGrp><term id="137177">Admins group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2094898">grup Administradors</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12634_298003_2145200"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A menu item that provides options for restarting or turning off your computer or device, or for activating Stand By or Hibernate modes.</descrip></descripGrp><ntig><termGrp><term id="298003">Shut Down</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2145200">Apagar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12644_36190_2094930"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of gathering and packing the currently allocated regions of memory or auxiliary storage into as small a space as possible, so as to create as much continuous free space as possible.</descrip></descripGrp><ntig><termGrp><term id="36190">compaction</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2094930">compactació</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12676_252120_1550689"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of formatting characteristics that you can apply to text, tables, and lists in your document to quickly change their appearance.</descrip></descripGrp><ntig><termGrp><term id="252120">style</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1550689">estil</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12678_415521_1098380"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A name that uniquely identifies a server computer on a network.</descrip></descripGrp><ntig><termGrp><term id="415521">server name</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1098380">nom del servidor</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12695_253689_2094939"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An 8-byte, fixed-point data type that is useful for calculations involving money or for fixed-point calculations in which accuracy is extremely important. The Currency data type is used to store numbers with up to 15 digits to the left of the decimal point and 4 digits to the right. The type-declaration character in Microsoft© Visual Basic© is an at sign (@). Currency can range from -922,337,203,685,477.5808 to 922,337,203,685,477.5807.</descrip></descripGrp><ntig><termGrp><term id="253689">Currency</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2094939">Moneda</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12695_253689_2095096"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An 8-byte, fixed-point data type that is useful for calculations involving money or for fixed-point calculations in which accuracy is extremely important. The Currency data type is used to store numbers with up to 15 digits to the left of the decimal point and 4 digits to the right. The type-declaration character in Microsoft© Visual Basic© is an at sign (@). Currency can range from -922,337,203,685,477.5808 to 922,337,203,685,477.5807.</descrip></descripGrp><ntig><termGrp><term id="253689">Currency</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2095096">money</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12695_374694_2094939"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An 8-byte, fixed-point data type that is useful for calculations involving money or for fixed-point calculations in which accuracy is extremely important. The Currency data type is used to store numbers with up to 15 digits to the left of the decimal point and 4 digits to the right. The type-declaration character in Microsoft© Visual Basic© is an at sign (@). Currency can range from -922,337,203,685,477.5808 to 922,337,203,685,477.5807.</descrip></descripGrp><ntig><termGrp><term id="374694">money</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2094939">Moneda</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12695_374694_2095096"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An 8-byte, fixed-point data type that is useful for calculations involving money or for fixed-point calculations in which accuracy is extremely important. The Currency data type is used to store numbers with up to 15 digits to the left of the decimal point and 4 digits to the right. The type-declaration character in Microsoft© Visual Basic© is an at sign (@). Currency can range from -922,337,203,685,477.5808 to 922,337,203,685,477.5807.</descrip></descripGrp><ntig><termGrp><term id="374694">money</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2095096">money</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12696_41116_2094766"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A query that calculates a sum, average, count, or other type of total on records, and then groups the result by two types of information: one down the left side of the datasheet and the other across the top.</descrip></descripGrp><ntig><termGrp><term id="41116">crosstab query</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2094766">consulta de taula de referències creuades</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1271_397184_411295"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The information contained in an email message that is required to send and deliver a message between messaging servers by using SMTP protocol commands. The message envelope contains the sender email address and the recipient email address information. Recipients never see the message envelope, because it is not part of the message content, and it is discarded when the message reaches its destination. The X.400 messaging standard equivalent to the message envelope is called the "P1 header." The message envelope is often referred to as the "P1 header."</descrip></descripGrp><ntig><termGrp><term id="397184">message envelope</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="411295">sobre d'un missatge</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1271_397184_411436"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The information contained in an email message that is required to send and deliver a message between messaging servers by using SMTP protocol commands. The message envelope contains the sender email address and the recipient email address information. Recipients never see the message envelope, because it is not part of the message content, and it is discarded when the message reaches its destination. The X.400 messaging standard equivalent to the message envelope is called the "P1 header." The message envelope is often referred to as the "P1 header."</descrip></descripGrp><ntig><termGrp><term id="397184">message envelope</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="411436">capçalera P1</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1271_397195_411295"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The information contained in an email message that is required to send and deliver a message between messaging servers by using SMTP protocol commands. The message envelope contains the sender email address and the recipient email address information. Recipients never see the message envelope, because it is not part of the message content, and it is discarded when the message reaches its destination. The X.400 messaging standard equivalent to the message envelope is called the "P1 header." The message envelope is often referred to as the "P1 header."</descrip></descripGrp><ntig><termGrp><term id="397195">P1 header</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="411295">sobre d'un missatge</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1271_397195_411436"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The information contained in an email message that is required to send and deliver a message between messaging servers by using SMTP protocol commands. The message envelope contains the sender email address and the recipient email address information. Recipients never see the message envelope, because it is not part of the message content, and it is discarded when the message reaches its destination. The X.400 messaging standard equivalent to the message envelope is called the "P1 header." The message envelope is often referred to as the "P1 header."</descrip></descripGrp><ntig><termGrp><term id="397195">P1 header</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="411436">capçalera P1</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12711_2464298_2469930"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A scaled-down version of a product where a user can try out different features before buying it.</descrip></descripGrp><ntig><termGrp><term id="2464298">test drive</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2469930">versió de prova</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12716_2328432_2621751"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The type of enterprise in which businesses or organizations are engaged.</descrip></descripGrp><ntig><termGrp><term id="2328432">line of business</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2621751">línia de negoci</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12724_32944_1963224"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The time to which a clock is set.</descrip></descripGrp><ntig><termGrp><term id="32944">clock setting</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1963224">configuració del rellotge</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12755_1177216_1547580"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A form of storage characterized by high capacity (roughly 650 MB) and the use of laser optics rather than magnetic means for reading data. Optical disk storage commonly used for audio, video, and computer data. DVDs range in capacity from 4.7 GB to 17 GB, and can store significantly more than a CD-ROM.</descrip></descripGrp><ntig><termGrp><term id="1177216">digital versatile disc</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1547580">DVD</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12755_45847_1547580"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A form of storage characterized by high capacity (roughly 650 MB) and the use of laser optics rather than magnetic means for reading data. Optical disk storage commonly used for audio, video, and computer data. DVDs range in capacity from 4.7 GB to 17 GB, and can store significantly more than a CD-ROM.</descrip></descripGrp><ntig><termGrp><term id="45847">digital video disk</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1547580">DVD</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12755_45848_1547580"><langSet xml:lang="en-US"><desc