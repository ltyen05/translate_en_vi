></termGrp></ntig></langSet></termEntry><termEntry id="6048_19162_1144380"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A duplicate of a program, a disk, or data, made either for archiving purposes or for safeguarding files.</descrip></descripGrp><ntig><termGrp><term id="19162">backup copy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1144380">fitxer de còpia de seguretat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6048_19162_722420"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A duplicate of a program, a disk, or data, made either for archiving purposes or for safeguarding files.</descrip></descripGrp><ntig><termGrp><term id="19162">backup copy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="722420">còpia de seguretat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6048_317873_1144380"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A duplicate of a program, a disk, or data, made either for archiving purposes or for safeguarding files.</descrip></descripGrp><ntig><termGrp><term id="317873">backup file</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1144380">fitxer de còpia de seguretat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6048_317873_722420"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A duplicate of a program, a disk, or data, made either for archiving purposes or for safeguarding files.</descrip></descripGrp><ntig><termGrp><term id="317873">backup file</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="722420">còpia de seguretat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6048_557844_1144380"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A duplicate of a program, a disk, or data, made either for archiving purposes or for safeguarding files.</descrip></descripGrp><ntig><termGrp><term id="557844">dump</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1144380">fitxer de còpia de seguretat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6048_557844_722420"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A duplicate of a program, a disk, or data, made either for archiving purposes or for safeguarding files.</descrip></descripGrp><ntig><termGrp><term id="557844">dump</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="722420">còpia de seguretat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6052_139701_2094940"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The record in a recordset that you can modify or retrieve data from. There is only one current record in a recordset, but a recordset may have no current record, for example, after a record has been deleted from a dynaset-type recordset.</descrip></descripGrp><ntig><termGrp><term id="139701">current record</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2094940">registre actual</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6054_73196_2236875"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A system for managing shared corporate knowledge.</descrip></descripGrp><ntig><termGrp><term id="73196">knowledge management</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2236875">administració del coneixement</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6056_117305_2392099"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A 32-bit value that enables the recipient of Internet Protocol version 4 (IPv4) packets to distinguish the network ID and host ID portions of the IPv4 address. Typically, subnet masks use the format 255.x.x.x. IPv6 uses network prefix notations rather than subnet masks.</descrip></descripGrp><ntig><termGrp><term id="117305">subnet mask</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2392099">màscara de subxarxa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6059_182676_1276047"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A compilation of the specific prices that can be charged for each unit in the unit group of a product.</descrip></descripGrp><ntig><termGrp><term id="182676">price list</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1276047">llista de preus</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="606_134615_1550786"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To transfer information either to a storage device, such as a disk, or to an output device, such as the monitor or a printer. Writing is the means by which a computer provides the results of processing. A computer can also be said to write to the screen when it displays information on the monitor.</descrip></descripGrp><ntig><termGrp><term id="134615">write</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1550786">escriure</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6064_140594_1547521"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A cell that contains a formula that refers to another cell. For example, if cell D10 contains the formula =B5, cell D10 is a dependent of cell B5.</descrip></descripGrp><ntig><termGrp><term id="140594">dependent</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1547521">dependent</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6077_314127_1097662"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Information about a client computer that Network Access Protection (NAP) uses to allow or deny access to a network and which is encapsulated in a statement of health (SoH), which is issued by a system health agent (SHA) on the client computer.</descrip></descripGrp><ntig><termGrp><term id="314127">health</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1097662">salut</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="608_1355238_1606352"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tool or software program designed to detect and respond to malicious software, such as viruses and worms. Responses may include blocking user access to infected files, cleaning infected files or systems, or informing the user that an infected program was detected.</descrip></descripGrp><ntig><termGrp><term id="1355238">anti-malware software</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1606352">programa antimalware</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="608_1355238_1606353"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tool or software program designed to detect and respond to malicious software, such as viruses and worms. Responses may include blocking user access to infected files, cleaning infected files or systems, or informing the user that an infected program was detected.</descrip></descripGrp><ntig><termGrp><term id="1355238">anti-malware software</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1606353">programari antimalware</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="608_1355238_1963181"><langSet xml:lang="en-US"><descrip