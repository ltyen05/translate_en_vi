 knowledge.</descrip></descripGrp><ntig><termGrp><term id="397999">NDA</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1766975">acord de confidencialitat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1205_397999_2686616"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A contract that restricts disclosure of confidential information or proprietary knowledge.</descrip></descripGrp><ntig><termGrp><term id="397999">NDA</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2686616">acord de no revelació</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1205_85315_1766975"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A contract that restricts disclosure of confidential information or proprietary knowledge.</descrip></descripGrp><ntig><termGrp><term id="85315">non-disclosure agreement</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1766975">acord de confidencialitat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1205_85315_2686616"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A contract that restricts disclosure of confidential information or proprietary knowledge.</descrip></descripGrp><ntig><termGrp><term id="85315">non-disclosure agreement</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2686616">acord de no revelació</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12063_38186_2913450"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In hardware, a coupler used to join cables or to join a cable to a device (for example, an RS-232-C connector used to join a modem cable to a computer). Most connector types are available in one of two genders--male or female. A male connector is characterized by one or more exposed pins; a female connector is characterized by one or more receptacles--sockets or jacks-- designed to accept the pins on the male connector.</descrip></descripGrp><ntig><termGrp><term id="38186">connector</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2913450">connector</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12068_27187_1143728"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A marketing program designed to accomplish a specific result, such as introducing a new product or increasing market share.</descrip></descripGrp><ntig><termGrp><term id="27187">campaign</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1143728">campanya</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12068_27187_1143731"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A marketing program designed to accomplish a specific result, such as introducing a new product or increasing market share.</descrip></descripGrp><ntig><termGrp><term id="27187">campaign</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1143731">campanya de màrqueting</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12068_335551_1143728"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A marketing program designed to accomplish a specific result, such as introducing a new product or increasing market share.</descrip></descripGrp><ntig><termGrp><term id="335551">marketing campaign</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1143728">campanya</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12068_335551_1143731"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A marketing program designed to accomplish a specific result, such as introducing a new product or increasing market share.</descrip></descripGrp><ntig><termGrp><term id="335551">marketing campaign</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1143731">campanya de màrqueting</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12069_150202_411457"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The pairing of two or more actions that are performed together as a single action; the action succeeds or fails as a whole.</descrip></descripGrp><ntig><termGrp><term id="150202">transaction</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="411457">transacció</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12094_1049764_2739447"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of servers that are in one location and that are networked together for the purpose of sharing workload.</descrip></descripGrp><ntig><termGrp><term id="1049764">remote desktop server farm</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2739447">clúster de servidors</term><termNote type="ge