rs.</descrip></descripGrp><ntig><termGrp><term id="1162510">tenant</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2236885">inquilí</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24793_1162565_1230157"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An option that makes it possible for the user to define a quotation by delimiting the left and right margins of a text, the same way HTML "blockquote" tags delimit a long quotation.</descrip></descripGrp><ntig><termGrp><term id="1162565">Block Quote</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1230157">cita en bloc</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24806_1162606_1359618"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">One or more characters that identify the start or end of a boundary.</descrip></descripGrp><ntig><termGrp><term id="1162606">boundary delimiter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1359618">delimitador de límits</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></te