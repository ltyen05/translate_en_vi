Number">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44343_2490012_2514356"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A fantasy team player's scores, games played, and other data.</descrip></descripGrp><ntig><termGrp><term id="2490012">player stats</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2514356">estadístiques del jugador</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44343_3145464_2514356"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A fantasy team player's scores, games played, and other data.</descrip></descripGrp><ntig><termGrp><term id="3145464">player statistics</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2514356">estadístiques del jugador</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44344_2490015_2514357"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An award granted based on a fantasy sales team member's position on the leaderboard for a specified KPI.</descrip></descripGrp><ntig><termGrp><term id="2490015">weekly award</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2514357">guardó setmanal</term><termNote type="geographicalUsage">ESP</termNo