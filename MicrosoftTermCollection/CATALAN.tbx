alNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2453134">Email_thread</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43274_2450817_2453376"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Advanced eDiscovery metadata type that identifies if a file is an inclusive file, an inclusive minus, or an inclusive copy.</descrip></descripGrp><ntig><termGrp><term id="2450817">Inclusive_type</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2453376">Inclusive_type</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43275_2450818_2452005"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of attributes for a population that includes the number of files and estimated number of relevant files as calculated by Advanced eDiscovery during processing.</descrip></descripGrp><ntig><termGrp><term id="2450818">population parameters</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2452005">paràmetres de població</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43276_2450819_2453137"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A unique identification number that represents a single Advanced eDiscovery import session.</descrip></descripGrp><ntig><termGrp><term id="2450819">import batch ID</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2453137">identificador de lot d'importació</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43277_2450820_2451980"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The offering that allows customers to upgrade service, adding additional functionality for a price.</descrip></descripGrp><ntig><termGrp><term id="2450820">Premium</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2451980">Premium</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43278_2450822_2453132"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Outlook feature that allows users to create cloud attachments either as a link or as a traditional attachment, and that allows users to set permissions for that attachment when it is sent.</descrip></descripGrp><ntig><termGrp><term id="2450822">Modern Attachments</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2453132">Fitxers adjunts moderns</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43279_2451009_2457053"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app built for Dynamics 365 to support customer service tasks.</descrip></descripGrp><ntig><termGrp><term id="2451009">Dynamics 365 Customer Service</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2457053">Dynamics 365 Customer Service</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43280_2451010_2457057"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The enterprise level business management solution that has functionality to support Retail, Distribution, Manufacturing, Public Sector and Service industries. It includes business operations ranging from financials, procurement, human resources, and more, all running in an Azure cloud.</descrip></descripGrp><ntig><termGrp><term id="2451010">Dynamics 365 for Operations</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2457057">Dynamics 365 for Operations</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id=