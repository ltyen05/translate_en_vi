nctionality, such as accessing data over the internet.</descrip></descripGrp><ntig><termGrp><term id="2485701">#BLOCKED!</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2487106">#BLOQUEJAT!</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44245_2485904_2488086"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A website that customers can go to for help with Microsoft products.</descrip></descripGrp><ntig><termGrp><term id="2485904">Microsoft Support</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2488086">Servei tècnic de Microsoft</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44250_2486129_2496822"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In mixed reality, an app view in which the app takes over the full display and becomes the only app you see.</descrip></descripGrp><ntig><termGrp><term id="2486129">immersive view</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2496822">visualització immersiva</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Sin