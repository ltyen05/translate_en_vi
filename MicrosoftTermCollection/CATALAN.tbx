><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3007207">Xarxa segura del Microsoft Edge</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52937_3007291_3007656"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A keyboard layout for Japanese characters that places keys in a 3x4 grid.</descrip></descripGrp><ntig><termGrp><term id="3007291">12-key layout</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3007656">distribució de 12 tecles</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52938_3007292_3007657"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A keyboard layout for Japanese characters that places keys in a grid with 5 rows, making it easier for Japanese speakers to find a specific Hiragana character.</descrip></descripGrp><ntig><termGrp><term id="3007292">50-on layout</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3007657">distribució de 50 tecles</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52939_3007385_3010609"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To capture text, graphics, and any associated annotations by using Snipping Tool.</descrip></descripGrp><ntig><termGrp><term id="3007385">snip</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3010609">retallar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52942_3007396_3010611"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The mode that the user chooses in Snipping Tool that determines what type of snip the app will capture.</descrip></descripGrp><ntig><termGrp><term id="3007396">Snipping mode</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3010611">Mode de retall</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52946_3007399_3010608"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process by which a user can capture a screen shot, or snip, of any object on the screen, and then annotate, save, or share the image.</descrip></descripGrp><ntig><termGrp><term id="3007399">snipping</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3010608">retallada de pantalla</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeec