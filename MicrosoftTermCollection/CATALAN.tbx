84373_2885842"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A chat bot conversation to answer a user question that can't be answered in a single turn, as the question needs to be refined to determine the correct answer.</descrip></descripGrp><ntig><termGrp><term id="2884373">multi-turn conversation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2885842">conversa de diversos torns</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51087_2884374_2885839"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in QnA Maker that allows you to add pre-populated conversation data sets into your knowledge base to make your bot more conversational and engaging.</descrip></descripGrp><ntig><termGrp><term id="2884374">chit-chat</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2885839">xat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51088_2884375_2885844"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In a QnA Maker knowledge base, a question and its respective answer and all the information associated with that answer.</descrip></descripGrp><ntig><termGrp><term id="2884375">QnA pair</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"