53056_3017116_3017781"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The universal interactive canvas application that moves freely across applications, bringing human connection back into hybrid work to enable teams to think, plan, and create together.</descrip></descripGrp><ntig><termGrp><term id="3017116">Loop</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3017781">Loop</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53056_3017116_3023025"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The universal interactive canvas application that moves freely across applications, bringing human connection back into hybrid work to enable teams to think, plan, and create together.</descrip></descripGrp><ntig><termGrp><term id="3017116">Loop</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3023025">Microsoft Loop</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53056_3022592_3017781"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The universal interactive canvas application that moves freely across applications, bringing human connection back into hybrid work to enable teams to think, plan, and create together.</descrip></descripGrp><ntig><termGrp><term id="3022592">Microsoft Loop</term><termNote type="partOfSpeech">Prop