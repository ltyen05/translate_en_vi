Set><langSet xml:lang="ca"><ntig><termGrp><term id="2859371">PAW</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50468_2857329_2859374"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A dedicated administrative workstation or laptop in an environment designed to help protect high-privilege administrative accounts, and the systems they have access to, from compromise.</descrip></descripGrp><ntig><termGrp><term id="2857329">PAW</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2859374">estació de treball d'accés amb privilegis</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50469_2857333_2859386"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A cheatsheet-like piece of content that contains key statements and ideas to be communicated within a team.</descrip></descripGrp><ntig><termGrp><term id="2857333">thought starter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2859386">iniciador d'idees</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50470_2857335_2859357"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A more detailed and actionable version of a thought starter, a cheatsheet-like piece of content that contains key statements and ideas to be communicated within a team.</descrip></descripGrp><ntig><termGrp><term id="2857335">facilitator guide</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2859357">guia per al formador</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50471_2857342_2859356"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The practice of using AI and machine learning to extract data and insights from text in documents.</descrip></descripGrp><ntig><termGrp><term id="2857342">document understanding</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2859356">comprensió mitjançant documents</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50472_2857343_2859378"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ability to recognize one’s emotions, as well as understand the reasons why one might be feeling them.</descrip></descripGrp><ntig><termGrp><term id="2857343">self-awareness</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2859378">autoconsciència</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50473_2857349_2859382"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The shared meaning that keeps teams focused, aligned, higher performing, and happier.</descrip></descripGrp><ntig><termGrp><term id="2857349">team purpose</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2859382">objectiu de l'equip</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50474_2857351_2859347"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of sharing link that allows recipients to access the file or folder without authenticating.</descrip></descripGrp><ntig><termGrp><term id="2857351">Anyone link</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2859347">enllaç d'accés anònim</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50474_2857351_2859350"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of sharing link that allows recipients to access the file or folder without authenticating.</descrip></descripGrp><ntig><termGrp><term id="2857351">Anyone link</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp><