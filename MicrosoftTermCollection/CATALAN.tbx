at is typically necessary for day-to-day operations.</descrip></descripGrp><ntig><termGrp><term id="2735236">privileged access</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2735673">accés privilegiat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48370_2735246_2737631"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of recommended chronological steps that help admins distribute, install, and configure software and/or hardware resources, by using available information on things such as the organization's assets, readiness, and target deadline.</descrip></descripGrp><ntig><termGrp><term id="2735246">deployment plan</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2737631">pla d'implementació</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48371_2735250_2737645"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A company that produces hardware.</descrip></descripGrp><ntig><termGrp><term id="2735250">manufacturer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2737645">fabricant</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">