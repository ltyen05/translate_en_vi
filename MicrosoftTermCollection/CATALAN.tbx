><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A reusable magnetic storage medium. The floppy disk used today is the rigid 3.5-inch microfloppy that holds 1.44 MB. It is called floppy because the first varieties were housed in bendable jackets.</descrip></descripGrp><ntig><termGrp><term id="1470">floppy disk</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1537174">disquet</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2490_339962_1537174"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A reusable magnetic storage medium. The floppy disk used today is the rigid 3.5-inch microfloppy that holds 1.44 MB. It is called floppy because the first varieties were housed in bendable jackets.</descrip></descripGrp><ntig><termGrp><term id="339962">disk</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1537174">disquet</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24903_1165764_1548071"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An option that isolates the foreground portion of an image and make the background transparent.</descrip></descripGrp><ntig><termGrp><term id="1165764">Remove Background</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1548071">Suprimeix el fons</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24913_1165825_1963238"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that lets users receive and send mail from other email accounts in Outlook Web App. They can add and delete those accounts, check their account synchronization status, and manage email from those accounts in their Inbox using Inbox rules.</descrip></descripGrp><ntig><termGrp><term id="1165825">Connected Accounts</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1963238">Comptes connectats</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24914_1165826_1963324"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A bubble that appears when a user clicks in a field or on a control in the user interface. The Help bubble contains information that helps the user know what to do.</descrip></descripGrp><ntig><termGrp><term id="1165826">Help bubble</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1963324">bombolla d'ajuda</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24915_1165827_1963343"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A rule that is defined by an end-user using Outlook or Outlook Web App. When a message that meets the conditions of the rule is sent or received, the rule triggers an action that is performed automatically.</descrip></descripGrp><ntig><termGrp><term id="1165827">Inbox rule</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1963343">norma de safata d'entrada</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24917_1165829_1963583"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A company that provides text messaging services.</descrip></descripGrp><ntig><termGrp><term id="1165829">mobile service provider</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1963583">proveïdor de serveis de telefonia mòbil</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2492_397154_411033"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An item that resides in a folder that uses an event sink. The item provides the store with information that includes what events will trigger the sink, the name of the sink, and options such as restrictions for when the event will fire.</descrip></descripGrp><ntig><termGrp><term id="397154">event registration</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="411033">registre d'esdeveniments</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24923_1165896_2425353"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An XrML-based certificate that associates an identity (for example, a user account) with a machine certificate.</descrip></descripGrp><ntig><termGrp><term id="1165896">Rights Account Certificate</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2425353">RAC</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24923_1165897_2425353"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An XrML-based certificate that associates an identity (for example, a user account) with a machine certificate.</descrip></descripGrp><ntig><termGrp><term id="1165897">RAC</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2425353">RAC</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24931_1165919_2319451"><langSet xml:lang="en-US"><descripGrp><descrip type="