Number">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1816943">Proveïdor d'extensions de l'Odata</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33083_1754526_1757969"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The automatic display of photos in Windows Photos in a grid-like pattern based on metadata from the photos that are connected to the user's account.</descrip></descripGrp><ntig><termGrp><term id="1754526">photo mix</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1757969">mescla de fotos</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33084_1755584_1757962"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A function relevant to an app in use that is displayed on the app bar.</descrip></descripGrp><ntig><termGrp><term id="1755584">app command</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1757962">ordre de l'aplicació</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33085_1755674_1757970"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The charm that takes users to the Start screen.</descrip></descripGrp><ntig><termGrp><term id="1755674">Start charm</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1757970">botó d'accés Inicia</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33087_1755689_1757965"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The functionality that allows users to switch back to recently used apps.</descrip></descripGrp><ntig><termGrp><term id="1755689">app switching</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1757965">canvi entre aplicacions</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33088_1755690_1757966"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The state that enables a PC to turn on instantly and have tiles and other services update even when the screen is off.</descrip></descripGrp><ntig><termGrp><term id="1755690">connected standby</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1757966">mode d'espera connectat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33089_1755691_1757968"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of Windows and device settings that users can change grouped into one location.</descrip></descripGrp><ntig><termGrp><term id="1755691">PC settings</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1757968">Configuració de l'ordinador</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3309_375734_380503"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Functionality in Exchange Server 2007 that helps the messaging administrator diagnose spam-related problems by applying diagnostic metadata, or "stamps," such as sender-specific information, puzzle validation results, and content filtering results, to messages as they pass through the anti-spam features that filter inbound messages from the Internet.</descrip></descripGrp><ntig><termGrp><term id="375734">anti-spam stamping</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="380503">segell contra correu brossa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33091_1755693_1757971"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tablet hardware button with the Windows logo on it that's similar to the Windows key on a keyboard. Pressing the Power and Windows buttons simultaneously is the equivalent of pressing Ctrl+Alt+Del.</descrip></descripGrp><ntig><termGrp><term id="1755693">Windows button</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1757971">botó del Windows</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33092_1755782_1760444"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The spreading of malicious content through online advertising.</descrip></descripGrp><ntig><termGrp><term id="1755782">malvertising</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1760444">publicitat maliciosa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33092_1755783_1760444"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The spreading of malicious content through online advertising.</descrip></descripGrp><ntig><termGrp><term id="1755783">malicious advertising</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1760444">publicitat maliciosa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33093_1755827_1781022"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A rating of how safe an app is determined to be by SmartScreen, according to age, presence of digital certificate, and other criteria.</descrip></descripGrp><ntig><termGrp><term id="1755827">SmartScreen Application Reputation</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1781022">Reputació d'aplicació SmartScreen</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33099_1757767_1816907"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application that determines what the out-of-box experience will be.</descrip></descripGrp><ntig><termGrp><term id="1757767">out-of-box experience application</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1816907">aplicació OOBE</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33099_1757767_1816910"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application that determines what the out-of-box experience will be.</descrip></descripGrp><ntig><termGrp><term id="1757767">out-of-box experience application</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1816910">aplicació d'experiència imme