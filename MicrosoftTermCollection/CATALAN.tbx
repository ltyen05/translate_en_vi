eographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21532_777721_1097704"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A list of messages that you have sent or received.</descrip></descripGrp><ntig><termGrp><term id="777721">message history</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1097704">historial de missatges</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21535_777724_1097713"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An instant message that is transmitted while the sender or recipient is offline.</descrip></descripGrp><ntig><termGrp><term id="777724">offline instant message</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1097713">missatge instantani fora de línia</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21541_777731_1097719"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ID that allows someone to sign in to a non-Microsoft website that uses the Microsoft Account service.</descrip></descripGrp><ntig><termGrp><term id="777731">Partner ID</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1097719">ID de soci</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21543_777733_1097907"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The helper program that can store sign-in information for multiple Windows Live IDs.</descrip></descripGrp><ntig><termGrp><term id="777733">Windows Live Sign-in Assistant</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1097907">Ajudant d'inici de sessió de Windows Live</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21545_777735_1098364"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that offers improved security by loading a document in a read-only view, rather than in the full editor, for scenarios that pose a greater potential security risk.</descrip></descripGrp><ntig><termGrp><term id="777735">Protected View</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1098364">Visualització protegida</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21546_777736_1098361"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A package containing everything you need to show one or many PowerPoint presentations on another computer. This package can be saved to a folder or burned to a CD.</descrip></descripGrp><ntig><termGrp><term id="777736">presentation package</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1098361">paquet de presentació</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21547_777737_1097887"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A slide show of MSN videos that displays in the advertising space of the main Main messenger window.</descrip></descripGrp><ntig><termGrp><term id="777737">video carousel</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1097887">seqüència de vídeo</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21548_777738_1097889"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file, similar to a video clip, that contains a short audio segment that a user records to send to a contact. The clip appears in the contact's conversation window and plays automatically.</descrip></descripGrp><ntig><termGrp><term id="777738">voice clip</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><te