p></ntig></langSet></termEntry><termEntry id="53506_3180607_3185282"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The cloud service that allows companies to issue and accept verifiable credentials, which users can store and manage in a digital wallet on their device and use for attestation of personal information and credentials with any organization.</descrip></descripGrp><ntig><termGrp><term id="3180607">Verified ID</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3185282">ID verificat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53507_3046578_3046865"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Part of the Microsoft Viva family of employee experience offerings, it empowers people to ask for and give anonymous feedback in under two minutes, allowing them to understand how they’re doing and to make necessary changes real time.</descrip></descripGrp><ntig><termGrp><term id="3046578">Microsoft Viva Pulse</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3046865">Microsoft Viva Pulse</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53508_3046579_3048823"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The program that helps telecom operators participate in Operator Connect (e.g., for fixed lines, mobile, 