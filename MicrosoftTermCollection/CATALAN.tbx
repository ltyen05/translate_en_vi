ech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12032_74843_2767868"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A connection between one or more sending and receiving devices.</descrip></descripGrp><ntig><termGrp><term id="74843">line</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2767868">línia</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12039_183955_364146"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A card-like layout on an Outlook Contact that provides the user with the look of a real world business card.</descrip></descripGrp><ntig><termGrp><term id="183955">Electronic Business Card</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="364146">Targeta de visita electrònica</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12039_183955_380838"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A card-like layout on an Outlook Contact that provides the user with the look of a real world business card.</descrip></descripGrp><ntig><termGrp><term id="183955">Electronic Business Card</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp>