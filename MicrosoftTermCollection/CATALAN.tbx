><descripGrp><descrip type="definition">A designation with the same meaning as another in the same language but often with different implications and associations.</descrip></descripGrp><ntig><termGrp><term id="118391">synonym</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2428658">sinònim</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42210_2389354_2390493"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Windows Camera mode in which the Camera app automatically adjusts image capture settings such as exposure, ISO, sensitivity, white balance and more.</descrip></descripGrp><ntig><termGrp><term id="2389354">Auto</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2390493">Automàtic</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42211_2389891_2394375"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A person who uses software internally before the software is released for production or public visibility. The person may be part of a coordinated effort where multiple users attempt to find errors in coding or logic that cause the software to malfunction.</descrip></descripGrp><ntig><termGrp><term id="2389891">self-hoster</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2394375">verificador intern</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42212_2389893_2417557"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A series of points with color and varying thickness that resembles physical ink on a digital screen.</descrip></descripGrp><ntig><termGrp><term id="2389893">ink</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2417557">traç</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42213_2390287_2392146"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A standalone application that requires the user to have an Office 365 subscription.</descrip></descripGrp><ntig><termGrp><term id="2390287">companion app</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2392146">aplicació complementària</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42221_2390960_2394371"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To use software internally before the software is released for production or public visibility, aiming at finding errors in coding or logic that cause the software to malfunction.</descrip></descripGrp><ntig><termGrp><term id="2390960">self-host</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2394371">provar internament</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42261_2391816_2393592"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The unavailability or decrease in quality of service due to an unexpected failure or interruption in use or functioning of a service impacting consumers.</descrip></descripGrp><ntig><termGrp><term id="2391816">app outage</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2393592">interrupció de l'aplicació</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42262_2391817_2393593"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A customized shortened URL used for tweets, leaving room for text to use the business brand in the link.</descrip></descripGrp><ntig><termGrp><term id="2391817">branded URL</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2393593">adreça URL de marca</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42267_2391822_2393599"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The serious vulnerability that affects HTTPS and other services that rely on SSL and TLS, allowing attackers to break the encryption and read or steal sensitive information.</descrip></descripGrp><ntig><termGrp><term id="2391822">DROWN</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2393599">DROWN</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42273_2391828_2393606"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The distributed security service which runs on Azure that helps isolate and destroy malware by analyzing millions of potential exploit and malware samples in virtual machines.</descrip></descripGrp><ntig><termGrp><term id="2391828">Microsoft Malware Detonation Service</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2393606">Microsoft Malware Detonation Service</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42279_2391834_2393615"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The code name for Microsoft Malware Detonation Service project.</descrip></descripGrp><ntig><termGrp><term id="2391834">SONAR<