ecisió</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20310_724523_760933"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A final decision made by a court or administrative authority.</descrip></descripGrp><ntig><termGrp><term id="724523">determination</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="760933">determinació</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20311_724524_760934"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">When referring to Microsoft Volume Licensing Programs, the use rights applicable to a new version of a product that are more restrictive than the use rights applicable to a prior version.</descrip></descripGrp><ntig><termGrp><term id="724524">detrimental use rights</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="760934">canvi restrictiu en els drets d'ús</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20312_724525_760937"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">When referring to Microsoft Volume Licensing Programs, an enrollment that is entered into between Microsoft and the Customer and where the customer pays Microsoft directly for licenses sold.</descrip></descripGrp><ntig><termGrp><term id="724525">direct enrollment</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="760937">inscripció directa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20313_724526_760938"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To convert a program from machine code into assembly language source code.</descrip></descripGrp><ntig><termGrp><term id="724526">disassemble</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="760938">desassemblar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20314_724527_760939"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To renounce or disaffirm a claim, right or possession.</descrip></descripGrp><ntig><termGrp><term id="724527">disclaim</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="760939">excloure</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2