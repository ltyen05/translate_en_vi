to an earlier version</descrip></descripGrp><ntig><termGrp><term id="2139117">Restore this version</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2151805">Restaura aquesta versió</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37478_2139118_2151804"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Sway view that allows the user to see what the Sway would look and behave like to anyone else reading it by switching from the edit view to the reading view.</descrip></descripGrp><ntig><termGrp><term id="2139118">Preview</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2151804">Visualització prèvia</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37479_2139119_2151820"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Sway feature that allows users to edit, add, reorder, delete, and structure their Sway content.</descrip></descripGrp><ntig><termGrp><term id="2139119">Storyline</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2151820">Guió</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Femini