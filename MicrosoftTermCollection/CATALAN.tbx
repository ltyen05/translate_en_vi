mNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55154_3126502_3127383"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The security solution designed to safeguard end-to-end communication and collaboration for organizations using Microsoft tools like Teams and Outlook.</descrip></descripGrp><ntig><termGrp><term id="3126502">Defender for Collaboration</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3127383">Defender per a la col·laboració</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55154_3126502_3127387"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The security solution designed to safeguard end-to-end communication and collaboration for organizations using Microsoft tools like Teams and Outlook.</descrip></descripGrp><ntig><termGrp><term id="3126502">Defender for Collaboration</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3127387">Microsoft Defender per a la col·laboració</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55155_3126610_3126639"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An AI-powered model used in Dynamics 365 Marketing that provides users with a feedback loop to gain a comprehensive view of the effectiveness of their real-time marketing tactics in driving key business outcomes, empowering them to optimize their marketing mix by learning from tactics that worked well and improving or dropping tactics that didn’t.</descrip></descripGrp><ntig><termGrp><term id="3126610">attribution model</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3126639">model d'atribució</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55156_3126611_3126641"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A hub to manage consent and compliance in Dynamics 365 Marketing. Compliance profiles govern how consent is captured and enforced, as well as store information such as company address, the preference management experience, and related configuration.</descrip></descripGrp><ntig><termGrp><term id="3126611">compliance profile</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3126641">perfil de compliment</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55157_3126612_3126642"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in Dynamics 365 Marketing that helps users analyze event data through a broad overview of the event planning activities and results from all their events, and event records for one event to see results and analytics that relate to that event only.</descrip></descripGrp><ntig><termGrp><term id="3126612">event analytics</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3126642">anàlisi d'esdeveniments</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55158_3126613_3126643"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that lets users set a limit on the number of messages their customers receive in a given amount of time through a particular channel in real-time marketing journeys.</descrip></descripGrp><ntig><termGrp><term id="3126613">frequency cap</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3126643">límit de freqüència</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55159_3126614_3126644"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A template available in Dynamics 365 Marketing to quickly create a new customer journey or reuse an existing customer journey structure as a starting point for future campaigns.</descrip></descripGrp><ntig><termGrp><term id="3126614">journey template</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3126644">plantilla de recorregut</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55160_3126615_3126645"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The dashboard in Dynamics 365 Marketing that allows users to define key customer milestones, measure them over time, and assess the contribution and effectiveness of their journeys, channels, and marketing assets in driving customers to the milestones.</descrip></descripGrp><ntig><termGrp><term id="3126615">marketing effectiveness</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3126645">eficàcia del màrqueting</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55161_3126616_3126646"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An inbound communication channel that allows your customers to register for newsletters, ask for quotations, etc. The form is defined by a set of input fields arranged into a form layout.</descrip></descripGrp><ntig><termGrp><term id="3126616">marketing form</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3126646">formulari de màrqueting</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55162_3126617_3126647"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A center in real-time marketing that allows users to provide customers with branded experiences to sign up for communications and fine-tune their preferences to ensure they receive the right communications.</descrip></descripGrp><ntig><termGrp><term id="3126617">preference center</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3126647">centre de preferències</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55163_3126618_3126648"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An item that is visibly present at the event, and features a sponsor's logo or message. These typically include small freebies given away to event attendees, but could also be some type of infrastructure or facility provided to event-goers.</descrip></descripGrp><ntig><termGrp><term id="3126618">sponsorable article</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3126648">element patrocinable</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55164_3126700_3127713"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The dedicated Microsoft Edge experience built for work that enables admins in organizations to give their users a productive and secure work browser across managed and unmanaged devices.</descrip></descripGrp><ntig><termGrp><term id="3126700">Microsoft Edge for Business</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3127713">Microsoft Edge for Business</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55165_3126701_3127711"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The directory service that provides authentication, authorization, and password management for Microsoft Windows networks.</descrip></descripGrp><ntig><termGrp><term id="3126701">Microsoft Entra Domain Services</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3127711">Serveis de domini</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55165_3126701_3127712"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The directory service that provides authentication, authorization, and password management for Microsoft Windows networks.</descrip></descripGrp><ntig><termGrp><term id="3126701">Microsoft Entra Domain Services</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3127712">Serveis de domini del Microsoft Entra</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><