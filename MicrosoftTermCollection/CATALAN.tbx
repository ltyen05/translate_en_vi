termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3043999">Clau de client del Microsoft Purview</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46350_3043787_2613659"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that enables customers to provide and control their own encryption keys used to encrypt their Microsoft data at rest.</descrip></descripGrp><ntig><termGrp><term id="3043787">Microsoft Purview Customer Key</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2613659">Clau de client</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46350_3043787_2613661"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that enables customers to provide and control their own encryption keys used to encrypt their Microsoft data at rest.</descrip></descripGrp><ntig><termGrp><term id="3043787">Microsoft Purview Customer Key</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2613661">Clau de client de l'Office 365</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46350_3043787_3043999"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that enables customers to provide and control their own encryption keys used to encrypt their Microsoft data at rest.</descrip></descripGrp><ntig><termGrp><term id="3043787">Microsoft Purview Customer Key</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3043999">Clau de client del Microsoft Purview</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46351_2611874_2613667"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The REST web service allows users to retrieve information about user, admin, system, and policy actions and events from Office 365 and Azure AD activity logs and to aggregates them into tenant-specific content blobs.</descrip></descripGrp><ntig><termGrp><term id="2611874">Office 365 Management Activity API</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2613667">Office 365 Management Activity API</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46353_2612185_2612288"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The consumer-friendly name for virtualization-based security (VBS). The VBS service in Windows 10 uses hardware virtualization features to create and isolate a secure region of memory from the normal operating system.</descrip></descripGrp><ntig><termGrp><term id="2612185">Core isolation</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2612288">Aïllament del nucli</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46354_2612186_2612289"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of open tabs, including applications, files, pages, or websites, which can be saved together and re-opened together when you want to continue with that set of tabs.</descrip></descripGrp><ntig><termGrp><term id="2612186">set</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2612289">conjunt</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46355_2612189_2612295"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The most important person in a video that you create using the video remix feature in Microsoft Photos. When ​the user selects a person as the "star," then photos and video clip​s of that person will be featured more prominently than other content in the video.​</descrip></descripGrp><ntig><termGrp><term id="2612189">star</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2612295">estrella</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46356_2612191_2614153"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The pre-release version of Microsoft People app.</descrip></descripGrp><ntig><termGrp><term id="2612191">People Preview</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2614153">Visualització prèvia del Persones de Microsoft</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46356_2612191_2614155"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The pre-release version of Microsoft People app.</descrip></descripGrp><ntig><termGrp><term id="2612191">People Preview</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2614155">Visualització prèvia del Persones</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46356_2612764_2614153"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The pre-release version of Microsoft People app.</descrip></descripGrp><ntig><termGrp><term id="2612764">Microsoft People Preview</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2614153">Visualització prèvia del Persones de Microsoft</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46356_2612764_2614155"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The pre-release version of Microsoft People app.</descrip></descripGrp><ntig><termGrp><term id="2612764">Microsoft People Preview</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2614155">Visualització prèvia del Persones</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46375_2612854_2614156"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A date when Microsoft will no longer provide updates to a feature release of a product, such that a customer needs to upgrade to a new feature release to continue receiving support from Microsoft.</descrip></descripGrp><ntig><termGrp><term id="2612854">end of service</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2614156">fi del servei</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46375_2878237_2614156"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A date when Microsoft will no longer provide updates to a feature release of a product, such that a customer needs to upgrade to a new feature release to continue receiving support from Microsoft.</descrip></descripGrp><ntig><termGrp><term id="2878237">EOL</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2614156">fi del servei</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46381_3128246_3129143"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature for Windows commercial customers that helps mitigate security threats by restricting the applications that users are allowed to run and the code that runs in the System Core (kernel).</descrip></descripGrp><ntig><termGrp><term id="3128246">App Control for Business</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3129143">Control d'aplicacions</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46381_3128246_3129144"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature for Windows commercial customers that helps mitigate security threats by restricting the applications that users are allowed to run and the code that runs in the System Core (kernel).</descrip></descripGrp><ntig><termGrp><term id="3128246">App Control for Business</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3129144">Control d'aplicacions per a empreses</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46381_3128314_3129143"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature for Windows commercial customers that helps mitigate security threats by restricting the applications that users are allowed to run and the code that runs in the System Core (kernel).</descrip></descripGrp><ntig><termGrp><term id="3128314">App Control</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3129143">Control d'aplicacions</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46381_3128314_3129144"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature for Windows commercial customers that helps mitigate security threats by restricting the applications that users are allowed to run and the code that runs in the System Core (kernel).</descrip></descripGrp><ntig><termGrp><term id="3128314">App Control</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3129144">Control d'aplicacions per a empreses</term><termNote type="geographicalUsage">ESP</termNo