nection between the user's device and a server that provides access to the Internet, typically through an Internet service provider.</descrip></descripGrp><ntig><termGrp><term id="184819">Internet connection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1555464">connexió a Internet</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11218_236993_1382133"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A connection between the user's device and a server that provides access to the Internet, typically through an Internet service provider.</descrip></descripGrp><ntig><termGrp><term id="236993">web connection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1382133">connexió web</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11218_236993_1555464"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A connection between the user's device and a server that provides access to the Internet, typically through an Internet service provider.</descrip></descripGrp><ntig><termGrp><term id="236993">web connection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1555464">connexió a Internet</term><termNote type="geographicalUsage">ESP</termNo