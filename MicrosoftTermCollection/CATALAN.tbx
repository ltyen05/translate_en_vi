rosoft Dynamics 365 for tablets</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2838165">Microsoft Dynamics 365 per a tauletes</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50177_2837913_2838162"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Dynamics 365 mobile app optimized for a larger tablet screen.</descrip></descripGrp><ntig><termGrp><term id="2837913">Dynamics 365 for tablets</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2838162">Dynamics 365 per a tauletes</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50177_2837913_2838165"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Dynamics 365 mobile app optimized for a larger tablet screen.</descrip></descripGrp><ntig><termGrp><term id="2837913">Dynamics 365 for tablets</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2838165">Microsoft Dynamics 365 per a tauletes</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50178_2837903_2838166"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The cloud-based service that extends the power of Dynamics 365 for Customer Service to enable customers to instantly connect and engage with their customers via newly introduced channels: live chat and SMS.</descrip></descripGrp><ntig><termGrp><term id="2837903">Omnichannel Engagement Hub</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2838166">Centre d'interacció omnicanal</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50179_2837904_2838167"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The add-in to Dynamics 365 Customer Service apps that extends the power of Dynamics 365 Customer Service to enable organizations to instantly connect and engage with their customers via channels like live chat and texting.</descrip></descripGrp><ntig><termGrp><term id="2837904">Omnichannel for Customer Service</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2838167">Plataforma omnicanal per al Customer Service</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50180_2837905_2838169"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The tool that helps new customers get started with setting up Dynamics 365 Business Central. It creates and helps apply configuration packages using a toolset designed to speed up deployment times, improve quality of implementation, introduce a repeatable approach to implementations, and enable productivity by automating and simplifying recurring tasks.</descrip></descripGrp><ntig><termGrp><term id="2837905">RapidStart Services Implementer</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2838169">Implementador del RapidStart Services</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50181_2837906_2838170"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The add-on capability for the Dynamics 365 Field Service application that enables users to automatically schedule work orders for the most appropriate resources, by optimizing bookings for the shortest travel time, available work hours, and many other constraints.</descrip></descripGrp><ntig><termGrp><term id="2837906">Resource Scheduling Optimization</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2838170">Resource Scheduling Optimization</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50182_2837907_2838171"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of features that enable in-store activities by field sales personnel including: site visit planning, activity lists, checklists and surveys.</descrip></descripGrp><ntig><termGrp><term id="2837907">Retail Sales Execution</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2838171">Execució de vendes minoristes</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50183_2837908_2838172"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature in Dynamics 365 AI for Market Insights app that provides audience insights from interactions on Bing search.</descrip></descripGrp><ntig><termGrp><term id="2837908">Search Insights</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2838172">Conclusions de cerca</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50184_2837909_2838173"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The service offered by Microsoft Social Engagement app that provides the ability to identify, compute, and project queries related to publicly available documents and posts.</descrip></descripGrp><ntig><termGrp><term id="2837909">Social Analytics</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2838173">Anàlisis socials</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50185_2837910_2838174"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The service offered by Microsoft Social Engagement app that provides the ability to listen to and monitor publicly available social communications across public and managed networks administered by third parties.</descrip></descripGrp><ntig><termGrp><term id="2837910">Social Media Monitoring</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2838174">Supervisió de les xarxes socials</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50187_2838775_2840861"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An approach to machine translation that uses an artificial neural network to predict the likelihood of a sequence of words, typically modeling entire sentences in a single integrated model.</descrip></descripGrp><ntig><termGrp><term id="2838775">neural machine translation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2840861">traducció automàtica neuronal</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50187_2838775_2840862"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An approach to machine translation that uses an artificial neural network to predict the likelihood of a sequence of words, typically modeling entire sentences in a single integrated model.</descrip></descripGrp><ntig><termGrp><term id="2838775">neural machine translation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2840862">NMT</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50187_2839428_2840861"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An approach to machine translation that uses an artificial neural network to predict the likelihood of a sequence of words, typically modeling entire sentences in a single integrated model.</descrip></descripGrp><ntig><termGrp><term id="2839428">NMT</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2840861">traducció automàtica neuronal</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50187_2839428_2840862"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An approach to machine translation that uses an artificial neural network to predict the likelihood of a sequence of words, typically modeling entire sentences in a single integrated model.</descrip></descripGrp><ntig><termGrp><term id="2839428">NMT</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2840862">NMT</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50188_2839431_2840856"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in Excel that records actions performed on an Excel sheet and saves them to a script. Henceforth, the actions can be performed automatically by running the script.</descrip></descripGrp><ntig><termGrp><term id="2839431">Action Recorder</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2840856">Enregistrador d'accions</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50189_2839432_2840864"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Name of an Excel dialog used to start the the Action Recorder.</descrip></descripGrp><ntig><termGrp><term id="2839432">Record Actions</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2840864">Enregistra accions</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5019_210901_364111"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mode in which the default style settings defined in Page Options &gt; CSS tab will be not be used, but rather the styles defined in the Manage Styles task pane for the entire page or for individual items on a page will need to be applied by the user. The style application mode can also be set to auto.</descrip></descripGrp><ntig><termGrp><term id="210901">manual style application mode</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="364111">mode d'aplicació manual d'estil</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50190_2839434_2840860"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Name of a feature in Excel that allows users to edit scripts.</descrip></descripGrp><ntig><termGrp><term id="2839434">Code Editor</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2840860">Editor de codi</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50192_2839466_2864482"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Related to Microsoft integrated marketing campaigns that align the sales, marketing, and services teams of Microsoft and its partners to address a common customer need.</descrip></descripGrp><ntig><termGrp><term id="2839466">go-to-market</term><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2864482">comercialització</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50194_2839796_2840858"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tool used to set a Yammer network to native mode, to address any network incompatibilities, to provide information on the quantity and usage of private unlisted groups in the network, and other functions.</descrip></descripGrp><ntig><termGrp><term id="2839796">Alignment Tool</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2840858">Eina d'alineació</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50195_2839821_2840857"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A report that provides information about the quantity and usage of external groups, files previously uploaded in private messages, the activity of network guests, and other information a Yammer network.</descrip></descripGrp><ntig><termGrp><term id="2839821">Alignment Report</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2840857">Informe d'alineació</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50196_2839890_2840866"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An entity that shares the controller role with another entity to ensure GDPR compliance.</descrip></descripGrp><ntig><termGrp><term id="2839890">co-controller</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2840866">corresponsable del tractament</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50196_2839891_2840866"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An entity that shares the controller role with another entity to ensure GDPR compliance.</descrip></descripGrp><ntig><termGrp><term id="2839891">joint controller</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2840866">corresponsable del tractament</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50197_2839915_2840863"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The processing of personal data in such a manner that the personal data can no longer be attributed to a specific data subject without the use of additional information, provided that such additional information is kept separately and is subject to technical and organisational measures to ensure that the personal data are not attributed to an identified or identifiable natural person.</descrip></descripGrp><ntig><termGrp><term id="2839915">pseudonymisation</term><termNote type="partOfSpeech">Noun</termN