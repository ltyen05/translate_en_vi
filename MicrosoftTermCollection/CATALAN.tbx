rp><term id="212527">massively multiplayer on-line game</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2915896">MMOG</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10829_212531_2915859"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A game conducted over the Internet in which a large number of players (hundreds or thousands) participate simultaneously.</descrip></descripGrp><ntig><termGrp><term id="212531">MMOG</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2915859">joc en xarxa massiu</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10829_212531_2915896"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A game conducted over the Internet in which a large number of players (hundreds or thousands) participate simultaneously.</descrip></descripGrp><ntig><termGrp><term id="212531">MMOG</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2915896">MMOG</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10836_2450781_1097840"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The free online on-demand tool that conducts three types of scans: the protection scan checks for and removes things like viruses and malware; the clean-up scan checks the hard disk for unnecessary files and helps users decide which ones they can safely remove, and also clears the computer's registry of orphaned data; the tune-up scan helps improve the computer's performance by defragmenting the hard disk.</descrip></descripGrp><ntig><termGrp><term id="2450781">Microsoft Safety Scanner</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1097840">analitzador de seguretat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10836_2450781_1147625"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The free online on-demand tool that conducts three types of scans: the protection scan checks for and removes things like viruses and malware; the clean-up scan checks the hard disk for unnecessary files and helps users decide which ones they can safely remove, and also clears the computer's registry of orphaned data; the tune-up scan helps improve the computer's performance by defragmenting the hard disk.</descrip></descripGrp><ntig><termGrp><term id="2450781">Microsoft Safety Scanner</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1147625">Analitzador de seguretat del Windows Live OneCare</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalG