<termEntry id="9389_185000_1382062"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A button on Audio Controls that mutes the user's microphone.</descrip></descripGrp><ntig><termGrp><term id="185000">Mute Microphone</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1382062">Silencia el micròfon</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9391_318770_1143595"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The † character.</descrip></descripGrp><ntig><termGrp><term id="318770">DAGGER</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1143595">creu</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9391_42062_1143595"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The † character.</descrip></descripGrp><ntig><termGrp><term id="42062">dagger</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1143595">creu</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9392_60785_2717497"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An information structure that precedes and identifies the information that follows.</descrip></descripGrp><ntig><termGrp><term id="60785">header</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2717497">capçalera</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9396_303757_1143592"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A function of some Web browsers that allows users to surf and view multiple pages by loading Web sites into sections (or tabs) of one page, rather than multiple pages.</descrip></descripGrp><ntig><termGrp><term id="303757">tabbed browsing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1143592">navegació per pestanyes</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9398_185340_1382102"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A selection that displays the first and last name, instead of the email address or sign-in name, for each contact in the user's Contacts list.</descrip></descripGrp><ntig><termGrp><term id="185340">Show Friendly Name</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1382102">Mostra nom amigable</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9399_186186_364182"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A notification bar warning the user about data that is blocked in the loaded file. Trust Bars can be for information only (non-actionable) or actionable.</descrip></descripGrp><ntig><termGrp><term id="186186">Trust Bar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="364182">Barra de confiança</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="94_397174_411285"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mail-enabled Active Directory user that represents a user outside the Exchange organization. Each mail user has an external email address. A mail user is similar to a mail contact, except that a mail user has Active Directory logon credentials and can access resources.</descrip></descripGrp><ntig><termGrp><term id="397174">mail user</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="411285">usuari de correu</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9401_74162_1143596"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Of or pertaining to documents, data, software, or hardware that existed prior to a certain time.</descrip></descripGrp><ntig><termGrp><term id="74162">legacy</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1143596">llegat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9409_475208_1276370"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The complete set of bill-to address information that makes up the full postal address.</descrip></descripGrp><ntig><termGrp><term id="475208">billing address information</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1276370">informació de l'adreça de facturació</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9446_48391_1547574"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Any ink that you add to a file that is not recognized as handwriting.</descrip></descripGrp><ntig><termGrp><term id="48391">drawing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1547574">dibuix</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></te