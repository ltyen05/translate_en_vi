ence of Boolean expressions paired with values, evaluates each expression in order, and returns the value corresponding to the first Boolean expression that evaluates to TRUE.</descrip></descripGrp><ntig><termGrp><term id="2422534">IFSV2</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2426007">SI.SV2</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42744_2422535_2426006"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A log of notable changes made in a piece of software.</descrip></descripGrp><ntig><termGrp><term id="2422535">changelog</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2426006">registre de canvis</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42749_2422743_2425355"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The service powered by Microsoft Cloud App Security service that enables users to gain visibility by discovering apps, activities, users, data and files in the cloud environment as well as third-party apps that are connected to the cloud.</descrip></descripGrp><ntig><termGrp><term id="2422743">Shadow IT Discovery</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2425355">