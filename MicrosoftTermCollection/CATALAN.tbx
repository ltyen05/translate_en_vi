rovides the user with analytics about teams that they are a member or owner of, including data about user and guest volume as well as messaging activity.</descrip></descripGrp><ntig><termGrp><term id="2900640">Insights</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2900884">Insights</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51557_2901206_2901525"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The licensing model in which Power BI Premium features are licensed on a per user basis.</descrip></descripGrp><ntig><termGrp><term id="2901206">Premium per user</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2901525">Power BI Premium per usuari</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51557_2901206_2901531"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The licensing model in which Power BI Premium features are licensed on a per user basis.</descrip></descripGrp><ntig><termGrp><term id="2901206">Premium per user</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2901531">Premium per usuari</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Proper