termNote></termGrp></ntig></langSet></termEntry><termEntry id="55151_3126498_3127390"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An AI service which can identify information specified by a user in a set of files and pull matching information out of similar files automatically.</descrip></descripGrp><ntig><termGrp><term id="3126498">freeform document processing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3127390">processament de documents de format lliure</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55152_3126499_3127393"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A service that can identify types of files and specific information in them after someone labels the files and provides explanations.</descrip></descripGrp><ntig><termGrp><term id="3126499">unstructured document processing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3127393">processament de documents no estructurats</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55153_3126500_3127392"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A category of services that capture, transform, and process data from documents.</descrip></descripGrp><ntig><termGrp><term id="3126500">intelligent document processing</term><termNote type="partOfSpeech">Noun</termNote><