="2482734">form designer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2497696">dissenyador de formularis</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44171_2482805_2497704"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Tracking measures and reports of website traffic using web visit and activity analytics services like Google Analytics.</descrip></descripGrp><ntig><termGrp><term id="2482805">traffic analytics</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2497704">anàlisi del trànsit</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44172_2482808_2497694"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A series of marketing strategies that that may be leveraged to influence a customer’s progress through a sales process.</descrip></descripGrp><ntig><termGrp><term id="2482808">customer journey</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2497694">recorregut del client</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44173_2482810_2497700"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An online service that allows customers to securely connect their CRM data to their web portal.</descrip></descripGrp><ntig><termGrp><term id="2482810">portal solution</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2497700">solució del portal</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44174_2482811_2497699"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A planned event such as a trade show, seminar, or webinar.</descrip></descripGrp><ntig><termGrp><term id="2482811">marketing event</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2497699">esdeveniment de màrqueting</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44175_2482812_2497705"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The application infrastructure for Dynamics 365 apps that provides a consistent user experience across a variety of form factors - PCs, phones, and tablets.</descrip></descripGrp><ntig><termGrp><term id="2482812">Unified Interface</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2497705">Interfície unificada</term><