677_2809791_2838168"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows customers using Power Apps and Common Data Service to create external-facing websites that allow users outside their organizations to sign in with a variety of authentication providers, create and view data in Common Data Service, and browse content anonymously.</descrip></descripGrp><ntig><termGrp><term id="2809791">Power Apps portals</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2838168">portals del Power Apps</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49700_2812847_2840766"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The family of Microsoft products that provide malware protection and a unified infrastructure for client management and security.</descrip></descripGrp><ntig><termGrp><term id="2812847">System Center Endpoint Protection</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2840766">System Center Endpoint Protection</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49702_2812919_2832297"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Power Query feature for data preparation which allows you to apply different data transformations by previewing data and selecting transformations in the user experience.</descrip></d