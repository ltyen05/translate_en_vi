tion, collaboration, integration, automation, and measurement cooperation between developers and other information-technology (IT) professionals is encouraged and expected.</descrip></descripGrp><ntig><termGrp><term id="2307925">DevOps</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2469925">DevOps</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39692_2308052_2308941"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mark or piece of information that you can add to a map, save, and share with others.</descrip></descripGrp><ntig><termGrp><term id="2308052">note</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2308941">nota de mapa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39692_2308052_2308943"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mark or piece of information that you can add to a map, save, and share with others.</descrip></descripGrp><ntig><termGrp><term id="2308052">note</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2308943">nota</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39692_2308053_2308941"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mark or piece of information that you can add to a map, save, and share with others.</descrip></descripGrp><ntig><termGrp><term id="2308053">map note</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2308941">nota de mapa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39692_2308053_2308943"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mark or piece of information that you can add to a map, save, and share with others.</descrip></descripGrp><ntig><termGrp><term id="2308053">map note</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2308943">nota</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39701_2308955_2653421"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A software development methodology intended to improve software quality and responsiveness to changing customer requirements through frequent releases in short development cycles, which is intended to improve productivity and introduce checkpoints at which new customer requirements can be adopted.</descrip></descripGrp><ntig><termGrp><term id="2308955">extreme programming</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2653421">programació extrema</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39701_2309246_2653421"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A software development methodology intended to improve software quality and responsiveness to changing customer requirements through frequent releases in short development cycles, which is intended to improve productivity and introduce checkpoints at which new customer requirements can be adopted.</descrip></descripGrp><ntig><termGrp><term id="2309246">XP</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2653421">programació extrema</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3972_44091_1537119"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A value that is automatically used by a program when the user does not specify an alternative and are built into a program when a value or option must be assumed for the program to function.</descrip></descripGrp><ntig><termGrp><term id="44091">default</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1537119">valor per defecte</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3974_31934_2094924"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A predefined name used to refer to an OLE object in Visual Basic. A class name consists of the name of the application used to create the OLE object, the object's type, and, optionally, the version number of the application.</descrip></descripGrp><ntig><termGrp><term id="31934">class name</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2094924">nom de classe</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39784_2309116_2707381"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A condition that must be met by an entity to satisfy an agreement.</descrip></descripGrp><ntig><termGrp><term id="2309116">requirement</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2707381">requisit</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39791_2309123_2572208"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An iterative and incremental agile software development methodology for managing product development defining "a flexible, holistic product development strategy where a development team works as a unit to reach a common goal", challenges assumptions of the "traditional, sequential approach" to product development, and enabling teams to self-organize by encouraging physical co-location or close online collaboration of all team members, as well as daily face-to-face communication among all team members and disciplines in the project.</descrip></descripGrp><ntig><termGrp><term id="2309123">Scrum</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2572208">Scrum</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39791_2309123_2857302"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An iterative and incremental agile software development methodology for managing product development defining "a flexible, holistic product development strategy where a development team works as a unit to reach a common goal", challenges assumptions of the "traditional, sequential approach" to product development, and enabling teams to self-organize by encouraging physical co-location or close online collaboration of all team members, as well as daily face-to-face communication among all team members and disciplines in the project.</descrip></descripGrp><ntig><termGrp><term id="2309123">Scrum</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2857302">Scrum àgil</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><