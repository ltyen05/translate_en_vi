8517">Microsoft Get Started</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2159772">Introducció de Microsoft</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37573_2158517_2159980"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The built-in app that teaches customers the basic tasks of getting started with Windows 10 and what's new in each update.</descrip></descripGrp><ntig><termGrp><term id="2158517">Microsoft Get Started</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2159980">Introducció del Windows</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37577_2144334_2392050"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A data structure that contains authentication and authorization information for a user.</descrip></descripGrp><ntig><termGrp><term id="2144334">access token</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2392050">testimoni d'accés</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37580_2144338_2147058"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Lumia Camera, the feature that allows users to create high-definition photos and videos by capturing a short, high-definition video recording.</descrip></descripGrp><ntig><termGrp><term id="2144338">Lumia Moments</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2147058">Lumia Moments</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37581_2144339_2147070"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Lumia Camera, one or more frames of video that can be used to create a special image type such as a Living Image or action shot.</descrip></descripGrp><ntig><termGrp><term id="2144339">moment</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2147070">moment</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37582_2144340_2147068"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app that allows the user to capture multiple images simultaneously with different focus settings.</descrip></descripGrp><ntig><termGrp><term id="2144340">Lumia Refocus</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2147068">Lumia Refocus</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37583_2144341_2147069"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app for capturing, editing, and sharing photos of oneself that can be automatically enhanced with various effects.</descrip></descripGrp><ntig><termGrp><term id="2144341">Lumia Selfie</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2147069">Lumia Selfie</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37584_2144342_2147077"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A photo that one has taken of oneself, normally using a smartphone or a digital camera, that is planned to be uploaded to a social media website.</descrip></descripGrp><ntig><termGrp><term id="2144342">selfie</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2147077">autofoto</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37585_2354826_2356191"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that allows the camera to capture multiple shots at different flash and exposure settings, so that the user can shoot first and edit and select the perfect shot later. The resulting photo is produced by merging multiple images to produce different lighting effects, similar to HDR or blended flash.</descrip></descripGrp><ntig><termGrp><term id="2354826">Rich HDR</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2356191">HDR enriquit</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37586_2144610_2147079"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The button that invokes the Start menu (desktop) and the Start screen (mobile or desktop).</descrip></descripGrp><ntig><termGrp><term id="2144610">Start</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2147079">Inicia</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37587_2144631_2147088"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The full-screen view of Start that includes the list of items, such as apps, websites, and other info that a person can specify and customize. It is what is displayed when the Start button is used.</descrip></descripGrp><ntig><termGrp><term id="2144631">Start screen</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2147088">Inici</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37587_2144631_2147096"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The full-screen view of Start that includes the list of items, such as apps, websites, and other info that a person can specify and customize. It is what is displayed when the Start button is used.</descrip></descripGrp><ntig><termGrp><term id="2144631">Start screen</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2147096">pantalla inicial</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37587_2144639_2147088"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The full-screen view of Start that includes the list of items, such as apps, websites, and other info that a person can specify and customize. It is what is displayed when the Start button is used.</descrip></descripGrp><ntig><termGrp><term id="2144639">Start</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2147088">Inici</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37587_2144639_2147096"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The full-screen view of Start that includes the list of items, such as apps, websites, and other info that a person can specify and customize. It is what is displayed when the Start button is used.</descrip></descripGrp><ntig><termGrp><term id="2144639">Start</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2147096">pantalla inicial</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37588_2144650_2147089"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The resizable view of Start. It can be resized to show the list of items, such as apps, websites, and other info that a person can specify and customize.</descrip></descripGrp><ntig><termGrp><term id="2144650">Start menu</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2147089">Inici</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37588_2144650_2147093"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The resizable view of Start. It can be resized to show the list of items, such as apps, websites, and other info that a person can specify and customize.</descrip></descripGrp><ntig><termGrp><term id="2144650">Start menu</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termN