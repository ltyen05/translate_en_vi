cripGrp><descrip type="definition">The service in Teams that provides unlimited toll dial-in minutes and 60 dial-out minutes to the United States and Canada pooled at the tenant level.​</descrip></descripGrp><ntig><termGrp><term id="3175490">Microsoft Teams Audio Conferencing with dial-out to USA/CAN</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3175800">Audioconferència del Microsoft Teams amb trucades sortints a USA/CAN</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53181_3028165_3028653"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature in the Microsoft 365 Admin Center that provides insights to help IT admins understand how their organization adopts Microsoft 365 recommended practices and shows how Microsoft 365 delivers hybrid workplace value.</descrip></descripGrp><ntig><termGrp><term id="3028165">adoption score</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3028653">puntuació d'adopció</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53182_3028166_3028667"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A session in Teams that allows users to set a timer to work uninterrupted with Microsoft Teams notifications silenced to help them make progress on important tasks in regular intervals, with breaks planned in between.</d