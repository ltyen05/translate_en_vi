gSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft Dynamics CRM’s business application framework that surfaces the Microsoft Application Platform to accelerate the development of enterprise-class relational business applications.</descrip></descripGrp><ntig><termGrp><term id="1336787">xRM</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1376309">xRM</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26670_1340962_1367656"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A telephony device that keeps the phones working if the connection to the central site is lost.</descrip></descripGrp><ntig><termGrp><term id="1340962">Survivable Branch Appliance</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1367656">aplicació de sucursal amb funcions de supervivència</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2668_237838_2735678"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The option under the Columns heading on the Report window that allows users to select columns that contain tracking information such as "Created By" and "Modified On".</descrip></descripGrp><ntig><termGrp><term id="237838">Tracking Columns</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2735678">Columnes de seguiment</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26685_1346459_1382215"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The display name UI label used when there isn’t a display name value available, as when data can't be retrieved or someone hasn’t completely filled out their profile.</descrip></descripGrp><ntig><termGrp><term id="1346459">Someone on Windows Live</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1382215">Algú</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26685_1346459_1937061"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The display name UI label used when there isn’t a display name value available, as when data can't be retrieved or someone hasn’t completely filled out their profile.</descrip></descripGrp><ntig><termGrp><term id="1346459">Someone on Windows Live</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1937061">Algú del Windows Live</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26685_1380060_1382215"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The display name UI label used when there isn’t a display name value available, as when data can't be retrieved or someone hasn’t completely filled out their profile.</descrip></descripGrp><ntig><termGrp><term id="1380060">Someone</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1382215">Algú</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26685_1380060_1937061"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The display name UI label used when there isn’t a display name value available, as when data can't be retrieved or someone hasn’t completely filled out their profile.</descrip></descripGrp><ntig><termGrp><term id="1380060">Someone</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1937061">Algú del Windows Live</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26686_1346464_1355889"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The label for the Windows Live Devices task webpage where someone specifies a name and an icon for the computer that they plan to sync.</descrip></descripGrp><ntig><termGrp><term id="1346464">Personalize</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1355889">Personalització</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26687_1346465_1355896"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The group label for the links that provide one-click access to a subset of email messages based on specific criteria, such as flagged, containing photos, and from social networking services.</descrip></descripGrp><ntig><termGrp><term id="1346465">Quick views</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1355896">Visualitzacions ràpides</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26690_1347061_1356007"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The UI label for the Hotmail quick view that displays only the email messages that originate from a social networking service such as Facebook.</descrip></descripGrp><ntig><termGrp><term id="1347061">Social updates</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1356007">Actualitzacions socials</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26691_1347063_1356010"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The spam-fighting program that Hotmail runs where actual customers classify email messages as "junk" or "not junk." Because the program is by invitation only, customers who participate are highly engaged. The Hotmail team reported in 2010 that more than half of the spam fighters participate daily. Invitations to the program are extended to a cross-section of customers who reflect the broad population of Hotmail customers in several dimensions, including age of account and country or region. Under the program, Hotmail resends an actual message that was addressed to the spam fighter. One message per day at the most is sent.</descrip></descripGrp><ntig><termGrp><term id="1347063">Spam Fighters program</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1356010">Equip de lluita contra el correu brossa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26691_1354361_1356010"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The spam-fighting program that Hotmail runs where actual customers classify email messages as "junk" or "not junk." Because the program is by invitation only, customers who participate are highly engaged. The Hotmail team reported in 2010 that more than half of the spam fighters participate daily. Invitations to the program are extended to a cross-section of customers who reflect the broad population of Hotmail customers in several dimensions, including age of account and country or region. Under the program, Hotmail resends an actual message that was addressed to the spam fighter. One message per day at the most is sent.</descrip></descripGrp><ntig><termGrp><term id="1354361">Feedback Loop program</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1356010">Equip de lluita contra el correu brossa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26692_1347064_1355760"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A rating system for online games.</descrip></descripGrp><ntig><termGrp><term id="1347064">game rating system</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1355760">sistema de classificació de jocs</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26696_1347068_1356164"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A conversation that is displayed with other conversations in one window. The conversations are loaded into sections or tabs of the window, rather than in multiple windows.</descrip></descripGrp><ntig><termGrp><term id="1347068">tabbed conversation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1356164">conversa en pestanya</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26697_1347069_1356006"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The webpage subheading for the view in Messenger that displays the social activity of friends.</descrip></descripGrp><ntig><termGrp><term id="1347069">social</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1356006">social</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26698_1347070_1355781"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The UI label in Messenger for the aspect of the social view that displays prioritized recent social activity of friends.</descrip></descripGrp><ntig><termGrp><term id="1347070">highlights</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1355781">informacions destacades</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26699_1347071_1355893"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An email message that has image attachements, inline images, inline video, or an inline album.</descrip></descripGrp><ntig><termGrp><term id="1347071">photo e-mail</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1355893">correu electrònic amb fotos</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2670_233117_2368700"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of project in which the customer pays a predetermined amount for the entire project.</descrip></descripGrp><ntig><termGrp><term id="233117">fixed-price project</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2368700">projecte de preu fix</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2670_627844_2368700"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of project in which the customer pays a predetermined amount for the entire project.</descrip></descripGrp><ntig><termGrp><term id="627844">fixed fee job</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2368700">projecte de preu fix</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26702_1347074_1355902"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that lets you work on your computer from a different computer.</descrip></descripGrp><ntig><termGrp><term id="1347074">remote connection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1355902">connexió remota</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26703_1347075_1355888"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The tooltip that is displayed when hovering over a personal folder on the Manage Folders webpage.</descrip></descripGrp><ntig><termGrp><term id="1347075">Personal Folder</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1355888">Carpeta personal</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26704_1347076_1356163"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The webpage subheading for the list of synced folders.</descrip></descripGrp><ntig><termGrp><term id="1347076">Synced folders</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1356163">carpetes sincronitzades</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26705_1347077_1355782"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The UI element that allows users to set permissions for an item or content so that is not made available to anyone else, thus making it private.</descrip></descripGrp><ntig><termGrp><term id="1347077">Just me</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1355782">Només per a mi</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26706_1347078_1355884"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The UI label for the social activity stream that Windows Live programmatically displays in a collection. Items listed may originate within a Windows Live program, service, or landing page (Messenger, OneDrive, Windows Live Photos), or in third-party activities people connect to their profiles, such as Facebook.</descrip></descripGrp><ntig><termGrp><term id="1347078">Messenger social</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1355884">Novetats a la xarxa social</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26707_1347079_1355654"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To manually edit and make adjustments to your photos.</descrip></descripGrp><ntig><termGrp><term id="1347079">fine tune</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1355654">ajustar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26708_1347080_1355762"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A metadata tag that includes GPS latitude and longitude coordinates to specify a location. Geotags are typically used to find and organise photos and videos.</descrip></descripGrp><ntig><termGrp><term id="1347080">geotag</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1355762">geoetiqueta</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26709_1347081_1356005"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To present items within a set in no established order, as opposed to ordering items by name, by date taken, by size, etc., and typically used with audio and visual media, such as album song order or photo slide shows.</descrip></descripGrp><ntig><termGrp><term id="1347081">shuffle</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1356005">seleccionar aleatòriament</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26710_1347082_1356162"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables users to share stories with others using their digital photos and photo management software.</descrip></descripGrp><ntig><termGrp><term id="1347082">storytelling</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1356162">narrador d'històries</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26714_1347086_1355890"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To add a personal touch to something.</descrip></descripGrp><ntig><termGrp><term id="1347086">personalize</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1355890">personalitzar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26719_1347108_1355895"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A view that provides one-click access to a subset of email messages based on specific criteria, which include: flagged (messages that the customer has designated as requiring follow-up), photos (messages that contain photos), and social updates (messages that originate from a social networking service such as Facebook).</descrip></descripGrp><ntig><termGrp><term id="1347108">quick view</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1355895">visualització ràpida</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26720_1347110_1355755"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The webpage subheading for the view in Messenger that displays someone's friends and contacts that aren't friends but that can be interacted with in Messenger (those are often legacy entries).</descrip></descripGrp><ntig><termGrp><term id="1347110">friends</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1355755">amics</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26726_1354359_2145176"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file exported by Outlook for Mac that contains a user's email messages, contacts, calendar events, and other information.</descrip></descripGrp><ntig><termGrp><term id="1354359">Outlook for Mac data file</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2145176">arxiu de dades d'Outlook per a Mac</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26727_1354360_1376300"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A territory, and its information, that is included within another territory.</descrip></descripGrp><ntig><termGrp><term id="1354360">sub-territory</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1376300">subzona de vendes</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26728_1354362_1381858"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in Hotmail that's designed to help people get more done on the web without having to leave their inbox. Active View displays directly in the body of the email message, showing either previews to other web content or interactive elements created by the sender that let the recipient complete core tasks. A preview message example might include a reference to a file on a photo-sharing or video-sharing website that the recipient can view in the message, or package-tracking information that's extracted from a shipping website. Interactive scenarios might include rating movies and updating wish lists on movie-rental websites or responding to invitations or comments on social networking websites.</descrip></descripGrp><ntig><termGrp><term id="1354362">Active View</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1381858">visualització activa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26735_1354369_1989362"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application that is meant to run on a desktop or laptop computer.</descrip></descripGrp><ntig><termGrp><term id="1354369">desktop application</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1989362">programa d'escriptori</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26735_1505030_1989362"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application that is meant to run on a desktop or laptop computer.</descrip></descripGrp><ntig><termGrp><term id="1505030">desktop app</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1989362">programa d'escriptori</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26735_1986256_1989362"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application that is meant to run on a desktop or laptop computer.</descrip></descripGrp><ntig><termGrp><term id="1986256">desktop program</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1989362">programa d'escriptori</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26737_1354381_1356169"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that gives users a rich way to send video messages asynchronously to another user.</descrip></descripGrp><ntig><termGrp><term id="1354381">Video Messages</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1356169">Missatges de vídeo</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26737_1354381_2052568"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that gives users a rich way to send video messages asynchronously to another user.</descrip></descripGrp><ntig><termGrp><term id="1354381">Video Messages</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2052568">missatges de vídeo</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26737_1815478_1356169"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that gives users a rich way to send video messages asynchronously to another user.</descrip></descripGrp><ntig><termGrp><term id="1815478">video messages</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1356169">Missatges de vídeo</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26737_1815478_2052568"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that gives users a rich way to send video messages asynchronously to another user.</descrip></descripGrp><ntig><termGrp><term id="1815478">video messages</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2052568">missatges de vídeo</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26738_1354382_1355894"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables users to access their other POP3 enabled email accounts from within their central email account.</descrip></descripGrp><ntig><termGrp><term id="1354382">POP aggregation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1355894">agregació POP</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26740_1354385_1382022"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A small image that provides a visual indication of roles, contribution levels, achievements, affiliations, etc.</descrip></descripGrp><ntig><termGrp><term id="1354385">