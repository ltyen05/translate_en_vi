 Office suite, including Office Online.</descrip></descripGrp><ntig><termGrp><term id="2106336">Office 365 Nonprofit Business Premium</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2107524">Office 365 Nonprofit Business Premium</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35639_2106335_2107523"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office 365 subscription for small and midsized nonprofit organizations that need anywhere access to email and documents with Office Online.</descrip></descripGrp><ntig><termGrp><term id="2106335">Office 365 Nonprofit Business Essentials</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2107523">Office 365 Nonprofit Business Essentials</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35640_2046824_2067225"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An offer from Microsoft Office 365 for nonprofit organizations that offers additional storage options for SharePoint Online, priced per gigabyte, to support an organization's SharePoint Online growth.</descrip></descripGrp><ntig><termGrp><term id="2046824">SharePoint Online Storage for Nonprofits</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></nt