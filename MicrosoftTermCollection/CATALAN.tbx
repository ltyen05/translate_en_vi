ote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42991_2436154_2438548"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A cloud service that uses machine learning.</descrip></descripGrp><ntig><termGrp><term id="2436154">intelligent service</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2438548">servei intel·ligent</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42992_2436155_2438552"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Word Mobile feature that opens a preview window of the scrolling destination page when the user taps on the Thumb Scroll and that only updates the main view once the user lets go.​</descrip></descripGrp><ntig><termGrp><term id="2436155">Scroll Preview</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2438552">Visualització prèvia del desplaçament</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42993_2436156_2594932"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mechanism to set up clients to the cloud service.</descrip></descripGrp><ntig><termGrp><term id="2436156">onboarding</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2594932">incorporació</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42994_2436157_2594931"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mechanism to remove clients from the cloud service.</descrip></descripGrp><ntig><termGrp><term id="2436157">offboarding</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2594931">exclusió</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42995_2436354_2438546"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that allows Office users wanting to use a third-party app or plug in within Office to provide their credentials or permission so that the app within Office can perform actions on their behalf. ​</descrip></descripGrp><ntig><termGrp><term id="2436354">App to App sign in</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2438546">Inici de sessió entre aplicacions</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42996_2436355_2438551"><langSet xml:lang="en-US"