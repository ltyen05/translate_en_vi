ovides unlimited access to a catalog of games, including popular backward compatible Xbox 360 and blockbuster Xbox One titles.</descrip></descripGrp><ntig><termGrp><term id="2873631">Game Pass</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2517293">Xbox Game Pass</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44161_2873631_2913848"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A monthly subscription that provides unlimited access to a catalog of games, including popular backward compatible Xbox 360 and blockbuster Xbox One titles.</descrip></descripGrp><ntig><termGrp><term id="2873631">Game Pass</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2913848">Game Pass</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44166_2482613_2484940"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A card that contains content that is based on key words in email drafts and that can be added to the email.</descrip></descripGrp><ntig><termGrp><term id="2482613">suggestion card</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2484940">targeta de suggeriments</term><termNote type="geographicalUsage">ESP</termNote><termNote type="part