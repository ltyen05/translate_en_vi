"grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2824635">flux planificat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49902_2821617_2824633"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A flow that provides a streamlined user experience that leads people through the processes their organization has defined for interactions that need to be advanced to a desired outcome.</descrip></descripGrp><ntig><termGrp><term id="2821617">business process flow</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2824633">flux del procés de negoci</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49903_2821620_2824634"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A flow in which a user selects a button to run repetitive tasks from any place, at any time, via a mobile device.</descrip></descripGrp><ntig><termGrp><term id="2821620">instant flow</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2824634">flux instantani</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49904_2821624_2824636">