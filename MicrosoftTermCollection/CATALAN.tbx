<termGrp><term id="1367627">múltiples punts de presència</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26170_1269206_1359629"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Windows Presentation Foundation and Silverlight, the movement of an event in a tree of elements. There are three types of event routing: direct, bubbling, and tunneling. With direct routing, the event does not move in the tree. With bubbling, the event moves up to the top of the tree. With tunneling, the event starts at the top of the tree and moves down to the source of the event. In Silverlight,  event routing and routed events are used, but tunneling is not implemented.</descrip></descripGrp><ntig><termGrp><term id="1269206">event routing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1359629">encaminament d'incidències</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26192_1270870_1955242"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of tools that is used to troubleshoot the crawling and indexing of Web sites.</descrip></descripGrp><ntig><termGrp><term id="1270870">webmaster tools</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1955242">eines de l'administrador web</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="262_2791_1136452"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A list of names and email addresses that are grouped under a single name.</descrip></descripGrp><ntig><termGrp><term id="2791">mailing list</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1136452">llista de correu</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2620_128366_1550766"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The vertical bar at the right of a window that users can click to move through a document.</descrip></descripGrp><ntig><termGrp><term id="128366">vertical scroll bar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1550766">barra de desplaçament vertical</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2620_128367_1550766"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The vertical bar at the right of a window that users can click to move through a document.</descrip></descripGrp><ntig><termGrp><term id="128367">vertical scrollbar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><n