uació contínua d'accés</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50351_2844892_2849663"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Name of the tab that displays the Grid view (in Microsoft Project)</descrip></descripGrp><ntig><termGrp><term id="2844892">Grid</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2849663">Quadrícula</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50360_2846268_2853102"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Microsoft 365 Compliance, a function that allows risk analysts and investigators to review copies of all individual files and email messages associated with risk alerts.</descrip></descripGrp><ntig><termGrp><term id="2846268">insider risk management content explorer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2853102">Explorador de continguts</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50360_2846268_2853285"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Microsoft 365 Compliance, a function that allows risk analysts and investigators to 