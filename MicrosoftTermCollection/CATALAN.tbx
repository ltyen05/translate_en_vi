 xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft design language developed in 2017 that contains a set of UWP features and guidelines for creating UWP apps that perform beautifully across devices, inputs, and dimensions. The guidelines are divided into several categories: layout, style, controls, input and devices, and usability.</descrip></descripGrp><ntig><termGrp><term id="2619372">Fluent Design</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2816190">Fluent</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46530_2619372_2816471"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft design language developed in 2017 that contains a set of UWP features and guidelines for creating UWP apps that perform beautifully across devices, inputs, and dimensions. The guidelines are divided into several categories: layout, style, controls, input and devices, and usability.</descrip></descripGrp><ntig><termGrp><term id="2619372">Fluent Design</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2816471">Sistema Fluent Design</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46530_2815603_2808662"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft design language developed in 2017 that contains a set of UWP