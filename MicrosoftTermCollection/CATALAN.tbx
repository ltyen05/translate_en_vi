ed.</descrip></descripGrp><ntig><termGrp><term id="2044157">server-side synchronization</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2063495">sincronització del servidor</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35623_2044158_2063493"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A non-production, test instance that provides an isolated environment of Dynamics CRM to allow for testing of custom code, such as plug-ins.</descrip></descripGrp><ntig><termGrp><term id="2044158">sandbox instance</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2063493">instància d'espai aïllat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35628_2045176_2063492"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A field that displays a value based on a calculation of the values of itself and its child fields.</descrip></descripGrp><ntig><termGrp><term id="2045176">rollup field</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2063492">camp de valor consolidat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNo