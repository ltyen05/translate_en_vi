ng Bar</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1357914">Barra del Bing</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25985_1253605_2338377"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A graphical representation of data where the intensity of color corresponds to the related analytical data. For example, low values in a range appear as blue (cold) and high values as red (hot).</descrip></descripGrp><ntig><termGrp><term id="1253605">heat map</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2338377">mapa tèrmic</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25985_2593079_2338377"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A graphical representation of data where the intensity of color corresponds to the related analytical data. For example, low values in a range appear as blue (cold) and high values as red (hot).</descrip></descripGrp><ntig><termGrp><term id="2593079">heatmap</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2338377">mapa tèrmic</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2599_211415_1555470"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Intel microprocessor that uses explicitly parallel instruction set computing and 64-bit memory addressing. "Itanium-based" refers to systems or platforms that are based on the Itanium processor. "Itanium2-based" refers to systems or platforms that are based on the Itanium2 processor. "Itanium architecture-based" refers to systems or platforms that are based on the Itanium and Itanium2 processors.</descrip></descripGrp><ntig><termGrp><term id="211415">Itanium</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1555470">Itanium</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25992_1253847_1649950"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An online community where members can virtually socialize by posting and commenting on a newsfeed, by chatting, and by sharing photos, images, articles, and other content.</descrip></descripGrp><ntig><termGrp><term id="1253847">social network</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1649950">xarxa social</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25992_1253847_2696901"><langSet xml:lang="en-US"><descripGrp><descrip 