he Inbox, Outbox, Sent Items, Deleted Items, Calendar, and Contacts folders are default folders.</descrip></descripGrp><ntig><termGrp><term id="397139">default folder</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="411010">carpeta predeterminada</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13082_186196_364185"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A task pane with options that enable the user to send a Publisher file as personalized, individually addressed email to the recipients in the specified list.</descrip></descripGrp><ntig><termGrp><term id="186196">E-mail Merge</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="364185">personalització de correu electrònic</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13089_102926_2094823"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process of copying content and/or configuration settings from one location, generally a server node, to another to ensure synchronization or fault tolerance.</descrip></descripGrp><ntig><termGrp><term id="102926">replication</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2094823">replicació</term><termNote type="geographicalUsage">ES