ntig><termGrp><term id="1056874">CDN</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2356780">CDN</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22986_1056874_2356781"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A distributed system of servers deployed in multiple data centers that cache content from origin servers and then serve it to customers. This action reduces the load on the origin servers and provides high- availability and performance to customers.</descrip></descripGrp><ntig><termGrp><term id="1056874">CDN</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2356781">xarxa de lliurament de contingut</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22986_1056875_2356780"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A distributed system of servers deployed in multiple data centers that cache content from origin servers and then serve it to customers. This action reduces the load on the origin servers and provides high- availability and performance to customers.</descrip></descripGrp><ntig><termGrp><term id="1056875">content delivery network</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2356780">CDN</term><termNot