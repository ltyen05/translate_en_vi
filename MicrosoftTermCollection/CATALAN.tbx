ermEntry id="34699_2001863_2002265"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The search feature for Windows 8.1 and beyond that enables a central search from the Start screen across the device used, the cloud, apps, and the web.</descrip></descripGrp><ntig><termGrp><term id="2001863">Bing Smart Search</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2002265">Cerca intel·ligent del Bing</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="347_186202_364186"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A web site collection feature that creates all artifacts that must be present for the web-level publishing feature to function. These include item profiles, web parts, workflow definitions, workflow bindings, site templates, events, actions, etc.</descrip></descripGrp><ntig><termGrp><term id="186202">Publishing Resources</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="364186">Recursos per a publicació</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34715_2001978_2603703"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The agreement between Microsoft Corporation and a client on the subscription of Online Services.</descrip></descripGrp><ntig><termGrp><term id="2001978">Microsoft Online Subscription Agreement</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2603703">Contracte de subscripció de Microsoft Online</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34715_2001979_2603703"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The agreement between Microsoft Corporation and a client on the subscription of Online Services.</descrip></descripGrp><ntig><termGrp><term id="2001979">MOSA</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2603703">Contracte de subscripció de Microsoft Online</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34717_2002298_2013530"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ability of Search to automatically consume fewer server resources such as memory and CPU when server resources are constrained due to transient load.</descrip></descripGrp><ntig><termGrp><term id="2002298">dynamic resource consumption for Search</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2013530">consum de recursos dinàmic per a la Cerca</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34718_2002302_2013545"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that provides the ability to keep SharePoint items on In-Place Hold for a specific time period.</descrip></descripGrp><ntig><termGrp><term id="2002302">Time-Based In-Place Hold</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2013545">Conservació al lloc amb durada definida</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34719_2002360_2013532"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The shared calendar that you can create in Office for a group of users to schedule events, track milestones, create meetings, and engage in conversations around events. Users can add events from a group calendar to their personal calendars.</descrip></descripGrp><ntig><termGrp><term id="2002360">Group Calendar</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2013532">Calendari de grup</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34720_2002416_2013541"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An advanced feature that enables a user to apply filters on properties such as people, folder, and attachments.</descrip></descripGrp><ntig><termGrp><term id="2002416">search refiner</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2013541">refinador de cerques</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34720_2002416_2820176"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An advanced feature that enables a user to apply filters on properties such as people, folder, and attachments.</descrip></descripGrp><ntig><termGrp><term id="2002416">search refiner</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2820176">refinador</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34720_2817523_2013541"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An advanced feature that enables a user to apply filters on properties such as people, folder, and attachments.</descrip></descripGrp><ntig><termGrp><term id="2817523">refiner</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2013541">refinador de cerques</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34720_2817523_2820176"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An advanced feature that enables a user to apply filters on properties such as people, folder, and attachments.</descrip></descripGrp><ntig><termGrp><term id="2817523">refiner</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2820176">refinador</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34721_2002417_2013540"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that automatically corrects searches for misspellings, alternative spellings or other input that would otherwise reduce the number or quality of the results.</descrip></descripGrp><ntig><termGrp><term id="2002417">Search Prediction</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2013540">Predicció de cerca</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34723_2002419_2013524"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables a user to search for events in the Calendar using keywords, and use filters to refine the search.</descrip></descripGrp><ntig><termGrp><term id="2002419">Calendar Event Search</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2013524">Cerca d'esdeveniments del Calendari</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34726_2002422_2013533"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables group owners to change their group's image and colors for a better representation.</descrip></descripGrp><ntig><termGrp><term id="2002422">group theming</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2013533">temes de grup</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34728_2002424_2013536"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A menu that appears on the nav bar to accommodate additional links that cannot be displayed due to a low screen resolution or small size of the browser window. The More menu is represented on the nav bar as an ellipsis.</descrip></descripGrp><ntig><termGrp><term id="2002424">More menu</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2013536">menú Més</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34730_2003267_2013544"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An app that enables a user to interact with tasks in a SharePoint list. A user can quickly move tasks between status categories to keep the list up to date.</descrip></descripGrp><ntig><termGrp><term id="2003267">TaskBoard</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2013544">Tauler de tasques</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34731_2004703_2013539"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables a user to search for another user's or group's calendar and pin it to their calendar list.</descrip></descripGrp><ntig><termGrp><term id="2004703">search and pin calendars</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2013539">cerca i ancora calendaris</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34734_2009037_2013523"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The workspace at the bottom of the application that displays alerts and notifications.</descrip></descripGrp><ntig><termGrp><term id="2009037">desktop app bar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2013523">barra d'aplicacions d'escriptori</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34735_2009421_2013535"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The workspace along the bottom edge of the screen that enables the user to access Office 365 services or sign out.</descrip></descripGrp><ntig><termGrp><term id="2009421">mobile app bar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2013535">barra d'aplicacions per a mòbil</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34739_2012681_2013537"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables users to compose or reply to a message without leaving the context of the conversation.</descrip></descripGrp><ntig><termGrp><term id="2012681">Quick Compose</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2013537">Redacció ràpida</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34741_2012702_2521301"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that allows organizations to comply with legal discovery requirements by searching and holding relevant content from mailboxes, Skype for Business, and SharePoint Online websites, documents and file shares.</descrip></descripGrp><ntig><termGrp><term id="2012702">In-Place eDiscovery</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2521301">eDiscovery local</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34748_2012910_2013543"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office feature that creates a view where users can see the content that has been shared with them.</descrip></descripGrp><ntig><termGrp><term id="2012910">Shared with Me</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2013543">Compartits amb mi</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34749_2012913_2013534"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows a preview of a webpage or YouTube video. The preview will show a photo, title, and description of the webpage or video.</descrip></descripGrp><ntig><termGrp><term id="2012913">Inline Previews</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2013534">Visualitzacions prèvies en línia</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34750_2012915_2013525"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A button that opens the current document’s table of contents in a pane. Users can pin the pane to the document, and when they scroll through the document, the table of contents dynamically highlights the section they are in.</descrip></descripGrp><ntig><termGrp><term id="2012915">Contents</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2013525">Contingut</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34751_2012916_2013531"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The UI element that enables the user to locate text and go to locations where the text occurs in a document.</descrip></descripGrp><ntig><termGrp><term id="2012916">Find</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2013531">Cerca</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34754_2013078_2013538"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ability of multiple authors, who are editing a shared document, to simultaneously see text and formatting changes made by co-authors as they add them.</descrip></descripGrp><ntig><termGrp><term id="2013078">Real-time Co-authoring</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2013538">Coautoria en temps real</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34755_2013123_2013546"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that creates new and improved mobile browser views. Documents are displayed as big touchable tiles on the screen. Users can view their own documents, shared documents, or ones they follow. They can open documents or share the URL of a document with other users. Additionally, users can navigate to Mail, Calendar, People, and Sites to view sites that they follow and those promoted by their site administrator.</descrip></descripGrp><ntig><termGrp><term id="2013123">Touch Design</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2013546">Disseny tàctil</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34756_2013318_2017589"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An app for the Windows Store designed for small groups of SharePoint users to enable them to perform basic tasks, such as provide access to team document libraries, site feeds, and project tasks.</descrip></descripGrp><ntig><termGrp><term id="2013318">Sites app</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml: