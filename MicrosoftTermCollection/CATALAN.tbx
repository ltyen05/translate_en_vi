"><ntig><termGrp><term id="1251312">Cashback</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25902_1231846_1253327"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Web page object that assists users in finding both public (Web and Windows Live) and private (my Windows Live content) content for insertion into their authored content.</descrip></descripGrp><ntig><termGrp><term id="1231846">Quick add</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1253327">Afegeix ràpidament</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25903_1231847_1251565"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The link to the free online workspace for accessing, editing, and sharing Excel, Word, PowerPoint and OneNote documents across your PC, smartphone, and web browser.</descrip></descripGrp><ntig><termGrp><term id="1231847">Documents</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1251565">Documents</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25904_1231848_1250878"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The link to bing.com in some regions but to a dropdown list of more Bing options in other regions.</descrip></descripGrp><ntig><termGrp><term id="1231848">Bing</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1250878">Bing</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25905_1231849_1251563"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Windows Mobile header link that opens a menu that contains more options.</descrip></descripGrp><ntig><termGrp><term id="1231849">Do more</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1251563">Fes més coses</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25906_1231850_1251562"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The link to the website where customers add computers (both PCs and Macs), mobile phones, and digital photo frames so they can access their synced folders and connect remotely to their devices.</descrip></descripGrp><ntig><termGrp><term id="1231850">Devices</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1251562">Dispositius</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</ter