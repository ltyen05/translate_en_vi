Grp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1098093">DEP</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11319_168227_1098294"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A security feature that monitors programs on a computer to determine if they use system memory safely.</descrip></descripGrp><ntig><termGrp><term id="168227">DEP</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1098294">Prevenció de l'execució de dades</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11325_253810_2095111"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A variable that contains a reference to an object.</descrip></descripGrp><ntig><termGrp><term id="253810">object variable</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2095111">variable d'objecte</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1133_1520_1550676"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A data type used in some programming languages, notably C, to declare variables that can store floating-point numbers.</descrip></descripGrp><ntig><termGrp><term id="1520">float</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1550676">float</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11330_360145_1143707"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A program you use to view, print, and electronically mail a snapshot, such as a report snapshot.</descrip></descripGrp><ntig><termGrp><term id="360145">Snapshot Viewer</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1143707">Snapshot Viewer</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11332_397182_411291"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A managed folder that appears in Outlook by default, to which messaging records management has been applied, and whose the retention and journaling is controlled by managed content settings that are applied to the folder.</descrip></descripGrp><ntig><termGrp><term id="397182">managed default folder</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="411291">carpeta per defecte administrada</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11334_397217_411446"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A designated server through which Exchange routes all outgoing messages. The smart host then makes the remote connection. If a smart host is designated, the Exchange server only needs to transmit to the smart host, instead of repeatedly contacting the domain until a connection is made.</descrip></descripGrp><ntig><termGrp><term id="397217">smart host</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="411446">amfitrió intel·ligent</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11334_397218_411446"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A designated server through which Exchange routes all outgoing messages. The smart host then makes the remote connection. If a smart host is designated, the Exchange server only needs to transmit to the smart host, instead of repeatedly contacting the domain until a connection is made.</descrip></descripGrp><ntig><termGrp><term id="397218">relay host</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="411446">amfitrió intel·ligent</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11339_117428_1321708"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A company controlled by another company or corporation.</descrip></descripGrp><ntig><termGrp><term id="117428">subsidiary</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1321708">filial</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1134_36967_1546558"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To reduce the size of a set of data, such as a file or a communications message, so that it can be stored in less space or transmitted with less bandwidth.</descrip></descripGrp><ntig><termGrp><term id="36967">compress</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1546558">comprimir</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11341_237305_327301"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows task work to be assigned to a group at the resource level to rather than to an individual. The total work load of the team resource includes both each individual's and the team's. These are not project teams.</descrip></descripGrp><ntig><termGrp><term id="237305">Team Resources</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="327301">Recursos d'equip</term><termNote type="geographicalUsage">ESP</termNote><termNot