nction may vary in different programs.</descrip></descripGrp><ntig><termGrp><term id="89979">PAGE DOWN key</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1136445">tecla Av Pàg</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14101_334507_1821056"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The User Interface (UI) element that initiates the process of accepting an incoming telephone call.</descrip></descripGrp><ntig><termGrp><term id="334507">answer</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1821056">respon</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14106_234578_1963643"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A room, computer, or any equipment needed at a meeting.</descrip></descripGrp><ntig><termGrp><term id="234578">resource</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1963643">recurs</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1411_134356_1550783"><langSet xml:l