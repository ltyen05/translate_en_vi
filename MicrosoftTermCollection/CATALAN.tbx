e type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2957163">equació de segon grau</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52739_2956719_2957153"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A multiplicative factor consisting of a whole number.</descrip></descripGrp><ntig><termGrp><term id="2956719">Integer coefficient</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2957153">coeficient enter</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5274_168784_1550757"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To go back to a previous state by reversing the effects of one or more commands.</descrip></descripGrp><ntig><termGrp><term id="168784">undo</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1550757">desfer</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52741_2956721_2957165"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A solution that is a rational number, that is any number that can be represented in the form of p/q where q=/=0.</descrip></descripGrp><ntig><termGrp><term id="2956721">rational solution</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2957165">solució racional</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52742_2956722_2957131"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A scalar value that is a function of the entries of a square matrix.</descrip></descripGrp><ntig><termGrp><term id="2956722">determinant</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2957131">determinant</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52743_2956723_2957152"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A statement that of two quantities one is specifically less than or greater than another.</descrip></descripGrp><ntig><termGrp><term id="2956723">inequality</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2957152">desigualtat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52744_2956724_2957181"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The replacement of the variables in an algebraic expression by their values in terms of another set of variables.</descrip></descripGrp><ntig><termGrp><term id="2956724">transformation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2957181">transformació</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52745_2956725_2957126"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The derived function of a function.</descrip></descripGrp><ntig><termGrp><term id="2956725">derivative</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2957126">derivada</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52746_2956726_2957155"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The coordinate of the point at which a curve intersects an axis.</descrip></descripGrp><ntig><termGrp><term id="2956726">intercept</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2957155">intersecció</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntr