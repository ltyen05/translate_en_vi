ermGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1136470">inhabilitar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1914_46388_2145076"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To make an entity nonfunctional.</descrip></descripGrp><ntig><termGrp><term id="46388">disable</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2145076">deshabilitar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1918_183941_364144"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows users to check and remove personal and other sensitive information from a document.</descrip></descripGrp><ntig><termGrp><term id="183941">Document Inspector</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="364144">inspector de documents</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19188_652160_2095169"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The part of PivotTable view that contains row fields.</descrip></descripGrp><ntig><termGrp><term id="652160">row area</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2095169">àrea de files</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19189_652161_2095171"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The numbered gray area to the left of each row.</descrip></descripGrp><ntig><termGrp><term id="652161">row heading</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2095171">títol de la fila</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1919_46463_1537138"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A round, flat piece of nonmagnetic, shiny metal encased in a plastic coating, designed to be read from and written to by optical (laser) technology.</descrip></descripGrp><ntig><termGrp><term id="46463">disc</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1537138">disc</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19193_652165_2095180"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Access workgroup in which users log on with a user name and password and in which access to database objects is restricted according to permissions granted to specific user accounts and groups.</descrip></descripGrp><ntig><termGrp><term id="652165">security-enabled workgroup</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2095180">grup de treball amb la seguretat habilitada</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19196_652168_2095183"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A field that is displayed in the series area of a chart and that contains series items. A series is a group of related data points.</descrip></descripGrp><ntig><termGrp><term id="652168">series field</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2095183">camp de sèrie</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19197_652169_2095184"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A technique that uses a version of the current form or datasheet with empty fields in which you can type values you want the filtered records to contain. The data is filtered by the server before it's retrieved from the database.</descrip></descripGrp><ntig><termGrp><term id="652169">Server Filter By Form</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2095184">filtre de servidor per formulari</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1920_460667_1281841"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A reply by a recipient of a campaign activity. Campaign responses can result from many channels, including email, telephone, and fax.</descrip></descripGrp><ntig><termGrp><term id="460667">campaign response</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1281841">resposta de campanya</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19205_652177_1537165"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To change the dimensions of a shape by dragging one of its handles after it has been selected with the pointer tool.</descrip></descripGrp><ntig><termGrp><term id="652177">size</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1537165">canviar la mida</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1922_2618056_1276383"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The amount of money designated for an activity or task.</descrip></descripGrp><ntig><termGrp><term id="2618056">budget</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1276383">pressupost assignat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1922_460666_1276383"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The amount of money designated for an activity or task.</descrip></descripGrp><ntig><termGrp><term id="460666">budget allocated</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1276383">pressupost assignat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19258_652230_2095206"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A special row in a list or table that provides a selection of aggregate functions useful for working with numerical data.</descrip></descripGrp><ntig><termGrp><term id="652230">total row</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2095206">fila de totals</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19258_760167_2095206"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A special row in a list or table that provides a selection of aggregate functions useful for working with numerical data.</descrip></descripGrp><ntig><termGrp><term id="760167">totals row</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2095206">fila de totals</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19260_652232_2095205"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A query that displays a summary calculation, such as an average or sum, for values in various fields from a table or tables. A totals query is not a separate kind of query; rather, it extends the flexibility of select queries.</descrip></descripGrp><ntig><termGrp><term id="652232">totals query</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2095205">consulta de totals</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19265_652237_1098398"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A folder or file path on your computer or a location on your intranet from which it is safe to run code. Default trusted locations include the Templates, Addins, and Startup folders, and you can specify your own trusted locations.</descrip></descripGrp><ntig><termGrp><term id="652237">trusted location</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1098398">ubicació de confiança</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19271_652243_1550759"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The percentage of a work resource’s time that is assigned to a task.</descrip></descripGrp><ntig><termGrp><term id="652243">unit</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1550759">unitat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1928_90900_2365905"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To break input into smaller chunks so that a program can act upon the information.</descrip></descripGrp><ntig><termGrp><term id="90900">parse</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2365905">analitzar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19287_652259_2095222"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A case-sensitive alphanumeric string that is 4 to 20 characters long and that you enter when creating a new workgroup information file by using the Workgroup Administrator. This uniquely identifies the Admin group for this workgroup file.</descrip></descripGrp><ntig><termGrp><term id="652259">workgroup ID</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2095222">identificador de grup de treball</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19288_652260_2095223"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file that Access reads at startup that contains information about the users in a workgroup. This information includes users' account names, their passwords, and the groups of which they are members.</descrip></descripGrp><ntig><termGrp><term id="652260">workgroup information file</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2095223">fitxer d'informació del grup de treball</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19291_652263_1098416"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An XML structure that consists of a start tag, an end tag, and the information between the tags. Elements can have attributes and can contain other elements.</descrip></descripGrp><ntig><termGrp><term id="652263">XML element</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1098416">element XML</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19292_2026657_2095224"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The combination of characters and symbols that replace other characters when an XML document is parsed, usually those that have other meanings in XML. For example, &amp;lt; represents the &lt; symbol, which is also the opening bracket for a tag. A General Entity is an entity that is used within the XML document itself, as opposed to a parameter entity, which is only referenced in the DTD.</descrip></descripGrp><ntig><termGrp><term id="2026657">general entity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2095224">entitat XML</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19292_2026658_2095224"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The combination of characters and symbols that replace other characters when an XML document is parsed, usually those that have other meanings in XML. For example, &amp;lt; represents the &lt; symbol, which is also the opening bracket for a tag. A General Entity is an entity that is used within the XML document itself, as opposed to a parameter entity, which is only referenced in the DTD.</descrip></descripGrp><ntig><termGrp><term id="2026658">XML general entity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2095224">entitat XML</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19292_652264_2095224"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The combination of characters and symbols that replace other characters when an XML document is parsed, usually those that have other meanings in XML. For example, &amp;lt; represents the &lt; symbol, which is also the opening bracket for a tag. A General Entity is an entity that is used within the XML document itself, as opposed to a parameter entity, which is only referenced in the DTD.</descrip></descripGrp><ntig><termGrp><term id="652264">XML entity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2095224">entitat XML</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19293_652265_2095226"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of field with content set to either Yes or No. For example, the Recurring field indicates whether the task is a recurring task.</descrip></descripGrp><ntig><termGrp><term id="652265">Yes/No field</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2095226">camp Sí/No</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19294_652266_2095072"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To establish a connection to data from another application so that users can view and edit the data in both the original application and in the destination application.</descrip></descripGrp><ntig><termGrp><term id="652266">link</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2095072">enllaçar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1930_46651_1547563"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A device used to store information.</descrip></descripGrp><ntig><termGrp><term id="46651">disk</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1547563">disc</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19300_652272_1545880"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to information that shows what has actually occurred. For example, the actual start date for a task is the day that the task actually started.</descrip></descripGrp><ntig><termGrp><term id="652272">actual</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1545880">real</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19301_652273_1545895"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The percentage of a resource's capacity that is designated for a specific assignment.</descrip></descripGrp><ntig><termGrp><term id="652273">allocation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1545895">assignació</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19303_652275_2095172"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A small box or bar that, when clicked, selects an entire row in table or macro Design view, or when you sort and group records in report Design view.</descrip></descripGrp><ntig><termGrp><term id="652275">row selector</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2095172">selector de files</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19305_652277_2095191"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A query that consists of an SQL statement. Subqueries and pass-through, union, and data-definition queries are SQL-specific queries.</descrip></descripGrp><ntig><termGrp><term id="652277">SQL-specific query</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2095191">consulta específica de SQL</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1932_211418_1963356"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The computer that you are currently logged on to as a user. More generally, a local computer is a computer that you can access directly without using a communications line or a communications device, such as a network adapter or a modem.</descrip></descripGrp><ntig><termGrp><term id="211418">local computer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1963356">ordinador local</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1932_535324_1963356"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The computer that you are currently logged on to as a user. More generally, a local computer is a computer that you can access directly without using a communications line or a communications device, such as a network adapter or a modem.</descrip></descripGrp><ntig><termGrp><term id="535324">local machine</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1963356">ordinador local</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19320_652420_1547511"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Conditions you specify to limit which records are included in the result set of a query or filter.</descrip></descripGrp><ntig><termGrp><term id="652420">criteria</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1547511">criteris</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1933_142750_2095047"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A custom shortcut menu that replaces the built-in shortcut menu for the following objects - fields in table and query datasheets; forms and form controls in Form view, Datasheet view, and Print Preview; and reports in Print Preview.</descrip></descripGrp><ntig><termGrp><term id="142750">global shortcut menu</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2095047">menú de drecera global</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19337_652971_722784"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables users to build robust, targeted queries that include search operators. The least complex of which are the Boolean operators many users are familiar with. In addition, customers can use advanced operators such as "contains:" or "inanchor:" or "site:" Customers can add operator upon operator and watch their query change in the search box.</descrip></descripGrp><ntig><termGrp><term id="652971">advanced search</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="722784">cerca avançada</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19338_652972_722785"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A notification that is displayed to a user when user-defined criteria are met.</descrip></descripGrp><ntig><termGrp><term id="652972">alert</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="722785">avís</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19339_1722536_1097650"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The set of Windows features that provides parents and individuals with the ability to customize key aspects of the online experience in order to protect their children and/or themselves.</descrip></descripGrp><ntig><termGrp><term id="1722536">Microsoft Family Safety</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></