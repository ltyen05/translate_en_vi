="en-US"><descripGrp><descrip type="definition">The ultimate user of a computer or computer application in its finished, marketable form.</descrip></descripGrp><ntig><termGrp><term id="50960">end user</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1963299">usuari final</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13224_138502_2686543"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A reference to a specific legal case, statute, or other legal document.</descrip></descripGrp><ntig><termGrp><term id="138502">citation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2686543">citació</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13228_263086_1547496"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A person who is involved in the creation of content. For example editors, technical reviewers and subject matter experts are contributors.</descrip></descripGrp><ntig><termGrp><term id="263086">contributor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1547496">col·laborador</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13233_372513_1769068"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The amount of space from the bottom of one line of text to the bottom of the next line.</descrip></descripGrp><ntig><termGrp><term id="372513">leading</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1769068">interlineat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13233_75157_1769068"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The amount of space from the bottom of one line of text to the bottom of the next line.</descrip></descripGrp><ntig><termGrp><term id="75157">line spacing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1769068">interlineat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13234_237381_327286"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The tools and processes an organization uses to capture, manage, store, preserve, and deliver content and documents.</descrip></descripGrp><ntig><termGrp><term id="237381">Enterprise Content Management</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="327286">Gestió de contingut empresarial</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13236_338612_1821198"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A status notification that the device is not within the wireless service range.</descrip></descripGrp><ntig><termGrp><term id="338612">No service</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1821198">sense servei</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13239_318323_1143870"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A value assigned to an item of media content that indicates its suitability for a particular audience.</descrip></descripGrp><ntig><termGrp><term id="318323">content rating</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1143870">classificació del contingut</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13242_61847_2289727"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A chart consisting of horizontal or vertical bars, the widths or heights of which represent the values of numerical data.</descrip></descripGrp><ntig><termGrp><term id="61847">histogram</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2289727">histograma</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13246_264638_325409"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A dialog box that allows users to add/remove/organize the list of bibliographic information for the document</descrip></descripGrp><ntig><termGrp><term id="264638">Source Manager</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="325409">Gestor de fonts bibliogràfiques</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13247_210455_364107"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A system for organizing sites on a server. Each server can have more than one IIS instance, and each IIS instance can have more than one top-level site.</descrip></descripGrp><ntig><termGrp><term id="210455">IIS instance</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="364107">Instància de l'IIS</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13249_396919_406130"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Functionality available on Receive connectors and Send connectors on the Exchange Server 2007 Edge Transport server that lets email administrators modify the SMTP addresses of senders and recipients on messages that enter and leave an Exchange organization. Address rewriting lets an organization present a consistent appearance to external recipients of messages from the organization.</descrip></descripGrp><ntig><termGrp><term id="396919">address rewriting</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="406130">unificació d'adreces</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13259_264864_325425"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The amount of time a resource has available to work at any given point in time. Actual Capacity is equal to Capacity minus resource calendar exceptions (e.g. offsite training, morale events, jury duty) and previously scheduled committed work (Project task assignments with type = committed). This is the most valuable measure for scheduling a resource.</descrip></descripGrp><ntig><termGrp><term id="264864">Actual Capacity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="325425">Capacitat real</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13265_132802_1143873"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A keyboard character that can be used to represent one or many characters when conducting a query.</descrip></descripGrp><ntig><termGrp><term id="132802">wildcard character</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1143873">caràcter comodí</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13265_132803_1143873"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A keyboard character that can be used to represent one or many characters when conducting a query.</descrip></descripGrp><ntig><termGrp><term id="132803">wildcard</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1143873">caràcter comodí</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13265_257449_1143873"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A keyboard character that can be used to represent one or many characters when conducting a query.</descrip></descripGrp><ntig><termGrp><term id="257449">pattern-matching character</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1143873">caràcter comodí</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13266_264865_325426"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An amount of time a resource can work based on its project calendar.</descrip></descripGrp><ntig><termGrp><term id="264865">base capacity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="325426">capacitat bàsica</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13270_386705_722404"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A UI element that links to Account Services or other, account-related site.</descrip></descripGrp><ntig><termGrp><term id="386705">Account</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="722404">Compte</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13272_264866_325427"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An amount of time a resource can work based on its project calendar minus standard exceptions such as holidays and planned vacations.</descrip></descripGrp><ntig><termGrp><term id="264866">capacity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="325427">capacitat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13283_264880_325429"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A template that addresses, from a Finance &amp; Accounting view, the general activities that define a typical effort to prepare an Annual Financial Report. Includes activities focused on obtaining the necessary information from multiple departments, to working with other departments (e.g., Legal and Public Relations) to ensure all required information is presented accurately, and up through the printing and distribution process.</descrip></descripGrp><ntig><termGrp><term id="264880">Annual Report Preparation</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="325429">Preparació de l'informe anual</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13284_232490_1744132"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The combination of a number of products for sale as one unit.</descrip></descripGrp><ntig><termGrp><term id="232490">bundle</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1744132">paquet</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13288_264886_325435"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A template that outlines the various considerations you might need in order to plan a marketing campaign in your organization. Planning a marketing campaign begins with understanding you position in the marketplace and ends with collecting data and analyzing campaign effectiveness.</descrip></descripGrp><ntig><termGrp><term id="264886">Marketing Campaign Planning</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="325435">Planificació de campanyes de màrqueting</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13291_2045175_2063487"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A language selected by the user for viewing menus, dialog boxes, messages, and Help files. If none is selected, the system-preferred language is displayed.</descrip></descripGrp><ntig><termGrp><term id="2045175">preferred language</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2063487">llengua preferida</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13291_2045175_2063496"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A language selected by the user for viewing menus, dialog boxes, messages, and Help files. If none is selected, the system-preferred language is displayed.</descrip></descripGrp><ntig><termGrp><term id="2045175">preferred language</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2063496">llengua d'interfície preferida per l'usuari</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13291_311260_2063487"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A language selected by the user for viewing menus, dialog boxes, messages, and Help files. If none is selected, the system-preferred language is displayed.</descrip></descripGrp><ntig><termGrp><term id="311260">user-preferred interface language</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2063487">llengua preferida</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13291_311260_2063496"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A language selected by the user for viewing menus, dialog boxes, messages, and Help files. If none is selected, the system-preferred language is displayed.</descrip></descripGrp><ntig><termGrp><term id="311260">user-preferred interface language</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2063496">llengua d'interfície preferida per l'usuari</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13293_2428_1555465"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A network within an organization that uses Internet technologies and protocols, but is available only to certain people, such as employees of a company.</descrip></descripGrp><ntig><termGrp><term id="2428">intranet</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1555465">intranet</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13293_629895_1555465"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A network within an organization that uses Internet technologies and protocols, but is available only to certain people, such as employees of a company.</descrip></descripGrp><ntig><termGrp><term id="629895">private network</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1555465">intranet</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13294_264888_325437"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A template that addresses, from a Finance &amp; Accounting perspective, the significant activities required of companies to prepare their opening balance sheet at the date of transition to IFRS within the context of a conversion from previous Generally Accepted Accounting Principles (GAAP) to International Financial Reporting Standards (IFRS).</descrip></descripGrp><ntig><termGrp><term id="264888">Preparation of an Opening Balance Sheet at the Date of Transition to IFRS</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="325437">Preparació d'un balanç inicial a la data de transició als IFRS</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13299_32234_2714373"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A metric that measures a user's reaction to a content element by tracking the link to a different Web site, or a page or frame within the initial Web site.</descrip></descripGrp><ntig><termGrp><term id="32234">click</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2714373">clic</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13303_264892_325441"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A template that outlines the phases, key activities and deliverables of the standard Six Sigma life cycle.</descrip></descripGrp><ntig><termGrp><term id="264892">Six Sigma DMAIC Cycle</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="325441">Cicle DMAIC de Six Sigma</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13304_185645_512269"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A person whose information, such as ID or email address, has been added by the user to their contact list or to an address book.</descrip></descripGrp><ntig><termGrp><term id="185645">contact</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="512269">contacte</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13310_264893_325442"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A template that addresses the general activities involved in efforts to achieve more efficient SOX compliance. This project assumes that the organization is already SOX compliant.</descrip></descripGrp><ntig><termGrp><term id="264893">SOX Compliance and Technology Options</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="325442">Opcions de tecnologia i compliment de la llei Sarbanes-Oxley</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1332_47882_1547572"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The standard used to measure screen and printer resolution, expressed as the number of dots that a device can display or print per linear inch. The greater the number of dots per inch, the better the resolution.</descrip></descripGrp><ntig><termGrp><term id="47882">dots per inch</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1547572">ppp</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1332_47883_1547572"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The standard used to measure screen and printer resolution, expressed as the number of dots that a device can display or print per linear inch. The greater the number of dots per inch, the better the resolution.</descrip></descripGrp><ntig><termGrp><term id="47883">DPI</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1547572">ppp</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13320_34214_1724687"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of rules that determines how data is compared, ordered, and presented.</descrip></descripGrp><ntig><termGrp><term id="34214">collation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang=