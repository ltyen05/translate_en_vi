geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5819_126909_722524"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A string that uniquely identifies a user in a computer system for the purpose of logging into said system and identifying oneself to other users.</descrip></descripGrp><ntig><termGrp><term id="126909">username</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="722524">nom d'usuari</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5819_2638662_2641821"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A string that uniquely identifies a user in a computer system for the purpose of logging into said system and identifying oneself to other users.</descrip></descripGrp><ntig><termGrp><term id="2638662">user name</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2641821">nom d'usuari</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5819_2638662_722524"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A string that uniquely identifies a user in a computer system for the purpose of logging into said system and identifying oneself to other users.</descrip></descripGrp><ntig><termGrp><term id="2638662">user name</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="722524">nom d'usuari</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5834_87984_1546178"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A specific action carried out by a computer in the process of executing a program.</descrip></descripGrp><ntig><termGrp><term id="87984">operation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1546178">operació</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5845_334514_1821259"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A status displayed when the phone sound volume is set to 0 and vibration is off.</descrip></descripGrp><ntig><termGrp><term id="334514">silent</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1821259">silenci</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5849_122378_1550746"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A variety of graphics tablet that uses pressure sensors, rather than the electromagnetics used in more expensive high-resolution tablets, to track the position of a device on its surface.</descrip></descripGrp><ntig><termGrp><term id="122378">touch pad</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1550746">ratolí tàctil</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5849_783226_1550746"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A variety of graphics tablet that uses pressure sensors, rather than the electromagnetics used in more expensive high-resolution tablets, to track the position of a device on its surface.</descrip></descripGrp><ntig><termGrp><term id="783226">touchpad</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1550746">ratolí tàctil</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5850_182522_1276019"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of price reductions that can be applied to a product based on volume purchased.</descrip></descripGrp><ntig><termGrp><term id="182522">discount list</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1276019">llista de descomptes</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5853_309073_1546230"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of files that modify Windows features. Package types include service packs, security updates, language packs, and hotfixes. Examples of packages include LanguagePack, Windows Foundation, and FeaturePack.</descrip></descripGrp><ntig><termGrp><term id="309073">package</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1546230">paquet</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5855_116115_2723283"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To run a software program.</descrip></descripGrp><ntig><termGrp><term id="116115">start</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2723283">iniciar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5858_184170_364177"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Outlook pane that can be enabled to show an overview of the user's schedule, tasks and frequent contacts.</descrip></descripGrp><ntig><termGrp><term id="184170">To-Do Bar</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="364177">Barra de tasques pendents</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5859_293097_2008891"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A unique number governments issue to companies and citizens in order to track taxes paid on goods and services. VAT IDs in the European Union contain a country prefix followed by up to 12 digits or characters.</descrip></descripGrp><ntig><termGrp><term id="293097">VAT ID</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2008891">ID d'IVA</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5870_725947_1144374"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows x86-based computers to support more than 4 gigabytes (GB) of physical memory. Up to 64 GB of physical memory can be used as regular 4-kilobyte (KB) pages, and the number of bits that can be used by the kernel to address physical memory can be expanded from 32 to 36.</descrip></descripGrp><ntig><termGrp><term id="725947">physical address expansion</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1144374">extensió d'adreça física</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5870_92106_1144374"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows x86-based computers to support more than 4 gigabytes (GB) of physical memory. Up to 64 GB of physical memory can be used as regular 4-kilobyte (KB) pages, and the number of bits that can be used by the kernel to address physical memory can be expanded from 32 to 36.</descrip></descripGrp><ntig><termGrp><term id="92106">physical address extension</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1144374">extensió d'adreça física</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5870_92107_1144374"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows x86-based computers to support more than 4 gigabytes (GB) of physical memory. Up to 64 GB of physical memory can be used as regular 4-kilobyte (KB) pages, and the number of bits that can be used by the kernel to address physical memory can be expanded from 32 to 36.</descrip></descripGrp><ntig><termGrp><term id="92107">PAE</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1144374">extensió d'adreça física</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5878_149487_2095212"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of recordset that works efficiently in a client/server environment by caching data on the client and minimizing round trips to the server to access and update data.</descrip></descripGrp><ntig><termGrp><term id="149487">updateable snapshot</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2095212">instantània actualitzable</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5878_360141_2095212"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of recordset that works efficiently in a client/server environment by caching data on the client and minimizing round trips to the server to access and update data.</descrip></descripGrp><ntig><termGrp><term id="360141">updatable snapshot</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2095212">instantània actualitzable</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5890_211335_2333166"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application available in an enterprise to help with particular business and process needs, such as payroll, resource planning, supply chain management, and accounting.</descrip></descripGrp><ntig><termGrp><term id="211335">li