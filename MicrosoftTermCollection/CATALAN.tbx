 de nivell dos</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39440_2290515_2330340"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A section in the service desk that displays a view of the tiles. Each tile contains the name of the queue or view and the number of records.</descrip></descripGrp><ntig><termGrp><term id="2290515">Tiles</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2330340">Peces</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39441_2290516_2330330"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A section in the service desk that display a data stream from a Queue or a View.</descrip></descripGrp><ntig><termGrp><term id="2290516">Streams</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2330330">Seqüències</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39442_2290517_2330314"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The concept of the Service Desk application in that CSRs can interact with it, and it is tailored to the service personas and the tasks th