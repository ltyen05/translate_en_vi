ermNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3103689">Serveis d'assessorament de Microsoft</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54659_3103216_3103690"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app available within Microsoft 365, Microsoft Edge, and other apps that provides live updates related to Microsoft 365 activity such as document editing, email mentions, articles shared in Teams.</descrip></descripGrp><ntig><termGrp><term id="3103216">Microsoft Feed</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3103690">Microsoft Feed</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54660_3103217_3103680"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The API that provides Super Resolution (SR) support for D3D12 applications.</descrip></descripGrp><ntig><termGrp><term id="3103217">DirectSR</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3103680">DirectSR</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54661_3103943_3104247"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Teams app for EDU that functions as a learning management system (LMS) by allowing educators to create, organize, and reuse their course content over time and allowing students to find relevant learning resources in Teams.</descrip></descripGrp><ntig><termGrp><term id="3103943">Classwork</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3104247">Classwork</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54662_3103944_3104248"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The integrated security approach that covers the entire lifecycle of cloud-native applications by combining cloud security posture management (CSPM), cloud workload protection (CWP), cloud infrastructure entitlement management (CIEM), and cloud applications security broker (CASB).</descrip></descripGrp><ntig><termGrp><term id="3103944">Cloud-Native Application Protection</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3104248">Protecció per a aplicacions natives del núvol</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54662_3103944_3104249"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The integrated security approach that covers the entire lifecycle of cloud-native applications by combining cloud security posture management (CSPM), cloud workload protection (CWP), cloud infrastructure entitlement management (CIEM), and cloud applications security broker (CASB).</descrip></descripGrp><ntig><termGrp><term id="3103944">Cloud-Native Application Protection</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3104249">CNAPP</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54662_3103945_3104248"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The integrated security approach that covers the entire lifecycle of cloud-native applications by combining cloud security posture management (CSPM), cloud workload protection (CWP), cloud infrastructure entitlement management (CIEM), and cloud applications security broker (CASB).</descrip></descripGrp><ntig><termGrp><term id="3103945">CNAPP</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3104248">Protecció per a aplicacions natives del núvol</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54662_3103945_3104249"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The integrated security approach that covers the entire lifecycle of cloud-native applications by combining cloud security posture management (CSPM), cloud workload protection (CWP), cloud infrastructure entitlement management (CIEM), and cloud applications security broker (CASB).</descrip></descripGrp><ntig><termGrp><term id="3103945">CNAPP</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3104249">CNAPP</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54663_3103946_3104246"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft Security kit that includes infographics, videos, and an email to help users protect identities, devices, and data, safeguard from phishing and other scams, manage passwords efficiently and keep software up to date.</descrip></descripGrp><ntig><termGrp><term id="3103946">Be Cyber Smart</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3104246">Kit de ciberseguretat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54664_3103947_3104250"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Jargon or popular language for the use of multiple cloud computing and storage services in a single heterogeneous architecture.</descrip></descripGrp><ntig><termGrp><term id="3103947">multicloud</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3104250">multinúvol</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54665_3103948_3104251"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows customers to cryptographically tie tokens to the device a user originally signed in from.</descrip></descripGrp><ntig><termGrp><term id="3103948">token protection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3104251">protecció de testimonis</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54666_3104302_3104326"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A capability that quickly captures detailed steps for each process in your organization to help you better understand the opportunities to streamline your workflows. Process advisor includes both task mining and process mining capabilities.</descrip></descripGrp><ntig><termGrp><term id="3104302">process advisor</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3104326">assessor de processos</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54667_3104366_3104649"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A container-like module that is used to organize the information or modules on a page by providing a collapsible drawer-like capability. An accordion module can be used on any page.</descrip></descripGrp><ntig><termGrp><term id="3104366">accordion</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3104649">acordió</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54668_3104367_3104650"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Dynamics 365 Commerce module that is used to display and link to loyalty program information.</descrip></descripGrp><ntig><termGrp><term id="3104367">Account loyalty</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3104650">Fidelitat del compte</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54669_3104368_3104651"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A module that provides product information needed to make a purchase decision and allows the user to add the items to cart.</descrip></descripGrp><ntig><termGrp><term id="3104368">buy box</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3104651">requadre de compra</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5467_375735_380527"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mechanism that helps reduce the volume of antivirus scanning that is required across an organization by stamping messages that have been scanned for viruses with metadata that indicates the version of the antivirus software that performed the scan and the result of that scan. This metadata, or "stamp," travels securely with the message as it is routed through different email servers within the organization and is used to determine whether subsequent additional virus scanning on the message can be bypassed.</descrip></descripGrp><ntig><termGrp><term id="375735">antivirus stamping</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="380527">segell antivirus</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54670_3104369_3104652"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A code-free style change that overrides any Dynamics 365 Commerce module's Cascading Style Sheets (CSS).</descrip></descripGrp><ntig><termGrp><term id="3104369">CSS override</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3104652">substitució de CSS</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54671_3104370_3104654"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A programmatically determined marker in your published pages that allows screen-reader users to understand where they are currently located in the webpage.</descrip></descripGrp><ntig><termGrp><term id="3104370">landmark</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3104654">punt de referència</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54672_3104371_3104655"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A card that entitles the card holder to participate in the loyalty programs that are assigned to the card.</descrip></descripGrp><ntig><termGrp><term id="3104371">loyalty card</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3104655">targeta de fidelitat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54673_3104372_3104657"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A number assigned systematically to a new call center channel. Because call centers are created as operating units, users can link the call center channel to various Commerce features, such as assortments, catalogs, and specific modes of delivery.</descrip></descripGrp><ntig><termGrp><term id="3104372">operating unit number</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3104657">número d'unitat operativa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54673_3104372_3104659"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A number assigned systematically to a new call center channel. Because call centers are created as operating units, users can link the call center channel to various Commerce features, such as assortments, catalogs, and specific modes of delivery.</descrip></descripGrp><ntig><termGrp><term id="3104372">operating unit number</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3104659">OUN</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54673_3104389_3104657"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A number assigned systematically to a new call center channel. Because call centers are created as operating units, users can link the call center channel to various Commerce features, such as assortments, catalogs, and specific modes of delivery.</descrip></descripGrp><ntig><termGrp><term id="3104389">OUN</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3104657">número d'unitat operativa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54673_3104389_3104659"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A number assigned systematically to a new call center channel. Because call centers are created as operating units, users can link the call center channel to various Commerce features, such as assortments, catalogs, and specific modes of delivery.</descrip></descripGrp><ntig><termGrp><term id="3104389">OUN</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3104659">OUN</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54674_3104373_3104658"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A template that can be created and used to quickly place repeat orders.</descrip></descripGrp><ntig><termGrp><term id="3104373">order template</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3104658">plantilla de comanda</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54675_3104374_3104660"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An extension that facilitates communication between Commerce (and associated components) and a payment service.</descrip></descripGrp><ntig><termGrp><term id="3104374">payment connector</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3104660">connector de pagament</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54676_3104375_3104661"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A page that provides detailed information about a product, and lets customers select product options such as a size, style, and color. A PDP should showcase all the product information that a customer requires to make a purchase decision.</descrip></descripGrp><ntig><termGrp><term id="3104375">PDP</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3104661">PDP</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54676_3104375_3105703"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A page that provides detailed information about a product, and lets customers select product options such as a size, style, and color. A PDP should showcase all the product information that a customer requires to make a purchase decision.</descrip></descripGrp><ntig><termGrp><term id="3104375">PDP</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3105703">pàgina de detalls del producte</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54677_3104376_3104662"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of rules that are joined by AND conditions. Users can also create multiple rule blocks that have OR conditions between them.</descrip></descripGrp><ntig><termGrp><term id="3104376">rule block</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3104662">bloc de regles</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54678_3104377_3104663"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A profile that can be set up to manage identity management settings for site user logins.</descrip></descripGrp><ntig><termGrp><term id="3104377">site authentication profile</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3104663">perfil d'autenticació del lloc</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54679_3104378_3104664"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A toolset that enables users to build templates, select themes, and select and configure modules for a website without writing any code.</descrip></descripGrp><ntig><termGrp><term id="3104378">site builder</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3104664">generador del lloc</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54680_3104379_3104665"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A module that lets users browse across multiple sites by providing an easy way to switch between sites and select their preferred shopping site when a business has different sites across markets, regions, and locales.</descrip></descripGrp><ntig><termGrp><term id="3104379">site picker</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3104665">selector de lloc</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54681_3104380_3104666"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A programming element that lets a screen reader pass over navigation elements and ads on a Web site and go directly to the desired content.</descrip></descripGrp><ntig><termGrp><term id="3104380">skip link</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3104666">enllaç d'omissió</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54682_3104381_3104667"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A module that is used to add space between sections on your page to allow for different layout and design options.</descrip></descripGrp><ntig><termGrp><term id="3104381">spacer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3104667">espaiador</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54683_3104548_3105744"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The add-on service made available as a Microsoft Dataverse solution that adds the ability to replicate Dataverse data to a Microsoft Azure SQL Database store in a customer-owned Microsoft Azure subscription.</descrip></descripGrp><ntig><termGrp><term id="3104548">Data Export</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3105744">Exportació de dades</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54684_3104549_3105745"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The asynchronous service that executes long-running operations independent of the main Microsoft Dataverse core operation.</descrip></descripGrp><ntig><termGrp><term id="3104549">Dynamics 365 Async Service</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3105745">Servei asíncron del Dynamics 365</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54684_3104549_3105746"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The asynchronous service that executes long-running operations independent of the main Microsoft Dataverse core operation.</descrip></descripGrp><ntig><termGrp><term id="3104549">Dynamics 365 Async Service</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3105746">Servei de processament asíncron del Dynamics 365</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54684_3104558_3105745"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The asynchronous service that executes long-running operations independent of the main Microsoft Dataverse core operation.</descrip></descripGrp><ntig><termGrp><term id="3104558">Dynamics 365 Asynchronous Processing Service</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3105745">Servei asíncron del Dynamics 365</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54684_3104558_3105746"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The asynchronous service that executes long-running operations independent of the main Microsoft Dataverse core operation.</descrip></descripGrp><ntig><termGrp><term id="3104558">Dynamics 365 Asynchronous Processing Service</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3105746">Servei de processament asíncron del Dynamics 365</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54685_3104550_3105747"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The event website that provides an online resource where people can read about your event and its speakers, create an account, register for the event, purchase passes, view their session schedule, and more.</descrip></descripGrp><ntig><termGrp><term id="3104550">Event Portal</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3105747">Portal d'esdeveniments</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54686_3104551_3105748"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The service that enables continuous replication of Common Data Service entity data to Azure Data Lake, which can then be used to run analytics, such as Power BI reporting, machine learning, data warehousing, or other downstream integration purposes. It simplifies the technical and administrative complexity of operationalizing entities for analytics and managing schema and data.</descrip></descripGrp><ntig><termGrp><term id="3104551">Export to Data Lake</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3105748">Exportació al llac de dades</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54687_3104552_3105749"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The component that is used to display the SharePoint documents in Microsoft Dynamics 365.</descrip></descripGrp><ntig><termGrp><term id="3104552">Microsoft Dynamics 365 List</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3105749">Llista del Microsoft Dynamics 365</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54688_3104553_3105750"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that enables professional developers to build code components that can be used across model-driven and canvas apps. Code components are reusable, metadata-driven, and solution-aware, so they can be easily packaged and moved across organizations to support multiple form factors.</descrip></descripGrp><ntig><termGrp><term id="3104553">Power Apps component framework</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3105750">Power Apps component framework</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54689_3104554_3105751"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Power BI feature that allows users to easily embed interactive Power BI content in blog posts, websites, emails, or social media. They can also easily edit, update, refresh, or stop sharing their published visuals.</descrip></descripGrp><ntig><termGrp><term id="3104554">Publish to Web</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3105751">Publica al web</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5469_177200_1546149"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A message sent to the user or administrator of a system where the recipient may be a human or an automated notification manager.</descrip></descripGrp><ntig><termGrp><term id="177200">notification</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1546149">notificació</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54690_3104555_3105752"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The extension required to create and customize fetch-based reports by using SQL Server Data Tools - Business Intelligence, an authoring environment for Visual Studio.</descrip></descripGrp><ntig><termGrp><term id="3104555">Report Authoring Extension</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3105752">Extensió de creació d'informes</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54691_3104556_3105753"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tool that allows app developers to create a model-driven app site map.</descrip></descripGrp><ntig><termGrp><term id="3104556">site map designer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3105753">dissenyador de mapes de llocs</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54692_3104557_3105754"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The tool that detects issues in a Dynamics 365 environment, giving users a better picture of the state of their instances.</descrip></descripGrp><ntig><termGrp><term id="3104557">Solution Health Hub</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3105754">Centre d'estat de la solució</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54694_3105975_3121064"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The tree-planting initiative sponsored by Microsoft by which players grow a virtual seed into a tree by completing tasks on the weather page. Once the virtual tree is grown, Microsoft sponsors the planting of a real tree.</descrip></descripGrp><ntig><termGrp><term id="3105975">E-tree</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3121064">E-tree</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54695_3106186_3107244"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A transient view that appears above other content on screen to describe or add additional information when users hover over, focus on, or click an interactive element.</descrip></descripGrp><ntig><termGrp><term id="3106186">popover</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3107244">visualització emergent</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumb