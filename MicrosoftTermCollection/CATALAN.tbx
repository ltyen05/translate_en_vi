h">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2095105">camp nul</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50431_2855264_2856491"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Name of a side-pane in Outlook and other Office applications that allows the user to search reference material such as dictionaries, thesauri, specific search sites, etc.</descrip></descripGrp><ntig><termGrp><term id="2855264">Research</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2856491">Recerca</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50432_2855305_2863942"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The portal where you can get tips and advice from Power Apps users and Microsoft experts.</descrip></descripGrp><ntig><termGrp><term id="2855305">Power Apps Community</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2863942">Comunitat del Power Apps</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50441_2855883_2857319"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Any content that is linked from the Internet or an intranet to a workbook or presentation. Some examples of external content are images, linked media, data connections, and templates.</descrip></descripGrp><ntig><termGrp><term id="2855883">external content</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2857319">contingut extern</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50442_2855884_2857308"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Office applications, a small bar beneath the ribbon or in another location on the UI that shows messages.</descrip></descripGrp><ntig><termGrp><term id="2855884">business bar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2857308">barra informativa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50443_2855885_2857312"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Excel, a rectangular window that appears when the user clicks an icon in either a Stocks or Geography data cell and displays information that was retrieved from Bing or another source.</descrip></descripGrp><ntig><termGrp><term id="2855885">card</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><