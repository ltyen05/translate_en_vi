te type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2485743">placa base</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15383_81653_2485743"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The primary circuit board in a computer that contains most of the basic components of the system.</descrip></descripGrp><ntig><termGrp><term id="81653">motherboard</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2485743">placa base</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15383_81654_2485743"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The primary circuit board in a computer that contains most of the basic components of the system.</descrip></descripGrp><ntig><termGrp><term id="81654">system board</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2485743">placa base</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15384_178508_2344851"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An order for a large quantity of products or services. The minimum quantity that qualifies as a bulk order is set by individual companies.</descrip></descripGrp><ntig><termGrp><term id="178508">bulk order</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2344851">comanda massiva</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15399_446286_1321723"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process whose execution can proceed independently or in the background. Other processes may be started before the asynchronous process has finished.</descrip></descripGrp><ntig><termGrp><term id="446286">system job</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1321723">feina del sistema</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="154_543576_1098379"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A member of the Administrators group on the local server computer.</descrip></descripGrp><ntig><termGrp><term id="543576">server administrator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1098379">administrador del servidor</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15406_460690_1307827"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To initiate another response.</descrip></descripGrp><ntig><termGrp><term id="460690">override</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1307827">substituir</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15418_475193_1303461"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of accounts contacts or leads who are identified through their demographics as people or businesses who might be the most receptive to a campaign. For example to introduce a new product you can create a marketing list of accounts that have previously purchased similar products and send them brochures about the new product.</descrip></descripGrp><ntig><termGrp><term id="475193">marketing list</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1303461">llista de màrqueting</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15419_140417_2094956"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Any sequence of characters with a valid format that is surrounded by number signs (#). Valid formats include the date format specified by the locale settings for your code or the universal date format.</descrip></descripGrp><ntig><termGrp><term id="140417">date literal</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2094956">literal de data</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1542_30264_1546204"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A symbol that carries meaning in language, such as a letter, number, punctuation mark, or emoticon.</descrip></descripGrp><ntig><termGrp><term id="30264">character</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1546204">caràcter</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15422_460670_1283547"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The postal location that correspondence should be mailed to about a contract.</descrip></descripGrp><ntig><termGrp><term id="460670">contract address</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1283547">adreça del contracte</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15431_475244_1307836"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An account that is immediately above a contact entity. Any action taken on the account entity can propagate to the child contact entity.</descrip></descripGrp><ntig><termGrp><term id="475244">parent customer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1307836">client principal</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15434_460700_1314340"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of settings required to produce a snapshot, including user credentials, filter criteria, parameters, and schedule information.</descrip></descripGrp><ntig><termGrp><term id="460700">snapshot definition</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1314340">definició d'instantània</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15447_461351_1307837"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A drop-down list control that determines the values of another drop-down list (also known as a picklist) or a check box.</descrip></descripGrp><ntig><termGrp><term id="461351">parent picklist</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1307837">llista de selecció principal</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15449_261564_1143920"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tool used to edit the content of web pages that the customer has created with Office Live.</descrip></descripGrp><ntig><termGrp><term id="261564">Page Editor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1143920">Editor de pàgines</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15456_231959_2094929"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A field that's assigned a column orientation in a PivotTable report. Items associated with a column field are displayed as column labels.</descrip></descripGrp><ntig><termGrp><term id="231959">column field</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2094929">camp de columna</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15457_461710_2599399"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Excel feature that identifies invalid worksheet data, formulas, or formatting and proposes corrections.</descrip></descripGrp><ntig><termGrp><term id="461710">error checking</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2599399">comprovació d'errors</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15459_303758_1143921"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An upgrade option that allows users to upgrade from one edition of Windows to another by purchasing the upgrade online. It is enabled by Software Licensing Services (SLS) technology which allows a digital lincense to determine what features are enabled or disabled allowing Microsoft to sell either additional licenses or product upgrades through digital licenses (PUP-DL). Customers may either buy full packaged product (FPP) or upgrade quickly and conveniently electronically.</descrip></descripGrp><ntig><termGrp><term id="303758">Windows Anytime Upgrade</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1143921">Windows Anytime Upgrade</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15459_303760_1143921"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An upgrade option that allows users to upgrade from one edition of Windows to another by purchasing the upgrade online. It is enabled by Software Licensing Services (SLS) technology which allows a digital lincense to determine what features are enabled or disabled allowing Microsoft to sell either additional licenses or product upgrades through digital licenses (PUP-DL). Customers may either buy full packaged product (FPP) or upgrade quickly and conveniently electronically.</descrip></descripGrp><ntig><termGrp><term id="303760">WAU</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1143921">Windows Anytime Upgrade</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15476_72470_1537142"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In database management, an identifier for a record or group of records in a datafile.</descrip></descripGrp><ntig><termGrp><term id="72470">key</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1537142">clau</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1548_182532_1288401"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The agreed-upon method for handling shipping costs. Freight terms identify the party responsible for the payment of freight charges.</descrip></descripGrp><ntig><termGrp><term id="182532">freight terms</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1288401">condicions de transport</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</