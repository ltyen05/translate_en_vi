 xml:lang="ca"><ntig><termGrp><term id="2211052">subscriure's</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9608_183935_364142"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A graphic element on a drawing that is associated with data.</descrip></descripGrp><ntig><termGrp><term id="183935">data graphic</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="364142">gràfic de dades</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="963_232834_1963323"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The first row in a spreadsheet. The header row contains category labels that describe the contents of the columns.</descrip></descripGrp><ntig><termGrp><term id="232834">header row</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1963323">fila d'encapçalament</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9638_210467_364120"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The role name of a server that services queries in the farm topology.</descrip></descripGrp><ntig><termGrp><term id="210467">query role</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="364120">funció de consulta</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9648_233439_610777"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An audio message played over the telephone to explain valid options to users.</descrip></descripGrp><ntig><termGrp><term id="233439">prompt</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="610777">missatge d'assistència de veu</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="965_317875_1548105"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To display the subentries contained within a folder or outline view.</descrip></descripGrp><ntig><termGrp><term id="317875">expand</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1548105">expandir</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9654_315160_1143601"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Of, pertaining to, or characteristic of an electronic circuit or hardware grouping in which