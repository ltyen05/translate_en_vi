2117_2842489"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A nonprofit consortium of industry leaders, including Microsoft, that develops open standards for simpler, stronger authentication.</descrip></descripGrp><ntig><termGrp><term id="2842117">FIDO Alliance</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2842489">FIDO Alliance</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50253_2842118_2843453"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An industry collaboration program that aims to bring organizations in cybersecurity and in other industries together to change the game against malware.</descrip></descripGrp><ntig><termGrp><term id="2842118">Coordinated Malware Eradication</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2843453">CME</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50253_2842118_2843456"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An industry collaboration program that aims to bring organizations in cybersecurity and in other industries together to change the game against malware.</descrip></descripGrp><ntig><termGrp><term id="2842118">Coordinated Malware Eradication</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote