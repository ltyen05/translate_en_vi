.</descrip></descripGrp><ntig><termGrp><term id="3119531">object-level security</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3119844">seguretat a nivell d'objecte</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55035_3119825_3119930"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The practice of structuring information models and associated data schemas such that every data element is mastered (or edited) in only one place.</descrip></descripGrp><ntig><termGrp><term id="3119825">single source of truth</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3119930">font única de veritat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55036_3119828_3120015"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The enterprise-grade data lake as a service provided within each tenant of Microsoft Fabric.</descrip></descripGrp><ntig><termGrp><term id="3119828">OneLake</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3120015">OneLake</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55037_3119830_3120100"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Microsoft Fabric, the virtualized copy of data in the lake that all analytical engines can access.</descrip></descripGrp><ntig><termGrp><term id="3119830">One Copy</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3120100">Una còpia</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55049_3120732_3120828"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A neural network architecture based on transformer models, pre-trained on large datasets of unlabeled text and then tuned for specific tasks, and able to generate novel humanlike text.</descrip></descripGrp><ntig><termGrp><term id="3120732">generative pre-trained transformer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3120828">transformador generatiu preentrenat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55049_3120732_3120829"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A neural network architecture based on transformer models, pre-trained on large datasets of unlabeled text and then tuned for specific tasks, and able to generate novel humanlike text.</descrip></descripGrp><ntig><termGrp><term id