825447"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Office 365 capability that leverages threat intelligence and machine learning algorithms to automatically respond to security incidents.</descrip></descripGrp><ntig><termGrp><term id="2821551">automated incident response</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2825447">resposta automatitzada a incidents</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49897_2821557_2825452"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A grouping of emails based on similarity of attributes from message headers, body, URLs and attachments.</descrip></descripGrp><ntig><termGrp><term id="2821557">email cluster</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2825452">clúster de correu</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49898_2821559_2825483"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An email cluster containing email messages that have similar sender and content attributes.</descrip></descripGrp><ntig><termGrp><term id="2821559">similarity cluster</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2825483">clúster de similituds</term><termNote ty