 use.</descrip></descripGrp><ntig><termGrp><term id="269332">standard account</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1144404">compte estàndard</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6621_211538_1546352"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The smallest element used to form the composition of an image on a computer monitor.</descrip></descripGrp><ntig><termGrp><term id="211538">picture element</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1546352">píxel</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6621_3078_1546352"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The smallest element used to form the composition of an image on a computer monitor.</descrip></descripGrp><ntig><termGrp><term id="3078">pixel</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1546352">píxel</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6621_3079_1546352"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The smallest element used to form the composition of an image on a computer monitor.</descrip></descripGrp><ntig><termGrp><term id="3079">pel</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1546352">píxel</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6622_262573_1545862"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A credit or title animation in Windows Movie Maker.</descrip></descripGrp><ntig><termGrp><term id="262573">Mirror</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1545862">Mirall</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6626_264881_325430"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A template that provides a framework for the general activities, from a Human Resources departmental perspective, that are undertaken to perform an analysis of forecasted skills needs and the potential hiring and/or training plans needed to address the gap between needed skills and available skills.</descrip></descripGrp><ntig><termGrp><term id="264881">Develop Skills Needs - Hiring Plan - Hiring Forecast</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="325430">desenvolupament de destreses