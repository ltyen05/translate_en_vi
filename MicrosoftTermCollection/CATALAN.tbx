ographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50273_2843779_2846694"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A class of security tools that assures a continuous process of cloud security improvement and adaptation to reduce the likelihood of a successful attack, including use cases for compliance monitoring, DevOps integration, incident response, risk assessment, and risk visualization.</descrip></descripGrp><ntig><termGrp><term id="2843779">cloud security posture management</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2846694">administració de la posició de seguretat al núvol</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50273_2843780_2846689"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A class of security tools that assures a continuous process of cloud security improvement and adaptation to reduce the likelihood of a successful attack, including use cases for compliance monitoring, DevOps integration, incident response, risk assessment, and risk visualization.</descrip></descripGrp><ntig><termGrp><term id="2843780">CSPM</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2846689">CSPM</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammati