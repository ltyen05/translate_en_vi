ech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20324_724544_760967"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">When referring to the Microsoft Enterprise and Enterprise Subscription programs, a type of desktop platform comprised of Windows Upgrade, Office Enterprise and Enterprise CAL.</descrip></descripGrp><ntig><termGrp><term id="724544">enterprise desktop</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="760967">enterprise desktop</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20325_724545_760968"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An enrollment signed under an Enterprise Agreement by the entity that signed the Enterprise Agreement or one of its affiliates.</descrip></descripGrp><ntig><termGrp><term id="724545">Enterprise Enrollment</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="760968">Inscripció Enterprise</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20326_724546_760969"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An enrollment signed under an Enterprise Agreement by the entity that signed the Enterprise Agreement or one of its affiliates and an 