<termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1359627">propietat de dependència</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14509_113733_1143896"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A graphical user interface control that is equipped with a small bar which slides along a visible line and is used to set a value along a range with a minimum and maximum.</descrip></descripGrp><ntig><termGrp><term id="113733">slider</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1143896">control lliscant</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14509_641191_1143896"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A graphical user interface control that is equipped with a small bar which slides along a visible line and is used to set a value along a range with a minimum and maximum.</descrip></descripGrp><ntig><termGrp><term id="641191">slider control</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1143896">control lliscant</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14511_2148_1550789"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To reduce a window to a button on the taskbar by clicking the Minimize button (leftmost button on the right side of the title bar) or by pressing ALT+SPACEBAR and then pressing N.</descrip></descripGrp><ntig><termGrp><term id="2148">minimize</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1550789">minimitzar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14513_96306_2723265"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To run a set of instructions to retrieve specific data from the database, usually with multiple conditions. No list is displayed until you run the query.</descrip></descripGrp><ntig><termGrp><term id="96306">query</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2723265">consultar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14515_183604_2516499"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to transactions and related activity between a business and customers who use the products for personal consumption or sell to individuals for personal use.</descrip></descripGrp><ntig><termGrp><term id="183604">business to consumer</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2516499">B2C</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14515_183605_2516499"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to transactions and related activity between a business and customers who use the products for personal consumption or sell to individuals for personal use.</descrip></descripGrp><ntig><termGrp><term id="183605">business-to-consumer</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2516499">B2C</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14515_183606_2516499"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to transactions and related activity between a business and customers who use the products for personal consumption or sell to individuals for personal use.</descrip></descripGrp><ntig><termGrp><term id="183606">B2C</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2516499">B2C</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></t