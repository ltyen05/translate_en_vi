ected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2405525">Bescanvia o ofereix el meu torn</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42428_2400532_2405519"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A request from one employee to have another employee take a shift from him/her.</descrip></descripGrp><ntig><termGrp><term id="2400532">shift offer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2405519">oferta de torn</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42429_2400543_2405522"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A request from one employee to another to trade shifts with each other.</descrip></descripGrp><ntig><termGrp><term id="2400543">shift swap</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2405522">bescanvi de torns</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42430_2400558_2405524"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The StaffHub view where users can ask another employee to do a shift swap with them.</descrip></descripGrp><ntig><termGrp><term id="2400558">Swap my shift</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2405524">Bescanvia el meu torn</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42431_2400569_2405512"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The StaffHub view where users can request that another employee accept a shift offer created by them.</descrip></descripGrp><ntig><termGrp><term id="2400569">Offer my shift</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2405512">Ofereix el meu torn</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42441_2402832_2421168"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A digital fingerprint for the Secure Shell protocol.</descrip></descripGrp><ntig><termGrp><term id="2402832">SSH thumbprint</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2421168">empremta digital SSH</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42442_2402833_2421158"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A third-party company that offers organizations and end users the ability to save data to an off-site storage system.</descrip></descripGrp><ntig><termGrp><term id="2402833">cloud storage provider</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2421158">proveïdor d'emmagatzematge al núvol</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42443_2402834_2421159"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A business that maintains and manages its customers’ data and makes that data accessible over a network, usually the Internet.</descrip></descripGrp><ntig><termGrp><term id="2402834">cloud storage service</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2421159">servei d'emmagatzematge al núvol</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42445_2404433_2407768"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office setting that will save a user's work automatically without him/her needing to use the save button or ctrl+s and that works across apps and across platforms.</descrip></descripGrp><ntig><termGrp><term id="2404433">AutoSave</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></lan