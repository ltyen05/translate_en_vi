 type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20406_724630_761145"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A document that specifies the terms and conditions applicable to the use of products licensed under Microsoft Volume Licensing Programs.</descrip></descripGrp><ntig><termGrp><term id="724630">Product Use Rights</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761145">drets d'ús</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20406_724630_761146"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A document that specifies the terms and conditions applicable to the use of products licensed under Microsoft Volume Licensing Programs.</descrip></descripGrp><ntig><termGrp><term id="724630">Product Use Rights</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761146">drets d'ús dels productes</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20407_724631_761147"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">When referring to a Microsoft Enterprise or Enterprise Subscription Agreement, a type of desktop platform comprised of Windows Upgrade, Office Professional and Core CAL.</descrip></descripGrp><ntig><termGrp><term id="724631">professional desktop</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761147">professional desktop</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20408_724632_761149"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to information or property (including products) belonging to or controlled by a person or entity.</descrip></descripGrp><ntig><termGrp><term id="724632">proprietary</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761149">de la seva propietat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20409_724633_761150"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A sales tax applied in Canada by each Province.</descrip></descripGrp><ntig><termGrp><term id="724633">Provincial Sales Tax</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761150">Impost Provincial sobre Vendes</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20410_724634_761156"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">When referring to Microsoft Volume Licensing Programs, an existing prior enrollment that meets the applicable criteria in order to qualify for certain rights under the applicable license agreement.</descrip></descripGrp><ntig><termGrp><term id="724634">qualifying enrollment</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761156">inscripció qualificada</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20411_724635_761157"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">When referring to Microsoft Volume Licensing Programs, a government organization that meets the criteria required to participate under Microsoft Volume Licensing Programs as a government customer.</descrip></descripGrp><ntig><termGrp><term id="724635">qualifying government entity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761157">entitat pública qualificada</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20412_724636_761158"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">When referring to Microsoft Volume Licensing Programs, the form submitted by a qualifying government entity confirming that it meets the criteria required to participate under Microsoft Volume Licensing Programs as a government customer.</descrip></descripGrp><ntig><termGrp><term id="724636">qualifying government entity addendum</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761158">addendum d'entitat pública qualificada</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20413_724637_761159"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">When referring to Microsoft Volume Licensing Programs, an operating system that the customer must run on its desktops in order to be eligible to license the upgrade version available under the volume licensing programs. The list of qualifying operating systems is set out in the product list.</descrip></descripGrp><ntig><termGrp><term id="724637">qualifying operating system</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761159">sistema operatiu susceptible d'actualització</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20414_724638_761160"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">When referring to Microsoft Volume Licensing Programs, an operating system license that the customer must have in order to be eligible to acquire the upgrade license available under the volume licensing programs. The list of qualifying operating systems is set out in the product list.</descrip></descripGrp><ntig><termGrp><term id="724638">qualifying systems license</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761160">llicència de sistemes susceptibles d'actualització</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20415_724639_761163"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The estimated retail prices of licenses sold through a reseller or distribution channel.</descrip></descripGrp><ntig><termGrp><term id="724639">reference pricing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761163">preus de referència</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20416_724640_761169"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The means to impose, safeguard or recover a right or to obtain redress for an infringement of a right.</descrip></descripGrp><ntig><termGrp><term id="724640">remedy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761169">remei</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termN