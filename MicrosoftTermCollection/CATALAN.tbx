</termGrp></ntig></langSet></termEntry><termEntry id="32986_1724598_1816813"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An optional feature of Lync Online that enables users to make calls to, and receive calls from, the traditional network by using Lync. This feature is available to Voice Plan customers only, and administrators must sign in with a Lync-to-phone provider to get the feature.</descrip></descripGrp><ntig><termGrp><term id="1724598">Lync-to-phone</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1816813">Lync per a telèfon</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32994_2027122_2033965"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An app for Mac computers that creates a folder on the user's computer, downloads the contents of their OneDrive, and keeps the folder in sync with any file changes online and among additional computers.</descrip></descripGrp><ntig><termGrp><term id="2027122">OneDrive for Mac</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2033965">OneDrive per al Mac</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32995_1736382_1816664"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that facilitates the use of Presenter View by automatically applying the Extend setting for Windows projection and identifying the correct display for Slide Show versus Presenter view.</descrip></descripGrp><ntig><termGrp><term id="1736382">Auto-Extend</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1816664">Extensió automàtica</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32996_1736384_1816838"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in Presenter View that enables the user to switch which monitor is showing Presenter View and which monitor is showing Slide Show.</descrip></descripGrp><ntig><termGrp><term id="1736384">Swap Displays</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1816838">Canvia de pantalla</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32999_2282725_2289734"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft on-premises server product that runs Microsoft Office Online.</descrip></descripGrp><ntig><termGrp><term id="2282725">Office Online Server</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2289734">Office Online Server</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3300_294443_1649946"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The entity designated to receive something.</descrip></descripGrp><ntig><termGrp><term id="294443">recipient</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1649946">destinatari</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33000_1736513_1816807"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A web-based management portal for Lync Online services.</descrip></descripGrp><ntig><termGrp><term id="1736513">Lync admin center</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1816807">Centre d'administració del Lync</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33001_1737006_1749361"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A nonfinal release of Internet Explorer 10 that follows the consumer preview.</descrip></descripGrp><ntig><termGrp><term id="1737006">Internet Explorer 10 Release Preview</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1749361">Internet Explorer 10 Release Preview</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33002_1737007_1816658"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A component of an app for SharePoint that can be embedded on a site page to expose the functionality of the app.</descrip></descripGrp><ntig><termGrp><term id="1737007">app part</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1816658">element d'aplicació</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33009_1737014_3023023"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of confirming the identity of an individual or business who is applying to an account.</descrip></descripGrp><ntig><termGrp><term id="1737014">identity verification</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3023023">verificació de la identitat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3301_185609_1381815"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Lync menu that opens a list of options for the selected person. In Office Communicator, a menu item that opens a list of numbers for the selected person. When the user selects a phone number, Lync or Office Communicator places the call.</descrip></descripGrp><ntig><termGrp><term id="185609">Call</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1381815">Truca</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33028_1738547_1816682"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A dropdown menu item or ribbon component that is added to a site page.</descrip></descripGrp><ntig><termGrp><term id="1738547">custom action</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1816682">acció personalitzada d'aplicació</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33029_1738549_1816655"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of custom action that is added to a host site by an app for SharePoint and that links to more functionality that is contained by the app.</descrip></descripGrp><ntig><termGrp><term id="1738549">app custom action</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1816655">acció personalitzada d'aplicació</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNot