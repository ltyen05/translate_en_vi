:lang="en-US"><descripGrp><descrip type="definition">A number that combines precision and recall, and that is calculated with (precision*recall)/(precision + recall).</descrip></descripGrp><ntig><termGrp><term id="2447225">f-measure</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2450367">valor-f</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43203_2805605_2450367"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A number that combines precision and recall, and that is calculated with (precision*recall)/(precision + recall).</descrip></descripGrp><ntig><termGrp><term id="2805605">F1 score</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2450367">valor-f</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43204_2447226_2450303"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Advanced eDiscovery control that appears as a bar in a bar graph and that can be clicked on to view all the details of what comprises the bar.</descrip></descripGrp><ntig><termGrp><term id="2447226">pivot bar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2450303">barra pivot</term><termNote type="geographicalUsage">ESP</termNote><termNote type="pa