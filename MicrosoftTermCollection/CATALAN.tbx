0136_2362234"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To learn more information about an item in your collection.</descrip></descripGrp><ntig><termGrp><term id="2360136">explore</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2362234">explorar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40689_2360191_2360759"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An element in the navigation pane containing one or more tiles that represent a customized view of some subset of the underlying datasets.</descrip></descripGrp><ntig><termGrp><term id="2360191">dashboard</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2360759">escriptori digital</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4069_359698_2094908"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A data type that stores either a 1 or 0 value. Integer values other than 1 or 0 are accepted, but they are always interpreted as 1.</descrip></descripGrp><ntig><termGrp><term id="359698">bit</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2094908">bit</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</t