13_2857313"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Icon in the Visio ribbon that launches the Connector tool.</descrip></descripGrp><ntig><termGrp><term id="2856013">Connector</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2857313">Connector</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50451_2856014_2857316"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Visio, function that is used to connect two connection points.</descrip></descripGrp><ntig><termGrp><term id="2856014">Connector tool</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2857316">eina Connector</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50452_2856030_2857295"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A framework for implementing agile software development that requires real-time communication of capacity and full transparency of work. Work items are represented visually on a kanban board, allowing team members to see the state of every piece of work at any time.</descrip></descripGrp><ntig><termGrp><term id="2856030">Agile kanban</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2857295">Kanban àgil</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50453_2856031_2857321"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An agile project management tool designed to help visualize work, limit work-in-progress, and maximize efficiency (or flow).</descrip></descripGrp><ntig><termGrp><term id="2856031">kanban board</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2857321">tauler Kanban</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50454_2856043_2857879"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A ​background image that has motion built into it​.</descrip></descripGrp><ntig><termGrp><term id="2856043">motion background</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2857879">fons animat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50455_2856044_2857877"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The website that supports extensions, themes, and other add-ons for Microsoft Edge.</descrip></descripGrp><ntig><termGrp><term id="2856044">Microsoft Edge add-ons</term><termNote type=