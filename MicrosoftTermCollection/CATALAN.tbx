mNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2346346">Cartera</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40315_2354807_2346346"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Universal Windows app that allows a person to add credit cards that can be used to pay for things with their phones using NFC. The app can also be used to save loyalty cards, coupons, boarding passes, and event tickets.</descrip></descripGrp><ntig><termGrp><term id="2354807">Wallet</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2346346">Cartera</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40340_2345583_2350053"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The functionality that translates the drawing speed of an object on a touch-screen device into thickness of the line on the screen--the higher the speed, the thicker the line.</descrip></descripGrp><ntig><termGrp><term id="2345583">Velocity Ink</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2350053">Traç en funció de la velocitat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="gra