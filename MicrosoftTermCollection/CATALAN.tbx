nition">An access right available in Microsoft Dynamics CRM that enables users to attach an entity instance to the selected entity instance.</descrip></descripGrp><ntig><termGrp><term id="1774757">Append</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1788031">Annexa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33376_1775119_1816790"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A badge that is awarded to a member at the discretion of the community owner or moderators rather than being granted automatically based on that member’s earned points in the reputation system.</descrip></descripGrp><ntig><termGrp><term id="1775119">gifted badge</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1816790">distintiu atorgat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33379_1775477_1816802"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A query syntax for enterprise search that supports free-text expressions, property restrictions, and specified operators.</descrip></descripGrp><ntig><termGrp><term id="1775477">keyword query syntax</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1816802">sintaxi de consulta de par