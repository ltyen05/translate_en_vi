><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The drawing app you can use to create simple or elaborate drawings. These drawings can be either black-and-white or color. You can also use Paint to work with pictures, such as .jpg, .gif, or .bmp files.</descrip></descripGrp><ntig><termGrp><term id="2438783">Microsoft Paint</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2439800">Microsoft Paint</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43044_2438783_2439801"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The drawing app you can use to create simple or elaborate drawings. These drawings can be either black-and-white or color. You can also use Paint to work with pictures, such as .jpg, .gif, or .bmp files.</descrip></descripGrp><ntig><termGrp><term id="2438783">Microsoft Paint</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2439801">Paint</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43044_2438784_2439800"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The drawing app you can use to create simple or elaborate drawings. These drawings can be either black-and-white or color. You can also use Paint to work with pictures, such as .jpg, .gif, or .bmp files.</descrip></descripGrp><ntig><termGrp><term id="2438784">Paint</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2439800">Microsoft Paint</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43044_2438784_2439801"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The drawing app you can use to create simple or elaborate drawings. These drawings can be either black-and-white or color. You can also use Paint to work with pictures, such as .jpg, .gif, or .bmp files.</descrip></descripGrp><ntig><termGrp><term id="2438784">Paint</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2439801">Paint</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43053_2439180_2439802"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A bar, appearing at the top, that displays a small preview image (thumbnail) of the content in each open tab.</descrip></descripGrp><ntig><termGrp><term id="2439180">preview bar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2439802">barra de visualització prèvia</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43054_2439181_2439814"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows you to see a small preview of the content in each open tab, shown in a persistent bar (not just on mouseover)​.</descrip></descripGrp><ntig><termGrp><term id="2439181">tab preview</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2439814">visualització prèvia de pestanyes</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43055_2439182_2439813"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To clear or remove all tabs that are currently displayed, and save them as a set of tabs that you can restore later.</descrip></descripGrp><ntig><termGrp><term id="2439182">set aside</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2439813">reservar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43056_2439225_2922934"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The low-code, back-end data platform that includes data storage, a set of common entities with built-in data models, security management, AI, and scalable integration. Its shared data storage provides single-source data consistency that customers can build apps, flows, bots, and AI models on, of varying complexity at scale.</descrip></descripGrp><ntig><termGrp><term id="2439225">Common Data Service</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2922934">Dataverse</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43056_2715882_2922934"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The low-code, back-end data platform that includes data storage, a set of common entities with built-in data models, security management, AI, and scalable integration. Its shared data storage provides single-source data consistency that customers can build apps, flows, bots, and AI models on, of varying complexity at scale.</descrip></descripGrp><ntig><termGrp><term id="2715882">CDS</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2922934">Dataverse</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43056_2907430_2922934"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The low-code, back-end data platform that includes data storage, a set of common entities with built-in data models, security management, AI, and scalable integration. Its shared data storage provides single-source data consistency that customers can build apps, flows, bots, and AI models on, of varying complexity at scale.</descrip></descripGrp><ntig><termGrp><term id="2907430">Dataverse</term><termNot