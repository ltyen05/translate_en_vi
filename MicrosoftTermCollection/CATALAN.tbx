e="definition">The SSIS transform that takes a single input and distributes the incoming rows to one or more outputs uniformly via multithreading in a round robin fashion.</descrip></descripGrp><ntig><termGrp><term id="2304643">BDD</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2308905">BDD</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39496_2304644_2308906"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The stateless, synchronous service that receives messages from the on-premise instance of SQL Server and generates a self-signed SSL certificate as part of its first run to run as a Local System account, a configuration file to configure itself, and a Windows Firewall rule to allow its incoming TCP connections at default port 11435.</descrip></descripGrp><ntig><termGrp><term id="2304644">Cloud Adapter</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2308906">Adaptador pel núvol</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39497_2304645_2308907"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An authentication mechanism that allows a security token service (STS) in one trust domain to delegate user authentication to an identity provider in another trust domain, while generating a security token for the user, when there is a trust relationship between the two domains.</descrip></descripGrp><ntig><termGrp><term id="2304645">federated authentication</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2308907">autenticació federada</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39497_2361909_2308907"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An authentication mechanism that allows a security token service (STS) in one trust domain to delegate user authentication to an identity provider in another trust domain, while generating a security token for the user, when there is a trust relationship between the two domains.</descrip></descripGrp><ntig><termGrp><term id="2361909">federated sign-on</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2308907">autenticació federada</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39498_2304646_2308908"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A background process that cleans up ghost records.</descrip></descripGrp><ntig><termGrp><term id="2304646">ghost cleanup</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2308908">neteja de registres fantasma</term><termNote type="geographical