ature that allows the user to view, send, receive, and download SMS and MMS text messages.</descrip></descripGrp><ntig><termGrp><term id="2902290">Messages</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2903343">Missatges</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51608_2902292_2903342"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The phone feature that allows the user to make and receive calls.</descrip></descripGrp><ntig><termGrp><term id="2902292">Calls</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2903342">Trucades</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51609_2902293_2903344"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The phone feature that allows the user to control notification settings.</descrip></descripGrp><ntig><termGrp><term id="2902293">Notifications</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2903344">Notificacions</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51610_2902294_2903341"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that allows users to access the apps installed on their phone or other mobile device.</descrip></descripGrp><ntig><termGrp><term id="2902294">Apps</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2903341">Aplicacions</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51612_2902297_2907261"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The vertical distance of a point or an object above or below a reference surface or datum. Generally, the reference surface is mean sea level.</descrip></descripGrp><ntig><termGrp><term id="2902297">elevation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2907261">Elevació</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51615_2902485_2913430"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A color variation of Xbox Wireless Controllers; universally understood black color pigment, bold and reflecting little light.</descrip></descripGrp><ntig><termGrp><term id="2902485">Carbon Black</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2913430">Carbon Black</term><termNote type="g