<term id="3100233">shared calling</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3100265">trucades compartides</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54565_3100234_3100267"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in Microsoft Teams meetings that allows participants to augment their video stream with visual effects, such as make up, styles and frames.</descrip></descripGrp><ntig><termGrp><term id="3100234">video filters</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3100267">filtres de vídeo</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54566_3100235_3100266"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that provides a personal meeting stage configuration that keeps sign language interpreters and other signers in a consistent, central location with the highest available video quality throughout the meeting.</descrip></descripGrp><ntig><termGrp><term id="3100235">sign language view</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3100266">visualització de llengua de signes</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54567_3100236_3100264"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows IT admins to create policies for specific priority users (C-Suite) that filter out unwanted communication.</descrip></descripGrp><ntig><termGrp><term id="3100236">priority account chat control</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3100264">control del xat per a comptes prioritaris</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54568_3100237_3100262"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows IT admins to customize backgrounds for licensed users in an organization.</descrip></descripGrp><ntig><termGrp><term id="3100237">organization meeting background</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3100262">fons per a les reunions de l'organització</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54569_3100238_3100263"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows IT admins to customize Together Mode scenes for licensed users in an organization.</descrip></descripGrp><ntig><termGrp><term id="3100238">organization together mode scene</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3100263">escena del mode conjunt de l'organització</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54580_3100695_3100854"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The retail media advertising platform that connects brands with the world's largest retailers and their active shoppers.</descrip></descripGrp><ntig><termGrp><term id="3100695">PromoteIQ</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3100854">PromoteIQ</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54581_3100752_3100851"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app that integrates the most common PC/desktop management functions: virus inspection, trash cleaning, system repair/upgrade, system optimization, application management, pop-up blocking.</descrip></descripGrp><ntig><termGrp><term id="3100752">PC Manager</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3100851">Administrador de l'ordinador</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54582_3100753_3100849"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature within the PC Manager app that boosts PC performance by freeing memory.</descrip></descripGrp><ntig><termGrp><term id="3100753">PC Boost</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3100849">Millora del rendiment de l'ordinador</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54583_3100754_3100847"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature within the PC Manager app that protects the operational system default browser settings from unexpected changes.</descrip></descripGrp><ntig><termGrp><term id="3100754">Browser Protection</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3100847">Protecció del navegador</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54587_3113361_3114223"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft Entra product that enables securing and managing workloads, such as applications, service principals, managed identities and other software components that need to access cloud resources.</descrip></descripGrp><ntig><termGrp><term id="3113361">Microsoft Entra Workload ID</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3114223">Identitat de càrrega de treball del Microsoft Entra</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54587_3113361_3114224"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft Entra product that enables securing and managing workloads, such as applications, service principals, managed identities and other software components that need to access cloud resources.</descrip></descripGrp><ntig><termGrp><term id="3113361">Microsoft Entra Workload ID</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3114224">Identitat de càrrega de treball</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54587_3113362_3114223"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft Entra product that enables securing and managing workloads, such as applications, service principals, managed identities and other software components that need to access cloud resources.</descrip></descripGrp><ntig><termGrp><term id="3113362">Workload ID</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3114223">Identitat de càrrega de treball del Microsoft Entra</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54587_3113362_3114224"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft Entra product that enables securing and managing workloads, such as applications, service principals, managed identities and other software components that need to access cloud resources.</descrip></descripGrp><ntig><termGrp><term id="3113362">Workload ID</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3114224">Identitat de càrrega de treball</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54588_3101395_3102035"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The unity add-in that enables Microsoft Mesh users to upload custom environment templates to suit corporate events and meetings or create digital twins to match real-world environments in Mesh Spaces and Events.</descrip></descripGrp><ntig><termGrp><term id="3101395">Mesh Toolkit</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3102035">Kit d'eines del Mesh</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54591_3101398_3102032"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A strategy for fact checking an unfamiliar online source by leaving the webpage and opening a new browser tab to see what additional websites say about the unknown source.</descrip></descripGrp><ntig><termGrp><term id="3101398">lateral reading</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3102032">lectura lateral</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54592_3101451_3101511"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A layout control which helps to lay out an array of objects in a predefined three-dimensional shape. It supports various surface styles, such as plane, cylinder, sphere, and radial. The radius and size of the objects and the space between them can be adjusted.</descrip></descripGrp><ntig><termGrp><term id="3101451">3D object collection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3101511">col·lecció d'objectes 3D</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54593_3101452_3101512"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in Dynamics 365 Guides on HoloLens that allows user and remote collaborator annotate in the environment while on the call. Annotations are useful for pointing out different parts of the space, including parts that may be difficult or dangerous to reach. All call participants can see each others’ additions, and can make their own annotations.</descrip></descripGrp><ntig><termGrp><term id="3101452">annotation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3101512">anotació</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54594_3101453_3101513"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An anchor in Dynamics 365 Guides used to align guide by gazing at a printed circular code anchor that's attached to a physical object in the real world.</descrip></descripGrp><ntig><termGrp><term id="3101453">circular code anchor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3101513">àncora de codi circular</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54595_3101454_3101514"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An anchor in Dynamics 365 Guides used to align guide to a digital 3D hologram that's overlaid on a physical object in the real world.</descrip></descripGrp><ntig><termGrp><term id="3101454">holographic anchor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3101514">àncora hologràfica</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54596_3101455_3101515"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of anchor in Dynamics 365 Guides that represents a position and orientation relative to a real-world object in an environment. It provides a common frame of reference that allows to place digital content in the same physical location of a real-world object.</descrip></descripGrp><ntig><termGrp><term id="3101455">object anchor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3101515">àncora d'objecte</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54597_3101456_3101516"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An anchor in Dynamics 365 Guides used to align guide by gazing at a printed QR code anchor that's attached to a physical object in the real world. QR code anchoring is recommended for small to medium-size objects and spaces because it's the most accurate method, and the anchor can be printed at different sizes.</descrip></descripGrp><ntig><termGrp><term id="3101456">QR code anchor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3101516">àncora de codi QR</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54598_3101457_3101517"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in Microsoft Dynamics 365 Remote Assist that enables to capture and annotate a part of the environment during a call. Users can save the snapshot to their mobile device gallery, the in-call text chat, or both.</descrip></descripGrp><ntig><termGrp><term id="3101457">snapshot</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3101517">instantània</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54599_3101458_3101518"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A central building block for creating a guide in Microsoft Dynamics 365 Guides. After creating the structure for guide in the Outline page, Step Editor will need to be used to add instructional text and 3D models or media to support the step.</descrip></descripGrp><ntig><termGrp><term id="3101458">step</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3101518">pas</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54600_3102395_3102564"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft Purview feature that combines the risk scoring and user-activity approach of Insider Risk Management, with the data protection capabilities from Microsoft DLP.</descrip></descripGrp><nti