><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24569_1135487_1147621"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The desktop email program that lets users manage multiple email accounts, newsgroups, and feeds in one place.</descrip></descripGrp><ntig><termGrp><term id="1135487">Windows Live Mail</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1147621">Windows Live Mail</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24586_1136146_1631133"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method of connecting with Remote Assistance that lets people establish a trusted contact list that they can use to connect to a remote computer without having to go through a complex authentication process.</descrip></descripGrp><ntig><termGrp><term id="1136146">Easy Connect</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1631133">Connexió fàcil</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24587_1136147_2612314"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process when one entity authenticates itself to a second entity and the second entity authenticates itself to the first entity. In networking, two routers often perform mutual authentication in order to create a connection.</descrip></descripGrp><ntig><termGrp><term id="1136147">mutual authentication</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2612314">autenticació mútua</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24590_1136151_1995378"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A task page in the Windows Control Panel from where customers can get real-time status information about their network, and also make changes to settings.</descrip></descripGrp><ntig><termGrp><term id="1136151">Network and Sharing Center</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1995378">Centre de xarxes i de recursos compartits</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24594_1136229_1355949"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An area on the user interface where commands and other controls are displayed in functionally related groups.</descrip></descripGrp><ntig><termGrp><term id="1136229">ribbon</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1355949">franja</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</te