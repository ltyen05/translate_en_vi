n</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="380519">expressió d'autorització</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="30755_1536639_2459092"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The open protocol that defines a set of best practices for building and consuming RESTful APIs.</descrip></descripGrp><ntig><termGrp><term id="1536639">Open Data Protocol</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2459092">OData</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="30755_1536640_2459092"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The open protocol that defines a set of best practices for building and consuming RESTful APIs.</descrip></descripGrp><ntig><termGrp><term id="1536640">OData</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2459092">OData</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="30756_1537190_1586204"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The URL where the 