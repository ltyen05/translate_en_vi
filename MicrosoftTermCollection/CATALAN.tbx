ievement that isn't unveiled until it's unlocked.</descrip></descripGrp><ntig><termGrp><term id="2035373">secret achievement</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2543050">assoliment secret</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35486_2035474_2543052"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The game matchmaking system for Xbox One.</descrip></descripGrp><ntig><termGrp><term id="2035474">Smart Match</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2543052">Smart Match</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35487_2035475_2543053"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To open an app in a snapped state or to shift an app to the side of the screen.</descrip></descripGrp><ntig><termGrp><term id="2035475">snap</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2543053">acoblar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35488_2035476_2543062"><langSe