te><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5361_237928_1537184"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The approximate location of one or more resources, such as a person, computer, printer, or asset, in a space plan.</descrip></descripGrp><ntig><termGrp><term id="237928">space</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1537184">espai</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53611_3052168_3053058"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in Outlook that empowers individuals to set up personal appointment booking pages to eliminate the back-and-forth of scheduling 1:1 meetings while still maintaining control of their calendar.</descrip></descripGrp><ntig><termGrp><term id="3052168">Bookings with me</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3053058">Bookings amb mi</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53612_3052180_3053074"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app in Microsoft Teams that allows organizations to create basic check-in forms for a range of processes (end of shift, store evaluations, recurring action items) based off out-of-the-box tools.</descrip></descripGrp><ntig><termGrp><term id="3052180">Updates</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3053074">Actualitzacions</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53613_3052187_3053072"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app that connects business owners with payment providers in Microsoft Teams and helps them receive payments from customers while they register for a webinar and during a meeting.</descrip></descripGrp><ntig><termGrp><term id="3052187">Payments</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3053072">Pagaments</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53614_3052229_3053060"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The free Microsoft-owned domain used by default for some automatic user creation and domain transfer scenarios when the tenant hasn't added a custom domain.</descrip></descripGrp><ntig><termGrp><term id="3052229">fallback domain</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3053060">domini de reserva</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termN