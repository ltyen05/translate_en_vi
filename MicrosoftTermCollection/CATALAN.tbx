ip type="definition">The Office Lens feature that uses voice guidance to help users with visual impairments center objects in the frame of their camera when taking pictures.</descrip></descripGrp><ntig><termGrp><term id="2439288">Frame Guide</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2442466">Guia d'enquadrament</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43060_2505368_2442466"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office Lens feature that uses voice guidance to help users with visual impairments center objects in the frame of their camera when taking pictures.</descrip></descripGrp><ntig><termGrp><term id="2505368">VoiceOver</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2442466">Guia d'enquadrament</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43061_2439289_2442458"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft Graph tool that populates a graph from a set of input entities (documents, people, etc.) and the relationships between them.</descrip></descripGrp><ntig><termGrp><term id="2439289">Sets</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="24