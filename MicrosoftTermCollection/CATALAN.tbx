es.</descrip></descripGrp><ntig><termGrp><term id="143045">grouped controls</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2095054">controls agrupats</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13507_210470_364123"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To remove the hold from an item on SPS that exempts it from being subject to the policy set on the site.</descrip></descripGrp><ntig><termGrp><term id="210470">release hold</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="364123">anul·la la suspensió</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13513_318305_380848"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A scalable, security-enhanced, standards-based solution that centralizes control and management of electronic forms by allowing customers to use a common Web browser to interact with information. It will help streamline organizations forms-driven business processes with existing systems.</descrip></descripGrp><ntig><termGrp><term id="318305">Office Forms Server</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="380848">Microsoft® Office Forms Server</term><termNote type="geographicalUsage">ESP