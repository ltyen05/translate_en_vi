US"><descripGrp><descrip type="definition">A scheduling engine for Project Server that enables automated project updates and scheduling that is similar to that in Project Professional.</descrip></descripGrp><ntig><termGrp><term id="1788192">Project Calculation Service</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1816916">Servei de càlcul de Project</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33514_1791362_2150345"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The stand-alone email filtering service for customers that run Exchange or another messaging solution on-site but use the Exchange Online Protection service that is hosted in the Microsoft cloud environment.</descrip></descripGrp><ntig><termGrp><term id="1791362">Exchange Online Protection</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2150345">Exchange Online Protection</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33514_2925587_2150345"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The stand-alone email filtering service for customers that run Exchange or another messaging solution on-site but use the Exchange Online Protection service that is hosted in the Microsoft cloud environment.</descrip></descripGrp><ntig><termGrp><term id="2925587">EOP</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2150345">Exchange Online Protection</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33520_1791368_2392071"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of transport rules and classification logic that applies specific filtering based on specific regulatory requirements, for example, HIPAA (Health Insurance Portability and Accountability Act).</descrip></descripGrp><ntig><termGrp><term id="1791368">DLP policy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2392071">norma de DLP</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33522_1791370_2001326"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An informative notice displayed to email senders while they’re composing a message that they might be violating a data loss prevention (DLP) policy.</descrip></descripGrp><ntig><termGrp><term id="1791370">policy tip</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2001326">suggeriment de norma</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNot