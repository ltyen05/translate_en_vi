budgeted cost from the total actual cost and then divides that value by the total budgeted cost. This value is then multiplied by 100.</descrip></descripGrp><ntig><termGrp><term id="460679">Cost Increase</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1283622">Augment del cost</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9180_1166144_1166145"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A program that is run automatically when a computer is turned on or booted.</descrip></descripGrp><ntig><termGrp><term id="1166144">bootstrapper</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1166145">programa d'arrencada</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9180_1176951_1166145"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A program that is run automatically when a computer is turned on or booted.</descrip></descripGrp><ntig><termGrp><term id="1176951">boot loader</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1166145">programa d'arrencada</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammat