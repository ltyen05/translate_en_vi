ngSet xml:lang="en-US"><descripGrp><descrip type="definition">The process that populates data to the Office Telemetry Log.</descrip></descripGrp><ntig><termGrp><term id="1707459">Office telemetry logging</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1816970">registre de telemetria de l'Office</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32862_1707461_1816902"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A stylistic variation on a font that provides an alternative to its default appearance.</descrip></descripGrp><ntig><termGrp><term id="1707461">stylistic set</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1816902">conjunt estilístic</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32867_1707634_1722848"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The operating system designed for enthusiasts and business/technical pros that includes all of the features in Windows 8, plus features for encryption, virtualization, PC management, and domain connectivity.</descrip></descripGrp><ntig><termGrp><term id="1707634">Windows 8 Pro</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1722848">Windows 8 Pro</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32868_1707637_1722805"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The operating system for PCs and tablets powered by x86 (32-bit) and AMD (64-bit) processors that includes an updated Windows Explorer, Task Manager, better multi-monitor support, and fast language switching.</descrip></descripGrp><ntig><termGrp><term id="1707637">Windows 8</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1722805">Windows 8</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32869_1707640_1722867"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The operating system only available pre-installed on PCs and tablets powered by ARM processors that helps enable new thin and lightweight form factors with impressive battery life. Windows RT includes touch-optimized versions of Microsoft Word, Excel, PowerPoint, and OneNote.</descrip></descripGrp><ntig><termGrp><term id="1707640">Windows RT</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1722867">Windows RT</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32870_1707648_1722850"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A downloadable pack that adds features to Windows 8 or Windows 8 Single Language editions to move them to a Windows 8 Pro edition with Windows Media Center installed.</descrip></descripGrp><ntig><termGrp><term id="1707648">Windows 8 Pro Pack</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1722850">Windows 8 Pro Pack</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32871_1707658_1722813"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An edition of Windows 8 that is available only through volume licensing.</descrip></descripGrp><ntig><termGrp><term id="1707658">Windows 8 Enterprise</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1722813">Windows 8 Enterprise</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32872_1707665_1722864"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An edition of Windows 8 designed to make Windows affordable to mainstream consumers in emerging markets.</descrip></descripGrp><ntig><termGrp><term id="1707665">Windows 8 Single Language</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1722864">Windows 8 Single Language</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32873_1708234_1722843"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A media pack add-on to Windows 8 Pro that upgrades the edition to include Windows Media Center.</descrip></descripGrp><ntig><termGrp><term id="1708234">Windows 8 Media Center Pack</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1722843">Windows 8 Media Center Pack</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32878_1709112_1760437"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The button or slider on tablets and convertible tablets that rotates the display.</descrip></descripGrp><ntig><termGrp><term id="1709112">rotation lock button</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1760437">botó de blocatge del gir</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32879_1709128_1816895"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Exchange mailbox that is associated with a SharePoint site, enabling users to access documents and email related to group projects through either Outlook or SharePoint.</descrip></descripGrp><ntig><termGrp><term id="1709128">site mailbox</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1816895">bústia del lloc</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32884_1710098_1722852"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An edition of Windows 8 Pro that contains Windows Media Center.</descrip></descripGrp><ntig><termGrp><term id="1710098">Windows 8 Pro with Media Center</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1722852">Windows 8 Pro amb el Media Center</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32885_1713270_1816820"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in the PowerPivot add-in for Excel that identifies the categories of data in your Excel workbook (such as cities, sports teams, or animals), sends those data categories online to Microsoft, and recommends other sets of similar data that might interest you.</descrip></descripGrp><ntig><termGrp><term id="1713270">Microsoft Data Categorization and Recommendation Service</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1816820">Servei de categorització i recomanació de dades de Microsoft</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32885_1713270_1816877"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in the PowerPivot add-in for Excel that identifies the categories of data in your Excel workbook (such as cities, sports teams, or animals), sends those data categories online to Microsoft, and recommends other sets of similar data that might interest you.</descrip></descripGrp><ntig><termGrp><term id="1713270">Microsoft Data Categorization and Recommendation Service</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1816877">Servei de recomanació</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32885_1781372_1816820"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in the PowerPivot add-in for Excel that identifies the categories of data in your Excel workbook (such as cities, sports teams, or animals), sends those data categories online to Microsoft, and recommends other sets of similar data that might interest you.</descrip></descripGrp><ntig><termGrp><term id="1781372">Recommendation Service</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1816820">Servei de categorització i recomanació de dades de Microsoft</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32885_1781372_1816877"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in the PowerPivot add-in for Excel that identifies the categories of data in your Excel workbook (such as cities, sports teams, or animals), sends those data categories online to Microsoft, and recommends other sets of similar data that might interest you.</descrip></descripGrp><ntig><termGrp><term id="1781372">Recommendation Service</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1816877">Servei de recomanació</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32886_1713361_1816695"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Authenticated access that can be granted to external partners and clients to enable sharing of selected SharePoint Online content.</descrip></descripGrp><ntig><termGrp><term id="1713361">external access</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1816695">accés extern</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32887_1713362_1816794"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A unique link that provides external users anonymous access to selected documents stored in SharePoint Online, with no sign in required.</descrip></descripGrp><ntig><termGrp><term id="1713362">guest link</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1816794">enllaç de convidat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32888_1713387_1816915"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables rich visualizations for interactive data exploration, presentation and reporting in SharePoint and Excel.</descrip></descripGrp><ntig><termGrp><term id="1713387">Power View</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1816915">Power View</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32893_1713523_1722862"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The release candidate release of the Windows 8 operating system.</descrip></descripGrp><ntig><termGrp><term id="1713523">Windows 8 Release Preview</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1722862">Windows 8 Release Preview</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32895_1713527_1749326"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An automated proactive scan that triggers when NTFS detects a corruption. The scan is equivalent to the scan phase of chkdsk and finds and logs all corruptions to an internal file. This scan runs during maintenance hours, can be triggered from the Explorer, or manually run from a command line. When this scan is running in the background, some NTFS operations may be blocked.</descrip></descripGrp><ntig><termGrp><term id="1713527">Proactive Scanner</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1749326">Exploració proactiva</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32896_1713528_1749317"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A registry setting that allows the DHCP client to transmit more messages to the server to obtain an IP address when the PC is in connected standby mode. This setting can increase power consumption but can also help resolve IP address (IPv4 or IPv6) problems more quickly.</descrip></descripGrp><ntig><termGrp><term id="1713528">aggressive address acquisition retry</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1749317">reintent d'adquisició agressiva de l'adreça</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32897_1713529_1749320"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A service within Remote Desktop Services responsible for aggregating RemoteApp programs and desktops that are published to end users from across the entire deployment. It ensure only users with appropriate rights can access published resources. The resources are used to display error messages that, for example, might say that the publishing service is unavailable. This can help the admin debug their deployment.</descrip></descripGrp><ntig><termGrp><term id="1713529">Central Publishing service</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1749320">servei de Publicació central</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32899_1713532_1749324"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The capability to sign in to a PC by using a four-digit code.</descrip></descripGrp><ntig><termGrp><term id="1713532">PIN sign-in</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1749324">inici de sessió amb PIN</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3290_142330_1550680"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A color that that is currently selected for drawing or displaying text on the screen.</descrip></descripGrp><ntig><termGrp><term id="142330">foreground color</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1550680">color de primer pla</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32900_1713533_1749331"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A software setting that disables display rotation.</descrip></descripGrp><ntig><termGrp><term id="1713533">rotation lock</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1749331">blocatge del gir</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32900_1713533_2079102"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A software setting that disables display rotation.</descrip></descripGrp><ntig><termGrp><term id="1713533">rotation lock</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2079102">blocatge de rotació</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32907_1718118_1816952"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Collectively, the SharePoint service applications that write to ULS logs using shared code for automated document processing.</descrip></descripGrp><ntig><termGrp><term id="1718118">Office Automation Services</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1816952">Serveis d'automatització de l'Office</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32908_1718119_1816845"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An instrumentation and logging platform that provides monitoring, reporting and log viewing capabilities for Office servers and services.</descrip></descripGrp><ntig><termGrp><term id="1718119">ULS</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1816845">ULS</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32908_1718119_1816848"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An instrumentation and logging platform that provides monitoring, reporting and log viewing capabilities for Office servers and services.</descrip></descripGrp><ntig><termGrp><term id="1718119">ULS</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1816848">Servei de registre unificat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32908_1722438_1816845"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An instrumentation and logging platform that provides monitoring, reporting and log viewing capabilities for Office servers and services.</descrip></descripGrp><ntig><termGrp><term id="1722438">Unified Logging Service</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1816845">ULS</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32908_1722438_1816848"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An instrumentation and logging platform that provides monitoring, reporting and log viewing capabilities for Office servers and services.</descrip></descripGrp><ntig><termGrp><term id="1722438">Unified Logging Service</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1816848">Servei de registre unificat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32909_1718122_1816674"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application-hosting architecture that relies on cloud-based services. Application logic and data are typically hosted on a distributed set of services on the Internet, connected through web APIs, and authenticated with server-to-server authentication technologies such as OAuth.</descrip></descripGrp><ntig><termGrp><term id="1718122">Cloud App Model</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1816674">Model d'aplicació del núvol</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32925_1718267_1816908"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A menu item that lets the user open a document using a different application than the one associated with the document type.</descrip></descripGrp><ntig><termGrp><term id="1718267">Open with</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1816908">Obre-ho amb</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3293_83637_1136676"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">On a Web page, a grouping of hyperlinks for getting around in that particular Web site.</descrip></descripGrp><ntig><termGrp><term id="83637">navigation bar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1136676">barra de navegació</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32930_1719344_2000807"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Data that shows how products are used including where, how often, with which other software and hardware. This data is used to identify user needs and experiences as well as potential marketing and product improvement opportunities over time. Partners and Microsoft can better understand what happens between planning, lab testing, sales data, and real world scenarios over time.</descrip></descripGrp><ntig><termGrp><term id="1719344">telemetry</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2000807">telemetria</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32930_1719344_2000808"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Data that shows how products are used including where, how often, with which other software and hardware. This data is used to identify user needs and experiences as well as potential marketing and product improvement opportunities over time. Partners and Microsoft can better understand what happens between planning, lab testing, sales data, and real world scenarios over time.</descrip></descripGrp><ntig><termGrp><term id="1719344">telemetry</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2000808">dades de telemetria</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32930_1719344_2791101"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Data that shows how products are used including where, how often, with which other software and hardware. This data is used to identify user needs and experiences as well as potential marketing and product improvement opportunities over time. Partners and Microsoft can better understand what happens between planning, lab testing, sales data, and real world scenarios over time.</descrip></descripGrp><ntig><termGrp><term id="1719344">telemetry</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2791101">dades de diagnòstic</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32930_1998703_2000807"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Data that shows how products are used including where, how often, with which other software and hardware. This data is used to identify user needs and experiences as well as potential marketing and product improvement opportunities over time. Partners and Microsoft can better understand what happens between planning, lab testing, sales data, and real world scenarios over time.</descrip></descripGrp><ntig><termGrp><term id="1998703">telemetry data</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><