p><descrip type="definition">A minimum or starting point used for comparisons.</descrip></descripGrp><ntig><termGrp><term id="2819451">baseline</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2822414">referència</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49871_2819453_2822445"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A summary page in Microsoft 365 admin center showing all scores for your organization side by side.</descrip></descripGrp><ntig><termGrp><term id="2819453">score overview</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2822445">informació general de la puntuació</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49872_2819454_2822444"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A subcategory within a larger score such as Security Score, Compliance Score, Productivity Score, or User Experience Score.</descrip></descripGrp><ntig><termGrp><term id="2819454">score category</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2822444">categoria de puntuació</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</ter