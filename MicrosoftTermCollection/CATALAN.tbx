_3056788_3060765"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In programming, pertaining to a development method that uses a drag-and-drop approach and requires basic knowledge of coding to finish the building and deploying process.</descrip></descripGrp><ntig><termGrp><term id="3056788">low-code</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3060765">amb poc codi</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53691_3056788_3095041"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In programming, pertaining to a development method that uses a drag-and-drop approach and requires basic knowledge of coding to finish the building and deploying process.</descrip></descripGrp><ntig><termGrp><term id="3056788">low-code</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3095041">de poc codi</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53692_3056798_3057818"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In gaming, a method by which games just read and write from their desired save directory, using the standard Win32 file IO APIs, and synchronization is handled automatically.</descrip></descripGrp><ntig><termGrp><term id="3056798">cloud save</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3057818">desament al núvol</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53693_3056864_3057584"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that launches the ink editing experience in Word, allowing the users to edit documents with ink gestures.</descrip></descripGrp><ntig><termGrp><term id="3056864">Action Pen</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3057584">Llapis d'accions</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53694_3056893_3057598"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An operational setup designed to meet both the physical and technological needs of a business and its workers.</descrip></descripGrp><ntig><termGrp><term id="3056893">modern workplace</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3057598">àrea de treball moderna</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53695_3056894_3057592"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The sc