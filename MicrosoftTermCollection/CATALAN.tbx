rmGrp><term id="81482">module</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2686247">mòdul</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8861_397221_411538"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To add a database, either a blank database or a copy of the production database, to the storage group copy. This becomes the baseline database for the passive copy of the storage group.</descrip></descripGrp><ntig><termGrp><term id="397221">seed</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="411538">propagar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8869_87023_1546166"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A network status that indicates a client is not connected to a server.</descrip></descripGrp><ntig><termGrp><term id="87023">offline</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1546166">fora de línia</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8884_135175_2095225"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A field data type you use for fields that will contain only one of two values, such as Yes or No and True or False. Null values are not allowed.</descrip></descripGrp><ntig><termGrp><term id="135175">Yes/No data type</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2095225">tipus de dades Sí/No</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8885_210477_364129"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A floating task pane that allows users to view and customize specific paragraph and text style properties.</descrip></descripGrp><ntig><termGrp><term id="210477">style inspector</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="364129">inspector d'estils</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8887_62829_2095055"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file format that can be viewed using a Web browser. With this file format, you can publish your reports directly to your Intranet or web site.</descrip></descripGrp><ntig><termGrp><term id="62829">HTML file</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2095055">fitxer HTML</t