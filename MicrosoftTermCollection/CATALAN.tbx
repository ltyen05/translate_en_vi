mNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52733_2956711_2957166"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Denoting different kinds of mutual relation, often with reference to the substitution of reciprocals for given quantities.</descrip></descripGrp><ntig><termGrp><term id="2956711">reciprocal</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2957166">recíproc</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52734_2956714_2957154"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To subject to the operation of finding the integral of a function.</descrip></descripGrp><ntig><termGrp><term id="2956714">Integrate</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2957154">integrar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52735_2956715_2957145"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The largest positive integer that is a factor/divisor of each of a given set of integers.</descrip></descripGrp><ntig><termGrp><term id="2956715">greatest common factor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp><