348"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A state of having different changes made to the same document in multiple locations that can prevent the document from being saved until they are reconciled.</descrip></descripGrp><ntig><termGrp><term id="2753781">page conflict</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2755348">conflicte de pàgina</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48679_2753782_2755325"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A total amount of time spent at work emailing, in meetings, and on chats or calls.</descrip></descripGrp><ntig><termGrp><term id="2753782">collaboration time</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2755325">temps de col·laboració</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48681_2753810_2764308"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that shows what you selected in a slicer.</descrip></descripGrp><ntig><termGrp><term id="2753810">filter restatement</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2764308">redefinició de filtres</term><termNote type="geographicalUsage">ESP</termNote><termNote type="par