>ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2376719">Carta d'autorització</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41912_2372260_2376721"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A telephone number to which all of a customer phone numbers are charged in a consolidated telephone phone bill, instead of showing charges under each telephone number. Also called billed telephone number.</descrip></descripGrp><ntig><termGrp><term id="2372260">billing telephone number</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2376721">número de telèfon de facturació</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41913_2372261_2376718"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process of taking the phone numbers you currently have with a telephone service provider or carrier and transferring those numbers over to different provider.</descrip></descripGrp><ntig><termGrp><term id="2372261">number porting</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2376718">portabilitat del número</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termN