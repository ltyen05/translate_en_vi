</ntig></langSet></termEntry><termEntry id="14749_397190_411310"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process by which Exchange Server creates and updates the OAB. Administrators can define when the OAB generation process will run.</descrip></descripGrp><ntig><termGrp><term id="397190">OAB generation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="411310">generació de l'OAB</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14749_397190_411314"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process by which Exchange Server creates and updates the OAB. Administrators can define when the OAB generation process will run.</descrip></descripGrp><ntig><termGrp><term id="397190">OAB generation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="411314">generació de llibretes d'adreces sense connexió</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14755_375732_380504"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An SMTP namespace for which Microsoft an Exchange Server organization sends and receives email.</descrip></descripGrp><ntig><termGrp><term id="375732">accepted domain</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><