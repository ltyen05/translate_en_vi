termGrp></ntig></langSet></termEntry><termEntry id="2755_550_1547498"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A chunk of data that a Web server sends to a browser, which in turn saves it and sends it back when accessing the Web server again.</descrip></descripGrp><ntig><termGrp><term id="550">cookie</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1547498">galeta</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2755_550_2169376"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A chunk of data that a Web server sends to a browser, which in turn saves it and sends it back when accessing the Web server again.</descrip></descripGrp><ntig><termGrp><term id="550">cookie</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2169376">galetes</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27555_1381690_1517242"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A website or service that a customer can connect to in order to share what they've been doing on other websites, see their friends and their updates from other services in Windows Live, or share their Windows Live activity on other websites.</descrip></descripGrp><ntig><termGrp><term id="1381690">service</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1517242">servei</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27556_1381691_1383470"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A service that a user has connected to Windows Live.</descrip></descripGrp><ntig><termGrp><term id="1381691">connected service</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1383470">servei connectat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27578_1385957_1411828"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that allows users to navigate directly to the webpage of the top-ranked search result when a search is performed in the address bar.</descrip></descripGrp><ntig><termGrp><term id="1385957">Address Bar Top Result</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1411828">resultat principal de la barra d'ubicació</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27584_1387192_1744155"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The return to a customer's account of fund