Set><langSet xml:lang="ca"><ntig><termGrp><term id="2542986">bateria</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34418_1991528_2917403"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The controller battery charger that powers the controller battery while in use.</descrip></descripGrp><ntig><termGrp><term id="1991528">Xbox 360 Play &amp; Charge Kit</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2917403">Equip Carrega i juga Xbox 360</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34419_1991529_2913468"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The audio speaker on the headset.</descrip></descripGrp><ntig><termGrp><term id="1991529">earpiece</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2913468">auricular</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34420_1991530_2913910"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The cable attached to the headset.</descrip></descripGrp><ntig><termGrp><term id="1991530">headset cable</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2913910">cable d'auriculars</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34421_1991531_2913911"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The button on the wireless headset used to make a permanent attachment between the headset and console. Connect button acceptable.</descrip></descripGrp><ntig><termGrp><term id="1991531">headset connect button</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2913911">botó de connexió dels auriculars</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34422_1991532_2913913"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The connector at the end of the headset cable.</descrip></descripGrp><ntig><termGrp><term id="1991532">headset connector</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2913913">connector dels auriculars</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34423_1991533_2915899"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The muting control on the headset.</descrip></descripGrp><ntig><termGrp><term id="1991533">mute button</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2915899">botó de silenci</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34424_1991534_2917199"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The volume dial on the headset.</descrip></descripGrp><ntig><termGrp><term id="1991534">volume control</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2917199">control del volum</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34425_1991535_2917394"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Xbox 360 wired audio headset.</descrip></descripGrp><ntig><termGrp><term id="1991535">Xbox 360 Headset</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2917394">Auriculars Xbox 360</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34426_1991536_2917312"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Xbox 360 text input device that attaches to the controller, allowing text communication between players.</descrip></descripGrp><ntig><termGrp><term id="1991536">Xbox 360 Chatpad</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2917312">Chatpad Xbox 360</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34427_1991537_2917396"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Xbox 360 rechargeable audio headset.</descrip></descripGrp><ntig><termGrp><term id="1991537">Xbox 360 Wireless Headset</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2917396">Auriculars sense fil Xbox 360</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34428_1991538_2917417"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Xbox 360 wireless microphone.</descrip></descripGrp><ntig><termGrp><term id="1991538">Xbox 360 Wireless Microphone</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2917417">Micròfon sense fil Xbox 360</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34429_1991539_2917415"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The universal Xbox 360 remote control. Works with the console and can be programmed to be used with your TV.</descrip></descripGrp><ntig><termGrp><term id="1991539">Xbox 360 Universal Media Remote</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2917415">Comandament a distància multimèdia universal Xbox 360</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34430_1991540_2917435"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The system display that appears at start-up, and outside of games, media, etc.</descrip></descripGrp><ntig><termGrp><term id="1991540">Xbox Dashboard</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2917435">Interfície Xbox</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34431_1991541_2917439"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The heads-up display that appears in-game, in-media, etc.</descrip></descripGrp><ntig><termGrp><term id="1991541">Xbox Guide</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2917439">Guia de l'Xbox</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34432_1991542_2913476"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Settings that allow parents/guardians to manage the content allowed on the console.</descrip></descripGrp><ntig><termGrp><term id="1991542">family settings</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2913476">control parental</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34433_1991543_2913409"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The height, weight, year of birth, and gender that a user chooses to enter as their personal physical characteristics for fitness tracking.</descrip></descripGrp><ntig><termGrp><term id="1991543">attributes</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2913409">atributs</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34434_1991544_2913471"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Estimates of the results of your physical activity, including calories burned, time spent playing, and physical intensity of movements.</descrip></descripGrp><ntig><termGrp><term id="1991544">exercise stats</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2913471">estadístiques de l'exercici</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34435_1991545_2913480"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of game that supports the monitoring and recording of exercise stats from a fitness tracking device worn by a player.</descrip></descripGrp><ntig><termGrp><term id="1991545">fitness tracking game</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2913480">joc de seguiment de fitnes</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34436_1991546_2913479"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of device worn during exercise that estimates your exercise stats based on your level of physical activity.</descrip></descripGrp><ntig><termGrp><term id="1991546">fitness tracking device</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2913479">dispositiu de seguiment d'exercici</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34437_1991547_2917141"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A legal notice that describes the properties of the system.</descrip></descripGrp><ntig><termGrp><term id="1991547">system information</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2917141">informació del sistema</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34438_1991548_2213523"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A legal notice that establishes the terms under which service is provided.</descrip></descripGrp><ntig><termGrp><term id="1991548">terms of use</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2213523">condicions d'ús</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34439_1991549_2917131"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A message that applications must display when unable to establish a connection to a required non-Xbox Live server or web service.</descrip></descripGrp><ntig><termGrp><term id="1991549">Sorry, [video service name/web service name] isn't available right now. Please try again later. For more information, go to www.xbox.com/status.</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2917131">[video service name/web service name] no està disponible en aquest moment. Torna a provar-ho més tard. Per obtenir més informació, visita www.xbox.com/status.</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3444_14266_1545901"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To move selected items to another location for long term storage.</descrip></descripGrp><ntig><termGrp><term id="14266">archive</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1545901">arxivar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34440_1991550_2917152"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A message that applications must display when Xbox privacy and online settings prevent the sharing of video status.</descrip></descripGrp><ntig><termGrp><term id="1991550">The Video and Music Status setting for [gamertag1, gamertag2, gamertag3, gamertags4] is set to allow apps to show titles of videos you watch in your Xbox Live online status.</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2917152">El paràmetre Estat de vídeo i música per a [gamertag1, gamertag2, gamertag3, gamertags4] està configurat per permetre que les aplicacions mostrin els títols dels vídeos que vegis en l'estat en línia de l'Xbox Live.</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34441_1991551_2913405"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A message that applications must display if they will serve third-party advertising and cannot contractually guarantee that they will meet the Xbox Creative Acceptance Policy (CAP) for advertising content. The need for this disclaimer will be determined contractually prior to certification, and the inability to comply should be indicated during application submission. Talk to your Developer Account Manager for additional details.</descrip></descripGrp><ntig><termGrp><term id="1991551">All content in this Application, including advertising content, is provided by [video service name].</term><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2913405">Tot el contingut d'aquesta aplicació, inclòs el contingut publicitari, el proporciona [video service name].</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34442_1991552_2917148"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A message that game titles must display when unable to establish a connection to a required non-Xbox Live server or web service. This message also applies to Xbox games on Windows Phone.</descrip></descripGrp><ntig><termGrp><term id="1991552">The [game name] service is not available. Please try again later.</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2917148">El servei de [game name] no està disponible. Torna a provar-ho més tard.</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34443_1991553_2922121"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Xbox Live Arcade menu item.</descrip></descripGrp><ntig><termGrp><term id="1991553">leaderboards</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2922121">taules de classificació</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34444_1991554_2922104"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Xbox Live Arcade menu item.</descrip></descripGrp><ntig><termGrp><term id="1991554">achievements</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2922104">assoliments</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34445_1991555_2913914"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Xbox Live Arcade menu item.</descrip></descripGrp><ntig><termGrp><term id="1991555">help &amp; options</term><termNote type="partOfSp