ig><termGrp><term id="1676359">documentació</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20463_2666668_761265"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The information provided with a product by a manufacturer describing how to use a product.</descrip></descripGrp><ntig><termGrp><term id="2666668">doc</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761265">documentació d'usuari</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20463_724693_1676359"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The information provided with a product by a manufacturer describing how to use a product.</descrip></descripGrp><ntig><termGrp><term id="724693">user documentation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1676359">documentació</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20463_724693_761265"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The information provided with a product by a manufacturer describing how to use a product.</descrip></descripGrp><ntig><termGrp><term id="724693">user documentation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761265">documentació d'usuari</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20464_724694_761269"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Having no legal effect.</descrip></descripGrp><ntig><termGrp><term id="724694">void</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761269">nul</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20465_724695_761271"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The relinquishment or abandonment of a legal right, or the abstention from asserting it.</descrip></descripGrp><ntig><termGrp><term id="724695">waiver</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761271">renúncia</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20466_724696_761021"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">When referring to a product sold or licensed and when the seller or licensor knows the buyer is purchasing a product or license for a particular purpose, a warranty implied by law that a product is suitable for that purpose.</descrip></descripGrp><ntig><termGrp><term id="724696">implied warranty of fitness for a particular purpose</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761021">garantia implícita d'idoneïtat per a una finalitat específica</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20467_724697_761022"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">When referring to a product sold or licensed, a warranty implied by law that the product meets the standard of quality that would be reasonably expected by a consumers and persons in that trade i.e. that it is fit for the ordinary purpose for which such goods are used.</descrip></descripGrp><ntig><termGrp><term id="724697">implied warranty of merchantability</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761022">garantia implícita de comerciabilitat o idoneïtat per a una finalitat específica</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20468_724698_761274"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">When referring to a product sold or licensed, a warranty that the product does not violate any intellectual property right.</descrip></descripGrp><ntig><termGrp><term id="724698">warranty of non-infringement</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761274">garantia d'absència d'infracció</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20469_724699_761023"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">When referring to a product sold or licensed, a warranty implied by law that the product will meet a standard that any reasonable person would consider as satisfactory.</descrip></descripGrp><ntig><termGrp><term id="724699">implied warranty of satisfactory quality</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761023">garantia implícita de qualitat satisfactòria</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20470_724700_761275"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">When referring to a product sold or licensed, a warranty that the seller or licensor has title to the product.</descrip></descripGrp><ntig><termGrp><term id="724700">warranty of title</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761275">garantia de titularitat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20471_724701_761276"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A service provided via the World Wide Web.</descrip></descripGrp><ntig><termGrp><term id="724701">web-based service</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761276">servei basat en web</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20472_724702_761279"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">When referring to taxation, to deduct funds from salary or other income to cover tax liability.</descrip></descripGrp><ntig><termGrp><term id="724702">withhold</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761279">retenir</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20473_724703_761283"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A notice provided in written format (sometimes includes email format).</descrip></descripGrp><ntig><termGrp><term id="724703">written notice</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761283">avís escrit</term><termNote type="geographicalUsage">ESP</ter