langSet xml:lang="ca"><ntig><termGrp><term id="1550773">empaperat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12505_131084_2145116"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In a graphical user interface such as Windows, a pattern or picture in the screen background that can be chosen by the user.</descrip></descripGrp><ntig><termGrp><term id="131084">wallpaper</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2145116">fons de pantalla</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1251_52930_1548117"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An orientation of printed paper where the printed side is against a surface. For example, paper is face down when it is placed in a copier with the printed side against the copying surface.</descrip></descripGrp><ntig><termGrp><term id="52930">face down</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1548117">cara avall</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12512_537628_1245010"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A component registered with ASP.NET (typically with an .axd extension) that produces Web output dynamically.</descrip></descripGrp><ntig><termGrp><term id="537628">HTTP handler</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1245010">gestor d'HTTP</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12515_464494_2723275"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To block access to a program or operating system functionality.</descrip></descripGrp><ntig><termGrp><term id="464494">restrict</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2723275">restringir</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12520_1296_1555373"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A member of the TCP/IP suite of protocols, used to copy files between two computers on the Internet. Both computers must support their respective FTP roles: one must be an FTP client and the other an FTP server.</descrip></descripGrp><ntig><termGrp><term id="1296">File Transfer Protocol</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1555373">FTP</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12520_1296_2145150"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A member of the TCP/IP suite of protocols, used to copy files between two computers on the Internet. Both computers must support their respective FTP roles: one must be an FTP client and the other an FTP server.</descrip></descripGrp><ntig><termGrp><term id="1296">File Transfer Protocol</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2145150">protocol per compartir arxius</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12520_1297_1555373"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A member of the TCP/IP suite of protocols, used to copy files between two computers on the Internet. Both computers must support their respective FTP roles: one must be an FTP client and the other an FTP server.</descrip></descripGrp><ntig><termGrp><term id="1297">FTP</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1555373">FTP</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12520_1297_2145150"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A member of the TCP/IP suite of protocols, used to copy files between two computers on the Internet. Both computers must support their respective FTP roles: one must be an FTP client and the other an FTP server.</descrip></descripGrp><ntig><termGrp><term id="1297">FTP</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2145150">protocol per compartir arxius</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12524_73352_1143807"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of binaries that can be installed on top of the core product and enables users to select a preferred language so that the user interface and Help files appear in that preferred language.</descrip></descripGrp><ntig><termGrp><term id="73352">language pack</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1143807">paquet de llengua</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12530_262704_1550787"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A common programming interface to the lower-level system area network (SAN) implementations, developed by Microsoft. WSD sits underneath the standard WinSock application programming interface (API), but bypasses the kernel networking layers to talk directly to the SAN hardware. Because WSD sits underneath the existing WinSock API, IT departments can deploy applications in a SAN environment without modifying the applications.</descrip></descripGrp><ntig><termGrp><term id="262704">WinSock direct</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1550787">WSD</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12530_262705_1550787"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A common programming interface to the lower-level system area network (SAN) implementations, developed by Microsoft. WSD sits underneath the standard WinSock application programming interface (API), but bypasses the kernel networking layers to talk directly to the SAN hardware. Because WSD sits underneath the existing WinSock API, IT departments can deploy applications in a SAN environment without modifying the applications.</descrip></descripGrp><ntig><termGrp><term id="262705">WSD</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1550787">WSD</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12537_95084_1770076"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A sequence of declarations and statements that are executed as a unit.</descrip></descripGrp><ntig><termGrp><term id="95084">procedure</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1770076">procediment</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12539_346969_1550754"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An electronic system of transmitting transient images of fixed or moving objects together with sound through space by an apparatus that converts light and sound into electrical waves and reconverts them into visible light rays and audible sound.</descrip></descripGrp><ntig><termGrp><term id="346969">TV</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1550754">TV</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12539_346969_1770107"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An electronic system of transmitting transient images of fixed or moving objects together with sound through space by an apparatus that converts light and sound into electrical waves and reconverts them into visible light rays and audible sound.</descrip></descripGrp><ntig><termGrp><term id="346969">TV</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1770107">televisió</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12539_346970_1550754"><langSet xml:lang="en-US"><descr