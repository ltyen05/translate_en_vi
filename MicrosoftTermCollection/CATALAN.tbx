">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39003_2267586_2268448"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To withdraw from the role access rights and return back to the normal state of no access rights of this role.</descrip></descripGrp><ntig><termGrp><term id="2267586">deactivate</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2268448">desactivar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39007_2267722_2268392"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The version of OneNote that runs on iPad, iPhone and iPod touch.</descrip></descripGrp><ntig><termGrp><term id="2267722">OneNote for iPad, iPhone and iPod touch</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2268392">OneNote per a l'iPad, l'iPhone i l'iPod touch</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39012_2268334_2269761"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Cellular data that customers can buy from the Windows Store to connect to their Windows device.</descrip></descripGrp><ntig><termGrp><term id="2268334">paid cellular data</term><termNot