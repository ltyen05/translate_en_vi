ra onto profile-related UI for profiles signed in with an Entra ID account.</descrip></descripGrp><ntig><termGrp><term id="3153852">organization branding</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3154096">marca de l'organització</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56088_3153853_3154094"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that, based on a prompt entered by the user, creates custom images formatted as an Edge theme.</descrip></descripGrp><ntig><termGrp><term id="3153853">custom theme</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3154094">tema personalitzat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56089_3153855_3154098"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables the user, when writing in the browser, to use generative AI to reword their written text.</descrip></descripGrp><ntig><termGrp><term id="3153855">rewrite</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3154098">reescriptura</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNot