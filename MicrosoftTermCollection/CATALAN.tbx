n</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2094758">codi de caràcter</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13049_641047_2094758"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A numeric value that corresponds to a particular character in a set.</descrip></descripGrp><ntig><termGrp><term id="641047">code point</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2094758">codi de caràcter</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13054_144059_1143864"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A control on a form, that repeats as needed, into which users can enter text. The control can be formatted as a bulleted, numbered, or plain list.</descrip></descripGrp><ntig><termGrp><term id="144059">list control</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1143864">control de les llistes</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13064_375736_380520"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A custom word or phrase that the administrator sets for the Content Filter agent to prevent email messages that contain specific words or phrases from being delivered to Exchange Server 2007 mailbox users.</descrip></descripGrp><ntig><termGrp><term id="375736">Block phrase</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="380520">expressió de bloqueig</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13070_292970_2715587"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A form of authentication delegation in which Kerberos can be used to impersonate users that send requests for certain services, as opposed to all services.</descrip></descripGrp><ntig><termGrp><term id="292970">Kerberos constrained delegation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2715587">delegació limitada de kerberos</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13076_1486351_1143865"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A sequence of words or other text used to gain access to a network, program, or data. A passphrase is generally longer for added security.</descrip></descripGrp><ntig><termGrp><term id="1486351">pass phrase</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"