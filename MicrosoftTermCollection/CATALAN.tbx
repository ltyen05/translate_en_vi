ermNote></termGrp></ntig></langSet></termEntry><termEntry id="20353_724575_761017"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The legislative statement of all the private, non-commercial law in effect in Hungary.</descrip></descripGrp><ntig><termGrp><term id="724575">Hungarian Civil Code</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761017">Codi Civil Hongarès</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20354_724576_761018"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to something prohibited by law.</descrip></descripGrp><ntig><termGrp><term id="724576">illegal</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761018">il·legal</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20355_724577_761020"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A warranty that is not explicitly agreed to by the parties but is automatically imposed by the operation of law, i.e. by a statute or by a court to implement the intent of the parties.</descrip></descripGrp><ntig><termGrp><term id="724577">implied warranty</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761020">garantia implícita</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20356_724578_761025"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In an honest and truthful way.</descrip></descripGrp><ntig><termGrp><term id="724578">in good faith</term><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761025">de bona fe</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20358_724580_761029"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The set of standard trade definitions used in international sales contracts devised and published by the International Chamber of Commerce.</descrip></descripGrp><ntig><termGrp><term id="724580">INCOTERMS 2000</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761029">INCOTERMS 2000</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20359_724581_761030"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An individual or entity that does not have an employment contract (and is not an employee), but rather has a contract for service where he/she/it is entrusted to carry out a specific project.</descrip></descripGrp><ntig><termGrp><term id="724581">independent contractor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761030">contractista independent</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20360_724582_761032"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">When referring to Microsoft Volume Licensing Programs, an enrollment that is entered into between Microsoft and the Customer but where the licenses are paid for through a distribution channel involving a reseller which purchases and resells the licenses.</descrip></descripGrp><ntig><termGrp><term id="724582">indirect enrollment</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761032">inscripció indirecta</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20361_724583_761033"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">When referring to intellectual property, to violate an intellectual property right (such as copyright, trademark or patent).</descrip></descripGrp><ntig><termGrp><term id="724583">infringe</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761033">infringir</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20362_724584_761036"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">When referring to Microsoft Volume Licensing Programs, the length of time a new agreement or enrollment stays in effect before its renewal or replacement by a new agreement (often for three years).</descrip></descripGrp><ntig><termGrp><term id="724584">initial term</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761036">període de vigència inicial</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20362_724584_761037"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">When referring to Microsoft Volume Licensing Programs, the length of time a new agreement or enrollment stays in effect before its renewal or replacement by a new agreement (often for three years).</descrip></descripGrp><ntig><termGrp><term id="724584">initial term</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761037">període inicial</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20363_724585_761038"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A remedy in the form of a court order that either requires or forbids a certain action to be carried out (or forbids the continuation of an action).</descrip></descripGrp><ntig><termGrp><term id="724585">injunctive relief</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761038">mesures cautelars</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20364_724586_761042"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">When referring to a Microsoft licensing agreement, an inspection carried out by a customer of its own compliance with the requirements of the license agreement.</descrip></descripGrp><ntig><termGrp><term id="724586">internal audit</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761042">auditoria interna</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20365_724587_761043"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An international organization that works to promote global trade and investment.</descrip></descripGrp><ntig><termGrp><term id="724587">International Chamber of Commerce</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761043">Càmbra de Comerç Internacional</term><termNote type="geographicalUsage">ESP</termNote><te