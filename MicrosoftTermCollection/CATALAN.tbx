/termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2368715">estructura del desglossament del treball</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1611_184157_364174"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A form in which two views are displayed at the same time. These are synched so that as your focus moves in one view it is changed automatically in the other view.</descrip></descripGrp><ntig><termGrp><term id="184157">split form</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="364174">formulari dividit</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16113_2794716_1547569"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A uniquely-named collection of computers in a networked environment that share a common database, directory database, or tree and that is administered as a unit with common rules and procedures, which can include security policies.</descrip></descripGrp><ntig><termGrp><term id="2794716">network domain</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1547569">domini</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16113_47604_1547569"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A uniquely-named collection of computers in a networked environment that share a common database, directory database, or tree and that is administered as a unit with common rules and procedures, which can include security policies.</descrip></descripGrp><ntig><termGrp><term id="47604">domain</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1547569">domini</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16114_530294_2520706"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A flat board made of nonconducting material, such as plastic or fiberglass where chips and other electronic components are mounted, usually in predrilled holes. The component holes are connected electrically by predefined conductive metal pathways that are printed on the surface of the board. The metal leads protruding from the electronic components are soldered to the conductive metal pathways to form a connection.</descrip></descripGrp><ntig><termGrp><term id="530294">printed circuit board</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2520706">placa de circuit imprès</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16114_530295_2520706"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A flat board made of nonconducting material, such as plastic or fiberglass where chips and other electronic components are mounted, usually in predrilled holes. The component holes are connected electrically by predefined conductive metal pathways that are printed on the surface of the board. The metal leads protruding from the electronic components are soldered to the conductive metal pathways to form a connection.</descrip></descripGrp><ntig><termGrp><term id="530295">PCB</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2520706">placa de circuit imprès</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16117_347943_1098371"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group that is associated with another group so that their properties and the properties of the groups and fields they contain always match. If the properties of one group are changed, the other group is updated automatically.</descrip></descripGrp><ntig><termGrp><term id="347943">reference group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1098371">grup de referència</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16119_329894_1143936"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A request for payment for products and/or services sold.</descrip></descripGrp><ntig><termGrp><term id="329894">bill</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1143936">factura</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1612_111004_2954461"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file-sharing protocol designed to allow networked computers to transparently access files that reside on remote systems over a variety of networks. The SMB protocol defines a series of commands that pass information between computers. SMB uses four message types: session control, file, printer, and message.</descrip></descripGrp><ntig><termGrp><term id="111004">Server Message Block</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2954461">SMB</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1612_111004_2954547"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file-sharing protocol designed to allow networked computers to transparently access files that reside on remote systems over a variety of networks. The SMB protocol defines a series of commands that pass information between computers. SMB uses four message types: session control, file, printer, and message.</descrip></descripGrp><ntig><termGrp><term id="111004">Server Message Block</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</ter