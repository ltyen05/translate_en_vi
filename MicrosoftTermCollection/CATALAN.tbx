ine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4042_464491_1649943"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A website from Microsoft which provides updates (patches and fixes) for multiple Microsoft products in one place, including Windows operating system software and Windows-based hardware, Microsoft Office system, Microsoft SQL Server, and Microsoft Exchange Server.</descrip></descripGrp><ntig><termGrp><term id="464491">Microsoft Update</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1649943">Microsoft Update</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40423_2347704_2349294"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A request for response based on the French, Répondez s’il vous plaît.</descrip></descripGrp><ntig><termGrp><term id="2347704">RSVP</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2349294">sol·licitud de resposta</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4043_3317_2437256"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The name by which a client uniquely identifies an instance of a service. It is usually built from the DNS name of the host. The SPN is used in the process of mutual authentication between the client and the server hosting a particular service.</descrip></descripGrp><ntig><termGrp><term id="3317">service principal name</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2437256">nom d'entitat de seguretat de servei</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4043_3318_2437256"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The name by which a client uniquely identifies an instance of a service. It is usually built from the DNS name of the host. The SPN is used in the process of mutual authentication between the client and the server hosting a particular service.</descrip></descripGrp><ntig><termGrp><term id="3318">SPN</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2437256">nom d'entitat de seguretat de servei</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40430_2347754_2348551"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The service plan offer covering domestic calls as part of the PSTN Calling service in Office 365.</descrip></descripGrp><ntig><termGrp><term id="2347754">Skype for Business PSTN Domestic Calling</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2348551">Trucades XTC nacionals de Skype for Business</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40431_2347755_2348552"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The service plan offer covering international calls as part of the PSTN Calling service in Office 365.</descrip></descripGrp><ntig><termGrp><term id="2347755">Skype for Business PSTN International Calling</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2348552">Trucades XTC internacionals de Skype for Business</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40432_2347756_2348550"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The service plan offer covering domestic and international calls as part of the PSTN Calling service in Office 365.</descrip></descripGrp><ntig><termGrp><term id="2347756">Skype for Business PSTN Domestic and International Calling</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2348550">Trucades XTC nacionals i internacionals de Skype for Business</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40433_2348753_2348835"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The agent for personal or enterprise use to keep data fresh by connecting to on-premises data sources.</descrip></descripGrp><ntig><termGrp><term id="2348753">Power BI Gateway</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2348835">Power BI Gateway</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40434_2348755_2348836"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The enterprise version of Power BI Gateway that enables IT departments to deploy, configure, manage and maintain a group of central gateways to serve a large group of users instead of having each employee install and configure a Power BI Gateway - Personal and transparently refresh data uploaded to Power BI for users requiring up-to-date data, with direct query support to SQL Server.</descrip></descripGrp><ntig><termGrp><term id="2348755">Power BI Gateway - Enterprise</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2348836">Power BI Gateway - Enterprise</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40435_2348758_2348834"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The client agent that enables Power BI to connect to on-premises SQL Server Analysis Services instances and author interactive reports and dashboards based on role membership on that instance.</descrip></descripGrp><ntig><termGrp><term id="2348758">Power BI Analysis Services Connector</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2348834">Power BI Analysis Services Connector</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40436_2349281_2351938"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A menu item showing hearts (number of likes) for a given chat message. The heart-feature refers to giving and removing hearts and is distinct from the Like-feature known from e.g. Facebook.</descrip></descripGrp><ntig><termGrp><term id="2349281">Show likes</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2351938">Mostra els "M'agrada"</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40438_2349283_2351933"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A menu item connected the heart-feature, whereby a participant can remove a "heart" from a chat message, indicating that the participant does not like a chat message. The heart-feature refers to giving and removing hearts and is distinct from the Like-feature known from e.g. Facebook.</descrip></descripGrp><ntig><termGrp><term id="2349283">Unlike</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2351933">Ja no m'agrada</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40439_2349284_2351930"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An amount of money added to an account.</descrip></descripGrp><ntig><termGrp><term id="2349284">credit</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2351930">crèdit</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40440_2349285_2351935"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A menu item connected the heart-feature, whereby a participant can give a "heart" to a chat message, indicating that the participant likes a chat message. The heart-feature refers to giving and removing hearts and is distinct from the Like-feature known from e.g. Facebook.</descrip></descripGrp><ntig><termGrp><term id="2349285">Like</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2351935">M'agrada</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40441_2349286_2351936"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A list of hearts showing how many particpant have liked a chat message. The heart-feature refers to giving and removing hearts and is distinct from the Like-feature known from e.g. Facebook.</descrip></descripGrp><ntig><termGrp><term id="2349286">Likes</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2351936">M'agrada</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40449_2350535_2422719"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Azure service for virtual machines (VMs) that helps address organizational security and compliance requirements by encrypting the VM boot and data disks with keys and policies that are controlled in Azure Key Vault.</descrip></descripGrp><ntig><termGrp><term id="2350535">Azure Disk Encryption</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2422719">Xifratge de discos de l'Azure</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40449_2901999_2422719"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Azure service for virtual machines (VMs) that helps address organizational security and compliance requirements by encrypting the VM boot and data disks with keys and policies that are controlled in Azure Key Vault.</descrip></descripGrp><ntig><termGrp><term id="2901999">ADE</term><termNote type="partOfSpeech">ProperNoun</termNote><te