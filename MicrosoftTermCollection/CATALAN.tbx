aintaining said infrastructure.</descrip></descripGrp><ntig><termGrp><term id="2748866">platform-as-a-service</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2750212">plataforma com a servei</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33488_1785151_2330313"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The capability of provisioning storage, networks, processing as well as other resources where the user can deploy and run software.</descrip></descripGrp><ntig><termGrp><term id="1785151">infrastructure as a service</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2330313">infraestructura com a servei</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33488_1785154_2330313"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The capability of provisioning storage, networks, processing as well as other resources where the user can deploy and run software.</descrip></descripGrp><ntig><termGrp><term id="1785154">IaaS</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2330313">infraestructura com a servei</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammat