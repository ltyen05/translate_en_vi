_2399526_2405534"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Sway feature that automatically chooses from several caption styles having different layout and visibility, based on the Navigation layout, Group choice, and Style choice.</descrip></descripGrp><ntig><termGrp><term id="2399526">Caption variation</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2405534">Variació del títol</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42415_2399527_2405539"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Sway Caption variation that shows an icon where the user can click to see the caption somewhere on the captioned content.</descrip></descripGrp><ntig><termGrp><term id="2399527">Hidden</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2405539">Amagat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42416_2399528_2405541"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The caption style chosen by Sway Caption variation that shows the caption at the bottom of the captioned content and that expands to show the entire caption with a scroll bar when the content is clicked on.</descrip></descripGrp><ntig><termGrp><term id="2399528">Minimal</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2405541">Minimalista</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42417_2399529_2405543"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The caption style chosen by Sway Caption variation that captions content without covering it and shows the entire caption, with a scroll bar for longer captions.</descrip></descripGrp><ntig><termGrp><term id="2399529">Off-image</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2405543">Fora de la imatge</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42418_2399530_2405550"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that allows users to change text size for an entire document.</descrip></descripGrp><ntig><termGrp><term id="2399530">Text size</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2405550">Mida del text</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42419_2400062_2405549"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Sway drop down menu that provides users with a set of suggested websites and programs from where they can get content.</descrip></descripGrp><ntig><termGrp><term id="2400062">Suggested</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2405549">Suggeriments</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42420_2400063_2405544"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Sway button that allows users to maintain the original size of a Web embed.</descrip></descripGrp><ntig><termGrp><term id="2400063">Original size</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2405544">Mida original</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42422_2400125_2405546"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An entity that can complete work or be used to complete work.</descrip></descripGrp><ntig><termGrp><term id="2400125">resource</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2405546">recurs</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">