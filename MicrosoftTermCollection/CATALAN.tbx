 network.</descrip></descripGrp><ntig><termGrp><term id="1630199">physical topology</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2857325">topologia de xarxa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12934_370788_2857325"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The physical layout of computers, cables, switches, routers, and other components of a network.</descrip></descripGrp><ntig><termGrp><term id="370788">network topology</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2857325">topologia de xarxa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1294_346944_1537145"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A pictorial graphic such as a digital photograph or illustration.</descrip></descripGrp><ntig><termGrp><term id="346944">digital image</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1537145">imatge</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1294_370920_1537145"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A pictorial graphic such as a digital photograph or illustration.</descrip></descripGrp><ntig><termGrp><term id="370920">picture</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1537145">imatge</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1294_64520_1537145"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A pictorial graphic such as a digital photograph or illustration.</descrip></descripGrp><ntig><termGrp><term id="64520">image</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1537145">imatge</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12942_94098_2915924"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A button that turns a device off and on.</descrip></descripGrp><ntig><termGrp><term id="94098">power button</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2915924">botó d'engegada</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12948_182890_1276316"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A compilation of the different measurements that a product is available in. A unit group contains the base unit in which a product is available, for example, a two-liter. It then lists all the different increments that this base unit is packaged in for sale, such as an individual two-liter bottle or a case of 6 two-liter bottles, and also indicates which measurement is the primary unit.</descrip></descripGrp><ntig><termGrp><term id="182890">unit group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1276316">grup d'unitats</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12951_210502_364088"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A gatherer plug-in that is responsible for indexing the anchor text. Anchor text is an important feature in the ranking of the search results in v3.</descrip></descripGrp><ntig><termGrp><term id="210502">anchor plugin</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="364088">connector d'ancoratge</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12954_134044_1098412"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A search technology used to separate text into individual words.</descrip></descripGrp><ntig><termGrp><term id="134044">word breaker</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1098412">separador de paraules</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12958_1060966_1097879"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To activate something making it available for use.</descrip></descripGrp><ntig><termGrp><term id="1060966">turn on</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1097879">activar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12958_1060966_1537173"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To activate something making it available for use.</descrip></descripGrp><ntig><termGrp><term id="1060966">turn on</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1537173">habilitar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12958_50552_1097879"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To activate something making it available for use.</descrip></descripGrp><ntig><termGrp><term id="50552">enable</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1097879">activar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12958_50552_1537173"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To activate something making it available for use.</descrip></descripGrp><ntig><termGrp><term id="50552">enable</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1537173">habilitar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1297_1141794_1546161"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An advanced file system designed for use specifically with the Windows NT operating system. It supports long filenames, full security access control, file system recovery, extremely large storage media, and various features for the Windows NT POSIX subsystem. It also supports object-oriented applications by treating all files as objects with user-defined and system-defined attributes.</descrip></descripGrp><ntig><termGrp><term id="1141794">Windows NTFS</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1546161">NTFS</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Not