rmGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1308687">autenticació connectable</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16384_568060_1322259"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An XML or XOML file that contains the information that other programs require to instantiate and run the workflow. Optionally, any custom metadata the workflow requires to run.</descrip></descripGrp><ntig><termGrp><term id="568060">workflow definition</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1322259">definició de flux de treball</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16385_568062_1322404"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of rules for a workflow.</descrip></descripGrp><ntig><termGrp><term id="568062">workflow policy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1322404">norma de flux de treball</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16388_568111_1322116"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process that occurs when a workflow host calls the WorkflowRuntime.CreateWorkflow method.</descrip></descripGrp><ntig><termGrp><term id="568111">workflow activation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1322116">activació de flux de treball</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16389_568136_1098270"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A custom group used to target content to people based on membership within the group.</descrip></descripGrp><ntig><termGrp><term id="568136">audience</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1098270">auditori</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16389_568136_2814829"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A custom group used to target content to people based on membership within the group.</descrip></descripGrp><ntig><termGrp><term id="568136">audience</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2814829">públic</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16390_568168_1322129"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An elemental unit of a workflow that represents actions and provides functionality for control flow, conditions, event handling, state management, and communication with applications and services.</descrip></descripGrp><ntig><termGrp><term id="568168">workflow activity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1322129">activitat de flux de treball</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16392_568170_1322435"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A registration process that occurs when you add a workflow definition to the Microsoft Dynamics CRM database.</descrip></descripGrp><ntig><termGrp><term id="568170">workflow registration</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1322435">registre de flux de treball</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16394_568174_1288358"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The combination of runtime event processing, support programs, code libraries, a scripting language, or other software to help develop and glue together the different components of a software project. In Microsoft Dynamics CRM, the plug-ins and workflows are included in a single event model.</descrip></descripGrp><ntig><termGrp><term id="568174">event framework</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1288358">marc d'incidències</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16396_568178_1305897"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An architectural principle where a single instance of software is used to run a service for multiple clients (tenants).</descrip></descripGrp><ntig><termGrp><term id="568178">multitenancy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1305897">arquitectura de diversos inquilins</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16397_568182_1305898"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to multiple client organizations (tenants) that are served by a single software-as-a-service (SaaS) vendor's servers.</descrip></descripGrp><ntig><termGrp><term id="568182">multitenant</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1305898">diversos inquilins</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16398_568183_1308689"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Occurring after a core system operation has been completed.</descrip></descripGrp><ntig><termGrp><term id="568183">post-event</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1308689">posterior a la incidència</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16399_568184_1308690"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Occurring before a core system operation occurs.</descrip></descripGrp><ntig><termGrp><term id="568184">pre-event</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1308690">anterior a la incidència</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16400_568187_1307840"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A class whose definition is split over two or more source files. Each source file contains a section of the class definition, and all parts are combined when the application is compiled.</descrip></descripGrp><ntig><termGrp><term id="568187">partial class</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1307840">classe parcial</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16414_583814_2576154"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature of an integrated development environment (IDE) that provides logical code elements that the user can select from a drop-down menu while coding.</descrip></descripGrp><ntig><termGrp><term id="583814">IntelliSense</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2576154">IntelliSense</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1642_210902_364136"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mode of session state in which the entire session state is serialized and stored as a BLOB on the client then deserialized during every post-back. This has a tremendous hit in bytes over the wire (BoW), but is highly scalable in that it doesn’t require storing information in the database.</descrip></descripGrp><ntig><termGrp><term id="210902">view state</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="364136">visualització de l'estat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16427_3099101_3099116"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A control that is used with a window that does not have enough display area to show all of its content. The pager control allows the user to scroll to the area of the window that is not currently in view.</descrip></descripGrp><ntig><termGrp><term id="3099101">pager</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3099116">selector de pàgines</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16427_584196_3099116"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A control that is used with a window that does not have enough display area to show all of its content. The pager control allows the user to scroll to the area of the window that is not currently in view.</descrip></descripGrp><ntig><termGrp><term id="584196">pager control</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3099116">selector de pàgines</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16440_584278_1098258"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A column chart subtype that compares data points along two axes.</descrip></descripGrp><ntig><termGrp><term id="584278">3-D column chart</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id=