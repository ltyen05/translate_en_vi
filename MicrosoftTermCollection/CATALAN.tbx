 type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44560_2506548_2509028"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A packet of bytes meant to transfer a small amount of data between programs.</descrip></descripGrp><ntig><termGrp><term id="2506548">token</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2509028">testimoni</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44561_2506549_2509335"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An opaque token provided by Microsoft Graph to a notification URL that needs to be provided back to Microsoft Graph in order to validate ownership of the notification URL.</descrip></descripGrp><ntig><termGrp><term id="2506549">validation token</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2509335">testimoni de validació</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44562_2506550_2509006"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A querying functionality that enables applications to discover newly created, updated, or deleted entities without performing a full read of the target resource with every request.</descrip></descripGrp><ntig><termGrp><term id="2506550">delta query</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2509006">consulta delta</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44563_2506551_2509014"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A string on the end of the path in a GET request (“/delta”) that triggers delta query.</descrip></descripGrp><ntig><termGrp><term id="2506551">delta function</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2509014">funció delta</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44564_2506552_2509005"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A complete set of data returned for a resource from a delta query GET request.</descrip></descripGrp><ntig><termGrp><term id="2506552">delta feed</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2509005">canal de continguts delta</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44565_2506553_2509029"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An opaque token returned in a delta query GET response which encodes the point in time of the last data provided to the client.</descrip></descripGrp><ntig><termGrp><term id="2506553">state token</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2509029">testimoni d'estat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44567_2506560_2509008"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A piece of data about a resource that contains complex values, generally indicating behaviors or capabilities of an item.</descrip></descripGrp><ntig><termGrp><term id="2506560">facet</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2509008">faceta</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44568_2506562_2509007"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A piece of data related to Outlook MAPI properties not already exposed in the Microsoft Graph API metadata.</descrip></descripGrp><ntig><termGrp><term id="2506562">extended property</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2509007">propietat ampliada</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44569_2506611_2509692"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A technology that enables Wi-Fi devices to connect directly, without a router or other mechanism, making it simpler to do things like print, share, sync, and display.​</descrip></descripGrp><ntig><termGrp><term id="2506611">Wi-Fi Direct</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2509692">Wi-Fi Direct</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44586_2506886_2509615"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An app that enables members of a Language community to provide translation and language-related feedback about features. The app is currently available only for Windows Desktop.</descrip></descripGrp><ntig><termGrp><term id="2506886">Language Community app</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2509615">aplicació Comunitat lingüística</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44587_2506888_2509620"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A request to gather and send language feedback using quests in Feedback Hub and the Language Community app.​</descrip></descripGrp><ntig><termGrp><term id="2506888">language quest</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2509620">tasca lingüística</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44608_2573054_2577436"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The section of the expanded view of the profile card that contains LinkedIn profile information.</descrip></descripGrp><ntig><termGrp><term id="2573054">LinkedIn profile in Microsoft</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2577436">Perfil del LinkedIn a Microsoft</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44611_2509173_2512977"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Outlook feature that allows users to compose and save a message as a template, and then reuse it when they want to.</descrip></descripGrp><ntig><termGrp><term id="2509173">Email templates</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2512977">Plantilles de correu electrònic</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44619_2512050_2515327"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that provides a notification feed where you can view all your notifications in one place.</descrip></descripGrp><ntig><termGrp><term id="2512050">notification center</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2515327">centre de notificacions</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4462_72367_1137770"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The core of layered architecture that manages the most basic operations of the operating system and the computer's processor. The kernel schedules different blocks of executing code, called threads, for the processor to keep it as busy as possible and coordinates multiple processors to optimize performance. The kernel also synchronizes activities among Executive-level subcomponents, such as I/O Manager and Process Manager, and handles hardware exceptions and other hardware-dependent functions. The kernel works closely with the hardware abstraction layer.</descrip></descripGrp><ntig><termGrp><term id="72367">kernel</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1137770">nucli</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntr