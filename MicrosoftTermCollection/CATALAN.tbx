<descrip type="definition">An authentication mechanism to configure access control based on role claims contained in the authentication token.</descrip></descripGrp><ntig><termGrp><term id="2138009">role-based access control</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2801466">control d'accés segons les funcions</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37463_2138010_2801466"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An authentication mechanism to configure access control based on role claims contained in the authentication token.</descrip></descripGrp><ntig><termGrp><term id="2138010">RBAC</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2801466">control d'accés segons les funcions</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37474_2139114_2151807"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A database that stores search settings which include, but are not limited to search topology settings.</descrip></descripGrp><ntig><termGrp><term id="2139114">search administration database</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2151807">base de dades d'administració de cerques</term><termNote typ