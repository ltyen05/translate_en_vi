ed</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1724724">relació de persona</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32764_1703331_1724726"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An entity that represents a person, declared as such in metadata.</descrip></descripGrp><ntig><termGrp><term id="1703331">person-type entity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1724726">entitat de tipus de persona</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32765_1703332_1724680"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An entity that represents a person in the Business Network, to which person-type entities in CRM can be linked.</descrip></descripGrp><ntig><termGrp><term id="1703332">Business Network profile</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1724680">Perfil de la Xarxa comercial</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32766_1703333_1724682"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An explicit (for example, “colleague”) or implicit (for example,  “sent 100 emails in the last 30 days”) relationship, with inherent strength, between people in the Business Network.</descrip></descripGrp><ntig><termGrp><term id="1703333">Business Network relationship</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1724682">Relació de la Xarxa comercial</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32767_1703334_1724689"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A role that is similar to the customer service role, with the addition of being able to manage public conversations enabled and with the following permissions: organization read, BU append, BU append to, and user delete.</descrip></descripGrp><ntig><termGrp><term id="1703334">community representative</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1724689">representant de la comunitat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32768_1703340_1724742"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In a pie chart that represents records, for example, cases broken out by source, the part of the "pie" (the slice) that represents social sources such as Facebook, Twitter, and other social channels.</descrip></descripGrp><ntig><termGrp><term id="1703340">social slice</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1724742">sector social</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32769_1703344_1744173"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An action by which a subscription (the source subscription) is replaced by a new subscription, both owned by the same billing account, along a preconfigured conversion path. The source subscription is canceled and the destination subscription is the new subscription.</descrip></descripGrp><ntig><termGrp><term id="1703344">conversion</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1744173">conversió</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32770_1703345_1744205"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A new subscription that is created as a result of a conversion or a merge.</descrip></descripGrp><ntig><termGrp><term id="1703345">destination subscription</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1744205">subscripció de destinació</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32772_1703346_1724703"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To add to or augment data that is in the system, usually from an outside data service provider.</descrip></descripGrp><ntig><termGrp><term id="1703346">enrich</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1724703">enriquir</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32773_1703347_1744253"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A subscription that is canceled to create a new subscription as a result of a conversion or merge.</descrip></descripGrp><ntig><termGrp><term id="1703347">source subscription</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1744253">subscripció d'origen</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32774_1703348_1744221"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A partner in scenarios where the partner providing the offer is different than the partner providing the service, for example, Xbox selling Messenger products.</descrip></descripGrp><ntig><termGrp><term id="1703348">merchant</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1744221">comerciant</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32775_1703349_1744224"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To replace a set of subscriptions with a new subscription.</descrip></descripGrp><ntig><termGrp><term id="1703349">merge</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1744224">combinar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32776_1703350_1744239"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of activating tokens during a purchase.</descrip></descripGrp><ntig><termGrp><term id="1703350">POSA</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1744239">activació al punt de venda</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32776_1703350_1744244"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of activating tokens during a purchase.</descrip></descripGrp><ntig><termGrp><term id="1703350">POSA</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1744244">POSA</term><termNote type="geographicalUs