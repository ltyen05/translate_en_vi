stomers manage their payments, dues, invoicing, and contact information for paid Microsoft services.</descrip></descripGrp><ntig><termGrp><term id="702316">billing account</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1097356">compte de facturació</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20133_702317_1097357"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Information, such as name, billing address, and payment method, related to paying for account services.</descrip></descripGrp><ntig><termGrp><term id="702317">billing information</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1097357">informació de facturació</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20134_702320_1963280"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The usually pretrial disclosure of pertinent facts or documents by one or both parties to a legal action or proceeding.</descrip></descripGrp><ntig><termGrp><term id="702320">legal discovery</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1963280">descobriment</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender"