pe="definition">The behavior property of a Date and Time attribute where the date portion of the value is as specified in the UI and SDK and the time portion of the value is always 12:00 A.M.</descrip></descripGrp><ntig><termGrp><term id="2157393">Date Only</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2236873">Només data</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37774_2157394_2236886"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The behavior property of a Date and Time attribute where field values are displayed with no time zone conversion.</descrip></descripGrp><ntig><termGrp><term id="2157394">Time-Zone Independent</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2236886">Independent del fus horari</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37775_2157422_2159726"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A photo that illustrates action by blending multiple frames of a short video to create a strobe effect in the resulting still image.</descrip></descripGrp><ntig><termGrp><term id="2157422">action shot</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2159726">fotografia d'acció</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37777_2157424_2159741"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature for taking photos in low light, capturing both short and long exposure images. The user can dynamically blend the two exposures afterwards, as preferred</descrip></descripGrp><ntig><termGrp><term id="2157424">dynamic exposure</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2159741">exposure dinàmic</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37778_2157425_2159743"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mode for taking photos that automatically captures images with and without flash. The user can choose the amount of flash in the photo after it has been taken.</descrip></descripGrp><ntig><termGrp><term id="2157425">dynamic flash</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2159743">flash dinàmic</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37779_2157426_2159751"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An image file type in which a very short video is followed by a transition to a still image. The combination of video and still image captures the essence of the moment.</descrip></descripGrp><ntig><termGrp><term id="2157426">living image</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2159751">fotoclip</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37780_2157427_2159814"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A photo that illustrates motion by blurring together multiple frames of a short video to create the effect of motion in the still image.</descrip></descripGrp><ntig><termGrp><term id="2157427">motion focus</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2159814">Focus de moviment</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37781_2157428_2159864"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The top level view in File Explorer that shows the user's most frequently used and most recently used files and folders or folders pinned by the user for quick access.</descrip></descripGrp><ntig><termGrp><term id="2157428">Quick access</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2159864">Accés ràpid</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37782_2157429_2159871"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that provides unending stream of music based not on the user's library, but on an artist or song selected by the user.</descrip></descripGrp><ntig><termGrp><term id="2157429">Radio</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2159871">Ràdio</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37783_2157430_2159876"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The suggested content that is displayed on different surface areas in the operating system. Content can range from tips and tricks, a link to other content, an app, etc.</descrip></descripGrp><ntig><termGrp><term id="2157430">Suggestions for you</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2159876">Suggeriments per a tu</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37784_2157431_2159750"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An interval of time that it takes to complete a circuit in a race or exercise course, which the user can record with a stopwatch.</descrip></descripGrp><ntig><termGrp><term id="2157431">lap</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2159750">volta</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37785_2157432_2159873"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The total amount of time up to a given point that the user marks while using the stopwatch. After marking a split, the stopwatch continues running in the background.</descrip></descripGrp><ntig><termGrp><term id="2157432">split</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2159873">temps parcial</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37786_2157433_2159729"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A technology that enables app publishers to send ad requests to multiple ad networks to ensure that publishers can match the right ad networks to the right inventory and maximize the ad revenue.</descrip></descripGrp><ntig><termGrp><term id="2157433">ad mediation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2159729">mediació d'anuncis</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminin