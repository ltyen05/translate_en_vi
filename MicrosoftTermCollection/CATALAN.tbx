9770_3019887"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Windows Shadow Stack security feature that prevents a class of vulnerabilities known as Return-Oriented Programming (ROP) and requires hardware in order to work.</descrip></descripGrp><ntig><termGrp><term id="3019770">HSP</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3019887">HSP</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50524_2861024_2862209"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Power Mixed Reality feature that allows users to place a 3D object of a specific size into the AR environment around them.</descrip></descripGrp><ntig><termGrp><term id="2861024">AR Cube</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2862209">Cub d'RA</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50525_2861025_2862211"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Combining nearby pins together to form one new cluster pin, usually with a number of pins provided, to indicate the density of locations for a certain zoom level on the map.</descrip></descripGrp><ntig><termGrp><term id="2861025">pin clustering</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="c