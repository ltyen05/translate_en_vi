">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761167">llançament</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19991_693623_761171"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The re-establishment of an agreement or the replacement of a prior agreement with a new one.</descrip></descripGrp><ntig><termGrp><term id="693623">renewal</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761171">pròrroga</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19992_693625_761172"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">When referring to a Microsoft volume licensing agreement, an order submitted by a customer to re-establish the terms of a license agreement or to replace a prior agreement with a new one.</descrip></descripGrp><ntig><termGrp><term id="693625">renewal order</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761172">sol·licitud de pròrroga</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19993_693627_761173"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The length of time a renewal remains in effect.</descrip></descripGrp><ntig><termGrp><term id="693627">renewal term</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761173">període de pròrroga</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19994_693630_761174"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To allow someone to use temporarily property in return for payment.</descrip></descripGrp><ntig><termGrp><term id="693630">rent</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761174">llogar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19995_693631_761176"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A statement of fact expressed to induce someone to enter into an agreement.</descrip></descripGrp><ntig><termGrp><term id="693631">representation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761176">manifestació</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19996_693632_