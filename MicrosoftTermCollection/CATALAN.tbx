rmNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="514673">Opcions</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53010_3013010_3013230"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A constraint on the algorithms used to publish aggregate information about a statistical database which limits the privacy impact on individuals whose information is in the database.</descrip></descripGrp><ntig><termGrp><term id="3013010">differential privacy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3013230">privadesa diferencial</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53011_3013183_3019909"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A profile that a user can create in Microsoft Cloud for Sustainability to check the volume of greenhouse gases that result from an operational activity. The profile contains the settings needed to run the calculation, and includes the calculation model.</descrip></descripGrp><ntig><termGrp><term id="3013183">calculation profile</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3019909">perfil de càlcul</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53012_3013184_3019910"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A legal document evidencing the agreement between the parties.</descrip></descripGrp><ntig><termGrp><term id="3013184">contractual instrument</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3019910">instrument contractual</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53013_3013185_3019911"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A value that relates the amount of pollution generated and the activity associated with the generation of that pollution.</descrip></descripGrp><ntig><termGrp><term id="3013185">emission factor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3019911">factor d'emissió</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53014_3013186_3019912"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Power BI app published through AppSource and used to demonstrate the energy and carbon efficiency of Microsoft cloud services through a Power BI dashboard. The app provides individual customers with Carbon footprint and GHG emissions associated with their current Azure and Dynamics 365 subscription(s) in comparison with the estimated footprint of on-premises alternatives.</descrip></descripGrp><ntig><termGrp><term id="3013186">Emissions Impact Dashboard</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3019912">Escriptori digital d'impacte de les emissions</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53015_3013187_3019913"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A direct release to the atmosphere of greenhouse gas compounds from various types of equipment and processes.</descrip></descripGrp><ntig><termGrp><term id="3013187">fugitive emission</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3019913">emissió fugitiva</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53016_3013188_3019914"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The cloud offering that helps companies measure, understand and take charge of their carbon emissions, set sustainability goals and take measurable action.</descrip></descripGrp><ntig><termGrp><term id="3013188">Microsoft Cloud for Sustainability</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3019914">Microsoft Cloud for Sustainability</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53017_3013189_3019915"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An emission from the combustion of fossil fuels used in the operation of vehicles or other forms of mobile transportation.</descrip></descripGrp><ntig><termGrp><term id="3013189">mobile combustion</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3019915">combustió mòbil</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53018_3013190_3019916"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An emission from the combustion of fuels used in the operation of power plants, industrial combustion plants, etc.</descrip></descripGrp><ntig><termGrp><term id="3013190">stationary combustion</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3019916">combustió estacionària</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53019_3013191_3019917"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A report that shows the effects that an organization's business operations have on the environment.</descrip></descripGrp><ntig><termGrp><term id="3013191">sustainability report</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3019917">informe sobre la sostenibilitat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5303_76437_2997998"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In mathematics, the power to which a base must be raised to equal a given number. For example, for the base 10, the logarithm of 16 is (approximately) 1.2041 because 101.2041 equals (approximately) 16. Both natural logarithms (to the base e, which is approximately 2.71828) and common logarithms (to the base 10) are used in programming. Languages such as C and Basic include functions for calculating natural logarithms.</descrip></descripGrp><ntig><termGrp><term id="76437">logarithm</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2997998">logaritme</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53031_3014789_3060024"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Azure offering that supports Azure Virtual Desktop on Azure Stack HCI.</descrip></descripGrp><ntig><termGrp><term id="3014789">Azure Virtual Desktop on Azure Stack HCI</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term i