In a digital context, trusted third parties generate a trusted time stamp for a particular message by having a time stamping service append a time value to a message and then digitally signing the result.</descrip></descripGrp><ntig><termGrp><term id="121727">time stamp</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2145208">marca d'hora</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6879_78424_1230159"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Moving text that is used on a data access page to draw the user's attention to a specific page element, such as a headline or an important announcement.</descrip></descripGrp><ntig><termGrp><term id="78424">marquee</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1230159">marquesina</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6883_210434_1768992"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A device used to copy files to recordable CDs and DVDs.</descrip></descripGrp><ntig><termGrp><term id="210434">disc burner</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1768992">enregistrador de discos</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpee