></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1355887">panorama</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20106_694850_1097636"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The image or avatar someone adds to their profile to represent themselves.</descrip></descripGrp><ntig><termGrp><term id="694850">display picture</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1097636">imatge de visualització</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20107_694869_761127"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A transaction to record money that is paid from a customer to a supplier for goods or services received.</descrip></descripGrp><ntig><termGrp><term id="694869">payment</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="761127">pagament</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2012_357288_1555487"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A graphical control used to display text.</descrip></descripGrp><ntig><termGrp><term id="357288">label</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1555487">etiqueta</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20125_700660_1963234"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Meeting an organization's various obligations, which may arise from laws, regulations, rules, and many other legal instruments, such as court judgments, litigation, and even contracts. Specific and important examples of these obligations include the Sarbanes-Oxley Act (SOX) and the California Law on Notice of Security Breach, formerly known as SB-1386. These regulatory obligations may be created by many sources, such as national and local governments and from industry-specific oversight groups, such as the Payment Card Industry Data Security Standards.</descrip></descripGrp><ntig><termGrp><term id="700660">compliance</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1963234">compliment normatiu</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20126_700661_1963235"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Person responsible for ensuring that an organization complies with the various regulations and standards that are imposed by government and other regulatory bodies.</descrip></descripGrp><ntig><termGrp><term id="700661">compliance officer</term><termNote type="partOfSpeech">Noun</termNote><termNote 