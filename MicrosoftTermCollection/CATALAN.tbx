plication settings.</descrip></descripGrp><ntig><termGrp><term id="126494">user profile</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1770122">perfil d'usuari</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2631_126494_2889103"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file that contains configuration information for a specific user, such as desktop settings, persistent network connections, and application settings.</descrip></descripGrp><ntig><termGrp><term id="126494">user profile</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2889103">perfil</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2631_2888473_1770122"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file that contains configuration information for a specific user, such as desktop settings, persistent network connections, and application settings.</descrip></descripGrp><ntig><termGrp><term id="2888473">profile</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1770122">perfil d'usuari</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="