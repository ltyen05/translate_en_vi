 Update</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39476_2296026_2300798"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature of Microsoft Rights Management Services to documents and share them both internally as well as with other businesses, limit who gets access to such documents, set an expiration date and monitor who has accessed, opened, used, and changed them or attempted to view them, when and from where, and possibly revoke access when necessary regardless of where they are stored.</descrip></descripGrp><ntig><termGrp><term id="2296026">Document Tracking</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2300798">Seguiment de documents</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39486_2300114_2303431"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The access level that allows consumers who are on a small-screen device and have not signed into an Office 365 app with a subscription to do basic editing.</descrip></descripGrp><ntig><termGrp><term id="2300114">core editing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2303431">edició bàsica</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39487_2300132_2303438"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to the access level for Office Web Apps in which consumers who are not signed in with a license or can view existing documents, but can't edit them or create new documents.</descrip></descripGrp><ntig><termGrp><term id="2300132">view-only</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2303438">només visualització</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39488_2300148_2303432"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An ideogram originating in Japanese electronic messages or websites and used to express an idea, emotion, etc. in electronic communication.</descrip></descripGrp><ntig><termGrp><term id="2300148">emoji</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2303432">emoji</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39489_2300781_2303434"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A unit of measure for the workload of an employed person or a student that allows comparison to one full-time workload in the particular environment.</descrip></descripGrp><ntig><termGrp><term id="2300781">full-time equivalent</term><termNote type="partOfSpeech">Noun