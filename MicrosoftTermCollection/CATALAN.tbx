ch">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1275215">auditar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24973_1166077_1275605"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tab that is available only when an object in a page is selected.</descrip></descripGrp><ntig><termGrp><term id="1166077">contextual tab</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1275605">pestanya contextual</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24977_1166109_1275813"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A solution that is "open" and that can be modified by anybody with the required privileges.</descrip></descripGrp><ntig><termGrp><term id="1166109">unprotected solution</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1275813">solució desprotegida</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24979_1166112_1275607"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The mode in which certain information is not available for edit on the page until the page is saved after creation. An example of this would be the opportunity record pages, where the opportunity has to be saved before products can be added.</descrip></descripGrp><ntig><termGrp><term id="1166112">create mode</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1275607">mode de creació</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24980_1166113_1275623"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A component that requires the current component to work properly. For example, a dependent component of a global Option Set is an “attribute” that references that Option Set.</descrip></descripGrp><ntig><termGrp><term id="1166113">dependent component</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1275623">component dependent</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24981_1166114_1275630"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A proprietary XML-based query language that is used in Microsoft Dynamics CRM to retrieve information.</descrip></descripGrp><ntig><termGrp><term id="1166114">Fetch</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1275630">Fetch</ter