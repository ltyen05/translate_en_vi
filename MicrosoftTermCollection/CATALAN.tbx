earning analysis to enable business users of all skill levels to apply artificial intelligence to predict a range of business outcomes with regards to lead qualification.</descrip></descripGrp><ntig><termGrp><term id="2579496">predictive scoring model</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2814165">model de puntuació predictiu</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45806_2579498_2814166"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A characteristic of a profile that has a name and a value associated with it and describes it in a particular context.</descrip></descripGrp><ntig><termGrp><term id="2579498">property</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2814166">propietat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45807_2579499_2814167"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A property that represents the status of the provisioning operation on the resource.</descrip></descripGrp><ntig><termGrp><term id="2579499">provisioning state</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2814167">estat d'aprovisionament</term><termNote type="geographicalUsage">ESP</termNote><termNote type="pa