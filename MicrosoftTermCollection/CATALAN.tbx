langSet xml:lang="en-US"><descripGrp><descrip type="definition">A 3D printing format that allows design applications to send 3D models to other applications, platforms, services, and printers.​</descrip></descripGrp><ntig><termGrp><term id="2328170">3MF</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2328692">3MF</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40034_2328171_2328695"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The rectangular boundaries of the object to be scanned.​​</descrip></descripGrp><ntig><termGrp><term id="2328171">boundary cube</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2328695">cub limitador</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40035_2328172_2328707"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that simulates a body scanning booth by using a turntable in combination with the Kinect.​​​</descrip></descripGrp><ntig><termGrp><term id="2328172">scanning booth</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2328707">cabina d'escaneig</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">