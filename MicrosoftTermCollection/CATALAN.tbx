tig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2857302">Scrum àgil</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3980_37784_1546567"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To acknowledge an action or the value of some data (e.g. password) by definite assurance.</descrip></descripGrp><ntig><termGrp><term id="37784">confirm</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1546567">confirmar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39836_2309204_2653445"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A software development approach where developers must first write a test that fails before they write the code to make the test succeed.</descrip></descripGrp><ntig><termGrp><term id="2309204">TDD</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2653445">desenvolupament guiat per proves</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39836_2309244_2653445"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A software development approach where developers must first write a test that fails before they write the code to make the test succeed.</descrip></descripGrp><ntig><termGrp><term id="2309244">test-driven development</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2653445">desenvolupament guiat per proves</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39847_2310171_2334235"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office service that uses the Microsoft Graph to give personalized insight to users around content and people based on who they interact with in their company and what content their colleagues are viewing, restricted by permissions.</descrip></descripGrp><ntig><termGrp><term id="2310171">Delve</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2334235">Delve</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39847_2310171_2408768"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office service that uses the Microsoft Graph to give personalized insight to users around content and people based on who they interact with in their company and what content their colleagues are viewing, restricted by permissions.</descrip></descripGrp><ntig><termGrp><term id="2310171">Delve</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2408768">Microsoft Delve</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39847_2407977_2334235"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office service that uses the Microsoft Graph to give personalized insight to users around content and people based on who they interact with in their company and what content their colleagues are viewing, restricted by permissions.</descrip></descripGrp><ntig><termGrp><term id="2407977">Microsoft Delve</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2334235">Delve</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39847_2407977_2408768"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office service that uses the Microsoft Graph to give personalized insight to users around content and people based on who they interact with in their company and what content their colleagues are viewing, restricted by permissions.</descrip></descripGrp><ntig><termGrp><term id="2407977">Microsoft Delve</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2408768">Microsoft Delve</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39848_2384090_2384307"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Facebook mobile app that is built and is distributed by Microsoft.</descrip></descripGrp><ntig><termGrp><term id="2384090">Facebook for Windows Phone 8.1</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2384307">Facebook per al Windows Phone 8.1</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39850_2312644_2329484"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The UI element in Outlook that when clicked will identify and display email where a user has been explicitly mentioned via the @ symbol in either the email subject or body.</descrip></descripGrp><ntig><termGrp><term id="2312644">Mentions</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2329484">Mencions</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39851_2312649_2318428"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To remove a flag.</descrip></descripGrp><ntig><termGrp><term id="2312649">unflag</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="231842