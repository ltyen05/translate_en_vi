740">text net</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1406_149332_2095207"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A control that is not connected to a field in an underlying table, query, or SQL statement. An unbound control is often used to display informational text or decorative pictures.</descrip></descripGrp><ntig><termGrp><term id="149332">unbound control</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2095207">control independent</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14063_545681_2095109"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tab in the Toolbox where you can go to insert objects into your document.</descrip></descripGrp><ntig><termGrp><term id="545681">Object Palette</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2095109">paleta d'objectes</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14064_235261_2368685"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A payment made by a customer for a past due obligation.</descrip></descripGrp><ntig><termGrp><term id="235261">back payment</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2368685">pagament retroactiu</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14081_7275_1963085"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In programming, the means by which an application can read from or write to a resource.</descrip></descripGrp><ntig><termGrp><term id="7275">access mechanism</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1963085">mètode d'accés</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14081_7276_1963085"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In programming, the means by which an application can read from or write to a resource.</descrip></descripGrp><ntig><termGrp><term id="7276">access method</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1963085">mètode d'accés</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14083_180015_2906654"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To move between different environments and have the same user experience in both environments.</descrip></descripGrp><ntig><termGrp><term id="180015">roam</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2906654">fer servir un perfil d'itinerància</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14085_361581_1724712"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A message transfer protocol used by the World Wide Web to service page requests, and which adds a security layer using Secure Socket Layer (SSL) technology.</descrip></descripGrp><ntig><termGrp><term id="361581">Hypertext Transfer Protocol over Secure Sockets Layer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1724712">HTTPS</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14085_361582_1724712"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A message transfer protocol used by the World Wide Web to service page requests, and which adds a security layer using Secure Socket Layer (SSL) technology.</descrip></descripGrp><ntig><termGrp><term id="361582">HTTPS</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1724712">HTTPS</term><termNote type="geographicalUsage">ESP</termNote><ter