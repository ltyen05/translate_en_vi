mbers of the group.</descrip></descripGrp><ntig><termGrp><term id="109185">security group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2095179">grup de seguretat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11486_126144_2000837"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A data type that can only hold a whole number with a value greater than, or equal to, zero. In this implementation, the maximum value that an unsigned integer can hold is 0xFFFFFFFF (4,294,967,295).</descrip></descripGrp><ntig><termGrp><term id="126144">unsigned integer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2000837">enter sense signe</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11487_212898_1321722"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to applications or commands run in the order listed and that must finish before the next application or command is run.</descrip></descripGrp><ntig><termGrp><term id="212898">synchronous</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1321722">síncron</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11487_2479307_1321722"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to applications or commands run in the order listed and that must finish before the next application or command is run.</descrip></descripGrp><ntig><termGrp><term id="2479307">sync</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1321722">síncron</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11493_120895_2864314"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A rectangular control in an application that allows the user to enter or edit text.</descrip></descripGrp><ntig><termGrp><term id="120895">text box</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2864314">àrea d'entrada de text</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11493_2864260_2864314"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A rectangular control in an application that allows the user to enter or edit text.</descrip></descripGrp><ntig><termGrp><term id="2864260">text input area</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><la