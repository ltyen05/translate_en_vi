52_2776307"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft hosted version of Windows SharePoint Services, the Microsoft-hosted solution that helps employees create and manage custom team and project-focused intranet sites for collaboration and document sharing.</descrip></descripGrp><ntig><termGrp><term id="1056352">Microsoft SharePoint Online</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2776307">SharePoint</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22945_2773098_2776307"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft hosted version of Windows SharePoint Services, the Microsoft-hosted solution that helps employees create and manage custom team and project-focused intranet sites for collaboration and document sharing.</descrip></descripGrp><ntig><termGrp><term id="2773098">SharePoint</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2776307">SharePoint</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22960_1056667_1098284"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A corporate executive in charge of management and distribution of all the business and technical knowledge of a company. The CKO maximizes the value of stored knowledge by ensuring that employees have access, and by avoiding knowledge loss caused by technology-based changes and upgrades in databases and other storage.</descrip></descripGrp><ntig><termGrp><term id="1056667">CKO</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1098284">gestor del coneixement</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22960_1056668_1098284"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A corporate executive in charge of management and distribution of all the business and technical knowledge of a company. The CKO maximizes the value of stored knowledge by ensuring that employees have access, and by avoiding knowledge loss caused by technology-based changes and upgrades in databases and other storage.</descrip></descripGrp><ntig><termGrp><term id="1056668">Chief Knowledge Officer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1098284">gestor del coneixement</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22963_1056673_2520697"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A verbose, English-like compiled programming language developed between 1959 and 1961 and still in widespread use today, especially in business applications typically run on mainframes. A COBOL program consists of an Identification Division, which specifies the name of the program and contains any other documentation the programmer wants to add; an Environment Division, which specifies the computers being used and the files used in the program for input and output; a Data Division, which describes the format of the data structures used in the program; and a Procedure Division, which contains the procedures that dictate the actions of the program.</descrip></descripGrp><ntig><termGrp><term id="1056673">COBOL</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2520697">COBOL</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22963_1056674_2520697"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A verbose, English-like compiled programming language developed between 1959 and 1961 and still in widespread use today, especially in business applications typically run on mainframes. A COBOL program consists of an Identification Division, which specifies the name of the program and contains any other documentation the programmer wants to add; an Environment Division, which specifies the computers being used and the files used in the program for input and output; a Data Division, which describes the format of the data structures used in the program; and a Procedure Division, which contains the procedures that dictate the actions of the program.</descrip></descripGrp><ntig><termGrp><term id="1056674">Common Business-Oriented Language</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2520697">COBOL</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termN