<termGrp><term id="1382040">preferit</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27007_1362193_2694331"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A service that manages media quality over a wide area network (WAN) connection by either rerouting traffic or by denying connection requests when bandwidth is approaching saturation.</descrip></descripGrp><ntig><termGrp><term id="1362193">call admission control</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2694331">control d'admissió de trucades</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27007_1517552_2694331"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A service that manages media quality over a wide area network (WAN) connection by either rerouting traffic or by denying connection requests when bandwidth is approaching saturation.</descrip></descripGrp><ntig><termGrp><term id="1517552">CAC</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2694331">control d'admissió de trucades</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27030_1362593_2768097"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An agreement that is part of the Microsoft volume licensing program.</descrip></descripGrp><ntig><termGrp><term id="1362593">Microsoft Volume Licensing agreement</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2768097">contracte de llicències per volum de Microsoft</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27033_1362691_2768095"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A family of Microsoft licensing agreement offering programs for large numbers of users that provide potentially substantial savings, ease of deployment, flexible acquisition, numerous payment options, and other benefits such as Software Assurance.</descrip></descripGrp><ntig><termGrp><term id="1362691">Microsoft Volume Licensing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2768095">Llicències per volum de Microsoft</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27051_1364948_2822424"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A drop-down menu that appears when you click the drop-down arrow on an item in a SharePoint list or library, or a Microsoft Word document.</descrip></descripGrp><ntig><termGrp><term id="1364948">Edit Control Block</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</