Entry id="51095_2884687_2885339"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An unpatched software vulnerability that is unknown to, or unaddressed by, the software's vendor that can be exploited to attack the computer system or network.</descrip></descripGrp><ntig><termGrp><term id="2884687">0-day</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2885339">vulnerabilitat de dia zero</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51096_2884688_2885337"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Descriptive of any content or feature available to a customer who upgrades from a free service to a paid service, as part of that larger offering.</descrip></descripGrp><ntig><termGrp><term id="2884688">premium</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2885337">prèmium</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51104_2884921_2885635"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The collection of background images for the Windows lock screen and/or the Windows desktop, with hotspots overlaying linking to information about the image, in-product marketing, experiences, or tips and tricks.</descrip></descripGrp><ntig><termGrp><term id="2884921">spotlight collection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2885635">col·lecció de destacats</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51108_2885547_2886588"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To stream the content of a user's device screen or a separate window to the screens of other users' devices, so these users could remotely see the screen of the user who shares it.</descrip></descripGrp><ntig><termGrp><term id="2885547">share</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2886588">compartir</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51109_2885548_2886589"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An app that helps users be more productive at work, such as Office apps.</descrip></descripGrp><ntig><termGrp><term id="2885548">productivity app</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2886589">aplicació de productivitat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51113_2886072_2886270"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The United States holiday celebrated on June 14 that commemorates the adoption of the flag of the United States.</descrip></descripGrp><ntig><termGrp><term id="2886072">Flag Day</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2886270">Dia de la Bandera</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51114_2886073_2886271"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Croatian national holiday celebrated on May 30 to commemorate the constitution of the first modern multi-party Croatian Parliament.</descrip></descripGrp><ntig><termGrp><term id="2886073">Statehood Day</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2886271">Dia de l'Estat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5114_139328_411002"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Web Storage System content class defines the intent or purpose of an item along with the names of properties that are intended for items in this class.</descrip></descripGrp><ntig><termGrp><term id="139328">content class</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="411002">classe de contingut</term><termNote type="geographicalUsage">ESP</