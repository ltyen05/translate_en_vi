></langSet></termEntry><termEntry id="12218_186005_515218"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The item on a user's My Status menu that resets the user's status to the previous setting after the user has manually selected a status setting.</descrip></descripGrp><ntig><termGrp><term id="186005">Reset Status</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="515218">Restableix l'estat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1223_147636_2734762"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A link that uses a relative URL.</descrip></descripGrp><ntig><termGrp><term id="147636">relative link</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2734762">enllaç relatiu</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12232_334511_1821200"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A status that indicates that an active telephone call has been temporarily suspended.</descrip></descripGrp><ntig><termGrp><term id="334511">on hold</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1821200">en espera</term><termNote type="geographicalUsage">ESP</termNote><termNote type="part