</termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1663936">control de selecció tàctil</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31651_1608229_1663939"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Visio-based design surface that enables users to create and edit workflows visually by manipulating shapes that represent actions and conditions.</descrip></descripGrp><ntig><termGrp><term id="1608229">Visual Designer</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1663939">Dissenyador visual</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31659_1608235_1645020"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The name of a product in the store that appears to customers. To the end user, this is the name of the product.</descrip></descripGrp><ntig><termGrp><term id="1608235">app name</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1645020">nom de l'aplicació</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31660_1608236_2242545"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file that contains the app manifest, executable files, text and image resource files, and other files that make up the app for a single platform.</descrip></descripGrp><ntig><termGrp><term id="1608236">app package</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2242545">paquet d'aplicació</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31663_1608239_1645023"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Collected data about an app, such as analytics of download, usage, in-application transaction, customer ratings provided by the Windows Store developer portal. This type of information helps developers clearly understand how their applications are doing in the Windows market.</descrip></descripGrp><ntig><termGrp><term id="1608239">App Summary</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1645023">Resum de l'aplicació</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31664_1608240_1645024"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Windows Store service that enables end users to update apps one at a time or all at the same time for all apps purchased through the Windows Store.</descrip></descripGrp><ntig><termGrp><term id="1608240">App Update</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1645024">Actualització d'aplicacions</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31668_1611161_1781023"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The stage of an app in the certification process.</descrip></descripGrp><ntig><termGrp><term id="1611161">certification status</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1781023">estat de certificació</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31670_1612553_1645026"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A link that takes you to a precise location, such as a slide within a presentation, a section of a document, or a specific page within a site, instead of to the main page of the web site.</descrip></descripGrp><ntig><termGrp><term id="1612553">deep link</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1645026">enllaç profund</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3168_210466_364119"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The formal name for PowerPoint 12 file format. This format has an open, royalty-free specification, and is the technology licensed to external parties. This license is the subject in the messaging points where “Open, royalty-free license” is discussed.</descrip></descripGrp><ntig><termGrp><term id="210466">PowerPoint XML Format</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="364119">Format XML del PowerPoint</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31681_1612562_1662731"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SharePoint site template that provides an entry point for users to access the business intelligence ecosystem.</descrip></descripGrp><ntig><termGrp><term id="1612562">Business Intelligence Center</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1662731">Centre d'intel·ligència empresarial</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31683_1612565_1645077"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An API for AtomPub and syndication.</descrip></descripGrp><ntig><termGrp><term id="1612565">Web</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1645077">Web</term><termNote type="geographi