oice corrections.</descrip></descripGrp><ntig><termGrp><term id="3170812">transaction connection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3170852">connexió de transacció</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56391_3170950_3175803"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A software-based trusted execution environment inside the address space of a host application. More technically, it is a Dynamic Link Library (DLL) loaded by a standard Windows application that secures secrets and sensitive operations in memory.</descrip></descripGrp><ntig><termGrp><term id="3170950">virtualization-based security enclave</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3175803">enclavament VBS</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56391_3170950_3175804"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A software-based trusted execution environment inside the address space of a host application. More technically, it is a Dynamic Link Library (DLL) loaded by a standard Windows application that secures secrets and sensitive operations in memory.</descrip></descripGrp><ntig><termGrp><term id="3170950">virtualization-based security enclave</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</ter