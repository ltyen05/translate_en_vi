ntry><termEntry id="26773_1355136_3134327"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A trusted industry standard in online pharmacy verification. Established in 2003, the PharmacyChecker Verification Program helps protect consumers by ensuring that the prescription drugs they order come from qualified online pharmacies.</descrip></descripGrp><ntig><termGrp><term id="1355136">PharmacyChecker</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="3134327">PharmacyChecker</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26781_1355241_1381747"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature of Communicator Web Access in which a user can join a conference by requesting that Office Communications Server call a specified phone number instead of the user placing a call to a conferencing service.</descrip></descripGrp><ntig><termGrp><term id="1355241">Call Me</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1381747">Truca'm</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26782_1355242_2781321"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A primary SharePoint Server management plan that identifies what is considered a record, what category the record belong to, where the records are stored, record rete