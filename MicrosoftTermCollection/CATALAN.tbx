iding Windows APIs and other technologies including IOAV, AMSI and Cloud files.</descrip></descripGrp><ntig><termGrp><term id="2842111">Microsoft Virus Initiative</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2843569">MVI</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50248_2842112_2843568"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A membership program that helps members get their products working and integrated with Windows by providing Windows APIs and other technologies including IOAV, AMSI and Cloud files.</descrip></descripGrp><ntig><termGrp><term id="2842112">MVI</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2843568">Iniciativa antivirus de Microsoft</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50248_2842112_2843569"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A membership program that helps members get their products working and integrated with Windows by providing Windows APIs and other technologies including IOAV, AMSI and Cloud files.</descrip></descripGrp><ntig><termGrp><term id="2842112">MVI</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2843569">MVI</term><term