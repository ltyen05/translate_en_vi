ected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2039053">Microsoft OneDrive for Business</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32531_1684427_2664022"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The set of pages in the virtual address space of the process that are currently resident in physical memory.</descrip></descripGrp><ntig><termGrp><term id="1684427">working set</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="2664022">conjunt de treball</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32556_1686879_1749323"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that validates, signs, and stores boot information in the Trusted Platform Module chip to verify the integrity of the PC.</descrip></descripGrp><ntig><termGrp><term id="1686879">Measured Boot</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1749323">Arrencada mesurada</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32559_1688076_1816686"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature whereby the A/V Conferencing Server calls the user, and the user answers the phone to join the conference.</descrip></descripGrp><ntig><termGrp><term id="1688076">dial-out conferencing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1816686">conferència per acceptació de trucada</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32563_1688192_1816683"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method of real-time communication wherein participants share and collaborate on several data and document types. The session can be hosted on an in-house server, an Internet-based service, or both.</descrip></descripGrp><ntig><termGrp><term id="1688192">data conferencing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1816683">conferència de dades</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32564_1688692_1816875"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A section in the default OneNote notebook where certain notes are stored by default.</descrip></descripGrp><ntig><termGrp><term id="1688692">Quick Notes</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca"><ntig><termGrp><term id="1816875">Notes ràpides</term><termNote type="geographica