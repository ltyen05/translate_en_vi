shing page field to which it is bound.</descrip></descripGrp><ntig><termGrp><term id="1506637">content placeholder</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969562">contenidor de contingut</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29107_1506638_1969563"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A named category of content types that is used to organize content types of a similar purpose.</descrip></descripGrp><ntig><termGrp><term id="1506638">content type group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969563">grup de tipus de contingut</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29108_1506639_1969564"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A unique identifier that is assigned to a content type.</descrip></descripGrp><ntig><termGrp><term id="1506639">content type identifier</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969564">identificador de tipus de contingut</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29109_1506640_1969565"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The sequence in which content types are displayed.</descrip></descripGrp><ntig><termGrp><term id="1506640">content type order</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969565">orde del tipus de contingut</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2911_135487_1967476"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A string that contains no characters.</descrip></descripGrp><ntig><termGrp><term id="135487">zero-length string</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1967476">cadena de llargària zero</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29110_1506641_1969566"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A folder that stores the resource files that are associated with a content type.</descrip></descripGrp><ntig><termGrp><term id="1506641">content type resource folder</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969566">carpeta de recursos de tipus de contingut</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29111_1506642_1969567"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An XML definition that describes the contents of a content type.</descrip></descripGrp><ntig><termGrp><term id="1506642">content type schema</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969567">esquema de tipus de contingut</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29112_1506643_1969568"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A view that is associated with a particular content type that is associated with a folder.</descrip></descripGrp><ntig><termGrp><term id="1506643">content type specific view</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969568">visualització específica de tipus de contingut</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29113_1506645_1969569"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A site that corresponds to the context of the current request.</descrip></descripGrp><ntig><termGrp><term id="1506645">context site</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969569">lloc de context</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29114_1506647_1969570"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A GUID that is used as a classification for an event receiver.</descrip></descripGrp><ntig><termGrp><term id="1506647">context type</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969570">tipus de context</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29115_1506649_1969571"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A system-defined restriction that can optionally be added to a query to restrict the query results to items that are from a specific site or list.</descrip></descripGrp><ntig><termGrp><term id="1506649">contextual search scope</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969571">àmbit de recerca contextual</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29116_1506651_1969572"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of properties that provides information about the results of crawling a display URL. The information includes whether the crawl was successful, the content source to which the display URL belongs, and the level, message, time, and identifier for any errors that occur.</descrip></descripGrp><ntig><termGrp><term id="1506651">crawl log</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969572">registre de rastreig</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29117_1506655_1969573"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A data structure that stores the list of items to crawl next.</descrip></descripGrp><ntig><termGrp><term id="1506655">crawl queue</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969573">cua de rastreig</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29118_1506657_1969574"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The state of a crawl operation.</descrip></descripGrp><ntig><termGrp><term id="1506657">crawl status</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969574">estat del rastreig</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29119_1506659_1969575"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A setting that specifies whether to evaluate all of the users and member groups in the directory service that is crawled, or only those users and member groups that were modified after the last crawl.</descrip></descripGrp><ntig><termGrp><term id="1506659">crawl type</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969575">tipus de rastreig</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29120_1506661_1969576"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A data structure that stores a list of URLs and their properties, such as when a URL was last crawled.</descrip></descripGrp><ntig><termGrp><term id="1506661">crawl URL history</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969576">historial d'URL de rastreig</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29121_1506663_1969577"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of metadata that can be discovered during a crawl and applied to one or more items. It can be mapped to a managed property.</descrip></descripGrp><ntig><termGrp><term id="1506663">crawled property</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969577">propietat rastrejada</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29122_1506664_1969578"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of crawled properties for a specific type of item.</descrip></descripGrp><ntig><termGrp><term id="1506664">crawled property category</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969578">categoria de propietat rastrejada</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29123_1506665_1969579"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A unique identifier that associates one or more crawled properties with a crawled property category.</descrip></descripGrp><ntig><termGrp><term id="1506665">crawled property set identifier</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969579">identificador del grup de propietats rastrejades</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="gramma