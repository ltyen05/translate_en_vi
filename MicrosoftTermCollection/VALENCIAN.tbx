tion">An orientation where the long dimension of a rectangular area (for example, screen, photo, or paper) is vertical.​</descrip></descripGrp><ntig><termGrp><term id="93814">portrait</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1571177">vertical</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="197_93814_1968696"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An orientation where the long dimension of a rectangular area (for example, screen, photo, or paper) is vertical.​</descrip></descripGrp><ntig><termGrp><term id="93814">portrait</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1968696">orientació vertical</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19701_673215_1970807"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An overlap between tasks that have a dependency. For example, if a task can start when its predecessor is half-finished, you can specify a finish-to-start dependency with a lead time of 50 percent for its successor [has a negative lag value].</descrip></descripGrp><ntig><termGrp><term id="673215">lead time</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970807">temps previ</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19722_673385_3072837"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The amount of light emitted onto a film or image sensor.</descrip></descripGrp><ntig><termGrp><term id="673385">exposure</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="3072837">exposició</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19729_1309629_1967443"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">When a ribbon is divided into multiple views, any one of the views. Every tab contains functionally related commands and other controls that are organized in groups. Typically, ribbon tabs are labeled.</descrip></descripGrp><ntig><termGrp><term id="1309629">ribbon tab</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1967443">pestanya de la franja</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19749_674478_1970654"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Dotted lines that show the most desirable location for the center of the next shape being dropped on the page, based on where previous shapes have been placed.</descrip></descripGrp><ntig><termGrp><term id="674478">dynamic grid</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970654">quadrícula dinàmica</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1975_73133_1646404"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A designation used to conduct sorting or searching operations.</descrip></descripGrp><ntig><termGrp><term id="73133">keyword</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1646404">paraula clau</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19767_674770_2770173"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A rating unit, e.g. assigning a "one-star rating" to an image.</descrip></descripGrp><ntig><termGrp><term id="674770">star</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2770173">estrela</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1978_45320_1566680"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To enter numbers on a device, such as telephone or mobile, in order to make a phone call.</descrip></descripGrp><ntig><termGrp><term id="45320">dial</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1566680">marcar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19780_2466458_2469077"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The audio effect ​that creates the perception that there are many more sources of sound then are currently present. This is a well-known and industry term for the technique of creating a surround sound experience for users listening to audio with regular stereo headphones.</descrip></descripGrp><ntig><termGrp><term id="2466458">virtual surround sound</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2469077">so envoltant virtual</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19780_682693_2469077"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The audio effect ​that creates the perception that there are many more sources of sound then are currently present. This is a well-known and industry term for the technique of creating a surround sound experience for users listening to audio with regular stereo headphones.</descrip></descripGrp><n