langSet></termEntry><termEntry id="27131_1365515_1588614"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An online action, such as updating a status message, publishing photos, or updating profile info.</descrip></descripGrp><ntig><termGrp><term id="1365515">activity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1588614">activitat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27134_1367496_1968536"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A reference to a table or subset of a table by the table name and column specifier instead of cell coordinates.</descrip></descripGrp><ntig><termGrp><term id="1367496">structured reference</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1968536">referència estructurada</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27137_1367505_2508158"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A commercial message that consists of a visual component (text, rich media, etc.) and associated metadata (URLs, placement information, etc.).</descrip></descripGrp><ntig><termGrp><term id="1367505">ad</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2508158">anunci</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27141_1367509_1969833"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The management command line interface built on Windows PowerShell technology that includes a set of cmdlets to help control administration and automation.</descrip></descripGrp><ntig><termGrp><term id="1367509">Lync Server Management Shell</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969833">Intèrpret d'ordes de l'administració del Lync Server</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2716_145576_1970435"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The quality that defines how much light passes through an object's pixels. If an object is 100 percent opaque, no light passes through it.</descrip></descripGrp><ntig><termGrp><term id="145576">opacity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970435">opacitat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27182_1375272_1970812"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Early or incomplete releases of one's own product, software, or services that aren't final and are put into use to test the viability, compatibility, or stability of a planned release. Although a dogfood release is often thought of as being used only internally, partners or enthusiasts may also be invited to try it.</descrip></descripGrp><ntig><termGrp><term id="1375272">internal release</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970812">versió interna</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27185_1367786_1968307"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A service that provides information about the location of a caller who calls 9-1-1.</descrip></descripGrp><ntig><termGrp><term id="1367786">Enhanced 9-1-1</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1968307">Servei d'emergències 112</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27185_1367786_1969837"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A service that provides information about the location of a caller who calls 9-1-1.</descrip></descripGrp><ntig><termGrp><term id="1367786">Enhanced 9-1-1</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><ter