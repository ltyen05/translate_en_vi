ps.</descrip></descripGrp><ntig><termGrp><term id="1809933">video storage</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2508448">emmagatzematge de vídeo</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33702_1810821_2508430"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The document that covers how users may use Skype software, Skype products, and the Skype website.</descrip></descripGrp><ntig><termGrp><term id="1810821">Terms of Use</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2508430">Condicions d'ús</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33703_1810823_2508407"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables the user to connect to public WiFi hotspots, paying per minute with Skype Credit.</descrip></descripGrp><ntig><termGrp><term id="1810823">Skype WiFi</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2508407">Wi-Fi de Skype</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33707_1810831_2508406"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An electronic coupon that can be bought from selected retail outlets to top up Skype Credit.</descrip></descripGrp><ntig><termGrp><term id="1810831">Skype voucher</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2508406">val de Skype</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33708_1811255_2508420"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A free internet call between two or more Skype users.</descrip></descripGrp><ntig><termGrp><term id="1811255">Skype-to-Skype call</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2508420">trucada entre usuaris de Skype</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3371_142397_1967611"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A data-entry field on a page. A site visitor supplies information in a field either by typing text or by selecting a field.</descrip></descripGrp><ntig><termGrp><term id="142397">form field</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="19676