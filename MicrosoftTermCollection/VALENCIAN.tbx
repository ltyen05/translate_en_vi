. When the user selects a phone number, Lync or Office Communicator places the call.</descrip></descripGrp><ntig><termGrp><term id="185609">Call</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1968091">Truca</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3305_203181_2192523"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The video format with the same resolution as traditional television.</descrip></descripGrp><ntig><termGrp><term id="203181">standard definition</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2192523">SD</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3305_203182_2192523"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The video format with the same resolution as traditional television.</descrip></descripGrp><ntig><termGrp><term id="203182">SD</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2192523">SD</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33075_1749609_2737564"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A computer that enables internal users to share audio and video data with external users.</descrip></descripGrp><ntig><termGrp><term id="1749609">A/V Edge server</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2737564">servidor perimetral A/V</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33083_1754526_1757988"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The automatic display of photos in Windows Photos in a grid-like pattern based on metadata from the photos that are connected to the user's account.</descrip></descripGrp><ntig><termGrp><term id="1754526">photo mix</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1757988">mescla de fotos</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33084_1755584_1757975"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A function relevant to an app in use that is displayed on the app bar.</descrip></descripGrp><ntig><termGrp><term id="1755584">app command</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1757975">orde de l'aplicació</t