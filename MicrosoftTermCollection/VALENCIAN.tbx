mber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38633_2247562_2250767"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A work area on a computer screen that contains different groups of apps or content open and available for different tasks or aspects of your life.</descrip></descripGrp><ntig><termGrp><term id="2247562">virtual desktop</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2250767">escriptori</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38633_2247562_2250772"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A work area on a computer screen that contains different groups of apps or content open and available for different tasks or aspects of your life.</descrip></descripGrp><ntig><termGrp><term id="2247562">virtual desktop</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2250772">escriptori virtual</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38633_2247563_2250767"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A work area on a computer screen that contains different groups of apps or content open and available for different tasks or aspects of your life.</descrip></descripGrp><ntig><termGrp><term id="2247563">desktop</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2250767">escriptori</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38633_2247563_2250772"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A work area on a computer screen that contains different groups of apps or content open and available for different tasks or aspects of your life.</descrip></descripGrp><ntig><termGrp><term id="2247563">desktop</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2250772">escriptori virtual</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38638_2247833_2250769"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The user accounts that are connected as a family. This feature allows adults to manage kids’ experiences within the kids’ user account.</descrip></descripGrp><ntig><termGrp><term id="2247833">Microsoft family</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2250769">família de Microsoft</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38639_224783