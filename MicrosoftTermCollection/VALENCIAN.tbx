927"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A search ad that automatically target relevant search queries based on the content of your website, and is dynamically created to respond to these search queries.</descrip></descripGrp><ntig><termGrp><term id="3031668">DSA</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="3032927">DSA</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53215_3031668_3032928"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A search ad that automatically target relevant search queries based on the content of your website, and is dynamically created to respond to these search queries.</descrip></descripGrp><ntig><termGrp><term id="3031668">DSA</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="3032928">anunci dinàmic de recerca</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53216_3031669_3032929"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A search ad that allows you to set multiple ad headlines and ad descriptions within a single ad.</descrip></descripGrp><ntig><termGrp><term id="3031669">responsive search ad</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><te