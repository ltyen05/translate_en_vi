set of reports or other data that is arranged in a panel format on a single page, or series of pages, in a web browser or SharePoint site.</descrip></descripGrp><ntig><termGrp><term id="210054">dashboard</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2696207">tauler</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9733_1981778_2622977"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A pre-released version of a product that is sent to customers and partners for evaluation and feedback.</descrip></descripGrp><ntig><termGrp><term id="1981778">technical preview</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2622977">visualització prèvia tècnica</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9733_694772_2622977"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A pre-released version of a product that is sent to customers and partners for evaluation and feedback.</descrip></descripGrp><ntig><termGrp><term id="694772">beta product</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2622977">visualització prèvia tècnica</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpee