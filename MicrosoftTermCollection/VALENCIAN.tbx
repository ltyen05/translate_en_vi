rtOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969754">índex de la zona d'elements web</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29311_1507093_1969756"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process that runs a work item.</descrip></descripGrp><ntig><termGrp><term id="1507093">work item process</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969756">procés de l'element de treball</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29312_1507094_1969757"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A GUID that is used to identify a work item type.</descrip></descripGrp><ntig><termGrp><term id="1507094">work item type identifier</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969757">identificador de tipus d'element de treball</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29313_1507095_1969758"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file that contains a byte stream representation of a workbook.</descrip></descripGrp><ntig><termGrp><term id="1507095">workbook file</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969758">fitxer del llibre de treball</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29314_1507096_1969759"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An object that is associated with a workbook.</descrip></descripGrp><ntig><termGrp><term id="1507096">workbook object</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969759">objecte del llibre de treball</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29315_1507097_1969760"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A single cell that is designated to receive input from a user.</descrip></descripGrp><ntig><termGrp><term id="1507097">workbook parameter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969760">paràmetre del llibre de treball</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29316_1507098_1969761"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of display settings, such as the height and width, for the windows in a workbook.</descrip></descripGrp><ntig><termGrp><term id="1507098">workbook view</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969761">visualització del llibre de treball</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29317_1507099_1969762"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An association of a workflow template to a specific list or content type.</descrip></descripGrp><ntig><termGrp><term id="1507099">workflow association</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969762">associació del flux de treball</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29318_1507100_1969763"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An implementation-specific file that is a part of a workflow. The workflow configuration file contains information that is necessary to create a workflow template from the specified workflow markup and rules files, and to associate it to a specific list.</descrip></descripGrp><ntig><termGrp><term id="1507100">workflow configuration file</term><termNote type="partOfSpeech">Noun</termNote><termNote typ