ig><termGrp><term id="184819">Internet connection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1968147">connexió web</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11218_236993_1568551"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A connection between the user's device and a server that provides access to the Internet, typically through an Internet service provider.</descrip></descripGrp><ntig><termGrp><term id="236993">web connection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1568551">connexió a Internet</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11218_236993_1968147"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A connection between the user's device and a server that provides access to the Internet, typically through an Internet service provider.</descrip></descripGrp><ntig><termGrp><term id="236993">web connection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1968147">connexió web</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11221_361626_1968950"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of creating an index of the content.</descrip></descripGrp><ntig><termGrp><term id="361626">content indexing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1968950">indexació del contingut</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11225_231967_1967739"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tool that helps you create or edit a formula and also provides information about functions and their arguments.</descrip></descripGrp><ntig><termGrp><term id="231967">Formula Palette</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1967739">paleta de fórmules</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11225_231967_1967752"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tool that helps you create or edit a formula and also provides information about functions and their arguments.</descrip></descripGrp><ntig><termGrp><term id="231967">Formula Palette</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1967752">Creador de fórmules</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11225_477232_1967739"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tool that helps you create or edit a formula and also provides information about functions and their arguments.</descrip></descripGrp><ntig><termGrp><term id="477232">Formula Builder</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1967739">paleta de fórmules</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11225_477232_1967752"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tool that helps you create or edit a formula and also provides information about functions and their arguments.</descrip></descripGrp><ntig><termGrp><term id="477232">Formula Builder</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1967752">Creador de fórmules</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11229_231980_1967745"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The area of the Query window that displays the tables in a query. Each table displays the fields from which you can retrieve data.</descrip></descripGrp><ntig><termGrp><term id="231980">table pane</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1967745">subfinestra de taules</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11232_231971_1967640"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In a PivotTable report, the summarized data calculated from the data fields of a source list or table.</descrip></descripGrp><ntig><termGrp><term id="231971">PivotTable data</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1967640">dades de la taula dinàmica</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11239_90209_1968695"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The request by a user's browser for a Web page. The number of requests to view a page can indicate the frequency with which an ad is viewed.</descrip></descripGrp><ntig><termGrp><term id="90209">page view</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1968695">visualització de pàgines</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1124_49642_1563771"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of routines that an application uses to request and carry out lower-level services performed by a computer's or device's operating system. These routines usually carry out maintenance tasks such as managing files and displaying information.</descrip></descripGrp><ntig><termGrp><term id="49642">API</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1563771">API</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1124_49644_1563771"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of routines that an application uses to request and carry out lower-level services performed by a computer's or device's operating system. These routines usually carry out maintenance tasks such as managing files and displaying information.</descrip></descripGrp><ntig><termGrp><term id="49644">application program interface</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1563771">API</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1124_49645_1563771"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of routines that an application uses to request and carry out lower-level services performed by a computer's or device's operating system. These routines usually carry out maintenance tasks such as managing files and displaying information.</descrip></descripGrp><ntig><termGrp><term id="49645">application programming interface</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1563771">API</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11241_1998713_2014182"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A character used to control the format of displayed or printed information, rather than to represent a particular letter, digit, or other special character. The space ( ) is one of the more important nonprinting characters.</descrip></descripGrp><ntig><termGrp><term id="1998713">non-printable character</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2014182">caràcter no imprimible</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11241_85464_2014182"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A character used to control the format of displayed or printed information, rather than to represent a particular letter, digit, or other special character. The space ( ) is one of the more important nonprinting characters.</descrip></descripGrp><ntig><termGrp><term id="85464">nonprinting character</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2014182">caràcter no imprimible</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11246_24169_1564505"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To scan a database, a list of files, or the Internet, either for a particular item or for anything that seems to be of interest.</descrip></descripGrp><ntig><termGrp><term id="24169">browse</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1564505">navegar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11246_385260_1564505"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To scan a database, a list of files, or the Internet, either for a particular item or for anything that seems to be of interest.</descrip></descripGrp><ntig><termGrp><term id="385260">browse for</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1564505">navegar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11249_1166159_1568531"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Light that is beyond red in the color spectrum. While the light is not visible to the human eye, infrared transmitters and receivers can send and receive infrared signals.</descrip></descripGrp><ntig><termGrp><term id="1166159">infrared light</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1568531">infrarojos</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11249_66343_1568531"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Light that is beyond red in the color spectrum. While the light is not visible to the human eye, infrared transmitters and receivers can send and receive infrared signals.</descrip></descripGrp><ntig><termGrp><term id="66343">infrared</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1568531">infrarojos</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11249_66344_1568531"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Light that is beyond red in the color spectrum. While the light is not visible to the human eye, infrared transmitters and receivers can send and receive infrared signals.</descrip></descripGrp><ntig><termGrp><term id="66344">IR</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1568531">infrarojos</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1125_1359070_1967327"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An operator in the relational algebra used in database management that, when applied to two existing relations (tables), results in the creation of a new table containing all possible ordered concatenations (combinations) of tuples (rows) from the first relation with tuples from the second. The number of rows in the resulting relation is the product of the number of rows in the two source relations.</descrip></descripGrp><ntig><termGrp><term id="1359070">cross product</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1967327">producte de creu</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1125_28192_1967327"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An operator in the relational algebra used in database management that, when applied to two existing relations (tables), results in the creation of a new table containing all possible ordered concatenations (combinations) of tuples (rows) from the first relation with tuples from the second. The number of rows in the resulting relation is the product of the number of rows in the two source relations.</descrip></descripGrp><ntig><termGrp><term id="28192">Cartesian product</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1967327">producte de creu</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11254_188104_1968813"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A person who identifies the business needs of their clients to help determine solutions to business problems. This person has a strong knowledge of business activity monitoring and enterprise process management. This person analyzes multidimensional business information based on key performance indicators and is a liaison between senior management and the IT staff.</descrip></descripGrp><ntig><termGrp><term id="188104">business analyst</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1968813">analista de negocis</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11255_142286_1970428"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Embedding a limited number of characters specific to one font, reducing file size.</descrip></descripGrp><ntig><termGrp><term id="142286">font subsetting</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970428">subclasse del tipus de lletra</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11257_211083_1568507"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables records managers to create and manage entries to a “Holds list” such that any document, image, or webpage on that list cannot be deleted, modified, or allowed to expire until the item is removed from the list. The feature is typically used for items that are subject to events such as litigation, audits, or investigations.</descrip></descripGrp><ntig><termGrp><term id="211083">Hold</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1568507">Suspensió</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11262_178633_1968767"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A product sent to a customer.</descrip></descripGrp><ntig><termGrp><term id="178633">delivery</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1968767">entrega</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11264_233734_1968858"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of files that can be delivered as a unit to a client computer or device for installation.</descrip></descripGrp><ntig><termGrp><term id="233734">deployment package</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1968858">paquet d'implementació</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11268_2461481_1816610"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Control Panel feature that is used to set restrictions on what traffic is allowed to enter your network from the Internet.</descrip></descripGrp><ntig><termGrp><term id="2461481">Windows Defender Firewall</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1816610">Tallafoc del Windows</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11268_2461481_2465636"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Control Panel feature that is used to set restrictions on what traffic is allowed to enter your network from the Internet.</descrip></descripGrp><ntig><termGrp><term id="2461481">Windows Defender Firewall</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2465636">Tallafoc del Windows Defender</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11280_133179_1572469"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A utility that enables the user to locate and open files and folders.</descrip></descripGrp><ntig><termGrp><term id="133179">Windows Explorer</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1572469">Explorador del Windows</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11280_133179_1708209"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A utility that enables the user to locate and open files and folders.</descrip></descripGrp><ntig><termGrp><term id="133179">Windows Explorer</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1708209">Explorador de fitxers</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11280_1707188_1572469"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A utility that enables the user to locate and open files and folders.</descrip></descripGrp><ntig><termGrp><term id="1707188">File Explorer</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1572469">Explorador del Windows</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11280_1707188_1708209"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A utility that enables the user to locate and open files and folders.</descrip></descripGrp><ntig><termGrp><term id="1707188">File Explorer</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1708209">Explorador de fitxers</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11281_359989_1967509"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The section of a module containing declarations that apply to every procedure in the module. It can include declarations for variables, constants, user-defined data types, and external procedures in a dynamic-link library.</descrip></descripGrp><ntig><termGrp><term id="359989">Declarations section</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1967509">secció Declaracions</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11291_27974_1568541"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The location where text or graphics will be inserted. Also used for text box controls to indicate input focus.</descrip></descripGrp><ntig><termGrp><term id="27974">insertion point</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1568541">punt d'inserció</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11291_27975_1568541"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The location where text or graphics will be inserted. Also used for text box controls to indicate input focus.</descrip></descripGrp><ntig><termGrp><term id="27975">system caret</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1568541">punt d'inserció</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11303_232405_1969976"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The status applied to blocks of time in a user's Calendar to indicate that the user will be away.</descrip></descripGrp><ntig><termGrp><term id="232405">Out of Office</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969976">Fora de l'oficina</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</te