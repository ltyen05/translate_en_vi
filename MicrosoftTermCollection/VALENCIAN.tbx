ngSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969582">associació de flux de treball declaratiu</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29127_1506672_1969583"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The view of a list that is defined by the owner of the list to appear when users browse to the list without specifying a view.</descrip></descripGrp><ntig><termGrp><term id="1506672">default list view</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969583">visualització de llista per defecte</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29128_1506676_1969584"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The view of a list that is defined by the owner of the list to appear when users browse to the list from a mobile device without specifying a view.</descrip></descripGrp><ntig><termGrp><term id="1506676">default mobile list view</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969584">visualització de llista mòbil per defecte</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29129_1506679_1969585"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The search scope that is assigned automatically to a search scope display group.</descrip></descripGrp><ntig><termGrp><term id="1506679">default search scope</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969585">àmbit de recerca per defecte</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29130_1506681_1969586"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An object that is created as part of a site or site collection. Examples of deployment system objects are root folders, catalogs, default pages, and galleries that are created during site or site collection creation. A deployment system object is not part of a template.</descrip></descripGrp><ntig><termGrp><term id="1506681">deployment system object</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969586">objecte del sistema d'implementació</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29131_1506685_1969587"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Any content type that inherits from another content type.</descrip></descripGrp><ntig><termGrp><term id="1506685">descendant content type</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969587">tipus de contingut descendent</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29132_1506687_1969588"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A sort order in which text strings are arranged in reverse alphabetical order, numerical values are arranged from largest to smallest, and dates and times are arranged from newest to oldest.</descrip></descripGrp><ntig><termGrp><term id="1506687">descending order</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969588">orde descendent</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29132_1506687_3146544"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A sort order in which text strings are arranged in reverse alphabetical order, numerical values are arranged from largest to smallest, and dates and times are arranged from newest to oldest.</descrip></descripGrp><ntig><termGrp><term id="1506687">descending order</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="3146544">De la Z a la A</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp><