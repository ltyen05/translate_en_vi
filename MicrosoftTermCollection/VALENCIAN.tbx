ields.</descrip></descripGrp><ntig><termGrp><term id="347933">attribute field</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1968923">camp d'atribut</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7044_76326_1968453"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A record in a log file.</descrip></descripGrp><ntig><termGrp><term id="76326">log entry</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1968453">entrada del registre</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="705_2070045_1566790"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A graphic design applied to a collection of numbers, symbols, and characters and that describes a certain typeface, along with other qualities such as size, spacing, and pitch.</descrip></descripGrp><ntig><termGrp><term id="2070045">font resource</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1566790">tipus de lletra</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langS