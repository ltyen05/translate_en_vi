ographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48006_2703742_2708571"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process that allows the redemption of invitations to be automated.</descrip></descripGrp><ntig><termGrp><term id="2703742">auto redeem</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2708571">bescanvi automàtic</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48008_2703744_2708577"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To go through the invitation redemption process to gain access to resources.</descrip></descripGrp><ntig><termGrp><term id="2703744">redeem</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2708577">bescanviar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4801_235057_1770740"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A wizard that guides the user through installing a printer on their network.</descrip></descripGrp><ntig><termGrp><term id="235057">Network Printer Installation Wizard</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">S