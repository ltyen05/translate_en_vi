rust relationship between two or more SIP domains that permits users in separate organizations to communicate in real time across network boundaries.</descrip></descripGrp><ntig><termGrp><term id="180264">federation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1968133">federació</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11974_148915_1967498"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Visual Basic for Applications (VBA) procedure that carries out an operation, but unlike a Function procedure, does not return a value.</descrip></descripGrp><ntig><termGrp><term id="148915">Sub procedure</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1967498">procediment SUB</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11976_185681_2508224"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An item on the right-click menu for the Communicator icon that appears in the Windows taskbar that signs the user out of Communicator and closes all open Communicator windows and dialog boxes.</descrip></descripGrp><ntig><termGrp><term id="185681">Exit</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term i