59"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows the user to convert an image of writing to editable digital ink.</descrip></descripGrp><ntig><termGrp><term id="2445824">ink grab</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2448559">conversió a entrada manuscrita</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43167_2453892_2448561"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature which allows you to stay connected and quickly interact and share with the people you care about most.</descrip></descripGrp><ntig><termGrp><term id="2453892">My People</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2448561">La meua gent</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43169_2445827_2448563"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The major Windows 10 update to be released in Spring 2017, focused on creativity, 3D and mixed reality, 4K gaming, game broadcasting, among other features for both consumer and enterprise audiences.</descrip></descripGrp><ntig><termGrp><term id="2445827">Windows 10 Creators Update</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="