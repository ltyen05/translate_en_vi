5391_1970446"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An object that is inserted into a document from a source file and that is updated when the original source file is updated.</descrip></descripGrp><ntig><termGrp><term id="75391">linked object</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970446">objecte enllaçat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4631_158674_1970114"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The menu for a group of ready-made shapes that includes basic shapes, such as rectangles and circles, plus a variety of lines and connectors, block arrows, flowchart symbols, stars and banners, and callouts.</descrip></descripGrp><ntig><termGrp><term id="158674">AutoShapes</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970114">Formes automàtiques</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46310_2608183_2609769"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A web part that is offered as default for the design of a SharePoint communication site.</descrip></descripGrp><ntig><termGrp><term id="2608183">default hero</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2609769">element web destacat per defecte</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46325_2608792_2609771"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SharePoint site created or managed by few people to broadcast information out to a broad audience.</descrip></descripGrp><ntig><termGrp><term id="2608792">communication site</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2609771">lloc de comunicació</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46330_2609539_2663839"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app that enables Cortana to take over your mouse pointer and literally show you how to change a setting when you ask her to "show me (how to do something)." She performs each step for you in a sequence of clicks needed to make a particular change in Windows Settings.</descrip></descripGrp><ntig><termGrp><term id="2609539">Cortana Show Me</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2663839">Cortana Show Me</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46337_2609835_2785529"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To plan an event for a specific time slot.</descrip></descripGrp><ntig><termGrp><term id="2609835">schedule</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2785529">planificar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46341_2610077_2611046"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The consumer-facing name for Hypervisor Code Integrity (HVCI). The HVCI service in Windows 10 determines whether code executing in kernel mode is securely designed and trustworthy, and helps ensure that all software running in kernel mode, including drivers, securely allocate memory and operate as they are intended.</descrip></descripGrp><ntig><termGrp><term id="2610077">memory integrity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2611046">integritat de la memòria</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46344_2834959_2836050"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The desktop-only sync app for OneDrive that enables on-demand file sharing and navigation in File Explorer and that comes pre-installed on PCs.</descrip></descripGrp><ntig><termGrp><term id="2834959">Microsoft OneDrive sync</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2836050">Sincronització del Microsoft OneDrive</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46344_2834959_2836051"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The desktop-only sync app for OneDrive that enables on-demand file sharing and navigation in File Explorer and that comes pre-installed on PCs.</descrip></descripGrp><ntig><termGrp><term id="2834959">Microsoft OneDrive sync</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2836051">Sincronització del OneDrive</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46344_2834960_2836050"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The desktop-only sync app for OneDrive that enables on-demand file sharing and navigation in File Explorer and that comes pre-installed on PCs.</descrip></descripGrp><ntig><termGrp><term id="2834960">OneDrive sync</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2836050">Sincronització del Microsoft OneDrive</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">M