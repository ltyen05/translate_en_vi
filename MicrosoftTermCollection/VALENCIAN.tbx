maticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1967432">botó del Microsoft Office</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20655_732027_1967433"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A button that replaces the File menu beginning with some 2007 Microsoft Office system programs.</descrip></descripGrp><ntig><termGrp><term id="732027">Microsoft Office Button</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1967433">botó de l'Office</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20655_747784_1967432"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A button that replaces the File menu beginning with some 2007 Microsoft Office system programs.</descrip></descripGrp><ntig><termGrp><term id="747784">Office Button</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1967432">botó del Microsoft Office</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20655_747784_1967433"><langSet xml:lang="en-US"><descripGrp><de