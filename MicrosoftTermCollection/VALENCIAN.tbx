"147895">result set</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1571274">resultats</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3539_147895_1967427"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of records that results from running a query or applying a filter.</descrip></descripGrp><ntig><termGrp><term id="147895">result set</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1967427">conjunt de resultats</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3539_308341_1571274"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of records that results from running a query or applying a filter.</descrip></descripGrp><ntig><termGrp><term id="308341">results</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1571274">resultats</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3539_308341_1967427"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of records that results from running a query or applying a filter.</descrip></descripGrp><ntig><termGrp><term id="308341">results</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1967427">conjunt de resultats</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35390_2029084_2036703"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The edition of Windows 8.1 Pro that is optimized for students and educational institutions.</descrip></descripGrp><ntig><termGrp><term id="2029084">Windows 8.1 Pro for Education</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2036703">Windows 8.1 Pro for Education</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35391_2029155_2036613"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A service that establishes a simple flow for learning about and using authenticated Microsoft Online Services endpoints for a given user. It is a single point where a developer can start, pass the user identity, get information to initiate authorization flows, get the hosting location of services for that user, and get the endpoints to the service.</descrip></descripGrp><ntig><termGrp><term id="2029155">Discovery Service</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2036613">Servei de detecció</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35392_2029156_2036620"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of web services built on top of the Office 365 platform that makes available Office 365 components or data, such as documents, spreadsheets, presentations, calendars, mail, contacts, and tasks. These services are available from within apps for Office, apps for SharePoint, and also from third-party sites or applications who want to use Office 365 components, but are hosted on another platform, such as Microsoft Azure.</descrip></descripGrp><ntig><termGrp><term id="2029156">Office 365 APIs</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2036620">API de l'Office 365</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35393_2029157_2036617"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that creates a template for a sensitive information type from a form, which can then be used to define transport rules, prevent oversharing of information, and create Data Loss Protection policies.</descrip></descripGrp><ntig><termGrp><term id="2029157">Document Fingerprinting</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2036617">Creació d'empremta digital de document</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35394_2029266_2036699"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The software update to Windows 8.1 Enterprise that gives users a more familiar and convenient experience across touch, keyboard and mouse inputs and enables more affordable Windows device choices.</descrip></descripGrp><ntig><termGrp><term id="2029266">Windows 8.1 Enterprise Update</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2036699">Windows 8.1 Enterprise Update</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35395_2029267_2036713"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The software update to Windows 8.1 Single Language that gives users a more familiar and convenient experience across touch, keyboard and mouse inputs and enables more affordable Windows device choices.</descrip></descripGrp><ntig><termGrp><term id="2029267">Windows 8.1 Single Language Update</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2036713">Windows 8.1 Single Language Update</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35396_2029268_2036709"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The software update to Windows 8.1 Pro with Media Center that gives users a more familiar and convenient experience across touch, keyboard and mouse inputs and enables more affordable Windows device choices.</descrip></descripGrp><ntig><termGrp><term id="2029268">Windows 8.1 Pro with Media Center Update</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2036709">Windows 8.1 Pro amb el Media Center Update</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35402_2110143_2033033"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application that allows the user to track financial market conditions, including personal portfolio tracking, finance articles, tools and calculator for common financial tasks.</descrip></descripGrp><ntig><termGrp><term id="2110143">MSN Money</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2033033">Finances</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35402_2110143_2033040"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application that allows the user to track fi