inition">A specified amount of processing performed as a unit by a computer.</descrip></descripGrp><ntig><termGrp><term id="71392">job</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1569455">faena</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15371_210471_1970822"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A logical unit consisting of shared services and shared resources. A farm could have multiple SRPs.</descrip></descripGrp><ntig><termGrp><term id="210471">Shared Resource Provider</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970822">Proveïdor de recursos compartits</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15371_210471_1970823"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A logical unit consisting of shared services and shared resources. A farm could have multiple SRPs.</descrip></descripGrp><ntig><termGrp><term id="210471">Shared Resource Provider</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970823">SRP</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><term