<ntig><termGrp><term id="2906525">Designer</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2907160">Dissenyador</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39475_2295325_2300743"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The service for downloading Windows updates and Windows Store apps from sources in addition to Microsoft and sending them to other PCs in a local network or on the Internet reducing the amount of Internet bandwidth needed.</descrip></descripGrp><ntig><termGrp><term id="2295325">Windows Update Delivery Optimization</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2300743">Optimització del lliurament</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39475_2295325_2300744"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The service for downloading Windows updates and Windows Store apps from sources in addition to Microsoft and sending them to other PCs in a local network or on the Internet reducing the amount of Internet bandwidth needed.</descrip></descripGrp><ntig><termGrp><term id="2295325">Windows Update Delivery Optimization</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="c