e type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44765_2520275_3115146"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that enables customers to control access to rows in a database table based on the characteristics of the user executing a query (e.g., group membership or execution context).</descrip></descripGrp><ntig><termGrp><term id="2520275">RLS</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="3115146">seguretat de nivell de fila</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44765_3114827_3115146"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that enables customers to control access to rows in a database table based on the characteristics of the user executing a query (e.g., group membership or execution context).</descrip></descripGrp><ntig><termGrp><term id="3114827">row-level security</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="3115146">seguretat de nivell de fila</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44776_2520537_2521979"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A message that contains an actionable message card.</descrip></descripGrp><ntig><termGrp><term id="2520537">actionable message</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2521979">missatge accionable</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44795_2520655_2523199"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The capability of Microsoft Defender Advanced Threat Protection, which helps protect against malware that uses exploits to infect devices and spread.</descrip></descripGrp><ntig><termGrp><term id="2520655">Exploit Protection</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2523199">Protecció contra vulnerabilitats</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="448_93293_1571173"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An input device used to control an on-screen cursor for such actions as "pressing" on-screen buttons in dialog boxes, choosing menu items, and selecting ranges of cells in spreadsheets or groups of words in a document.</descrip></descripGrp><ntig><termGrp><term id="93293">pointing device</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1571173">dispositiu assenyalador</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44809_2521577_2523937"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Excel add-in that finds functions needed to transform and format data when the user gives it examples of the desired output.</descrip></descripGrp><ntig><termGrp><term id="2521577">Transform Data by Example</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2523937">Transform Data by Example</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4481_1133582_1997607"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Windows feature that allows users to connect remotely to a computer and access programs, files, and network resources as though they were sitting at the computer.</descrip></descripGrp><ntig><termGrp><term id="1133582">RD</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1997607">escriptori remot</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4481_543804_1997607"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Windows feature that allows users to connect remotely to a computer and access programs, files, and network resources as though they were sitting at the computer.</descrip></descripGrp><ntig><termGrp><term id="543804">Remote Desktop</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1997607">escriptori remot</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44810_2521581_2526314"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A membership where admittance is based on rules, making it easy for administrators to manage large groups.</descrip></descripGrp><ntig><termGrp><term id="2521581">dynamic membership</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2526314">pertinença dinàmica</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44811_2521582_2526309"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group where membership is maintained by a set of rules created by an administrator.</descrip></descripGrp><ntig><termGrp><term id="2521582">dynamic group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2526309">grup dinàmic</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44814_2522595_2526315"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A sudden burst of light used to illuminate a dark scene so that features are visible in the captured image.</descrip></descripGrp><ntig><termGrp><term id="2522595">flash</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2526315">flaix</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44815_2522648_2526320"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An element in a vector graphic.</descrip></descripGrp><ntig><termGrp><term id="2522648">vector object</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2526320">element vectorial</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44816_2522672_2813771"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office Lens mode that recognizes pictures of business cards so that when they are saved to OneNote, Office Lens will automatically recognize the card’s contact information and format it nicely into a OneNote notebook.</descrip></descripGrp><ntig><termGrp><term id="2522672">Business Card</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2813771">Targeta de visita</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44818_2522794_2526292"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pointing in the direction of the user of the device.</descrip></descripGrp><ntig><termGrp><term id="2522794">front facing</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2526292">frontal</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44819_2522797_2526290"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pointing away from the direction of the user of the device.</descrip></descripGrp><ntig><termGrp><term id="2522797">back facing</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2526290">posterior</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44820_2522800_2526318"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A piece of code incorporated into a project that was not written by the owners of the project.</descrip></descripGrp><ntig><termGrp><term id="2522800">third-party code</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2526318">codi de tercers</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44823_2524057_2576065"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A hardware accessory that allows you to take action in mixed reality. It tracks a precise position in space, allowing for fine-grained interaction with digital objects. When using a Windows Mixed Reality immersive headset, the motion controller is the primary way to take action.</descrip></descripGrp><ntig><termGrp><term id="2524057">motion controller</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2576065">comandament de moviment</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44823_2524057_2576066"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A hardware accessory that allows you to take action in mixed reality. It tracks a precise position in space, allowing for fine-grained interaction with digital objects. When using a Windows Mixed Reality immersive headset, the motion controller is the primary way to take action.</descrip></descripGrp><ntig><termGrp><term id="2524057">motion controller</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2576066">comandament de moviment del Windows Mixed Reality</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44823_2531456_2576065"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A hardware accessory that allows you to take action in mixed reality. It tracks a precise position in space, allowing for fine-grained interaction with digital objects. When using a Windows Mixed Reality immersive headset, the motion controller is the primary way to take action.</descrip></descripGrp><ntig><termGrp><term id="2531456">Windows Mixed Reality motion controller</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2576065">comandament de moviment</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44823_2531456_2576066"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A hardware accessory that allows you to take action in mixed reality. It tracks a precise position in space, allowing for fine-grained interaction with digital objects. When using a Windows Mixed Reality immersive headset, the motion controller is the primary way to take action.</descrip></descripGrp><ntig><termGrp><term id="2531456">Windows Mixed Reality motion controller</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2576066">comandament de moviment del Windows Mixed Reality</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44824_2524653_2526920"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Windows 10 update announced at Build 2017 and being released in the Sept-Nov 2017 timeframe.</descrip></descripGrp><ntig><termGrp><term id="2524653">Windows 10 Fall Creators Update</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2526920">Windows 10 Fall Creators Update</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44825_2524668_2526877"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature in Windows Defender Security Center that monitors your device and provides you with information and recommendations in a Health report to address common issues with your storage capacity, device drivers, battery life, or Windows Update.</descrip></descripGrp><ntig><termGrp><term id="2524668">Health Advisor</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2526877">Assessor d'estat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44826_2524671_2526876"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature in Windows Defender Security Center that helps you refresh your device by reinstalling and updating Windows — for example, if your device has performance issues or you have too many unnecessary apps.</descrip></descripGrp><ntig><termGrp><term id="2524671">Fresh Start</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2526876">Inici de zero</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44827_2524676_2526894"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The pre-release version of Microsoft Remote Desktop app.</descrip></descripGrp><ntig><termGrp><term id="2524676">Microsoft Remote Desktop Preview</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2526894">Visualització prèvia de l'Escriptori remot de Microsoft</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44827_2524676_2611049"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The pre-release version of Microsoft Remote Desktop app.</descrip></descripGrp><ntig><termGrp><term id="2524676">Microsoft Remote Desktop Preview</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2611049">Visualització prèvia de l'Escriptori remot</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44827_2609623_2526894"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The pre-release version of Microsoft Remote Desktop app.</descrip></descripGrp><ntig><termGrp><term id="2609623">Remote Desktop Preview</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2526894">Visualització prèvia de l'Escriptori remot de Microsoft</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44827_2609623_2611049"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The pre-release version of Microsoft Remote Desktop app.</descrip></descripGrp><ntig><termGrp><term id="2609623">Remote Desktop Preview</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2611049">Visualització prèvia de l'Escriptori remot</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44828_2524681_2526871"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The period of time when users are required to schedule a restart.</descrip></descripGrp><ntig><termGrp><term id="2524681">Engaged restart</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2526871">Reinici programat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44829_2524692_2526924"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A system service that enables spatial perception, spatial input, and holographic rendering.</descrip></descripGrp><ntig><termGrp><term id="2524692">Windows Perception Service</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2526924">Servei de percepció del Windows</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4483_55751_1567248"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A structured document or template with spaces reserved for entering information and often containing special coding (e.g. to trigger data processing).</descrip></descripGrp><ntig><termGrp><term id="55751">form</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1567248">formulari</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44832_2524734_2659333"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft interactive livestreaming platform for gaming communities.</descrip></descripGrp><ntig><termGrp><term id="2524734">Mixer</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2659333">Mixer</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44842_2524849_2530057"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A presentation of visual elements in an image, especially the placement of the subject in relation to other objects.</descrip></descripGrp><ntig><termGrp><term id="2524849">frame</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2530057">marc</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44843_2524926_2526908"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A head-mounted display (HMD) that displays mixed reality experiences. Used inclusively to denote both Microsoft HoloLens and OEM devices, whether they blend virtual content within the physical world (holographic headsets), or display virtual content with a degree (big or small) of environmental awareness (immersive headsets)​. Plus, these headsets can either be self-contained (like Microsoft HoloLens - the whole computing power is contained into the headset) or PC-connected (the computing power comes from the PC and the headset cannot work without that associated PC).</descrip></descripGrp><ntig><termGrp><term id="2524926">mixed reality headset</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2526908">casc de realitat mixta</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44843_2524926_2576064"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A head-mounted display (HMD) that displays mixed reality experiences. Used inclusively to denote both Microsoft HoloLens and OEM devices, whether they blend virtual content within the physical world (holographic headsets), or display virtual content with a degree (big or small) of environmental awareness (immersive headsets)​. Plus, these headsets can either be self-contained (like Microsoft HoloLens - the whole computing power is contained into the headset) or PC-connected (the computing power comes from the PC and the headset cannot work without that associated PC).</descrip></descripGrp><ntig><termGrp><term id="2524926">mixed reality headset</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2576064">casc</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44843_2526431_2526908"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A head-mounted display (HMD) that displays mixed reality experiences. Used inclusively to denote both Microsoft HoloLens and OEM devices, whether they blend virtual content within the physical world (holographic headsets), or display virtual content with a degree (big or small) of environmental awareness (immersive headsets)​. Plus, these headsets can either be self-contained (like Microsoft HoloLens - the whole computing power is contained into the headset) or PC-connected (the computing power comes from the PC and the headset cannot work without that associated PC).</descrip></descripGrp><ntig><termGrp><term id="2526431">headset</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2526908">casc de realitat mixta</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44843_2526431_2576064"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A head-mounted display (HMD) that displays mixed reality experiences. Used inclusively to denote both Microsoft HoloLens and OEM devices, whether they blend virtual content within the physical world (holographic headsets), or display virtual content with a degree (big or small) of environmental awareness (immersive headsets)​. Plus, these headsets can either be self-contained (like Microsoft HoloLens - the whole computing power is contained into the headset) or PC-connected (the computing power comes from the PC and the headset cannot work without that associated PC).</descrip></descripGrp><ntig><termGrp><term id="2526431">headset</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2576064">casc</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44844_2524930_2526878"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A head-mounted display (HMD) that displays virtual content only and with a degree (big or small) of environmental awareness. This is a subset of "mixed reality headset."​ This is to be looked at in contrast with "holographic headsets".</descrip></descripGrp><ntig><termGrp><term id="2524930">immersive headset</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2526878">casc immersiu</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44845_2524937_2526914"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of moving from a lower version of a system to a higher version. A configuration shift where the user becomes able to change default settings which were locked before the shift.</descrip></descripGrp><ntig><termGrp><term id="2524937">switch</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><t