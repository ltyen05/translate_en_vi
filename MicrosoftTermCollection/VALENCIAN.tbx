></ntig></langSet></termEntry><termEntry id="26485_1274638_1968295"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A class for the delivery of audio media streams.</descrip></descripGrp><ntig><termGrp><term id="1274638">Expedited Forwarding</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1968295">reenviament accelerat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26485_1274638_1968296"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A class for the delivery of audio media streams.</descrip></descripGrp><ntig><termGrp><term id="1274638">Expedited Forwarding</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1968296">EF</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26485_1274639_1968295"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A class for the delivery of audio media streams.</descrip></descripGrp><ntig><termGrp><term id="1274639">EF</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1968295">reenviament accelerat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26485_1274639_1968296"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A class for the delivery of audio media streams.</descrip></descripGrp><ntig><termGrp><term id="1274639">EF</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1968296">EF</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26486_1274640_1969476"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A moving average of data that gives more weight to the more recent data in the period and less weight to the older data in the period. The formula applies weighting factors which decrease exponentially. The weighting for each older data point decreases exponentially, giving much more importance to recent observations while still not discarding older observations entirely.</descrip></descripGrp><ntig><termGrp><term id="1274640">exponential moving average</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969476">mitjana de desplaçament exponencial</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2649_67737_1568544"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of adding software to a computer system.</descrip></descripGrp><ntig><termGrp><term id="67737">installation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1568544">instal·lació</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26497_1275220_1970173"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that enables viewing of PowerPoint documents from a Web browser.</descrip></descripGrp><ntig><termGrp><term id="1275220">PowerPoint Viewing</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970173">Visualització del PowerPoint</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26502_1275260_1967811"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An interactive and flexible data filter that conveys the current filtering state.</descrip></descripGrp><ntig><termGrp><term id="1275260">slicer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1967811">afinador</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26502_1275260_2611452"><langSet xml:lang="en-US"><descripGrp><descrip type="definiti