eech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1968492">contracte de serveis</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9476_143198_1968726"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A form field that is invisible to a site visitor but supplies data to a form handler. When a form is submitted, hidden fields are passed to the form handler along with name-value pairs for each visible form field.</descrip></descripGrp><ntig><termGrp><term id="143198">Hidden field</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1968726">camp amagat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9483_55065_3074368"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To change the orientation of a selected object horizontally, vertically, or in both directions.</descrip></descripGrp><ntig><termGrp><term id="55065">flip</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="3074368">Gira</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9486_375944_1968556"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A horizontal or vertical layout guide that can be aligned to any point on a ruler.</descrip></descripGrp><ntig><termGrp><term id="375944">ruler guide</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1968556">guia de regle</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9488_115096_1967431"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A character that is not found on your keyboard and must be inserted from within the software or by pressing a combination of keys on your keyboard.</descrip></descripGrp><ntig><termGrp><term id="115096">special character</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1967431">caràcter especial</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="95_237773_1967621"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A system library used to store images that are used throughout the site collection. Provides versioning, check-in/check-out, search and visual browse capabilities.</descrip></descripGrp><ntig><termGrp><term id="237773">Site Collection Images</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1967621">Imatges de la col·lecció de llocs</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9510_162790_2915557"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An experience that is presented to end users the first time they start a new computer.</descrip></descripGrp><ntig><termGrp><term id="162790">first-run experience</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2915557">experiència de la primera execució</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9510_162790_2915559"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An experience that is presented to end users the first time they start a new computer.</descrip></descripGrp><ntig><termGrp><term id="162790">first-run experience</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2915559">EPE</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9510_214541_2915557"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An experience that is presented to end users the first time they start a new computer.</descrip></descripGrp><ntig><termGrp><term id="214541">out-of-box experience</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2915557">experiència de la primera execució</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9510_214541_2915559"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An experience that is presented to end users the first time they start a new computer.</descrip></descripGrp><ntig><termGrp><term id="214541">out-of-box experience</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2915559">EPE</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9510_214542_2915557"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An experience that is presented to end users the first time they start a new computer.</descrip></descripGrp><ntig><termGrp><term id="214542">OOBE</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2915557">experiència de la primera execució</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9510_214542_2915559"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An experience that is presented to end users the first time they start a new computer.</descrip></descripGrp><ntig><termGrp><term id="214542">OOBE</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2915559">EPE</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9510_2713702_2915557"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An experience that is presented to end users the first time they start a new computer.</descrip></descripGrp><ntig><termGrp><term id="2713702">FRE</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2915557">experiència de la primera execució</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9510_2713702_2915559"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An experience that is presented to end users the first time they start a new computer.</descrip></descripGrp><ntig><termGrp><term id="2713702">FRE</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2915559">EPE</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9514_63893_1971705"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Operational but not in use.</descrip></descripGrp><ntig><termGrp><term id="63893">idle</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1971705">inactiu</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="952_318124_1564509"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To translate all the source code of a program from a high-level language into object code prior to execution of the program.</descrip></descripGrp><ntig><termGrp><term id="318124">build</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1564509">compilar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="952_36555_1564509"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To translate all the source code of a program from a high-level language into object code prior to execution of the program.</descrip></descripGrp><ntig><termGrp><term id="36555">compile</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1564509">compilar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9521_253747_2708576"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An account provided in a local domain for a user whose regular account is not in a trusted domain. A local account cannot be used to log on interactively. Further, a local account created in one domain cannot be used in a trusted domain.</descrip></descripGrp><ntig><termGrp><term id="253747">local account</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2708576">compte local</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9529_1074776_1969329"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A dialog that allows the user to view all the rules (logic) in a form pivoted in different ways. Because the information is summarized in a centralized view, the user doesn't have to click through multiple dialogs.</descrip></descripGrp><ntig><termGrp><term id="1074776">Rules Inspector</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969329">Inspector de regles</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9536_61276_1568504"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">For a computer system, to be in an inactive state, but not shut off. When the computer is switched back on, the desktop is restored exactly as it was.</descrip></descripGrp><ntig><termGrp><term id="61276">hibernate</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1568504">hibernar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9541_415794_1969061"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A measure of profitability that is calculated by using the formula: profit margin = net income before tax and interest / revenue. It can be expressed as a percentage or a number.</descrip></descripGrp><ntig><termGrp><term id="415794">profit margin</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969061">marge de beneficis</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9543_415057_1967651"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A member of a dimension whose value is calculated at run time by using an expression. Calculated member values can be derived from the values of other members.</descrip></descripGrp><ntig><termGrp><term id="415057">calculated member</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1967651">membre calculat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9544_16314_1968437"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The type of information contained by an attribute, such as quarters or months in a time dimension, which may enable specific treatment by the server and client applications.</descrip></descripGrp><ntig><termGrp><term id="16314">attribute type</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1968437">tipus d'atribut</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9552_266832_1967816"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A secondary data source that is accessible to users who fill out forms offline. When a user is online, data from the data source is stored on the user’s computer so that it can appear in controls when the form is offline.</descrip></descripGrp><ntig><termGrp><term id="266832">offline data source</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1967816">origen de dades fora de línia</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9555_139836_1566661"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A field you can create. A custom field can be a blank, combination, or formula field.</descrip></descripGrp><ntig><termGrp><term id="139836">custom field</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1566661">camp personalitzat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9564_413294_1967959"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The primary function of the server, as enabled by the grouping of features and services that the server administrator specifies.</descrip></descripGrp><ntig><termGrp><term id="413294">server role</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1967959">funció del servidor</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9566_323154_1572359"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To start or reset a computer by turning the power on, by pressing a reset button on the computer case, or by issuing a software command to restart.</descrip></descripGrp><ntig><termGrp><term id="323154">start</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1572359">iniciar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="957_117447_2323112"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Dialog from film or video displayed on the screen (usually at the bottom) and typically used to provide translation from a foreign language.</descrip></descripGrp><ntig><termGrp><term id="117447">subtitle</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2323112">subtítol</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9570_3951_1970205"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The engine at the core of managed code execution. The runtime supplies managed code with services such as cross-language integration, code access security, object lifetime management, and debugging and profiling support.</descrip></descripGrp><ntig><termGrp><term id="3951">common language runtime</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970205">Common Language Runtime</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9570_3952_1970205"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The engine at the core of managed code execution. The runtime supplies managed code with services such as cross-language integration, code access security, object lifetime management, and debugging and profiling support.</descrip></descripGrp><ntig><termGrp><term id="3952">CLR</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970205">Common Language Runtime</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9570_714923_1970205"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The engine at the core of managed code execution. The runtime supplies managed code with services such as cross-language integration, code access security, object lifetime management, and debugging and profiling support.</descrip></descripGrp><ntig><termGrp><term id="714923">Common Language Runtime support</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970205">Common Language Runtime</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9570_725987_1970205"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The engine at the core of managed code execution. The runtime supplies managed code with services such as cross-language integration, code access 