Note type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1505_2778460_1563779"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A value that a function or a method receives from a caller to perform computations.</descrip></descripGrp><ntig><termGrp><term id="2778460">arg</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1563779">argument</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15055_116264_1572363"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The condition at a particular time of any of numerous elements of computing--a device, a communications channel, a network station, a program, a bit, or other element--used to report on or to control computer operations.</descrip></descripGrp><ntig><termGrp><term id="116264">state</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1572363">estat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15055_116265_1572363"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The condition at a particular time of any of numerous elements of computing--a device, a communications channel, a network station, a program, a bit, or other element--used to report on or to control computer operations.</descrip></descripGrp><ntig><termGrp><term id="116265">status</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1572363">estat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15056_415804_1969065"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The primordial model site for an application. Each application must contain one root model site.</descrip></descripGrp><ntig><termGrp><term id="415804">root model site</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969065">lloc model arrel</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15063_412982_1967633"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables the use of color, icons, or bars to help illustrate trends or show different values in a data range.</descrip></descripGrp><ntig><termGrp><term id="412982">data visualization</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1967633">visualització de les dades</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15067_7086_1967985"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A security mechanism that determines which operations a user, group, service, or computer is authorized to perform on a computer or on a particular object, such as a file, printer, registry subkey, or directory service object.</descrip></descripGrp><ntig><termGrp><term id="7086">access control</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1967985">control d'accés</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15072_233234_1968854"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of report views that are grouped together in a single dashboard zone. These report views can be conditionally shown, based on the selected KPI.</descrip></descripGrp><ntig><termGrp><term id="233234">report view group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1968854">grup de visualitzacions d'informe</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15075_186215_1970836"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An alternate URL mapping that Windows SharePoint Services preserves in the mapping table. It is the URL a user would see, but is not a URL that IIS would give to WSS.</descrip></descripGrp><ntig><termGrp><term id="186215">alternate access mapping</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970836">assignació alternativa d'accés</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15087_544920_1968648"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A designation that indicates that certain users or roles have both Read and Write permissions to an object or data set.</descrip></descripGrp><ntig><termGrp><term id="544920">Read+Write permission</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1968648">permisos de lectura i escriptura</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15088_140956_1967610"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A control that appears dimmed on a form or data access page. A disabled control cannot get the focus and will not respond to mouse clicks.</descrip></descripGrp><ntig><termGrp><term id="140956">disabled control</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1967610">control inhabilitat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1509_101960_1571259"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The likelihood of a computer system or device continuing to function over a given period of time and under specified conditions.</descrip></descripGrp><ntig><termGrp><term id="101960">reliability</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1571259">fiabilitat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15094_347947_1968009"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A control on a form that contains other controls in a table format and that repeats as needed. Users can insert multiple rows when filling out the form.</descrip></descripGrp><ntig><termGrp><term id="347947">repeating table</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1968009">taula de repetició</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15095_375724_1968989"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A color model that defines a color by three values: Hue, the color itself; Saturation, the purity of the color; and Luminance, the amount of light that is either reflected or absorbed by the color.</descrip></descripGrp><ntig><termGrp><term id="375724">HSL</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1968989">HSL</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15098_322615_1968064"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Web site based on the Document Workspace template that workspace members use for discussing, editing, and working together on a document.</descrip></descripGrp><ntig><termGrp><term id="322615">Document Workspace</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1968064">lloc Àrea de treball del document</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15098_322615_1969994"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Web site based on the Document Workspace template that workspace members use for discussing, editing, and working together on a document.</descrip></descripGrp><ntig><termGrp><term id="322615">Document Workspace</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969994">Àrea de treball del document</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15098_361653_1968064"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Web site based on the Document Workspace template that workspace members use for discussing, editing, and working together on a document.</descrip></descripGrp><ntig><termGrp><term id="361653">Document Workspace site</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1968064">lloc Àrea de treball del document</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15098_361653_1969994"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Web site based on the Document Workspace template that workspace members use for discussing, editing, and working together on a document.</descrip></descripGrp><ntig><termGrp><term id="361653">Document Workspace site</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969994">Àrea de treball del document</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15105_418598_1969098"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In a snowflake schema in a data warehouse, a dimension table that is directly related to, and usually joined to, the fact table.</descrip></descripGrp><ntig><termGrp><term id="418598">primary dimension table</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969098">taula de dimensions principal</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15119_375723_1968988"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A pre-designed combination of fonts that work well together.</descrip></descripGrp><ntig><termGrp><term id="375723">font scheme</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1968988">esquema de tipus de lletra</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15122_415055_1969011"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A prescribed action that performs one or multiple operations on the multidimensional data in a model.</descrip></descripGrp><ntig><termGrp><term id="415055">business rule</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969011">regla de negoci</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15125_415472_1970147"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A special visual or sound effect added to text or an object. For instance, a user can have the text bullet points fly in from the left, one word at a time, or hear the sounds of applause when a picture is uncovered.</descrip></descripGrp><ntig><termGrp><term id="415472">animation effect</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970147">efecte d'animació</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15132_565851_2770142"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A person, real or legal that regularly provides goods or services to another company.</descrip></descripGrp><ntig><termGrp><term id="565851">partner</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2770142">soci</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15136_493916_2578703"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The practice of penetrating system security by tricking individuals into divulging passwords and information about network vulnerabilities. Often done by calling the individual on phone and pretending to be another employee of company with a computer-related question.</descrip></descripGrp><ntig><termGrp><term id="493916">social engineering</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2578703">enginyeria social</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15141_415068_1969020"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user-defined period of time during which you can schedule form data entry, review, or approval, or report review or approval through assignments, or schedule server actions, also known as jobs. Cycle also defines the time period for which data can be submitted.</descrip></descripGrp><ntig><termGrp><term id="415068">cycle</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969020">cicle</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15144_346594_1770174"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The time for which a dry or alkaline cell is able to produce an electric current before it needs to be replaced.</descrip></descripGrp><ntig><termGrp><term id="346594">battery life</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1770174">vida de la bateria</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15145_415073_1969025"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An entry on the left side of a T account or double-entry balance sheet that typically increases asset or expense accounts and decreases liabilities, owners' equity, or income accounts.</descrip></descripGrp><ntig><termGrp><term id="415073">debit</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969025">dèbit</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15151_68314_1568546"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Characterized by conversational exchange of input and output, as when a user enters a question or command and the system immediately responds. The interactivity of microcomputers is one of the features that makes them approachable and easy to use.</descrip></descripGrp><ntig><termGrp><term id="68314">interactive</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1568546">interactiu</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15153_304427_1566564"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An exponentiation operator used in some programming languages. For example, the expression 3^2 represents the number 3 raised to the second power.</descrip></descripGrp><ntig><termGrp><term id="304427">caret</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1566564">operador exponencial</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15161_234965_1967632"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A span of time during which the financial activities of an organization are calculated. A fiscal year is divided into fiscal periods, typically defined as semesters, quarters, or months. The organization determines the dates that begin and end its fiscal year, which may not correspond to a traditional calendar year.</descrip></descripGrp><ntig><termGrp><term id="234965">fiscal year</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1967632">exercici fiscal</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15169_237946_1970522"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A guide consisting of two short, intersecting lines that can be placed anywhere on a drawing page or on a shape.</descrip></descripGrp><ntig><termGrp><term id="237946">guide point</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970522">punt de referència</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1517_557624_1968609"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To spread a non-leaf-level value to all leaf-level members while maintaining the ratio between the non-leaf-level and leaf-level members.</descrip></descripGrp><ntig><termGrp><term id="557624">spread by ratio</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1968609">propagar proporcionalment</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15172_30240_1967609"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An integer that corresponds to an open dynamic data exchange (DDE) channel.</descrip></descripGrp><ntig><termGrp><term id="30240">channel number</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1967609">número de canal</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15173_233319_1967631"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An estimate of sales revenue that typically spans a specific period such as a month, quarter of a year, one half of a year, or a full year.</descrip></descripGrp><ntig><termGrp><term id="233319">sales forecast</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1967631">previsió de vendes</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15181_84318_2175745"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A link between a user's computer and a group of computers and other devices that enables the user to access printers, servers etc. The link can be through a wire, cable, phone line or wireless transmissions.</descrip></descripGrp><ntig><termGrp><term id="84318">network connection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2175745">connexió de xarxa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15191_232512_1968847"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The modification of a process or task to improve performance to meet an established standard.</descrip></descripGrp><ntig><termGrp><term id="232512">performance management</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1968847">administració del rendiment</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15200_415480_1968501"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of template that contains instructions on how to create your own document.</descrip></descripGrp><ntig><termGrp><term id="415480">sample document</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1968501">document d'exemple</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15201_36468_1566622"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to a product that can work with or is equivalent to another product.</descrip></descripGrp><ntig><termGrp><term id="36468">compatible</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1566622">compatible</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15209_19668_2932058"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The data transfer capacity (speed of transmission) of a digital communications system as measured in bits per second (bps).</descrip></descripGrp><ntig><termGrp><term id="19668">bandwidth</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2932058">amplada de banda</term><termNote type="geographicalUsage">E