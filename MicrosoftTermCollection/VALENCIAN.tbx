ng="en-US"><descripGrp><descrip type="definition">An orientation where the long dimension of a rectangular area (for example, screen, photo, or paper) is horizontal.</descrip></descripGrp><ntig><termGrp><term id="73296">landscape</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1570362">horitzontal</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14724_124184_1970091"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A cross-platform interface for acquiring electronic images that have been captured by scanners, digital cameras, and still-frame video capture boards.</descrip></descripGrp><ntig><termGrp><term id="124184">TWAIN</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970091">TWAIN</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14726_110688_1572235"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A number assigned to a specific inventory item to identify it and differentiate it from similar items with the same item number.</descrip></descripGrp><ntig><termGrp><term id="110688">serial number</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1572235">número de sèrie</term><termNo