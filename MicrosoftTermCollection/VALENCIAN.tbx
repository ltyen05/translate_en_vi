e higher the authority level assigned to a page, the higher the page appears in search results. Also referred to as authoritative page.</descrip></descripGrp><ntig><termGrp><term id="641205">authoritative page</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969798">pàgina d'autoritat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17385_641206_1969284"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The number of links between a content item and an authoritative page linking to the content item.</descrip></descripGrp><ntig><termGrp><term id="641206">click distance</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969284">distància en clics</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17385_697659_1969284"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The number of links between a content item and an authoritative page linking to the content item.</descrip></descripGrp><ntig><termGrp><term id="697659">click-distance</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969284">distància en clics</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termN