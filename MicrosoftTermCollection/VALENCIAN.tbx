cation for groups of educators who meet regularly to share expertise and work collaboratively to improve teaching skills and the academic performance of students.</descrip></descripGrp><ntig><termGrp><term id="2870706">PLC</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2915926">Comunitat d'aprenentatge professional</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50717_2870996_2873011"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Descriptive phrasing to be used when an app or accessory is compatible with Windows.</descrip></descripGrp><ntig><termGrp><term id="2870996">works with Windows</term><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2873011">compatible amb el Windows</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50751_2871535_2873161"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft tool designed to help developers discover, install, upgrade, remove, and configure their Windows tools.</descrip></descripGrp><ntig><termGrp><term id="2871535">Windows Package Manager</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2873161">Administrador de paquets d