</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1757985">mode d'espera connectat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33089_1755691_1757987"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of Windows and device settings that users can change grouped into one location.</descrip></descripGrp><ntig><termGrp><term id="1755691">PC settings</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1757987">Configuració de l'ordinador</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33091_1755693_1757994"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tablet hardware button with the Windows logo on it that's similar to the Windows key on a keyboard. Pressing the Power and Windows buttons simultaneously is the equivalent of pressing Ctrl+Alt+Del.</descrip></descripGrp><ntig><termGrp><term id="1755693">Windows button</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1757994">botó del Windows</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33092_1755782_1760449"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The spreading of malicious content through online advertising.</descrip></descripGrp><ntig><termGrp><term id="1755782">malvertising</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1760449">publicitat maliciosa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33092_1755783_1760449"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The spreading of malicious content through online advertising.</descrip></descripGrp><ntig><termGrp><term id="1755783">malicious advertising</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1760449">publicitat maliciosa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33093_1755827_1781053"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A rating of how safe an app is determined to be by SmartScreen, according to age, presence of digital certificate, and other criteria.</descrip></descripGrp><ntig><termGrp><term id="1755827">SmartScreen Application Reputation</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1781053">Reputa