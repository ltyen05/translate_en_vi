S"><descripGrp><descrip type="definition">A way of defining color both for onscreen display and print. Colors can be described by using several different color models: HSV (hue, saturation, and value); CMY (cyan, magenta, and yellow); and RGB (red, green, and blue).</descrip></descripGrp><ntig><termGrp><term id="34557">color model</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970450">model de color</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6032_178599_1967628"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An entity that sells similar products or services and competes for the same customer segment.</descrip></descripGrp><ntig><termGrp><term id="178599">competitor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1967628">competidor</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6033_319444_1566733"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An area within the Control Panel that provides accessibility options and settings to help users interact more easily with the computer.</descrip></descripGrp><ntig><termGrp><term id="319444">Ease of Access Center</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valen