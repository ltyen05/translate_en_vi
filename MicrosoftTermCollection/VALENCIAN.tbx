e></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1968201">Bloquejat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27772_1448163_2653520"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Rules by which one must agree to abide by in order to use a service. The accompanying Microsoft software includes computer software and may include associated media, printed materials, “online” or electronic documentation, and Internet-based services for use with a Microsoft software product (collectively, the “ADD-IN SOFTWARE”).</descrip></descripGrp><ntig><termGrp><term id="1448163">terms of service</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2653520">condicions del servei</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27784_1462925_1968312"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows a user to answer a call for another user or make calls on behalf of the other user.</descrip></descripGrp><ntig><termGrp><term id="1462925">call delegation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1968312">delegació de trucades</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27786_1463882_1968313"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A site that is associated with one central site and contains at least a public switched telephone network (PSTN) gateway, and can include a Mediation Server. Or, a branch site could run a survivable branch appliance which makes the site more resistant if there are wide-area network failures.</descrip></descripGrp><ntig><termGrp><term id="1463882">branch site</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1968313">lloc de sucursal</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27787_1463884_1968314"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature whereby a user can select an option to report a received call as malicious. By tracing the call, an administrator can then identify the call, the calling number, and the gateway or SIP trunk over which the call was received.</descrip></descripGrp><ntig><termGrp><term id="1463884">malicious call tracing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1968314">seguiment de trucades malicioses</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27788_1463920_1968315"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A policy that provides information to the Lync Server ExUM Routing application about where to route calls for users whose mailboxes are located on a hosted Exchange service.</descrip></descripGrp><ntig><termGrp><term id="1463920">hosted voice mail policy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1968315">norma de correu de veu allotjat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27793_1464067_1970773"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The combined schedule of a number of people or resources.</descrip></descripGrp><ntig><termGrp><term id="1464067">group schedule</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970773">planificació de grup</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27799_1464802_2839062"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A call center for answering emergency calls and providing emergency services.</descrip></descripGrp><ntig><termGrp><term id="1464802">Public Safety Answering Point</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2839062">PSAP</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOf