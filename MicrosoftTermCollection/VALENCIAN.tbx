cument library where users can upload files that are then routed automatically to the correct library or folder in the site based upon rules defined by the site administrator.</descrip></descripGrp><ntig><termGrp><term id="773462">Drop Off Library</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969311">biblioteca d'encaminament</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21381_1102876_1970175"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that displays a definition or translation of a word or piece of text in a ScreenTip when the pointer is moved over the selection.</descrip></descripGrp><ntig><termGrp><term id="1102876">Mini Translator</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970175">Minitraductor</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21402_775135_2371423"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A radio network that provides coverage for cellular telephone communications.</descrip></descripGrp><ntig><termGrp><term id="775135">cellular network</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2371423">xarxa mòbil</term><term