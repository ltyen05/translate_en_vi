ig><termGrp><term id="1570920">àlies</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1575_1177075_1566595"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The electronic circuit in a computer that generates a steady stream of timing pulses--the digital signals that synchronize every operation. The system clock signal is precisely set by a quartz crystal, typically at a specific frequency between 1 and 50 megahertz. The clock rate of a computer is one of the prime determinants of its overall processing speed, and it can go as high as the other components of the computer allow.</descrip></descripGrp><ntig><termGrp><term id="1177075">system timer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1566595">rellotge</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1575_32826_1566595"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The electronic circuit in a computer that generates a steady stream of timing pulses--the digital signals that synchronize every operation. The system clock signal is precisely set by a quartz crystal, typically at a specific frequency between 1 and 50 megahertz. The clock rate of a computer is one of the prime determinants of its overall processing speed, and it can go as high as the other components of the computer allow.</descrip></descripGrp><ntig><termGrp><term id="32826">clock</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1566595">rellotge</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1575_334537_1566595"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The electronic circuit in a computer that generates a steady stream of timing pulses--the digital signals that synchronize every operation. The system clock signal is precisely set by a quartz crystal, typically at a specific frequency between 1 and 50 megahertz. The clock rate of a computer is one of the prime determinants of its overall processing speed, and it can go as high as the other components of the computer allow.</descrip></descripGrp><ntig><termGrp><term id="334537">system clock</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1566595">rellotge</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15750_149937_1967396"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The part of an SQL statement that specifies which records to retrieve.</descrip></descripGrp><ntig><termGrp><term id="149937">WHERE clause</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1967396">clàusula WHERE</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote>