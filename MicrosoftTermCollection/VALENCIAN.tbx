maticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8275_143490_1967678"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A reference to a range of cells instead of a single cell that is calculated like a single cell. If cell C10 contains the formula =B5: B15*5, Excel multiplies the value in cell B10 by 5 because cells B10 and C10 are in the same row.</descrip></descripGrp><ntig><termGrp><term id="143490">implicit intersection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1967678">intersecció implícita</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8276_182564_1569462"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Microsoft Web site that provides customers with access to a database of articles written by Microsoft Support professionals.</descrip></descripGrp><ntig><termGrp><term id="182564">Knowledge Base</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1569462">KB</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8276_182564_1969964"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Microsoft Web site that provides customers with access to a database of articles written by Microsoft Support professionals.</descrip></descripGrp><ntig><termGrp><term id="182564">