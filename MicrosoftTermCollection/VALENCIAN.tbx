ote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="3128206">D'acord</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43257_2450114_2454097"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A target error margin for recall that is used to estimate number of additional files necessary needed for review.</descrip></descripGrp><ntig><termGrp><term id="2450114">assessment target</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2454097">objectiu d'avaluació</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43258_2450131_2454099"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A percentage of files that need to be reviewed, which can be defined by the user of Advanced eDiscovery.</descrip></descripGrp><ntig><termGrp><term id="2450131">cut-off point</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2454099">llindar de fitxers</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43259_2450137_2454100"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Advanced eDiscovery view where detailed interim cumulative results can be viewed after each Relevance training cycle.</descrip></descripGrp><ntig><termGrp><term id="2450137">Detailed Results</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2454100">Resultats detallats</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43261_2450561_2454121"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process where an expert labels each file and issue within a sample as relevant, not relevant, or an item that should be skipped as part of Advanced eDiscovery Relevance training.</descrip></descripGrp><ntig><termGrp><term id="2450561">tagging</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2454121">etiquetatge</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43262_2450562_2454122"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Advanced eDiscovery panel where users can tag files and issues as relevant, not relevant, or where they can choose to skip it.</descrip></descripGrp><ntig><termGrp><term id="2450562">Tagging panel</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2454122">Tauler d'etiquetatge</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43263_2450563_2454123"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A margin of error for the recall value that is used to estimate the number of files that need to be reviewed by Advanced eDiscovery.</descrip></descripGrp><ntig><termGrp><term id="2450563">target error margin</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2454123">marge d'error objectiu</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43264_2450798_2454098"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Advanced eDiscovery mode that allows users to process new file loads after other file loads were already started, see a comparison of the loads, and decide if they want to merge the new loads with the existing ones or split them.</descrip></descripGrp><ntig><termGrp><term id="2450798">Catch-up</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2454098">Posada al dia</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43265_2450799_2454111"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Advanced eDiscovery option that allows users to continue Relevance training, treating new loads and old loads like the same set of files.</descrip></descripGrp><ntig><termGrp><term id="2450799">Merge loads</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2454111">Combina les compilacions</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43266_2450800_2454119"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Advanced eDiscovery option that allows users to perform Relevance training on new file loads separately from old file loads.</descrip></descripGrp><ntig><termGrp><term id="2450800">Split loads</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2454119">Separa les compilacions</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43267_2450801_2454116"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Advanced eDiscovery mode that allows users to incorporate a new load with existing loads using Catch-up and which triggers any new necessary Relevance training.</descrip></descripGrp><ntig><termGrp><term id="2450801">Rolling loads</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2454116">Compilacions addicionals</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43268_2450802_2454106"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Advanced eDiscovery feature that allows users to select a set of parameters that will determine which files are exported in a batch.</descrip></descripGrp><ntig><termGrp><term id="2450802">Export batch</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2454106">Lot d'exportació</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43269_2450812_2454112"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file that is in its original file type.</descrip></descripGrp><ntig><termGrp><term id="2450812">native file</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2454112">fitxer natiu</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43270_2450813_2454115"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A phase in e-discovery where native files are prepared to be loaded into a document review platform, metadata is extracted from files, and data culling techniques are employed.</descrip></descripGrp><ntig><termGrp><term id="2450813">processing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2454115">processament</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43271_2450814_2454101"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Advanced eDiscovery metadata type that identifies whether file is a document, email or an attachment.</descrip></descripGrp><ntig><termGrp><term id="2450814">Doc_type</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2454101">Doc_type</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43272_2450815_2454102"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Advanced eDiscovery metadata type that identifies the subset of exact duplicates.</descrip></descripGrp><ntig><termGrp><term id="2450815">Duplicate_subset</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2454102">Duplicate_subset</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43273_2450816_2454103"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Advanced eDiscovery metadata type that identifies an email within an email thread, including the node IDs of all emails in the thread from the root to the current email.</descrip></descripGrp><ntig><termGrp><term id="2450816">Email_thread</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2454103">Email_thread</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43274_2450817_2454109"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Advanced eDiscovery metadata type that identifies if a file is an inclusive file, an inclusive minus, or an inclusive copy.</descrip></descripGrp><ntig><termGrp><term id="2450817">Inclusive_type</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2454109">Inclusive_type</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43275_2450818_2454113"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of attributes for a population that includes t