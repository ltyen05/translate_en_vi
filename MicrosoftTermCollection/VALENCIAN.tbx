ork and are available through shared network folders.</descrip></descripGrp><ntig><termGrp><term id="140933">direct synchronization</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1967364">sincronització directa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6765_145989_1970681"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The nonprinting ¶ character that Microsoft Office Word inserts when you press ENTER to end a paragraph. The paragraph mark stores the formatting you apply to the paragraph.</descrip></descripGrp><ntig><termGrp><term id="145989">paragraph mark</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970681">marca de paràgraf</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6766_147201_1967387"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A variable you declare with the Public keyword in the Declarations section of a module. A public variable can be shared by all the procedures in every module in a database.</descrip></descripGrp><ntig><termGrp><term id="147201">public variable</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1967387">variable pública</term><termNote type="geogra