nsider</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42526_2410029_2412815"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A condition of being protected from danger or risk.</descrip></descripGrp><ntig><termGrp><term id="2410029">safety</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2412815">seguretat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42527_2410030_2412812"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An entity that is responsible for the administrative tasks of an Office 365 subscription for a third party.</descrip></descripGrp><ntig><termGrp><term id="2410030">Office 365 admin</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2412812">administrador de l'Office 365</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42528_2410031_2412813"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office application that allows Office 365 admins to access their Office 365 admin center and manage their tenants via their mobile devices.</descrip></descripGrp><ntig><termGrp><term id="2410031">Office 365 Admin</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2412813">Office 365 Admin</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42529_2410032_2412804"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A failure of a program operation that causes the operation to stop completely.</descrip></descripGrp><ntig><termGrp><term id="2410032">hard fail</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2412804">error no recuperable</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42530_2410033_2412808"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A failure of a program operation where the failure is recorded and the operation continues on.</descrip></descripGrp><ntig><termGrp><term id="2410033">soft fail</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2412808">error recuperable</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42531_2410034_2412801"