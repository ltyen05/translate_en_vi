</termGrp></ntig></langSet></termEntry><termEntry id="25427_1176701_1969421"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature of Microsoft Office that allows the user to view and edit image document formats like .TIF, which is the format most traditionally used in fax transmissions (IOs, T&amp;Cs, etc.).</descrip></descripGrp><ntig><termGrp><term id="1176701">Microsoft Office Document Imaging</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969421">Microsoft Office Document Imaging</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25427_1177410_1969421"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature of Microsoft Office that allows the user to view and edit image document formats like .TIF, which is the format most traditionally used in fax transmissions (IOs, T&amp;Cs, etc.).</descrip></descripGrp><ntig><termGrp><term id="1177410">MODI</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969421">Microsoft Office Document Imaging</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25431_1176709_1969423"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The end-to-end architecture that powers the Word and PowerPoint viewing experience in the browser. It includes the front-end machines to service the browser requests and the back-end machines which convert the document from a DOC or PPT file to PNG, each representing a page of your document.</descrip></descripGrp><ntig><termGrp><term id="1176709">Office Viewing Architecture</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969423">Arquitectura de visualització de l'Office</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25451_1176752_1970166"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A converter that supports dynamic viewing of PowerPoint presentations (with animation) in a Web environment.</descrip></descripGrp><ntig><termGrp><term id="1176752">PowerPoint render</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970166">representació del PowerPoint</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25453_1176757_1969424"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A momentum oscillator that compares upward movements of a stock's closing price with downward movements, and results in values that range from 0 to 100.</descrip></descripGrp><ntig><termGrp><term id="1176757">Relative Strength Index</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969424">índex de força relativa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25472_1176798_1970167"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A guide used to position shapes and objects on slides.</descrip></descripGrp><ntig><termGrp><term id="1176798">drawing guide</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970167">guia de dibuix</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25475_1176808_1970168"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A converter that supports static viewing of PowerPoint presentations (without animation) in a Web environment.</descrip></descripGrp><ntig><termGrp><term id="1176808">PowerPoint static</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970168">element estàtic del PowerPoint</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25476_1176809_1969425"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user role for an individual who owns or maintains a document repository, and who is responsible for configuring, customizing, and creating site features.</descrip></descripGrp><ntig><termGrp><term id="1176809">content steward</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969425">administrador de contingut</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25485_1176837_1967805"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A test in which the null hypothesis is rejected if the value of the test statistic falls into a specific tail of the probability distribution (e.g. the test statistic must be greater than a critical value in order to reject the null hypothesis).</descrip></descripGrp><ntig><termGrp><term id="1176837">one-tailed test</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1967805">prova d'una cua</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25485_1176837_1967806"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A test in which the null hypothesis is rejected if the value of the test statistic falls into a specific tail of the probability distribution (e.g. the test statistic must be greater than a critical value in order to reject the null hypothesis).</descrip></descripGrp><ntig><termGrp><term id="1176837">one-tailed test</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp><