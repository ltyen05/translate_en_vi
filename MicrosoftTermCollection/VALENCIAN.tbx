d="34731_2004703_2013825"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables a user to search for another user's or group's calendar and pin it to their calendar list.</descrip></descripGrp><ntig><termGrp><term id="2004703">search and pin calendars</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2013825">recerca i ancora calendaris</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34734_2009037_2013796"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The workspace at the bottom of the application that displays alerts and notifications.</descrip></descripGrp><ntig><termGrp><term id="2009037">desktop app bar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2013796">barra d'aplicacions d'escriptori</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34735_2009421_2013809"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The workspace along the bottom edge of the screen that enables the user to access Office 365 services or sign out.</descrip></descripGrp><ntig><termGrp><term id="2009421">mobile app bar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2013809">barra d'aplicacions per a mòbil</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34739_2012681_2013817"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables users to compose or reply to a message without leaving the context of the conversation.</descrip></descripGrp><ntig><termGrp><term id="2012681">Quick Compose</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2013817">Redacció ràpida</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34748_2012910_2013830"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office feature that creates a view where users can see the content that has been shared with them.</descrip></descripGrp><ntig><termGrp><term id="2012910">Shared with Me</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2013830">Compartits amb mi</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34749_2012913_2013808"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows a preview of a webpage or YouTube video. The preview will show a photo, title, and description of the webpage or video.</descrip></descripGrp><ntig><termGrp><term id="2012913">Inline Previews</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2013808">Visualitzacions prèvies en línia</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34750_2012915_2013795"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A button that opens the current document’s table of contents in a pane. Users can pin the pane to the document, and when they scroll through the document, the table of contents dynamically highlights the section they are in.</descrip></descripGrp><ntig><termGrp><term id="2012915">Contents</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2013795">Contingut</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34751_2012916_2013800"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The UI element that enables the user to locate text and go to locations where the text occurs in a document.</descrip></descripGrp><ntig><termGrp><term id="2012916">Find</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2013800">Busca</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34754_2013078_2013818"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ability of multiple authors, who are editing a shared document, to simultaneously see text and formatting changes made by co-authors as they add them.</descrip></descripGrp><ntig><termGrp><term id="2013078">Real-time Co-authoring</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2013818">Coautoria en temps real</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34755_2013123_2013842"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that creates new and improved mobile browser views. Documents are displayed as big touchable tiles on the screen. Users can view their own documents, shared documents, or ones they follow. They can open documents or share the URL of a document with other users. Additionally, users can navigate to Mail, Calendar, People, and Sites to view sites that they follow and those promoted by their site administrator.</descrip></descripGrp><ntig><termGrp><term id="2013123">Touch Design</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2013842">Disseny tàctil</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34756_2013318_2017837"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An app for the Windows Store designed for small groups of SharePoint users to enable them to perform basic tasks, such as provide access to team document libraries, site feeds, and project tasks.</descrip></descripGrp><ntig><termGrp><term id="2013318">Sites app</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2017837">aplicació Llocs</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34758_2013323_2770134"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A transfer of customer data from one system to another.</descrip></descripGrp><ntig><termGrp><term id="2013323">migration</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2770134">migració</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34759_2013324_2590847"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A product that provides additional functionality when used with a prerequisite underlying base product.</descrip></descripGrp><ntig><termGrp><term id="2013324">add-on</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></te