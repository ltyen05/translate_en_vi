82_1967995"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A means of defining the permissions of a group role within the Safe Editing feature. Administrators can create user groups and the authoring rights of each group member will be restricted according to the group permission.</descrip></descripGrp><ntig><termGrp><term id="183982">group inheritance</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1967995">herència de grups</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16032_419226_1968647"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The net income (revenue minus all expenses) of a business entity.</descrip></descripGrp><ntig><termGrp><term id="419226">earnings</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1968647">beneficis</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16034_269339_1572429"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file system defined by the Optical Storage Technology Association (OSTA) that is the successor to the CD-ROM file system (CDFS). UDF is used for removable disk media like DVD, CD, and magneto-optic (MO) disks.</descrip></descripGrp><ntig><termGrp><term id="269339">Universal Disk Format</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1572429">UDF</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16034_269340_1572429"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file system defined by the Optical Storage Technology Association (OSTA) that is the successor to the CD-ROM file system (CDFS). UDF is used for removable disk media like DVD, CD, and magneto-optic (MO) disks.</descrip></descripGrp><ntig><termGrp><term id="269340">UDF</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1572429">UDF</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16037_245224_3028379"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature available in various security products that continuously detects and blocks attacks and potentially malicious objects, providing uninterrupted protection.</descrip></descripGrp><ntig><termGrp><term id="245224">Real-time protection</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="3028379">protecció en temps real</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16037_3027999_3028379"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature available in various security products that continuously detects and blocks attacks and potentially malicious objects, providing uninterrupted protection.</descrip></descripGrp><ntig><termGrp><term id="3027999">real-time protection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="3028379">protecció en temps real</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16047_139902_1967361"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">User-defined sort order. For example, you could define a custom sort order to display values in the EmployeeTitle column on the basis of the title's seniority.</descrip></descripGrp><ntig><termGrp><term id="139902">custom order</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1967361">orde personalitzat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16063_2481712_1567284"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A hardware device, or a logical partition of it, that reads data from and writes data to hard disks.</descrip></descripGrp><ntig><termGrp><term id="2481712">HDD</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1567284">unitat de disc dur</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16063_339969_1567284"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A hardware device, or a logical partition of it, that reads data from and writes data to hard disks.</descrip></descripGrp><ntig><termGrp><term id="339969">hard disk drive</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1567284">unitat de disc dur</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16066_236645_1969867"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to time on a schedule when a person may participate in a scheduled task.</descrip></descripGrp><ntig><termGrp><term id="236645">tentative</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969867">provisional</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16068_234748_1564484"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A visual impairment that results in complete loss of vision in both eyes.</descrip></descripGrp><ntig><termGrp><term id="234748">blindness</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1564484">ceguera</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16076_139513_1969914"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A character that is inserted in right-to-left and mixed text to specify the formatting of text when the inherent directionality of the text is insufficient to display expected results.</descrip></descripGrp><ntig><termGrp><term id="139513">control character</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969914">caràcter de control</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1608_264787_1970842"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A list view toolbar type in the toolbar picker, that shows an abbreviated version of a full toolbar.</descrip></descripGrp><ntig><termGrp><term id="264787">Summary toolbar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970842">Barra d'eines reduïda</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16082_138434_1967669"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A sheet in a workbook that contains only a chart.</descrip></descripGrp><ntig><termGrp><term id="138434">chart sheet</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1967669">full de gràfic</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16083_237936_1970514"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The page in a drawing window that contains a drawing. A page can be either a foreground or a background page. Each page has a size, which usually corresponds to a standard paper size, and it has a scale.</descrip></descripGrp><ntig><termGrp><term id="237936">drawing page</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970514">pàgina de dibuix</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16088_211827_1971761"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The value of an item that is based on a weighted average of the values of itself and its child entries.</descrip></descripGrp><ntig><termGrp><term id="211827">rollup</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1971761">valor consolidat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1609_184972_2508279"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An item that appears on the Forwarding Calls To menu. When the user selects Mobile, Communicator automatically forwards incoming calls to the number the user has published for his mobile phone.</descrip></descripGrp><ntig><termGrp><term id="184972">Mobile</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2508279">Mòbil</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16094_347944_1968930"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A field in the data source that can occur more than once. Controls such as bulleted, numbered, and plain lists; repeating sections; and repeating tables can be bound to repeating fields.</descrip></descripGrp><ntig><termGrp><term id="347944">repeating field</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1968930">camp de repetició</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16098_232555_1968848"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Items that an owning organization uses in its product delivery activities. The value of an item is calculated by using an inventory valuation method and is recorded in inventory accounts.</descrip></descripGrp><ntig><termGrp><term id="232555">inventory</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1968848">inventari</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1611_184157_1967323"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A form in which two views are displayed at the same time. These are synched so that as your focus moves in one view it is changed automatically in the other view.</descrip></descripGrp><ntig><termGrp><term id="184157">split form</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1967323">formulari dividit</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16113_2794716_1566719"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A uniquely-named collection of computers in a networked environment that share a common database, directory database, or tree and that is administered as a unit with common rules and procedures, which can include security policies.</descrip></descripGrp><ntig><termGrp><term id="2794716">network domain</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1566719">domini</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16113_47604_1566719"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A uniquely-named collection of computers in a networked environment that share a common database, directory database, or tree and that is administered as a unit with common rules and procedures, which can include security policies.</descrip></descripGrp><ntig><termGrp><term id="47604">domain</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1566719">domini</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16116_690974_1969283"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The area inside content placeholders.</descrip></descripGrp><ntig><termGrp><term id="690974">content region</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969283">àrea de contingut</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16117_347943_1968929"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group that is associated with another group so that their properties and the properties of the groups and fields they contain always match. If the properties of one group are changed, the other group is updated automatically.</descrip></descripGrp><ntig><termGrp><term id="347943">reference group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1968929">grup de referència</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1612_111004_2954946"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file-sharing protocol designed to allow networked computers to transparently access files that reside on remote systems over a variety of networks. The SMB protocol defines a series of commands that pass information between computers. SMB uses four message types: session control, file, printer, and message.</descrip></descripGrp><ntig><termGrp><term id="111004">Server Message Block</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2954946">Bloc de missatges del servidor</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1612_111004_2954947"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file-sharing protocol designed to allow networked computers to transparently access files that reside on remote systems over a variety of networks. The SMB protocol defines a series of commands that pass information between computers. SMB uses four message types: session control, file, printer, and message.</descrip></descripGrp><ntig><termGrp><term id="111004">Server Message Block</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2954947">SMB</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1612_111005_2954946"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file-sharing protocol designed to allow networked computers to transparently access files that reside on remote systems over a variety of networks. The SMB protocol defines a series of commands that pass information between computers. SMB uses four message types: session control, file, printer, and message.</descrip></descripGrp><ntig><termGrp><term id="111005">SMB</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2954946">Bloc de missatges del servidor</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1612_111005_2954947"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file-sharing protocol designed to allow networked computers to transparently access files that reside on remote systems over a variety of networks. The SMB protocol defines a series of commands that pass information between computers. SMB uses four message types: session control, file, printer, and message.</descrip></descripGrp><ntig><termGrp><term id="111005">SMB</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2954947">SMB</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16120_89167_1968460"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The packaged Windows Media file that is created with Windows Media Rights Manager SDK.</descrip></descripGrp><ntig><termGrp><term id="89167">output file</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1968460">fitxer d'eixida</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1613_343638_1970452"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of producing copies of documents, publications, or images in high volume.</descrip></descripGrp><ntig><termGrp><term id="343638">commercial printing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970452">impressió professional</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16131_66303_1970806"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The formal name for a company's data processing department.</descrip></descripGrp><ntig><termGrp><term id="66303">information technology</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970806">sistemes d'informació</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16131_66304_1970806"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The formal name for a company's data processing department.</descrip></descripGrp><ntig><termGrp><term id="66304">IT</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970806">sistemes d'informació</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16131_702301_1970806"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The formal name for a company's data processing department.</descrip></descripGrp><ntig><termGrp><term id="702301">IS</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970806">sistemes d'informació</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16131_702302_1970806"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The formal name for a company's data processing department.</descrip></descripGrp><ntig><termGrp><term id="702302">information systems</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970806">sistemes d'informació</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1614_234308_1968861"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A data validation alert that marks controls that contain invalid or missing data with a dashed red border or red asterisk. Users can display custom error messages by right-clicking the control or by clicking a link for more information.</descrip></descripGrp><ntig><termGrp><term id="234308">inline alert</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1968861">avís inserit</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16144_121017_1967932"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Formatting that controls the appearance of a text. Examples include text alignment, intercharacter spacing, text justification, and text and background colors.</descrip></descripGrp><ntig><termGrp><term id="121017">text formatting</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1967932">format de text</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16150_545626_1970184"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A graphic element from the SmartArt feature.</descrip></descripGrp><ntig><termGrp><term id="545626">SmartArt graphic</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970184">gràfic SmartArt</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16152_185510_1968088"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A button on Audio Controls that turns off mute on the user's phone.</descrip></descripGrp><ntig><termGrp><term id="185510">Unmute</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1968088">Activa el so</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16158_143130_1969927"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Paragraph formatting in which the second and subsequent lines of a paragraph are indented more than the first line.</descrip></descripGrp><ntig><termGrp><term id="143130">hanging indent</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969927">sagnia francesa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16161_234782_2016829"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of preset power-management options. For example, you can set elapsed times for putting your computer on standby and for turning off your monitor and hard disk. You save these settings as a named power scheme.</descrip></descripGrp><ntig><termGrp><term id="234782">power plan</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2016829">pla d'energia</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16161_94159_2016829"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of preset power-management options. For example, you can set elapsed times for putting your computer on standby and for turning off your monitor and hard disk. You save these settings as a named power scheme.</descrip></descripGrp><ntig><termGrp><term id="94159">power scheme</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2016829">pla d'energia</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16167_184359_1968134"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The name of the dialog box in Lync and Office Communicator where a user can configure their connection settings to a server.</descrip></descripGrp><ntig><termGrp><term id="184359">Advanced Connection Settings</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1968134">Configuració de connexió avançada</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16175_1508829_1970085"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An area at the left side in some dialog boxes, such as Save As, Open, and Insert Picture that contains shortcuts to various folders.</descrip></descripGrp><ntig><termGrp><term id="1508829">Places Bar</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970085">barra d'ubicacions</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16175_477172_1970085"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An area at the left side in some dialog boxes, such as Save As, Open, and Insert Picture that contains shortcuts to various folders.</descrip></descripGrp><ntig><termGrp><term id="477172">My Places bar</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970085">barra d'ubicacions</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16176_143109_1970690"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A margin setting that adds extra space to the side or top margin of a document you plan to bind. A gutter margin ensures that text isn't obscured by the binding.</descrip></descripGrp><ntig><termGrp><term id="143109">gutter margin</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970690">marge d'enquadernació</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16183_1608214_2770170"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The server-based report generation environment for enterprise, Web-enabled reporting functionality that allows users to create reports that draw content from a variety of data sources, publish reports in various formats, and centrally manage security and subscriptions.</descrip></descripGrp><ntig><termGrp><term id="1608214">Microsoft SQL Server Reporting Services</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2770170">SSRS</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16183_169566_2770170"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The server-based report generation environment for enterprise, Web-enabled reporting functionality that allows users to create reports that draw content from a variety of data sources, publish reports in various formats, and centrally manage security and subscriptions.</descrip></descripGrp><ntig><termGrp><term id="169566">SQL Server Reporting Services</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2770170">SSRS</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16183_169567_2770170"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The server-based report generation environment for enterprise, Web-enabled reporting functionality that allows users to create reports that draw content from a variety of data sources, publish reports in various formats, and centrally manage security and subscriptions.</descrip></descripGrp><ntig><termGrp><term id="169567">SSRS</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2770170">SSRS</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16183_2482816_2770170"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The server-based report generation environment for enterprise, Web-enabled reporting functionality that allows users to create reports that draw content from a variety of data sources, publish reports in various formats, and centrally manage security and subscriptions.</descrip></descripGrp><ntig><termGrp><term id="2482816">Reporting Services</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2770170">SSRS</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16190_184195_1968414"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Content has been hashed and verified as valid against the signature. The certificate used to verify the signature is “valid” in the sense that it has a relationship to a trusted certificate authority (and isn’t expired, etc.)</descrip></descripGrp><ntig><termGrp><term id="184195">Signed - verified</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1968414">Signat: verificat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16196_237375_1967620"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A field that has certain restrictions, such as no images allowed.</descrip></descripGrp><ntig><termGrp><term id="237375">constrained field</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1967620">camp restringit</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16206_361573_1968945"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file that represents the addressable entry point for XML Web services created with managed code. Web service consumers utilize the functionality of a Web service by accessing its ASMX file.</descrip></descripGrp><ntig><termGrp><term id="361573">ASMX file</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1968945">fitxer ASMX</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16213_2167436_2177888"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A hard plastic disc on a mouse that is perpendicular to the mouse surface. It is normally located between the left and right mouse buttons and is used for scrolling.</descrip></descripGrp><ntig><termGrp><term id="2167436">mouse wheel</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2177888">roda del ratolí</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16213_534934_2177888"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A hard plastic disc on a mouse that is perpendicular to the mouse surface. It is normally located between the left and right mouse buttons and is used for scrolling.</descrip></descripGrp><ntig><termGrp><term id="534934">scroll wheel</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2177888">roda del ratolí</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1622_234771_1567269"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to Microsoft software which is published by Microsoft, properly licensed, and fully supported by Microsoft or a trusted partner.</descrip></descripGrp><ntig><termGrp><term id="234771">genuine</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1567269">autèntic</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16223_237296_1967639"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows the user to select from a gallery of pre-defined formatting styles and apply them quickly to tables, text, charts, drawing objects and SmartArt graphics.</descrip></descripGrp><ntig><termGrp><term id="237296">Quick Styles</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1967639">Estils ràpids</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16225_232420_1969981"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A secure email feature that lets you add sensitivity labels, such as Internal Use Only, to the message header. Security labels in your organization are controlled by security policies set up by your email administrator.</descrip></descripGrp><ntig><termGrp><term id="232420">security label</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969981">etiqueta de seguretat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16244_180140_1968797"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A folder that contains all history items and the records they are linked to.</descrip></descripGrp><ntig><termGrp><term id="180140">Business History Folder</term><termNote type="pa