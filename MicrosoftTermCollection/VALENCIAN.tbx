ES-valencia"><ntig><termGrp><term id="1967436">llegenda</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15242_123603_2767920"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A version of a product that can be used for a limited period of time for purposes of evaluation.</descrip></descripGrp><ntig><termGrp><term id="123603">trial version</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2767920">prova</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15242_1490934_2767920"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A version of a product that can be used for a limited period of time for purposes of evaluation.</descrip></descripGrp><ntig><termGrp><term id="1490934">trial edition</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2767920">prova</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15242_1992951_2767920"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A version of a product that can be used for a limited period of time for purposes of evaluation.</descrip></descripGrp><ntig><termGrp><term id="1992951">trial</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2767920">prova</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15248_142601_1968724"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A standard method of extending Web server functionality by executing programs or scripts on a Web server in response to Web browser requests, such as in form processing. Use of a common gateway interface can make a web page more dynamic.</descrip></descripGrp><ntig><termGrp><term id="142601">Gateway script</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1968724">script de passarel·la</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15254_1986304_1991920"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables users to provide input through the screen by using a finger or a pen.</descrip></descripGrp><ntig><termGrp><term id="1986304">touch</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1991920">funcionalitat tàctil</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15254_276552_1991920"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables users to provide input through the screen by using a finger or a pen.</descrip></descripGrp><ntig><termGrp><term id="276552">touch input</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1991920">funcionalitat tàctil</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15260_178691_1968773"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The source of an account, business contact, or opportunity; for example, an advertisement or personal reference.</descrip></descripGrp><ntig><termGrp><term id="178691">source of lead</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1968773">origen del client potencial</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15265_417322_1969077"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A one-to-one correspondence that a business rule can establish between members or dimensions of two separate models.</descrip></descripGrp><ntig><termGrp><term id="417322">cross-model mapping</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang