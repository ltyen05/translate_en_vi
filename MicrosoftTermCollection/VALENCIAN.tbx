662"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user interface element that displays a list of active fields in a PivotChart® view and is used to apply filters to those fields.</descrip></descripGrp><ntig><termGrp><term id="1506795">PivotChart filter pane</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969662">subfinestra de filtres de gràfic dinàmic</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29210_1506796_1969663"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A PivotTable® field that is in the PivotTable area where the data values are shown.</descrip></descripGrp><ntig><termGrp><term id="1506796">PivotTable data field</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969663">camp de dades de taula dinàmica</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29211_1506797_1969664"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user interface element that displays a list of all PivotTable® fields. A PivotTable field list can be used to populate a PivotTable report and to manipulate the fields.</descrip></descripGrp><ntig><termGrp><term id="1506797">PivotTable field list</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><