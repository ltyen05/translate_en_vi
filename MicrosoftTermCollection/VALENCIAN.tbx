rmNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2736146">Windows Autopilot Deployment</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45074_2908351_2909788"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A cloud deployment solution that leverages the cloud to automate the configuration of new PCs including changing default start up screens without the need of IT assistance.</descrip></descripGrp><ntig><termGrp><term id="2908351">AutoPilot</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2909788">Autopilot</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45078_2543137_2544396"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Windows, an input panel where user can insert emojis and other expressive images or symbols. When using the en-US hardware keyboard to type, user can use SPACE+ : (colon) to input emoji in an easy and smart way. Rather than having to use the mouse, user can bring up the emoji panel and search or arrow key through the options. Eventually, this panel will include stickers and other expression objects.</descrip></descripGrp><ntig><termGrp><term id="2543137">emoji panel</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2544396">tauler d'emojis</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45086_2911839_2912611"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A worker who serves as the first point of contact between companies, their customers, products, suppliers and the market and who often directly impact the customer experience and the delivery and development of products and services.</descrip></descripGrp><ntig><termGrp><term id="2911839">frontline worker</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2912611">treballador de primera línia</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45100_2544667_2545521"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that allows users to use a digital pen and make the strokes appear in pencil texture.</descrip></descripGrp><ntig><termGrp><term id="2544667">Digital Pencil</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2545521">Llapis digital</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45101_2544668_2545523"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An ink type that looks like pencil strokes.</descrip></descripGrp><ntig><termGrp><term id="2544668">pencil texture</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2545523">textura del llapis</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45113_2546253_2549010"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft solutions framework that brings together Office 365, Windows 10 and Enterprise Mobility + Security.</descrip></descripGrp><ntig><termGrp><term id="2546253">Microsoft 365</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2549010">Microsoft 365</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45118_2547320_2548390"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The section in the Xbox Store where developers participating in the Xbox Live Creators Program publish their games directly. The collection offers exciting and diverse games that are fun to pick up and play.</descrip></descripGrp><ntig><termGrp><term id="2547320">Creators Collection</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2548390">Col·lecció dels creadors</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45134_2547479_2548069"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An edition of Windows with unique support for server-grade hardware, and designed to meet demanding needs of mission-critical and compute-intensive workloads.</descrip></descripGrp><ntig><termGrp><term id="2547479">Windows 10 Pro for Workstations</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2548069">Windows 10 Pro for Workstations</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45135_2547505_2915855"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The bot built into Microsoft Teams that triggers Planner notifications to Teams users when tasks are assigned to them.</descrip></descripGrp><ntig><termGrp><term id="2547505">Planner Bot</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2915855">Robot del Planner</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45136_2547959_2581223"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature within Office 365 that provides the ability to extend an online meeting to users which are outside of the organization.</descrip></descripGrp><ntig><termGrp><term id="2547959">Audio Conferencing</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2581223">Audioconferència</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45136_2581285_2581223"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature within Office 365 that provides the ability to extend an online meeting to users which are outside of the organization.</descrip></descripGrp><ntig><termGrp><term id="2581285">Office 365 Audio Conferencing</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2581223">Audioconferència</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45139_2547962_2848584"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that provides a way to pay for calls and helps ensure that the users are able to make audio conferences or international phone calls.</descrip></descripGrp><ntig><termGrp><term id="2547962">Communications Credits</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2848584">Crèdits de comunicacions</term><termNote type="