users or administrators to have more control over when the UI transitions from one version to the next.</descrip></descripGrp><ntig><termGrp><term id="1088883">visual upgrade</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969343">actualització visual</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23717_1088887_1967800"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of conditional formatting that is configured within Microsoft SQL Server Analysis Services.</descrip></descripGrp><ntig><termGrp><term id="1088887">data source formatting</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1967800">format del servidor OLAP</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23717_1088887_1969344"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of conditional formatting that is configured within Microsoft SQL Server Analysis Services.</descrip></descripGrp><ntig><termGrp><term id="1088887">data source formatting</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969344">format d'origen de les dades</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNot