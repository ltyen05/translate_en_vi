.</descrip></descripGrp><ntig><termGrp><term id="760123">ACE</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1967562">motor de base de dades de l'Access</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20946_760123_1967576"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Part of the Access database system that retrieves and stores data in user and system databases. The engine can be thought of as a data manager on which database systems are built.</descrip></descripGrp><ntig><termGrp><term id="760123">ACE</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1967576">Motor de connectivitat de l'Access</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20946_760124_1967561"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Part of the Access database system that retrieves and stores data in user and system databases. The engine can be thought of as a data manager on which database systems are built.</descrip></descripGrp><ntig><termGrp><term id="760124">Access database engine</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1967561">ACE</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20946_760124_1967562"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Part of the Access database system that retrieves and stores data in user and system databases. The engine can be thought of as a data manager on which database systems are built.</descrip></descripGrp><ntig><termGrp><term id="760124">Access database engine</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1967562">motor de base de dades de l'Access</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20946_760124_1967576"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Part of the Access database system that retrieves and stores data in user and system databases. The engine can be thought of as a data manager on which database systems are built.</descrip></descripGrp><ntig><termGrp><term id="760124">Access database engine</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1967576">Motor de connectivitat de l'Access</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20947_760125_1967563"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The list that appears when you click the arrow in the Action column of the Macro object tab.</descrip></descripGrp><ntig><termGrp><term id="760125">action list</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1967563">llista d'accions</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20948_760126_1967564"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of gathering information by sending and receiving HTML forms or InfoPath forms from Access.</descrip></descripGrp><ntig><termGrp><term id="760126">data collection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1967564">compilació de dades</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20949_760128_1967566"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of objects that can include tables, queries, forms, reports, macros, and code modules that are designed to work together to make a database easier to use.</descrip></descripGrp><ntig><termGrp><term id="760128">database application</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1967566">aplicació de base de dades</term><termNote type="geogra