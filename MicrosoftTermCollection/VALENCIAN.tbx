Set xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to an entity imported from an external accounting system into Business Contact Manager for Outlook.</descrip></descripGrp><ntig><termGrp><term id="180162">external</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1968591">extern</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43506_2462246_2465591"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The mixed-reality shell experience, in which content can be placed and used in virtual (or, in the case of HoloLens, real) surroundings.</descrip></descripGrp><ntig><termGrp><term id="2462246">mixed world</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2465591">món mixt</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43511_2462585_2738967"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A directed acyclic graph in Apache Storm that defines how data flows between spouts and bolts.</descrip></descripGrp><ntig><termGrp><term id="2462585">topology</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2738967">topologia</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4353_151854_2235107"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method of delivering digital media across a network in a continuous flow. The digital media is played by client software as it is received.</descrip></descripGrp><ntig><termGrp><term id="151854">streaming</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2235107">reproducció multimèdia</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4353_2227182_2235107"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method of delivering digital media across a network in a continuous flow. The digital media is played by client software as it is received.</descrip></descripGrp><ntig><termGrp><term id="2227182">media streaming</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2235107">reproducció multimèdia</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4354_185591_2508157"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The menu from which the user can call someone, send an instant message or email, schedule or join a conference, start a video conversation, set options, start a Live Meeting, or run the Audio and Video Tuning Wizard.</descrip></descripGrp><ntig><termGrp><term id="185591">Actions</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2508157">Accions</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43568_2463950_2955108"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The offer for Microsoft Classroom targeted at faculty members.</descrip></descripGrp><ntig><termGrp><term id="2463950">Microsoft Classroom for faculty</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2955108">Microsoft Classroom per a docents</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43569_2463966_2955109"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The offer for Microsoft Classroom targeted at university students.</descrip></descripGrp><ntig><termGrp><term id="2463966">Microsoft Classroom for students</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2955109">Microsoft Classroom per a alumnes</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGe