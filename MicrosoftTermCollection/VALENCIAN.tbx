955561">CUBEMEMBER</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2994879">CUBEMEMBER</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52350_2955562_2994880"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Cube Excel function that returns the value of a member property in the cube. Use to validate that a member name exists within the cube and to return the specified property for this member.</descrip></descripGrp><ntig><termGrp><term id="2955562">CUBEMEMBERPROPERTY</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2994880">CUBEMEMBERPROPERTY</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52351_2955563_2994881"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Cube Excel function that returns the nth, or ranked, member in a set. Use to return one or more elements in a set, such as the top sales performer or top 10 students.</descrip></descripGrp><ntig><termGrp><term id="2955563">CUBERANKEDMEMBER</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2994881">CUBERANKEDMEMBER</term><termNote type="geographicalUsage">ESP</termNote><termNote typ