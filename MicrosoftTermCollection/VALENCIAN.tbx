>NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970022">galeria Desplaça sempre</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20697_777440_1568510"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of computers on a home network that can share pictures, music, videos, documents, and printers. A homegroup is created by using the HomeGroup feature; it is protected with a password.</descrip></descripGrp><ntig><termGrp><term id="777440">homegroup</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1568510">grup domèstic</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20698_782774_1770293"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A password that helps prevent unauthorized access to homegroup files and printers.</descrip></descripGrp><ntig><termGrp><term id="782774">homegroup password</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1770293">contrasenya del grup domèstic</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20703_746420_1566588"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An action that removes redundant messages from an email conversation to reduce information overload and improve readability.</descrip></descripGrp><ntig><termGrp><term id="746420">Clean Up</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1566588">Neteja</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20704_746421_1970023"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A fork within a conversation, where more than one reply was made to a single email and caused a split in the conversation.</descrip></descripGrp><ntig><termGrp><term id="746421">branch</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970023">branca</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20705_746424_2927405"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To confer with the call recipient before transferring a call or adding the call recipient to a conference call.</descrip></descripGrp><ntig><termGrp><term id="746424">consult</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2927405">consultar</term><termNote type="geographicalUsage">ESP<