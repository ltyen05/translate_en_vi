finition">The process of transposing, aggregating and validating data from source to destination models that are in the application database.</descrip></descripGrp><ntig><termGrp><term id="1508564">Data Movement job</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969825">faena de desplaçament de dades</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29448_1508565_1969826"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A row that is added to a single cell for the purpose of specifying detailed information for a single line item in an assignment matrix.</descrip></descripGrp><ntig><termGrp><term id="1508565">line item detail</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969826">detall de l'element de la línia</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29449_1508566_1969827"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A KPI that has one or more child KPIs underneath it in a scorecard hierarchy.</descrip></descripGrp><ntig><termGrp><term id="1508566">parent KPI</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969827">KPI principal</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29450_1508567_1969828"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The database where the exported data resides when a Data Export job is run.</descrip></descripGrp><ntig><termGrp><term id="1508567">outbound database</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969828">base de dades d'eixida</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29451_1508568_1969829"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A copy of the settings and properties that are selected when a report is defined by using the Report Wizard.</descrip></descripGrp><ntig><termGrp><term id="1508568">Report Wizard instance</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969829">instància d'auxiliar d'informes</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29452_1508569_1969830"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of rollup of that is used for KPIs. It causes an objective KPI to display the same indicator as the lowest performing child KPI in a scorecard hierarchy.</descrip></descripGrp><ntig><termGrp><term id="1508569">Worst Child rollup</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969830">informe del pitjor KPI</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29452_1508570_1969830"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of rollup of that is used for KPIs. It causes an objective KPI to display the same indicator as the lowest performing child KPI in a scorecard hierarchy.</descrip></descripGrp><ntig><termGrp><term id="1508570">worst indicator rollup</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969830">informe del pitjor KPI</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29454_1508752_1968667"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A context-menu command that can launch an operation with a selected item as a parameter or retrieve information about the selected item. Actions are enabled by cube administrators and are defined in SQL Server Analysis Services.</descrip></descripGrp><ntig><termGrp><term id="1508752">Additional Actions</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1968667">Accions addicionals</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29455_1508759_1967649"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A measure whose value is calculated at run time by using an expression.</descrip></descripGrp><ntig><termGrp><term id="1508759">calculated measure</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1967649">mesura calculada</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29456_1508794_1970075"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A program you can use to create and manage Internet and intranet sites without programming. Available with Microsoft Office or as a stand-alone product.</descrip></descripGrp><ntig><termGrp><term id="1508794">Microsoft FrontPage</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970075">Microsoft FrontPage</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29458_1508805_1970076"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A high resolution, tag-based graphics format, based on the Tagged Image File Format (TIFF) used for digital graphics.</descrip></descripGrp><ntig><t