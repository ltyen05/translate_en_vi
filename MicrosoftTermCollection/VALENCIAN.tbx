73"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A specific type of published item that represents a range of cells.</descrip></descripGrp><ntig><termGrp><term id="1506808">published range</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969673">àmbit publicat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29223_1506809_1969674"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A sheet that is published.</descrip></descripGrp><ntig><termGrp><term id="1506809">published sheet</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969674">full publicat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29224_1506810_1969675"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The version of a list item that is approved and can be seen by all users. The user interface (UI) version number for a published version is incremented to the next positive major version number and the minor version is zero. and minor version.</descrip></descripGrp><ntig><termGrp><term id="1506810">published version</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969675">versió publicada</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29225_1506811_1969676"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An integer that is assigned to a document to indicate the publishing status of that version of the document.</descrip></descripGrp><ntig><termGrp><term id="1506811">publishing level</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969676">nivell de publicació</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29226_1506812_1969677"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A document that binds to a page layout to generate an HTML page for display to a reader. Publishing pages have specific fields that contain the content that is displayed in an HTML page.</descrip></descripGrp><ntig><termGrp><term id="1506812">publishing page</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969677">pàgina de publicació</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29227_1506814_1969678"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A system to rank items that uses features that do not vary with different queries.</descrip></descripGrp><ntig><termGrp><term id="1506814">query independent rank</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969678">jerarquia independent de consultes</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29228_1506815_1969679"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of recording information about user searches, such as search terms and time of access.</descrip></descripGrp><ntig><termGrp><term id="1506815">query logging</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969679">registre de consultes</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29229_1506817_1969680"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A result for a given query, which contains the title and URL of the item, and can also contain other managed properties and a hit-highlighted summary.</descrip></descripGrp><ntig><termGrp><term id="1506817">query result</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969680">resultat de la consulta</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2923_59620_1770262"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method of specifying software behavior by system administrators. Administrators set policies that are used to control how software features behave.</descrip></descripGrp><ntig><termGrp><term id="59620">Group Policy</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1770262">Estratègia de grup</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29230_1506818_1969681"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A two-dimensional table that presents data from an external data source.</descrip></descripGrp><ntig><termGrp><term id="1506818">query table</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969681">taula de consultes</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29231_1506819_1969682"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The textual string portion of a query. Frequently, a user enters query text, but it can be programmatically amended and is not guaranteed to be exactly what the user typed.</descrip></descripGrp><ntig><termGrp><term id="1506819">query text</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969682">text de la consulta</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29232_1506820_1969683"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A value that is used to influence the algorithm that determines the rank of an item.</descrip></descripGrp><ntig><termGrp><term id="1506820">ranking parameter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969683">paràmetre de classificació</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29233_1506822_1969684"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A system for specifying cells or ranges of cells and that is used in formulas. A reference style is used to specify a specific cell in a two-dimensional table by identifying the row and column that contain that cell or range of cells.</descrip></descripGrp><ntig><termGrp><term id="1506822">reference style</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969684">estil de referència</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29234_1506823_1969685"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An element of markup in a page that defines a relationship between binary files on the server that implements Web Parts and Web controls. The register directive also serves as the namespace of the markup in the Web Part Page that will refer to those binary files.</descrip></descripGrp><ntig><termGrp><term id="1506823">register directive</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969685">directiva Register</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29235_1506824_1969686"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A search result that is relevant to a query term based on rank. By default, the higher the rank, the higher the item appears in the query results.</descrip></descripGrp><ntig><termGrp><term id="1506824">relevant result</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969686">resultat rellevant</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29236_1506826_1968618"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An event in which various statistics are calculated and recorded in the main catalog.</descrip></descripGrp><ntig><termGrp><term id="1506826">reranking</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1968618">tornar a classificar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29237_1506827_1969687"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An integer that identifies the relative location of a relevant result within a search results page. The first relevant result has a result position of 1, the second has 2, the 11th has 11, and so on.</descrip></descripGrp><ntig><termGrp><term id="1506827">result position</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969687">posició de resultat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29238_1506828_1969688"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An integer that uniquely identifies a role definition within a site.</descrip></descripGrp><ntig><termGrp><term id="1506828">role identifier</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969688">identificador de funció</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29239_1506830_1969689"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A document in the root folder of a site.</descrip></descripGrp><ntig><termGrp><term id="1506830">root document</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969689">document arrel</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29240_1506831_1968619"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A status that is applied to a list item or document that specifies a time when the item or document will be published or unpublished.</descrip></descripGrp><ntig><termGrp><term id="1506831">scheduled</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1968619">planificat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29241_1506833_1969690"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An integer value that represents the version number of the schema for a deployment package.</descrip></descripGrp><ntig><termGrp><term id="1506833">schema version</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969690">versió de l'esquema</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29242_1506835_1969691"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A GUID that uniquely identifies a scope within a site collection.</descrip></descripGrp><ntig><termGrp><term id="1506835">scope identifier</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969691">identificador de l'àmbit</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29243_1506837_1969692"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A unique group of search settings that is associated, one-to-one, with a shared service provider.</descrip></descripGrp><ntig><termGrp><term id="1506837">search application</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969692">aplicació de recerca</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29244_1506838_1969693"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">All of the crawl data that is associated with a given search application. A search catalog provides information that is used to generate query results.</descrip></descripGrp><ntig><termGrp><term id="1506838">search catalog</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969693">catàleg de recerca</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29245_1506839_1969694"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A database that stores search-related information, including stored procedures and tables that are used for crawler data, document metadata, and administration information.</descrip></descripGrp><ntig><termGrp><term id="1506839">search database</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969694">base de dades de recerca</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29246_1506840_1969695"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of updating a full-text index catalog to reflect unincorporated changes to the definitions of search scopes.</descrip></descripGrp><ntig><termGrp><term id="1506840">search scope compilation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969695">compilació de l'àmbit de recerca</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29247_1506841_1969696"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A site collection that uses a particular search scope display group.</descrip></descripGrp><ntig><termGrp><term id="1506841">search scope consumer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969696">consumidor de l'àmbit de recerca</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29248_1506842_1969697"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of scope consumers.</descrip></descripGrp><ntig><termGrp><term id="1506842">search scope consumer group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969697">grup de consumidors de l'àmbit de recerca</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29249_1506844_1969698"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An ordered set of search scopes, defined by an administrator or programmatically, and used for returning groups of search scopes. Search scope display groups are saved for each search scope consumer and search scopes can be in multiple search scope display groups.</descrip></descripGrp><ntig><termGrp><term id="1506844">search scope display group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969698">grup de visualització de l'àmbit de recerca</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2925_558978_1969187"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Internet Information Services (IIS) virtual server and port used for SharePoint Central Administration.</descrip></descripGrp><ntig><termGrp><term id="558978">administration port</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969187">port d'administració</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29250_1506846_1969699"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A specialized component of a full-text index catalog that is built on the values of scoped properties for optimized queries.</descrip></descripGrp><ntig><termGrp><term id="1506846">search scope index</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969699">índex de l'àmbit de recerca</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29251_1506847_1969700"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An attribute that specifies which items are included in a given search scope.</descrip></descripGrp><ntig><termGrp><term id="1506847">search scope rule</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969700">regla de l'àmbit de recerca</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29252_1506848_1969701"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user-specified string that is associated with a search scope rule. It is used to determine membership of an item in the associated search scope.</descrip></descripGrp><ntig><termGrp><term id="1506848">search scope rule value</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969701">valor de la regla de l'àmbit de recerca</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29253_1506849_1969702"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An object that represents the specifications of the search service on one particular server.</descrip></descripGrp><ntig><termGrp><term id="1506849">search service instance</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term i