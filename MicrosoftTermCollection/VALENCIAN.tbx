.</descrip></descripGrp><ntig><termGrp><term id="1286748">main operator extension</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1968297">extensió d'operador principal</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26595_1286750_1968298"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mechanism for connecting the voice network of an enterprise to a service provider that offers public switched telephone network (PSTN) origination, termination, and emergency services without deploying PSTN gateways.</descrip></descripGrp><ntig><termGrp><term id="1286750">SIP trunking</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1968298">entroncament SIP</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26595_1286750_1968299"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mechanism for connecting the voice network of an enterprise to a service provider that offers public switched telephone network (PSTN) origination, termination, and emergency services without deploying PSTN gateways.</descrip></descripGrp><ntig><termGrp><term id="1286750">SIP trunking</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1968299"