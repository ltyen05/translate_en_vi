ure that allows you to bookmark webpages and articles to read later.</descrip></descripGrp><ntig><termGrp><term id="2277931">reading list</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2280995">llista de lectura</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39278_2278224_2280994"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The UI option on the Start menu to shut down, restart the computer, or put the computer to sleep.</descrip></descripGrp><ntig><termGrp><term id="2278224">Power</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2280994">Engegada</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39286_2280415_2508393"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Skype for Business service in Office 365 that enables producers to stream a Skype Meeting to thousands of users using Azure Media Services, live and on demand.</descrip></descripGrp><ntig><termGrp><term id="2280415">Skype Meeting Broadcast</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2508393">Difusió de reunió de Skype</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOf