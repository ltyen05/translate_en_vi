n entity, such as a device or program, that connects to another entity over a network.</descrip></descripGrp><ntig><termGrp><term id="483">client</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1967615">ordinador client</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="728_484_1566592"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An entity, such as a device or program, that connects to another entity over a network.</descrip></descripGrp><ntig><termGrp><term id="484">client computer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1566592">client</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="728_484_1967615"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An entity, such as a device or program, that connects to another entity over a network.</descrip></descripGrp><ntig><termGrp><term id="484">client computer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1967615">ordinador client</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7280_502936_1588616"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A presence status the user can select, while signed in, to make it appear to other users that he or she is currently willing to be contacted.</descrip></descripGrp><ntig><termGrp><term id="502936">available</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1588616">disponible</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7290_60173_1567283"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Any token that a program can use to identify and access an object such as a device, a file, a window, or a dialog box.</descrip></descripGrp><ntig><termGrp><term id="60173">handle</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1567283">identificador</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7294_370776_1970000"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An XML-based specification for the exchange, editing, and delivery of 2-D vector graphics on the Web. An application of XML (Extensible Markup Language), VML uses XML tags and Cascading Style Sheets to create and place vector graphics, such as circles and squares, in an XML or HTML document, such as a Web page. These graphics, which are rendered in the native operating system, can include color and are editable in a variety of graphics programs.</descrip></descripGrp><ntig><termGrp><term id="370776">Vector Markup Language</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970000">VML</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7294_370777_1970000"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An XML-based specification for the exchange, editing, and delivery of 2-D vector graphics on the Web. An application of XML (Extensible Markup Language), VML uses XML tags and Cascading Style Sheets to create and place vector graphics, such as circles and squares, in an XML or HTML document, such as a Web page. These graphics, which are rendered in the native operating system, can include color and are editable in a variety of graphics programs.</descrip></descripGrp><ntig><termGrp><term id="370777">VML</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970000">VML</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7306_119668_1572395"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To touch an item once with the tablet pen and then lift the pen quickly.</descrip></descripGrp><ntig><termGrp><term id="119668">tap</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1572395">tocar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7309_116642_1572368"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To retain a physical representation of (data or instructions) that enables them to be subsequently retrieved.</descrip></descripGrp><ntig><termGrp><term id="116642">store</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1572368">emmagatzemar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="731_361193_1572261"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To remove unused space from data tables.</descrip></descripGrp><ntig><termGrp><term id="361193">shrink</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1572261">reduir</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7315_126572_1572444"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A person who uses products such as devices, services, 