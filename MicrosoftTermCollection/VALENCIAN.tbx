</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46046_2594916_2596363"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The area in Windows Defender Security Center where people can see, access, and troubleshoot features related to their accounts, including device login, Windows Hello, Dynamic Lock, and other convenience and security features related to accounts and login.</descrip></descripGrp><ntig><termGrp><term id="2594916">account protection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2596363">protecció del compte</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46047_2594920_2596364"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The area in Windows Defender Security Center, within Ransomware protection, where customers can set up or initiate file restores with cloud providers, to help recover from a ransomware attack (which often encrypts files).</descrip></descripGrp><ntig><termGrp><term id="2594920">Ransomware data recovery</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2596364">Recuperació de dades de programari de rescat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46048_2594927_2596365"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In the Windows Defender Security Center, the area within the Virus &amp; threat protection section (pillar), where customers can find and use features to help prevent or recover from ransomware attacks.​</descrip></descripGrp><ntig><termGrp><term id="2594927">Ransomware protection</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2596365">Protecció contra programari de rescat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46049_2594936_2596382"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Windows Defender Security Center, the area within the Virus &amp; threat protection section (pillar) where customers can see the history of the threats found on their devices.</descrip></descripGrp><ntig><termGrp><term id="2594936">Threat history</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2596382">Historial d'amenaces</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4605_415552_1969035"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A company that owns enough voting stock in another company to control management and operations by influencing or electing its board of directors.</descrip></descripGrp><ntig><termGrp><term id="415552">holding company</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969035">societat de cartera</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46050_2594944_2596385"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Windows Defender Security Center app on Windows 10, the area within the Virus &amp; threat protection section (pillar) where customers can see information about ​the definitions being used to recognize the latest threats on their device, and check for updates to those definitions.</descrip></descripGrp><ntig><termGrp><term id="2594944">Virus &amp; threat protection updates</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2596385">Actualitzacions de la protecció contra virus i amenaces</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46052_3029685_3030260"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app that allows users to make and receive calls and texts, check notifications, and instantly access their Android device's photos and apps from their Windows PC.</descrip></descripGrp><ntig><termGrp><term id="3029685">Phone Link</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><ter