unctionality of Microsoft Word. Commands and functions in a loaded WLL are also available to Microsoft Visual Basic projects.</descrip></descripGrp><ntig><termGrp><term id="232859">Word Add-in Library</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970734">Biblioteca de complements del Word</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12562_232859_1970735"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A stand-alone, dynamic-link library that, when loaded, can add custom commands that extend the functionality of Microsoft Word. Commands and functions in a loaded WLL are also available to Microsoft Visual Basic projects.</descrip></descripGrp><ntig><termGrp><term id="232859">Word Add-in Library</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970735">WLL</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12562_232860_1970734"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A stand-alone, dynamic-link library that, when loaded, can add custom commands that extend the functionality of Microsoft Word. Commands and functions in a loaded WLL are also available to Microsoft Visual Basic projects.</descrip></descripGrp><ntig><termGrp><term id="232860">WLL</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970734">Biblioteca de complements del Word</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12562_232860_1970735"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A stand-alone, dynamic-link library that, when loaded, can add custom commands that extend the functionality of Microsoft Word. Commands and functions in a loaded WLL are also available to Microsoft Visual Basic projects.</descrip></descripGrp><ntig><termGrp><term id="232860">WLL</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970735">WLL</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12578_58758_1567274"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A button on the address bar that enables the user to navigate to the specified location (such as a folder path or web address).</descrip></descripGrp><ntig><termGrp><term id="58758">Go</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1567274">Vés-hi</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12587_361173_1968937"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An update process that uses an analysis of historical information accumulated over all previous updates to determine which documents are likely to have changed. Only this content is accessed during the crawl.</descrip></descripGrp><ntig><termGrp><term id="361173">adaptive update</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1968937">actualització d'adaptació</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12592_77991_1570415"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A person whose work or profession is management.</descrip></descripGrp><ntig><termGrp><term id="77991">manager</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1570415">administrador</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12597_235370_2454114"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A structured set of activities designed to yield a specified result or output.</descrip></descripGrp><ntig><termGrp><term id="235370">process</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2454114">procés</term><termNote type="g