 type="definition">To move between different environments and have the same user experience in both environments.</descrip></descripGrp><ntig><termGrp><term id="180015">roam</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2907167">utilitzar un perfil d'itinerància</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14085_361581_2915575"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A message transfer protocol used by the World Wide Web to service page requests, and which adds a security layer using Secure Socket Layer (SSL) technology.</descrip></descripGrp><ntig><termGrp><term id="361581">Hypertext Transfer Protocol over Secure Sockets Layer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2915575">HTTPS</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14085_361582_2915575"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A message transfer protocol used by the World Wide Web to service page requests, and which adds a security layer using Secure Socket Layer (SSL) technology.</descrip></descripGrp><ntig><termGrp><term id="361582">HTTPS</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2915