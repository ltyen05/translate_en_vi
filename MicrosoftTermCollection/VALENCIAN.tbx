NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2380511">Grups de l'Office 365</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36805_2874478_2879269"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that unifies components across applications, such as people, conversations, calendars, emails, and files, to create a seamless collaboration experience. Creating a group anywhere in Microsoft 365 will automatically provision a corresponding Yammer conversation feed, an Outlook inbox and calendar, and a SharePoint document library for every Group member. Groups make these components persistent across applications, so that changes made to components in part of Microsoft 365 will carry through to the others, thus enabling a unified experience.</descrip></descripGrp><ntig><termGrp><term id="2874478">Microsoft 365 Groups</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2879269">Microsoft 365 Groups</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36806_2072312_2078543"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The database that stores search feature settings which include but are not limited to query rules and the search schema.</descrip></descripGrp><ntig><termGrp><term id="2072312">search settings database</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2078543">base de dades de configuracions de recerca</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36807_2072313_2078542"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables the user to record on-screen activity, and embeds the video automatically in PowerPoint.</descrip></descripGrp><ntig><termGrp><term id="2072313">Screen Recording</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2078542">Enregistrament de pantalla</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36824_2077814_2508381"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Skype software application that uses the non-desktop user interface introduced with Windows 8.</descrip></descripGrp><ntig><termGrp><term id="2077814">Skype for modern Windows</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2508381">Skype per al Windows modern</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36825_2078795_2508387"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Skype software application for Windows desktop.</descrip></descripGrp><ntig><termGrp><term id="2078795">Skype for Windows desktop</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2508387">Skype per a l'escriptori del Windows</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36831_2082095_2152928"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A management object that contains the connection settings and administrator credentials for the source server that hosts the mailboxes that you want to migrate to Exchange Online.</descrip></descripGrp><ntig><termGrp><term id="2082095">Migration Endpoint</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2152928">Extrem de migració</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36832_2085426_2093863"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A menu that contains the most commonly used contextual commands such as Cut, Copy, Paste, Comment, and Proofing.</descrip></descripGrp><ntig><termGrp><term id="2085426">Mini Toolbar</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2093863">Minibarra d'eines</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36833_2085429_2093862"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A yellow bar with a warning icon appearing below the ribbon that provides information or alerts the user. Information can be security alerts, errors, or notifications.</descrip></descripGrp><ntig><termGrp><term id="2085429">Message Bar</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2093862">Barra de missatges</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36834_2085430_2093865"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A dialog box that shows the progress of an operation.</descrip></descripGrp><ntig><termGrp><term id="2085430">Progress UI</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2093865">IU de progrés</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36835_2085431_2093864"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A recurring meeting that does not have a standard pattern of daily, weekly, monthly, etc.</descrip></descripGrp><ntig><termGrp><term id="2085431">custom repeat</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2093864">repetició personalitzada</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36836_2086047_2093861"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The icon on the upper-left corner of the Office 365 suite. The icon is the entry point to all Office 365 services for which the user has a valid subscription, and to the Admin center (only if the user is an admin).</descrip></descripGrp><ntig><termGrp><term id="2086047">app launcher</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2093861">iniciador d'aplicacions</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36868_2093283_2152932"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A component in Exchange 2013 that performs background tasks, such as mailbox database maintenance, mailbox processing, inference training, calendar repair, offline address book generation, and more.</descrip></descripGrp><ntig><termGrp><term id="2093283">Time-Based Assistant</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2152932">Auxiliar de tasques de duració definida</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36869_2093284_2152937"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A component in Exchange 2013 that performs background tasks, such as mailbox database maintenance, mailbox processing, inference training, calendar repair, offline address book generation, and more.</descrip></descripGrp><ntig><termGrp><term id="2093284">Time-Based Assistant</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2152937">Auxiliar de tasques de duració definida</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36870_2093285_2152914"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A time-based assistant (TBA) that parses emails and makes internal inferences based on them. Inferences are used to allow the system to gain insight into a user’s mailbox based on user patterns. Those inferences are then used to populate features for users, such as People View in Outlook Web App.</descrip></descripGrp><ntig><termGrp><term id="2093285">inference training</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2152914">aprenentatge d'inferències</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36871_2093286_2152917"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A component that feeds data (such as mailbox messages) to the inference training assistant in batches. It controls performance by giving the inference training assistant a fixed amount of work to process at each interval.</descrip></descripGrp><ntig><termGrp><term id="2093286">inference training feeder</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2152917">alimentador d'aprenentatge d'inferències</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36872_2093287_2105588"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature of OneNote for Android that allows you to create notes, audio notes, and picture notes right from your phone’s home screen.</descrip></descripGrp><ntig><termGrp><term id="2093287">widget</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2105588">giny</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36873_2093298_2105585"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A contextual tab on the Ribbon that enables the user to modify the appearance, size, and other aspects of the container controls in a form.</descrip></descripGrp><ntig><termGrp><term id="2093298">Control Tools</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2105585">Eines de control</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36880_2099681_2175814"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The on-screen keyboard key that traditionally (as in word processing) is used to insert tab characters into a document.</descrip></descripGrp><ntig><termGrp><term id="2099681">Tab</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2175814">Tabulador</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36882_2099685_2948420"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A GUI tool used to create and manage lists that tell Internet Explorer 11 which websites to run in Enterprise Mode.</descrip></descripGrp><ntig><termGrp><term id="2099685">Enterprise Mode Site List Manager</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2948420">Administrador de la llista de llocs de mode empresarial</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36887_2099902_2192528"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Street level imagery that enables users to experience Bing Maps from the street level. Streetside supplements maps, directions and local search.</descrip></descripGrp><ntig><termGrp><term id="2099902">Streetside</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2192528">Streetside</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36894_2099909_2508228"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Saved objects associated with a map, such as a locations and routes.</descrip></descripGrp><ntig><termGrp><term id="2099909">favorites</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2508228">favorits</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36900_2101411_2105591"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Outlook email filter that moves low priority messages out of the Inbox to the Clutter folder based on individual user preferences.</descrip></descripGrp><ntig><termGrp><term id="2101411">Clutter</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2105591">Altres correus</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36904_2101422_2999876"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A seminar conducted through the Internet.</descrip></descripGrp><ntig><termGrp><term id="2101422">webinar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2999876">seminari web</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36904_2101808_2999876"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A seminar conducted through the Internet.</descrip></descripGrp><ntig><termGrp><term id="2101808">web-based seminar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2999876">seminari web</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36910_2101809_2124480"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The link to the Microsoft privacy statement.</descrip></descripGrp><ntig><termGrp><term id="21018