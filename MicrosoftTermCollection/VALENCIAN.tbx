/termGrp></ntig></langSet></termEntry><termEntry id="32747_1698384_1708207"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To remotely view, stream, or copy files stored on a PC running OneDrive from any other device.</descrip></descripGrp><ntig><termGrp><term id="1698384">fetch</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1708207">recollir</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32769_1703344_1781660"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An action by which a subscription (the source subscription) is replaced by a new subscription, both owned by the same billing account, along a preconfigured conversion path. The source subscription is canceled and the destination subscription is the new subscription.</descrip></descripGrp><ntig><termGrp><term id="1703344">conversion</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1781660">conversió</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32770_1703345_1781675"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A new subscription that is created as a result of a conversion or a merge.</descrip></descripGrp><ntig><termGrp><term id="1703345">destination subscription</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1781675">subscripció de destinació</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32773_1703347_1781671"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A subscription that is canceled to create a new subscription as a result of a conversion or merge.</descrip></descripGrp><ntig><termGrp><term id="1703347">source subscription</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1781671">subscripció d'origen</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32774_1703348_1781665"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A partner in scenarios where the partner providing the offer is different than the partner providing the service, for example, Xbox selling Messenger products.</descrip></descripGrp><ntig><termGrp><term id="1703348">merchant</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1781665">comerciant</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32775_1703349_1781666"><langSet xml:lang="en-US"><de