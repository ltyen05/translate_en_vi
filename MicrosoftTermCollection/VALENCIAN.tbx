tement) that creates a new table and then creates records (rows) in it by copying records from an existing table.</descrip></descripGrp><ntig><termGrp><term id="360105">Make Table query</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1967513">Consulta de creació de taules</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9078_360105_1971737"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A query (SQL statement) that creates a new table and then creates records (rows) in it by copying records from an existing table.</descrip></descripGrp><ntig><termGrp><term id="360105">Make Table query</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1971737">consulta de creació de taules</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9084_152809_1566640"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Information such as audio, video, images, or text that is contained in a digital media file or stream.</descrip></descripGrp><ntig><termGrp><term id="152809">content</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1566640">contingut</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpee