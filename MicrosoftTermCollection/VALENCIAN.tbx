tig><termGrp><term id="2915850">telèfon</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16647_594141_1989400"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Software that provides encryption for sensitive data, such as passwords, in applications.</descrip></descripGrp><ntig><termGrp><term id="594141">encryption provider</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1989400">proveïdor de xifratge</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16658_600620_1968513"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The round button in the lower left-hand corner of the Windows screen that allows the user to click and display the Start menu.</descrip></descripGrp><ntig><termGrp><term id="600620">Start button</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1968513">botó Inicia</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16665_601385_2625777"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An attack by a malicious user or malicious software on a computer or operating system to find a secret password or a symmetric encryption key by guessing passwords or keys until the correct password or key is discovered.</descrip></descripGrp><ntig><termGrp><term id="601385">key search attack</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2625777">atac per força bruta</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16665_601385_2625780"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An attack by a malicious user or malicious software on a computer or operating system to find a secret password or a symmetric encryption key by guessing passwords or keys until the correct password or key is discovered.</descrip></descripGrp><ntig><termGrp><term id="601385">key search attack</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2625780">atac per recerca de clau</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16665_601386_2625777"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An attack by a malicious user or malicious software on a computer or operating system to find a secret password or a symmetric encryption key by guessing passwords or keys until the correct password or key is discovered.</descrip></descripGrp><ntig><termGrp><term id="601386">brute force attack</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2625777">atac per força bruta</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16665_601386_2625780"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An attack by a malicious user or malicious software on a computer or operating system to find a secret password or a symmetric encryption key by guessing passwords or keys until the correct password or key is discovered.</descrip></descripGrp><ntig><termGrp><term id="601386">brute force attack</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2625780">atac per recerca de clau</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1668_147156_1571200"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A grouping of properties presented as a tabbed page of a property sheet.</descrip></descripGrp><ntig><termGrp><term id="147156">property page</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1571200">pàgina de propietats</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16697_601660_1696954"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Microsoft site that provides a comprehensive listing of updates that can be distributed over a corporate network.</descrip></descripGrp><ntig><termGrp><term id="601660">Microsoft Update Catalog</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1696954">Catàleg del Microsoft Update</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16698_605441_1968514"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of permissions to objects in the database. Users who have been assigned the role can access these objects with the permissions specified in the role. The permissions determine what the user can do with the object – read, insert, modify, delete or execute.</descrip></descripGrp><ntig><termGrp><term id="605441">user role</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1968514">funció d'usuari</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16729_608729_1969213"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A queue type used for reports that are reported silently. It is utilized when a user is not to be notified when the event occurs or prior to reporting the event.</descrip></descripGrp><ntig><termGrp><term id="608729">headless queue</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969213">cua d'informes sense notificació</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16730_608730_1969214"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A queue type that is used for reports that the user has not seen before. It is utilized when a user is not to be notified when the event occurs, but is to be notified prior to reporting the event.</descrip></descripGrp><ntig><termGrp><term id="608730">signoff queue</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969214">cua d'informes amb aprovació</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16732_609692_1969215"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The length of time during which a pre-configured number of similar events are written to Planning Server log files, when filtering is enabled.</descrip></descripGrp><ntig><termGrp><term id="609692">window interval</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969215">interval d'espera</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculi