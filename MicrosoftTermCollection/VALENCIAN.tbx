 xml:lang="en-US"><descripGrp><descrip type="definition">The offer for Office 365 for Education that also includes email, instant messaging, HD video conferencing, 1 TB personal file storage and sharing, advanced security, analytics and PSTN conferencing and that is targeted at university students.</descrip></descripGrp><ntig><termGrp><term id="2816011">Office 365 A5 for students</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2955116">Office 365 A5 per a alumnes</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43580_2464259_2955147"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The offer for Office 365 Education E5 for faculty that does not include PSTN conferencing.</descrip></descripGrp><ntig><termGrp><term id="2464259">Office 365 Education E5 without PSTN Conferencing for faculty</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2955147">Office 365 Educació E5 sense el servei Conferència XTC per a docents</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43581_2464274_2955148"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The offer for Office 365 Education E5 for university students that does not include PSTN conferencing.</descrip></descripGrp><ntig><termGrp><term id="2464274">Office 365 Education 