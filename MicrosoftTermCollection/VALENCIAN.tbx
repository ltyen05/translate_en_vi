"partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29325_1507107_1969769"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A list that stores the sequence of actions or tasks for a business process.</descrip></descripGrp><ntig><termGrp><term id="1507107">workflow task list</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969769">llista de tasques del flux de treball</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29326_1507108_1969770"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A chart image that is embedded in a worksheet or chart sheet.</descrip></descripGrp><ntig><termGrp><term id="1507108">worksheet image</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969770">imatge del full de càlcul</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29327_1507109_1969771"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An object that is associated with a worksheet.</descrip></descripGrp><ntig><termGrp><term id="1507109">worksheet object</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969771">objecte del full de càlcul</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29328_1507110_1969772"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An abstract description of an action that is supported by a WSDL service, as specified in WSDL.</descrip></descripGrp><ntig><termGrp><term id="1507110">WSDL operation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969772">operació WSDL</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29329_1507111_1969773"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A named set of abstract operations that is supported by one or more endpoints, as specified in WSDL.</descrip></descripGrp><ntig><termGrp><term id="1507111">WSDL port type</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969773">tipus de port WSDL</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29330_1507112_1969774"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A function that is native to an application and is made available for use in formulas.</descrip></descripGrp><ntig><termGrp><term id="1507112">built-in function</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969774">funció integrada</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29331_1507113_1969775"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A special SharePoint site where an administrator can manage all sites and servers in a farm that is running Microsoft® SharePoint® Products and Technologies.</descrip></descripGrp><ntig><termGrp><term id="1507113">Central Administration site</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969775">lloc d'Administració central</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29332_1507114_1969776"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of keyword consumers.</descrip></descripGrp><ntig><termGrp><term id="1507114">keyword consumer group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969776">grup de consumidors de paraules clau</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29333_1507115_1969777"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The amount of information that is stored in a log file for a transaction. Log levels can be represented by numbers or by words from the most to the least verbose.</descrip></descripGrp><ntig><termGrp><term id="1507115">log level</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969777">nivell de registre</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29334_1507116_1969778"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A complete set of conditions that are used to generate search results, including query text, sort order, and ranking parameters.</descrip></descripGrp><ntig><termGrp><term id="1507116">search query</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969778">consulta de recerca</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29335_1507117_1969779"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A record of information about user searches, such as search terms and time of access.</descrip></descripGrp><ntig><termGrp><term id="1507117">search query log</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969779">registre de consultes de recerca</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29336_1507118_1969780"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A report that is generated from query log information. For example, a search query log report might include the number of queries that were executed every day over the past thirty days.</descrip></descripGrp><ntig><termGrp><term id="1507118">search query log report</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969780">informe de registre de consultes de recerca</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29337_1507119_1969781"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The user search security filter that specifies group and user permissions for a specific FAST Search user. FAST Search Authorization (FSA) filters out inappropriate search results by intersecting the user’s query with the user's search security filter, and checking each document’s access control list to determine if the user has permission to view that document. The user search security filter is FSA's primary means of enforcing document-level security ("security trimming"), which helps to ensure that search results display only documents that the user has permissions to read.</descrip></descripGrp><ntig><termGrp><term id="1507119">user search security filter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969781">filtre de seguretat de recerca d'usuaris</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29338_1507120_1969782"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The condition of a Web Part and the Web Part chrome surrounding it. Possible values are zero (0) for normal state or one (1) for minimized state.</descrip></descripGrp><ntig><termGrp><term id="1507120">Web Part chrome state</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969782">estat del crom de l'element web</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29339_1507121_1969783"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A default group of users on a SharePoint site. By default, the Visitors group is assigned the Read permission level.</descrip></descripGrp><ntig><termGrp><term id="1507121">Visitors group</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969783">grup Visitants</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29346_1507357_1969788"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The indicator set that can be used when the "closer to target" scoring pattern is selected when you edit the band settings.</descrip></descripGrp><ntig><termGrp><term id="1507357">centered indicator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969788">indicador centrat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29348_1507359_1969789"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An indicator set that can be used when either the "increasing is better" or "decreasing is better" scoring patterns are selected when you edit the band settings.</descrip></descripGrp><ntig><termGrp><term id="1507359">standard indicator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969789">indicador estàndard</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29349_1507362_1968664"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of Web services that determines how PerformancePoint Services operates.</descrip></descripGrp><ntig><termGrp><term id="1507362">PerformancePoint Web Services</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1968664">serveis web de PerformancePoint</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29350_1507363_1968665"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Functionality in PerformancePoint Services that makes it possible to display dashboard views that were defined in Dashboard Designer and then published to SharePoint Server.</descrip></descripGrp><ntig><termGrp><term id="1507363">PerformancePoint Web Parts</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1968665">elements web del PerformancePoint</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29351_1507364_1969790"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A location within Microsoft SharePoint Server from which dashboard content can be run. By default, all locations are trusted, but can be changed by a PerformancePoint Services administrator.</descrip></descripGrp><ntig><termGrp><term id="1507364">PerformancePoint trusted location</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969790">ubicació de confiança del PerformancePoint</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2939_7912_1967712"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The selected cell in which data is entered when you begin typing. Only one cell is active at a time. The active cell is bounded by a heavy border.</descrip></descripGrp><ntig><termGrp><term id="7912">active cell</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1967712">cel·la activa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2939_7913_1967712"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The selected cell in which data is entered when you begin typing. Only one cell is active at a time. The active cell is bounded by a heavy border.</descrip></descripGrp><ntig><termGrp><term id="7913">current cell</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1967712">cel·la activa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29398_1507580_1969791"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of standardizing data, which includes conformance, detection, and removal of duplicate data. Data cleansing facilitates data integrity and accuracy.</descrip></descripGrp><ntig><termGrp><term id="1507580">data cleansing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969791">neteja de dades</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2940_179726_1968487"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A component of a scroll bar that allows the information to be scrolled by defined increments when the user clicks it. The direction of the arrow indicates the direction in which the information scrolls.</descrip></descripGrp><ntig><termGrp><term id="179726">scroll arrow button</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1968487">fletxa de desplaçament</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2940_179727_1968487"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A component of a scroll bar that allows the information to be scrolled by defined increments when the user clicks it. The direction of the arrow indicates the direction in which the information scrolls.</descrip></descripGrp><ntig><termGrp><term id="179727">scroll arrow</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1968487">fletxa de desplaçament</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29401_1507593_1969792"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A member set that includes exactly one member from each dimension in the model. A PEL tuple does not recognize order.</descrip></descripGrp><ntig><termGrp><term id="1507593">PEL tuple</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969792">tupla PEL</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29402_1507594_1969793"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A PerformancePoint Planning Server action that performs currency conversions based on the required accounting principles.</descrip></descripGrp><ntig><termGrp><term id="1507594">Currency Translation job</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969793">faena de conversió de moneda</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29404_1507596_1969794"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The person who installs, sets up, and maintains the PerformancePoint Server system. The PerformancePoint Server administrator is usually an information technology (IT) administrator.</descrip></descripGrp><ntig><termGrp><term id="1507596">PerformancePoint Server administrator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969794">administrador del PerformancePoint Server</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29405_1507597_1969795"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The location of data that is exported from a PerformancePoint Planning application.</descrip></descripGrp><ntig><termGrp><term id="1507597">data destination</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969795">destinació de dades</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29406_1507598_1969796"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A hierarchy that is manually defined by a cube designer. These hierarchies often contain several levels.</descrip></descripGrp><ntig><termGrp><term id="1507598">user-defined hierarchy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969796">jerarquia definida per l'usuari</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29407_1507599_1969797"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The server component of Analysis Services that is specifically designed to create and maintain multidimensional data structures and provide multidimensional data in response to client queries.</descrip></descripGrp><ntig><termGrp><term id="1507599">Analysis Server</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969797">Servidor d'anàlisi</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29408_1507601_1969799"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A chart that represents data on two axes, x and y, and displays chart objects in flat graphical formatting.</descrip></descripGrp><ntig><termGrp><term id="1507601">2-D chart</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969799">gràfic 2D</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29409_1507603_1969801"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A directory on an index server or a query server where all files are stored for the purpose of creating a full-text index catalog or performing queries on a full-text index catalog.</descrip></descripGrp><ntig><termGrp><term 