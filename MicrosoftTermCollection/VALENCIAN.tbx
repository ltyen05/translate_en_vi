hone.</descrip></descripGrp><ntig><termGrp><term id="2903846">Cloud Enabled</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2880390">habilitat per al núvol</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51019_2881664_2881989"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The qualification of a facility or software for compliance standards that points out systems that need to be validated against standards that need to be met and outlines how to maintain qualifications.</descrip></descripGrp><ntig><termGrp><term id="2881664">validation plan</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2881989">pla de validació</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51020_2881665_2881990"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A special folder in Windows, such as Desktop, Documents, and Pictures, that is identified by a GUID and can be redirected to a new location.</descrip></descripGrp><ntig><termGrp><term id="2881665">known folder</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2881990">carpeta coneguda</term><termNote type="geographicalUsage">ESP</termNote><termNot