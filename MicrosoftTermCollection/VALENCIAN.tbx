156_1967783"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A chart axis that represents the category for each data point. It displays arbitrary text values like Qtr1, Qtr2, and Qtr3; it cannot display scaled numerical values.</descrip></descripGrp><ntig><termGrp><term id="650156">category axis</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1967783">eix de categories</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17797_650157_1967415"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A field that is displayed in the category area of PivotChart view. Items in a category field appear as labels on the category axis.</descrip></descripGrp><ntig><termGrp><term id="650157">category field</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1967415">camp de categoria</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17798_650158_1970553"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The point around which a shape or text block rotates.</descrip></descripGrp><ntig><termGrp><term id="650158">center of rotation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970553">centre de gir</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17799_650159_1970454"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The small overlap created where two differently colored objects that are close in luminance abut on a printed page.</descrip></descripGrp><ntig><termGrp><term id="650159">centerline trap</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970454">superposició de línia central</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17800_650160_1970006"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A way to see if a certificate used to sign a message is valid. Outlook can check the status of the certificate from the issuing certification authority's database.</descrip></descripGrp><ntig><termGrp><term id="650160">certificate revocation checking</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970006">comprovació de revocació de certificat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17801_650161_1970554"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In a statechart or activity diagram, an event in which a designated condition becomes true. A ChangeEvent is indicated by the keyword when followed by a Boolean expression in parentheses, for example: when (balance &lt; 0)</descrip></descripGrp><ntig><termGrp><term id="650161">ChangeEvent</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970554">IncidènciaCanvi</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17802_650162_1970555"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Code that enforces constraints on a table or column.</descrip></descripGrp><ntig><termGrp><term id="650162">check clause</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970555">clàusula de comprovació</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17803_650163_1967532"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A constraint that allows for business rules that span multiple tables. For example, the Order table could have a CHECK constraint that would prevent orders for a customer from exceeding a credit limit defined for the customer in the Customer table.</descrip></descripGrp><ntig><termGrp><term id="650163">CHECK constraint</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1967532">restricció CHECK</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17804_650164_1969249"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A control that is used to present a set of mutually exclusive choices. By default, a choice group contains two choice sections, one of which appears to the user as the default choice in the form.</descrip></descripGrp><ntig><termGrp><term id="650164">choice group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969249">grup d'opcions</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17806_650166_1970556"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The point at which transitions split into multiple, mutually exclusive branches, each terminating at a different destination state. One of the branches must be a default branch.</descrip></descripGrp><ntig><termGrp><term id="650166">choicepoint</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970556">punt de decisió</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17807_650167_1970455"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A small overlap that decreases the knockout of the lower of two differently colored, abutting objects.</descrip></descripGrp><ntig><termGrp><term id="650167">choke</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970455">retracció</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17808_650168_1970557"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A superclass that includes class, data type, and interface subclasses. Because all classifier subclasses share the same syntax, they are all represented by the same rectangle model element.</descrip></descripGrp><ntig><termGrp><term id="650168">classifier</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970557">classificador</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17809_650169_1970558"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of collaboration role that is a slot for an object in a collaboration. It is represented by the class rectangle symbol with only the name compartment showing.</descrip></descripGrp><ntig><termGrp><term id="650169">ClassifierRole</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970558">FuncióClassificador</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17810_650170_1970257"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The format that you define for a work breakdown structure [WBS] code or a custom outline code. The mask specifies the sequence and number of letters or numbers required for each level and the symbol separating the levels.</descrip></descripGrp><ntig><termGrp><term id="650170">code mask</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970257">màscara de codi</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17811_650171_1970258"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Visual Basic for Applications, the window that is used to display, edit, and write module-level and procedure code.</descrip></descripGrp><ntig><termGrp><term id="650171">code pane</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970258">subfinestra de codi</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17812_650172_1970559"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of modeling elements that interact within a given context to perform an operation or a use case. The objects in a collaboration are roles describing types of objects rather than representations of the objects themselves.</descrip></descripGrp><ntig><termGrp><term id="650172">collaboration</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970559">col·laboració</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17813_650173_1970560"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An interaction diagram that shows, for one system event described by one use case, how a group of objects collaborate with one another.</descrip></descripGrp><ntig><termGrp><term id="650173">collaboration diagram</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970560">diagrama de col·laboració</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17814_650174_1970007"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A keyword or phrase with an associated color that helps you keep track of items, such as messages, contacts, and appointments. You can use color categories to easily find, sort, filter, or group items.</descrip></descripGrp><ntig><termGrp><term id="650174">color category</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970007">categoria de color</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17815_650175_1967416"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The part of PivotTable view that contains column fields.</descrip></descripGrp><ntig><termGrp><term id="650175">column area</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1967416">àrea de columnes</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17817_650177_1969250"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A view containing two views. The bottom pane view shows detailed information about the tasks or resources in the top pane view. For example, the Gantt Chart view could be in the top pane and the Task Form view in the bottom pane.</descrip></descripGrp><ntig><termGrp><term id="650177">combination view</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969250">visualització de combinació</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17818_650178_1970259"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A resource that is formally allocated to any task assignments they have within a project.</descrip></descripGrp><ntig><termGrp><term id="650178">committed resource</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970259">recurs compromés</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17819_650179_1970561"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In a statechart or activity diagram, a relationship between multiple source and/or target states or action states.</descrip></descripGrp><ntig><termGrp><term id="650179">complex transition</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970561">transició complexa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1782_130364_2014261"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The representation of information and data in the form of an image, diagram, or animation. For example, some databases can interpret and show data in the form of a two- or three-dimensional model.</descrip></descripGrp><ntig><termGrp><term id="130364">visualization</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2014261">visualització</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1782_130364_2628119"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The representation of information and data in the form of an image, diagram, or animation. For example, some databases can interpret and show data in the form of a two- or three-dimensional model.</descrip></descripGrp><ntig><termGrp><term id="130364">visualization</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2628119">visualització de dades</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1782_2396693_2014261"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The representation of information and data in the form of an image, diagram, or animation. For example, some databases can interpret and show data in the form of a two- or three-dimensional model.</descrip></descripGrp><ntig><termGrp><term id="2396693">visual</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2014261">visualització</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1782_2396693_2628119"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The representation of information and data in the form of an image, diagram, or animation. For example, some databases can interpret and show data in the form of a two- or three-dimensional model.</descrip></descripGrp><ntig><termGrp><term id="2396693">visual</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2628119">visualització de dades</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1782_2626823_2014261"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The representation of information and data in the form of an image, diagram, or animation. For example, some databases can interpret and show data in the form of a two- or three-dimensional model.</descrip></descripGrp><ntig><termGrp><term id="2626823">data visualization</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2014261">visualització</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1782_2626823_2628119"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The representation of information and data in the form of an image, diagram, or animation. For example, some databases can interpret and show data in the form of a two- or three-dimensional model.</descrip></descripGrp><ntig><termGrp><term id="2626823">data visualization</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2628119">visualització de dades</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17820_650180_1970562"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An implementation diagram that shows the structure of the code itself.</descrip></descripGrp><ntig><termGrp><term id="650180">component diagram</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970562">diagrama de components</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17821_650181_1970563"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A high-level object made of tightly bound parts. A composite object is an instance of a composite class, which implies the composition aggregation between the class and its parts.</descrip></descripGrp><ntig><termGrp><term id="650181">composite object</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970563">objecte compost</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17822_650182_1970564"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In a statechart diagram, a state that has been decomposed into concurrent (representing and relationships) or mutually exclusive (representing or relationships) substates.</descrip></descripGrp><ntig><termGrp><term id="650182">composite state</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970564">estat compost</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17823_650183_1971930"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A format, such as cell shading or font color, that Excel automatically applies to cells if a specified condition is true.</descrip></descripGrp><ntig><termGrp><term id="650183">conditional format</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1971930">format condicional</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17826_650186_1967819"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The type of Web Part connection. For example, the Provide Row To connection type passes a row of data from one Web Part to another Web Part.</descrip></descripGrp><ntig><termGrp><term id="650186">connection type</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1967819">tipus de connexió</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17827_650187_1970008"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A view of an individual contact that contains all the information stored in the contact.</descrip></descripGrp><ntig><termGrp><term id="650187">contact form</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970008">formulari de contacte</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17828_650188_1970009"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of buttons used to move through contact items displayed in Address Cards or Detailed Address Cards view. The Contact index moves the focus to the first contact whose name begins with the selected character.</descrip></descripGrp><ntig><termGrp><term id="650188">Contact index</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970009">Índex de contactes</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17829_650189_1969251"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft SQL Server or WMSDE database that contains the content for one or more SharePoint sites.</descrip></descripGrp><ntig><termGrp><term id="650189">content database</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969251">base de dades de contingut</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17830_650190_1970456"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A note at the beginning or end of a text box indicating that the text is continued from or continues on a different page.</descrip></descripGrp><ntig><termGrp><term id="650190">Continued notice</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970456">avís de continuació</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17831_650191_1970260"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The shape of how scheduled work for an assignment is distributed across time. Use a contour to control how Project schedules the work of a resource.</descrip></descripGrp><ntig><termGrp><term id="650191">contour</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970260">contorn</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17832_650192_1970261"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The completion of the contract [such as fixed price or lump sum, cost reimbursable, unit price contracts]. Closeout includes resolving all outstanding issues and items, such as inspections or invoices.</descrip></descripGrp><ntig><termGrp><term id="650192">contract closeout</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970261">tancament contractual</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17834_650194_1970262"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of information about a resource's rates, including the standard rate, overtime rate, any per-use cost, and the date when the pay rate takes effect. You can establish up to five different cost rate tables for each resource.</descrip></descripGrp><ntig><termGrp><term id="650194">cost rate table</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970262">taula de taxes de cost</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17835_650195_1970263"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A resource that doesn't depend on the amount of work on a task or the duration of a task, such as airfare or lodging.</descrip></descripGrp><ntig><termGrp><term id="650195">cost resource</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970263">recurs de cost</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17836_650196_1970264"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A task that must be completed on schedule for the project to finish on time. If a critical task is delayed, the project completion date might also be delayed. A series of critical tasks makes up a project's critical path.</descrip></descripGrp><ntig><termGrp><term id="650196">critical task</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970264">tasca crítica</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17837_650197_1970265"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Printed information about tasks and resources over a specified time period. There are five predefined crosstab reports in Project: Cash Flow, Crosstab, Resource Usage, Task Usage, and Who Does What When.</descrip></descripGrp><ntig><termGrp><term id="650197">crosstab report</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970265">informe de taula de referències creuades</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17838_650198_1970565"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A specification language for describing data structures. You can use the Crow's Foot entity and relationship shapes to diagram the structure of databases.</descrip></descripGrp><ntig><termGrp><term id="650198">Crow's Foot</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970565">pota de gall</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17839_650199_1970108"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A color in the Visio application that is stored with a shape as an RGB or HSL value rather than as an index to the document's color palette. A custom color is saved only with the shape to which it is applied.</descrip></descripGrp><ntig><termGrp><term id="650199">custom color</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970108">color personalitzat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17841_650201_1969252"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An .html file whose content is displayed in a window next to a form. Custom task panes can provide form-specific commands and Help content.</descrip></descripGrp><ntig><termGrp><term id="650201">custom task pane</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969252">subfinestra de tasques personalitzada</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17844_650204_1967428"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A programming interface to access and manipulate database objects.</descrip></descripGrp><ntig><termGrp><term id="650204">DAO</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1967428">Data Access Objects</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17844_650204_1967430"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A programming interface to access and manipulate database objects.</descrip></descripGrp><ntig><termGrp><term id="650204">DAO</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1967430">DAO</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17844_651820_1967428"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A programming interface to access and manipulate database objects.</descrip></descripGrp><ntig><termGrp><term id="651820">Data Access Objects</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1967428">Data Access Objects</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17844_651820_1967430"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A programming interface to access and manipulate database objects.</descrip></descripGrp><ntig><termGrp><term id="651820">Data Access Objects</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1967430">DAO</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17845_650205_1967784"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The area of the window that displays the result set of your query.</descrip></descripGrp><ntig><termGrp><term id="650205">data pane</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1967784">subfinestra de dades</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17846_650206_1970566"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In the Charts And Graphs template, a control handle on the Line Graph shape that you can drag to change the values in the graph.</descrip></descripGrp><ntig><termGrp><term id="650206">data point</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970566">punt de dades</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17848_650208_1967533"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of creating two or more special copies (replicas) of an Access database. Replicas can be synchronized, changes made to data in one replica, or design changes made in the Design Master, are sent to other replicas.</descrip></descripGrp><ntig><termGrp><term id="650208">database replication</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1967533">replicació de base de dades</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17849_650209_1970655"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An exchange of information between processes that represent discrete packets of data that flow into and out of processes.</descrip></descripGrp><ntig><termGrp><term id="650209">dataflow</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970655">flux de dades</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17849_674637_1970655"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An exchange of information between processes that represent discrete packets of data that flow into and out of processes.</descrip></descripGrp><ntig><termGrp><term id="674637">data flow</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970655">flux de dades</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17850_650210_1970656"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tool for functional analysis that shows the general flow of information through a system or program.</descrip></descripGrp><ntig><termGrp><term id="650210">dataflow diagram</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970656">diagrama de flux de dades</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17850_674639_1970656"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tool for functional analysis that shows the general flow of information through a system or program.</descrip></descripGrp><ntig><termGrp><term id="674639">data flow diagram</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970656">diagrama de flux de dades</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17851_650211_1967399"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A character that is used to separate the day, month, and year when date values are formatted. The characters are determined by system settings or by the Format function.</descrip></descripGrp><ntig><termGrp><term id="650211">date separator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1967399">separador de dates</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17853_650213_1967534"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The default property setting of a control type. You customize a control type before you create two or more similar controls to avoid customizing each control individually.</descrip></descripGrp><ntig><termGrp><term id="650213">default control style</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1967534">estil de control per defecte</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17854_650214_1967594"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The font that a program uses by default to display text.</descrip></descripGrp><ntig><termGrp><term id="650214">default font</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1967594">tipus de lletra per defecte</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17856_650216_1969253"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A setting associated with a particular user role. Users who are not assigned to an existing role are automatically assigned to the role that is specified as the default.</descrip></descripGrp><ntig><termGrp><term id="650216">default role</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969253">funció per defecte</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17857_650217_1970405"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The unit of measure used to display a value if no units of measure are explicitly specified.</descrip></descripGrp><ntig><termGrp><term id="650217">default unit</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970405">unitat per defecte</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17858_650218_1970567"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In a statechart or activity diagram, an event that must be postponed for later use while another activity is under way. You can show a deferred event for a state by including the event among the state's internal transitions.</descrip></descripGrp><ntig><termGrp><term id="650218">deferred event</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970567">incidència ajornada</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17859_650219_1566671"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The amount of time between the scheduled start of a task and the time when work should actually begin on the task.</descrip></descripGrp><ntig><termGrp><term id="650219">delay</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1566671">retard</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17860_650220_1970568"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An element, such as an attribute or association, that can be calculated or derived from other information. For example, an age attribute for the class Person can be derived if you know the Person's date of birth.</descrip></descripGrp><ntig><termGrp><term id="650220">derived element</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970568">element derivat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17861_650221_1967535"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The grid that you use to design a query or filter in query Design view or in the Advanced Filter/Sort window. For queries, this grid was formerly known as the QBE grid.</descrip></descripGrp><ntig><termGrp><term id="650221">design grid</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1967535">quadrícula de disseny</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17862_650222_1970569"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In a collaboration diagram, a marker used to indicate object roles and association roles, or links, that are destroyed during the operation.</descrip></descripGrp><ntig><termGrp><term id="650222">destruction marker</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970569">marcador de destrucció</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17863_650223_1967536"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The part of PivotTable view that contains detail and total fields.</descrip></descripGrp><ntig><termGrp><term id="650223">detail area</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1967536">àrea de detalls</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17864_650224_1970570"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A text label on a generalization path that indicates the name of a partition of the general class that the more specific class is in. The default discriminator is an empty string.</descrip></descripGrp><ntig><termGrp><term id="650224">discriminator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970570">discriminador</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17865_650225_1967590"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Web site component that enables users to participate in topics of discussion by posting and replying to comments.</descrip></descripGrp><ntig><termGrp><term id="650225">discussion board</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1967590">tauler de discussió</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17866_650226_1969254"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A remark or topic of discussion that is associated with a Web page or Microsoft Office file and is stored on a discussion server.</descrip></descripGrp><ntig><termGrp><term id="650226">discussion comment</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969254">comentari de discussió</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17867_650227_1970474"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Produced with the use of dithering.</descrip></descripGrp><ntig><termGrp><term id="650227">dithered</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970474">interpolat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17868_650228_1967537"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Characteristic of a number stored in twice the amount (two words; typically 8 bytes) of computer memory that is required for storing a less precise (single-precision) number. Commonly handled by a computer in floating-point form.</descrip></descripGrp><ntig><termGrp><term id="650228">double-precision</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1967537">precisió doble</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17869_650229_1970571"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Visio file with a .vsd extension that contains a drawing.</descrip></descripGrp><ntig><termGrp><term id="650229">drawing file</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970571">fitxer de dibuix</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17870_650230_1970572"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ratio of distance on the printed page to distances in the real world. For example, a drawing scale of 1 cm = 1 m means that 1 centimeter on the printed page represents 1 meter in the real world.</descrip></descripGrp><ntig><termGrp><term id="650230">drawing scale</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970572">escala de dibuix</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17871_650231_1970573"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Visio file (template) with a .vst extension that opens with the stencils, styles, and settings you need to create a particular type of drawing.</descrip></descripGrp><ntig><termGrp><term id="650231">drawing type</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970573">tipus de dibuix</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17872_650232_1970266"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The resource whose assignment to a task determines the finish date of the task.</descrip></descripGrp><ntig><termGrp><term id="650232">driving resource</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970266">recurs essencial</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17873_650233_1970267"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of field whose content is expressed as a duration of time. Examples include the Work, Duration, and Delay fields. A duration field includes the duration unit, such as hour, day, or week.</descrip></descripGrp><ntig><termGrp><term id="650233">duration field</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970267">camp de duració</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17874_650234_1970574"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A standard format used by CAD programs (such as Autodesk AutoCAD) to store drawing files.</descrip></descripGrp><ntig><termGrp><term id="650234">DWG</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970574">DWG</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17875_650235_1970268"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The earliest date that a task could possibly be completed, based on early finish dates of predecessor and successor tasks, other constraints, and any leveling delay.</descrip></descripGrp><ntig><termGrp><term id="650235">early finish date</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970268">primera data de finalització</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17876_650236_1970269"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A measure of the cost of work performed up to the status date or current date. Earned value uses your original cost estimates saved with a baseline and your actual work to date to show whether the actual costs incurred are on budget.</descrip></descripGrp><ntig><termGrp><term id="650236">earned value</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970269">valor obtingut</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17877_650237_1967538"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of Access updating or repainting the screen while a macro is running.</descrip></descripGrp><ntig><termGrp><term id="650237">echo</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1967538">eco</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17878_650238_1970270"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The default method of scheduling in Project; the duration of a task shortens or lengthens as resources are added or removed from a task, while the amount of effort necessary to complete a task remains unchanged.</descrip></descripGrp><ntig><termGrp><term id="650238">effort-driven scheduling</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970270">planificació orientada a recursos</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17879_650239_1970271"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The amount of time that a task will take to finish, based on a 24-hour day and a 7-day week, including holidays and other nonworking days. For example: emin = elapsed minute, ehr = elapsed hour, eday = elapsed day, ewk = elapsed week.</descrip></descripGrp><ntig><termGrp><term id="650239">elapsed duration</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970271">temps transcorregut</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1794_264894_1970800"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A template that addresses, from a Strategic Business Development perspective, the general activities that a company goes through to determine their business growth strategy. The roadmap includes understanding market position, evaluating trade-offs between mergers/acquisitions and internal development, evaluating M&amp;A candidates and placing valuation on target companies.</descrip></descripGrp><ntig><termGrp><term id="264894">Strategic Merger or Acquisition Evaluation</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970800">Avaluació d'adquisició o fusió estratègica</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1801_111907_1572253"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To make resources, such as folders, printers, files, photos, available to others.</descrip></descripGrp><ntig><termGrp><term id="111907">share</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1572253">compartir</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1809_149352_1967501"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A control you place on a form or report to contain an unbound object.</descrip></descripGrp><ntig><termGrp><term id="149352">unbound object frame</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1967501">marc d'objecte independent</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1819_143381_1969928"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A path containing a document with hyperlinks that is used as the root of the hyperlinks in the document.</descrip></descripGrp><ntig><termGrp><term id="143381">hyperlink base</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969928">base de l'enllaç</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1820_76908_1570406"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To execute a group of statements repeatedly.</descrip></descripGrp><ntig><termGrp><term id="76908">loop</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1570406">repetir</term><termNote type="geographicalUsage">ESP</termNote>