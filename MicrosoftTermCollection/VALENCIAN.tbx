>redraw</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970815">tornar a dibuixar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24057_1098418_1969875"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of statistics that indicates the degree to which a service meets performance, usage, and other demands for the service.</descrip></descripGrp><ntig><termGrp><term id="1098418">service quality metrics</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969875">mètriques de qualitat dels serveis</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24059_1098419_1969362"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of rules that defines security permissions for a collection of assemblies by associating attributes of those assemblies, such as location and signature, with a set of code access security permissions.</descrip></descripGrp><ntig><termGrp><term id="1098419">code access security (CAS) policy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969362">norma de seguretat d'accés de codi (CAS)</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech"