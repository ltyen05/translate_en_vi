="definition">The control that lets users change their photo, presence, and other public information.</descrip></descripGrp><ntig><termGrp><term id="2015005">My profile</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2017828">El meu perfil</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34886_2015169_2017836"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of diagrams, provided as examples, which you can use to learn about Visio and its features.</descrip></descripGrp><ntig><termGrp><term id="2015169">sample diagrams</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2017836">diagrames d'exemple</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3495_160383_1696945"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An area that shows available network connections and helps users quickly connect to the most appropriate one.</descrip></descripGrp><ntig><termGrp><term id="160383">Connection Manager</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1696945">Administrador de connexions</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34954_2016735_2019940"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A control used in Office 365 mobile applications to indicate navigation between applications in Office 365.</descrip></descripGrp><ntig><termGrp><term id="2016735">Office 365 global navigation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2019940">navegació global de l'Office 365</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34966_2017840_2175751"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To show or share screen content in a display other than the primary display.</descrip></descripGrp><ntig><termGrp><term id="2017840">project</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2175751">projectar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34967_2017939_2019947"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that filters a user’s Inbox to only display email messages from people who are the user's frequent contacts. When a frequent contact sends the user a new email, the sender's photo is displayed beneath “People” in the Folder Pane. When the user selects the sender’s photo under “People,” email messages from that sender are displayed.</descrip></descripGrp><ntig><termGrp><term id="2017939">People view</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2019947">visualització Persones</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34973_2018740_2020901"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The website hosted by Microsoft where users can browse community-approved wiki articles, post questions and answers or start a discussion on technology-related topics.</descrip></descripGrp><ntig><termGrp><term id="2018740">Microsoft Community</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2020901">Microsoft Community</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34984_2019395_2019936"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A search feature that provides immediate results to users.</descrip></descripGrp><ntig><termGrp><term id="2019395">Instant Search</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2019936">Recerca instantània</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34985_2019396_2019933"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of rules to automatically delete documents in a site collection within a specified time period. Deletion policies can be assigned to a site collection or a site collection template. Site administrators can then select specific deletion policies and rules, and apply to document libraries in their site.</descrip></descripGrp><ntig><termGrp><term id="2019396">Document Deletion Policy</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2019933">Norma de supressió de documents</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34986_2019404_2028248"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The OneNote companion app that photographs, trims, enhances and makes pictures of whiteboards and documents readable and converts the images to PDF, Word and PowerPoint files.</descrip></descripGrp><ntig><termGrp><term id="2019404">Office Lens</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2028248">Office Lens</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><ter