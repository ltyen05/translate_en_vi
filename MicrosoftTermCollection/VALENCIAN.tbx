ature that allows IT pros and admins to set up internal SharePoint Online sites within their organizations and populate them with training videos customized to their end users.</descrip></descripGrp><ntig><termGrp><term id="2946708">learning pathways</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2947319">itineraris d'aprenentatge</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52131_2946708_2947320"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that allows IT pros and admins to set up internal SharePoint Online sites within their organizations and populate them with training videos customized to their end users.</descrip></descripGrp><ntig><termGrp><term id="2946708">learning pathways</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2947320">itineraris d'aprenentatge del Microsoft 365</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52139_2946739_2947322"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature in Teams that helps the remote worker reinstate the division between work time and home time by scheduling time at the beginning of the workday to prepare for work and at the end of the workday to reflect, celebrate accomplishments, plan the next day's tasks, or meditate with Headspace.</descrip></descripGrp><ntig><termGrp><term id="2946739">virtual commute</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2947322">desplaçament virtual</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52143_2947723_2948419"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An XML document that specifies a list of sites, their compatibility mode, and their intended browser.</descrip></descripGrp><ntig><termGrp><term id="2947723">Enterprise Mode Site List</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2948419">Llista de llocs de mode empresarial</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52144_2947724_2948423"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A benefit, advantage, or discount provided to a customer when they use a product in association with a Windows device.</descrip></descripGrp><ntig><termGrp><term id="2947724">Windows benefit</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2948423">Benefici del Windows</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote ty