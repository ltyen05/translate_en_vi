</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39882_2320437_2323096"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app for purchasing cellular data that is packaged with cellular enabled Dell devices that include a Microsoft SIM card.</descrip></descripGrp><ntig><termGrp><term id="2320437">Dell NetReady</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2323096">Dell NetReady</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39889_2321509_2323124"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The collection of TV shows that are in the top N% of ratings.</descrip></descripGrp><ntig><termGrp><term id="2321509">Top-rated TV shows</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2323124">Programes de TV millor valorats</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39890_2321510_2323098"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The collection of items emphasized to the customer through placement on the site.</descrip></descripGrp><ntig><termGrp><term id="2321510">Featured collections</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termG