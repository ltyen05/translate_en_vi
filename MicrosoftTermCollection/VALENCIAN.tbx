ig><termGrp><term id="1968589">sense valoració</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15396_148352_1969864"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">E-mail accounts and folders that you can group and set common options for, such as whether to download headers or messages, size limits on downloaded messages, behavior online vs. offline, and time interval for connecting to the server.</descrip></descripGrp><ntig><termGrp><term id="148352">Send/Receive group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969864">Grup d'enviament i recepció</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1542_30264_1566581"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A symbol that carries meaning in language, such as a letter, number, punctuation mark, or emoticon.</descrip></descripGrp><ntig><termGrp><term id="30264">character</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1566581">caràcter</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15438_137719_1970113"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Any graphics on a slide, including drawing objects, patterns in a background fill, and pictures.</descrip></descripGrp><ntig><termGrp><term id="137719">background graphics</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970113">gràfics de fons</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15440_179059_1968590"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to an account status indicating that payments are up-to-date.</descrip></descripGrp><ntig><termGrp><term id="179059">current</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1968590">actualitzat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15452_219611_1968829"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of data that is organized and summarized into a multidimensional structure that is defined by a set of dimensions and measures.</descrip></descripGrp><ntig><termGrp><term id="219611">OLAP cube</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1968829">cub OLAP</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15452_41272_1968829"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of data that is organized and summarized into a multidimensional structure that is defined by a set of dimensions and measures.</descrip></descripGrp><ntig><termGrp><term id="41272">cube</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1968829">cub OLAP</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15456_231959_1967410"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A field that's assigned a column orientation in a PivotTable report. Items associated with a column field are displayed as column labels.</descrip></descripGrp><ntig><termGrp><term id="231959">column field</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1967410">camp de columna</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15457_461710_2599437"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Excel feature that identifies invalid worksheet data, formulas, or formatting and proposes corrections.</descrip></descripGrp><ntig><termGrp><term id="461710">error checking</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2599437">comprovació d'errors</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15459_303758_1572466"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An upgrade option that allows users to upgrade from one edition of Windows to another by purchasing the upgrade online. It is enabled by Software Licensing Services (SLS) technology which allows a digital lincense to determine what features are enabled or disabled allowing Microsoft to sell either additional licenses or product upgrades through digital licenses (PUP-DL). Customers may either buy full packaged product (FPP) or upgrade quickly and conveniently electronically.</descrip></descripGrp><ntig><termGrp><term id="303758">Windows Anytime Upgrade</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1572466">Windows Anytime Upgrade</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15459_303760_1572466"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An upgrade option that allows users to upgrade from one edition of Windows to another by purchasing the upgrade online. It is enabled by Software Licensing Services (SLS) technology which allows a digital lincense to determine what features are enabled or disabled allowing Microsoft to sell either additional licenses or product upgrades through digital licenses (PUP-DL). Customers may either buy full packaged product (FPP) or upgrade quickly and conveniently electronically.</descrip></descripGrp><ntig><termGrp><term id="303760">WAU</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1572466">Windows Anytime Upgrade</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15465_1044453_1969321"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of scanning content to compile and maintain an index.</descrip></descripGrp><ntig><termGrp><term id="1044453">update</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969321">actualització</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15465_535201_1969321"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of scanning content to compile and maintain an index.</descrip></descripGrp><ntig><termGrp><term id="535201">population</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969321">actualització</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular