 of user profiles that can be accessed from multiple sites and farms.</descrip></descripGrp><ntig><termGrp><term id="1275614">User Profile service</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969478">servei de perfils d'usuari</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26518_1275616_1969479"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SharePoint service application that collects, reports, and analyzes the usage and effectiveness of SharePoint Server sites.</descrip></descripGrp><ntig><termGrp><term id="1275616">Web Analytics service application</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969479">Aplicació de servei del Web Analytics</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26519_1275617_1969480"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A service over which the administration (that is all the methods necessary to control the Search service, such as starting content source index crawls, updating scopes, etc.) of the Microsoft Office SharePoint Search service takes place.</descrip></descripGrp><ntig><termGrp><term id="1275617">Search Administration Web Service</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969480">Servei web d'administració de recerca</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26531_1275663_1968111"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To transfer a call to a holding point instead of holding the call at the phone device.</descrip></descripGrp><ntig><termGrp><term id="1275663">park</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1968111">aparcar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26535_1275693_1968112"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To answer a call by dialing the associated number on the network where it has been parked.</descrip></descripGrp><ntig><termGrp><term id="1275693">retrieve</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1968112">recuperar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26536_1275694_1969836"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that transfers a call back to the person who parked it, after a specified amount of time, so a caller doesn't remain on hold indefinitely.</descrip></descripGrp><ntig><termGrp><term id="1275694">ringback</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969836">recuperació de trucada</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26537_1275696_1968191"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A number assigned to a parked call by the call park server.</descrip></descripGrp><ntig><termGrp><term id="1275696">orbit</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1968191">òrbita</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26538_1275697_1968192"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An additional phone number with a distinct ring tone that cannot be forwarded. A private line allows a person who delegates calls to have a direct, confidential line.</descrip></descripGrp><ntig><termGrp><term id="1275697">private line</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1968192">línia privada</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26539_1275698_1968193"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A microphone and speaker combination configured by the user in Lync and Office Communicator.</descrip></descripGrp><ntig><termGrp><term id="1275698">custom device</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1968193">dispositiu personalitzat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26542_1275835_1969481"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A web site that provides information about business intelligence in Microsoft SharePoint Server 2010.</descrip></descripGrp><ntig><termGrp><term id="1275835">Business Intelligence Resource Center</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969481">Centre de recursos d'intel·ligència empresarial</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26545_1275963_1968194"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An option on the Transfer button that lets you park a call.</descrip></descripGrp><ntig><termGrp><term id="1275963">Parking Lot</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1968194">Aparcament</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26546_1275964_1968195"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables phone users to report disturbing calls to the system administrator. When the user selects to report a malicious call, data from the last call received is captured and sent to the system administrator.</descrip></descripGrp><ntig><termGrp><term id="1275964">malicious call reporting</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1968195">informe de trucades malicioses</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26550_1275968_1970878"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The listing of contents created by bookmarking blocks of text and creating the table of contents of the bookmarked area.</descrip></descripGrp><ntig><termGrp><term id="1275968">ookmark TOC</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970878">IDC de marcadors</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26551_1275969_1969482"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An administrative setting for a keyword that specifies how to transform query text that contains the keyword, before executing the query against a search index.</descrip></descripGrp><ntig><termGrp><term id="1275969">search setting</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969482">configuració de recerca</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26552_1275970_1969483"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Web Part available to end users that displays the most frequently viewed content and search queries.</descrip></descripGrp><ntig><termGrp><term id="1275970">Web Analytics Web Part</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969483">Element web del Web Analytics</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26554_1276172_1968531"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The window that contains the user's workbook of tabbed sheets.</descrip></descripGrp><ntig><termGrp><term id="1276172">workbook window</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1968531">finestra del llibre de treball</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26555_1276173_1567263"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A prewritten formula that simplifies the process of entering calculations and enables the user to use formulas that might be difficult to build from scratch.</descrip></descripGrp><ntig><termGrp><term id="1276173">function</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1567263">funció</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26558_1276179_2049137"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of Human Interaction Proof challenge, which plays an audio file decipherable only by a person. The audio file might seem faint or mixed with background voices and noise. This is intentional to ensure a person, not an automated program, completes the HIP challenge.</descrip></descripGrp><ntig><termGrp><term id="1276179">audio challenge</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2049137">verificació d'àudio</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26565_1276491_1968661"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Web Part that displays all items that belong to a given tag.</descrip></descripGrp><ntig><termGrp><term id="1276491">Tagged Items</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1968661">elements etiquetats</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26567_1276528_1970811"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method for determining project performance which involves comparing the value of the work that was planned with the budgeted cost of the work performed to date, with what was actually spent. These comparisons provide invaluable information about actual conditions within the project and trends that may be developing in terms of schedule and cost performance.</descrip></descripGrp><ntig><termGrp><term id="1276528">earned value analysis</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970811">anàlisi del valor obtingut</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26571_1276626_1967812"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A range of cells in a worksheet that has been formatted as a table and can be managed independently from the data in other rows and columns on the worksheet.</descrip></descripGrp><ntig><termGrp><term id="1276626">Excel table</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1967812">taula de l'Excel</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26581_1278354_1969484"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A typographical unit of measure that is equal in width to the point size of a particular font. For many fonts, this is equal to the width of a capital N, from which the en space takes its name.</descrip></descripGrp><ntig><termGrp><term id="1278354">en space</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969484">espai curt</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26586_1280146_1967975"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user who regularly files mailbox items into folders.</descrip></descripGrp><ntig><termGrp><term id="1280146">filer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1967975">arxivador</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26586_1280146_1967976"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user who regularly files mailbox items into folders.</descrip></descripGrp><ntig><termGrp><term id="1280146">filer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1967976">usuari arxivador</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26586_1346188_1967975"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user who regularly files mailbox items into folders.</descrip></descripGrp><ntig><termGrp><term id="1346188">filer user</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1967975">arxivador</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26586_1346188_1967976"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user who regularly files mailbox items into folders.</descrip></descripGrp><ntig><termGrp><term id="1346188">filer user</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1967976">usuari arxivador</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termN