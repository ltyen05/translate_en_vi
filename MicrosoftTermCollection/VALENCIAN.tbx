 navigate and organize presentations.</descrip></descripGrp><ntig><termGrp><term id="1075942">presentation section</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1571770">secció</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21354_1075942_1970159"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A labeled group of consecutive slides that helps the user navigate and organize presentations.</descrip></descripGrp><ntig><termGrp><term id="1075942">presentation section</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970159">secció de presentació</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21354_772636_1571770"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A labeled group of consecutive slides that helps the user navigate and organize presentations.</descrip></descripGrp><ntig><termGrp><term id="772636">section</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1571770">secció</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21354_772636_1970159"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A labeled group of consecutive slides that helps the user navigate and organize presentations.</descrip></descripGrp><ntig><termGrp><term id="772636">section</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970159">secció de presentació</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21357_773109_1969304"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tool in Groove for storing and sharing files; primary use is intended to be as connection to SharePoint (via Site Client).</descrip></descripGrp><ntig><termGrp><term id="773109">Groove Documents Tool</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969304">Eina de documents del Groove</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21358_773112_1967836"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that makes automatic versions of user documents during each autosave operation and allows the user to revert to previous copies of the document with ease.</descrip></descripGrp><ntig><termGrp><term id="773112">Office Auto-Revisions</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1967836">Revisions automàtiques de l'Office</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21360_773163_1970028"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that alerts users to potential issues with email recipients before the message is sent.</descrip></descripGrp><ntig><termGrp><term id="773163">MailTips</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970028">Suggeriments per al correu</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21362_773197_1571122"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To establish a Bluetooth link or connection between two Bluetooth–enabled devices.</descrip></descripGrp><ntig><termGrp><term id="773197">pair</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1571122">aparellar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21364_773416_1970814"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To use ALL CAPITAL LETTERS for emphasis in email or a newsgroup article. Excessive shouting is considered a violation of netiquette. A word can be more acceptably emphasized by placing it between *asterisks* or _underscores_.</descrip></descripGrp><ntig><termGrp><term id="773416">shout</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970814">cridar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21366_773418_1979138"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To make a single file out of a set of files using a program such as compress, gzip, or PKZIP.</descrip></descripGrp><ntig><termGrp><term id="773418">zip</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1979138">comprimir</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21369_773459_1969308"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A unique, persistent identifier assigned to a document or other item in SharePoint Server that allows it to be referenced and retrieved regardless of its location.</descrip></descripGrp><ntig><termGrp><term id="773459">Document ID</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969308">ID de document</term><termNote type="geog