ntry><termEntry id="21334_770408_2400111"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft app that creates sticky notes that can be shared between devices, that cloud sync, that are stored on Exchange, and that provide contextual reminders and actions that can be performed based on the content.</descrip></descripGrp><ntig><termGrp><term id="770408">Sticky Notes</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2400111">Notes adhesives</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21334_770408_2676654"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft app that creates sticky notes that can be shared between devices, that cloud sync, that are stored on Exchange, and that provide contextual reminders and actions that can be performed based on the content.</descrip></descripGrp><ntig><termGrp><term id="770408">Sticky Notes</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2676654">Notes adhesives de Microsoft</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21335_770428_2410780"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An individual piece of content that resembles a physical sticky note, is displayed across multiple apps and platforms, and that is created using Sticky Notes.</descrip></descripGrp><ntig><termGrp><term id="770428">sticky note</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2410780">nota adhesiva</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21348_771258_3045370"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To continue movement, as with the cursor or a search operation, to the beginning or to a new starting point rather than stopping when the end of a series is reached. For example, the screen cursor might wrap around to the first column of the next line rather than stopping when it reaches the last column of the current line. Likewise, a program starting a search or replace operation in the middle of a document might be instructed to wrap around to the beginning rather than stop when it reaches the end of the document.</descrip></descripGrp><ntig><termGrp><term id="771258">wrap around</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="3045370">Ajusta</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21350_771325_1969302"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Web Part that displays a browser-enabled InfoPath form.</descrip></descripGrp><ntig><termGrp><term id="771325">InfoPath Form Web Part</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969302">element web de formularis de l'InfoPath</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21351_1119206_1969363"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SharePoint Server service that maintains temporary state information for InfoPath Forms Services.</descrip></descripGrp><ntig><termGrp><term id="1119206">Microsoft SharePoint Server State Service</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969363">Servei d'estats provisionals del SharePoint Server</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21352_771336_1969303"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that updates absolute URLs in form templates associated with SharePoint Form Libraries (i.e., InfoPath XSNs) as well as Universal Data Connection files.</descrip></descripGrp><ntig><termGrp><term id="771336">Form Library URL Repair Tool</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969303">Eina de reparació d'URL de biblioteques de formularis</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21353_1177078_1970153"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables presenters in the rich client to broadcast a slide show to remote viewers watching in a Web browser. Throughout the presentation, the remote attendees will see the current slide being shown by the presenter.</descrip></descripGrp><ntig><termGrp><term id="1177078">PowerPoint Broadcast Slide Show</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970153">Retransmissió de presentació de diapositives</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21353_1177078_1970170"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables presenters in the rich client to broadcast a slide show to remote viewers watching in a Web browser. Throughout the presentation, the remote attendees will see the current slide being shown by the presenter.</descrip></descripGrp><ntig><termGrp><term id="1177078">PowerPoint Broadcast Slide Show</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970170">Retransmissió de presentació de diapositives del PowerPoint</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntr