he Word view that displays text in one narrow column​​​ that has the same width as the Narrow view.</descrip></descripGrp><ntig><termGrp><term id="2445835">Single</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2450942">Simple</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43184_2446073_2448562"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A setting that adjusts the display to eliminate blue tones that may disrupt your ability to sleep at night.</descrip></descripGrp><ntig><termGrp><term id="2446073">night light</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2448562">llum nocturna</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43193_2446339_2454118"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Advanced eDiscovery mode that tags issues and that can be set for individual users and issues for user authorizations.</descrip></descripGrp><ntig><termGrp><term id="2446339">Sampling mode</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2454118">Mode de mostreig</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</