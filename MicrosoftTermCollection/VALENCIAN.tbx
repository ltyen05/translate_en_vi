></termGrp></ntig></langSet></termEntry><termEntry id="31515_2247937_1991905"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application that is built using the traditional Win32 app model, typically makes use of the COM or .NET runtime, and runs only on the desktop of Windows.</descrip></descripGrp><ntig><termGrp><term id="2247937">Windows desktop application</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1991905">programa d'escriptori</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31515_2247955_1991905"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application that is built using the traditional Win32 app model, typically makes use of the COM or .NET runtime, and runs only on the desktop of Windows.</descrip></descripGrp><ntig><termGrp><term id="2247955">desktop application</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1991905">programa d'escriptori</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31515_2259606_1991905"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application that is built using the traditional Win32 app model, typically makes use of the COM or .NET runtime, and runs only on the desktop of Windows.</descrip></descripGrp><ntig><termGrp><term id="2259606">Classic Windows applic