ermNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45210_2659063_2666054"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that allows customers to store their users’ Office 365 data in specific Office 365 geographical locations to fulfill regulatory data residency requirements.</descrip></descripGrp><ntig><termGrp><term id="2659063">Multi-Geo</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2666054">Multi-Geo</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45210_2866055_2555517"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that allows customers to store their users’ Office 365 data in specific Office 365 geographical locations to fulfill regulatory data residency requirements.</descrip></descripGrp><ntig><termGrp><term id="2866055">Microsoft 365 Multi-Geo</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2555517">Multi-Geo Capabilities</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45210_2866055_2666054"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that allows customers to store their users’ Office 365 data in specific Office 365 geographical locations to fulfill regulatory 