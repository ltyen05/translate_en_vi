ES-valencia"><ntig><termGrp><term id="1968405">Servei de consulta</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23449_1082184_1967945"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A relational database system capable of handling queries more complex than those handled by standard relational databases, through multidimensional access to data (viewing the data by several different criteria), intensive calculation capability, and specialized indexing techniques.</descrip></descripGrp><ntig><termGrp><term id="1082184">OLAP database</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1967945">base de dades OLAP</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2345_234849_1968863"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An account that records transactions about assets and liabilities and that is used in the preparation of the balance sheet.</descrip></descripGrp><ntig><termGrp><term id="234849">balance account</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1968863">compte de balanç</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23459_1082196_1968114"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Audio and video on a call that are exchanged before the recipient accepts the call. Examples include announcements, requests for input, and caller voice commands.</descrip></descripGrp><ntig><termGrp><term id="1082196">early media</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1968114">elements multimèdia inicials</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2346_15363_2738755"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To link one entity to another for a specific purpose.</descrip></descripGrp><ntig><termGrp><term id="15363">assign</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2738755">assignar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23462_1082215_1570399"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The street address or geographical coordinates of a user, and (by way of extensions) of the user’s computer or devices.</descrip></descripGrp><ntig><termGrp><term id="1082215">location</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1570399">ubicació</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2349_178836_1968783"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tabulation of goods and services that one purchases or sells, or offers for purchase or sale.</descrip></descripGrp><ntig><termGrp><term id="178836">Product and Service Items list</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1968783">llista d'elements de productes i serveis</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23512_1086338_1970392"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that provides a centralized location for managers of all types to approve work and control progress on all of their projects plans. It gives managers the ability to preview the impact of accepting updates from resources as well as view their past history of accepted updates.</descrip></descripGrp><ntig><termGrp><term id="1086338">Approval Center</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970392">Centre d'aprovació</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23515_1086717_1968651"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables users to create simple calculations using one or more KPI values. This reduces the amount of MDX that is required to create complex scorecards.</descrip></descripGrp><ntig><termGrp><term id="1086717">Calculated Metrics</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1968651">Mètriques calculades</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23517_1086719_1970031"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows users to see conflicting appointments directly from Mail view without having to switch to Calendar view. Makes it much easier for users to decide to accept or decline a meeting invite that conflicts with an existing meeting.</descrip></descripGrp><ntig><termGrp><term id="1086719">Calendar Preview</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970031">Visualització prèvia del calendari</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23518_1086825_1969335"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that is inactive in Office Web Apps, but that is present when the content is opened in the rich client.</descrip></descripGrp><ntig><termGrp><term id="1086825">unsupported feature</term><termNote type="part