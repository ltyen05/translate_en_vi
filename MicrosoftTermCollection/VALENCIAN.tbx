ber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20283_724486_1968080"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A division of a company, either a profit or cost center, that has a certain degree of autonomy and is responsible for a particular range of products or brands or for specific administrative functions.</descrip></descripGrp><ntig><termGrp><term id="724486">business unit</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1968080">unitat de negoci</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="203_442_1566577"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A digital document used for authentication and network security that binds a public key to an entity that holds the corresponding private key.</descrip></descripGrp><ntig><termGrp><term id="442">certificate</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1566577">certificat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="203_443_1566577"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A digital document used for authentication and network security that binds a public key to an entity that holds the corresponding private key.</descrip></descripGrp><ntig><termGrp><term id="443">digital certificate</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1566577">certificat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="203_761730_1566577"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A digital document used for authentication and network security that binds a public key to an entity that holds the corresponding private key.</descrip></descripGrp><ntig><termGrp><term id="761730">security certificate</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1566577">certificat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2031_57111_1967469"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application consisting of a "back-end" database file that contains tables, and copies of a "front-end" database file that contain all other database objects with links to the back-end tables.</descrip></descripGrp><ntig><termGrp><term id="57111">front-end/back-end application</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1967469">aplicació frontal/de fons</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="gr