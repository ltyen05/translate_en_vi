OfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1568536">inserció d'entrades manuscrites</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6950_54230_1969888"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file-storage device on a local area network that is accessible to users on the network. A file server not only stores files but manages them and maintains order as network users request files and make changes to them.</descrip></descripGrp><ntig><termGrp><term id="54230">file server</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969888">servidor de fitxers</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6953_375728_1968993"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">One of the page size options available in Publisher for printing a folded card. This option prints two pages per sheet of paper.</descrip></descripGrp><ntig><termGrp><term id="375728">Tent card</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1968993">targeta plegada</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6958_371975_1968975"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The area in a catalog merge template into which merge fields are inserted. When a merge is completed, data from a data source populates each field, and the catalog merge area will repeat and display multiple records on each page.</descrip></descripGrp><ntig><termGrp><term id="371975">catalog merge area</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1968975">àrea de combinació de catàlegs</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6962_312045_1967749"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A cell that is referred to by a formula in another cell. For example, if cell D10 contains the formula =B5, cell B5 is a precedent to cell D10.</descrip></descripGrp><ntig><termGrp><term id="312045">precedent</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1967749">precedent</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6969_178470_1968754"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The amount to be taken off the price of each unit of the product or service.</descrip></descripGrp><ntig><termGrp><term id="178470">adjusted percentage</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1968754">percentatge ajustat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6977_340130_2742585"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To switch between active calls.</descrip></descripGrp><ntig><termGrp><term id="340130">swap</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2742585">intercanviar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6979_178728_1968775"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The preferred method of communication with the Business Contact; for example, phone, email message, letter, fax, and so on.</descrip></descripGrp><ntig><termGrp><term id="178728">method of contact</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1968775">mètode de contacte</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="698_237910_1970495"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of diagram that shows the interrelationships among topics in a hierarchy. You can think of it as a graphical illustration of a text outline.</descrip></descripGrp><ntig><termGrp><term id="237910">brainstorming diagram</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970495">diagrama de pluja d'idees</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6987_1354392_1968245"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of attributes that provides an indication of a person's status, activity, location, willingness to communicate, and contact information.</descrip></descripGrp><ntig><termGrp><term id="1354392">presence information</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1968245">presència</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6987_230790_1968245"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of attributes that provides an indication of a person's status, activity, location, willingness to communicate, and contact information.</descrip></descripGrp><ntig><termGrp><term id="230790">presence</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1968245">presència</term><termNote type=