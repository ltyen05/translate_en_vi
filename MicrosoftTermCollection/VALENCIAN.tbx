635">canal de continguts d'activitats</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24102_3145080_1967635"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feed that provides users with information, notifications and updates based on people, documents, and tags they are following.</descrip></descripGrp><ntig><termGrp><term id="3145080">Xbox activity feed</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1967635">canal de continguts d'activitats</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24106_1098539_1970036"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A synchronous event whose handler runs completely before the action that raised the event starts.</descrip></descripGrp><ntig><termGrp><term id="1098539">before event</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970036">incidència abans</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24106_1098540_1970036"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A synchronous event whose handler runs completely before the action that raised the e