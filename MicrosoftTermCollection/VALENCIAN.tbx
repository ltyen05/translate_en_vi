><termGrp><term id="1970135">retransmissió de la presentació</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45269_2556878_2559461"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A handle that allows users to scroll by touching the device's screen.</descrip></descripGrp><ntig><termGrp><term id="2556878">scroll handle</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2559461">control de desplaçament</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45282_2556931_2559458"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ink effect in the colors of a rainbow.</descrip></descripGrp><ntig><termGrp><term id="2556931">rainbow</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2559458">arc de Sant Martí</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45283_2556932_2559455"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An effect applied to digital ink.</descrip></descripGrp><ntig><termGrp><term id="2556932">ink effect</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNu