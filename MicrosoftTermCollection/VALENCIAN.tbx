the view in Messenger that displays someone's friends and contacts that aren't friends but that can be interacted with in Messenger (those are often legacy entries).</descrip></descripGrp><ntig><termGrp><term id="1347110">friends</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1588627">amics</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26729_1354363_1969495"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A specific reporting job that automatically checks for potential configuration, performance, and usage problems.</descrip></descripGrp><ntig><termGrp><term id="1354363">health rule</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969495">regla d'estat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26730_1354364_1970817"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of printing multiple pages on a single sheet so that they can be folded and trimmed to form a sequence of pages.</descrip></descripGrp><ntig><termGrp><term id="1354364">imposition</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970817">imposició</term><termNote type="geographicalUsage">ESP</termNote><ter