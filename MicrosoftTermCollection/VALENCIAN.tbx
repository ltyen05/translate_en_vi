ngSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1988362">assessor de subscripcions</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2905_136563_1770185"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of CD-ROM that can be written (only once) on a CD recorder and read on a CD-ROM drive.</descrip></descripGrp><ntig><termGrp><term id="136563">compact disc-recordable</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1770185">CD-R</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2905_136564_1770185"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of CD-ROM that can be written (only once) on a CD recorder and read on a CD-ROM drive.</descrip></descripGrp><ntig><termGrp><term id="136564">CD-R</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1770185">CD-R</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29075_1506403_1969530"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A logical grouping of users, groups, and content permissions for a third-party security or content system that is accessed by FAST Search Authorization.</descrip></descripGrp><ntig><termGrp><term id="1506403">user store</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969530">magatzem d'usuaris</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29076_1506404_1969531"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The search security filter in FSA that finds documents that all users have access to.</descrip></descripGrp><ntig><termGrp><term id="1506404">public filter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969531">filtre públic</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29077_1506405_1969532"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of mapping a user or a group in one user store to a user or a group in another user store for the purpose of returning all documents that the user or group has rights to view, regardless of which user store the user or group is authenticated to.</descrip></descripGrp><ntig><termGrp><term id="1506405">principal aliasing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969532">assignació principal d'àlies</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29078_1506406_1969533"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A word or phrase that is added to a SharePoint item, either as a value in the Managed Keyword column or as a social tag.</descrip></descripGrp><ntig><termGrp><term id="1506406">managed keyword</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969533">paraula clau administrada</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29079_1506407_1969534"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Windows service that generates user search security filters in FAST Search Authorization.</descrip></descripGrp><ntig><termGrp><term id="1506407">FSA worker</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969534">procés de treball de FSA</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29079_1680037_1969534"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Windows service that generates user search security filters in FAST Search Authorization.</descrip></descripGrp><ntig><termGrp><term id="1680037">security worker</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969534">procés de treball de FSA</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2908_38136_1770193"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ability of hardware devices, software packages, or a computer itself to work with network devices or with other hardware devices, software packages, or a computer over a network connection.</descrip></descripGrp><ntig><termGrp><term id="38136">connectivity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1770193">connectivitat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29080_1506408_1969535"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Windows service that provides administration functionality for FAST Search Authorization.</descrip></descripGrp><ntig><termGrp><term id="1506408">FSA Manager</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969535">Administrador de FSA</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29081_1506409_1969536"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user store supplied as a starting point for expanding group membership when a user store is not already specified in FAST Search Authorization.</descrip></descripGrp><ntig><termGrp><term id="1506409">default user store</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969536">magatzem d'usuaris per defecte</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29082_1506410_1969537"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The internal URL that is used by a crawler to identify and access an item.</descrip></descripGrp><ntig><termGrp><term id="1506410">access URL</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969537">URL d'accés</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29083_1506411_1969538"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The current selection of cells, rows, or columns that includes the active cell in a datasheet.</descrip></descripGrp><ntig><termGrp><term id="1506411">active selection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969538">selecció activa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29084_1506412_1969539"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A running instance of a workflow that consists of a sequence of action instances and/or activity model instances. Action instances and activity model instances can be sequenced in any order to create a single activity flow.</descrip></descripGrp><ntig><termGrp><term id="1506412">activity flow</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969539">flux d'activitats</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29085_1506413_1969540"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A worksheet function that is provided by an add-in, instead of being built-in.</descrip></descripGrp><ntig><termGrp><term id="1506413">add-in function</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969540">funció de complement</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29086_1506415_1969541"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A cell that is in the same row as and adjoins the current cell in a worksheet.</descrip></descripGrp><ntig><termGrp><term id="1506415">adjacent cell</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969541">cel·la adjacent</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29087_1506416_1969542"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A connection that uses the ActiveX Data Objects (ADO) data access interface.</descrip></descripGrp><ntig><termGrp><term id="1506416">ADO connection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969542">connexió ADO</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29088_1506431_1969543"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Data and the information that is needed to access that data from applications and databases that support the ActiveX Data Objects (ADO) data access interface.</descrip></descripGrp><ntig><termGrp><term id="1506431">ADO data source</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969543">origen de dades ADO</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29089_1506432_1969544"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A request to receive an Internet message automatically when user-defined criteria are met. Such messages are generated automatically when items such as documents, Web pages, list items, sites, or other resources on a server are changed.</descrip></descripGrp><ntig><termGrp><term id="1506432">alert subscription</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969544">subscripció a avisos</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29090_1506433_1969545"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An additional user account that is in a different domain, but within the same forest as the primary account.</descrip></descripGrp><ntig><termGrp><term id="1506433">alternate account</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969545">compte alternatiu</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29091_1506434_1969546"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A content source that is used to import the anchor text from links between items into the full-text index catalog.</descrip></descripGrp><ntig><termGrp><term id="1506434">anchor content source</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969546">origen de contingut d'ancoratge</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29092_1506435_1969547"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of adding anchor text that is in links between items to the full-text index catalog.</descrip></descripGrp><ntig><termGrp><term id="1506435">anchor crawl</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969547">rastreig d'ancoratge</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29093_1506436_1969548"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The period of time when an application is running. When an application starts, the session starts. When an application quits, the session ends.</descrip></descripGrp><ntig><termGrp><term id="1506436">application session</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969548">sessió d'aplicació</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29094_1506437_1969549"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A GUID or string that is used to uniquely identify an audience.</descrip></descripGrp><ntig><termGrp><term id="1506437">audience identifier</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969549">identificador d'auditori</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29095_1506438_1969550"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of logical conditions that determine whether a user profile can be a member of an audience.</descrip></descripGrp><ntig><termGrp><term id="1506438">audience rule</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969550">regla d'auditori</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29096_1506439_1969551"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A floating-point number that designates that a specific Web page is more relevant than other Web pages. Allowed values are 0, 1, or 2. Zero (0) signifies the most valuable authoritative page level.</descrip></descripGrp><ntig><termGrp><term id="1506439">authority level</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969551">nivell d'autoritat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29097_1506440_1969552"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An XML-based collection of predefined or user-defined settings that are stored as a site definition configuration or a site template, and can be used when creating a site.</descrip></descripGrp><ntig><termGrp><term id="1506440">available site template</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969552">plantilla de lloc disponible</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29098_1506441_1969553"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The text or number that identifies the categories or the scaling of an axis. The axis label usually appears below or to the left of the axis.</descrip></descripGrp><ntig><termGrp><term id="1506441">axis label</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969553">etiqueta d'eix</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29099_1506442_1969554"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A condition of a handwritten signature, in an image or .ink file, that specifies the direction of the characters in the signature, right-to-left or left-to-right.</descrip></descripGrp><ntig><termGrp><term id="1506442">backward signing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969554">signatura inversa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29100_1506443_1969555"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Web Parts page that contains only one Web Part zone and, by default, a Content Editor Web Part.</descrip></descripGrp><ntig><termGrp><term id="1506443">basic page</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969555">pàgina bàsica</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29101_1506444_1969556"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A site that was created by using the "Blank" site template.</descrip></descripGrp><ntig><termGrp><term id="1506444">blank site</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969556">lloc en blanc</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29102_1506445_1969557"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An XML-based language that is used to describe various elements, such as queries and views, in sites that are based on Microsoft® SharePoint® Products and Technologies.</descrip></descripGrp><ntig><termGrp><term id="1506445">Collaborative Application Markup Language</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969557">Llenguatge d'etiquetatge d'aplicació de col·laboració</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29102_1506445_1969558"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An XML-based language that is used to describe various elements, such as queries and views, in sites that are based on Microsoft® SharePoint® Products and Technologies.</descrip></descripGrp><ntig><termGrp><term id="1506445">Collaborative Application Markup Language</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969558">CAML</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29102_1506446_1969557"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An XML-based language that is used to describe various elements, such as queries and views, in sites that are based on Microsoft® SharePoint® Products and Technologies.</descrip></descripGrp><ntig><termGrp><term id="1506446">CAML</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969557">Llenguatge d'etiquetatge d'aplicació de col·laboració</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29102_1506446_1969558"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An XML-based language that is used to describe various elements, such as queries and views, in sites that are based on Microsoft® SharePoint® Products and Technologies.</descrip></descripGrp><ntig><termGrp><term id="1506446">CAML</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969558">CAML</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29103_1506447_1969559"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of removing information about all crawled items from a full-text index catalog.</descrip></descripGrp><ntig><termGrp><term id="1506447">catalog reset</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969559">re