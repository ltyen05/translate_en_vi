99_1968685"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of options that you can use to specify what type of content is crawled, what URLs to crawl, and how deep and when to crawl.</descrip></descripGrp><ntig><termGrp><term id="49899">content source</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1968685">origen de contingut</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14023_29994_1968676"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A server-side interface for initiating software services. For example, a set of interfaces that describe how a Web server communicates with software on the same computer. Any software can be a CGI program if it handles input and output according to the CGI standard.</descrip></descripGrp><ntig><termGrp><term id="29994">CGI</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1968676">CGI</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14023_29995_1968676"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A server-side interface for initiating software services. For example, a set of interfaces that describe how a Web server communicates with software on the same computer. Any software can be a CGI program if it handles input and output according to the CGI standard.</descrip