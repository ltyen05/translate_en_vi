onnection that allows apps to access user profiles in an organization, as well as the profiles of their managers and direct reports.</descrip></descripGrp><ntig><termGrp><term id="2453751">Office 365 Users</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2455450">Usuaris de l'Office 365</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43324_2454174_2455452"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The button that launches a digital ruler that allows users to draw straight ink and align shapes against​ it.</descrip></descripGrp><ntig><termGrp><term id="2454174">Ruler</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2455452">Regle</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43325_2454194_2455455"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tool that can positioned within content so that users can align objects and ink straight lines.</descrip></descripGrp><ntig><termGrp><term id="2454194">virtual ruler</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2455455">regle virtual</term><termNote type="geographicalUsage">ESP</termNote><termNote type="par