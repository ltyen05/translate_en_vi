eech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969589">supressió de resultats duplicats</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29133_1783060_1969589"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of grouping that removes documents with duplicate or near-duplicate content from search results.</descrip></descripGrp><ntig><termGrp><term id="1783060">duplicate removal</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969589">supressió de resultats duplicats</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29133_1783061_1969589"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of grouping that removes documents with duplicate or near-duplicate content from search results.</descrip></descripGrp><ntig><termGrp><term id="1783061">duplicate trimming</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969589">supressió de resultats duplicats</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29134_1506693_1969590"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A component of the rank that depends on how well query text matches an indexed item.</descrip></descripGrp><ntig><termGrp><term id="1506693">dynamic rank</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969590">classificació dinàmica</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29135_1506695_1969591"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An item that is excluded from a crawl by the administrator of the host site or the search administrator of the crawler.</descrip></descripGrp><ntig><termGrp><term id="1506695">excluded item</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969591">element exclòs</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29136_1506697_1969592"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A reference to a cell, range, defined name, or other object in another worksheet or workbook.</descrip></descripGrp><ntig><termGrp><term id="1506697">external reference</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969592">referència externa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29137_1506700_1969593"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A workbook, other than the active workbook, that is on disk or in memory and to which a dependency is implied or intended.</descrip></descripGrp><ntig><termGrp><term id="1506700">external workbook</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969593">llibre de treball extern</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29138_1506701_1969594"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The definition that is obtained by an index server during a crawl, to identify if any sentences in the item match the pattern for defining a term.</descrip></descripGrp><ntig><termGrp><term id="1506701">extracted definition</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969594">definició obtinguda</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29139_1506703_1969595"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A term that an extracted definition applies to.</descrip></descripGrp><ntig><termGrp><term id="1506703">extracted term</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969595">terme obtingut</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29140_1506704_1969596"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of users that has permission to manage all of the servers in a server farm. Members of the Farm Administrators group can perform command-line operations and all of the administrative tasks in Central Administration for the server or server farm.</descrip></descripGrp><ntig><termGrp><term id="1506704">Farm Administrators group</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969596">Grup d'administradors del conjunt de servidors</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29141_1506705_1969597"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An XML fragment that defines a feature and its attributes.</descrip></descripGrp><ntig><termGrp><term id="1506705">feature definition</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969597">definició de la característica</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29143_1506707_1969598"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A GUID that identifies a feature.</descrip></descripGrp><ntig><termGrp><term id="1506707">feature identifier</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969598">identificador de la característica</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29144_1506709_1969599"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A property that is associated with an active feature at a particular scope.</descrip></descripGrp><ntig><termGrp><term id="1506709">feature property</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969599">propietat de la característica</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29145_1506710_1969600"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The scope at which a feature can be activated.</descrip></descripGrp><ntig><termGrp><term id="1506710">feature scope</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969600">àmbit de característiques</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29147_1506714_1969602"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The configuration settings that describe how to issue a query for a given federated location and display the search results.</descrip></descripGrp><ntig><termGrp><term id="1506714">federated location definition</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969602">definició de la ubicació federada</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29148_1506720_1969603"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A string that uniquely identifies a field in a content type or a SharePoint list.</descrip></descripGrp><ntig><termGrp><term id="1506720">field internal name</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969603">nom intern del camp</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29149_1506722_1969604"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A container for items that are deleted. Items in this container are visible to users with the appropriate permissions and to site collection administrators.</descrip></descripGrp><ntig><termGrp><term id="1506722">first-stage Recycle Bin</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969604">Paperera de reciclatge de primer nivell</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29150_1506734_1969605"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of files that contain all index keys that are extracted from a set of items.</descrip></descripGrp><ntig><termGrp><term id="1506734">full-text index component</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969605">component de l'índex per paraules completes</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29151_1506735_1969606"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of propagating of one full-text index component.</descrip></descripGrp><ntig><termGrp><term id="1506735">full-text index propagation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969606">propagació de l'índex per paraules completes</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29152_1506736_1969607"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A list whose base type is Generic List.</descrip></descripGrp><ntig><termGrp><term id="1506736">generic list</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969607">llista genèrica</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29153_1506737_1968615"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The condition of a document whose content is stored in a location other than the content database. If a document is ghosted, the front-end Web server determines the location of the content by using the SetupPath value for the document.</descrip></descripGrp><ntig><termGrp><term id="1506737">ghosted</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1968615">per darrere</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29154_1506738_1969608"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An object that represents a chart and the datasheet that contains the data for the chart.</descrip></descripGrp><ntig><termGrp><term id="1506738">graph object</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969608">objecte de gràfic</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29155_1506739_1969609"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A string that uniquely identifies a document that is subject to the policies defined for a Group Approval workflow. The string is generated and assigned automatically to a document by a protocol server.</descrip></descripGrp><ntig><termGrp><term id="1506739">Group Approval document identifier</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969609">identificador de documents de l'aprovació de grup</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29156_1506740_1969610"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A cell that no longer appears in a worksheet view because it is contained within a hidden row or a hidden column.</descrip></descripGrp><ntig><termGrp><term id="1506740">hidden cell</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969610">cel·la amagada</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29157_1506741_1969611"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A column that does not appear in a worksheet view because its width is set to zero (0). A column can be hidden if an outline is collapsed.</descrip></descripGrp><ntig><termGrp><term id="1506741">hidden column</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969611">columna amagada</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29158_1506742_1969612"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A row that does not appear in a worksheet view because its height is set to zero (0). A row can be hidden if a user is filtering or if an outline is collapsed.</descrip></descripGrp><ntig><termGrp><term id="1506742">hidden row</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969612">fila amagada</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29159_1506743_1969613"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A managed property from the metadata index that the administrator identifies as a good indicator of a highly relevant item. It is used to produce a high confidence result.</descrip></descripGrp><ntig><termGrp><term id="1506743">high confidence property</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969613">propietat de confiança elevada</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29160_1506744_1969614"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A formatting setting that specifies how content is positioned within the horizontal space of a cell, object, or page. Content can be aligned along the left or right edge, or distributed evenly across the horizontal space.</descrip></descripGrp><ntig><termGrp><term id="1506744">horizontal alignment</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969614">alineació horitzontal</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29161_1506745_1969615"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The number of allowable host hops for a content source.</descrip></descripGrp><ntig><termGrp><term id="1506745">host depth</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969615">profunditat d'amfitrió</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29162_1506746_1969616"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of traversing to a server with a different host name during a crawl.</descrip></descripGrp><ntig><termGrp><term id="1506746">host hop</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969616">salt d'amfitrió</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29164_1506748_1969617"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">For each token that is encountered in a corpus of indexed items, a data structure that stores a list of postings that identify which documents matched and a list of occurrences that identify which position in each document.</descrip></descripGrp><ntig><termGrp><term id="1506748">inverted index</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969617">índex invertit</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29165_1506749_1969618"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An integer that uniquely identifies an item in a SharePoint list.</descrip></descripGrp><ntig><termGrp><term id="1506749">item identifier</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969618">identificador de l'element</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29165_1506749_1969625"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An integer that uniquely identifies an item in a SharePoint list.</descrip></descripGrp><ntig><termGrp><term id="1506749">item identifier</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969625">identificador de l'element de la llista</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29165_1506756_1969618"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An integer that uniquely identifies an item in a SharePoint list.</descrip></descripGrp><ntig><termGrp><term id="1506756">list item identifier</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969618">identificador de l'element</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29165_1506756_1969625"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An integer that uniquely identifies an item in a SharePoint list.</descrip></descripGrp><ntig><termGrp><term id="1506756">list item identifier</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969625">identificador de l'element de la llista</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29166_1506750_1969619"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process that automatically determines the language code identifier (LCID) for text in a document.</descrip></descripGrp><ntig><termGrp><term id="1506750">language auto-detection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969619">detecció automàtica de llengua</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29167_1506751_1969620"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A folder that is contained within a SharePoint list. A list folder can contain documents or list items, and it retains the characteristics of other items in the list, such as a customizable schema.</descrip></descripGrp><ntig><termGrp><term id="1506751">list folder</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969620">carpeta de llista</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29168_1506752_1969621"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A page that allows users to create, view, or edit an item in a list.</descrip></descripGrp><ntig><termGrp><term id="1506752">list form</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969621">formulari de llista</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29169_1506753_1969622"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Web Part that is used to display, edit, or view an item in a list.</descrip></descripGrp><ntig><termGrp><term id="1506753">List Form Web Part</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969622">element web de formularis de llista</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29170_1506754_1969623"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A GUID that is used to identify a list in a site collection.</descrip></descripGrp><ntig><termGrp><term id="1506754">list identifier</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969623">identificador de la llista</term><termNote type="geographicalUsage