"1970537">forma 2D</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17767_650127_1970538"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A constraint that applies to two elements, such as two classes or two associations. The constraint is shown as a dashed arrow from one element to the other, labeled by the constraint string in braces ({ }).</descrip></descripGrp><ntig><termGrp><term id="650127">2-element constraint</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970538">restricció de 2 elements</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17769_650129_1970539"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In an activity diagram, a type of state that has an internal action and at least one outgoing transition that involves the explicit events of completing the internal action.</descrip></descripGrp><ntig><termGrp><term id="650129">action state</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970539">estat amb acció</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17770_650130_1970540"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The page that is currently available for editing in a document.</descrip></descripGrp><ntig><termGrp><term id="650130">active page</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970540">pàgina activa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17771_650131_1970541"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A special case of a statechart diagram in which all of the states are action states and the transitions are triggered by the completion of actions in the source state.</descrip></descripGrp><ntig><termGrp><term id="650131">activity diagram</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970541">diagrama d'activitats</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17772_650132_1970249"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A schedule for planning the activities that often follow the completion of a project.</descrip></descripGrp><ntig><termGrp><term id="650132">activity plan</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970249">pla d'activitats</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17773_650133_1970542"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The basic component of a ROOM structure diagram. The space inside the actor can contain actor references, behavior end ports, reference ports, bindings, and layer connections. The border can contain class relay ports and class end ports.</descrip></descripGrp><ntig><termGrp><term id="650133">actor class</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970542">classe d'actor</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17774_650134_1970543"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The actors that define components of your structure diagram. Actor references can appear only inside an actor class. An actor reference can have reference ports on its outside border.</descrip></descripGrp><ntig><termGrp><term id="650134">actor reference</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970543">referència d'actor</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17775_650135_1970250"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The amount of time a task has been in progress.</descrip></descripGrp><ntig><termGrp><term id="650135">actual duration</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970250">duració real</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17776_650136_1967531"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Microsoft Access project (.adp) file with all modules compiled and all editable source code removed.</descrip></descripGrp><ntig><termGrp><term id="650136">ADE file</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1967531">fitxer ADE</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17777_650137_1970251"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of documenting and archiving a project in a timely manner, as well as formally accepting the project's product and lessons learned.</descrip></descripGrp><ntig><termGrp><term id="650137">administrative closure</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970251">tancament administratiu</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17778_650138_1970544"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The rectangle that appears around shapes and objects from other applications as you move them.</descrip></descripGrp><ntig><termGrp><term id="650138">alignment box</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970544">quadre d'alineació</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17779_650139_1970545"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The angle of the orientation of a shape's local coordinate system with respect to its parent coordinate system. The angle of rotation is specified in the Angle cell of the Shape Transform section in a ShapeSheet spreadsheet.</descrip></descripGrp><ntig><termGrp><term id="650139">angle of rotation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970545">angle de gir</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17780_650140_1970546"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The unit in which angles are expressed in ShapeSheet cells.</descrip></descripGrp><ntig><termGrp><term id="650140">angular unit</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970546">unitat angular</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17781_650141_1970252"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The amount of time between the scheduled start of a task and the time that the assigned resource is to start working on the task.</descrip></descripGrp><ntig><termGrp><term id="650141">assignment delay</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970252">retard de tasca</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17782_650142_1970253"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An enterprise resource who is responsible for entering progress information in Project Web Access. This person can be different than the person initially assigned to the task.</descrip></descripGrp><ntig><termGrp><term id="650142">assignment owner</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970253">propietari de tasca</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17783_650143_1970254"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A view that shows the resources assigned to each task as well as the total and time-phased work and cost information for each assignment. The two assignment views are the Task Usage and Resource Usage views.</descrip></descripGrp><ntig><termGrp><term id="650143">assignment view</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970254">visualització de tasques</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17784_650144_1970547"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The end of a binary or other association where it connects to a class. By associating properties with an association end, you can indicate the role or direction.</descrip></descripGrp><ntig><termGrp><term id="650144">association end</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970547">extrem d'associació</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17785_650145_1970548"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of collaboration role that describes the relationship between two ClassifierRoles. It is represented by a path between two class role elements and can include the underlined name of the corresponding association.</descrip></descripGrp><ntig><termGrp><term id="650145">AssociationRole</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970548">FuncióAssociació</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17786_650146_1970549"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In a static structure diagram, a use of a parameterized class, or template, in which the parameters from the parameterized class are bound to actual values.</descrip></descripGrp><ntig><termGrp><term id="650146">bound element</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970549">element vinculat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17788_650148_1970550"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The distance from the midpoint of a circular arc to the midpoint of the arc's chord.</descrip></descripGrp><ntig><termGrp><term id="650148">bow</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970550">curvatura</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17789_2680595_1970551"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A shape in a PivotDiagram, positioned along the connector between a parent PivotDiagram node and the children of that node.</descrip></descripGrp><ntig><termGrp><term id="2680595">breakdown shape</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970551">Desglossament</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17789_2680595_2680867"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A shape in a PivotDiagram, positioned along the connector between a parent PivotDiagram node and the children of that node.</descrip></descripGrp><ntig><termGrp><term id="2680595">breakdown shape</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2680867">forma de desglossament</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17789_650149_1970551"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A shape in a PivotDiagram, positioned along the connector between a parent PivotDiagram node and the children of that node.</descrip></descripGrp><ntig><termGrp><term id="650149">Breakdown</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970551">Desglossament</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17789_650149_2680867"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A shape in a PivotDiagram, positioned along the connector between a parent PivotDiagram node and the children of that node.</descrip></descripGrp><ntig><termGrp><term id="650149">Breakdown</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2680867">forma de desglossament</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17790_650150_1970255"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A resource that captures the maximum capacity for a project to consume money, work, or material units for a project. Budgets can only be applied at the project level by assigning a budget resource to the project summary task.</descrip></descripGrp><ntig><termGrp><term id="650150">budget resource</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970255">recurs de pressupost</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17792_650152_1970746"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The formatting attributes that are available by default in an application's style list.</descrip></descripGrp><ntig><termGrp><term id="650152">built-in style</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970746">estil integrat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17793_650153_1970256"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Project view that displays a project's tasks in a calendar format.</descrip></descripGrp><ntig><termGrp><term id="650153">calendar view</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970256">visualització de calendari</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17794_650154_1970552"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In a statechart or activity diagram, an indication that an object has received a call for an operation. A CallEvent is defined using the following format: event-name (comma-separated-parameter-list)</descrip></descripGrp><ntig><termGrp><term id="650154">CallEvent</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970552">IncidènciaTrucada</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech"