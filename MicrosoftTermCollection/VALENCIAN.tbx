17_2013827"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that automatically corrects searches for misspellings, alternative spellings or other input that would otherwise reduce the number or quality of the results.</descrip></descripGrp><ntig><termGrp><term id="2002417">Search Prediction</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2013827">Predicció de recerca</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34723_2002419_2013793"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables a user to search for events in the Calendar using keywords, and use filters to refine the search.</descrip></descripGrp><ntig><termGrp><term id="2002419">Calendar Event Search</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2013793">Recerca d'esdeveniments del Calendari</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34726_2002422_2013803"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables group owners to change their group's image and colors for a better representation.</descrip></descripGrp><ntig><termGrp><term id="2002422">group theming</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSe