/term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2508215">teclat de marcatge</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22615_3188175_3188261"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A numeric keypad that is part of a device, is displayed on a device, or is in a computer program that you use to enter information in the context of a phone call.</descrip></descripGrp><ntig><termGrp><term id="3188175">dialpad</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="3188261">teclat de marcatge</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22629_1052639_2578685"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of creating a hyperlink to a specific page within a Web site or Web-based application instead of to the site’s home page.</descrip></descripGrp><ntig><termGrp><term id="1052639">deep linking</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2578685">enllaç en profunditat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22631_1052824_1588592"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An icon that is attached to an event and that is viewable in someone's calendar. Depending on the calendar view, a charm may appear next to an event title, or may be the only visual representation of an event on a calendar day.</descrip></descripGrp><ntig><termGrp><term id="1052824">charm</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1588592">icona expressiva</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22632_1052846_1967947"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A traditional graphics plotter that uses pens to draw on paper. Pen plotters use one or more colored pens, either fiber-tipped pens or, for highest-quality output, drafting pens.</descrip></descripGrp><ntig><termGrp><term id="1052846">pen plotter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1967947">traçador gràfic</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22638_1052853_2699565"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A pointer to nothing: usually a standardized memory address, such as 0. A null pointer usually marks the last of a linear sequence of pointers or indicates that a data search operation has come up empty.</descrip></descripGrp><ntig><termGrp><term id="1052853">null pointer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2699565">punter nul</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22638_1052854_2699565"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A pointer to nothing: usually a standardized memory address, such as 0. A null pointer usually marks the last of a linear sequence of pointers or indicates that a data search operation has come up empty.</descrip></descripGrp><ntig><termGrp><term id="1052854">nil pointer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2699565">punter nul</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22646_1053493_1968524"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The part of an email address that identifies a user or an account on an email system.</descrip></descripGrp><ntig><termGrp><term id="1053493">account name</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1968524">nom del compte</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2266_66217_1970208"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of material for the information of a specific audience.</descrip></descripGrp><ntig><termGrp><term id="66217">information packet</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970208">paquet d'informació</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2267_318112_1968012"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A server built upon and integrated with the Microsoft Windows SharePoint Services platform to enable Web-based use of InfoPath form templates, by rendering editable InfoPath forms in HTML in the browser.</descrip></descripGrp><ntig><termGrp><term id="318112">InfoPath Forms Services</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1968012">InfoPath Forms Services</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22673_1053596_1970858"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A device that limits some aspect of a transmitted signal, such as volume, in order to increase efficiency.</descrip></descripGrp><ntig><termGrp><term id="1053596">compressor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970858">compressor</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2268_184296_1569463"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A searchable collection of articles and facts about a particular subject area.</descrip></descripGrp><ntig><termGrp><term id="184296">knowledge base</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1569463">KB</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2268_184296_1969965"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A searchable collection of articles and facts about a particular subject area.</descrip></descripGrp><ntig><termGrp><term id="184296">knowledge base</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969965">base de coneixement</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2268_351589_1569463"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A searchable collection of articles and facts about a particular subject area.</descrip></descripGrp><ntig><termGrp><term id="351589">KB</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1569463">KB</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2268_351589_1969965"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A searchable collection of articles and facts about a particular subject area.</descrip></descripGrp><ntig><termGrp><term id="351589">KB</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969965">base de coneixement</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22692_1053737_1967968"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A procedure by which a user's password can be changed to a known value, in situations where the user has forgotten or lost their password.</descrip></descripGrp><ntig><termGrp><term id="1053737">password reset</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1967968">reinicialització de la contrasenya</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22734_1054764_1970386"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A view that shows all of the resources on a project and their work over time. This makes it easy to rearrange work, schedule new work, and manage a team's load.</descrip></descripGrp><ntig><termGrp><term id="1054764">Team Planner</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970386">Planificació de l'equip</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22735_1054767_1970030"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows the application of tags to individual Outlook items to specify retention policy for that message, conversation or other item.</descrip></descripGrp><ntig><termGrp><term id="1054767">Retention Policy</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970030">Norma de retenció</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2279_26594_1566117"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A piece of software that functions as an electronic calendar used for scheduling.</descrip></descripGrp><ntig><termGrp><term id="26594">calendar program</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1566117">calendari</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2279_294450_1566117"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A piece of software that functions as an electronic calendar used for scheduling.</descrip></descripGrp><ntig><termGrp><term id="294450">calendar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1566117">calendari</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22798_1055051_2699569"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A microprocessor architecture developed in 1992 by Motorola and IBM, with some participation by Apple. A PowerPC microprocessor is RISC-based and superscalar, with a 64-bit data bus and 32-bit address bus. It also has separate data and instruction caches, although the size of each varies by implementation. All PowerPC microprocessors have multiple integer and floating-point units. The voltage and operating speed varies with the implementation. Starting with the PowerPC 740, the microprocessors were manufactured with copper, instead of aluminum, for better performance and reliability.</descrip></descripGrp><ntig><termGrp><term id="1055051">PowerPC</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2699569">PowerPC</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22804_1055072_1970859"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The part of a servomechanism, controlled by the servomechanism's feedback circuit, that produces the final mechanical output.</descrip></descripGrp><ntig><termGrp><term id="1055072">servo</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970859">servosistema</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22804_1055073_1970859"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The part of a servomechanism, controlled by the servomechanism's feedback circuit, that produces the final mechanical output.</descrip></descripGrp><ntig><termGrp><term id="1055073">servomotor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970859">servosistema</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22805_1055074_1970860"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A control system in which the final output is mechanical movement. A servomechanism uses feedback to control the position, velocity, or acceleration of a mechanical component.</descrip></descripGrp><ntig><termGrp><term id="1055074">servomechanism</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970860">servomecanisme</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22805_1055075_1970860"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A control system in which the final output is mechanical movement. A servomechanism uses feedback to control the position, velocity, or acceleration of a mechanical component.</descrip></descripGrp><ntig><termGrp><term id="1055075">servo system</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970860">servomecanisme</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22823_1055132_1563939"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The navigation button used to return to recently visited Web pages in Internet Explorer, Microsoft Edge, and other internet browsers.</descrip></descripGrp><ntig><termGrp><term id="1055132">Back</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1563939">Arrere</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22837_1055178_1970816"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Appearing in relatively coarse detail, used in reference to text and graphics in raster-oriented computer displays and printing. Low-resolution printing is comparable to draft-quality dot-matrix output printed at 125 dots per inch or less.</descrip></descripGrp><ntig><termGrp><term id="1055178">low-resolution</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970816">baixa resolució</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2284_264858_1970784"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The time that a resource is in the office, and that is not dedicated to project tasks or effort. Represents a resource's true availability.</descrip></descripGrp><ntig><termGrp><term id="264858">Working Time</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970784">Temps de faena</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2285_109836_1967409"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A join in which records from a table are combined with other records from the same table when there are matching values in the joined fields. A self-join can be an inner join or an outer join. In database diagrams, a self-join is called a reflexive relationship.</descrip></descripGrp><ntig><termGrp><term id="109836">self-join</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1967409">combinació automàtica</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2286_415069_1969021"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Essentially, a template used to create cycle instances. Any edits to the cycle definition are applied to every subsequently-created cycle instance that is based on that cycle definition.</descrip></descripGrp><ntig><termGrp><term id="415069">cycle definition</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969021">definició de cicle</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22865_1055946_1968525"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Information that describes the current location of a computer. The location is entered manually in Default Location, and can be used by programs to determine the location of a computer when a location sensor is unavailable.</descrip></descripGrp><ntig><termGrp><term id="1055946">default location</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1968525">ubicació per defecte</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2290_103825_1571271"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Generally, any part of a computer system or network, such as a disk drive, printer, or memory, that can be allotted to a running program or a process.</descrip></descripGrp><ntig><termGrp><term id="103825">resource</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1571271">recurs</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2291_184207_1968365"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The hierarchical HTML tag structure of an opened HTML document that appears in a task pane window.</descrip></descripGrp><ntig><termGrp><term id="184207">tag tree</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1968365">arbre d'etiquetes</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22911_1056204_1571768"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A term that can be added to a search to filter the results by a specific property (for example, by author). Relevant search filters appear under the search box in any open folder.</descrip></descripGrp><ntig><termGrp><term id="1056204">search filter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1571768">filtre de recerca</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2293_79701_1770729"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A rectangular bar displayed in an application's window, often at the top, from which menus can be selected by the user.</descrip></descripGrp><ntig><termGrp><term id="79701">menu bar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1770729">barra de menús</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2294_237932_1970511"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A window that shows pipeline components and all components to which the pipeline is connected.</descrip></descripGrp><ntig><termGrp><term id="237932">Connectivity Explorer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970511">Explorador de connectivitat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22944_1056351_1572415"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A soft keyboard that is displayed with a different set of settings by default (larger buttons, bigger size, etc.) when you launch the Tablet PC Input Panel with touch. This is to facilitate touch input.</descrip></descripGrp><ntig><termGrp><term id="1056351">touch keyboard</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1572415">teclat tàctil</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22975_1056711_1995412"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A small, affordable laptop that is designed to perform a limited number of tasks such as web browsing and email.</descrip></descripGrp><ntig><termGrp><term id="1056711">netbook</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1995412">ultraportàtil</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22975_1099729_1995412"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A small, affordable laptop that is designed to perform a limited number of tasks such as web browsing and email.</descrip></descripGrp><ntig><termGrp><term id="1099729">small notebook PC</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1995412">ultraportàtil</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2299_232415_1571260"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A message that appears at a specified interval before an appointment, meeting, or task that announces when the activity is set to occur.</descrip></descripGrp><ntig><termGrp><term id="232415">reminder</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1571260">recordatori</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22992_1056886_1570892"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A real-time, physical action applied to an object, in which multiple contact points are used simultaneously.</descrip></descripGrp><ntig><termGrp><term id="1056886">multitouch</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1570892">multitàctil</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22992_1056887_1570892"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A real-time, physical action applied to an object, in which multiple contact points are used simultaneously.</descrip></descripGrp><ntig><termGrp><term id="1056887">multi-touch</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1570892">multitàctil</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2306_210486_1968424"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The formal name for Word 12 file format. This format has an open, royalty-free specification, and is the technology licensed to external parties. This license is the subject in the messaging points where “Open, royalty-free license” is discussed.</descrip></descripGrp><ntig><termGrp><term id="210486">Word XML Format</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1968424">Format XML del Word</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23065_1057649_1970387"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows the user to specify manual or automatic scheduling on a per-task basis.</descrip></descripGrp><ntig><termGrp><term id="1057649">user-controlled scheduling</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970387">planificació controlada per l'usuari</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23066_1057653_1970388"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of scheduling that gives the user control over start and finish dates of their tasks. Tasks do not automatically get moved by the scheduling engine. The user can enter blank dates, textual dates, or dates that do not follow dependencies, calendar, and other scheduling engine rules.</descrip></descripGrp><ntig><termGrp><term id="1057653">manual scheduling</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970388">planificació manual</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23068_1057655_1969322"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Web analytics report that identifies terms that should become Best Bets.</descrip></descripGrp><ntig><termGrp><term id="1057655">Best Bet Suggestions report</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969322">informe de suggeriments d'opcions més probables</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23069_1057656_1969323"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Web analytics report that identifies the Best Bet terms and how they are utilized by the system.</descrip></descripGrp><ntig><termGrp><term id="1057656">Best Bet Usage report</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969323">informe d'ús d'opcions més probables</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23091_1058112_1969324"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows administrators the ability to backup and replicate their configuration.</descrip></descripGrp><ntig><termGrp><term id="1058112">Configuration Export</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969324">Exportació de configuració</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23092_1058116_1970186"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that ensures that all components of a file are preserved, even if they are supported only by the rich client and not viewable in Web Companions.</descrip></descripGrp><ntig><termGrp><term id="1058116">Document Integrity</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970186">Integritat del document</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23093_1058130_1968379"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that simplifies the task of creating new SharePoint data. It makes it easier for users to enter free-form information or add photos, Web Parts or files to a SharePoint page.</descrip></descripGrp><ntig><termGrp><term id="1058130">Web Edit</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1968379">Edició web</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2314_117926_1572384"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To change between states or modes.</descrip></descripGrp><ntig><termGrp><term id="117926">switch</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1572384">canviar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23155_1060417_1969325"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A team site template that provides group collaboration capabilities based on standard business practices. Integrated functions include a group calendar, Whereabouts, Announcements, Phone Call Memo, and Schedule and Reservations.</descrip></descripGrp><ntig><termGrp><term id="1060417">Group Work Site</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969325">Lloc de grup de treball</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23155_1060942_1969325"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A team site template that provides group collaboration capabilities based on standard business practices. Integrated functions include a group calendar, Whereabouts, Announcements, Phone Call Memo, and Schedule and Reservations.</descrip></descripGrp><ntig><termGrp><term id="1060942">GroupBoard Workspace</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969325">Lloc de grup de treball</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2316_138366_2736048"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A format that can be applied to selected text characters.</descrip></descripGrp><ntig><termGrp><term id="138366">character formatting</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2736048">format de caràcters</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23160_1060428_1969326"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that collects and logs SharePoint health indicators and usage metrics for analysis and reporting purposes.</descrip></descripGrp><ntig><termGrp><term id="1060428">Usage and Health Data Collection</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969326">Compilació de dades d'utilització i estat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23177_1060970_1588604"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A customizable page that launches with Windows Live Messenger and features a summary of news and weather, allows a customer to preview their Windows Live Mail inbox and search the Internet.</descrip></descripGrp><ntig><termGrp><term id="1060970">Today page</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1588604">pàgina Hui</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23180_1060974_1970868"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A text box where someone enters the email addresses of the primary recipients of an email message.</descrip></descripGrp><ntig><termGrp><term id="1060974">To box</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970868">Quadre "Per a"</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23184_1060982_1970116"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of features that enables users to improve the quality of their images with just one or two clicks. Galleries help the user optimize characteristics such as brightness, contrast, color, and sharpness.</descrip></descripGrp><ntig><termGrp><term id="1060982">Corrections</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970116">Correccions</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23200_1062908_1970111"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables Tablet PC users to convert an ink drawing to a standard OfficeArt shape, which can be formatted with colors and effects exactly as if it were inserted using “Insert Shape.”</descrip></descripGrp><ntig><termGrp><term id="1062908">Convert to Shape</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970111">Converteix en forma</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23201_1062909_1970112"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables presenters to capture all the elements of a live presentation, including narration, slides, mouse clicks, A/V playback, and laser pointer highlights. The user can select which presentation aspects to record.</descrip></descripGrp><ntig><termGrp><term id="1062909">Record Slide Show</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970112">Enregistrar presentació de diapositives</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23214_1064085_1650555"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A map view created from aerial photos that shows buildings, roads, and geographical features.</descrip></descripGrp><ntig><termGrp><term id="1064085">aerial view</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1650555">visualització aèria</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2323_61200_3042723"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to the base-16 number system represented by the digits 0 through 9 and the uppercase or lowercase letters A (equivalent to decimal 10) through F (equivalent to decimal 15). Hexadecimal values are commonly used in HTML code to identify colors.</descrip></descripGrp><ntig><termGrp><term id="61200">hex</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="3042723">hexadecimal</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2323_61201_3042723"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to the base-16 number system represented by the digits 0 through 9 and the uppercase or lowercase letters A (equivalent to decimal 10) through F (equivalent to decimal 15). Hexadecimal values are commonly used in HTML code to identify colors.</descrip></descripGrp><ntig><termGrp><term id="61201">hexadecimal</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="3042723">hexadecimal</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23231_1064457_1970861"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method of encoding information in a signal by varying the duration of pulses. The unmodulated signal consists of a continuous train of pulses of constant frequency, duration, and amplitude. During modulation, the pulse durations are changed to reflect the information being encoded.</descrip></descripGrp><ntig><termGrp><term id="1064457">pulse duration modulation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970861">modulació de la duració dels impulsos</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23231_1064457_1970862"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method of encoding information in a signal by varying the duration of pulses. The unmodulated signal consists of a continuous train of pulses of constant frequency, duration, and amplitude. During modulation, the pulse durations are changed to reflect the information being encoded.</descrip></descripGrp><ntig><termGrp><term id="1064457">pulse duration modulation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970862">PWM</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23231_1064458_1970861"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method of encoding information in a signal by varying the duration of pulses. The unmodulated signal consists of a continuous train of pulses of constant frequency, duration, and amplitude. During modulation, the pulse durations are changed to reflect the information being encoded.</descrip></descripGrp><ntig><termGrp><term id="1064458">pulse length modulation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970861">modulació de la duració dels impulsos</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23231_1064458_1970862"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method of encoding information in a signal by varying the duration of pulses. The unmodulated signal consists of a continuous train of pulses of constant frequency, duration, and amplitude. During modulation, the pulse durations are changed to reflect the information being encoded.</descrip></descripGrp><ntig><termGrp><term id="1064458">pulse length modulation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970862">PWM</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23231_1064459_1970861"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method of encoding information in a signal by varying the duration of pulses. The unmodulated signal consists of a continuous train of pulses of constant frequency, duration, and amplitude. During modulation, the pulse durations are changed to reflect the information being encoded.</descrip></descripGrp><ntig><termGrp><term id="1064459">pulse width modulation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970861">modulació de la duració dels impulsos</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23231_1064459_1970862"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method of encoding information in a signal by varying the duration of pulses. The unmodulated signal consists of a continuous train of pulses of constant frequency, duration, and amplitude. During modulation, the pulse durations are changed to reflect the information being encoded.</descrip></descripGrp><ntig><termGrp><term id="1064459">pulse width modulation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970862">PWM</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23231_1064460_1970861"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method of encoding information in a signal by varying the duration of pulses. The unmodulated signal consists of a continuous train of pulses of constant frequency, duration, and amplitude. During modulation, the pulse durations are changed to reflect the information being encoded.</descrip></descripGrp><ntig><termGrp><term id="1064460">PDM</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970861">modulació de la duració dels impulsos</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23231_1064460_1970862"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method of encoding information in a signal by varying the duration of pulses. The unmodulated signal consists of a continuous train of pulses of constant frequency, duration, and amplitude. During modulation, the pulse durations are changed to reflect the information being encoded.</descrip></descripGrp><ntig><termGrp><term id="1064460">PDM</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970862">PWM</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23231_1064461_1970861"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method of encoding information in a signal by varying the duration of pulses. The unmodulated signal consists of a continuous train of pulses of constant frequency, duration, and amplitude. During modulation, the pulse durations are changed to reflect the information being encoded.</descrip></descripGrp><ntig><termGrp><term id="1064461">PWM</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970861">modulació de la duració dels impulsos</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23231_1064461_1970862"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method of encoding information in a signal by varying the duration of pulses. The unmodulated signal consists of a continuous train of pulses of constant frequency, duration, and amplitude. During modulation, the pulse durations are changed to reflect the information being encoded.</descrip></descripGrp><ntig><termGrp><term id="1064461">PWM</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970862">PWM</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2325_347934_1968924"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The InfoPath design environment in which you can create or modify a form template.</descrip></descripGrp><ntig><termGrp><term id="347934">design mode</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1968924">mode de disseny</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2328_21412_1770176"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To associate two pieces of information with one another.</descrip></descripGrp><ntig><termGrp><term id="21412">bind</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1770176">enllaçar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23319_1072508_2431870"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The XML-based vector image format for two-dimensional graphics that supports interactivity and animation and that maintains an image's appearance regardless of screen size or print size.</descrip></descripGrp><ntig><termGrp><term id="1072508">Scalable Vector Graphics</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2431870">SVG</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23319_1072509_2431870"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The XML-based vector image format for two-dimensional graphics that supports interactivity and animation and that maintains an image's appearance regardless of screen size or print size.</descrip></descripGrp><ntig><termGrp><term id="1072509">SVG</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2431870">SVG</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2333_146857_1967666"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Row or column labels that are printed at the top of or on the left side of every page on a printed worksheet.</descrip></descripGrp><ntig><termGrp><term id="146857">print titles</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1967666">títols d'impressió</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23331_1073321_1571235"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A slide show mode that displays content in a manageable window that can be resized and features navigation buttons. This mode is optimized for reviewing presentations, allowing users to get the full experience, complete with animations and media, while performing other tasks, such as taking notes.</descrip></descripGrp><ntig><termGrp><term id="1073321">Reading View</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1571235">Visualització de lectura</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23333_1087526_1969844"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows users to easily add links to content within other content (e.g. pages, sections, section groups) and provides quick navigation through these links. The feature operates in the same manner that links work in wikis.</descrip></descripGrp><ntig><termGrp><term id="1087526">linking</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969844">enllaç</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23334_1073349_1969839"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that highlights new or changed content in a shared notebook that the user has not yet read.</descrip></descripGrp><ntig><termGrp><term id="1073349">Unread Changes</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969839">Canvis no llegits</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23335_1073356_1970389"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A high-level linear representation of a project schedule that can be easily formatted, annotated, and copied and pasted from Project into other Office applications.</descrip></descripGrp><ntig><termGrp><term id="1073356">timeline</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970389">línia de temps</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23336_1073640_1969840"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that identifies the author of unread new or changed content in a shared notebook.</descrip></descripGrp><ntig><termGrp><term id="1073640">Author Marks</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969840">Marques d'autor</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23347_1074772_1969327"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A task pane that helps form designers to build and manage custom business rules for use in their forms.</descrip></descripGrp><ntig><termGrp><term id="1074772">Rules Manager</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969327">Administrador de regles</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23348_1074773_1969328"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A pre-defined table style that allows users to change the look and feel of a form.</descrip></descripGrp><ntig><termGrp><term id="1074773">layout style</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969328">estil de disposició</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23349_1074775_1968650"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows form designers to select from a gallery of pre-built rules to make their forms dynamic.</descrip></descripGrp><ntig><termGrp><term id="1074775">Quick Rules</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1968650">regles ràpides</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23350_1074777_1969330"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A pre-defined layout that users can select for their InfoPath form pages. Options include layouts with titles, titles and headings, titles, headings and subheadings.</descrip></descripGrp><ntig><termGrp><term id="1074777">page layout</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969330">disposició de pàgina</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23351_1074778_1969331"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A pre-defined layout that users can select for their InfoPath form sections. Options include single column, two-column, three-column, and four-column layouts.</descrip></descripGrp><ntig><termGrp><term id="1074778">section layout</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969331">disposició de la secció</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23352_1216614_1969443"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An environment in the InfoPath client that enables users to fill out forms (as opposed to designing them). It must be used if the forms to be filled out are not browser-compatible.</descrip></descripGrp><ntig><termGrp><term id="1216614">InfoPath Filler</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969443">InfoPath Filler</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23352_1216614_1969446"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An environment in the InfoPath client that enables users to fill out forms (as opposed to designing them). It must be used if the forms to be filled out are not browser-compatible.</descrip></descripGrp><ntig><termGrp><term id="1216614">InfoPath Filler</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969446">Microsoft InfoPath Filler</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23352_1216691_1969443"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An environment in the InfoPath client that enables users to fill out forms (as opposed to designing them). It must be used if the forms to be filled out are not browser-compatible.</descrip></descripGrp><ntig><termGrp><term id="1216691">Microsoft InfoPath Filler</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969443">InfoPath Filler</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23352_1216691_1969446"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An environment in the InfoPath client that enables users to fill out forms (as opposed to designing them). It must be used if the forms to be filled out are not browser-compatible.</descrip></descripGrp><ntig><termGrp><term id="1216691">Microsoft InfoPath Filler</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969446">Microsoft InfoPath Filler</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23355_1074783_1969332"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Web Part that implements Web chart controls to visually display information in a variety of chart types in SharePoint.</descrip></descripGrp><ntig><termGrp><term id="1074783">Chart Web Part</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969332">element web gràfic</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23361_1074891_2075485"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The combination of hardware (touchscreen or touchpad) and software elements that provides a way to control programs by touching multiple points on the screen simultaneously.</descrip></descripGrp><ntig><termGrp><term id="1074891">multi-touch</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2075485">multitàctil</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23377_1075958_1967580"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A system table that captures failures and other events for Access Services.</descrip></descripGrp><ntig><termGrp><term id="1075958">logging table</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1967580">taula de registre</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23379_1076039_1969333"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of features designed to improve Groove's communications infrastructure and routing model in order to increase efficiency and performance.</descrip></descripGrp><ntig><termGrp><term id="1076039">Single Connect</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969333">connexió unificada</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23380_1076951_1970390"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that leverages Excel Services and SharePoint Server to provide easy and powerful reporting capabilities.</descrip></descripGrp><ntig><termGrp><term id="1076951">Report Center</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970390">centre d'informes</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23381_1076971_1970391"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that captures and manages work proposals in a single location. Proposals move through a customizable, multi-stage governance process that may include review, selection of proposals for approval, and tracking the execution of approved proposals through to completion.</descrip></descripGrp><ntig><termGrp><term id="1076971">Demand Management</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970391">Administració de propostes</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23386_1077181_2915204"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A virtual object that is similar in shape to playing cards.</descrip></descripGrp><ntig><termGrp><term id="1077181">card</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2915204">targeta</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="234_237832_1572252"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An object created using drawing tools or commands.</descrip></descripGrp><ntig><termGrp><term id="237832">shape</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1572252">forma</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23413_1080643_1967581"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that allows administration of Access services through an administration interface and PowerShell scripts.</descrip></descripGrp><ntig><termGrp><term id="1080643">Access Services Administration</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1967581">Administració de serveis de l'Access</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23414_1080644_1972891"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A condition or phenomenon that has the potential to impact a business either positively or negatively.</descrip></descripGrp><ntig><termGrp><term id="1080644">business driver</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1972891">impulsor de negocis</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech"