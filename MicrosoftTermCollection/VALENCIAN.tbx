cripGrp><ntig><termGrp><term id="318732">My Videos</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1570904">Els meus vídeos</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13208_144335_1967488"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of related macros that are stored together under a single macro name. The collection is often referred to simply as a macro.</descrip></descripGrp><ntig><termGrp><term id="144335">macro group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1967488">grup de macros</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13211_1507610_1969808"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of full-text index components and other files that are organized in a specific directory structure and contain the data that is needed to perform queries.</descrip></descripGrp><ntig><termGrp><term id="1507610">full-text index catalog</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969808">catàleg de l'índex per paraules completes</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13211_57289_1969808"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of full-text index components and other files that are organized in a specific directory structure and contain the data that is needed to perform queries.</descrip></descripGrp><ntig><termGrp><term id="57289">full-text catalog</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969808">catàleg de l'índex per paraules completes</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13214_139213_1967357"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Filtering a field to show the top or bottom n items based on a total. For example, you could filter for the three cities that generated the most sales or the five products that are least profitable.</descrip></descripGrp><ntig><termGrp><term id="139213">conditional filtering</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1967357">filtre condicional</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13219_3051_1563722"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Authorization to perform operations associated with a specific shared resource, such as a file, directory, or printer and that must be granted by the system administrator to individual user accounts or administrative groups.</descrip></descripGrp><ntig><termGrp><term id="3051">permissions</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1563722">permisos d'accés</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13219_3051_1571154"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Authorization to perform operations associated with a specific shared resource, such as a file, directory, or printer and that must be granted by the system administrator to individual user accounts or administrative groups.</descrip></descripGrp><ntig><termGrp><term id="3051">permissions</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1571154">permisos</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13219_315150_1563722"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Authorization to perform operations associated with a specific shared resource, such as a file, directory, or printer and that must be granted by the system administrator to individual user accounts or administrative groups.</descrip></descripGrp><ntig><termGrp><term id="315150">access permissions</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1563722">permisos d'accés</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13219_315150_1571154"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Authorization to perform operations associated with a specific shared resource, such as a file, directory, or printer and that must be granted by the system administrator to individual user accounts or administrative groups.</descrip></descripGrp><ntig><termGrp><term id="315150">access permissions</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1571154">permisos</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13220_210458_1968422"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An option that changes a 2-dimensional linear expression, such as 5^2, to a built-up (3-dimensional) format.</descrip></descripGrp><ntig><termGrp><term id="210458">linear expression</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1968422">expressió lineal</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13224_138502_1969909"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A reference to a specific legal case, statute, or other legal document.</descrip></descripGrp><ntig><termGrp><term id="138502">citation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969909">citació</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13228_263086_1566643"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A person who is involved in the creation of content. For example editors, technical reviewers and subject matter experts are contributors.</descrip></descripGrp><ntig><termGrp><term id="263086">contributor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1566643">col·laborador</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13233_372513_1770351"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The amount of space from the bottom of one line of text to the bottom of the next line.</descrip></descripGrp><ntig><termGrp><term id="372513">leading</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1770351">interlineat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13233_75157_1770351"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The amount of space from the bottom of one line of text to the bottom of the next line.</descrip></descripGrp><ntig><termGrp><term id="75157">line spacing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1770351">interlineat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13242_61847_2353740"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A chart consisting of horizontal or vertical bars, the widths or heights of which represent the values of numerical data.</descrip></descripGrp><ntig><termGrp><term id="61847">histogram</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2353740">histograma</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13246_264638_1968037"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A dialog box that allows users to add/remove/organize the list of bibliographic information for the document</descrip></descripGrp><ntig><termGrp><term id="264638">Source Manager</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1968037">Administrador de fonts bibliogràfiques</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13247_210455_1970837"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A system for organizing sites on a server. Each server can have more than one IIS instance, and each IIS instance can have more than one top-level site.</descrip></descripGrp><ntig><termGrp><term id="210455">IIS instance</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970837">Instància de l'IIS</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13255_89155_1968694"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Any peripheral which purpose is to convey information from a computer to a user in the form of text, images, sounds or other.</descrip></descripGrp><ntig><termGrp><term id="89155">output device</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1968694">dispositiu d'eixida</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13259_264864_1970786"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The amount of time a resource has available to work at any given point in time. Actual Capacity is equal to Capacity minus resource calendar exceptions (e.g. offsite training, morale events, jury duty) and previously scheduled committed work (Project task assignments with type = committed). This is the most valuable measure for scheduling a resource.</descrip></descripGrp><ntig><termGrp><term id="264864">Actual Capacity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970786">Capacitat real</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13266_264865_1970787"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An amount of time a resource can work based on its project calendar.</descrip></descripGrp><ntig><termGrp><term id="264865">base capacity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970787">Capacitat bàsica</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13272_264866_1970788"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An amount of time a resource can work based on its project calendar minus standard exceptions such as holidays and planned vacations.</descrip></descripGrp><ntig><termGrp><term id="264866">capacity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970788">Capacitat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13283_264880_1970789"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A template that addresses, from a Finance &amp; Accounting view, the general activities that define a typical effort to prepare an Annual Financial Report. Includes activities focused on obtaining the necessary information from multiple departments, to working with other departments (e.g., Legal and Public Relations) to ensure all required information is presented accurately, and up through the printing and distribution process.</descrip></descripGrp><ntig><termGrp><term id="264880">Annual Report Preparation</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970789">Preparació de l'informe anual</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13284_232490_1781652"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The combination of a number of products for sale as one unit.</descrip></descripGrp><ntig><termGrp><term id="232490">bundle</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1781652">paquet</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13288_264886_1970794"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A template that outlines the various considerations you might need in order to plan a marketing campaign in your organization. Planning a marketing campaign begins with understanding you position in the marketplace and ends with collecting data and analyzing campaign effectiveness.</descrip></descripGrp><ntig><termGrp><term id="264886">Marketing Campaign Planning</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970794">Planificació de campanyes de màrqueting</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13289_134217_1968705"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The text of a WordArt object.</descrip></descripGrp><ntig><termGrp><term id="134217">WordArt text</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1968705">text del WordArt</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13293_2428_1568552"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A network within an organization that uses Internet technologies and protocols, but is available only to certain people, such as employees of a company.</descrip></descripGrp><ntig><termGrp><term id="2428">intranet</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1568552">intranet</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13293_629895_1568552"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A network within an organization that uses Internet technologies and protocols, but is available only to certain people, such as employees of a company.</descrip></descripGrp><ntig><termGrp><term id="629895">private network</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1568552">intranet</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13294_264888_1970796"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A template that addresses, from a Finance &amp; Accounting perspective, the significant activities required of companies to prepare their opening balance sheet at the date of transition to IFRS within the context of a conversion from previous Generally Accepted Accounting Principles (GAAP) to International Financial Reporting Standards (IFRS).</descrip></descripGrp><ntig><termGrp><term id="264888">Preparation of an Opening Balance Sheet at the Date of Transition to IFRS</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970796">Preparació d'un balanç inicial a la data de transició als IFRS</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13303_264892_1970799"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A template that outlines the phases, key activities and deliverables of the standard Six Sigma life cycle.</descrip></descripGrp><ntig><termGrp><term id="264892">Six Sigma DMAIC Cycle</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970799">Cicle DMAIC de Six Sigma</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13304_185645_1588620"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A person whose information, such as ID or email address, has been added by the user to their contact list or to an address book.</descrip></descripGrp><ntig><termGrp><term id="185645">contact</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1588620">contacte</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13310_264893_1970780"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A template that addresses the general activities involved in efforts to achieve more efficient SOX compliance. This project assumes that the organization is already SOX compliant.</descrip></descripGrp><ntig><termGrp><term id="264893">SOX Compliance and Technology Options</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970780">Opcions de tecnologia i compliment de la llei Sarbanes-Oxley</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1332_47882_1566722"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The standard used to measure screen and printer resolution, expressed as the number of dots that a device can display or print per linear inch. The greater the number of dots per inch, the better the resolution.</descrip></descripGrp><ntig><termGrp><term id="47882">dots per inch</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1566722">ppp</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1332_47883_1566722"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The standard used to measure screen and printer resolution, expressed as the number of dots that a device can display or print per linear inch. The greater the number of dots per inch, the better the resolution.</descrip></descripGrp><ntig><term