ngular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2915507">identitat col·lectiva</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50476_2857364_2916001"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ability to take into account not just yourself and your teammates, but also the context that surrounds you.</descrip></descripGrp><ntig><termGrp><term id="2857364">situational awareness</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2916001">consciència situacional</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50477_2857366_2915505"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ability to sense the emotions of others and recognize the impact that one’s actions may have on others.</descrip></descripGrp><ntig><termGrp><term id="2857366">co-awareness</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2915505">sensibilització conjunta</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50478_2857368_2915513"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The productive force that emerges when a team harnesses their differences, as a result of nurturing and balancing the other key team dynamics: team purpose, collective identity, awareness, inclusion, trust and vulnerability.</descrip></descripGrp><ntig><termGrp><term id="2857368">constructive tension</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2915513">tensió constructiva</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50479_2857369_2915180"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The joint understanding of self and others that enables teams to navigate interpersonal dynamics and foster team cohesion.</descrip></descripGrp><ntig><termGrp><term id="2857369">awareness and inclusion</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2915180">comprensió i inclusió</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50480_2857376_2915174"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">UI label for inserting an Anyone link.</descrip></descripGrp><ntig><termGrp><term id="2857376">Anyone</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2915174">Qualsevol usuari</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50481_2857401_2915583"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Partner web app or add-in that integrates with Microsoft Graph and Microsoft productivity apps, workflows, and data across devices.</descrip></descripGrp><ntig><termGrp><term id="2857401">integrated apps</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2915583">aplicacions integrades</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50497_2858228_2915558"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A component-based document model for developers who create collaborative text editing apps that includes options for real-time sharing of edits within documents, shared editable templates, and rich content editing options.</descrip></descripGrp><ntig><termGrp><term id="2858228">Microsoft Fluid Framework</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2915558">Fluid Framework</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50497_2858228_2915624"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A component-based document model for developers who create collaborative text editing apps that includes options for real-time sharing of edits within documents, shared editable templates, and rich content editing options.</descrip></descripGrp><ntig><termGrp><term id="2858228">Microsoft Fluid Framework</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2915624">Microsoft Fluid Framework</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50497_2858231_2915558"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A component-based document model for developers who create collaborative text editing apps that includes options for real-time sharing of edits within documents, shared editable templates, and rich content editing options.</descrip></descripGrp><ntig><termGrp><term id="2858231">Fluid Framework</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2915558">Fluid Framework</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50497_2858231_2915624"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A component-based document model for developers who create collaborative text editing apps that includes options for real-time sharing of edits within documents, shared editable templates, and rich content editing options.</descrip></de