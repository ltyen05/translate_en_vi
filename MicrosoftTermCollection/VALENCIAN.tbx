rip></descripGrp><ntig><termGrp><term id="2371061">Set due date</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2374969">Defineix una data de venciment</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41898_2371062_2374970"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office 365 Planner section header control that shows all of the completed tasks for a particular plan.</descrip></descripGrp><ntig><termGrp><term id="2371062">Show completed</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2374970">Mostra les completades</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41899_2371063_2374966"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office 365 Planner section header control that hides all of the completed tasks for a particular plan.</descrip></descripGrp><ntig><termGrp><term id="2371063">Hide completed</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2374966">Amaga les completades</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelect