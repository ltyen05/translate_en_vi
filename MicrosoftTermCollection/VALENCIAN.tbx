ographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37314_2114585_3183251"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The actual or potential impact of a threat on an entity or organization.</descrip></descripGrp><ntig><termGrp><term id="2114585">severity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="3183251">gravetat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37316_2114593_2175747"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The folder above the current folder in the folder hierarchy. For example, C:\Shares is the parent folder of C:\Shares\public.</descrip></descripGrp><ntig><termGrp><term id="2114593">parent folder</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2175747">carpeta principal</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37317_2114594_2175749"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The location of a user's profile on the local drive, for example C:\Users\jason. The user profile could be a local profile, which is stored on a single computer, or a roaming user profile, which is synchronized with a file server so that multiple PCs can use the same profile settings.</descrip></descripGrp><ntig><termGrp><term id="2114594">profile path</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2175749">camí del perfil</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37324_2116468_2137502"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft service that provides fonts on demand to Microsoft applications, eliminating the need for any fonts to be shipped with those applications.</descrip></descripGrp><ntig><termGrp><term id="2116468">Microsoft Fonts Online</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2137502">Microsoft Fonts Online</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37325_2116471_2137510"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A handle that appears on objects or text insertion points when a user taps on them making selection easier.</descrip></descripGrp><ntig><termGrp><term id="2116471">selection handle</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2137510">control de selecció</term><termNote type="geographicalUsage">ESP</