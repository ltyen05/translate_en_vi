</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2915192">controls de trucada</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46395_2613226_2915193"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of people who can answer calls on behalf of someone else.</descrip></descripGrp><ntig><termGrp><term id="2613226">call group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2915193">grup de trucades</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46396_2613227_2915489"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The channels belonging to a specific team.</descrip></descripGrp><ntig><termGrp><term id="2613227">channel list</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2915489">llista de canals</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46397_2613228_2915493"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The list of your most recent chats that shows next to the app bar.</descrip></descripGrp><ntig><termGrp><term id="2613228">chat list</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2915493">llista de xats</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46398_2613229_2915509"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The edit box at the top of the app that lets the user search for people and messages, enter /commands and open apps.</descrip></descripGrp><ntig><termGrp><term id="2613229">command box</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2915509">quadre d'ordres</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46399_2613230_2915512"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The collection of all installed and available connectors.</descrip></descripGrp><ntig><termGrp><term id="2613230">Connectors gallery</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2915512">gal·leria de connectors</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46400_2613231_2915524"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process for developers to build and submit an app in Microsoft Teams.</descrip></descripGrp><ntig><termGrp><term id="2613231">developer app flow</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2915524">flux d'aplicacions per a desenvolupadors</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46401_2613232_2915544"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The people who create and manage a broadcast meeting.</descrip></descripGrp><ntig><termGrp><term id="2613232">event group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2915544">grup d'esdeveniments</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46402_2613233_2915546"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A person who has permission to create and manage a broadcast meeting.</descrip></descripGrp><ntig><termGrp><term id="2613233">event group member</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2915546">membre del grup d'esdeveniments</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46403_2613234_2915549"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The menu beneath the compose box, which shows installed compose apps and a link to the app gallery.</descrip></descripGrp><ntig><termGrp><term id="2613234">extensions menu</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2915549">menú d'extensions</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46404_2613235_2915612"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The list of all the user's scheduled meetings.</descrip></descripGrp><ntig><termGrp><term id="2613235">meetings list</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2915612">llista de reunions</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46405_2613236_2915620"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An extension to the functionality of the compose box that lets the user add richly formatted information from other apps and services. Messaging extensions are a set of pre-built, out of the box cards that can be displayed in a new message, chats or on Teams threads. The first three cards will be Polls, Checklists, and Surveys.</descrip></descripGrp><ntig><termGrp><term id="2613236">messaging extension</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2915620">extensió de missatgeria</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46406_2613237_2915647"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A conversation between two people.</descrip></descripGrp><ntig><termGrp><term id="2613237">one-on-one chat</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2915647">xat privat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46407_2613238_2915889"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A 1:1 conversation between two Skype users to discuss sensitive or confidential information.</descrip></descripGrp><ntig><termGrp><term id="2613238">private conversation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2915889">conversa privada</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGr