grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20752_747355_1570912"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A pencil tool that works with texture and simulates a real life pencil in stroke.</descrip></descripGrp><ntig><termGrp><term id="747355">natural pencil</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1570912">llapis natural</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20754_747357_1770825"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Windows feature that enables users to easily roll back their PC to an earlier good state while keeping their data safe.</descrip></descripGrp><ntig><termGrp><term id="747357">System Recovery</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1770825">Recuperació del sistema</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20760_1275532_1968190"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Microsoft Outlook add-in that allows you to schedule a Live Meeting or Lync or Office Communicator conference call from Outlook.</descrip></descripGrp><ntig><termGrp><term id="1275532">Conferencing Add-in for Microsoft Outlook</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1968190">Complement per a conferències per al Microsoft Outlook</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20767_747430_1968102"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Dial in to the audio conferencing provider from your physical telephone when the audio conferencing provider service cannot call you.</descrip></descripGrp><ntig><termGrp><term id="747430">dial in manually</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1968102">marcar manualment</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20768_747433_1968103"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to a connection that has ended.</descrip></descripGrp><ntig><termGrp><term id="747433">disconnected</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1968103">desconnectat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2077_149214_2137513"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A view on a calendar that displays items such as meetings and events from left to right on a time scale and that can incorporate items from multiple calendars.</descrip></descripGrp><ntig><termGrp><term id="149214">timeline</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2137513">cronologia</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20770_747437_1968169"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A contact within a group in the Contacts list.</descrip></descripGrp><ntig><termGrp><term id="747437">group member</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1968169">membre del grup</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20771_747438_1968170"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A video stream from a source that is external to the user's computer.</descrip></descripGrp><ntig><termGrp><term id="747438">incoming video</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1968170">vídeo entrant</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20781_747562_2842314"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In a call queue, a method of sending calls to agents whereby incoming calls ring all call agents one by one, from the beginning of the call agent list. If an agent dismisses or does not pick up a call, the call will ring the next agent and will try all agents until it is picked up or times out.</descrip></descripGrp><ntig><termGrp><term id="747562">serial routing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2842314">encaminament en sèrie</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20788_747570_1968285"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of addresses that can be treated as a logical unit so that calls of a specific type (for example, support calls as opposed to sales calls) can be routed to it.</descrip></descripGrp><ntig><termGrp><term id="747570">hunt group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1968285">grup d'extensions</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20799_747608_1970024"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A rule that is executed by the SharePoint Maintenance Manager to identify problems that are related to configuration settings, data integrity, performance, security, and other issues.</descrip></descripGrp><ntig><termGrp><term id="747608">maintenance rule</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970024">regla de manteniment</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="208_33569_1968677"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A color model for commercial printing that produces a wide range of colors by mixing varying percentages of cyan, magenta, yellow, and black inks.</descrip></descripGrp><ntig><termGrp><term id="33569">CMYK</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1968677">CMYK</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="208_33569_1968678"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A color model for commercial printing that produces a wide range of colors by mixing varying percentages of cyan, magenta, yellow, and black inks.</descrip></descripGrp><ntig><termGrp><term id="33569">CMYK</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1968678">cian-magenta-groc-negre</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpee