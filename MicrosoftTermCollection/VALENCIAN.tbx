ographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29461_1508809_1969879"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Software that enhances the functionality of Microsoft Office 2002 and your Web browser by extending the functionality of a Web server to provide publishing, collaboration, and document management capabilities.</descrip></descripGrp><ntig><termGrp><term id="1508809">Microsoft Office Server Extensions</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969879">Extensions de servidor del Microsoft Office</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29462_1508810_1970078"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A toolbar with buttons and options used to apply text formatting. To display the toolbar, point to Toolbars on the View menu, and then click Formatting.</descrip></descripGrp><ntig><termGrp><term id="1508810">Formatting toolbar</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970078">barra d'eines de format</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29464_1508812_1970079"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Visual Basic identifier that's defined in the host application or by using the #Const compiler directive, and used by other compiler directives to determine when or if certain blocks of code are compiled.</descrip></descripGrp><ntig><termGrp><term id="1508812">conditional compiler constant</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970079">constant de compilador condicional</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29465_1508813_1970080"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Naskh script that enriches the display of Arabic text. This script uses object linking and embedding (OLE) to create and add objects to a document.</descrip></descripGrp><ntig><termGrp><term id="1508813">DecoType Naskh</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970080">Decotipus Naskh</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29466_1508814_1970081"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Ruq'ah script that enriches the display of Arabic text. This script uses object linking and embedding (OLE) to create and add objects to a document.</descrip></descripGrp><ntig><termGrp><term id="1508814">DecoType Ruq'ah</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970081">Decotipus Ruq'ah</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29473_1508823_1970082"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An administrative tool that examines a computer, server farm, or server cluster and provides statistics that indicate the degree to which the configuration meets expected demands.</descrip></descripGrp><ntig><termGrp><term id="1508823">health analyzer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970082">analitzador de l'estat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29474_1508825_1970084"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A custom handler that calls and runs custom code during the creation process for a site.</descrip></descripGrp><ntig><termGrp><term id="1508825">site provisioning provider</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970084">proveïdor de la provisió de llocs</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29476_1508830_1970086"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Microsoft Office program that you can use to organize related documents. You can check spelling, number pages consecutively across all documents in the binder, and print the documents.</descrip></descripGrp><ntig><termGrp><term id="1508830">Binder</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970086">Binder</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29477_1508834_1970087"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A text string used in HTML to identify a page element's type, format, and appearance. Many elements have start and end tags that define where the element starts and stops.</descrip></descripGrp><ntig><termGrp><term id="1508834">HTML tag</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970087">etiqueta HTML</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29480_1508864_1970088"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A contiguous piece of text or string of characters sharing the same attributes. All characters in a run have the same directional properties.</descrip></descripGrp><ntig><termGrp><term id="1508864">run</term><termNote type="partOfSpeech">Noun</termNote><