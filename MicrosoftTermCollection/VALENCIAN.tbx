ds, labels, or tags in a system, which includes user-generated and system-generated classifications.</descrip></descripGrp><ntig><termGrp><term id="2876396">taxonomy service</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2877854">servei de taxonomia</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50903_2876995_2877974"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Teams for Education, an activity by which a teacher can assign work to students within a class team.</descrip></descripGrp><ntig><termGrp><term id="2876995">assignment</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2877974">tasca</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50915_2877863_2878186"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To provide notification of a problem, bug, crash, violation, etc. via a form submission.</descrip></descripGrp><ntig><termGrp><term id="2877863">report</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2878186">informar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><ter