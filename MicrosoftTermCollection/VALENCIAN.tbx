egular expression with or without a checksum validation, keyword list, keyword dictionary.</descrip></descripGrp><ntig><termGrp><term id="3012995">supporting element</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="3014314">element de suport</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53002_3012997_3014311"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An incorrect or inappropriate configuration of an information system that put your system and data at risk.</descrip></descripGrp><ntig><termGrp><term id="3012997">misconfiguration</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="3014311">configuració incorrecta</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53003_3012998_3014312"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows you to create a child email address or a disposable email address based on your standard email address, adding a "+"  suffix to the local part of your email address.</descrip></descripGrp><ntig><termGrp><term id="3012998">plus addressing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="3014312">adreçament addicional</term><termNote type="geograp