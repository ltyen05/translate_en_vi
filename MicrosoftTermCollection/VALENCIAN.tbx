">A business that is owned by an individual but is not treated as a separate entity from the business owner for tax purposes.</descrip></descripGrp><ntig><termGrp><term id="1993406">disregarded entity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2003792">entitat exclosa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34575_1993407_2003793"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An individual or entity that has no tax liability under US tax laws because they are not a citizen, resident alien, or an organization created or organized under the laws of the United States.</descrip></descripGrp><ntig><termGrp><term id="1993407">exempt payee</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2003793">beneficiari exempt</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34576_1993408_2003797"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The federal revenue agency under the United States Department of the Treasury that is responsible for the collection of taxes in addition to the interpretation and enforcement of federal tax laws.</descrip></descripGrp><ntig><termGrp><term id="1993408">Internal Revenue Service</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp>