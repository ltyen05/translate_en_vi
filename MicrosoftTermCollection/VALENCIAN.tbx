 formatting changes.</descrip></descripGrp><ntig><termGrp><term id="78381">markup</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970762">etiquetatge</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34785_2014070_2016815"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A piece of equipment that is running an operating system.</descrip></descripGrp><ntig><termGrp><term id="2014070">device</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2016815">dispositiu</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34787_2014144_2016833"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The enterprise-oriented feature which enables organizations to provide their users with access to data and documents stored on their corporate computers from anywhere.</descrip></descripGrp><ntig><termGrp><term id="2014144">Work Folders</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2016833">Carpetes de la faena</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3480_178518_1968759"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A repository that stores data for Business Contact Manager for Outlook.</descrip></descripGrp><ntig><termGrp><term id="178518">business database</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1968759">base de dades professional</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3486_59711_1970478"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A drawing window you can open to edit individual components of a group. The group appears unrotated in the group window even if it is rotated on the drawing page.</descrip></descripGrp><ntig><termGrp><term id="59711">group window</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970478">finestra de grup</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34866_2014990_2017819"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An organization's logo that an administrator can upload to replace the Office 365 logo in the upper-left corner of the website.</descrip></descripGrp><ntig><termGrp><term id="2014990">custom logo</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet x