term id="2260567">distribuir</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38882_2259634_2260569"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that lets customers extend their gaming experience across multiple devices, play with other users, and show off scores and achievements.</descrip></descripGrp><ntig><termGrp><term id="2259634">game hub</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2260569">centre de joc</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38883_2259635_2260570"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The default browser in Windows 10, which provides a more interoperable, reliable, and discoverable experience with advanced features including the ability to annotate on web pages, a distraction-free reading experience, and integration of Cortana. Also available on iOS and Android.</descrip></descripGrp><ntig><termGrp><term id="2259635">Microsoft Edge</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2260570">Microsoft Edge</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38884_2259636_2260577"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The source location of files that are stored on OneDrive and not synced to the local device. This is different from other OneDrive files (just called "OneDrive"), where a copy is synced and stored locally as well as in the cloud.</descrip></descripGrp><ntig><termGrp><term id="2259636">OneDrive (cloud only)</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2260577">OneDrive (només al núvol)</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38885_2259637_2260579"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user role within Windows Store for Business that allows the user to acquire apps from Windows Store for Business on behalf of his company.</descrip></descripGrp><ntig><termGrp><term id="2259637">purchaser</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2260579">comprador</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38886_2259638_2260580"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A view of a set of photos that displays them one at a time, sequentially.</descrip></descripGrp><ntig><termGrp><term id="2259638">slideshow</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2260580">presentació</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38887_2259809_2260575"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The section in the Settings app for Windows 10 desktop, containing network and Internet settings.</descrip></descripGrp><ntig><termGrp><term id="2259809">Network &amp; Internet</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2260575">Xarxa i Internet</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38892_2897506_2898045"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft cloud-based filtering system that detects and blocks malicious files, attachments, malware, and links in team sites, document libraries, as well as in team collaboration and email apps.</descrip></descripGrp><ntig><termGrp><term id="2897506">Microsoft Defender for Office 365</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2898045">Microsoft Defender per a l'Office 365</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></