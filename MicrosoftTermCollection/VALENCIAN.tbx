rip type="definition">A model that defines how access to data is controlled.</descrip></descripGrp><ntig><termGrp><term id="558229">security model</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969178">model de seguretat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14503_150387_1566685"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Video images and sound stored in a digital format.</descrip></descripGrp><ntig><termGrp><term id="150387">digital video</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1566685">vídeo digital</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14503_150388_1566685"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Video images and sound stored in a digital format.</descrip></descripGrp><ntig><termGrp><term id="150388">DV</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1566685">vídeo digital</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14506_415812_1971777"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A date within each assignment by which submission, review and approval should be completed.</descrip></descripGrp><ntig><termGrp><term id="415812">deadline</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1971777">data de venciment</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14509_113733_1572340"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A graphical user interface control that is equipped with a small bar which slides along a visible line and is used to set a value along a range with a minimum and maximum.</descrip></descripGrp><ntig><termGrp><term id="113733">slider</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1572340">control lliscant</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14509_641191_1572340"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A graphical user interface control that is equipped with a small bar which slides along a visible line and is used to set a value along a range with a minimum and maximum.</descrip></descripGrp><ntig><termGrp><term id="641191">slider control</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1572340">control lliscant</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14511_2148_1570868"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To reduce a window to a button on the taskbar by clicking the Minimize button (leftmost button on the right side of the title bar) or by pressing ALT+SPACEBAR and then pressing N.</descrip></descripGrp><ntig><termGrp><term id="2148">minimize</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1570868">minimitzar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14513_96306_2915947"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To run a set of instructions to retrieve specific data from the database, usually with multiple conditions. No list is displayed until you run the query.</descrip></descripGrp><ntig><termGrp><term id="96306">query</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2915947">consultar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14520_1359815_1968269"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A service that runs on Lync Server that resides in the perimeter network and routes instant messaging (IM) and presence information from external users to internal users.</descrip></descripGrp><ntig><termGrp><term id="1359815">Access Edge service</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1968269">servei perimetral d'accés</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14520_180253_1968269"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A service that runs on Lync Server that resides in the perimeter network and routes instant messaging (IM) and presence information from external users to internal users.</descrip></descripGrp><ntig><termGrp><term id="180253">Access Proxy</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1968269">servei perimetral d'accés</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14520_522068_1968269"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A service that runs on Lync Server that resides in the perimeter network and routes instant messaging (IM) and presence information from external users to internal users.</descrip></descripGrp><ntig><termGrp><term id="522068">Access Edge Server</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></t