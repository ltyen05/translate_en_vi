nization) that contains the data to define, set up, maintain, and administer a deployment, including the deployment topology and user policies.</descrip></descripGrp><ntig><termGrp><term id="1359077">Central Management store</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1968301">magatzem d'Administració central</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26926_1359092_1968532"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A utility that a developer can enable when debugging a SharePoint Foundation web page, that displays all the details of a page load.</descrip></descripGrp><ntig><termGrp><term id="1359092">developer dashboard</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1968532">tauler del desenvolupador</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26928_1359095_1968533"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of data structures that facilitates query evaluation by a search service application.</descrip></descripGrp><ntig><termGrp><term id="1359095">search index</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1968533">índex de recerca</term><te