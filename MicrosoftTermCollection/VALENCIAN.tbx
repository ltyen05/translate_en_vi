><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2177891">mode de moviment</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37474_2139114_2152729"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A database that stores search settings which include, but are not limited to search topology settings.</descrip></descripGrp><ntig><termGrp><term id="2139114">search administration database</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2152729">base de dades d'administració de recerques</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37475_2139115_2152715"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The webpage that displays all the apps that a particular user has a license to and that is scoped to the individual user.</descrip></descripGrp><ntig><termGrp><term id="2139115">My apps</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2152715">Les meues aplicacions</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37476_2139116_2152726"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The menu option in the Office 365 Compliance Center that allows users to search mail, files, and sites, specifying criteria on groups, people, or locations, and then take compliance actions on the results.</descrip></descripGrp><ntig><termGrp><term id="2139116">Search</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2152726">Recerca</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37477_2139117_2152722"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The button in the History pane used to restore the current document to an earlier version</descrip></descripGrp><ntig><termGrp><term id="2139117">Restore this version</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2152722">Restaura esta versió</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37478_2139118_2152721"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Sway view that allows the user to see what the Sway would look and behave like to anyone else reading it by switching from the edit view to the reading view.</descrip></descripGrp><ntig><termGrp><term id="2139118">Preview</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2152721">Visualització prèvia</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37479_2139119_2152745"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Sway feature that allows users to edit, add, reorder, delete, and structure their Sway content.</descrip></descripGrp><ntig><termGrp><term id="2139119">Storyline</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2152745">Guió</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37480_2139120_2152711"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of different visualization patterns and interactions for content shown in Sway.</descrip></descripGrp><ntig><termGrp><term id="2139120">card</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2152711">disseny</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37481_2139121_2152707"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Sway card that allows the user to select one or more pieces or types of content and change what is selected into a heading.</descrip></descripGrp><ntig><termGrp><term id="2139121">Header</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2152707">Capçalera</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37482_2139122_2152739"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Sway card that shows individual pieces of content sequentially, allowing forward and backward navigation one piece of content at a time.</descrip></descripGrp><ntig><termGrp><term id="2139122">Slideshow</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2152739">Presentació de diapositives</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37483_2139123_2152742"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Sway group card that shows individual pieces of content sequentially, as a skeuomorphic stack.</descrip></descripGrp><ntig><termGrp><term id="2139123">Stack</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2152742">Pila</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37484_2139125_2152698"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The button in Sway that allows for the addition of Headers, Text and Media from the Web or local device, and Layout options at the indicated location.</descrip></descripGrp><ntig><termGrp><term id="2139125">Add content</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2152698">Afig contingut</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37485_2139126_2152708"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Sway option button under “Add Content” that allows users to select an office document and import it into Sway.</descrip></descripGrp><ntig><termGrp><term id="2139126">Import Document</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2152708">Importa un document</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37486_2139127_2152748"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The menu option in Sway under the “Add Content” button that analyzes the user’s Sway to suggest useful content that can be browsed or added as desired.</descrip></descripGrp><ntig><termGrp><term id="2139127">Suggested Content</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2152748">Contingut suggerit</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37525_2139445_2152750"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The menu option in Sway under the “Add Content” button that allows users to upload images, Word documents, or PowerPoint presentations from their computer or mobile device into their Sway.</descrip></descripGrp><ntig><termGrp><term id="2139445">Upload Content</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2152750">Carrega contingut</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37527_2139460_2152735"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Sway button that allows users to share a sway with other Sway users via social media or Docs.com, add additional authors to a sway, or generate the HTML embed code for a sway.</descrip></descripGrp><ntig><termGrp><term id="2139460">Share</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2152735">Comparteix</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37528_2139461_2152706"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Sway button that allows the user to change a set of cards into a group of cards.</descrip></descripGrp><ntig><termGrp><term id="2139461">Group</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2152706">Grup</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37529_2139462_2152700"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The area on a card that allows a user to make the card’s image a background when clicked on.</descrip></descripGrp><ntig><termGrp><term id="2139462">Background</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2152700">Fons</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3753_503131_1968096"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A menu item that removes a group and its contacts from the user's Contacts list.</descrip></descripGrp><ntig><termGrp><term id="503131">Delete Group</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1968096">Suprimeix el grup</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37530_2139463_2152701"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Sway card that provides a quote-like treatment with breaks before and after selected content.</descrip></descripGrp><ntig><termGrp><term id="2139463">Block Quote</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2152701">Cita en bloc</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37531_2139464_2152704"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Sway card that places content into a tighter arrangement, aligning content by rows and/or columns.</descrip></descripGrp><ntig><termGrp><term id="2139464">Grid</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2152704">Quadrícula</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37532_2139465_2152738"><langSet xml:lang="en-US