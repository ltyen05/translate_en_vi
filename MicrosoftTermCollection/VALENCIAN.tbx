></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969375">element web d'informes</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16374_566927_1969192"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A report type that contains a Web page.</descrip></descripGrp><ntig><termGrp><term id="566927">Web page report view</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969192">visualització d'informe de pàgina web</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16387_568108_1969193"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A report, accessible from the Web Author, that generates a list of all pages waiting for the approval of the user who is logged on.</descrip></descripGrp><ntig><termGrp><term id="568108">Approval Assistant</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969193">Ajudant d'aprovació</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1639_148511_1967730"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A workbook that is configured to allow multiple users on a network to view and make changes at the same time. Each user who saves the workbook sees the changes that are made by other users.</descrip></descripGrp><ntig><termGrp><term id="148511">shared workbook</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1967730">llibre de treball compartit</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16391_568169_1969194"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Web page presented to unauthenticated users logging on to a site requiring authentication with a Web browser.</descrip></descripGrp><ntig><termGrp><term id="568169">authentication page</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969194">pàgina d'autenticació</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16402_583252_1969196"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An account used to reduce an asset or a liability to its current value.</descrip></descripGrp><ntig><termGrp><term id="583252">contra account</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969196">contracompte</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16402_625822_1969196"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An account used to reduce an asset or a liability to its current value.</descrip></descripGrp><ntig><termGrp><term id="625822">contra-account</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969196">contracompte</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16414_583814_2576155"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature of an integrated development environment (IDE) that provides logical code elements that the user can select from a drop-down menu while coding.</descrip></descripGrp><ntig><termGrp><term id="583814">IntelliSense</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2576155">IntelliSense</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1642_210902_1968016"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mode of session state in which the entire session state is serialized and stored as a BLOB on the client then deserialized during every post-back. This has a tremendous hit in bytes over the wire (BoW), but is highly scalable in that it doesn’t require storing information in the database.</descrip></descripGrp><ntig><termGrp><term id="210902">view state</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1968016">visualització de l'estat</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16438_584264_1967753"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A column chart subtype that compares values across categories. The categories are organized horizontally, and values vertically, to emphasize variation over time.</descrip></descripGrp><ntig><termGrp><term id="584264">clustered column chart</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1967753">gràfic de columnes agrupades</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16439_584277_1967755"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A column chart subtype that compares the percentage that each value contributes to a total across categories.</descrip></descripGrp><ntig><termGrp><term id="584277">100% stacked column chart</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1967755">gràfic de columnes 100% apilades</term><termNote type="geographicalU