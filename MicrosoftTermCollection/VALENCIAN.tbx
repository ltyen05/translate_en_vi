</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1646386">oferta en l'aplicació</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31689_1612739_1646388"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A transaction performed by a consumer from within the context of an app to buy additional features for that app.</descrip></descripGrp><ntig><termGrp><term id="1612739">in-app purchase</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1646388">compra des de l'aplicació</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3169_232421_1969982"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of shortcuts to folders that can be displayed in the Shortcuts pane.</descrip></descripGrp><ntig><termGrp><term id="232421">shortcut group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1969982">grup de dreceres</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31692_1612750_1646420"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Applications in Windows Store are distributed with user-based licensing model. Windows runtime and application model will only allow applications that are for user-based license as well as signed by Windows Store to be installed/run on Windows 8.</descrip></descripGrp><ntig><termGrp><term id="1612750">Microsoft License Terms for Consumers</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1646420">Termes de llicència de Microsoft per a consumidors</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31693_1612753_1646418"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Windows 8 all windows portal experiences support and persist Live ID logins streamlining the partner experience when working with multiple services and sites.</descrip></descripGrp><ntig><termGrp><term id="1612753">Microsoft account logins</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1646418">inicis de sessió en comptes Microsoft</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31698_1612764_1647454"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of notification sent via the Microsoft Push Notification Service to an app running on Windows Phone. The format and meaning of the data is determined by the a