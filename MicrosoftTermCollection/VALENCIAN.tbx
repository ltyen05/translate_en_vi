rage characterized by high capacity (roughly 650 MB) and the use of laser optics instead of magnetic means for reading data.</descrip></descripGrp><ntig><termGrp><term id="29204">CD-ROM</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1566573">CD-ROM</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1762_29205_1566573"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A form of storage characterized by high capacity (roughly 650 MB) and the use of laser optics instead of magnetic means for reading data.</descrip></descripGrp><ntig><termGrp><term id="29205">compact disc read-only memory</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1566573">CD-ROM</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1773_12334_1968671"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An authentication mechanism that does not require user accounts and passwords.</descrip></descripGrp><ntig><termGrp><term id="12334">Anonymous access</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1968671">Autenticació anònima</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote ty