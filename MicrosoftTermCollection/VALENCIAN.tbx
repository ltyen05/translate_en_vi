345_2026693_2028273"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in Exchange Admin Center (EAC) that generates a dynamic log of commands made to a server at that given point of time. Administrators can view the log to check the UI behavior, analyze or troubleshoot commands, or even run custom scripts on a server.</descrip></descripGrp><ntig><termGrp><term id="2026693">Cmdlet Logging Viewer</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2028273">Visualitzador del registre de cmdlet</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35346_2026694_2028267"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A procedure in which adding a shape to the drawing canvas automatically also adds the shape's name as a text label.</descrip></descripGrp><ntig><termGrp><term id="2026694">auto-labelling</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2028267">etiquetatge automàtic</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3537_232842_1970725"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A global template that you can use for any type of document. You can modify this template to change the default document formatting or content.</descrip></descripGrp><ntig><termGrp><term id="232842">Normal template</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970725">plantilla normal</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35386_2029080_2036717"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The edition of Windows 8.1 that has the search engine in Internet Explorer defaulted to Bing.</descrip></descripGrp><ntig><termGrp><term id="2029080">Windows 8.1 with Bing</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2036717">Windows 8.1 amb el Bing</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35387_2029081_2036715"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The software update to Windows 8.1 that gives users a more familiar and convenient experience across touch, keyboard and mouse inputs and enables more affordable Windows device choices.</descrip></descripGrp><ntig><termGrp><term id="2029081">Windows 8.1 Update</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2036715">Windows 8.1 Update</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="gram