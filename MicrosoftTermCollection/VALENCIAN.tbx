 id="20140_702751_1970659"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of shapes arranged in a tree structure that helps analyze and summarize data in a visual, easy-to-understand format. It starts out as a single shape, called a top node, that contains information imported from a worksheet, table, view, or cube.</descrip></descripGrp><ntig><termGrp><term id="702751">PivotDiagram</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970659">diagrama dinàmic</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20141_703430_2175766"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A policy that specifies the length of time during which items such as data, documents, builds, and releases are to be retained.</descrip></descripGrp><ntig><termGrp><term id="703430">retention policy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2175766">norma d'arxivament</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20149_704965_1967708"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A sequence of data such as numbers, number and text combinations, dates, or time periods, based on an established pattern and used to automatically fill data into worksheet cells.</descrip></descripGrp><ntig><termGrp><term id="704965">fill series</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1967708">sèries d'ompliment</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20159_707781_3004860"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A communication technology based on short range (4cm or less) wireless data exchange.</descrip></descripGrp><ntig><termGrp><term id="707781">near field communication</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="3004860">comunicació de camp proper</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20159_707781_3004861"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A communication technology based on short range (4cm or less) wireless data exchange.</descrip></descripGrp><ntig><termGrp><term id="707781">near field communication</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="3004861">NFC</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20159_707782_3004860"><langSet xml: