"2928466">escàner amb ús compartit de la pantalla</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51982_2926577_2928458"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Microsoft Teams service that simplifies the communications services acquisition and adoption process for business customers, providing the option to provision/deprovision phone numbers and (eventually) acquire/obtain capabilities from certified Carriers, all through the Teams Admin Center.</descrip></descripGrp><ntig><termGrp><term id="2926577">Operator Connect</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2928458">Connexió amb operador</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51983_2926579_2928442"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The tab in Microsoft Teams that allows the user to create, manage, and share approval requests such as stakeholder authorizations, customer signatures, or manager acknowledgements.</descrip></descripGrp><ntig><termGrp><term id="2926579">Approvals</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2928442">Aprovacions</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammati