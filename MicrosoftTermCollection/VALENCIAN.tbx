<descrip type="definition">The particular range of colors that a device or color model is able to produce.</descrip></descripGrp><ntig><termGrp><term id="660552">gamut</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1968566">gamma de colors</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13605_347939_1967506"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file or set of files that defines the data structure, appearance, and behavior of a form.</descrip></descripGrp><ntig><termGrp><term id="347939">form template</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1967506">plantilla de formulari</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1362_360135_1967412"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A view that summarizes and analyzes data in a datasheet or form. You can use different levels of detail or organize data by dragging the fields and items, or by showing and hiding items in the drop-down lists for the fields.</descrip></descripGrp><ntig><termGrp><term id="360135">PivotTable view</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1967412">visualització de taula dinàmica</ter