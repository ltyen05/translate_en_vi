51"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature applied to an object on the screen to change its visual appearance often to cause a certain reaction.</descrip></descripGrp><ntig><termGrp><term id="2556950">effect</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2559451">efecte</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="453_346972_1566734"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Without difficulty.</descrip></descripGrp><ntig><termGrp><term id="346972">easily</term><termNote type="partOfSpeech">Adverb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1566734">fàcilment</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Adverb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45305_2556986_2557365"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The name of the premium experience for mixed reality when used with PC hardware that can support higher resolution/quality graphics.</descrip></descripGrp><ntig><termGrp><term id="2556986">Windows Mixed Reality Ultra</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="2557365">Windows Mixed Reality Ultra</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperN