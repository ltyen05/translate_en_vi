">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7177_360143_1967517"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A report that isn't connected to a record source such as a table, query, or SQL statement.</descrip></descripGrp><ntig><termGrp><term id="360143">unbound report</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1967517">informe independent</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7178_117203_1967977"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The part of a message header that is used by the sender to indicate the object of the message.</descrip></descripGrp><ntig><termGrp><term id="117203">subject line</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1967977">línia del tema</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7182_32688_1566594"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An area of storage for objects, data, or their references after a user carries out a Cut or Copy command.</descrip></descripGrp><ntig><termGrp><term id="32688">clipboard</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1566594">Porta-retalls</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="719_47296_1770216"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An operating system feature that allows executable routines (generally serving a specific function or set of functions) to be stored separately as files with .dll extensions. These routines are loaded only when needed by the program that calls them.</descrip></descripGrp><ntig><termGrp><term id="47296">DLL</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1770216">DLL</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="719_47297_1770216"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An operating system feature that allows executable routines (generally serving a specific function or set of functions) to be stored separately as files with .dll extensions. These routines are loaded only when needed by the program that calls them.</descrip></descripGrp><ntig><termGrp><term id="47297">dynamic-link library</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1770216">DLL</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7190_73009_1569468"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A calculator-style block of keys, usually at the right side of a keyboard, that can be used to enter numbers.</descrip></descripGrp><ntig><termGrp><term id="73009">keypad</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1569468">teclat numèric</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7190_73010_1569468"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A calculator-style block of keys, usually at the right side of a keyboard, that can be used to enter numbers.</descrip></descripGrp><ntig><termGrp><term id="73010">numeric keypad</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1569468">teclat numèric</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7198_233471_2508216"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A grouping of telephony users with some specific properties, such as unique telephone extension numbers, that allow the Private Branch eXchange (PBX) to determine what action to take with dialed digits.</descrip></descripGrp><ntig><termGrp><term id="233471">dial plan</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termG