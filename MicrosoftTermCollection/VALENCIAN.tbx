e the text suggestions with the text that you want. A content template contains a slide master and an optional title master.</descrip></descripGrp><ntig><termGrp><term id="139402">content template</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1970126">plantilla de contingut</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1045_137287_1563766"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Text displayed by Web browsers during image downloads for users who have graphics turned off, and for users who rely on screen-reading software to convert graphics on the screen to spoken words.</descrip></descripGrp><ntig><termGrp><term id="137287">alternative text</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-ES-valencia"><ntig><termGrp><term id="1563766">text ALT</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1045_765697_1563766"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Text displayed by Web browsers during image downloads for users who have graphics turned off, and for users who rely on screen-reading software to convert graphics on the screen to spoken words.</descrip></descripGrp><ntig><termGrp><term id="765697">ALT text</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ca-