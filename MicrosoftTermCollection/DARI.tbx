877866_2505207"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A card that displays information about a person such as their picture and contact information.</descrip></descripGrp><ntig><termGrp><term id="2877866">Persona Card</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2505207">کارت مشخصات</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44419_2501251_2505208"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A view of a virtual object, such as a card, that is larger and contains more information than the standard view.</descrip></descripGrp><ntig><termGrp><term id="2501251">expanded view</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2505208">دیدگاه گسترده</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44431_2550466_2552824"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An app that enables the users to view, organize, edit and share all of their photos and videos from multiple sources, and tell stories with them by making them into new videos. It replaces the default Photos app in Windows 10.</descrip></descripGrp><ntig><termGrp><term id="2550466">Photos &amp; Videos</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSe