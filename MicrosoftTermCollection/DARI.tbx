ermEntry><termEntry id="6186_418609_2074703"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A voice session that can be conducted between two or more telephones, two or more devices (such as computers or smartphones), or between two or more such devices and telephones.</descrip></descripGrp><ntig><termGrp><term id="418609">call</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2074703">تماس</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6190_142020_1897300"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The small black square in the lower-right corner of a selected cell that can be used to copy data and to fill adjacent cells with a series of data.</descrip></descripGrp><ntig><termGrp><term id="142020">fill handle</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1897300">دستۀ پرکاری</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6196_144404_1897322"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of information service used to configure messaging programs to send and receive email.</descrip></descripGrp><ntig><termGrp><term id="144404">mail delivery service</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1897322">خدمت ارسال پست</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6197_76338_1499138"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file that stores messages generated by an application, service, or operating system that are used to track the operations performed.</descrip></descripGrp><ntig><termGrp><term id="76338">log file</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1499138">فایل ثبت وقایع</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="62_3160_1499304"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A server located on a network between client software, such as a Web browser, and another server. It intercepts all requests to the server to determine whether it can fulfill them itself. If not, it forwards the request to another server.</descrip></descripGrp><ntig><termGrp><term id="3160">proxy server</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1499304">سرور نماینده</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6200_50329_1498904"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To insert information created in one program, such as a chart, an equation, an image, a video or a font, into another program or Web page.</descrip></descripGrp><ntig><termGrp><term id="50329">embed</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1498904">جادادن</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6202_70557_1499064"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To reverse something or change it to its opposite.</descrip></descripGrp><ntig><termGrp><term id="70557">invert</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1499064">معکوس کردن</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6208_147957_2299359"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A field that can show formatting and graphics, such as an embedded object, and not just text.</descrip></descripGrp><ntig><termGrp><term id="147957">rich text field</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2299359">میدان متن غنی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="621_121364_1505704"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of object within a process that runs program instructions. Using multiple threads allows concurrent operations within a process and enables one process to run different parts of its program on different processors simultaneously. A thread has its own set of registers, its own kernel stack, a thread environment block, and a user stack in the address space of its process.</descrip></descripGrp><ntig><termGrp><term id="121364">thread</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1505704">نخ</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6212_237302_1354592"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that monitors a user's saved searches and sends regular E-mail summaries with new and updated matching results. The user can provide feedback on the results to tune the saved search query for better results.</descrip></descripGrp><ntig><termGrp><term id="237302">Search Alerts</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1354592">زنگ های جستجو</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6214_144473_1897323"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A right that allows a user to add, modify, and remove lists, document libraries, discussion boards, and surveys.</descrip></descripGrp><ntig><termGrp><term id="144473">Manage Lists right</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1897323">حق مدیریت لست ها</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6215_2282727_2285101"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Microsoft word processing software designed for use with handheld computing devices.</descrip></descripGrp><ntig><termGrp><term id="2282727">Word Mobile</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2285101">Word Mobile</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6215_331740_2285101"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Microsoft word processing software designed for use with handheld computing devices.</descrip></descripGrp><ntig><termGrp><term id="331740">Microsoft® Office Word Mobile</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2285101">Word Mobile</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6217_2282728_2285094"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Microsoft spreadsheet software designed for use with handheld computing devices.</descrip></descripGrp><ntig><termGrp><term id="2282728">Excel Mobile</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2285094">Excel Mobile</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6217_331756_2285094"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Microsoft spreadsheet software designed for use with handheld computing devices.</descrip></descripGrp><ntig><termGrp><term id="331756">Microsoft® Office Excel® Mobile</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2285094">Excel Mobile</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6223_307422_2299044"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A password or a passcode that the users set on their device such as smartphones.</descrip></descripGrp><ntig><termGrp><term id="307422">device password</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2299044">رمز عبور دستگاه</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6224_144653_1505884"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A placeholder for text or pictures that you insert into your document.</descrip></descripGrp><ntig><termGrp><term id="144653">merge field</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1505884">میدان ادغام</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6231_144677_1897325"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A single cell that is created by combining two or more selected cells. The cell reference for a merged cell is the upper-left cell in the original selected range.</descrip></descripGrp><ntig><termGrp><term id="144677">merged cell</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1897325">سلول ادغام شده</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6232_141181_1505885"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An area upon which users can draw multiple shapes, such that the shapes can be moved and resized as a unit.</descrip></descripGrp><ntig><termGrp><term id="141181">drawing canvas</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1505885">پارچۀ رسامی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6239_264786_1505886"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A view for delivering a presentation that provides the presenter with additional options for viewing and controlling its delivery.</descrip></descripGrp><ntig><termGrp><term id="264786">Presenter View</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1505886">دید تقدیم کننده</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6247_318716_1498645"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of compositions or memorabilia of a specific type or for a particular purpose, such as audio recordings, photographs, or documents.</descrip></descripGrp><ntig><termGrp><term id="318716">album</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1498645">آلبوم</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6259_1054660_2701062"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A device consisting of a number of connected circuit elements, such as transistors and resistors, fabricated on a small rectangle (a "die") cut from a silicon (or, in some special cases, a sapphire) wafer. Chips are categorized by the number of elements they contain.</descrip></descripGrp><ntig><termGrp><term id="1054660">integrated circuit</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2701062">تراشه</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6259_1054661_2701062"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A device consisting of a number of connected circuit elements, such as transistors and resistors, fabricated on a small rectangle (a "die") cut from a silicon (or, in some special cases, a sapphire) wafer. Chips are categorized by the number of elements they contain.</descrip></descripGrp><ntig><termGrp><term id="1054661">IC</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2701062">تراشه</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6259_31338_2701062"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A device consisting of a number of connected circuit elements, such as transistors and resistors, fabricated on a small rectangle (a "die") cut from a silicon (or, in some special cases, a sapphire) wafer. Chips are categorized by the number of elements they contain.</descrip></descripGrp><ntig><termGrp><term id="31338">chip</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2701062">تراشه</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="626_61316_1499007"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Not visible to the user.</descrip></descripGrp><ntig><termGrp><term id="61316">hidden</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1499007">پنهان شده</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6270_380992_1530892"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A version that is ready for a larger group to see or that has changed significantly since the previous major version.</descrip></descripGrp><ntig><termGrp><term id="380992">major version</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1530892">نسخۀ عمده</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6273_145441_1897336"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of software that provides access to a particular type of OLAP database. This software can include a data source driver and other client software that is necessary to connect to a database.</descrip></descripGrp><ntig><termGrp><term id="145441">OLAP provider</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1897336">دسترسی به OLAP</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6279_26739_1498730"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To attempt to establish a voice conversation with another person or other people from a phone, computer, or mobile device.</descrip></descripGrp><ntig><termGrp><term id="26739">call</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1498730">فراخواندن</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6279_26739_2074800"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To attempt to establish a voice conversation with another person or other people from a phone, computer, or mobile device.</descrip></descripGrp><ntig><termGrp><term id="26739">call</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2074800">تماس</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6282_139056_1897267"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Colors that are opposite each other on the color wheel, such as yellow and blue.</descrip></descripGrp><ntig><termGrp><term id="139056">complementary colors</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1897267">رنگ های متضاد</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6287_89072_1499221"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Worksheet data in which rows or columns of detail data are grouped so that you can create summary reports. The outline can summarize either an entire worksheet or a selected portion of it.</descrip></descripGrp><ntig><termGrp><term id="89072">outline</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1499221">رئوس مطالب</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6288_307448_2299374"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Outlook and Outlook Web Access feature that automatically suggests the best meeting times for a given a group of attendees, allowing users to schedule people and resources quickly and efficiently.</descrip></descripGrp><ntig><termGrp><term id="307448">Scheduling Assistant</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2299374">مساعد تقسیم اوقات</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6293_1060959_1499225"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A document on the World Wide Web that consists of an HTML file, with associated files for graphics and scripts, in a particular directory on a particular machine (and thus identifiable by an URL).</descrip></descripGrp><ntig><termGrp><term id="1060959">webpage</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1499225">صفحه</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6293_1060959_1499560"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A document on the World Wide Web that consists of an HTML file, with associated files for graphics and scripts, in a particular directory on a particular machine (and thus identifiable by an URL).</descrip></descripGrp><ntig><termGrp><term id="1060959">webpage</term><ter