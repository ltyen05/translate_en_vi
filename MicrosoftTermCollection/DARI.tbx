plication that created it. In general, a binary file can be edited only by the application in which it was created.</descrip></descripGrp><ntig><termGrp><term id="21247">binary file</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1946052">پروندۀ مضاعف</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14540_373951_1506103"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An interactive technology in Microsoft Excel or Access that can show dynamic views of the same data from a list or a database.</descrip></descripGrp><ntig><termGrp><term id="373951">Microsoft PivotTable</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1506103">PivotTable</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14540_373952_1506103"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An interactive technology in Microsoft Excel or Access that can show dynamic views of the same data from a list or a database.</descrip></descripGrp><ntig><termGrp><term id="373952">PivotTable</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1506103">PivotTable</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Pr