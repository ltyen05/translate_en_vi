</ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1897949">فرمول ارزیابی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25837_1217966_2299089"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Outlook Live feature in the Web management interface that enables migration of the contents of user mailboxes from an on-premises IMAP messaging system to Outlook Live (or Exchange Online).</descrip></descripGrp><ntig><termGrp><term id="1217966">Email Migration</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2299089">انتقال ایمیل</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25844_1218374_2299334"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The domain name of the Outlook Live domain that you are configuring with Outlook Live Directory Sync (OLSync)(previously known as GALSync 2010). When you deploy OLSync, you manually enter at least one provisioning domain, for example, student.contoso.edu, during the ILM 2007 configuration process. The provisioning domain must be an accepted domain in your Outlook Live deployment.</descrip></descripGrp><ntig><termGrp><term id="1218374">provisioning domain</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2299334">دومین تدارک کردن</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25845_1218375_2298950"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A domain or a person that an end user doesn't want to receive email messages from. Messages received from any email address or domain listed in the users' Blocked Senders list are sent directly to the user's Junk E-Mail folder.</descrip></descripGrp><ntig><termGrp><term id="1218375">blocked sender</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2298950">فرستنده مسدود شده</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25846_1218376_2299219"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Active Directory security principal object that has at least one associated SMTP address</descrip></descripGrp><ntig><termGrp><term id="1218376">mail-enabled user</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2299219">استفاده کننده با ایمیل فعال</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25847_1218377_2299160"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The administrator user interface in Outlook Live used to import new users with a CSV file.</descrip></descripGrp><ntig><termGrp><term id="1218377">Import users</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2299160">وارد کردن استفاده کنندگان</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25848_1218378_2299019"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A comma separated value (CSV) file used to provision many new users at one time.</descrip></descripGrp><ntig><termGrp><term id="1218378">CSV import file</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2299019">فایل وارد کردن CSV</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25849_1218379_2299159"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of provisioning new users using a CSV file.</descrip></descripGrp><ntig><termGrp><term id="1218379">import process</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2299159">پروسه وارد کردن</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25850_1218380_2299498"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The administrative boundary in which members of an Exchange 2010 role group can make changes. For the Outlook Live hosted service, the write scope is the entire Outlook Live organization. For on-premises implementations of Microsoft Exchange Server 2010, write scopes may be smaller in breadth, such as those defined by a specific organizational unit or a database.</descrip></descripGrp><ntig><termGrp><term id="1218380">write scope</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2299498">محدوده نوشتن</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25851_1218381_2299054"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The role group that gives users the permissions needed to use Multi-Mailbox Search.</descrip></descripGrp><ntig><termGrp><term id="1218381">Discovery Management</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2299054">مدیریت اکتشاف</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25852_1218382_2299146"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The role group that gives users the permissions to reset passwords for users and manage settings on the Options page for users' Outlook Live account. To help troubleshoot user issues, members can also view, but not modify, all mailboxes, public groups, and external contacts in the organization.</descrip></descripGrp><ntig><termGrp><term id="1218382">Help Desk</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2299146">بخش کمک</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25853_1218383_2299340"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The role group that gives users the permissions to create and manage mailboxes, public groups, and external contacts. Members can also import new users, track messages sent and received by users, and manage Exchange ActiveSync settings for the organization.</descrip></descripGrp><ntig><termGrp><term id="1218383">Recipient Management</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2299340">مدیریت گیرنده</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25854_1218384_2299342"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The role group that gives users permissions to create and manage organization-wide rules, also known as transport rules. Members of the role group can also track messages sent and received by users.</descrip></descripGrp><ntig><termGrp><term id="1218384">Records Management</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2299342">مدیریت رکوردها</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25855_1218385_2299452"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The role group that gives users the permissions to manage Unified Messaging (UM) server configurations, UM properties on mailboxes, UM prompts, and UM auto attendant configuration.</descrip></descripGrp><ntig><termGrp><term id="1218385">UM Management</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2299452">مدیریت UM</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25856_1218386_2299474"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The administrator role group that gives users permissions to view, but not modify, all mailboxes, public groups, and external contacts in the organization. Members can also view settings for role assignment policies, transport rules, and supervision policies.</descrip></descripGrp><ntig><termGrp><term id="1218386">View-Only Organization Management</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2299474">مدیریت سازمان صرف-دیدن</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25857_1218387_2299372"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A domain or a person that a user wants to always receive email messages from. Users add recipients and domains to the Safe Senders list.</descrip></descripGrp><ntig><termGrp><term id="1218387">safe sender</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2299372">فرستنده مصئون</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25858_1218388_2299255"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in Exchange 2010 and Outlook Live that enables users to search the mailboxes in their organization for email and other message types that contain specific keywords. The results of a search are then copied to a mailbox that you have specified so that you can review, organize, and export the search results.</descrip></descripGrp><ntig><termGrp><term id="1218388">Multi-Mailbox Search</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2299255">جستجوی چند صندوق پستی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25859_1218389_2299461"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An item that can't be indexed for a mailbox search using Multi-Mailbox Search. This includes unrecognized message types and messages that contain attachments that are encrypted or have an unrecognized format.</descrip></descripGrp><ntig><termGrp><term id="1218389">unsearchable item</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2299461">فقره غیرقابل جستجو</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25860_1218390_2299139"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A person who is assigned the ability to approve and reject any messages sent to a public group or a dynamic distribution group.</descrip></descripGrp><ntig><termGrp><term id="1218390">group moderator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2299139">ناظم گروه</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25862_1223075_2299368"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of resource mailbox that is assigned to a meeting location such as a conference room, auditorium, or training room. Room mailboxes can be included as resources in meeting requests, providing a simple and efficient way of organizing meetings for an organization.</descrip></descripGrp><ntig><termGrp><term id="1223075">room mailbox</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2299368">صندوق پستی اتاق</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25869_1224269_2299417"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Elevated credentials that have rights to access objects that ordinary users without elevated credentials can't access.</descrip></descripGrp><ntig><termGrp><term id="1224269">super-user credentials</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2299417">مشخصات فوق کاربری</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25870_1224270_2299313"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A subscription that gathers messages from POP3 mailboxes and delivers the messages to a designated Outlook Live mailbox so that the Outlook Live end user can centralize their email accounts and only have to check one mailbox.</descrip></descripGrp><ntig><termGrp><term id="1224270">POP subscription</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2299313">اشتراک POP</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25871_1224271_2299085"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Windows Live ID created in a domain, and using the domain name, before the domain was enrolled in Outlook Live. After the Windows Live ID is imported into the Outlook Live domain, it is subject to the security and privacy policies of the organization.</descrip></descripGrp><ntig><termGrp><term id="1224271">unmanaged Windows Live ID</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2299085">شناسه EASI</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25871_1224271_2299088"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Windows Live ID created in a domain, and using the domain name, before the domain was enrolled in Outlook Live. After the Windows Live ID is imported into the Outlook Live domain, it is subject to the security and privacy policies of the organization.</descrip></descripGrp><ntig><termGrp><term id="1224271">unmanaged Windows Live ID</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2299088">ایمیل بحیث شناسه ورود</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25871_1275550_2299085"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Windows Live ID created in a domain, and using the domain name, before the domain was enrolled in Outlook Live. After the Windows Live ID is imported into the Outlook Live domain, it is subject to the security and privacy policies of the organization.</descrip></descripGrp><ntig><termGrp><term id="1275550">e-mail as sign in ID</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2299085">شناسه EASI</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25871_1275550_2299088"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Windows Live ID created in a domain, and using the domain name, before the domain was enrolled in Outlook Live. After the Windows Live ID is imported into the Outlook Live domain, it is subject to the security and privacy policies of the organization.</descrip></descripGrp><ntig><termGrp><term id="1275550">e-mail as sign in ID</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2299088">ایمیل بحیث شناسه ورود</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25871_1275551_2299085"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Windows Live ID created in a domain, and using the domain name, before the domain was enrolled in Outlook Live. After the Windows Live ID is imported into the Outlook Live domain, it is subject to the security and privacy policies of the organization.</descrip></descripGrp><ntig><termGrp><term id="1275551">EASI ID</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2299085">شناسه EASI</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25871_1275551_2299088"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Windows Live ID created in a domain, and using the domain name, before the domain was enrolled in Outlook Live. After the Windows Live ID is imported into the Outlook Live domain, it is subject to the security and privacy policies of the organization.</descrip></descripGrp><ntig><termGrp><term id="1275551">EASI ID</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2299088">ایمیل بحیث شناسه ورود</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25872_1224272_2299321"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of validating data before it is processed. This validation helps detect and exclude some errors from the intended process, which might be the import or migration of users using a CSV file, for example.</descrip></descripGrp><ntig><termGrp><term id="1224272">preliminary data validation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2299321">معتبرسازی ابتدایی دیتا</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25873_1224273_2298936"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A DNS server that is responsible for the DNS records that are associated with a domain.</descrip></descripGrp><ntig><termGrp><term id="1224273">authoritative name server</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2298936">سرور اسم موثق ساز</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25884_1230078_1897950"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The year 2010 edition of the Microsoft spreadsheet software with tools for analyzing, charting, and communicating data.</descrip></descripGrp><ntig><termGrp><term id="1230078">Microsoft Excel 2010</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1897950">Microsoft Excel 2010</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25885_1230079_1897951"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The year 2010 edition of the Microsoft spreadsheet software, with tools for analyzing, charting, and communicating data, designed for home and students.</descrip></descripGrp><ntig><termGrp><term id="1230079"