ected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25890_1230093_1897955"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The total number of objects from the object cache that have been removed from memory by the garbage collector.</descrip></descripGrp><ntig><termGrp><term id="1230093">object cache GC count</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1897955">تعداد اشیاء حذف شده از حافظه</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25900_1509435_1657939"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The device that runs Windows Phone Operating System.</descrip></descripGrp><ntig><termGrp><term id="1509435">Windows Phone</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1657939">Windows Phone</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25900_2195811_1657939"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The device that runs Windows Phone Operating System.</descrip></descripGrp><ntig><termGrp><term id="2195811">WP</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1657939">Windows Phone</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25901_1231845_1527131"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The menu item on the Bing menu that links to http://www.bing.com/cashback/.</descrip></descripGrp><ntig><termGrp><term id="1231845">Cashback</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1527131">بازپرداخت نقدی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25902_1231846_1527165"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Web page object that assists users in finding both public (Web and Windows Live) and private (my Windows Live content) content for insertion into their authored content.</descrip></descripGrp><ntig><termGrp><term id="1231846">Quick add</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1527165">اضافه کردن سریع</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25903_1231847_1527141"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The link to the free online workspace for accessing, editing, and sharing Excel, Word, PowerPoint and OneNote documents across your PC, smartphone, and web browser.</descrip></descripGrp><ntig><termGrp><term id="1231847">Documents</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1527141">مدارک</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25904_1231848_1527127"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The link to bing.com in some regions but to a dropdown list of more Bing options in other regions.</descrip></descripGrp><ntig><termGrp><term id="1231848">Bing</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1527127">Bing</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25905_1231849_1527138"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Windows Mobile header link that opens a menu that contains more options.</descrip></descripGrp><ntig><termGrp><term id="1231849">Do more</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1527138">انجام کار های بیشتر</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25906_1231850_1527137"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The link to the website where customers add computers (both PCs and Macs), mobile phones, and digital photo frames so they can access their synced folders and connect remotely to their devices.</descrip></descripGrp><ntig><termGrp><term id="1231850">Devices</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1527137">دستگاه ها</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25907_1231852_1527133"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The link to the code of conduct, which contains rules that explain how someone should behave while using a service or product.</descrip></descripGrp><ntig><termGrp><term id="1231852">Code of Conduct</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1527133">اصول و مقررات سلوک</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25912_1231866_1796231"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The year 2010 edition of the Microsoft messaging and collaboration client software for personal computers accessing Microsoft Exchange Server-based email and collaboration services.</descrip></descripGrp><ntig><termGrp><term id="1231866">Microsoft Outlook 2010</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1796231">Microsoft Outlook 2010</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25917_1231890_1527167"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The link to photos that only you and people that you select can view (versus public photos that anyone can view).</descrip></descripGrp><ntig><termGrp><term id="1231890">Shared photos</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1527167">عکس های مشترک</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25918_1231891_1527170"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The link to the Microsoft service agreement.</descrip></descripGrp><ntig><termGrp><term id="1231891">Terms</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1527170">شرایط</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25919_1231893_1527161"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Windows Mobile footer link to the site that is built for viewing from a PC.</descrip></descripGrp><ntig><termGrp><term id="1231893">PC site</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1527161">سایت کمپیوتر</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25921_1231895_1527159"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Windows Mobile footer link to the site that is built for viewing from mobile devices.</descrip></descripGrp><ntig><termGrp><term id="1231895">Mobile site</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1527159">سایت موبایل</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25957_1245016_2298905"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Identity Lifecycle Manager management agent provided by Microsoft to connect to Active Directory Domain Services (AD DS) or Active Directory directory service.</descrip></descripGrp><ntig><termGrp><term id="1245016">Active Directory Management Agent</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2298905">نماینده مدیریت دایریکتوری فعال</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25957_1245016_2298913"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Identity Lifecycle Manager management agent provided by Microsoft to connect to Active Directory Domain Services (AD DS) or Active Directory directory service.</descrip></descripGrp><ntig><termGrp><term id="1245016">Active Directory Management Agent</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2298913">ADMA</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25957_1245017_2298905"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Identity Lifecycle Manager management agent provided by Microsoft to connect to Active Directory Domain Services (AD DS) or Active Directory directory service.</descrip></descripGrp><ntig><termGrp><term id="1245017">ADMA</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2298905">نماینده مدیریت دایریکتوری فعال</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25957_1245017_2298913"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Identity Lifecycle Manager management agent provided by Microsoft to connect to Active Directory Domain Services (AD DS) or Active Directory directory service.</descrip></descripGrp><ntig><termGrp><term id="1245017">ADMA</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2298913">ADMA</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25959_1247422_2299476"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mailbox folder structure on some IMAP servers in which mail folders are accessed with the administrator username and password, and shell login access to the mail server is not allowed. Access to specific mailboxes is managed by access control lists. This means that users are assigned the permissions to only access their mailbox folder, while an administrator has access to all mailboxes. This allows organizations to use administrative credentials to migrate email from an IMAP server to Outlook Live.</descrip></descripGrp><ntig><termGrp><term id="1247422">virtual shared folder</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2299476">دوسیه شریک شده مجازی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25978_1251313_2299099"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To place a windows Live ID in a forced rename state, while the Windows Live ID and all of its existing settings, including the password, Xbox Live points, or Zune points are preserved. The user can sign in using the Windows Live ID and its password, but they're immediately asked to rename the Windows Live ID. They must specify an email address that's outside the Outlook Live domain.</descrip></descripGrp><ntig><termGrp><term id="1251313">evict</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2299099">اجبار کردن</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25979_1253307_1531156"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The service in Microsoft Sharepoint Foundation that needs to be started to allow for a sandboxed solution to be deployed.</descrip></descripGrp><ntig><termGrp><term id="1253307">Sandboxed Code Service</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1531156">خدمات کود جعبۀ ریگی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25979_1253307_1898039"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The service in Microsoft Sharepoint Foundation that needs to be started to allow for a sandboxed solution to be deployed.</descrip></descripGrp><ntig><termGrp><term id="1253307">Sandboxed Code Service</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1898039">Microsoft SharePoint Foundation Sandboxed Code Service</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25979_1496238_1531156"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The service in Microsoft Sharepoint Foundation that needs to be started to allow for a sandboxed solution to be deployed.</descrip></descripGrp><ntig><termGrp><term id="1496238">Microsoft SharePoint Foundation Sandboxed Code Service</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1531156">خدمات کود جعبۀ ریگی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25979_1496238_1898039"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The service in Microsoft Sharepoint Foundation that needs to be started to allow for a sandboxed solution to be deployed.</descrip></descripGrp><ntig><termGrp><term id="1496238">Microsoft SharePoint Foundation Sandboxed Code Service</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1898039">Microsoft SharePoint Foundation Sandboxed Code Service</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termG