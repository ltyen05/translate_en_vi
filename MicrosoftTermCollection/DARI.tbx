oun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29180_1506766_1898112"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An alternate name for a managed property.</descrip></descripGrp><ntig><termGrp><term id="1506766">managed property alias</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1898112">اسم مستعار خصوصیت اداره شده</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29181_1506767_1898113"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An integer value that defines the order in which crawl properties are mapped to managed properties. The value of a mapping order is unique for each managed property; no two mappings for the same managed property have the same mapping order value.</descrip></descripGrp><ntig><termGrp><term id="1506767">mapping order</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1898113">ترتیب نقشه برداری</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29182_1506768_1898114"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of data for a meeting that occurs only once or a single occurrence of a meeting that occurs multiple times. The data can be stored in a client application or on a Web site.</descrip></descripGrp><ntig><termGrp><term id="1506768">meeting instance</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1898114">مثال جلسه</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29183_1506769_1898115"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A qualified domain name, such as domain.corp.microsoft.com, that identifies the source of a member group.</descrip></descripGrp><ntig><termGrp><term id="1506769">member group source</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1898115">منبع گروه عضو</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29184_1506770_1531126"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A default group of users on a SharePoint site. By default, the Members group is assigned the Contribute permission level.</descrip></descripGrp><ntig><termGrp><term id="1506770">Members group</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1531126">گروه اعضا</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammatic