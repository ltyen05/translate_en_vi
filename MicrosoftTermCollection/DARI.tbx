rmNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3317_62295_2412745"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To provide services (often using a server) to client computers that connect from remote locations, for example, to offer Internet access or to be the source for a news or mail service.</descrip></descripGrp><ntig><termGrp><term id="62295">host</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2412745">ميزبانی کردن</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33272_1764210_1769894"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The version of software that's distributed to manufacturers to build into hardware they will make available when the final software is made generally available.</descrip></descripGrp><ntig><termGrp><term id="1764210">RTM</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1769894">منتشر برای تولید</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33272_1764519_1769894"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The version of software that's distributed to manufacturers to build into hardware they will make available when the final software is made generally available.</descrip></descripGrp><ntig><termGrp><term id="1764519">Release to Manufacturing</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1769894">منتشر برای تولید</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33276_1764505_1769893"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To reset a system using a method that restores PC settings to defaults but retains a user's files and personalization touches.</descrip></descripGrp><ntig><termGrp><term id="1764505">refresh your PC</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1769893">کامپیوتر خویش را تازه نمایید</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33278_1764509_1769897"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To reset a system so that all user customizations are removed.</descrip></descripGrp><ntig><termGrp><term id="1764509">reset your PC</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1769897">کامپیوتر خویش را تنظیم مجدد نمایید</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></ter