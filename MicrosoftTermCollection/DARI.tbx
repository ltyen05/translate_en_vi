<descripGrp><descrip type="definition">The category of apps or games that are selected based on downloads, usage, and revenue over a 7-day period and ranks them according to those metrics.</descrip></descripGrp><ntig><termGrp><term id="2358041">Most popular</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2360202">پرطرفدارترین</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40633_2358042_2360201"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The category for items that are in the top 1000 items based on sales.</descrip></descripGrp><ntig><termGrp><term id="2358042">Best selling</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2360201">با بهترین فروشات</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40652_2358625_2360205"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The view of a particular contact within the People app that shows all your past communication, upcoming meetings, status updates, and files you share with that person. ​</descrip></descripGrp><ntig><termGrp><term id="2358625">Timeline</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2360205">خط زمانی</term><termNot