92508_2517689"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Project work management app that helps a team create new plans, organize and assign work, share files, discuss team activity, and get updates on progress.</descrip></descripGrp><ntig><termGrp><term id="2392508">Planner</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2517689">Planner</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40618_2393978_2517689"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Project work management app that helps a team create new plans, organize and assign work, share files, discuss team activity, and get updates on progress.</descrip></descripGrp><ntig><termGrp><term id="2393978">Microsoft Planner</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2517689">Planner</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40619_2357847_2366963"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The drop-down menu that gives users the option of filtering messages in their inbox by “Unread” or “Flagged” items.</descrip></descripGrp><ntig><termGrp><term id="2357847">Quick Filters for message list</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></t