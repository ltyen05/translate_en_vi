icalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2156882">جستجو</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37477_2139117_2156878"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The button in the History pane used to restore the current document to an earlier version</descrip></descripGrp><ntig><termGrp><term id="2139117">Restore this version</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2156878">دوباره برگردانیدن این نسخه</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37480_2139120_2258076"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of different visualization patterns and interactions for content shown in Sway.</descrip></descripGrp><ntig><termGrp><term id="2139120">card</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2258076">کارت</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37481_2139121_2258087"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Sway card that allows the user to select o