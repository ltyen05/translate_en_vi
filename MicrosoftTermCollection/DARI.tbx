n operating system, directory service, or distributed system. For example, in Windows® integrated authentication, a login name uses the form "DOMAIN\username."</descrip></descripGrp><ntig><termGrp><term id="76690">login ID</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1531121">اسم ورودی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9275_237771_2298961"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of column that displays the results of mathematical or logical operations or expressions instead of stored data.</descrip></descripGrp><ntig><termGrp><term id="237771">calculated column</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2298961">ستون محاسبه شده</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9278_318317_1498912"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An audio CD that contains both audio and other multimedia content.</descrip></descripGrp><ntig><termGrp><term id="318317">enhanced audio CD</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1498912">سی دی صوتی ارتقأ یافته</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="928_177550_2299482"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Windows Server 2003 technology that supports creation of single point-in-time shadow copies - also known as snapshots - of single or multiple volumes without impacting file server performance. Volume Shadow Copy Service also supports backups of open files.</descrip></descripGrp><ntig><termGrp><term id="177550">Volume Shadow Copy Service</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2299482">سرویس کاپی سایه حجمی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="928_177551_2299482"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Windows Server 2003 technology that supports creation of single point-in-time shadow copies - also known as snapshots - of single or multiple volumes without impacting file server performance. Volume Shadow Copy Service also supports backups of open files.</descrip></descripGrp><ntig><termGrp><term id="177551">VSS</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2299482">سرویس کاپی سایه حجمی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9284_21852_1498701"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The speed at which binary digits are transmitted.</descrip></descripGrp><ntig><termGrp><term id="21852">bit rate</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1498701">میزان بت</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9284_21853_1498701"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The speed at which binary digits are transmitted.</descrip></descripGrp><ntig><termGrp><term id="21853">bitrate</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1498701">میزان بت</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9287_237916_1897525"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A flowchart used to compare current and ideal processes, and to understand how the steps in a process work together.</descrip></descripGrp><ntig><termGrp><term id="237916">TQM diagram</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1897525">دیاگرام TQM</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9287_237917_1897525"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A flowchart used to compare current and ideal processes, and to understand how the steps in a process work together.</descrip></descripGrp><ntig><termGrp><term id="237917">Total Quality Management diagram</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1897525">دیاگرام TQM</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="929_184163_1897411"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An interface in which the user can select and set styles for certain elements on the page.</descrip></descripGrp><ntig><termGrp><term id="184163">style picker</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1897411">انتخاب کننده سبک</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9295_93713_1651911"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To change a program in order to be able to run it on a different platform.</descrip></descripGrp><ntig><termGrp><term id="93713">port</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1651911">درگاه</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9299_237015_1498678"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows you to set up your computer so that when you insert a device or media, it will play automatically and you won't have to select your preferences every time.</descrip></descripGrp><ntig><termGrp><term id="237015">AutoPlay</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1498678">خود پخش</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="93_148267_2725338"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A page where users can search for other pages on the Internet or intranet and then go to the searched for page.</descrip></descripGrp><ntig><termGrp><term id="148267">search page</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2725338">صفحه جستجو</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9304_85837_1354556"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A list in which each item or block of text is preceded by a number.</descrip></descripGrp><ntig><termGrp><term id="85837">numbered list</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1354556">لیست شماره دار</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9305_232851_1499455"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A document area that contains a range of text distinct from other areas of text in a document. For example, if a document includes body text, footnotes, and headers, it contains a main text story, footnotes story, and headers story.</descrip></descripGrp><ntig><termGrp><term id="232851">story</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1499455">شرح</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9308_397142_1354494"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An authentication method that prompts the user for a user name and a password, also called credentials, which are hashed with other data before being transmitted over the network. Digest authentication is available only on domains that have domain controllers that are running Microsoft Windows Server operating systems.</descrip></descripGrp><ntig><termGrp><term id="397142">Digest authentication</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1354494">تصدیق digest</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="931_91234_2299301"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A private telephone network in an organization. Individual telephone numbers or extension numbers are supported, and calls are automatically routed to them. Users can call each other using extensions. They can also place calls to outside numbers.</descrip></descripGrp><ntig><termGrp><term id="91234">PBX</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2299301">PBX</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="931_91235_2299301"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A private telephone network in an organization. Individual telephone numbers or extension numbers are supported, and calls are automatically routed to them. Users can call each other using extensions. They can also place calls to outside numbers.</descrip></descripGrp><ntig><termGrp><term id="91235">Private Branch Exchange</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2299301">PBX</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9314_294464_1499252"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Personal configurations of a program or operating system.</descrip></descripGrp><ntig><termGrp><term id="294464">personal settings</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1499252">تنظیمات شخصی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9318_361628_1354619"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The main rule for a site that includes or excludes content from the content index.</descrip></descripGrp><ntig><termGrp><term id="361628">site restriction</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1354619">ممنوعیت سایت</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9324_117057_1499462"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A text file containing code to apply semantics such as page layout specifications to published content.</descrip></descripGrp><ntig><termGrp><term id="117057">style sheet</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1499462">ورقۀ شیوه</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9325_232852_1505963"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A vertical area along the left edge of the document window that displays the name of the paragraph style that is applied to each paragraph.</descrip></descripGrp><ntig><termGrp><term id="232852">style area</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1505963">ناحیۀ شیوه</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9332_210450_1897428"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The formal name for Excel 12 file format. The Excel XML Format has an open, royalty-free specification, and is the technology licensed to external parties.</descrip></descripGrp><ntig><termGrp><term id="210450">Excel XML Format</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1897428">قالب Excel XML</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9334_397201_2299216"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of object that has an email address on a domain in the organization, but the object does not have a mailbox in the domain at which to receive messages. The object appears in the global address list, which allows other people in the organization to easily locate or send a message to that person, but the administrator does not need to manage an unnecessary mailbox. Contacts, users, and even folders can be mail-enabled.</descrip></descripGrp><ntig><termGrp><term id="397201">mail-enabled object</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2299216">شیی با ایمیل فعال</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9336_119369_1499487"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A database object that stores data in records (rows) and fields (columns). The data is usually about a particular category of things, such as employees or orders.</descrip></descripGrp><ntig><termGrp><term id="119369">table</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1499487">جدول</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="934_76743_1499142"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A distinctive symbol that identifies a person, business, or organization.</descrip></descripGrp><ntig><termGrp><term id="76743">logo</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1499142">لوگو</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9355_309006_1499169"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The legal agreement between Microsoft and the user, with regard to the terms of use and transfer of software.</descrip></descripGrp><ntig><termGrp><term id="309006">Microsoft Software License Terms</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1499169">شرایط مجوز نرم افزار Microsoft</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9375_85176_1505964"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">For local area networks (LANs), a device that is connected to the network and is capable of communicating with other network devices.</descrip></descripGrp><ntig><termGrp><term id="85176">node</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1505964">نقطۀ تسلسل</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="938_584283_2299402"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A bar chart subtype that shows the relationship of individual items to the whole.</descrip></descripGrp><ntig><termGrp><term id="584283">stacked bar chart</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2299402">گراف میله یی انباشته</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9386_105576_2701077"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A server-based user profile that is downloaded to the local computer when a user logs on and that is updated both locally and on the server when the user logs off.</descrip></descripGrp><ntig><termGrp><term id="105576">roaming user profile</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2701077">نمایۀ رومینگ استفاده کننده</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9386_503125_2701077"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A server-based user profile that is downloaded to the local computer when a user logs on and that is updated both locally and on the server when the user logs off.</descrip></descripGrp><ntig><termGrp><term id="503125">roaming profile</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2701077">نمایۀ رومینگ استفاده کننده</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="gramm