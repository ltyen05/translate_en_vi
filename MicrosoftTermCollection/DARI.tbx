essage that appears at a specified interval before an appointment, meeting, or task that announces when the activity is set to occur.</descrip></descripGrp><ntig><termGrp><term id="232415">reminder</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1499332">تذکر دهنده</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22992_1056886_1499185"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A real-time, physical action applied to an object, in which multiple contact points are used simultaneously.</descrip></descripGrp><ntig><termGrp><term id="1056886">multitouch</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1499185">لمس-چندگانه</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22992_1056887_1499185"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A real-time, physical action applied to an object, in which multiple contact points are used simultaneously.</descrip></descripGrp><ntig><termGrp><term id="1056887">multi-touch</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1499185">لمس-چندگانه</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="g