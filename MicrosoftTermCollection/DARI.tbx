raphicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20543_760171_2281184"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Internet Explorer feature that allows users to surf the Web without leaving a browsing history, cookies or other information on the PC so they can do online banking on a shared computer, for example.</descrip></descripGrp><ntig><termGrp><term id="760171">InPrivate</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2281184">InPrivate</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20560_725996_1769903"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The service for wireless products that allows users to send and receive brief messages consisting of text and numbers to and from mobile phones and devices.</descrip></descripGrp><ntig><termGrp><term id="725996">SMS</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1769903">اس ام اس</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20595_726386_2021187"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A virtual community that provides people with opportunities to interact (via blogs, chats, newsgroups, webcasts, user groups, and forums) with Microsoft employees, experts, and peers in order to share knowledge and news about Microsoft technology.</descrip></descripGrp><ntig><termGrp><term id="726386">Microsoft community</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2021187">جامعه Microsoft</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20602_727015_2327542"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A calendar view that displays all scheduled items.</descrip></descripGrp><ntig><termGrp><term id="727015">Agenda view</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2327542">نمای لست کارها</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20606_727019_1954772"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An alert that is set by the user to be activated at a particular time.</descrip></descripGrp><ntig><termGrp><term id="727019">alarm</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1954772">زنگ ساعت</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20613_727416_1499501"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A renamed .cab file which contains a .theme file, and optionally one or more desktop backgrounds, icons, mouse pointer files, and sound files. It does not contain executables or screen savers.</descrip></descripGrp><ntig><termGrp><term id="727416">theme pack</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1499501">بستۀ طرح زمینه</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20613_727417_1499501"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A renamed .cab file which contains a .theme file, and optionally one or more desktop backgrounds, icons, mouse pointer files, and sound files. It does not contain executables or screen savers.</descrip></descripGrp><ntig><termGrp><term id="727417">.themepack file</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1499501">بستۀ طرح زمینه</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2062_2793271_2793847"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that displays the identity of the originator of an incoming call on the device screen.</descrip></descripGrp><ntig><termGrp><term id="2793271">caller identification</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2793847">هویت تماس گیرنده</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2062_2793271_2793849"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that displays the identity of the originator of an incoming call on the device screen.</descrip></descripGrp><ntig><termGrp><term id="2793271">caller identification</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2793849">شناسایی تماس گیرنده</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2062_334551_2793847"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that displays the identity of the originator of an incoming call on the device screen.</descrip></descripGrp><ntig><termGrp><term id="334551">caller ID</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2793847">هویت تماس گیرنده</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2062_334551_2793849"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that displays the identity of the originator of an incoming call on the device screen.</descrip></descripGrp><ntig><termGrp><term id="334551">caller ID</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2793849">شناسایی تماس گیرنده</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20621_727658_2701060"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A certificate that identifies the certification authority (CA) that issues server and client authentication certificates to the servers and clients that request these certificates.</descrip></descripGrp><ntig><termGrp><term id="727658">CA certificate</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2701060">تصدیق CA</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20621_727659_2701060"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A certificate that identifies the certification authority (CA) that issues server and client authentication certificates to the servers and clients that request these certificates.</descrip></descripGrp><ntig><termGrp><term id="727659">signature certificate</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2701060">تصدیق CA</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20621_748022_2701060"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A certificate that identifies the certification authority (CA) that issues server and client authentication certificates to the servers and clients that request these certificates.</descrip></descripGrp><ntig><termGrp><term id="748022">site certificate</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2701060">تصدیق CA</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20653_730882_1780803"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A folder that stores the user's graphics, e.g. digital pictures. Many graphic design and photo-editing programs use this location by default to open or save graphic files.</descrip></descripGrp><ntig><termGrp><term id="730882">Pictures</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1780803">تصاویر</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20655_732027_1897727"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A button that replaces the File menu beginning with some 2007 Microsoft Office system programs.</descrip></descripGrp><ntig><termGrp><term id="732027">Microsoft Office Button</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1897727">دکمۀ Office</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20655_732027_1953841"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A button that replaces the File menu beginning with some 2007 Microsoft Office system programs.</descrip></descripGrp><ntig><termGrp><term id="732027">Microsoft Office Button</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1953841">دکمه Microsoft Office</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20655_747784_1897727"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A button that replaces the File menu beginning with some 2007 Microsoft Office system programs.</descrip></descripGrp><ntig><termGrp><term id="747784">Office Button</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1897727">دکمۀ Office</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20655_747784_1953841"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A button that replaces the File menu beginning with some 2007 Microsoft Office system programs.</descrip></descripGrp><ntig><termGrp><term id="747784">Office Button</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1953841">دکمه Microsoft Office</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20673_741964_2299356"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mailbox that represents conference rooms and company equipment. Resource mailboxes can be included as resources in meeting requests, providing a simple and efficient way to utilize resources for an organization. The user account that is associated with a resource mailbox is disabled.</descrip></descripGrp><ntig><termGrp><term id="741964">resource mailbox</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2299356">صندوق پستی منبع</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20675_743746_2314655"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To monitor an email conversation or newsgroup thread. The headers for messages in a watched conversation appear in a different color, which makes them easier to find in a message list.</descrip></descripGrp><ntig><termGrp><term id="743746">watch</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2314655">تماشا</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20683_745706_1498809"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An option on the Views menu in File Explorer that shows the most appropriate details for the file type in a flexible layout rather than only showing the details associated with the column headers in the view.</descrip></descripGrp><ntig><termGrp><term id="745706">Content</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1498809">محتوا</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20689_2356132_2360204"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature in Control Panel that provides the user with a single point of entry for tasks and notifications related to security and general PC software maintenance.</descrip></descripGrp><ntig><termGrp><term id="2356132">Security and Maintenance</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2360204">امنیت و حفظ و مراقبت</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20695_746372_1897725"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A gallery that allows users to create a quick rule to move mail to a selected folder based on the sender, recipients, or conversation of the currently selected email message without opening the full Create Rule dialog.</descrip></descripGrp><ntig><termGrp><term id="746372">Always Move gallery</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1897725">گالری انتقال دائم</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20697_777440_1499018"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of computers on a home network that can share pictures, music, videos, documents, and printers. A homegroup is created by using the HomeGroup feature; it is protected with a password.</descrip></descripGrp><ntig><termGrp><term id="777440">homegroup</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1499018">گروه خانگی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20698_782774_1499021"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A password that helps prevent unauthorized access to homegroup files and printers.</descrip></descripGrp><ntig><termGrp><term id="782774">homegroup password</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1499021">رمزعبور گروه خانگی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20703_746420_1498762"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An action that removes redundant messages from an email conversation to reduce information overload and improve readability.</descrip></descripGrp><ntig><termGrp><term id="746420">Clean Up</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1498762">پاکسازی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20704_746421_1506215"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A fork within a conversation, where more than one reply was made to a single email and caused a split in the conversation.</descrip></descripGrp><ntig><termGrp><term id="746421">branch</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1506215">شاخه</term><