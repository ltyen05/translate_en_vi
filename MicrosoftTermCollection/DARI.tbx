hat takes advantage of partial pixels to make text appear sharper on the screen.</descrip></descripGrp><ntig><termGrp><term id="1632109">subpixel rendering</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1898335">موقعیت دهی کوچکتر از پیکسل</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3206_231966_1505779"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A bar at the top of the Excel window that you use to enter or edit values or formulas in cells or charts. Displays the constant value or formula stored in the active cell.</descrip></descripGrp><ntig><termGrp><term id="231966">formula bar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1505779">نوار فورمول</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32061_1632111_1898336"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of XML mapping that links WordprocessingML content directly to the backing data in the custom XML part.</descrip></descripGrp><ntig><termGrp><term id="1632111">rich text XML mapping</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1898336">نگاشت XML متن غنی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfS