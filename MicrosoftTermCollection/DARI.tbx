Note></termGrp></ntig></langSet></termEntry><termEntry id="37316_2114593_2194582"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The folder above the current folder in the folder hierarchy. For example, C:\Shares is the parent folder of C:\Shares\public.</descrip></descripGrp><ntig><termGrp><term id="2114593">parent folder</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2194582">دوسیه اصلی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37317_2114594_2194584"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The location of a user's profile on the local drive, for example C:\Users\jason. The user profile could be a local profile, which is stored on a single computer, or a roaming user profile, which is synchronized with a file server so that multiple PCs can use the same profile settings.</descrip></descripGrp><ntig><termGrp><term id="2114594">profile path</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2194584">مسیر پروفایل</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37324_2116468_2139367"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft service that provides fonts on demand to Microsoft applications, eliminating the need for any fonts to be shipped with those applications.</descrip></descripGrp><ntig><termGrp><term id="2116468">Microsoft Fonts Online</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2139367">Microsoft Fonts Online</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37325_2116471_2139372"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A handle that appears on objects or text insertion points when a user taps on them making selection easier.</descrip></descripGrp><ntig><termGrp><term id="2116471">selection handle</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2139372">دستگیر انتخاب</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37332_2119511_2139365"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The command that appears in both email and UX that allows users to put folders in their OneDrive list and allows them to sync those folders offline.</descrip></descripGrp><ntig><termGrp><term id="2119511">Add to my OneDrive</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2139365">اضافه کردن به OneDrive من</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNot