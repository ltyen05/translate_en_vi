utomation of system administration tasks across multiple platforms.</descrip></descripGrp><ntig><termGrp><term id="2353123">PowerShell Core</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2353722">PowerShell Core</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40511_2353386_2354213"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The group of add-ons for Office 2016 that includes one or more of the following: proofing tools, an LIP, a language pack, and/or a spellchecker.</descrip></descripGrp><ntig><termGrp><term id="2353386">Office 2016 Language Accessory Pack</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2354213">Office 2016 Language Accessory Pack</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40523_2354097_2355393"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Big Data Analysis Generic Enabler reference implementation (GEri) intended to deploy means for analyzing both batch and stream data and get insights on such a data.</descrip></descripGrp><ntig><termGrp><term id="2354097">Cosmos</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2355393">Cosmos</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40524_2354098_2355396"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A query expressed in the native SQL dialect of the database of choice.</descrip></descripGrp><ntig><termGrp><term id="2354098">native database query</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2355396">جستار دیتابیس بومی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40524_2354098_2355397"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A query expressed in the native SQL dialect of the database of choice.</descrip></descripGrp><ntig><termGrp><term id="2354098">native database query</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2355397">جستار بومی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40524_2354101_2355396"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A query expressed in the native SQL dialect of the database of choice.</descrip></descripGrp><ntig><termGrp><term id="2354101">native query</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2355396">جستار دیتابیس بومی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40524_2354101_2355397"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A query expressed in the native SQL dialect of the database of choice.</descrip></descripGrp><ntig><termGrp><term id="2354101">native query</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2355397">جستار بومی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4055_21561_1498700"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The smallest unit of information handled by a computer or device. One bit expresses a 1 or a 0 in a binary numeral, or a true or false logical condition. A group of 8 bits makes up a byte, which can represent many types of information, such as a letter of the alphabet, a decimal digit, or other character.</descrip></descripGrp><ntig><termGrp><term id="21561">bit</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1498700">بت</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4055_21562_1498700"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The smallest unit of information handled by a computer or device. One bit expresses a 1 or a 0 in a binary numeral, or a true or false logical condition. A group of 8 bits makes up a byte, which can represent many types of information, such as a letter of the alphabet, a decimal digit, or other character.</descrip></descripGrp><ntig><termGrp><term id="21562">binary digit</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1498700">بت</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4059_124417_1897240"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file (or component within another file) that contains Automation standard descriptions of exposed objects, properties, and methods.</descrip></descripGrp><ntig><termGrp><term id="124417">type library</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1897240">کتابخانه نوع</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="406_22638_2298951"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A portion of content within an email or Internet newsgroups, that follows the header and contains the content of the message.</descrip></descripGrp><ntig><termGrp><term id="22638">body</term><termNote type="partOfSpeech">Noun</termNote