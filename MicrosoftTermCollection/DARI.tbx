="prs-AF"><ntig><termGrp><term id="1498822">اعتبارنامه</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12369_2749763_1987676"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Information that includes identification and proof of identification that is used to gain access to local and network resources.</descrip></descripGrp><ntig><termGrp><term id="2749763">credential</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1987676">معلومات ورود</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12369_606_1498822"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Information that includes identification and proof of identification that is used to gain access to local and network resources.</descrip></descripGrp><ntig><termGrp><term id="606">credentials</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1498822">اعتبارنامه</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12369_606_1987676"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Information that includes identification and proof of identification that is used to gain access to local and network resources.</descrip></descripGrp><ntig><termGrp><term id="606">credentials</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1987676">معلومات ورود</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12370_17867_1506055"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The technology that is based on the Component Object Model (COM) that enables interoperability among ActiveX components, including OLE components. Formerly referred to as OLE Automation.</descrip></descripGrp><ntig><termGrp><term id="17867">Automation</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1506055">خودکاری</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12381_121120_1506056"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that consists of advanced text wrap functionality, allowing the user to select from various styles to specify how text flows around objects or graphics in a document.</descrip></descripGrp><ntig><termGrp><term id="121120">text wrapping</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1506056">سطر بندی کردن نوشته</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12383_63110_1506057"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of breaking a word between syllables at the end of a line or to separate the parts of a compound word.</descrip></descripGrp><ntig><termGrp><term id="63110">hyphenation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1506057">خط تیره زدن</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12386_46887_2299058"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A 32-bit integer that identifies a property set.</descrip></descripGrp><ntig><termGrp><term id="46887">dispatch ID</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2299058">شناسه ارسال</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12387_262437_1506058"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An encryption algorithm that uses a 56-bit key and maps a 64-bit input block to a 64-bit output block. The key appears to be a 64-bit key, but one bit in each of the eight bytes is used for odd parity, resulting in 56 bits of usable key.</descrip></descripGrp><ntig><termGrp><term id="262437">Data Encryption Standard</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1506058">DES</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12387_262438_1506058"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An encryption algorithm that uses a 56-bit key and maps a 64-bit input block to a 64-bit output block. The key appears to be a 64-bit key, but one bit in each of the eight bytes is used for odd parity, resulting in 56 bits of usable key.</descrip></descripGrp><ntig><termGrp><term id="262438">DES</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1506058">DES</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1239_25547_1977641"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The indication that the phone is busy.</descrip></descripGrp><ntig><termGrp><term id="25547">busy signal</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1977641">علامت مصروف</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12395_231972_1897460"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Total values for all cells in a row or all cells in a column of a PivotTable report. Values in a grand total row or column are calculated by using the same summary function used in the data area of the PivotTable report.</descrip></descripGrp><ntig><termGrp><term id="231972">PivotTable grand totals</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1897460">مجموع کل PivotTable</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="124_53143_1498933"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The inability of a computer system or related device to operate reliably or to operate at all.</descrip></descripGrp><ntig><termGrp><term id="53143">failure</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1498933">ناکامی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12405_184041_1897404"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mode that enables the user to move a document by dragging it. Panning mode is available when a Word document is displayed on a preview pane.</descrip></descripGrp><ntig><termGrp><term id="184041">panning mode</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1897404">حالت جابجایی سند</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1241_31081_2298972"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A calculated value that is used to test data for the presence of errors that can occur when data is transmitted or when it is written to disk. The checksum is calculated for a given chunk of data by sequentially combining all the bytes of data with a series of arithmetic or logical operations. After the data is transmitted or stored, a new checksum is calculated in the same way using the (possibly faulty) transmitted or stored data. If the two checksums do not match, an error has occurred, and the data should be transmitted or stored again. Checksums cannot detect all errors, and they cannot be used to correct erroneous data.</descrip></descripGrp><ntig><termGrp><term id="31081">checksum</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2298972">مجموعی مقایسوی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12412_1056070_2299355"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A calendaring feature that automatically manages resources. Resource requests are automatically accepted or denied depending on availability and policies.</descrip></descripGrp><ntig><termGrp><term id="1056070">Booking Attendant</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2299355">اشتراک کننده رزرو منبع</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12412_307447_2299355"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A calendaring feature that automatically manages resources. Resource requests are automatically accepted or denied depending on availability and policies.</descrip></descripGrp><ntig><termGrp><term id="307447">Resource Booking Attendant</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2299355">اشتراک کننده رزرو منبع</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12413_1484549_1354469"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of ad click that follows a hyperlink to another Web site, or a page or frame within the initial Web site.</descrip></descripGrp><ntig><termGrp><term id="1484549">click-through</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1354469">عبور با کلیک</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12413_32342_1354469"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of ad click that follows a hyperlink to another Web site, or a page or frame within the initial Web site.</descrip></descripGrp><ntig><termGrp><term id="32342">clickthrough</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1354469">عبور با کلیک</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12414_237907_1897523"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of block diagram that contains 3-D geometric shapes, directional lines, and a vanishing point for changing depth and perspective. Use for functional decomposition, hierarchical, and data structure diagrams.</descrip></descripGrp><ntig><termGrp><term id="237907">block diagram with perspective</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1897523">دیاگرام بلوکی با دیدگاه</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12419_237283_1897508"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An enhanced spell-check feature that looks at words before or after the word in question to assess proper usage. This allows the software to flag correctly-spelled words as 'wrong' if the usage appears to be incorrect.</descrip></descripGrp><ntig><termGrp><term id="237283">Contextual Spelling</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1897508">املای محتوا</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12434_231840_2327589"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To remove unread markers from specified elements in the workspace.</descrip></descripGrp><ntig><termGrp><term id="231840">mark read</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2327589">علامت گذاری بحیث خوانده شده</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12437_265122_1354589"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">HTML that includes markup for formatting such as backgrounds, borders, text fonts, styles and colors.</descrip></descripGrp><ntig><termGrp><term id="265122">rich HTML</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1354589">HTML غنی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1244_128141_1897241"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A number assigned by a software developer to identify a particular program at a particular stage, before and after public release. Successive public releases of a program are assigned increasingly higher numbers. Version numbers usually include decimal fractions. Major changes are usually marked by a change in the whole number, whereas for minor changes only the number after the decimal point increases.</descrip></descripGrp><ntig><termGrp><term id="128141">version number</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1897241">شمارۀ نسخه</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12442_155338_1506059"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of extensions to the Hypertext Transfer Protocol (HTTP) that facilitates collaborative editing and file management between users located remotely from each other on the Internet.</descrip></descripGrp><ntig><termGrp><term id="155338">Web Distributed Authoring and Versioning</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1506059">WebDAV</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12442_155338_1897375"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of extensions to the Hypertext Transfer Protocol (HTTP) that facilitates collaborative editing and file management between users located remotely from each other on the Internet.</des