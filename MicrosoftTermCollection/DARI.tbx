lang="en-US"><descripGrp><descrip type="definition">An address similar to a URL that provides network access to an event, such as a live broadcast. Attendees go to this address to view the event from their computers.</descrip></descripGrp><ntig><termGrp><term id="650877">event address</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1506177">آدرس رویداد</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18525_650879_1796214"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A text string that unambiguously refers to a hardware or software component under a certain context and can be used to access the data in that component.</descrip></descripGrp><ntig><termGrp><term id="650879">identifier</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1796214">شناسایی کننده</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18529_650883_1505086"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Data that is stored outside of the application that is currently in use.</descrip></descripGrp><ntig><termGrp><term id="650883">external data</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1505086">دادۀ خارجی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18530_650884_1506178"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A range of data that is brought into a worksheet but that originates outside of Excel, such as in a database or text file.</descrip></descripGrp><ntig><termGrp><term id="650884">external data range</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1506178">محدودۀ داده خارجی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18535_650889_1897668"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A pane located on top of the Navigation Pane that has copies of your Inbox, Sent Items, and so on. You can add, remove, and arrange folders in this pane. Collapse or expand the pane by clicking the arrow in the Favorite Folders header.</descrip></descripGrp><ntig><termGrp><term id="650889">Favorite Folders</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1897668">دوسیه های دلخواه</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18536_650890_1506179"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A button that identifies a field in a PivotTable or PivotChart report. You can drag the field buttons to change the layout of the report, or click the arrows next to the buttons to change the level of detail displayed in the report.</descrip></descripGrp><ntig><termGrp><term id="650890">field button</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1506179">دکمۀ میدان</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18538_650892_1506180"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The part of PivotTable or PivotChart view that contains filter fields.</descrip></descripGrp><ntig><termGrp><term id="650892">filter area</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1506180">ناحیۀ تصفیه</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18539_650893_1505087"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A field in the filter area that you can use to filter data displayed in PivotTable or PivotChart view. Filter fields perform the same functions as page fields in Microsoft Excel PivotTable reports.</descrip></descripGrp><ntig><termGrp><term id="650893">filter field</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1505087">میدان تصفیه</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18541_650895_1897669"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In a statechart or activity diagram, a representation of the completion of activity in the enclosing state or action state. The final state is indicated by a bull's eye.</descrip></descripGrp><ntig><termGrp><term id="650895">final state</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1897669">وضعیت نهایی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18542_650896_1506181"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The date that a project or task is scheduled to be completed. This date is based on the task's start date, duration, calendars, predecessor dates, task dependencies, and constraints.</descrip></descripGrp><ntig><termGrp><term id="650896">finish date</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1506181">تاریخ ختم</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18549_650903_1506182"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Internet Web page or intranet page that is associated with an Outlook folder. If a page has been associated with the folder and the option is set, the Web page appears in the Outlook window whenever you select the folder.</descrip></descripGrp><ntig><termGrp><term id="650903">folder home page</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1506182">صحفۀ خانگی دوسیه</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1855_307383_1505743"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of validating software with the manufacturer. Activation confirms the genuine status of a product and that the product key has not been compromised. It establishes a relationship between the software’s product key and a particular installation of that software on a device.</descrip></descripGrp><ntig><termGrp><term id="307383">activation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1505743">فعال سازی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18551_650905_1897670"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A location on a computer's hard drive to store a local copy of a form to improve performance when opening a form subsequent times.</descrip></descripGrp><ntig><termGrp><term id="650905">forms cache</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1897670">حافظه نهان فورمه ها</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18558_650912_1506183"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method to find a specific value for a cell by adjusting the value of one other cell. When goal seeking, Excel varies the value in a cell that you specify until a formula that's dependent on that cell returns the result you want.</descrip></descripGrp><ntig><termGrp><term id="650912">goal seek</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1506183">جستجوی هدف</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18559_650913_1796213"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A rank or category assigned to a material resource that denotes functional use but not level of quality. A low-grade resource is not necessarily a low-quality resource.</descrip></descripGrp><ntig><termGrp><term id="650913">grade</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1796213">دسته</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1856_52994_1897183"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Expressed as n! (n factorial), the result of multiplying the successive integers from 1 through n; n! equals n x (n - 1) x (n - 2) x ... x 1.</descrip></descripGrp><ntig><termGrp><term id="52994">factorial</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1897183">مضروب</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18560_650914_1506184"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The faint vertical and horizontal lines that appear in the drawing window when the grid is turned on. You can use grid lines to help position shapes precisely.</descrip></descripGrp><ntig><termGrp><term id="650914">grid lines</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1506184">خطوط رشته ای</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18561_650915_1506185"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The point that defines the layout of grid lines on the drawing page. A vertical grid line and a horizontal grid line pass through the grid origin, and all other grid lines are drawn at specified intervals from these reference lines.</descrip></descripGrp><ntig><termGrp><term id="650915">grid origin</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1506185">اساس رشته ای</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1858_128261_1505744"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The | character.</descrip></descripGrp><ntig><termGrp><term id="128261">vertical bar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1505744">نوار عمودی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1858_128262_1505744"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The | character.</descrip></descripGrp><ntig><termGrp><term id="128262">VERTICAL LINE</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1505744">نوار عمودی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1858_128263_1505744"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The | character.</descrip></descripGrp><ntig><termGrp><term id="128263">pipe</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1505744">نوار عمودی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18583_650937_1897671"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A phone number format for dialing any call from any location or with a calling card.</descrip></descripGrp><ntig><termGrp><term id="650937">international format</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1897671">قالب بین المللی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18585_650939_1506187"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A line that connects fields between two tables and shows how the data is related. The type of join indicates which records are selected for the query's result set.</descrip></descripGrp><ntig><termGrp><term id="650939">join line</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1506187">خط شرکت کردن</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18587_650941_1897672"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The special characters used to extend the joiner between two Arabic characters. Used to improve the appearance of justified text by visually lengthening words rather than increasing the spacing between words. Can also function like a hyphen.</descrip></descripGrp><ntig><termGrp><term id="650941">kashidas</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1897672">کشیده</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18590_650944_1499113"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Resolving resource conflicts or overallocations by delaying or splitting certain tasks. When Project levels a resource, its selected assignments are distributed and rescheduled.</descrip></descripGrp><ntig><termGrp><term id="650944">leveling</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1499113">سطح بندی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18594_650948_1897673"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of cascading style sheet that exists in a separate file and is referenced throughout one or more Web pages.</descrip></descripGrp><ntig><termGrp><term id="650948">linked style sheet</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1897673">ورق سبک لینک شده</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18598_650952_1897674"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A character, usually a comma or semicolon, that separates elements in a list.</descrip></descripGrp><ntig><termGrp><term id="650952">list-separator character</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1897674">نویسۀ جدا کنندۀ لست</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18599_650953_1354544"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The group of users who have permission to perform administration tasks on the local server computer. The permissions for this group are set by using the administration tools for the operating system.</descrip></descripGrp><ntig><termGrp><term id="650953">local administrators group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1354544">گروه مدیران محلی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="186_3712_1505692"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To change to a newer, and/or more powerful or sophisticated version of a product.</descrip></descripGrp><ntig><termGrp><term id="3712">upgrade</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1505692">ترفیع</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18601_650955_1897675"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A calendar that is based on cycles of the moon phase.</descrip></descripGrp><ntig><termGrp><term id="650955">Lunar calendar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1897675">تقویم قمری</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18604_650958_1897676"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A range in an XML list that has been linked to an element in an XML map.</descrip></descripGrp><ntig><termGrp><term id="650958">mapped range</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1897676">محدوده نقشه برداری شده</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18605_650959_1506062"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A shape on a stencil that you use repeatedly to create drawings. When you drag a shape from a stencil onto the drawing page, the shape becomes an instance of that master.</descrip></descripGrp><ntig><termGrp><term id="650959">master shape</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1506062">صورت رئیسی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18614_650968_1897677"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tone in a picture that is in the middle of the tonal range, between the lightest and darkest tones</descrip></descripGrp><ntig><termGrp><term id="650968">midtone</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1897677">رنگ میانی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1862_380991_1354615"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of Web sites that have the same owner and share administration settings. Each site collection contains a top-level site, can contain one or more subsites, and may have a shared navigation structure.</descrip></descripGrp><ntig><termGrp><term id="380991">site collection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1354615">مجموعۀ سایت</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1881_68580_1499057"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Software that enables a program to work with the user (the user interface, which can be a command-line interface, menu-driven, or a graphical user interface), with another program such as the operating system, or with the computer's hardware.</descrip></descripGrp><ntig><termGrp><term id="68580">interface</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1499057">رابط</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18831_651182_1897678"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A character that does not have strong right-to-left or left-to-right language attributes.</descrip></descripGrp><ntig><termGrp><term id="651182">neutral character</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1897678">نویسۀ خنثی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18840_651191_1897679"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file you create on your hard disk or a network share to store OLAP source data for a PivotTable or PivotChart report. Offline cube files allow you to keep working when you are not connected to the OLAP server.</descrip></descripGrp><ntig><termGrp><term id="651191">offline cube file</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1897679">فایل مکعبی آفلاین</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18851_651202_1506189"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The result of assigning more tasks to a resource than the resource can accomplish in the working time available.</descrip></descripGrp><ntig><termGrp><term id="651202">overallocation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1506189">زیادت در تخصیص</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18860_651211_1796240"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Principles that guide developers as they assign responsibilities to software classes and design system behavior. They are most useful when creating collaboration diagrams where messages imply responsibility.</descrip></descripGrp><ntig><termGrp><term id="651211">patterns</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1796240">طرح ها</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18862_651213_1897680"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A field that you use to enter or display how much of a task has been completed. This value is expressed as the percentage of the task duration that has been completed.</descrip></descripGrp><ntig><termGrp><term id="651213">percent complete</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1897680">فیصد تکمیل شده</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18865_651216_1354565"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A view of a list, SharePoint document library, or Web Part Page that is available only to a particular user.</descrip></descripGrp><ntig><termGrp><term id="651216">personal view</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1354565">دید شخصی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18866_651217_1354566"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A shared Web Part that has been modified by a user in personal view. The changes made to a Web Part personalized in this way are visible only to the user who made those changes.</descrip></descripGrp><ntig><termGrp><term id="651217">personalized Web Part</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1354566">بخش وب شخصی شده</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18873_651224_1499264"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A schedule of task start and finish dates and resource and cost data.</descrip></descripGrp><ntig><termGrp><term id="651224">plan</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1499264">برنامه</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18876_651227_1897681"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A list of projects within an organization that may share common management of scope, budget, or resources.</descrip></descripGrp><ntig><termGrp><term id="651227">portfolio</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1897681">مدارک تجاری</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18877_651228_1506190"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Placing elements, such as text and graphics, on a page to let the page author control the exact location and layer order of a page element.</descrip></descripGrp><ntig><termGrp><term id="651228">positioning</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1506190">موقعیت دادن</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18878_651229_1897682"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A bookmark that Microsoft Word automatically sets in each document.</descrip></descripGrp><ntig><termGrp><term id="651229">predefined bookmark</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1897682">نشان از پیش تعریف شده</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18887_651238_1354572"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A resource with a pending resource allocation to a task assignment that has not yet been authorized. This resource assignment does not detract from the availability of the resource to work on other projects.</descrip></descripGrp><ntig><termGrp><term id="651238">proposed resource</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1354572">وسیلۀ پیشنهاد شده</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18891_651242_1499307"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The degree of excellence, or the desired standards, in a product, process, or project.</descrip></descripGrp><ntig><termGrp><term id="651242">quality</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1499307">کیفیت</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18892_651243_1897683"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A default color category that is assigned to an item when you click the Categories column for the item in your Inbox or other table view. You set this color category from the Categorize menu.</descrip></descripGrp><ntig><termGrp><term id="651243">Quick Click category</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1897683">طبقۀ کلیک سریع</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18894_651245_1796217"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To move a task to a lower outline level [to the right] in the Task Name field. When you indent a task, it becomes a subtask of the nearest preceding task at a higher outline level.</descrip></descripGrp><ntig><termGrp><term id="651245">indent</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1796217">برجسته کردن</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18895_651246_1897684"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A task that occurs repeatedly during the course of a project. For example, you might define the weekly status meeting as a recurring task.</descrip></descripGrp><ntig><termGrp><term id="651246">recurring task</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1897684">کار تکرار شونده</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18908_651259_1897685"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Excel template (.xlt file) that includes one or more queries or PivotTable reports that are based on external data. When you save a report template, Excel saves the query definition but doesn't store the queried data in the template.</descrip></descripGrp><ntig><termGrp><term id="651259">report template</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1897685">نمونۀ گزارش</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18909_651260_2299352"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A category of reports that all contain similar information.</descrip></descripGrp><ntig><termGrp><term id="651260">report type</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2299352">نوع راپور</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18913_651264_1354586"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of resources that is available for assignment to project tasks. A resource pool can be used exclusively by one project or can be shared by several projects.</descrip></descripGrp><ntig><termGrp><term id="651264">resource pool</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1354586">محل وسیله</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18915_651266_1354587"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An account of how many hours a resource is scheduled to work within a given time period, and thus an indicator of resources allocation within that time period.</descrip></descripGrp><ntig><termGrp><term id="651266">resource usage</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1354587">استفادۀ وسیله</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18916_651267_1897686"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A certificate that has been cancelled by a certificate authority (CA) and is no longer valid.</descrip></descripGrp><ntig><termGrp><term id="651267">revoked certificate</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1897686">تصدیق باطل شده</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18922_651273_1354457"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A template that can be used as a project and task calendar to specify default working and nonworking time for a set of resources.</descrip></descripGrp><ntig><termGrp><term id="651273">base calendar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1354457">سالنما اساسی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">No