mber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2750609">بزرگ نمایی عالی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4860_235051_1499418"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in Windows that uses add-in programs, or gadgets, to extend information from your computer onto secondary displays.</descrip></descripGrp><ntig><termGrp><term id="235051">Windows SideShow</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1499418">SideShow</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4860_235051_1499571"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in Windows that uses add-in programs, or gadgets, to extend information from your computer onto secondary displays.</descrip></descripGrp><ntig><termGrp><term id="235051">Windows SideShow</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1499571">Windows SideShow</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4860_312519_1499418"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in Windows that uses add-in programs, or gadgets, to extend information from your computer onto secondary displays.</descrip></descripGrp><ntig><termGrp><term id="312519">SideShow</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1499418">SideShow</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4860_312519_1499571"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in Windows that uses add-in programs, or gadgets, to extend information from your computer onto secondary displays.</descrip></descripGrp><ntig><termGrp><term id="312519">SideShow</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1499571">Windows SideShow</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48609_2754104_2756964"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Phone System add-on feature that allows organizations to create a customized call with the ability to create a customized greeting, multiple call queues, as well the ability to automatically put calls on hold, search for the next available call agent, and play music while callers are in their queues.</descrip></descripGrp><ntig><termGrp><term id="2754104">Cloud call queue</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2756964">صف تماس ابری</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48626_2751831_2753696"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A distributed network that has no dedicated servers and whose connection is established between different devices where each device can be a client or a server.</descrip></descripGrp><ntig><termGrp><term id="2751831">peer-to-peer network</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2753696">شبکه همتا-به-همتا</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48650_2753556_2756967"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A means of marketing that uses one or more digital signage device and that targets a specific audience.</descrip></descripGrp><ntig><termGrp><term id="2753556">digital signage</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2756967">صفحه اعلانات دیجیتال</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48675_2753774_2756969"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A means of spreading multiple incoming calls to a single telephone number, to multiple lines.</descrip></descripGrp><ntig><termGrp><term id="2753774">line hunting</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2756969">توزیع خط تماس</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48677_2753779_2756974"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The second argument in a VLOOKUP or HLOOKUP function.</descrip></descripGrp><ntig><termGrp><term id="2753779">table_array</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2756974">آرایه جدول</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48678_2753781_2756970"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A state of having different changes made to the same document in multiple locations that can prevent the document from being saved until they are reconciled.</descrip></descripGrp><ntig><termGrp><term id="2753781">page conflict</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2756970">تناقض صفحه</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48679_2753782_2756965"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A total amount of time spent at work emailing, in meetings, and on chats or calls.</descrip></descripGrp><ntig><termGrp><term id="2753782">collaboration time</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2756965">زمان همکاری</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48682_2753813_2756971"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A number that identifies a row in an Excel sheet in order, starting at 1.</descrip></descripGrp><ntig><termGrp><term id="2753813">row index</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2756971">شاخص ردیف</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48683_2753814_2756966"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A letter that identifies a column in an Excel sheet in order, starting at A.</descrip></descripGrp><ntig><termGrp><term id="2753814">column index</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2756966">شاخص ستون</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48689_2753982_2756973"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An individual who has access to their team's OneNote and libraries and who share an individual notebook with their staff leader.</descrip></descripGrp><ntig><termGrp><term id="2753982">staff member</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2756973">عضو کارکنان</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48692_2754091_2759422"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A physical letter sent to a person requesting a number to verify that he/she resides in the same area where he/she would like to purchase a number.</descrip></descripGrp><ntig><termGrp><term id="2754091">verification letter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2759422">نامه تأییدیه</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48693_2754106_2762692"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A disabled user object that can be used to represent and assign resources within Azure, Office 365, and Skype.</descrip></descripGrp><ntig><termGrp><term id="2754106">resource account</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2762692">حساب منبع</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48694_2754396_2759419"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Kaizala chat feature that allows users to send confidential information in a one-to-one chat more securely by not allowing message content to be forwarded or copied, by blocking messages from showing up in notifications, and by automatically deleting them after they are read.</descrip></descripGrp><ntig><termGrp><term id="2754396">Secret Chat</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2759419">گفتگوی محرمانه</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48695_2754398_2759421"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An individual who has been invited by their group admin to download and join Kaizala, but who hasn't.</descrip></descripGrp><ntig><termGrp><term id="2754398">unregistered user</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2759421">استفاده کننده راجستر ناشده</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48697_2754411_2759417"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Diagnostic Data Viewer setting that allows users to view Office diagnostic data from a different machine.</descrip></descripGrp><ntig><termGrp><term id="2754411">Remote Office diagnostic data viewing</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2759417">نمایش راه دور دیتای تشخیص عیب Office</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48698_2754414_2759415"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of diagnostic data that is collected and sent to Microsoft about Office client software being used on computers running Windows that is used to keep Office secure and up-to-date, detect, diagnose and remediate problems, as well as to make product improvements.</descrip></descripGrp><ntig><termGrp><term id="2754414">Office diagnostic data</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2759415">دیتای تشخیص عیب Office</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="487_146725_2299325"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The "one" side of two related tables in a one-to-many relationship. A primary table should have a primary key and each record should be unique.</descrip></descripGrp><ntig><termGrp><term id="146725">primary table</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2299325">جدول اصلی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48703_2754422_2759416"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Diagnostic Data Viewer setting that allows users to see what Office diagnostic data is being collected.</descrip></descripGrp><ntig><termGrp><term id="2754422">Office diagnostic data viewing</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2759416">نمایش دیتای تشخیص عیب Office</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48704_2754423_2759414"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A string that consists of the IP address of the user's Windows machine and the port number that the DDV app is listening on.</descrip></descripGrp><ntig><termGrp><term id="2754423">Office connection string</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2759414">رشته اتصال Office</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48720_2754440_2759418"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A minimum amount of diagnostic data necessary to help keep Office secure, up-to-date, and performing as expected on the device it’s installed on.</descrip></descripGrp><ntig><termGrp><term id="2754440">required diagnostic data</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2759418">دیتای تشخیص عیب ضرور</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48721_2754441_2759407"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Office experience that provides some of its essential functionality through the use of cloud-based services. Connected experiences are Office experiences that download online content for use in Office (such as templates, images or new fonts) and/or analyze Office content (such as to provide editing suggestions or design recommendations).</descrip></descripGrp><ntig><termGrp><term id="2754441">connected experience</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2759407">تجربه متصل</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48722_2754443_2759405"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A connected experience that is not included in Office 365 ProPlus.</descrip></descripGrp><ntig><termGrp><term id="2754443">additional optional connected experience</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2759405">تجربه متصل اختیاری تکمیلی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48723_2754445_2759413"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of data that enables the delivery of cloud-based connected experiences and that helps make those experiences secure and perform as expected.</descrip></descripGrp><ntig><termGrp><term id="2754445">necessary service data</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2759413">دیتای سرویس ضرور</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48724_2754447_2759408"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of necessary service data that consists of content users create using Office, such as text typed in a Word document.</descrip></descripGrp><ntig><termGrp><term id="2754447">customer content</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2759408">محتوای مشتری</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48725_2754449_2759412"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of necessary service data needed by a connected experience to perform its task, such as configuration information about the app.</descrip></descripGrp><ntig><termGrp><term id="2754449">functional data</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2759412">دیتای عملکردی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48726_2754450_2759420"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of necessary service data needed to keep the service secure, up to date, and performing as expected and is strictly related to a connected experience.</descrip></descripGrp><ntig><termGrp><term id="2754450">service diagnostic data</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2759420">دیتای تشخیص عیب سرویس</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48727_2754452_2759411"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A service that needs to run and send data to Microsoft in order for Office to function properly.</descrip></descripGrp><ntig><termGrp><term id="2754452">essential service</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2759411">سرویس اساسی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48739_2755816_2762689"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to technology that is designed to be used without touch.</descrip></descripGrp><ntig><termGrp><term id="2755816">hands-free</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2762689">هندزفری</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48741_2756423_2762079"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of diagnostic data user can opt out of providing and that is used to make product improvements and provides enhanced information to help detect, diagnose, and remediate issues.</descrip></descripGrp><ntig><termGrp><term id="2756423">optional diagnostic data</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2762079">دیتای تشخیص عیب اختیاری</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48742_2756424_2762084"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of optional diagnostic data that indicates installed products and their version, install and uninstall status, software add-ins and their settings, and installed products and version installation status and updates readiness.</descrip></descripGrp><ntig><termGrp><term id="2756424">software setup and inventory data</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2762084">دیتای نصب و متعلقات سافت ویر</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48743_2756425_2762083"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The optional diagnostic data that indicates successful app function that individual features or aspects of the application have triggered, the functioning of Office accessibility features, and privacy obligations.</descrip></descripGrp><ntig><termGrp><term id="2756425">product and service usage data</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2762083">دیتای استعمال محصول و سرویس</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48744_2756426_2762082"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of optional diagnostic data that indicates an unexpected application exit and the state of that application at the time, as well as poor response time or performance for different product use scenarios.</descrip></descripGrp><ntig><termGrp><term id="2756426">product and service performance data</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2762082">دیتای کارآیی محصول و سرویس</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48745_2756428_2762071"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of optional diagnostic data that indicates the connection state and key device settings, such as memory.</descrip></descripGrp><ntig><termGrp><term id="2756428">device connectivity and configuration data</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2762071">دیتای قابلیت اتصال و پیکربندی دستگاه</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48746_2756498_2762070"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of data that is owned by an organization rather than an individual.</descrip></descripGrp><ntig><termGrp><term id="2756498">company data</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2762070">دیتای شرکت</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48749_2757085_2762072"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SharePoint administrator for a satellite or the central location.</descrip></descripGrp><ntig><termGrp><term id="2757085">geo administrator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2762072">سرپرست مکانی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48752_2757089_2762078"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The offer for OneDrive that includes Multi-Geo Capabilities.</descrip></descripGrp><ntig><termGrp><term id="2757089">OneDrive Multi-Geo</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2762078">OneDrive Multi-Geo</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48753_2757091_2762077"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A search in a multi-geo environment where queries can be sent to the index in each geo location and returned into a single result set.</descrip></descripGrp><ntig><termGrp><term id="2757091">multi-geo search</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2762077">جستجوی چند موقعیتی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48754_2757092_2762074"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to a feature that can be separately configurated for its geo location or is otherwise aware of its geo location.</descrip></descripGrp><ntig><termGrp><term id="2757092">multi-geo aware</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2762074">اعلان چند موقعیتی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48755_2757093_2762075"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tenant with a multi-geo configuration.</descrip></descripGrp><ntig><termGrp><term id="2757093">multi-geo environment</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2762075">ماحول چند موقعیتی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48756_2757095_2762080"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user property set by the administrator that indicates the geo location where the users' Exchange mailbox and OneDrive are provisioned and is attributed to group-connected sites and group mailboxes the creating user.</descrip></descripGrp><ntig><termGrp><term id="2757095">preferred data location</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2762080">PDL</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48756_2757095_2762081"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user property set by the administrator that indicates the geo location where the users' Exchange mailbox and OneDrive are provisioned and is attributed to group-connected sites and group mailboxes the creating user.</descrip></descripGrp><ntig><termGrp><term id="2757095">preferred data location</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2762081">موقعیت دیتای ترجیحی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48756_2757096_2762080"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user property set by the administrator that indicates the geo location where the users' Exchange mailbox and OneDrive are provisioned and is attributed to group-connected sites and group mailboxes the creating user.</descrip></descripGrp><ntig><termGrp><term id="2757096">PDL</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2762080">PDL</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48756_2757096_2762081"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user property set by the administrator that indicates the geo location where the users' Exchange mailbox and OneDrive are provisioned and is attributed to group-connected sites and group mailboxes the creating user.</descrip></descripGrp><ntig><termGrp><term id="2757096">PDL</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2762081">موقعیت دیتای ترجیحی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48758_2757098_2762069"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A geo location where a particular tenant was originally provisioned.</descrip></descripGrp><ntig><termGrp><term id="2757098">central location</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="276206