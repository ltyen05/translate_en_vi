termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40027_2326225_2334959"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app that allows users to collect Word, PowerPoint, Excel, Office Mix, and PDF documents as well as sways and publish them on the website, docs.com, where others can view, download or share them or comment on them.</descrip></descripGrp><ntig><termGrp><term id="2326225">Docs.com</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2334959">Docs.com</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40030_2327887_2641747"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The web-based interface that is included as part of specialized Windows devices and used by developers to manage device services remotely.</descrip></descripGrp><ntig><termGrp><term id="2327887">Windows Device Portal</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2641747">پورتل دستگاه</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40030_2327887_2643157"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The web-based interface that is included as part of specialized Windows devices and used by developers to manage device services remotely.</descrip></descripGrp><ntig><termGrp><term id="2327887">Windows Device Portal</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2643157">پورتل دستگاه Windows</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40030_2635486_2641747"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The web-based interface that is included as part of specialized Windows devices and used by developers to manage device services remotely.</descrip></descripGrp><ntig><termGrp><term id="2635486">Device Portal</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2641747">پورتل دستگاه</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40030_2635486_2643157"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The web-based interface that is included as part of specialized Windows devices and used by developers to manage device services remotely.</descrip></descripGrp><ntig><termGrp><term id="2635486">Device Portal</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2643157">پورتل دستگاه Windows</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4005_44392_1505813"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">One or more special characters used to separate peers in a delimited structure, at any level (fields, records, and so on).</descrip></descripGrp><ntig><termGrp><term id="44392">delimiter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1505813">حائل</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40080_2329245_2331159"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that lets a user hide an email message from their inbox, setting it to return to the top of their inbox at a specified date and time. It lets the user clear their inbox by postponing items that aren't urgent.</descrip></descripGrp><ntig><termGrp><term id="2329245">Schedule</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2331159">تقسیم اوقات</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40081_2329246_2331158"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To mark an email message or conversation such that it moves to the top of your inbox and is flagged at a specified date and time.</descrip></descripGrp><ntig><termGrp><term id="2329246">schedule</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2331158">تقسیم اوقات کردن</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40082_2329247_2329551"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The combination of enterprise-related hardware and software security features that, when configured together, will lock a device down so that it can only run trusted applications.​​​</descrip></descripGrp><ntig><termGrp><term id="2329247">Device Guard</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2329551">Device Guard</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40082_2795844_2329551"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The combination of enterprise-related hardware and software security features that, when configured together, will lock a device down so that it can only run trusted applications.​​​</descrip></descripGrp><ntig><termGrp><term id="2795844">Microsoft Defender Device Guard</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2329551">Device Guard</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40083_2329248_2335824"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The section of Windows Store for Business where admins can sign policies and catalogs of approved software, including LOB apps, using enterprise-specific signing certificates.​</descrip></descripGrp><ntig><termGrp><term id="2329248">Device Guard signing</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2335824">ورود به Device Guard</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40084_2329249_2335826"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The category of fonts that make it easier for people with dyslexia to read.​</descrip></descripGrp><ntig><termGrp><term id="2329249">Fluent</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2335826">Fluent</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40085_2329250_2338702"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">One to whom something is delegated.</descrip></descripGrp><ntig><termGrp><term id="2329250">assignee</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termG