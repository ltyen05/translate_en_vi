mium service that allows users to publish a Sway from within Word.</descrip></descripGrp><ntig><termGrp><term id="2707490">Transform to Web</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2636032">چاپ به وب</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46572_2707490_2713057"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Premium service that allows users to publish a Sway from within Word.</descrip></descripGrp><ntig><termGrp><term id="2707490">Transform to Web</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2713057">انتقال به ویب</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46573_2620858_2621992"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The OneDrive feature that allows users to access cloud files without downloading them, allows online files to be visible in File Explorer, and that, when needed, automatically downloads them so that they are locally available.</descrip></descripGrp><ntig><termGrp><term id="2620858">OneDrive Files On-Demand</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2621992">OneDrive فایل ها بر روی تقاضا</term><termNote type=