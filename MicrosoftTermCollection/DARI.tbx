ote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1527079">لوازم Windows Live</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24603_1136241_1676849"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The set of Microsoft software for email, instant messaging, photos, and personal movies available to customers in a single download and installation.</descrip></descripGrp><ntig><termGrp><term id="1136241">Windows Live Essentials</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1676849">لوازم Windows</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24603_1636168_1527079"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The set of Microsoft software for email, instant messaging, photos, and personal movies available to customers in a single download and installation.</descrip></descripGrp><ntig><termGrp><term id="1636168">Windows Essentials</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1527079">لوازم Windows Live</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24603_1636168_1676849"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The set of Microsoft software for email, instant messaging, photos, and personal movies available to customers in a single download and installation.</descrip></descripGrp><ntig><termGrp><term id="1636168">Windows Essentials</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1676849">لوازم Windows</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24604_1136243_1527074"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Windows Live universal roaming contact list that allows users to share their contact information and subscribe to others’ to automatically receive updates across Windows Live Messenger and Windows Live Spaces.</descrip></descripGrp><ntig><termGrp><term id="1136243">Windows Live Contacts</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1527074">تماس های Windows Live</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24606_1136281_1527073"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Windows Live service that allows users to make computer-to-computer or computer-to-phone calls. Users must be signed in to Windows Live Messenger to use it.</descrip></descripGrp><ntig><termGrp><term id="1136281">Windows Live Call</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1527073">فراخواندن Windows Live</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24607_1136282_1527069"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Windows Live service that lets people and groups add, manage, and share event information.</descrip></descripGrp><ntig><termGrp><term id="1136282">Windows Live Calendar</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1527069">سالمنای Windows Live</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24608_1136283_1527067"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Windows Live service that notifies someone of an event or information based on their subscription preferences. The alerts can be sent to Messenger, Mail, Hotmail, or a mobile device.</descrip></descripGrp><ntig><termGrp><term id="1136283">Windows Live Alerts</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1527067">هشدار های Windows Live</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singul