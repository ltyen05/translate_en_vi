3.</descrip></descripGrp><ntig><termGrp><term id="1508807">language folder</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1898242">دوسیۀ لسان</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29462_1508810_1898243"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A toolbar with buttons and options used to apply text formatting. To display the toolbar, point to Toolbars on the View menu, and then click Formatting.</descrip></descripGrp><ntig><termGrp><term id="1508810">Formatting toolbar</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1898243">نوار اسباب قالب بندی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29464_1508812_1898244"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Visual Basic identifier that's defined in the host application or by using the #Const compiler directive, and used by other compiler directives to determine when or if certain blocks of code are compiled.</descrip></descripGrp><ntig><termGrp><term id="1508812">conditional compiler constant</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1898244">کمپایلر ثابت مشروط</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29465_1508813_1898245"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Naskh script that enriches the display of Arabic text. This script uses object linking and embedding (OLE) to create and add objects to a document.</descrip></descripGrp><ntig><termGrp><term id="1508813">DecoType Naskh</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1898245">نسخ تزئینی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29466_1508814_1898246"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Ruq'ah script that enriches the display of Arabic text. This script uses object linking and embedding (OLE) to create and add objects to a document.</descrip></descripGrp><ntig><termGrp><term id="1508814">DecoType Ruq'ah</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1898246">روقا تزئینی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29473_1508823_1898247"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An administrative tool that examines a computer, server farm, or server cluster and provides statistics that indicate the degree to which the configuration meets expected demands.</descrip></descripGrp><ntig><termGrp><term id="1508823">health analyzer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1898247">تحلیل کنندۀ صحت</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29474_1508825_1898249"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A custom handler that calls and runs custom code during the creation process for a site.</descrip></descripGrp><ntig><termGrp><term id="1508825">site provisioning provider</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1898249">ارائه کننده خدمات سایت</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29476_1508830_1898251"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Microsoft Office program that you can use to organize related documents. You can check spelling, number pages consecutively across all documents in the binder, and print the documents.</descrip></descripGrp><ntig><termGrp><term id="1508830">Binder</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1898251">Binder</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeec