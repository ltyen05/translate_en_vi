 the caller.</descrip></descripGrp><ntig><termGrp><term id="2754779">Cloud auto attendant</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2806163">دستیار خودکار</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10637_2754779_2806164"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that supplies callers with information and performs an action without the intervention of a human operator, automatically routing calls based on selections made by the caller.</descrip></descripGrp><ntig><termGrp><term id="2754779">Cloud auto attendant</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2806164">دستیار خودکار ابری</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10648_1507092_1898199"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A procedure that is exposed to Web service clients as an operation that can be called on the Web service.</descrip></descripGrp><ntig><termGrp><term id="1507092">Web service method</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1898199">روش خدمات وب</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammat