<ntig><termGrp><term id="116265">status</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1499449">جایگاه</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15075_186215_1897420"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An alternate URL mapping that Windows SharePoint Services preserves in the mapping table. It is the URL a user would see, but is not a URL that IIS would give to WSS.</descrip></descripGrp><ntig><termGrp><term id="186215">alternate access mapping</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1897420">نقشه بندی دسترسی متبادل</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15076_413296_2299214"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Exchange Server 2007 server role that provides email storage and advanced scheduling services for Microsoft Office Outlook users. The Mailbox server role also includes public folders, which provide a foundation for workflow, document sharing, and other forms of collaboration.</descrip></descripGrp><ntig><termGrp><term id="413296">Mailbox server role</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2299214">نقش سرور صندوق پستی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15086_5913_1506122"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An integrated proofing tool used to search on common words and display synonyms.</descrip></descripGrp><ntig><termGrp><term id="5913">thesaurus</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1506122">قاموس</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15088_140956_1897292"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A control that appears dimmed on a form or data access page. A disabled control cannot get the focus and will not respond to mouse clicks.</descrip></descripGrp><ntig><termGrp><term id="140956">disabled control</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1897292">کنترول غیرفعال</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1509_101960_1499331"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The likelihood of a computer system or device continuing to function over a given period of time and under specified conditions.</descrip></descripGrp><ntig><termGrp><term id="101960">reliability</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1499331">قابلیت اعتماد</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15094_347947_2299349"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A control on a form that contains other controls in a table format and that repeats as needed. Users can insert multiple rows when filling out the form.</descrip></descripGrp><ntig><termGrp><term id="347947">repeating table</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2299349">جدول تکرار شونده</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15098_322615_1897566"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Web site based on the Document Workspace template that workspace members use for discussing, editing, and working together on a document.</descrip></descripGrp><ntig><termGrp><term id="322615">Document Workspace</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1897566">فضای کاری مدرک</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSe