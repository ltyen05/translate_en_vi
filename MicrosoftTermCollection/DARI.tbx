pointed to.</descrip></descripGrp><ntig><termGrp><term id="347647">tooltip</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1505893">نکتۀ صفحه</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6443_148638_2766003"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A debugging technique where the user steps through code one line at a time.</descrip></descripGrp><ntig><termGrp><term id="148638">single stepping</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2766003">تک مرحله یی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6450_74994_1897196"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A chart that shows trends in data at equal intervals, with values from one or more sets of data connected by lines.</descrip></descripGrp><ntig><termGrp><term id="74994">line chart</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1897196">گراف خطی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6451_1624393_1898311"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mode that provides full functionality for creating and/or editing a file.</descrip></descripGrp><ntig><termGrp><term id="1624393">Edit mode</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1898311">حالت تغیر</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6451_49332_1898311"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mode that provides full functionality for creating and/or editing a file.</descrip></descripGrp><ntig><termGrp><term id="49332">edit mode</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1898311">حالت تغیر</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6458_1274286_1657995"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Text that is entered by drawing or writing on a screen, rather with a keyboard.</descrip></descripGrp><ntig><termGrp><term id="1274286">digital handwriting</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1657995">دست خط</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termN