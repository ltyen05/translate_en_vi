lishing level</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1898144">سطح نشر</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29226_1506812_1531147"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A document that binds to a page layout to generate an HTML page for display to a reader. Publishing pages have specific fields that contain the content that is displayed in an HTML page.</descrip></descripGrp><ntig><termGrp><term id="1506812">publishing page</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1531147">صفحۀ نشر سازی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29227_1506814_1898145"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A system to rank items that uses features that do not vary with different queries.</descrip></descripGrp><ntig><termGrp><term id="1506814">query independent rank</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1898145">رتبه مستقل از استعلام</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29228_1506815_1531148"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of recording information about user searches, such as search terms and time of access.</descrip></descripGrp><ntig><termGrp><term id="1506815">query logging</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1531148">ورودی جستار</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29229_1506817_1531149"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A result for a given query, which contains the title and URL of the item, and can also contain other managed properties and a hit-highlighted summary.</descrip></descripGrp><ntig><termGrp><term id="1506817">query result</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1531149">نتیجۀ جستار</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2923_59620_1498994"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method of specifying software behavior by system administrators. Administrators set policies that are used to control how software features behave.</descrip></descripGrp><ntig><termGrp><term id="59620">Group Policy</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1498994">مقرارت گروه</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29230_1506818_1531150"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A two-dimensional table that presents data from an external data source.</descrip></descripGrp><ntig><termGrp><term id="1506818">query table</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1531150">جدول جستار</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29231_1506819_1531151"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The textual string portion of a query. Frequently, a user enters query text, but it can be programmatically amended and is not guaranteed to be exactly what the user typed.</descrip></descripGrp><ntig><termGrp><term id="1506819">query text</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1531151">نوشتۀ جستار</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29232_1506820_1898146"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A value that is used to influence the algorithm that determines the rank of an item.</descrip></descripGrp><ntig><termGrp><term id="1506820">ranking parameter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1898146">پارامیتر رتبه بندی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29233_1506822_1898147"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A system for specifying cells or ranges of cells and that is used in formulas. A reference style is used to specify a specific cell in a two-dimensional table by identifying the row and column that contain that cell or range of cells.</descrip></descripGrp><ntig><termGrp><term id="1506822">reference style</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1898147">سبک مرجع</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29234_1506823_1531155"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An element of markup in a page that defines a relationship between binary files on the server that implements Web Parts and Web controls. The register directive also serves as the namespace of the markup in the Web Part Page that will refer to those binary files.</descrip></descripGrp><ntig><termGrp><term id="1506823">register directive</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1531155">رهنمود ثبت نام</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29235_1506824_1898148"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A search result that is relevant to a query term based on rank. By default, the higher the rank, the higher the item appears in the query results.</descrip></descripGrp><ntig><termGrp><term id="1506824">relevant result</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1898148">نتیجه مربوط</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29236_1506826_1898149"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An event in which various statistics are calculated and recorded in the main catalog.</descrip></descripGrp><ntig><termGrp><term id="1506826">reranking</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1898149">رتبه بندی مجدد</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29237_1506827_1898150"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An integer that identifies the relative location of a relevant result within a search results page. The first relevant result has a result position of 1, the second has 2, the 11th has 11, and so on.</descrip></descripGrp><ntig><termGrp><term id="1506827">result position</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1898150">موقعیت نتیجه</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29238_1506828_1898151"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An integer that uniquely identifies a role definition within a site.</descrip></descripGrp><ntig><termGrp><term id="1506828">role identifier</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1898151">شناسایی کنندۀ نقش</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29239_1506830_1898152"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A document in the root folder of a site.</descrip></descripGrp><ntig><termGrp><term id="1506830">root document</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1898152">مدرک ریشه</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29240_1506831_1531158"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A status that is applied to a list item or document that specifies a time when the item or document will be published or unpublished.</descrip></descripGrp><ntig><termGrp><term id="1506831">scheduled</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1531158">تقسیم بنده شده</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29241_1506833_1531159"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An integer value that represents the version number of the schema for a deployment package.</descrip></descripGrp><ntig><termGrp><term id="1506833">schema version</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1531159">نسخۀ نمودار</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29242_1506835_1898153"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A GUID that uniquely identifies a scope within a site collection.</descrip></descripGrp><ntig><termGrp><term id="1506835">scope identifier</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1898153">شناسایی کنندۀ محدوده</term><termNote type="geog