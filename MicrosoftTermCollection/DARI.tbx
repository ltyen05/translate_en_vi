</langSet></termEntry><termEntry id="43398_2457782_2463291"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A sequence of words that co-occur more frequently, in a particular language, than would happen by chance.</descrip></descripGrp><ntig><termGrp><term id="2457782">collocation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2463291">نظم</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43399_2457783_2463296"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A modification of a word to express different grammatical categories.</descrip></descripGrp><ntig><termGrp><term id="2457783">inflection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2463296">بلندبالایی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43403_2458526_2518122"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The result of remixing existing media to create a new version of that thing.</descrip></descripGrp><ntig><termGrp><term id="2458526">remix</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2518122">ریمیکس</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termN