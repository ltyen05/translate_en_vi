 implies Kerberos only, a principal's secret key.</descrip></descripGrp><ntig><termGrp><term id="1506854">secret key</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1587034">کلید مخفی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29258_1506855_1898166"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An integer that uniquely identifies a security group from all other security principals and site groups within the same site collection.</descrip></descripGrp><ntig><termGrp><term id="1506855">security group identifier</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1898166">شناسایی کنندۀ گروه امنیتی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29259_1506856_1898167"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The rendering of the contents of a workbook that are associated with a particular session.</descrip></descripGrp><ntig><termGrp><term id="1506856">session view</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1898167">نمای جلسه</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote typ