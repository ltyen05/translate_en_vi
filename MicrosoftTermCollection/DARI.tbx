="39933_2323799_2331163"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that lets users link their inbox for one email account with an inbox for another account, so they can see the messages from both accounts in a single place.</descrip></descripGrp><ntig><termGrp><term id="2323799">Linked Inboxes</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2331163">صندوق های دریافت پیوند داده شده</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39934_2323812_2331162"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The OneNote toolbar designed to help individuals with learning differences or who are looking for literacy assistance.</descrip></descripGrp><ntig><termGrp><term id="2323812">Learning Tools for OneNote</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2331162">ابزارهای یادگیری OneNote</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39935_2324831_2328104"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To install an operating system image on a device, reformatting all partitions as part of the process.</descrip></descripGrp><ntig><termGrp><term id="2324831">flash</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></n