><termGrp><term id="2594916">account protection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2596719">محافظت حساب</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46047_2594920_2596816"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The area in Windows Defender Security Center, within Ransomware protection, where customers can set up or initiate file restores with cloud providers, to help recover from a ransomware attack (which often encrypts files).</descrip></descripGrp><ntig><termGrp><term id="2594920">Ransomware data recovery</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2596816">بازیابی دیتای Ransomware</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46048_2594927_2596818"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In the Windows Defender Security Center, the area within the Virus &amp; threat protection section (pillar), where customers can find and use features to help prevent or recover from ransomware attacks.​</descrip></descripGrp><ntig><termGrp><term id="2594927">Ransomware protection</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2596818">محافظت Ransomware</term><te