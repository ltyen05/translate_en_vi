ch">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2004747">کمپنی نوع C</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34574_1993406_2004750"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A business that is owned by an individual but is not treated as a separate entity from the business owner for tax purposes.</descrip></descripGrp><ntig><termGrp><term id="1993406">disregarded entity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2004750">نهاد منفک در نظر گرفته نشده</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34575_1993407_2004751"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An individual or entity that has no tax liability under US tax laws because they are not a citizen, resident alien, or an organization created or organized under the laws of the United States.</descrip></descripGrp><ntig><termGrp><term id="1993407">exempt payee</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2004751">گیرنده معاف از مالیات</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34576_1993408_2004755"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The federal revenue agency under the United States Department of the Treasury that is responsible for the collection of taxes in addition to the interpretation and enforcement of federal tax laws.</descrip></descripGrp><ntig><termGrp><term id="1993408">Internal Revenue Service</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2004755">سازمان مالیاتی آمریکا (IRS)</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34576_1993408_2004757"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The federal revenue agency under the United States Department of the Treasury that is responsible for the collection of taxes in addition to the interpretation and enforcement of federal tax laws.</descrip></descripGrp><ntig><termGrp><term id="1993408">Internal Revenue Service</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2004757">IRS</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34576_1993409_2004755"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The federal revenue agency under the United States Department of the Treasury that is responsible for the collection of taxes in addition to the interpretation and 