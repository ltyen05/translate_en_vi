59"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A special symbol that breaks a column when inserted into a document. It ends the current column and starts the next column.</descrip></descripGrp><ntig><termGrp><term id="34870">column break</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1505859">شکست ستون</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5370_60431_2328106"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The physical components of a computer system, including any peripheral equipment such as printers, modems, and mouse devices.</descrip></descripGrp><ntig><termGrp><term id="60431">hardware</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2328106">هارد ویر</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5371_82027_1499182"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Microsoft computer operating system with a command-line interface that is used to control many internal computer functions, such as running programs and organizing and maintaining files.</descrip></descripGrp><ntig><termGrp><term id="82027">MS-DOS</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1499182">MS-DOS</