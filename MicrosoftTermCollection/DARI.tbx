/langSet></termEntry><termEntry id="828_178555_2737259"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An item that is frequently accessed when using Business Contact Manager for Outlook and that is often listed on the Business Tools menu.</descrip></descripGrp><ntig><termGrp><term id="178555">business tool</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2737259">اسباب تجارتی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8283_153889_1498937"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A derivative of the file allocation table (FAT) file system. FAT32 supports smaller cluster sizes and larger volumes than FAT, which results in more efficient space allocation on FAT32 volumes.</descrip></descripGrp><ntig><termGrp><term id="153889">FAT32</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1498937">FAT32</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8286_2119323_2281188"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A unique set of letters or numbers that identifies a wireless network. For a computer or device to connect to a wireless network, it must supply that network’s SSID. An SSID can be up to 32 characters.</descrip></descripGrp><ntig><termGrp><term id="2119323">Service Set Identifier</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2281188">شناسایی کننده سیت سرویس</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8286_269331_2281188"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A unique set of letters or numbers that identifies a wireless network. For a computer or device to connect to a wireless network, it must supply that network’s SSID. An SSID can be up to 32 characters.</descrip></descripGrp><ntig><termGrp><term id="269331">SSID</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2281188">شناسایی کننده سیت سرویس</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8286_725814_2281188"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A unique set of letters or numbers that identifies a wireless network. For a computer or device to connect to a wireless network, it must supply that network’s SSID. An SSID can be up to 32 characters.</descrip></descripGrp><ntig><termGrp><term id="725814">network service set identifier</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2281188">شناسایی کننده سیت سرویس</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8289_138323_1897260"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Vertical lines appearing next to text that has been added, deleted, or changed by using tracked changes. You can specify that changed lines appear to the left or right of text. You can also hide changed lines.</descrip></descripGrp><ntig><termGrp><term id="138323">changed lines</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1897260">خطوط تغییر یافته</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8290_14789_1498665"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A message that appears in a newsgroup, public folder, or other forum, such as Facebook or Twitter, accessible by a number of individuals.</descrip></descripGrp><ntig><termGrp><term id="14789">article</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1498665">مقاله</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8290_14789_1499277"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A message that appears in a newsgroup, public folder, or other forum, such as Facebook or Twitter, accessible by a number of individuals.</descrip></descripGrp><ntig><termGrp