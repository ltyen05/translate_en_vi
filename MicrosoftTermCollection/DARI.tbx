mNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1498983">آغاز نمایی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14922_397187_1897580"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A snapshot of information from an address book that has been downloaded so that an Outlook user can access it while disconnected from the server. It contains the properties of a user, such as email addresses, that Outlook requires to send an email message and display information about the sender.</descrip></descripGrp><ntig><termGrp><term id="397187">offline address book</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1897580">کتابچه آدرس آفلاین</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14922_397187_2299268"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A snapshot of information from an address book that has been downloaded so that an Outlook user can access it while disconnected from the server. It contains the properties of a user, such as email addresses, that Outlook requires to send an email message and display information about the sender.</descrip></descripGrp><ntig><termGrp><term id="397187">offline address book</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2299268">OAB</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14922_397188_1897580"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A snapshot of information from an address book that has been downloaded so that an Outlook user can access it while disconnected from the server. It contains the properties of a user, such as email addresses, that Outlook requires to send an email message and display information about the sender.</descrip></descripGrp><ntig><termGrp><term id="397188">OAB</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1897580">کتابچه آدرس آفلاین</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14922_397188_2299268"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A snapshot of information from an address book that has been downloaded so that an Outlook user can access it while disconnected from the server. It contains the properties of a user, such as email addresses, that Outlook requires to send an email message and display information about the sender.</descrip></descripGrp><ntig><termGrp><term id="397188">OAB</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2299268">OAB</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14924_149902_1506116"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A query that retrieves data stored on your intranet or the Internet.</descrip></descripGrp><ntig><termGrp><term id="149902">Web query</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1506116">جستار وب</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14931_397193_2299269"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The method by which the offline address book (OAB) can be accessed by users when they are working remotely or over a dial-up connection. To distribute the OAB, administrators can use Web-based distribution, public folder distribution, or both. Public folder distribution is required for Outlook 2003 or earlier clients.</descrip></descripGrp><ntig><termGrp><term id="397193">offline address book distribution</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2299269">توزیع OAB</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14931_397193_2299276"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The method by which the offline address book (OAB) can be accessed by users when they are working remotely or over a dial-up connection. To distribute the OAB, administrators can use Web-based distribution, public folder distribution, or both. Public folder distribution is required for Outlook 2003 or earlier clients.</descrip></descripGrp><ntig><termGrp><term id="397193">offline address book distribution</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2299276">توزیع کتابچه آدرس آفلاین</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14931_397194_2299269"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The method by which the offline address book (OAB) can be accessed by users when they are working remotely or over a dial-up connection. To distribute the OAB, administrators can use Web-based distribution, public folder distribution, or both. Public folder distribution is required for Outlook 2003 or earlier clients.</descrip></descripGrp><ntig><termGrp><term id="397194">OAB distribution</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2299269">توزیع OAB</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14931_397194_2299276"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The method by which the offline address book (OAB) can be accessed by users when they are working remotely or over a dial-up connection. To distribute the OAB, administrators can use Web-based distribution, public folder distribution, or both. Public folder distribution is required for Outlook 2003 or earlier clients.</descrip></descripGrp><ntig><termGrp><term id="397194">OAB distribution</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2299276">توزیع کتابچه آدرس آفلاین</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14938_18094_1506117"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A predefined or free-form figure — such as a line, oval, cube, flowchart symbol, banner, or free-form scribble — that the user can insert into a document and then customize.</descrip></descripGrp><ntig><termGrp><term id="18094">AutoShape</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1506117">شکل خودکار</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14943_134986_1897247"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The position of a point with reference to the x-axis, defined in conjunction with the y- and z-coordinates.</descrip></descripGrp><ntig><termGrp><term id="134986">x-coordinate</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1897247">کوردینات x</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14944_262698_1499230"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In computer graphics, a display method in which a viewing window on the screen scans horizontally or vertically, like a camera, to bring offscreen extensions of the current image smoothly into view.</descrip></descripGrp><ntig><termGrp><term id="262698">pan</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1499230">حرکت موازی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14944_779138_1499230"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In computer graphics, a display method in which a viewing window on the screen scans horizontally or vertically, like a camera, to bring offscreen extensions of the current image smoothly into view.</descrip></descripGrp><ntig><termGrp><term id="779138">panning</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1499230">حرکت موازی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14948_245218_1498759"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A common point of entry for spyware guarded by an agent. Examples of checkpoints include Startup Folder, dial up connections, Wi-Fi connections, Internet Safe Sites, Winsock Layered Service Providers, Windows Messenger Service, and SPAM Zombie prevention.</descrip></descripGrp><ntig><termGrp><term id="245218">checkpoint</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1498759">نقطۀ بررسی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14953_38284_1506118"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A numeric or string value that is not calculated and, therefore, does not change.</descrip></descripGrp><ntig><termGrp><term id="38284">constant</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1506118">عدد ثابت</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14954_78795_1499157"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To enlarge a window to its largest size by double-clicking the title bar, clicking the Maximize button (at the right of the title bar), or by pressing ALT+SPACEBAR and then pressing X.</descrip></descripGrp><ntig><termGrp><term id="78795">maximize</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1499157">بزرگ کردن</term><termNote type="geographica