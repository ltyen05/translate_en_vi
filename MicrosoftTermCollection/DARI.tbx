Set xml:lang="en-US"><descripGrp><descrip type="definition">A device that reads the information stored on a compact disc. A compact disc player contains the optical equipment necessary for reading a disc's contents and the electronic circuitry for interpreting the data as it is read.</descrip></descripGrp><ntig><termGrp><term id="29105">CD player</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1498743">دستگاه پخش سی دی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4713_29106_1498743"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A device that reads the information stored on a compact disc. A compact disc player contains the optical equipment necessary for reading a disc's contents and the electronic circuitry for interpreting the data as it is read.</descrip></descripGrp><ntig><termGrp><term id="29106">compact disc player</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1498743">دستگاه پخش سی دی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4715_98780_2299339"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An email feature providing feedback to the sender that a message has been read by the recipient.</descrip></descripGrp><ntig><termGrp><term id="98780">read notification</term><termNote type="partOfSpeech">Noun</termNote><termN