 type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1124_49645_1897178"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of routines that an application uses to request and carry out lower-level services performed by a computer's or device's operating system. These routines usually carry out maintenance tasks such as managing files and displaying information.</descrip></descripGrp><ntig><termGrp><term id="49645">application programming interface</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1897178">API</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11245_59333_1506020"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A sequence of shades ranging from black through white, used in computer graphics to add detail to images or to represent a color image on a monochrome output device.</descrip></descripGrp><ntig><termGrp><term id="59333">grayscale</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1506020">پیمایش خاکستری</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11246_24169_1498714"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To scan a database, a list of files, or the Internet, either for a particular item or for anything that seems to be of interest.</descrip></descripGrp><ntig><termGrp><term id="24169">browse</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1498714">مرور</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11246_385260_1498714"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To scan a database, a list of files, or the Internet, either for a particular item or for anything that seems to be of interest.</descrip></descripGrp><ntig><termGrp><term id="385260">browse for</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1498714">مرور</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11257_211083_1499011"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables records managers to create and manage entries to a “Holds list” such that any document, image, or webpage on that list cannot be deleted, modified, or allowed to expire until the item is removed from the list. The feature is typically used for items that are subject to events such as litigation, audits, or investigations.</descrip></descripGrp><ntig><termGrp><term id="211083">Hold</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1499011">تعلیق</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11264_233734_1897502"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of files that can be delivered as a unit to a client computer or device for installation.</descrip></descripGrp><ntig><termGrp><term id="233734">deployment package</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1897502">بستۀ گسترش</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11268_2461481_1816547"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Control Panel feature that is used to set restrictions on what traffic is allowed to enter your network from the Internet.</descrip></descripGrp><ntig><termGrp><term id="2461481">Windows Defender Firewall</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1816547">سیستم امنیتی Windows</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11268_2461481_2465024"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Control Panel 