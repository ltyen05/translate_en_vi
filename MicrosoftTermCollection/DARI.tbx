<termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45074_2908350_2736059"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A cloud deployment solution that leverages the cloud to automate the configuration of new PCs including changing default start up screens without the need of IT assistance.</descrip></descripGrp><ntig><termGrp><term id="2908350">Autopilot</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2736059">Windows Autopilot</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45074_2908350_2736109"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A cloud deployment solution that leverages the cloud to automate the configuration of new PCs including changing default start up screens without the need of IT assistance.</descrip></descripGrp><ntig><termGrp><term id="2908350">Autopilot</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2736109">Windows Autopilot Deployment</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45074_2908351_2736059"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A cloud deployment solution that leverages the cloud to automate the configuration of new PCs including changing default start up screens without the need of IT assistance.</descrip></descripGrp><ntig><termGrp><term id="2908351">AutoPilot</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2736059">Windows Autopilot</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45074_2908351_2736109"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A cloud deployment solution that leverages the cloud to automate the configuration of new PCs including changing default start up screens without the need of IT assistance.</descrip></descripGrp><ntig><termGrp><term id="2908351">AutoPilot</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2736109">Windows Autopilot Deployment</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45078_2543137_2544321"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Windows, an input panel where user can insert emojis and other expressive images or symbols. When using the en-US hardware keyboard to type, user can use SPACE+ : (colon) to input emoji in an easy and smart way. Rather than having to use the mouse, user can bring up the emoji panel and search or arrow key through the options. Eventually, this panel will include stickers and other expression objects.</descrip></descripGrp><ntig><termGrp><term id="2543137">emoji panel</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2544321">پانل صورتک</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45100_2544667_2547324"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that allows users to use a digital pen and make the strokes appear in pencil texture.</descrip></descripGrp><ntig><termGrp><term id="2544667">Digital Pencil</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2547324">مداد دیجیتال</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45101_2544668_2547472"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An ink type that looks like pencil strokes.</descrip></descripGrp><ntig><termGrp><term id="2544668">pencil texture</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2547472">بافت مداد</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45113_2546253_2549480"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft solutions framework that brings together Office 365, Windows 10 and Enterprise Mobility + Security.</descrip></descripGrp><ntig><termGrp><term id="2546253">Microsoft 365</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2549480">Microsoft 365</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45118_2547320_2548667"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The section in the Xbox Store where developers participating in the Xbox Live Creators Program publish their games directly. The collection offers exciting and diverse games that are fun to pick up and play.</descrip></descripGrp><ntig><termGrp><term id="2547320">Creators Collection</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2548667">مجموعه سازندگان</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4512_145048_2299260"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A search method that lets you direct your search using conversational language.</descrip></descripGrp><ntig><termGrp><term id="145048">natural language searching</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet 