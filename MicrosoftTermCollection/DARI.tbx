">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1897464">میدان ردیف</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14041_139645_1897277"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The area of the window that displays the criteria used to limit the records included in the result set of your query.</descrip></descripGrp><ntig><termGrp><term id="139645">Criteria pane</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1897277">قاب معیارها</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14051_136919_2298897"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Additional information required by some macro actions - for example, the object affected by the action or special conditions under which the action is carried out.</descrip></descripGrp><ntig><termGrp><term id="136919">action argument</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2298897">ارگومان عمل</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14081_7275_2298891"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In programming, the means by which an application can read from or write to a resource.</descrip></descripGrp><ntig><termGrp><term id="7275">access mechanism</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2298891">شیوه دسترسی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14081_7276_2298891"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In programming, the means by which an application can read from or write to a resource.</descrip></descripGrp><ntig><termGrp><term id="7276">access method</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2298891">شیوه دسترسی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14097_7696_1498620"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The basic building block of a macro; a self-contained instruction that can be combined with other actions to automate tasks. This is sometimes called a command in other macro languages.</descrip></descripGrp><ntig><termGrp><term id="7696">action</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1498620">عمل</term><termNote type="geographicalUsage">AFG</termNote><termNote type="p