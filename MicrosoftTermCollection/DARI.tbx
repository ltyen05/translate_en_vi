e></termGrp></ntig></langSet></termEntry><termEntry id="12666_50449_1897180"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The state of an uninitialized Variant variable (which returns a VarType of 0).</descrip></descripGrp><ntig><termGrp><term id="50449">empty</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1897180">خالی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12676_252120_1499461"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of formatting characteristics that you can apply to text, tables, and lists in your document to quickly change their appearance.</descrip></descripGrp><ntig><termGrp><term id="252120">style</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1499461">شیوه</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12678_415521_1354601"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A name that uniquely identifies a server computer on a network.</descrip></descripGrp><ntig><termGrp><term id="415521">server name</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1354601">اسم سرور</term><termNote type="geographicalUsage">AFG</termNote><termNote type="