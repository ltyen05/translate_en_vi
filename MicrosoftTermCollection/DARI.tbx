erm id="2552465">تازه</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45188_2550381_2552478"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A text overlay style in Story Remix. This style resembles the typography of a printed book of poetry or a novel.</descrip></descripGrp><ntig><termGrp><term id="2550381">Poetry</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2552478">شعر</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45189_2550383_2552439"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The text overlay style in Story Remix. This style is big, bold and uses very large type.</descrip></descripGrp><ntig><termGrp><term id="2550383">Boom</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2552439">غرش</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45190_2550385_2552466"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The text overlay style in Story Remix. This style is big, bold, and uses a colored block with transparent lettering that resembles a stencil or poster graphic.</descr