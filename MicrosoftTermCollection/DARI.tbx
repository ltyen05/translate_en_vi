ch">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1354608">بخش وب اشتراکی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17416_645112_1354595"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Anything in the SharePoint environment on which permissions or permission levels can be set.</descrip></descripGrp><ntig><termGrp><term id="645112">securable object</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1354595">شئی قابل حفاظت</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17417_645113_1354568"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Web Part added to a Web Part Page by a user who is working on the page in personal view.</descrip></descripGrp><ntig><termGrp><term id="645113">private Web Part</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1354568">بخش وب خصوصی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17419_645117_1354486"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of reusab