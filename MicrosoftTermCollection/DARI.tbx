40_2490708"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An element of workflow logic that groups steps. Adding stages to a workflow does not affect how the steps function. Stages are purely for conceptual grouping of steps within complex workflows.</descrip></descripGrp><ntig><termGrp><term id="557740">stage</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2490708">مرحله</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10707_397191_2299270"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The HTTP Web address or public folder where client computers can download an offline address book. Public folder distribution is required for Outlook 2003 or earlier clients.</descrip></descripGrp><ntig><termGrp><term id="397191">offline address book distribution point</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2299270">نقطه توزیع OAB</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10707_397191_2299277"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The HTTP Web address or public folder where client computers can download an offline address book. Public folder distribution is required for Outlook 2003 or earlier clients.</descrip></descripGrp><ntig><termGrp><term id="397191">offline address book distribution point</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2299277">نقطه توزیع کتابچه آدرس آفلاین</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10707_397192_2299270"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The HTTP Web address or public folder where client computers can download an offline address book. Public folder distribution is required for Outlook 2003 or earlier clients.</descrip></descripGrp><ntig><termGrp><term id="397192">OAB distribution point</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2299270">نقطه توزیع OAB</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10707_397192_2299277"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The HTTP Web address or public folder where client computers can download an offline address book. Public folder distribution is required for Outlook 2003 or earlier clients.</descrip></descripGrp><ntig><termGrp><term id="397192">OAB distribution point</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2299277">نقطه توزیع کتابچه آدرس آفلاین</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNo