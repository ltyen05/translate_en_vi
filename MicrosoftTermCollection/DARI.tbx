tors</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2383328">واصل</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42020_2376839_2383336"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office 365 feature that allows users to connect online apps, tools, and services to their Groups so that all the members receive updates (via connector cards in Outlook) and have access to the connector.</descrip></descripGrp><ntig><termGrp><term id="2376839">Connectors</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2383336">Office 365 واصل ها</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42020_2376840_2383328"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office 365 feature that allows users to connect online apps, tools, and services to their Groups so that all the members receive updates (via connector cards in Outlook) and have access to the connector.</descrip></descripGrp><ntig><termGrp><term id="2376840">Office 365 Connectors</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2383328">واصل</term><termNote type="geographicalUsage">AFG</termNote><termNote type="part