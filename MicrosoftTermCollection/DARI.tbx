AF"><ntig><termGrp><term id="1499083">سلسلۀ کلید</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4635_72848_1498614"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Any combination of keys that must be pressed sequentially.</descrip></descripGrp><ntig><termGrp><term id="72848">key sequence</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1498614">کلید دسترسی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4635_72848_1499083"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Any combination of keys that must be pressed sequentially.</descrip></descripGrp><ntig><termGrp><term id="72848">key sequence</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1499083">سلسلۀ کلید</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46353_2612185_2612301"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The consumer-friendly name for virtualization-based security (VBS). The VBS service in Windows 10 uses hardware virtualization features to create and isolate a secure region of memory from the normal operating system.</descrip></descripGrp><ntig><termGrp><term id="2612185">Core isolation</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2612301">جداسازی اصلی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46354_2612186_2612302"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of open tabs, including applications, files, pages, or websites, which can be saved together and re-opened together when you want to continue with that set of tabs.</descrip></descripGrp><ntig><termGrp><term id="2612186">set</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2612302">مجموعه</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4639_108282_1499375"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To move a document or other data in a window in order to view a particular portion of the document. Scrolling may be controlled by the mouse, arrow keys, or other keys on the keyboard, eventually with one or more fingers.</descrip></descripGrp><ntig><termGrp><term id="108282">scroll</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1499375">حرکت دادن</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46410_2613241_2805390"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A team in Microsoft Teams that is available for all users in an organization to join.</descrip></descripGrp><ntig><termGrp><term id="2613241">public team</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2805390">تیم عمومی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4645_39469_1498816"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Windows program that collects and displays for users the system-level features of the computer, including hardware and software setup and configuration.</descrip></descripGrp><ntig><termGrp><term id="39469">Control Panel</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1498816">صفحۀ کنترول</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46478_2615085_2617986"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The security feature that protects your device by providing startup and runtime protections that the operating system can validate and report on.</descrip></descripGrp><ntig><termGrp><term id="2615085">System Guard</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2617986">گارد سیستم</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46479_2615093_2617391"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The remote attestation service that checks the health of Windows 10-based devices to allow or deny access to networks, apps, or services, based on whether devices prove to be healthy.</descrip></descripGrp><ntig><termGrp><term id="2615093">Windows Health Attestation Service</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2617391">سرویس تأییدیه صحت Windows</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46481_2615123_2617367"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The area in Windows Defender Security Center that helps customers keep their devices refreshed and up to date with the latest version of Windows 10. Device health advisor monitors the device and provides information and recommendations in a Health report to address common issues with storage capacity, device drivers, battery life, or Windows Update.</descrip></descripGrp><ntig><termGrp><term id="2615123">Device performance &amp; health</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2617367">کارآیی و صحت دستگاه</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4649_50166_1897179"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A typographical unit of measure that is equal in width to the point size of a particular font. For many fonts, this is equal to the width of a capital M, from which the em space takes its name.</descrip></descripGrp><ntig><termGrp><term id="50166">em space</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1897179">فاصله em</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="465_380990_1354609"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of users that can be created on a SharePoint site to manage permissions to the site and to provide an email distribution list for site users. A group can be used by many sites in one site collection.</descrip></descripGrp><ntig><termGrp><term id="380990">SharePoint group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1354609">گروه SharePoint</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46505_2618212_2620826"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tenant that consists of a central location and one or more satellite geo locations.</descrip></descripGrp><ntig><termGrp><term id="2618212">Multi-Geo tenant</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2620826">بسیار جغرافیایی مستاجر</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4651_184009_1897402"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The original URL from the request context or higher level OM call.</descrip></descripGrp><ntig><termGrp><term id="184009">incoming URL</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1897402">URL دریافتی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46511_2618261_2620825"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The single web portal where Microsoft 365 admins can manage user accounts and settings for each of the Microsoft 365 services they subscribe to.</descrip></descripGrp><ntig><termGrp><term id="2618261">Microsoft 365 admin center</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2620825">Microsoft 365 مرکز سرپرستی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46511_2690503_2620825"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The single web portal where Microsoft 365 admins can manage user accounts and settings for each of the Microsoft 365 services they subscribe to.</descrip></descripGrp><ntig><termGrp><term id="2690503">Admin Center</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2620825">Microsoft 365 مرکز سرپرستی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46512_2618262_2620827"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Immersive Reader feature that shows a picture when you click on a word.</descrip></descripGrp><ntig><termGrp><term id="2618262">Picture Dictionary</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2620827">لغتنامه تصویر</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46514_2618265_2620976"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Excel mode where a user can move to the next nonblank cell in the same column or row as the active cell.</descrip></descripGrp><ntig><termGrp><term id="2618265">End mode</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2620976">حالت پایان</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4652_236971_1499531"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A software that was installed on the system without user's consent.</descrip></descripGrp><ntig><termGrp><term id="236971">unwanted software</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1499531">نرم افزار ناخواست</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46533_2619438_2620132"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature in Windows Defender Security Center that helps protect devices running Windows 10 by checking web content that Microsoft Store apps use.​</descrip></descripGrp><ntig><termGrp><term id="2619438">App protection</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2620132">محافظت برنامه</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46534_2619566_2620134"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature in Windows Defender Security Center that helps protect devices running Windows 10 from malicious websites and downloads.​​</descrip></descripGrp><ntig><termGrp><term id="2619566">Web protection</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2620134">محافظت وب</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46556_2619828_2623896"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office add-in that helps users learn how to use JavaScript APIs by allowing them to create and edit JavaScript, HTML, and CSS within Word, Excel, and PowerPoint, giving them references to libraries and data on the web, and allowing them to run the code and see the result in a task pane within the Office application.</descrip></descripGrp><ntig><termGrp><term id="2619828">Script Lab</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2623896">Script Lab</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46568_2620200_2621991"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A person who is under the age of full legal responsibility.</descrip></descripGrp><ntig><termGrp><term id="2620200">minor</t