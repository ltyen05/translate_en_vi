e Outlook ribbon button that launches a pane where users can use Outlook Customer Manager.</descrip></descripGrp><ntig><termGrp><term id="2408959">Customer Manager</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2414968">Customer Manager</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42496_2408960_2414969"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Writing Assistant feature that gives users feedback (fluency score) based on the complexity of sentence and vocabulary, where a low score would reflect simple vocabulary and simple sentence structure and a high score would reflect complex sentence structure and high-level vocabulary.</descrip></descripGrp><ntig><termGrp><term id="2408960">Fluency Score</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2414969">تسلط امتیاز</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42526_2410029_2416814"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A condition of being protected from danger or risk.</descrip></descripGrp><ntig><termGrp><term id="2410029">safety</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2416814">ایمنی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42529_2410032_2416809"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A failure of a program operation that causes the operation to stop completely.</descrip></descripGrp><ntig><termGrp><term id="2410032">hard fail</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2416809">سخت شکست</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42530_2410033_2416815"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A failure of a program operation where the failure is recorded and the operation continues on.</descrip></descripGrp><ntig><termGrp><term id="2410033">soft fail</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2416815">نرم شکست</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42531_2410034_2416806"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The PowerPoint button that opens a tab with a specialized version of the app store where users can find materials related to education so that those materials can be included in their deck.</descrip></descripGrp><ntig><