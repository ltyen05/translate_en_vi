>A COM-based multimedia platform and infrastructure for digital media in Microsoft Windows. It focuses on content protection, audio and video quality, and interoperability for digital rights management (DRM).</descrip></descripGrp><ntig><termGrp><term id="1044558">Media Foundation</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1769886">بنیاد رسانه ها</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22433_1044558_1769887"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A COM-based multimedia platform and infrastructure for digital media in Microsoft Windows. It focuses on content protection, audio and video quality, and interoperability for digital rights management (DRM).</descrip></descripGrp><ntig><termGrp><term id="1044558">Media Foundation</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1769887">بنیاد رسانه های Microsoft</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2244_142353_1797403"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An individual box or button with which users enter information on an electronic form.</descrip></descripGrp><ntig><termGrp><term id="142353">form control</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1797403">فورمه کنترول</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2246_2573055_1498617"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A quality of a product to be directly or indirectly usable by individuals with disabilities.</descrip></descripGrp><ntig><termGrp><term id="2573055">a11y</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1498617">قابلیت دسترسی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2246_2573055_2578629"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A quality of a product to be directly or indirectly usable by individuals with disabilities.</descrip></descripGrp><ntig><termGrp><term id="2573055">a11y</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2578629">a11y</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2246_7442_1498617"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A quality of a product to be directly or indirectly usable by individuals with disabilities.</descrip></descripGrp><ntig><termGrp><term id="7442">accessibility</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1498617">قابلیت دسترسی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2246_7442_2578629"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A quality of a product to be directly or indirectly usable by individuals with disabilities.</descrip></descripGrp><ntig><termGrp><term id="7442">accessibility</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2578629">a11y</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22460_1045690_1897831"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A calendar for a group.</descrip></descripGrp><ntig><termGrp><term id="1045690">group calendar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1897831">تقویم گروهی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22470_1045704_1527223"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method of blocking access to websites based on their content. For example, In Windows Live Family Safety, parents can specify a filtering level, such as Strict or Basic, for their child.</descrip></descripGrp><ntig><termGrp><term id="1045704">web filtering</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1527223">فلتر کردن وب</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22482_1045718_2299141"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A person authorized to manage and make certain changes to a group, such as to approve a membership request.</descrip></descripGrp><ntig><termGrp><term id="1045718">group owner</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2299141">مالک گروه</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2250_527637_1527061"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to a process, tool, etc. that is enabled by Windows Live.</descrip></descripGrp><ntig><termGrp><term id="527637">powered by Windows Live</term><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1527061">اداره شده توسط Windows Live</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22509_1047681_1499381"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A search location exposed via .osdx templates and made possible via the OpenSearch technology. It connects the local search indexer to a remote index and provides the end user with the ability to search for files on a Web site or on an intranet site from within Windows.</descrip></descripGrp><ntig><termGrp><term id="1047681">search connector</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1499381">وصل دهندۀ جستجو</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22516_1047720_1698075"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Web site from Microsoft which provides solutions for the top issues about Windows Update or Microsoft Update, and enables you to contact a support professional.</descrip></descripGrp><ntig><termGrp><term id="1047720">Microsoft Update Solution Center</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1698075">مرکز حل مشکل Microsoft Update</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22533_1047904_1897832"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows users to build business logic in a new and easy-to-use authoring environment. The declarative, macro-style logic will run on client and server and includes both UI-level and data-level actions.</descrip></descripGrp><ntig><termGrp><term id="1047904">Data Macros</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1897832">ماکروهای ارقام</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22536_1047907_1506242"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that provides one-click filtering controls that make it easy to narrow down the portion of a data set that's being looked at.</descrip></descripGrp><ntig><termGrp><term id="1047907">Slicers</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1506242">بُرنده ها</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22541_1047912_1506243"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A miniature chart that can be inserted into text or embedded within a cell on a worksheet to illustrate highs, lows, and trends in your data.</descrip></descripGrp><ntig><termGrp><term id="1047912">sparkline</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1506243">خط جرقه</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22543_1047914_1506244"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Outlook Calendar view in which each calendar is listed vertically (not side-by-side). This view is optimized for viewing a schedule for a group and scheduling a meeting for a group.</descrip></descripGrp><ntig><termGrp><term id="1047914">Schedule View</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1506244">دید تقسیم اوقات</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22545_1047918_1506245"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that converts each slide in a presentation into a single image and rebuilds a new, compressed PPT presentation that can easily be shared, but not edited.</descrip></descripGrp><ntig><termGrp><term id="1047918">Picture Presentation</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1506245">نمایش تصویری</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22561_1048326_1531089"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A viewer that allows users to display Excel workbooks on a phone’s browser. A file is rendered as an HTML page with sufficient fidelity to convey important data or charts and illustrations.</descrip></descripGrp><ntig><termGrp><term id="1048326">Excel Mobile Viewer</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1531089">نمایشگر Excel موبایل</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22562_1048367_1531196"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A viewer that allows users to display Word documents on a phone’s browser. A file is rendered as an HTML page with sufficient fidelity to convey text and images on a small screen.</descrip></descripGrp><ntig><termGrp><term id="1048367">Word Mobile Viewer</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1531196">نمایشگر Word موبایل</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2257_183896_1897398"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables the user to compact or collapse rows when viewing several levels of data.</descrip></descripGrp><ntig><termGrp><term id="183896">compact row axis</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1897398">محور فشرده سازی سطر</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2260_2421477_2426918"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft program that allows users to select and print a variety of customizable calendar templates.</descrip></descripGrp><ntig><termGrp><term id="2421477">Calendar Printing Assistant</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2426918">سالنمای چاپ دستیار</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2260_331777_2426918"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft program that allows users to select and print a variety of customizable calendar templates.</descrip></descripGrp><ntig><termGrp><term id="331777">Calendar Printing Assistant for Microsoft® Office Outlook® 2007</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2426918">سالنمای چاپ دستیار</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22615_1050744_2258746"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A numeric keypad that is part of a device, is displayed on a device, or is in a computer program that you use to enter information in the context of a phone call.</descrip></descripGrp><ntig><termGrp><term id="1050744">dial pad</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2258746">صفحه شماره گیری</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22615_3188175_2258746"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A numeric keypad that is part of a device, is displayed on a device, or is in a computer program that you use to enter information in the context of a phone call.</descrip></descripGrp><ntig><termGrp><term id="3188175">dialpad</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2258746">صفحه شماره گیری</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22629_1052639_2578630"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of creating a hyperlink to a specific page within a Web site or Web-based application instead of to the site’s home page.</descrip></descripGrp><ntig><termGrp><term id="1052639">deep linking</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2578630">پیوند عمیق</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22631_1052824_1527177"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An icon that is attached to an event and that is viewable in someone's calendar. Depending on the calendar view, a charm may appear next to an event title, or may be the only visual representation of an event on a calendar day.</descrip></descripGrp><ntig><termGrp><term id="1052824">charm</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1527177">مورد جذاب</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22632_1052846_1897833"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A traditional graphics plotter that uses pens to draw on paper. Pen plotters use one or more colored pens, either fiber-tipped pens or, for highest-quality output, drafting pens.</descrip></descripGrp><ntig><termGrp><term id="1052846">pen plotter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1897833">پلاتر قلمی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22638_1052853_2701072"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A pointer to nothing: usually a standardized memory address, such as 0. A null pointer usually marks the last of a linear sequence of pointers or indicates that a data search operation has come up empty.</descrip></descripGrp><ntig><termGrp><term id="1052853">null pointer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2701072">نشانگر خالی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22638_1052854_2701072"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A pointer to nothing: usually a standardized memory address, such as 0. A null pointer usually marks the last of a linear sequence of pointers or indicates that a data search operation has come up empty.</descrip></descripGrp><ntig><termGrp><term id="1052854">nil pointer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2701072">نشانگر خالی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22646_1053493_1897834"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The part of an email address that identifies a user or an account on an email system.</descrip></descripGrp><ntig><termGrp><term id="1053493">account name</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1897834">نام حساب</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22665_1053565_2299267"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An email message that is sent by a notification activity.</descrip></descripGrp><ntig><termGrp><term id="1053565">notification message</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2299267">پیام آگهی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22668_1053572_2299272"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A part of a schema that defines the representation of a resource in ILM "2".</descrip></descripGrp><ntig><termGrp><term id="1053572">object type</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2299272">نوع شیی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2267_318112_1354530"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A server built upon and integrated with the Microsoft Windows SharePoint Services platform to enable Web-based use of InfoPath form templates, by rendering editable InfoPath forms in HTML in the browser.</descrip></descripGrp><ntig><termGrp><term id="318112">InfoPath Forms Services</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1354530">InfoPath Forms Services</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2268_184296_1499078"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A searchable collection of articles and facts about a particular subject area.</descrip></descripGrp><ntig><termGrp><term id="184296">knowledge base</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1499078">KB</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2268_184296_2299181"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A searchable collection of articles and facts about a particular subject area.</descrip></descripGrp><ntig><termGrp><term id="184296">knowledge base</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2299181">پایگاه دانش</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2268_351589_1499078"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A searchable collection of articles and facts about a particular subject area.</descrip></descripGrp><ntig><termGrp><term id="351589">KB</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1499078">KB</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2268_351589_2299181"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A searchable collection of articles and facts about a particular subject area.</descrip></descripGrp><ntig><termGrp><term id="351589">KB</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2299181">پایگاه دانش</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22692_1053737_2299300"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A procedure by which a user's password can be changed to a known value, in situations where the user has forgotten or lost their password.</descrip></descripGrp><ntig><termGrp><term id="1053737">password reset</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2299300">تنظیم کردن مجدد رمز عبور</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22734_1054764_1506246"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A view that shows all of the resources on a project and their work over time. This makes it easy to rearrange work, schedule new work, and manage a team's load.</descrip></descripGrp><ntig><termGrp><term id="1054764">Team Planner</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1506246">برنامه ریزی گروهی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22735_1054767_1506223"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows the application of tags to individual Outlook items to specify retention policy for that message, conversation or other item.</descrip></descripGrp><ntig><termGrp><term id="1054767">Retention Policy</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1506223">مقررات نگهداری</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22771_1054905_2299488"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user interface implemented by a software application via a component of a web server, such as IIS.</descrip></descripGrp><ntig><termGrp><term id="1054905">web portal</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2299488">پورتل ویب</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22781_1054938_2314446"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To permit someone else to perform an action.</descrip></descripGrp><ntig><termGrp><term id="1054938">allow</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2314446">اجازه دادن</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2279_26594_1498729"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A piece of software that functions as an electronic calendar used for scheduling.</descrip></descripGrp><ntig><termGrp><term id="26594">calendar program</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1498729">سالنما</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2279_26594_2298965"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A piece of software that functions as an electronic calendar used for scheduling.</descrip></descripGrp><ntig><termGrp><term id="26594">calendar program</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2298965">پروگرام سالنما</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2279_294450_1498729"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A piece of software that functions as an electronic calendar used for scheduling.</descrip></descripGrp><ntig><termGrp><term id="294450">calendar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1498729">سالنما</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2279_294450_2298965"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A piece of software that functions as an electronic calendar used for scheduling.</descrip></descripGrp><ntig><termGrp><term id="294450">calendar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2298965">پروگرام سالنما</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22798_1055051_2701076"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A microprocessor architecture developed in 1992 by Motorola and IBM, with some participation by Apple. A PowerPC microprocessor is RISC-based and superscalar, with a 64-bit data bus and 32-bit address bus. It also has separate data and instruction caches, although the size of each varies by implementation. All PowerPC microprocessors have multiple integer and floating-point units. The voltage and operating speed varies with the implementation. Starting with the PowerPC 740, the microprocessors were manufactured with copper, instead of aluminum, for better performance and reliability.</descrip></descripGrp><ntig><termGrp><term id="1055051">PowerPC</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2701076">PowerPC</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22823_1055132_1498681"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The navigation button used to return to recently visited Web pages in Internet Explorer, Microsoft Edge, and other internet browsers.</descrip></descripGrp><ntig><termGrp><term id="1055132">Back</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1498681">عقب</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22826_1055147_2299008"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A staging area that contains representations of selected objects and attributes in a connected data source.</descrip></descripGrp><ntig><termGrp><term id="1055147">connector space</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2299008">فضای اتصال دهنده</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22828_1055149_2299233"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The data store that is used by ILM to contain the aggregated identity information from multiple connected data sources, providing a single global, integrated view of all combined objects.</descrip></descripGrp><ntig><termGrp><term id="1055149">metaverse</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2299233">متاورس</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2285_109836_1897222"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A join in which records from a table are combined with other records from the same table when there are matching values in the joined fields. A self-join can be an inner join or an outer join. In database diagrams, a self-join is called a reflexive relationship.</descrip></descripGrp><ntig><termGrp><term id="109836">self-join</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1897222">خود ملحق</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22865_1055946_1498842"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Information that describes the current location of a computer. The location is entered manually in Default Location, and can be used by programs to determine the location of a computer when a location sensor is unavailable.</descrip></descripGrp><ntig><termGrp><term id="1055946">default location</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1498842">موقعیت حالت اصلی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22886_1056046_2299423"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A software system that retrieves information from a source data store and synchronizes (pushes) to a target data store. Examples of synchronization engines are the ILM 2007 and FIM 2010 synchronization engines, and the service that synchronizes data rows in the SQL Server Express database with objects in the Microsoft Office Outlook data store.</descrip></descripGrp><ntig><termGrp><term id="1056046">synchronization engine</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2299423">انجن همگام سازی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22886_1056047_2299423"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A software system that retrieves information from a source data store and synchronizes (pushes) to a target data store. Examples of synchronization engines are the ILM 2007 and FIM 2010 synchronization engines, and the service that synchronizes data rows in the SQL Server Express database with objects in the Microsoft Office Outlook data store.</descrip></descripGrp><ntig><termGrp><term id="1056047">SyncEngine</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2299423">انجن همگام سازی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22889_1056052_2299345"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To refuse to accept a file or message.</descrip></descripGrp><ntig><termGrp><term id="1056052">reject</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2299345">رد کردن</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22891_1056055_1354577"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The initial user reference guide or piece of documentation for using a device or feature.</descrip></descripGrp><ntig><termGrp><term id="1056055">Quick Start Guide</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1354577">رهنما آغاز نمودن سریع</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2290_103825_1499341"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Generally, any part of a computer system or network, such as a disk drive, printer, or memory, that can be allotted to a running program or a process.</descrip></descripGrp><ntig><termGrp><term id="103825">resource</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1499341">وسیله</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22904_1056071_2298978"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of components and services that enable users to access their Exchange mailboxes through the Outlook Web Access application.</descrip></descripGrp><ntig><termGrp><term id="1056071">Client Access server</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2298978">سرور دسترسی متقاضی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2291_184207_1897415"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The hierarchical HTML tag structure of an opened HTML document that appears in a task pane window.</descrip></descripGrp><ntig><termGrp><term id="184207">tag tree</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1897415">شجر علامتگذاری</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22911_1056204_1499382"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A term that can be added to a search to filter the results by a specific property (for example, by author). Relevant search filters appear under the search box in any open folder.</descrip></descripGrp><ntig><termGrp><term id="1056204">search filter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1499382">تصفیه کنندۀ جستجو</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22919_1056243_2298906"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of Internet Protocol subnets, usually used to connect a group of computers that are physically close to each other.</descrip></descripGrp><ntig><termGrp><term id="1056243">Active Directory site</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2298906">سایت دایریکتوری فعال</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22926_1056255_2298903"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of sign-in credentials (username and password) for an Active Directory account.</descrip></descripGrp><ntig><termGrp><term id="1056255">Active Directory credentials</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2298903">مشخصات کاربری دایریکتوری فعال</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22928_1056257_2298902"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The identity of a user, which can be used to grant access to resources or authority to perform certain tasks.</descrip></descripGrp><ntig><termGrp><term id="1056257">Active Directory account</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2298902">حساب دایریکتوری فعال</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2293_79701_1499165"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A rectangular bar displayed in an application's window, often at the top, from which menus can be selected by the user.</descrip></descripGrp><ntig><termGrp><term id="79701">menu bar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1499165">نوار منیو</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22951_1056450_1506248"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A two-way device provided by a cable provider that enables some one-way digital CableCARD-based consumer electronic devices such as high-definition DVRs and Media Center PCs to access digital cable channels delivered using switched digital video.</descrip></descripGrp><ntig><termGrp><term id="1056450">tuning adapter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1506248">TA</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22951_1056452_1506248"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A two-way device provided by a cable provider that enables some one-way digital CableCARD-based consumer electronic devices such as high-definition DVRs and Media Center PCs to access digital cable channels delivered using switched digital video.</descrip></descripGrp><ntig><termGrp><term id="1056452">TA</term><termNote type="part