ected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22342_1043701_1506241"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A node that makes cached data available to clients needing to retrieve the data.</descrip></descripGrp><ntig><termGrp><term id="1043701">peer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1506241">همتا</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22362_1043933_1354454"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of maintaining backup files and putting them back onto the source medium if necessary.</descrip></descripGrp><ntig><termGrp><term id="1043933">backup and restore</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1354454">نسخۀ پشتیبان و برگردان</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22364_1043935_1953842"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A streaming technology that quickly installs Office over the Internet, internal networks, local file systems, or from offline media.</descrip></descripGrp><ntig><termGrp><term id="1043935">Click-to-Run</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSe