rmEntry id="1114_4659_2299410"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A password that cannot be easily guessed or cracked and which is at least eight characters long, does not contain all or part of the user's account name, and contains at least three of the four following categories of characters: uppercase characters, lowercase characters, numbers, and symbols found on the keyboard (such as !, @, #).</descrip></descripGrp><ntig><termGrp><term id="4659">strong password</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2299410">رمز عبور قدرتمند</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11140_359992_2299114"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A table outside the open database or project.</descrip></descripGrp><ntig><termGrp><term id="359992">external table</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2299114">جدول خارجی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11141_79960_1897200"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The content that is delivered in an email message.</descrip></descripGrp><ntig><termGrp><term id="79960">message body</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lan