"1275614">User Profile service</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1531185">خدمات نمایۀ استفاده کننده</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26518_1275616_1897988"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SharePoint service application that collects, reports, and analyzes the usage and effectiveness of SharePoint Server sites.</descrip></descripGrp><ntig><termGrp><term id="1275616">Web Analytics service application</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1897988">برنامه خدمات تحلیلی وب</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26519_1275617_1531160"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A service over which the administration (that is all the methods necessary to control the Search service, such as starting content source index crawls, updating scopes, etc.) of the Microsoft Office SharePoint Search service takes place.</descrip></descripGrp><ntig><termGrp><term id="1275617">Search Administration Web Service</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1531160">خدمات وب سرپرستی جستجو</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26522_1275648_2299285"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The messaging system that an administrator runs on their own servers in their own company as compared to a messaging system that is run in the cloud (hosted).</descrip></descripGrp><ntig><termGrp><term id="1275648">on-premises messaging system</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2299285">سیستم تبادله پیام نصب شده در دستگاه</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26524_1275651_2299315"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An account that can receive mail using the POP3 protocol.</descrip></descripGrp><ntig><termGrp><term id="1275651">POP-enabled account</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2299315">حساب با POP فعال</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26525_1275652_2299323"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The email address that appears in the E-Mail Options section of the user's mailbox in the Web management interface for Outlook Live.</descrip></descripGrp><ntig><termGrp><term id="1275652">primary e-mail address</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2299323">آدرس ایمیل اصلی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26526_1275654_2299341"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An object that represents a user or resource in Outlook, generally a mail message addressee.</descrip></descripGrp><ntig><termGrp><term id="1275654">recipient object</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2299341">شیی گیرنده</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26527_1275656_2299344"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The domain that an administrator has registered with a domain registrar.</descrip></descripGrp><ntig><termGrp><term id="1275656">registered domain</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2299344">دومین راجستر شده</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26529_1275659_2299397"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process by which a user presses and holds a key on their mobile phone keypad to dial a specific phone number.</descrip></descripGrp><ntig><termGrp><term id="1275659">speed dialing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2299397">شماره گیری فوری</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26530_1275661_2299073"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The settings, related to the domain, a user needs to configure to get messaging up and running.</descrip></descripGrp><ntig><termGrp><term id="1275661">domain settings</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2299073">تنظیمات دومین</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26549_1275967_1531139"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The client-side SharePoint Server control that allows users to search for and select valid user accounts for people, groups, and claims in their organization to grant permission to items such as lists, libraries, or SharePoint sites.</descrip></descripGrp><ntig><termGrp><term id="1275967">People Picker</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1531139">انتخاب کننده مردم</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26550_1275968_1897989"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The listing of contents created by bookmarking blocks of text and creating the table of contents of the bookmarked area.</descrip></descripGrp><ntig><termGrp><term id="1275968">ookmark TOC</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1897989">نشانی TOC</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26551_1275969_1897990"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An administrative setting for a keyword that specifies how to transform query text that contains the keyword, before executing the query against a search index.</descrip></descripGrp><ntig><termGrp><term id="1275969">search setting</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1897990">تنظیمات جستجو</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26552_1275970_1531189"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Web Part available to end users that displays the most frequently viewed content and search queries.</descrip></descripGrp><ntig><termGrp><term id="1275970">Web Analytics Web Part</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1531189">Web Analytics تحلیل وب</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26554_1276172_2299496"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The window that contains the user's workbook of tabbed sheets.</descrip></descripGrp><ntig><termGrp><term id="1276172">workbook window</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2299496">پنجره کتاب کار</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26555_1276173_1498973"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A prewritten formula that simplifies the process of entering calculations and enables the user to use formulas that might be difficult to build from scratch.</descrip></descripGrp><ntig><termGrp><term id="1276173">function</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1498973">کارکرد</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26558_1276179_2052084"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of Human Interaction Proof challenge, which plays an audio file decipherable only by a person. The audio file might seem faint or mixed with background voices and noise. This is intentional to ensure a person, not an automated program, completes the HIP challenge.</descrip></descripGrp><ntig><termGrp><term id="1276179">audio challenge</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2052084">چالش صوتی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26565_1276491_1531179"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Web Part that displays all items that belong to a given tag.</descrip></descripGrp><ntig><termGrp><term id="1276491">Tagged Items</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1531179">عناصر تگ شده</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26571_1276626_1506276"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A range of cells in a worksheet that has been formatted as a table and can be managed independently from the data in other rows and columns on the worksheet.</descrip></descripGrp><ntig><termGrp><term id="1276626">Excel table</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1506276">جدول Excel</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26581_1278354_1897991"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A typographical unit of measure that is equal in width to the point size of a particular font. For many fonts, this is equal to the width of a capital N, from which the en space takes its name.</descrip></descripGrp><ntig><termGrp><term id="1278354">en space</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1897991">فاصله en</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26585_1280041_2299307"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user who doesn't file mailbox items regularly.</descrip></descripGrp><ntig><termGrp><term id="1280041">piler</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2299307">پایلر</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26585_1280041_2299308"><langSet xml: