riod of time near the user's status that is meant to give additional information on their status.</descrip></descripGrp><ntig><termGrp><term id="2761622">status message</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2765891">پیام وضعیت</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48793_2761632_2765894"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A live Skype experience that can be chosen from a set of pre-determined options organized by different Skype in the Classroom partners for an interactive educational experience within a classroom.</descrip></descripGrp><ntig><termGrp><term id="2761632">virtual field trip</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2765894">سیر علمی مجازی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48905_2765592_2769343"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The application that accepts PSTN calls, plays prompts, and joins the calls to an A/V conference.</descrip></descripGrp><ntig><termGrp><term id="2765592">Conferencing Attendant</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2769343">برنامه همراه تدویر کنفرانس</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48905_2765592_2784351"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The application that accepts PSTN calls, plays prompts, and joins the calls to an A/V conference.</descrip></descripGrp><ntig><termGrp><term id="2765592">Conferencing Attendant</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2784351">اشتراک کننده تدویر کنفرانس</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48905_2765593_2769343"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The application that accepts PSTN calls, plays prompts, and joins the calls to an A/V conference.</descrip></descripGrp><ntig><termGrp><term id="2765593">Conferencing Attendant application</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2769343">برنامه همراه تدویر کنفرانس</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48905_2765593_2784351"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The application that accepts PSTN calls, plays prompts, and joins the calls to an A/V conference.</descrip></descripGrp><ntig><termGrp><term id="2765593">Conferencing Attendant application</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2784351">اشتراک کننده تدویر کنفرانس</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4894_84648_2299265"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A member of the TCP/IP suite of protocols used to distribute network news messages to NNTP servers and clients (newsreaders) on the Internet. NNTP is designed so that news articles are stored on a server in a central database, thus enabling a user to select specific items to read.</descrip></descripGrp><ntig><termGrp><term id="84648">Network News Transfer Protocol</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2299265">پروتکول انتقال اخبار شبکه</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4894_84649_2299265"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A member of the TCP/IP suite of protocols used to distribute network news messages to NNTP servers and clients (newsreaders) on the Internet. NNTP is designed so that news articles are stored on a server in a central database, thus enabling a user to select specific items to read.</descrip></descripGrp><ntig><termGrp><term id="84649">NNTP</term><termNote type="partOfSpeech">Noun</termNote><termNot