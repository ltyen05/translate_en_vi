tion about mailbox searches that includes information about all results that meet the search criteria.</descrip></descripGrp><ntig><termGrp><term id="1275544">full logging</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2299132">واقعه نگاری مکمل</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26510_1275547_2298957"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A window that serves as an interface between the user and the browser.</descrip></descripGrp><ntig><termGrp><term id="1275547">browser window</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2298957">پنجره مرورگر</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26511_1275548_2298958"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A role group that ships by default as opposed to a customized role group that a admin would customize specifically for the needs of their organization</descrip></descripGrp><ntig><termGrp><term id="1275548">built-in role group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2298958">گروه نقش جا داده شده</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGend