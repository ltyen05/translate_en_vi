ientation, or landscape, which is the wider-than-tall orientation.</descrip></descripGrp><ntig><termGrp><term id="395929">page orientation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1499220">جهت</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7476_88742_1499220"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The direction a publication will be printed on a sheet of paper. You can choose either portrait, which is the taller-than-wide orientation, or landscape, which is the wider-than-tall orientation.</descrip></descripGrp><ntig><termGrp><term id="88742">orientation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1499220">جهت</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="749_139172_2298953"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An expression which results in a true or false value when calculated.</descrip></descripGrp><ntig><termGrp><term id="139172">conditional expression</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2298953">عبارت بولی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNot