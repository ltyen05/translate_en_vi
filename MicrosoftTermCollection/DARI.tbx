="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2456522">خط کش مجازی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43350_2455378_2482532"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A series of characters used to verify an account.</descrip></descripGrp><ntig><termGrp><term id="2455378">verification code</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2482532">کد تایید</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4336_90707_2299298"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A value used in programming that is given to a variable, either at the beginning of an operation or before an expression is evaluated by a program.</descrip></descripGrp><ntig><termGrp><term id="90707">parameter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2299298">پارامیتر</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43370_2457378_2463297"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office feature that recognizes hand-drawn inked shapes and converts them into computer-generated looking shapes and that provides support for diagram making, shape manipulation and that provides shape information.</descrip></descripGrp><ntig><termGrp><term id="2457378">Ink to shape</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2463297">جوهر برای شکل دادن به</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43372_2457380_2463290"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Outlook view that leaves emails formatted like classic email threads.</descrip></descripGrp><ntig><termGrp><term id="2457380">Classic</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2463290">کلاسیک</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43374_2490692_2500793"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Outlook view that highlights emails that are part of a thread and then shows that thread as a conversation.</descrip></descripGrp><ntig><termGrp><term id="2490692">Conversational</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2500793">محاورهای</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43393_2457752_2463295"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Editor feature that detects incorrect inflection and suggests corrections.</descrip></descripGrp><ntig><termGrp><term id="2457752">Incorrect Inflection</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2463295">درست بلندبالایی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43394_2457753_2463293"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Editor feature that detect unnatural collocation and suggests more natural phrasing.</descrip></descripGrp><ntig><termGrp><term id="2457753">Commonly Confused Phrases</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2463293">معمولا اشتباه عبارات</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43395_2457779_2463298"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Editor feature that detects errors in infinitive verb usage and suggests corrections.</descrip></descripGrp><ntig><termGrp><term id="2457779">Use of Plain Verb Form</term><termNot