60385_2465035"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A network status tag that appears underneath an available Wi-Fi network and allows to select it in Windows network flyout.</descrip></descripGrp><ntig><termGrp><term id="2460385">Open, suggested</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2465035">باز، پیشنهاد شده</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43456_2461302_2465755"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The tab in the Exchange admin center where users can create and use In-Place eDiscovery searches and use In-Place Hold search results.</descrip></descripGrp><ntig><termGrp><term id="2461302">In-Place eDiscovery &amp; Hold</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2465755">در محل های eDiscovery و نگه دارید</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43468_2721513_2722594"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that helps to isolate enterprise-defined untrusted sites based on a list of trusted web sites, cloud resources and internal networks defined by an enterprise administrator. Everything not on that list is considered untrusted.</descrip></descripGrp><ntig><termGrp><term id="2721513">Application Guard</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2722594">گارد برنامه های کاربردی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43468_2795831_2722594"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that helps to isolate enterprise-defined untrusted sites based on a list of trusted web sites, cloud resources and internal networks defined by an enterprise administrator. Everything not on that list is considered untrusted.</descrip></descripGrp><ntig><termGrp><term id="2795831">Microsoft Defender Application Guard</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2722594">گارد برنامه های کاربردی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43472_2795843_2465025"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The umbrella name for the Windows vulnerability mitigation features designed to address inherently technical attacks and prevent discovered vulnerabilities from being exploited.</descrip></descripGrp><ntig><termGrp><term id="2795843">Microsoft Defender Exploit Guard</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2465025">مدافع Windows بهرهبرداری گارد</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4349_58489_1498985"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to an entire entity such as document, file, or program rather than to a restricted segment of it.</descrip></descripGrp><ntig><termGrp><term id="58489">global</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1498985">جهانی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43506_2462246_2465034"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The mixed-reality shell experience, in which content can be placed and used in virtual (or, in the case of HoloLens, real) surroundings.</descrip></descripGrp><ntig><termGrp><term id="2462246">mixed world</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2465034">جهان مخلوط</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4353_151854_2234148"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method of delivering digital media across a network in a continuous flow. The digital media is played by client software as it is received.</descrip></descripGrp><ntig><termGrp><term id="151854">streaming</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2234148">نشر آنلاین رسانه</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4353_2227182_2234148"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method of delivering digital media across a network in a continuous flow. The digital media is played by client software as it is received.</descrip></descripGrp><ntig><termGrp><term id="2227182">media streaming</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2234148">نشر آنلاین رسانه</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43608_2464387_2465036"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A UI screen that appears in the Network flyout when a paid Wi-Fi hotspot is in range and paid Wi-Fi plans are available from Windows Store. A customer can then tap Connect with a data plan to open the Paid Wi-Fi &amp; Cellular app, choose a paid Wi-Fi data plan that’s offered from Windows Store, and then buy a plan using the payment information that’s stored in their Microsoft account.</descrip></descripGrp><ntig><termGrp><term id="2464387">Connect with a data plan</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="p