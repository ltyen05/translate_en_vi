.</descrip></descripGrp><ntig><termGrp><term id="648543">quota message</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2299337">پیام سهمیه</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17497_648614_1796206"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The expected total cost of a task or project, based on performance as of the status date. EAC is calculated as follows: EAC = ACWP + (BAC-BCWP)/CPI.</descrip></descripGrp><ntig><termGrp><term id="648614">estimate at completion</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1796206">EAC</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17497_648615_1796206"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The expected total cost of a task or project, based on performance as of the status date. EAC is calculated as follows: EAC = ACWP + (BAC-BCWP)/CPI.</descrip></descripGrp><ntig><termGrp><term id="648615">EAC</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1796206">EAC</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="gram