Set xml:lang="en-US"><descripGrp><descrip type="definition">A property whose value can be set to the Uniform Resource Identifier (URI) of the dictionary, an error message, or an empty string if no dictionary URI is found.</descrip></descripGrp><ntig><termGrp><term id="397141">Dictionary property</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2299046">خصوصیت لغتنامه</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1053_181699_1505718"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A static report that contains data captured at a specific point in time.</descrip></descripGrp><ntig><termGrp><term id="181699">report snapshot</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1505718">عکس فوری</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1053_181699_1897395"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A static report that contains data captured at a specific point in time.</descrip></descripGrp><ntig><termGrp><term id="181699">report snapshot</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1897395">نمای فوری راپور</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</