><ntig><termGrp><term id="1112948">feature activation dependency</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1897873">وابستگی فعال شدن خصوصیت</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24197_1115314_1531110"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The text-based, data interchange format that is used to transmit structured data, typically in Ajax Web applications.</descrip></descripGrp><ntig><termGrp><term id="1115314">JavaScript Object Notation</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1531110">JSON</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24197_1115315_1531110"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The text-based, data interchange format that is used to transmit structured data, typically in Ajax Web applications.</descrip></descripGrp><ntig><termGrp><term id="1115315">JSON</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1531110">JSON</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24198_1115316_1897874"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An operation that requires more resources than are allowed by a threshold, based on the number of items or amount of information that is processed during the operation.</descrip></descripGrp><ntig><termGrp><term id="1115316">privileged task</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1897874">کار دارای امتیاز</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="242_184035_1354560"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A special storage location of templatized pages for performance enhancement.</descrip></descripGrp><ntig><termGrp><term id="184035">page output cache</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1354560">ذخیرۀ مؤقتی برای تولید صفحه</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2420_308318_1498926"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The date after which information or a resource is no longer valid.</descrip></descripGrp><ntig><termGrp><term id="308318">expiration date</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1498926">تاریخ انقضا</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24202_1115320_2299357"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process, thread, or set of related processes or threads that requires significant system resources or time, or requires exclusive access to large amounts of data.</descrip></descripGrp><ntig><termGrp><term id="1115320">resource-intensive task</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2299357">کار وابسته به منابع</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24205_1115323_1897875"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An extensible programming model and components that can be used to design and implement custom applications for common business processes, such as document approval. Components include version control, tracking, and reporting.</descrip></descripGrp><ntig><termGrp><term id="1115323">workflow foundation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1897875">بنیاد جریان کاری</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24206_1115324_1531063"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The object that is used to initiate any actions with the client-side object model. It is the primary entry point for the client object model, and the primary object for coordinating requests against corresponding objects in a site collection.</descrip></descripGrp><ntig><termGrp><term id="1115324">client context</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1531063">همبافتی مشتری</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24208_1115326_1897876"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A server-side code routine that is called when a feature is activated, deactivated, installed, uninstalled, or upgraded on a computer, server farm, or server cluster.</descrip></descripGrp><ntig><termGrp><term id="1115326">feature event receiver</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1897876">دریافت کننده رویداد خصوصیت</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24209_1115327_1897877"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A statistic that indicates the degree to which a computer, server farm, or server cluster meets a specific demand for that configuration. It also indicates which log information to copy to a central location for review.</descrip></descripGrp><ntig><termGrp><term id="1115327">health tracking indicator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1897877">نشاندهندۀ تعقب صحی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24210_1115328_1897878"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A content type that inherits settings from a base content type that was designed for any type of SharePoint list item.</descrip></descripGrp><ntig><termGrp><term id="1115328">item-based content type</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1897878">نوع محتوا بر اساس فقره</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24211_1115329_1897879"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A content type that inherits settings from a base content type that was designed for document libraries.</descrip></descripGrp><ntig><termGrp><term id="1115329">document-based content type</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1897879">محتوای وابسته به مدرک</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24212_1119987_1531157"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A custom solution that can be deployed to a site by a site collection administrator, without approval from the farm administrator. Without that approval, the solution has full access to the immediate site and restricted access to system resources and other sites.</descrip></descripGrp><ntig><termGrp><term id="1119987">sandboxed solution</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1531157">حل جعبۀ ریگی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24213_1115331_1531109"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A persistent container that defines and stores instructions for a job to be run on a server, server farm, or server cluster. To run, a job must have an associated job definition, and a definition must be associated with a service or a Web application.</descrip></descripGrp><ntig><termGrp><term id="1115331">job definition</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1531109">تعریف وظیفه</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24214_1115332_1897880"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A dedicated, administrator-level user account that performs scheduled administrative tasks.</descrip></descripGrp><ntig><termGrp><term id="1115332">timer account</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1897880">حساب زمان سنج</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24215_1115333_1531176"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A compressed file that can be deployed to a server farm or a site. It can contain assemblies, resource files, site and feature definitions, templates, code access security policies, and Web Parts.</descrip></descripGrp><ntig><termGrp><term id="1115333">solution package</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1531176">بستۀ حل</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24216_1115334_1531175"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A custom keyword or description and shortcut to a Web page or item on a SharePoint site or the Internet. All of these tags can be viewed, managed, and shared by using My Site.</descrip></descripGrp><ntig><termGrp><term id="1115334">social tag</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1531175">تگ اجتماعی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24217_1115335_1897881"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of features that can be used to store and share comments, shortcuts, descriptions, and other information about Web pages and items on a SharePoint site or the Internet.</descrip></descripGrp><ntig><termGrp><term id="1115335">social data</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1897881">ارقام اجتماعی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24218_1115336_1897882"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A reserved time for performing administrative tasks on a computer, server farm, or server cluster.</descrip></descripGrp><ntig><termGrp><term id="1115336">service window</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1897882">صفحۀ خدمات</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24219_1115337_1897883"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An administrative setting that limits the number of query results for SharePoint lists, sites, and site collections that contain a large number of items.</descrip></descripGrp><ntig><termGrp><term id="1115337">query-size threshold</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1897883">حد اندازه استعلام</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24220_1115338_1897884"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A reserved time for performing large, resource-intensive queries for a computer, server farm, or server cluster.</descrip></descripGrp><ntig><termGrp><term id="1115338">query window</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1897884">صفحۀ استعلام</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24221_1115339_1531111"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A solution package that contains only a DLL that stores localized versions of strings in another solution package. After a language pack is deployed to a site, users can display the corresponding user interface in that language.</descrip></descripGrp><ntig><termGrp><term id="1115339">language pack</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1531111">بستۀ لسان</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24222_1115340_1531131"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An area for storing comments about a Web page. A note board can appear on a Web page or in a separate dialog box. The notes can be viewed, managed, and shared by using My Site.</descrip></descripGrp><ntig><termGrp><term id="1115340">note board</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1531131">لوحۀ یادداشت</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24223_1115341_1797380"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft SQL Server, MSDE, or WMSDE database that stores health monitoring and usage data temporarily, and can be used for reporting and diagnostics.</descrip></descripGrp><ntig><termGrp><term id="1115341">logging database</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1797380">دیتابیس وارد شدن</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24224_1115342_1897885"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A statistic that indicates the degree to which a computer, server farm, or server cluster meets usage demands for that configuration.</descrip></descripGrp><ntig><termGrp><term id="1115342">quality-of-service indicator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1897885">شاخص کیفیت خدمات</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24245_1117153_2314490"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An installation package that the user downloads from http://download.live.com/?mkt=en-us.</descrip></descripGrp><ntig><termGrp><term id="1117153">download</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2314490">دانلود</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24247_1117155_1527089"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The main landing or start page on Windows Live.</descrip></descripGrp><ntig><termGrp><term id="1117155">Windows Live Home</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1527089">صفحه اصلی Windows Live</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2425_34681_1498776"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A predefined set of harmonized colors that you can apply to text and objects. Text and objects with an applied scheme color will change automatically when you switch to a new color scheme or modify the current color scheme.</descrip></descripGrp><ntig><termGrp><term id="34681">color scheme</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1498776">طرح رنگ</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24287_1119142_1657945"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The button next to a search box that someone clicks to search for something.</descrip></descripGrp><ntig><termGrp><term id="1119142">Search button</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1657945">دکمۀ جستجو</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24304_1119174_1531164"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The shared service that securely stores credential sets for external data sources and associates those credential sets to identities of individuals or to group identities. This service can be used to support a variety of solutions. For example, the stored credentials can be leveraged by certain applications to enable single sign-on.</descrip></descripGrp><ntig><termGrp><term id="1119174">Secure Store Service</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1531164">خدمات ذخیرۀ ایمین</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24304_1162515_1531164"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The shared service that securely stores credential sets for external data sources and associates those credential sets to identities of individuals or to group identities. This service can be used to support a variety of solutions. For example, the stored credentials can be leveraged by certain applications to enable single sign-on.</descrip></descripGrp><ntig><termGrp><term id="1162515">SSS</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1531164">خدمات ذخیرۀ ایمین</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24304_2717982_1531164"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The shared service that securely stores credential sets for external data sources and associates those credential sets to identities of individuals or to group identities. This service can be used to support a variety of solutions. For example, the stored credentials can be leveraged by certain applications to enable single sign-on.</descrip></descripGrp><ntig><termGrp><term id="2717982">Secure Store</term><termNote type="partOfSpeech">ProperNoun<