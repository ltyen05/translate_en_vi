descrip></descripGrp><ntig><termGrp><term id="748513">Categories</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1498741">دسته جات</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20861_748513_1499489"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows the user to apply custom or default markers to items (e.g. Outlook messages or OneNote content) in order to categorize information for easy retrieval and sorting.</descrip></descripGrp><ntig><termGrp><term id="748513">Categories</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1499489">علامات</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20867_2676671_2678849"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that allows the user to fill cells with data that follows a pattern or that is based on data in other cells.</descrip></descripGrp><ntig><termGrp><term id="2676671">AutoFill</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2678849">پر کردن خودکار</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20867_752822_2678849"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that allows the user to fill cells with data that follows a pattern or that is based on data in other cells.</descrip></descripGrp><ntig><termGrp><term id="752822">Auto Fill</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2678849">پر کردن خودکار</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2087_22056_1796188"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A page where there is no information displayed</descrip></descripGrp><ntig><termGrp><term id="22056">blank page</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1796188">صفحۀ خالی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20874_757176_1897731"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tool used to turn on language-specific options for the languages one wants to use with a product.</descrip></descripGrp><ntig><termGrp><term id="757176">Language Settings tool</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1897731">ابزار تنظیمات لسان</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20883_759067_2314630"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of creating and sending text messages between or to mobile phones and devices using the SMS protocol.</descrip></descripGrp><ntig><termGrp><term id="759067">text messaging</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2314630">پیام کوتاه</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20884_759071_1499394"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Any hardware or software that can detect events or environmental changes, such as your current location or the amount of light around your computer. For example, a notebook with a location sensor, such as a Global Positioning System (GPS) receiver, can determine your exact location. An ambient light sensor can detect when there is a change in lighting, and then a program can use that information to adjust the brightness of your screen.</descrip></descripGrp><ntig><termGrp><term id="759071">sensor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1499394">حسگر</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20888_759108_1498987"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A device that includes an antenna, a radio receiver, and a processor for use with the worldwide GPS (Global Positioning System). A GPS receiver uses position and time information from four GPS satellites to calculate precise information about its current location, its speed of travel, and the current time.</descrip></descripGrp><ntig><termGrp><term id="759108">GPS receiver</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1498987">دریافت کنندۀ GPS</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20889_759109_1499135"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A category of sensor that can detect the current location of your computer.</descrip></descripGrp><ntig><termGrp><term id="759109">location sensor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1499135">حسگر موقعیت</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20907_759640_1499134"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An area within the Windows Control Panel that provides support for sensors such as enabling, disabling or uninstalling sensors and sensor-enabled applications, changing sensor settings, etc.</descrip></descripGrp><ntig><termGrp><term id="759640">Location and Other Sensors</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1499134">موقعیت و حسگرهای دیگر</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2091_50057_1498901"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A unit of information within a markup language that is defined by a tag, or a pair of tags surrounding some content, and includes any attributes defined within the initial tag.</descrip></descripGrp><ntig><termGrp><term id="50057">element</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1498901">عنصر</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20915_759738_1498843"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An area within the Windows Control Panel that allows the user to designate his home coordinates or address for location-aware functionalities.</descrip></descripGrp><ntig><termGrp><term id="759738">Default Location</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1498843">موقعیت حالت اصلی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20916_759739_1499512"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An arrangement of search results ordered by relevance using a special search algorithm.</descrip></descripGrp><ntig><termGrp><term id="759739">top results</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1499512">نتایج اعلی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20927_760006_1498849"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A gadget that users can display on their desktop, rather than on the Windows Sidebar. Examples are clocks, news headlines, slide shows, and weather forecasts.</descrip></descripGrp><ntig><termGrp><term id="760006">desktop gadget</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1498849">ابزار زمینه</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20948_760126_1897732"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of gathering information by sending and receiving HTML forms or InfoPath forms from Access.</descrip></descripGrp><ntig><termGrp><term id="760126">data collection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1897732">جمع آوری ارقام</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20981_761307_1796244"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A handler that displays a lightweight, read-only preview of a file’s contents without launching the application associated with the file. For example, a preview handler displays a Shell item in the Windows Explorer preview pane.</descrip></descripGrp><ntig><termGrp><term id="761307">previewer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1796244">پیش نمایش دهنده</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20981_761308_1796244"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A handler that displays a lightweight, read-only preview of a file’s contents without launching the application associated with the file. For example, a preview handler displays a Shell item in the Windows Explorer preview pane.</descrip></descripGrp><ntig><termGrp><term id="761308">preview handler</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1796244">پیش نمایش دهنده</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20984_761629_1527198"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collaborative action, such as sharing, calendar sharing, or using a whiteboard.</descrip></descripGrp><ntig><termGrp><term id="761629">activity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1527198">فعالیت</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20992_762951_2314508"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An email that a customer does not want delivered to their inbox, including spam and phishing messages (identified by the mail service) and messages from blocked senders and domains.</descrip></descripGrp><ntig><termGrp><term id="762951">junk e-mail</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2314508">ناخواسته</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20992_762956_2314508"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An email that a customer does not want delivered to their inbox, including spam and phishing messages (identified by the mail service) and messages from blocked senders and domains.</descrip></descripGrp><ntig><termGrp><term id="762956">junk</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2314508">ناخواسته</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20998_763011_1527172"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of colors and background images that lets users change the appearance of Windows Live pages. The theme is common to all pages, except for group, event, and space pages, which may each have their own theme.</descrip></descripGrp><ntig><termGrp><term id="763011">theme</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1527172">طرح زمینه</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20999_763132_1531145"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To copy something from a computer to a location online, such as a photo album or a blog post.</descrip></descripGrp><ntig><termGrp><term id="763132">publish</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1531145">نشر</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21000_763151_2314