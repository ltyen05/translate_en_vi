-AF"><ntig><termGrp><term id="1897840">جمع آوری معلومات صحت و استفاده</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23174_1060963_2314644"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The heading for information about the time at which something was added, changed, or re-posted.</descrip></descripGrp><ntig><termGrp><term id="1060963">updated</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2314644">بهنگام شده</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23177_1060970_1527188"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A customizable page that launches with Windows Live Messenger and features a summary of news and weather, allows a customer to preview their Windows Live Mail inbox and search the Internet.</descrip></descripGrp><ntig><termGrp><term id="1060970">Today page</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1527188">صفحه امروز</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23178_1060971_2314632"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The title of the window in which the Windows Live Messenger Today page is displayed.</descrip></descripGrp><ntig><termGrp><term id="1060971">Today</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2314632">امروز</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23180_1060974_1897841"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A text box where someone enters the email addresses of the primary recipients of an email message.</descrip></descripGrp><ntig><termGrp><term id="1060974">To box</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1897841">صندوق دریافت کننده</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23184_1060982_1946058"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of features that enables users to improve the quality of their images with just one or two clicks. Galleries help the user optimize characteristics such as brightness, contrast, color, and sharpness.</descrip></descripGrp><ntig><termGrp><term id="1060982">Corrections</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1946058">تصحیحات</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23200_1062908_1506250"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables Tablet PC users to convert an ink drawing to a standard OfficeArt shape, which can be formatted with colors and effects exactly as if it were inserted using “Insert Shape.”</descrip></descripGrp><ntig><termGrp><term id="1062908">Convert to Shape</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1506250">تبدیل به صورت</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23201_1062909_1946048"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables presenters to capture all the elements of a live presentation, including narration, slides, mouse clicks, A/V playback, and laser pointer highlights. The user can select which presentation aspects to record.</descrip></descripGrp><ntig><termGrp><term id="1062909">Record Slide Show</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1946048">ضبط نمایش سلاید</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23214_1064085_1657992"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A map view created from aerial photos that shows buildings, roads, and geographical features.</descrip></descripGrp><ntig><termGrp><term id="1064085">aerial view</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1657992">نمای هوایی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2325_347934_2299040"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The InfoPath design environment in which you can create or modify a form template.</descrip></descripGrp><ntig><termGrp><term id="347934">design mode</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2299040">حالت طراحی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2328_21412_1498698"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To associate two pieces of information with one another.</descrip></descripGrp><ntig><termGrp><term id="21412">bind</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1498698">قید کردن</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23319_1072508_2433766"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The XML-based vector image format for two-dimensional graphics that supports interactivity and animation and that maintains an image's appearance regardless of screen size or print size.</descrip></descripGrp><ntig><termGrp><term id="1072508">Scalable Vector Graphics</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2433766">SVG</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23319_1072509_2433766"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The XML-based vector image format for two-dimensional graphics that supports interactivity and animation and that maintains an image's appearance regardless of screen size or print size.</descrip></descripGrp><ntig><termGrp><term id="1072509">SVG</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2433766">SVG</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2333_146857_1505759"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Row or column labels that are printed at the top of or on the left side of every page on a printed worksheet.</descrip></descripGrp><ntig><termGrp><term id="146857">print titles</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1505759">عناوین چاپ</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23331_1073321_1499319"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A slide show mode that displays content in a manageable window that can be resized and features navigation buttons. This mode is optimized for reviewing presentations, allowing users to get the full experience, complete with animations and media, while performing other tasks, such as taking notes.</descrip></descripGrp><ntig><termGrp><term id="1073321">Reading View</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1499319">نمای خواندنی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23333_1087526_1499121"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows users to easily add links to content within other content (e.g. pages, sections, section groups) and provides quick navigation through these links. The feature operates in the same manner that links work in wikis.</descrip></descripGrp><ntig><termGrp><term id="1087526">linking</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1499121">پیوند دهی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23334_1073349_1506252"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that highlights new or changed content in a shared notebook that the user has not yet read.</descrip></descripGrp><ntig><termGrp><term id="1073349">Unread Changes</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1506252">تبدیلی ها را ناخوانده بسازید</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23335_1073356_1499505"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A high-level linear representation of a project schedule that can be easily formatted, annotated, and copied and pasted from Project into other Office applications.</descrip></descripGrp><ntig><termGrp><term id="1073356">timeline</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1499505">خط زمانی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23336_1073640_1897842"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that identifies the author of unread new or changed content in a shared notebook.</descrip></descripGrp><ntig><termGrp><term id="1073640">Author Marks</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1897842">علامت های نویسنده</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23347_1074772_1506247"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A task pane that helps form designers to build and manage custom business rules for use in their forms.</descrip></descripGrp><ntig><termGrp><term id="1074772">Rules Manager</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1506247">مدیر قوانین</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23348_1074773_1506042"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A pre-defined table style that allows users to change the look and feel of a form.</descrip></descripGrp><ntig><termGrp><term id="1074773">layout style</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1506042">شیوۀ طرح بندی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23349_1074775_1506255"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows form designers to select from a gallery of pre-built rules to make their forms dynamic.</descrip></descripGrp><ntig><termGrp><term id="1074775">Quick Rules</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1506255">قوانین سریع</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23351_1074778_1506253"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A pre-defined layout that users can select for their InfoPath form sections. Options include single column, two-column, three-column, and four-column layouts.</descrip></descripGrp><ntig><termGrp><term id="1074778">section layout</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1506253">طرح بندی بخش</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23352_1216614_1506256"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An environment in the InfoPath client that enables users to fill out forms (as opposed to designing them). It must be used if the forms to be filled out are not browser-compatible.</descrip></descripGrp><ntig><termGrp><term id="1216614">InfoPath Filler</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1506256">InfoPath Filler</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23352_1216691_1506256"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An environment in the InfoPath client that enables users to fill out forms (as opposed to designing them). It must be used if the forms to be filled out are not browser-compatible.</descrip></descripGrp><ntig><termGrp><term id="1216691">Microsoft InfoPath Filler</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1506256">InfoPath Filler</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23355_1074783_1531062"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Web Part that implements Web chart controls to visually display information in a variety of chart types in SharePoint.</descrip></descripGrp><ntig><termGrp><term id="1074783">Chart Web Part</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1531062">بخش وب چارت</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23361_1074891_2078956"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The combination of hardware (touchscreen or touchpad) and software elements that provides a way to control programs by touching multiple points on the screen simultaneously.</descrip></descripGrp><ntig><termGrp><term id="1074891">multi-touch</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2078956">لمس چندگانه</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23377_1075958_1897844"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A system table that captures failures and other events for Access Services.</descrip></descripGrp><ntig><termGrp><term id="1075958">logging table</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1897844">جدول ثبت وقایع</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="234_237832_1499404"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An object created using drawing tools or commands.</descrip></descripGrp><ntig><termGrp><term id="237832">shape</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1499404">صورت</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2342_138389_1897261"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The entire chart and all its elements.</descrip></descripGrp><ntig><termGrp><term id="138389">chart area</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1897261">ساحه گراف</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2343_210468_1354576"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The web service exposed by the web front-end that allows a client program to execute queries.</descrip></descripGrp><ntig><termGrp><term id="210468">Query Service</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1354576">سرویس جستجو</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23462_1082215_1499133"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The street address or geographical coordinates of a user, and (by way of extensions) of the user’s computer or devices.</descrip></descripGrp><ntig><termGrp><term id="1082215">location</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1499133">موقعیت</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">