1498826"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A symbol selected to designate a specific currency.</descrip></descripGrp><ntig><termGrp><term id="41397">currency symbol</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1498826">نماد واحد پول</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13405_94512_1506084"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">One or more fields that uniquely identify each record in a table.</descrip></descripGrp><ntig><termGrp><term id="94512">primary key</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1506084">کلید ابتدایی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13407_121010_1897232"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The way text is displayed in a document, how it behaves and breaks according to settings.</descrip></descripGrp><ntig><termGrp><term id="121010">text flow</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1897232">جریان متن</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotS