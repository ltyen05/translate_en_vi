mNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1506227">تماس های پیشنهادی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2131_397166_2299142"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process of permanently deleting something by removing it from the store or moving it to the dumpster when dumpster functionality is enabled.</descrip></descripGrp><ntig><termGrp><term id="397166">hard delete</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2299142">حدف دوامدار</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2132_125577_1499527"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">When referring to a device, to remove the corresponding device drivers from the hard disk and physically remove the device from the computer.</descrip></descripGrp><ntig><termGrp><term id="125577">uninstall</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1499527">عدم نصب کردن</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21322_769845_1506228"><langSet xml:l