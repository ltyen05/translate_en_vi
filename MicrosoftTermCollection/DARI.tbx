6053"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The sender's address, to which a letter or parcel can be returned if undeliverable.</descrip></descripGrp><ntig><termGrp><term id="295553">return address</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1506053">آدرس برگشت</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12332_237847_1506054"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A spreadsheet that contains information about a shape; for example, its dimensions, angle, and center of rotation and the styles that determine the shape's appearance.</descrip></descripGrp><ntig><termGrp><term id="237847">ShapeSheet</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1506054">ورق شکل</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12338_126816_1499350"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Tasks that a user is permitted to perform on a computer system or domain.</descrip></descripGrp><ntig><termGrp><term id="126816">user rights</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1499350">حقوق</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun