ation window.</descrip></descripGrp><ntig><termGrp><term id="1993378">application single-threaded apartment</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1997833">اپارتمان یک رشته ای برنامه</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34569_1993379_1997833"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A single-threaded apartment the thread of which is the core UI thread for an application window.</descrip></descripGrp><ntig><termGrp><term id="1993379">ASTA</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1997833">اپارتمان یک رشته ای برنامه</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34570_1993380_1997842"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To redistribute data or resources more evenly in order to change the processing capacity.</descrip></descripGrp><ntig><termGrp><term id="1993380">rebalance</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1997842">مساوات مجدد کردن</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></ter