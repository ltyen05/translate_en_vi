</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2662029">فیلتر SVG</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="47243_2660321_2662024"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The SVG filter that displaces the geometry of an image.</descrip></descripGrp><ntig><termGrp><term id="2660321">Displacement Map</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2662024">نقشه جابجایی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="47244_2660322_2662026"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The SVG filter that layers an offset copy of an image on top of another so that the images can be layered.</descrip></descripGrp><ntig><termGrp><term id="2660322">Offset</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2662026">انحراف</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="47245_2660323_2662028"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The SVG filter that creates a b