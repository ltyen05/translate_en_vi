ote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1354437">مجرای مدیریت</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29250_1506846_1898160"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A specialized component of a full-text index catalog that is built on the values of scoped properties for optimized queries.</descrip></descripGrp><ntig><termGrp><term id="1506846">search scope index</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1898160">فهرست محدوده جستجو</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29251_1506847_1898161"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An attribute that specifies which items are included in a given search scope.</descrip></descripGrp><ntig><termGrp><term id="1506847">search scope rule</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1898161">قانون محدوده جستجو</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29252_1506848_1898162"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user-specified string that is associated with a search scope rule. It is used to determine membership of an item in the associated search scope.</descrip></descripGrp><ntig><termGrp><term id="1506848">search scope rule value</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1898162">مقدار قانون محدوده جستجو</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29253_1506849_1898163"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An object that represents the specifications of the search service on one particular server.</descrip></descripGrp><ntig><termGrp><term id="1506849">search service instance</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1898163">مثال خدمات جستجو</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29254_1506850_1898164"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user account under which the search service runs.</descrip></descripGrp><ntig><termGrp><term id="1506850">search service account</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1898164">حساب خدمات جستجو</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammatica