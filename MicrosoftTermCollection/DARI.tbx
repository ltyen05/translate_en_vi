in an image.</descrip></descripGrp><ntig><termGrp><term id="2227159">color boost</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2234143">تقویت رنگ</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38422_2227160_2790810"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The menu invoked with a shortcut key (Windows + G) when gaming that allows users to take a screenshot, take a 30 second clip of a game, and adjust volume controls.</descrip></descripGrp><ntig><termGrp><term id="2227160">Game Bar</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2790810">Game Bar</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38422_2227160_2790847"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The menu invoked with a shortcut key (Windows + G) when gaming that allows users to take a screenshot, take a 30 second clip of a game, and adjust volume controls.</descrip></descripGrp><ntig><termGrp><term id="2227160">Game Bar</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2790847">Xbox Game Bar</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote typ