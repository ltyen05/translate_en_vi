ID</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1897346">شناسائی کنندۀ برنامه ای</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10349_147051_1897347"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An identifier in the form OLEServerName.ObjectName (for example, Excel.Sheet or PowerPoint.Slide) that's used by the Windows registry to uniquely identify an object.</descrip></descripGrp><ntig><termGrp><term id="147051">ProgID</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1897347">ProgID</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10353_307434_2299171"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The string that is used to define how to dial someone from outside of their country/region.</descrip></descripGrp><ntig><termGrp><term id="307434">international number format</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2299171">قالب نمبر بین المللی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10355_145683_1897338"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of entry that is used specifically for storing information on a section of an organization. It can represent a department or a group of people, for example, ou = Accounting Dept.</descrip></descripGrp><ntig><termGrp><term id="145683">organizational unit</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1897338">واحد سازمانی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10362_103575_1499339"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To change the size of an element on the screen.</descrip></descripGrp><ntig><termGrp><term id="103575">resize</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1499339">تجدید اندازه</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10367_129177_1499545"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The display of information from a given perspective or location.</descrip></descripGrp><ntig><termGrp><term id="129177">view</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1499545">دیدگاه</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10368_228771_2299382"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An account that is intended to be used to run a service. A service account has privileges beyond those provided when a service is run as part of the system, such as the ability to connect over the network to another computer.</descrip></descripGrp><ntig><termGrp><term id="228771">service account</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2299382">حساب خدمات</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10380_156547_1688743"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A document describing a company's position on privacy, detailing what information it collects, with whom the data is shared, and how users can control the use of their personal information.</descrip></descripGrp><ntig><termGrp><term id="156547">privacy statement</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1688743">حریم خصوصی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10380_156547_2780856"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A document describing a company's position on privacy, detailing what information it collects, with whom the data is shared, and how users can control the use of their personal information.</descrip></descripGrp><ntig><termGrp><term id="156547">privacy statement</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2780856">بیانیه حریم خصوصی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10396_158410_1506000"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to, being, or characteristic of something that is not dependent on timing. Each application or command runs in the specified order, but the specified item does not wait for any previously started processes to finish before an application or command runs.</descrip></descripGrp><ntig><termGrp><term id="158410">asynchronous</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1506000">ناهمگام</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10396_2479304_1506000"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to, being, or characteristic of something that is not dependent on timing. Each application or command runs in the specified order, but the specified item does not wait for any previously started processes to finish before an application or command runs.</descrip></descripGrp><ntig><termGrp><term id="2479304">async</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1506000">ناهمگام</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10398_307432_1897559"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The policy tool that gives authors control over how recipients use the documents and emails they send.</descrip></descripGrp><ntig><termGrp><term id="307432">Information Rights Management</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1897559">مدیریت حقوق معلوماتی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10398_307432_2299175"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The policy tool that gives authors control over how recipients use the documents and emails they send.</descrip></descripGrp><ntig><termGrp><term id="307432">Information Rights Management</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2299175">IRM</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10398_307472_1897559"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The policy tool that gives authors control over how recipients use the documents and emails they send.</descrip></descripGrp><ntig><termGrp><term id="307472">IRM</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1897559">مدیریت حقوق معلوماتی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10398_307472_2299175"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The policy tool that gives authors control over how recipients use the documents and emails they send.</descrip></descripGrp><ntig><termGrp><term id="307472">IRM</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2299175">IRM</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1040_378778_2299422"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A parameter that does not take an argument.</descrip></descripGrp><ntig><termGrp><term id="378778">switch parameter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2299422">پارامیتر سویچ</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10402_146400_1897342"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Text or some other element used in an application as an indicator that the user should enter in his or her own text.</descrip></descripGrp><ntig><termGrp><term id="146400">placeholder text</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1897342">گیرنده جای متن</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10410_397225_2299052"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Text that is added to email messages in transport to provide information that supports the sending organization's compliance policies, warnings about unknown or unverified email senders, or other information as determined by the sending organization. Exchange Server 2007 allows the administrator to use transport rules to target disclaimers based on specific criteria.</descrip></descripGrp><ntig><termGrp><term id="397225">disclaimer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2299052">ترک دعوی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10414_270278_1897548"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A line that separates the numerator and denominator of a fraction.</descrip></descripGrp><ntig><termGrp><term id="270278">fraction bar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1897548">خط کسر</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10421_210482_1897442"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A small space on the To-Do Bar where the user can input tasks directly. The default label reads "Type a new task".</descrip></descripGrp><ntig><termGrp><term id="210482">task input panel</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1897442">صفحۀ کنترول ورودی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10423_232516_1505872"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Data from a table, form, query, view, or stored procedure, displayed in a row-and-column format.</descrip></descripGrp><ntig><termGrp><term id="232516">datasheet</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1505872">ورق داده</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10425_77712_2299235"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A highspeed network that can carry voice, data, and images at up to 200 Mbps or faster over distances of up to 75 km. Based on the network architecture, the transmission speed can be higher for shorter distances. A MAN, which can include one or more LANs as well as telecommunications equipment such as microwave and satellite relay stations, is smaller than a wide area network but generally operates at a higher speed.</descrip></descripGrp><ntig><termGrp><term id="77712">MAN</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2299235">شبکه ناحیه شهری</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10425_77713_2299235"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A highspeed network that can carry voice, data, and images at up to 200 Mbps or faster over distances of up to 75 km. Based on the network architecture, the transmission speed can be higher for shorter distances. A MAN, which can include one or more LANs as well as telecommunications equipment such as microwave and satellite relay stations, is smaller than a wide area network but generally operates at a higher speed.</descrip></descripGrp><ntig><termGrp><term id="77713">metropolitan area network</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2299235">شبکه ناحیه شهری</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10431_232847_1897494"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A view that is designed for reading documents on a computer screen. The document is resized to fit the screen and most toolbars are removed, but commands are available for navigating, commenting, and looking up words.</descrip></descripGrp><ntig><termGrp><term id="232847">reading layout view</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1897494">نمای طرح بندی خواندن</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10436_415517_1897592"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Editor feature that gives users feedback on how easy it is for a reader to understand a written text based on information such as average sentence length and average word length.</descrip></descripGrp><ntig><termGrp><term id="415517">Readability Statistics</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1897592">احصائیۀ قابل خواندن</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10437_168488_1953832"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An optional Live Meeting tool that allows users to create Live Meeting slides and add a presenter photo as part of a Microsoft PowerPoint file.</descrip></descripGrp><ntig><termGrp><term id="168488">PowerPoint add-in</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1953832">افزونه PowerPoint</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10443_294444_1897551"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of chart that compares the aggregate values of a number of data series.</descrip></descripGrp><ntig><termGrp><term id="294444">radar chart</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1897551">گراف رادار</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10444_139402_1897272"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A design template that also contains text suggestions on each slide. You replace the text suggestions with the text that you want. A content template contains a slide master and an optional title master.</descrip></descripGrp><ntig><termGrp><term id="139402">content template</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1897272">نمونۀ محتوا</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNo