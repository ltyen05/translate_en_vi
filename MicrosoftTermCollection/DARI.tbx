langSet xml:lang="en-US"><descripGrp><descrip type="definition">A connection that uses the ActiveX Data Objects (ADO) data access interface.</descrip></descripGrp><ntig><termGrp><term id="1506416">ADO connection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1898050">ارتباط ADO</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29088_1506431_1898051"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Data and the information that is needed to access that data from applications and databases that support the ActiveX Data Objects (ADO) data access interface.</descrip></descripGrp><ntig><termGrp><term id="1506431">ADO data source</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1898051">منبع ارقام ADO</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29089_1506432_1898052"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A request to receive an Internet message automatically when user-defined criteria are met. Such messages are generated automatically when items such as documents, Web pages, list items, sites, or other resources on a server are changed.</descrip></descripGrp><ntig><termGrp><term id="1506432">alert subscription</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1898052">عضویت اخطار</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29090_1506433_1898053"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An additional user account that is in a different domain, but within the same forest as the primary account.</descrip></descripGrp><ntig><termGrp><term id="1506433">alternate account</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1898053">حساب متبادل</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29091_1506434_1898054"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A content source that is used to import the anchor text from links between items into the full-text index catalog.</descrip></descripGrp><ntig><termGrp><term id="1506434">anchor content source</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1898054">منبع محتوی لنگر</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29092_1506435_1531050"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of adding anchor text that is in links between items to the full-text index catalog.</descrip></descripGrp><ntig><termGrp><term id="1506435">anchor crawl</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1531050">خزیدن لنگرگاه</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29093_1506436_1898055"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The period of time when an application is running. When an application starts, the session starts. When an application quits, the session ends.</descrip></descripGrp><ntig><termGrp><term id="1506436">application session</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1898055">وقت برنامه</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29094_1506437_1898056"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A GUID or string that is used to uniquely identify an audience.</descrip></descripGrp><ntig><termGrp><term id="1506437">audience identifier</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1898056">شناسایی کننده شنوندگان</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29095_1506438_1531052"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of logical conditions that determine whether a user profile can be a member of an audience.</descrip></descripGrp><ntig><termGrp><term id="1506438">audience rule</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1531052">قانون شنونده</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29096_1506439_1898057"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A floating-point number that designates that a specific Web page is more relevant than other Web pages. Allowed values are 0, 1, or 2. Zero (0) signifies the most valuable authoritative page level.</descrip></descripGrp><ntig><termGrp><term id="1506439">authority level</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1898057">سطح اختیارات</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29097_1506440_1531054"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An XML-based collection of predefined or user-defined settings that are stored as a site definition configuration or a site template, and can be used when creating a site.</descrip></descripGrp><ntig><termGrp><term id="1506440">available site template</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1531054">الگوی میسر سایت</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29098_1506441_1531055"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The text or number that identifies the categories or the scaling of an axis. The axis label usually appears below or to the left of the axis.</descrip></descripGrp><ntig><termGrp><term id="1506441">axis label</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1531055">لیبل محور</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29099_1506442_1898058"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A condition of a handwritten signature, in an image or .ink file, that specifies the direction of the characters in the signature, right-to-left or left-to-right.</descrip></descripGrp><ntig><termGrp><term id="1506442">backward signing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1898058">جهت امضاء</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry