descripGrp><descrip type="definition">A character that is part of the set that makes up a particular language, such as vowels and consonants.</descrip></descripGrp><ntig><termGrp><term id="1508178">strong character</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1898235">نویسۀ قوی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29439_1508552_1898238"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application that parses code and markup in a page to help ensure that only trusted code and markup is run on a computer, server farm, or server cluster.</descrip></descripGrp><ntig><termGrp><term id="1508552">safe mode parser</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1898238">تجزیه کننده حالت مصؤن</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29440_1508555_1898239"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The area of the Help window that contains a Help topic.</descrip></descripGrp><ntig><termGrp><term id="1508555">topic pane</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1898239">قاب موضوع</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote>