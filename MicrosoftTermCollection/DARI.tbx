Note type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1133_1520_1498953"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A data type used in some programming languages, notably C, to declare variables that can store floating-point numbers.</descrip></descripGrp><ntig><termGrp><term id="1520">float</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1498953">شناور</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11330_360145_1506026"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A program you use to view, print, and electronically mail a snapshot, such as a report snapshot.</descrip></descripGrp><ntig><termGrp><term id="360145">Snapshot Viewer</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1506026">Snapshot Viewer</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11332_397182_2299222"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A managed folder that appears in Outlook by default, to which messaging records management has been applied, and whose the retention and journaling is controlled by managed content settings that are applied to the folder.</descrip></descripGrp><ntig><termGrp><term id="397182">managed default folder</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2299222">دوسیه حالت اصلی اداره شده</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1134_36967_1498789"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To reduce the size of a set of data, such as a file or a communications message, so that it can be stored in less space or transmitted with less bandwidth.</descrip></descripGrp><ntig><termGrp><term id="36967">compress</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1498789">فشردن</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11351_10952_1498648"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The consistent positioning of text, graphics, and other objects.</descrip></descripGrp><ntig><termGrp><term id="10952">alignment</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1498648">همراستی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11358_318141_1498918"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A return code that begins with E_ or DB_E_ and indicates that the method failed completely and was unable to do any useful work. Usually indicates a programming error.</descrip></descripGrp><ntig><termGrp><term id="318141">error code</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1498918">کود خطا</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11362_232517_1897484"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A virtual shape that contains default formatting properties for new shapes. Each presentation contains one default shape.</descrip></descripGrp><ntig><termGrp><term id="232517">default shape</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1897484">شکل اصلی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11363_359696_1499248"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The degree to which a product or service executes its specified function.</descrip></descripGrp><ntig><termGrp><term id="359696">performance</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1499248">کارآیی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender