</descripGrp><ntig><termGrp><term id="231964">error bar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1897455">نوار خطا</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14906_397175_2299211"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A database for storing mailboxes in Exchange Server. The mailbox database manages the data in mailboxes, tracks deleted messages and mailbox sizes, and assists in message transfers. A mailbox database is stored as an Exchange database (.edb) file.</descrip></descripGrp><ntig><termGrp><term id="397175">mailbox database</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2299211">دیتابیس صندوق پستی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14908_2254367_2249225"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An agreement in which a customer prepays for periodic or regular services.</descrip></descripGrp><ntig><termGrp><term id="2254367">in-app subscription</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2249225">عضویت</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</term