</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2017180">بستۀ رابط لسان</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8899_165924_2299384"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A cookie that is deleted at the end of the browser session.</descrip></descripGrp><ntig><termGrp><term id="165924">session cookie</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2299384">کوکی جلسه</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8902_95774_1897211"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A folder on a public server that people can use to share information, such as work information, discussions, contacts, tasks, and classified ads. Access permissions determine who can view and alter the folder and to what extent.</descrip></descripGrp><ntig><termGrp><term id="95774">public folder</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1897211">دوسیه عمومی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8913_56463_1505951"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A number that is not a whole number, such as ½ (vulgar fraction) or 0.5 (decimal fraction), formed by dividing one quantity into another.</descrip></descripGrp><ntig><termGrp><term id="56463">fraction</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1505951">خورده</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8916_1034316_2314452"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file containing digitized audio, such as voice or music.</descrip></descripGrp><ntig><termGrp><term id="1034316">audio</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2314452">صوتی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8916_16592_2314452"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file containing digitized audio, such as voice or music.</descrip></descripGrp><ntig><termGrp><term id="16592">audio file</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2314452">صوتی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelect