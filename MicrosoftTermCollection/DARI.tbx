897557"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The folder that contains any .one files that have been sent to you as an email message attachment.</descrip></descripGrp><ntig><termGrp><term id="299913">Notes E-mailed To Me</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1897557">یادداشت های ایمیل شده به من</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7246_116666_1499454"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To transfer into a store or storage location.</descrip></descripGrp><ntig><termGrp><term id="116666">store</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1499454">ذخیره کردن</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7248_54777_1505939"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Marked with a flag.</descrip></descripGrp><ntig><termGrp><term id="54777">flagged</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1505939">علامت بیرق زده شده</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7249_143685_1897316"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The base language used that governs how several language characteristics will behave, such as the language of the primary dictionary, and the direction and alignment of text (left-to-right or right-to-left).</descrip></descripGrp><ntig><termGrp><term id="143685">installed language</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1897316">لسان نصب شده</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7250_143242_1505914"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In 2-D line charts, lines that extend from the highest to the lowest value in each category. High-low lines are often used in stock charts.</descrip></descripGrp><ntig><termGrp><term id="143242">high-low lines</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1505914">خطوط بلند-پایین</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7253_298012_1505915"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Any graphic you draw or insert, which can be changed and enhanced. Drawing objects include AutoShapes, curves, lines, and WordArt.</descrip></descripGrp><ntig><termGrp><term id="298012">drawing object</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1505915">شیی رسامی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7257_55937_1498965"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To prepare a disk for use by organizing its storage space into a collection of data "compartments", each of which can be located by the operating system so that data can be sorted and retrieved. When a previously used disk is formatted, any preexisting information on it is lost.</descrip></descripGrp><ntig><termGrp><term id="55937">format</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1498965">خالی کردن</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7258_147302_1897349"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A diagram that is used to show foundation-based relationships.</descrip></descripGrp><ntig><termGrp><term id="147302">pyramid diagram</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1897349">دیاگرام هرمی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></l