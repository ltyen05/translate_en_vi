"29279_1506876_1898180"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The status of being a member of a site and having a defined set of user rights for accessing or managing content on that site.</descrip></descripGrp><ntig><termGrp><term id="1506876">site membership</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1898180">عضویت سایت</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29280_1506877_1531172"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A name/value pair of strings that serves as metadata for a site, such as the title or default language.</descrip></descripGrp><ntig><termGrp><term id="1506877">site property</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1531172">خصوصیت سایت</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29281_1506878_1898181"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A deployable, reusable package that contains a set of features, site definitions, and assemblies that apply to sites, and that can be enabled or disabled individually.</descrip></descripGrp><ntig><termGrp><term id="1506878">site solution</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id=