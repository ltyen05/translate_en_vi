207"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The service that allows you to securely share your company's applications and services with guest users and external partners from any organization, while maintaining control over your own corporate data.</descrip></descripGrp><ntig><termGrp><term id="2703706">B2B Collaboration</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2709207">B2B کلبریشن</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48000_2703707_2709206"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The service that allows you to securely share your company's applications and services with guest users and external partners from any organization, while maintaining control over your own corporate data.</descrip></descripGrp><ntig><termGrp><term id="2703707">B2B</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="2709206">B2B</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48000_2703707_2709207"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The service that allows you to securely share your company's applications and services with guest users and external partners from any organization, while maintaining control over your own corporate data.</descrip></descripGrp><ntig><termGrp>