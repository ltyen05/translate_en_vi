457"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An assignment property that indicates whether grades for the assignment are numeric or non-numeric.</descrip></descripGrp><ntig><termGrp><term id="1698172">Grade Values</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1898457">مقادیر نمرات</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32747_1698384_1708595"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To remotely view, stream, or copy files stored on a PC running OneDrive from any other device.</descrip></descripGrp><ntig><termGrp><term id="1698384">fetch</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="prs-AF"><ntig><termGrp><term id="1708595">واکشی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32769_1703344_1747602"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An action by which a subscription (the source subscription) is replaced by a new subscription, both owned by the same billing account, along a preconfigured conversion path. The source subscription is canceled and the destination subscription is the new subscription.</descrip></descripGrp><ntig><termGrp><term id="1703344">conversion</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langS