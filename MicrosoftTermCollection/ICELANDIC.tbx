ity Ultra</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2557309">Windows Mixed Reality Ultra</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45308_2558356_2746049"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The service for administrators to detect anomalous or high-risk user activity, discover 3rd-party cloud apps that are being used in their organization that have similar functionality to Office 365, and block 3rd-party application's access to Office 365 information.</descrip></descripGrp><ntig><termGrp><term id="2558356">Office 365 Cloud App Security</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2746049">Cloud App Security</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45308_2558359_2746049"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The service for administrators to detect anomalous or high-risk user activity, discover 3rd-party cloud apps that are being used in their organization that have similar functionality to Office 365, and block 3rd-party application's access to Office 365 information.</descrip></descripGrp><ntig><termGrp><term id="2558359">Cloud App Security</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></lan