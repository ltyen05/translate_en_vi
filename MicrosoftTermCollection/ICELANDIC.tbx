adjusting for revenue and expense items that do not result from cash transactions.</descrip></descripGrp><ntig><termGrp><term id="593044">indirect reconciliation method</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1109474">óbein afstemming</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16631_593045_1109475"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method of deriving the net income provided by operating activities from the components of operating cash receipts and payments, instead of adjusting the net income for items.</descrip></descripGrp><ntig><termGrp><term id="593045">direct method</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1109475">bein aðferð</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16632_593046_1109476"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A posted ledger transaction that is associated with a balance account, asset account, or liability account.</descrip></descripGrp><ntig><termGrp><term id="593046">balance sheet transaction</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1109476">efnahagsfærsla</term><termNote type="geographicalUsage">ISL</termNote><termNote type="par