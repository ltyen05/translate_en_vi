-US"><descripGrp><descrip type="definition">The collection title for games that were recently added to the Store.</descrip></descripGrp><ntig><termGrp><term id="2375037">New games</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2378270">Nýir leikir</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41954_2375038_2378269"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The collection title for apps that were recently added to the Store.</descrip></descripGrp><ntig><termGrp><term id="2375038">New apps</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2378269">Ný forrit</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41955_2375039_2378263"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The collection title for the games that are played the most by Store customers.</descrip></descripGrp><ntig><termGrp><term id="2375039">Most played games</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2378263">Mest spiluðu leikirnir</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41956_2375040_2378247"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The collection title for the apps that are played the most by Store customers.</descrip></descripGrp><ntig><termGrp><term id="2375040">Most played apps</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2378247">Mest spiluðu forritin</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41957_2375041_2378323"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A person who informally represents their feature team by sharing their expertise with the community in activities such as listening and responding to customer feedback, contributing to community forums, blogging about tips and tricks, and more.</descrip></descripGrp><ntig><termGrp><term id="2375041">community champion</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2378323">samfélagsfulltrúi</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41957_2751151_2378323"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A person who informally represents their feature team by sharing their expertise with the community in activities such as listening and responding to customer feedback, contributing to community forums, blogging about tips and tricks, and more.</descrip></descripGrp><ntig><termGrp><term id="2751151">community champ</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2378323">samfélagsfulltrúi</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4196_213534_571526"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The number of colors or levels of gray that can be displayed at one time. The amount or memory in the computer's graphics controller card controls the display. An 8-bit controller can display 256 colors or levels of gray; a 16-bit controller, 64,000 colors; and a 24-bit controller, 16.8 million colors.</descrip></descripGrp><ntig><termGrp><term id="213534">bit specification</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="571526">litafjöldi</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41961_2375458_3113296"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The basic amount of the guaranteed ingress/egress of events sent to an Event Hub that can be dynamically scaled according to stream processing, to pay only for compute needs and handle jobs with gigabytes/sec of streamed data.</descrip></descripGrp><ntig><termGrp><term id="2375458">capacity unit</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="3113296">afkastagetueining</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41961_2766779_3113296"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The basic amount of the guaranteed ingress/egress of events sent to an Event Hub that can be dynamically scaled according to stream processing, to pay only for compute needs and handle jobs with gigabytes/sec of streamed data.</descrip></descripGrp><ntig><termGrp><term id="2766779">CU</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="3113296">afkastagetueining</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4197_113668_571089"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A power-saving state that allows the computer or device to quickly resume full-power operation (typically within several seconds) when you want to start working again. All open documents and programs are saved to memory before the computer or device enters the low-power state.</descrip></descripGrp><ntig><termGrp><term id="113668">sleep</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="571089">hvíldarstaða</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote><