><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4964_232406_1931205"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A digital address book that is automatically created from contacts in the Contacts folder.</descrip></descripGrp><ntig><termGrp><term id="232406">Outlook Address Book</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1931205">Outlook-tengiliðaskrá</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49677_2809791_2838668"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows customers using Power Apps and Common Data Service to create external-facing websites that allow users outside their organizations to sign in with a variety of authentication providers, create and view data in Common Data Service, and browse content anonymously.</descrip></descripGrp><ntig><termGrp><term id="2809791">Power Apps portals</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2838668">Power Apps-gáttir</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4972_75877_1170768"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In information processing, an operation performed by the computer at hand rather than by a remote computer.</descrip></descripGrp><ntig><termGrp><term id="75877">local</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1170768">staðbundinn</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4973_141204_571285"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In line and area charts, lines that extend from a data point to the category (x) axis. Useful in area charts to clarify where one data marker ends and the next begins.</descrip></descripGrp><ntig><termGrp><term id="141204">drop lines</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="571285">línur</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49748_2815101_2837991"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that provides a dedicated cache solution that complements Delivery Optimization distributed peer-to-peer system.</descrip></descripGrp><ntig><termGrp><term id="2815101">Connected Cache</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2837991">Tengt skyndiminni</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp><