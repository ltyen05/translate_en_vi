of an entity, such as a user, computer, device, process, by validating the credentials provided by the entity.</descrip></descripGrp><ntig><termGrp><term id="16998">authentication</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="409040">sannvottun</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33428_1778978_2530555"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Comments and reactions to something, intended to provide useful information for future business decisions and development.</descrip></descripGrp><ntig><termGrp><term id="1778978">feedback</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2530555">ábending</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33442_1779260_1781677"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft website of information on and resources for computer security, digital privacy, and online safety.</descrip></descripGrp><ntig><termGrp><term id="1779260">Microsoft Safety &amp; Security Center</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1781677">Öryggismiðstöð Microsoft</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33442_1779261_1781677"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft website of information on and resources for computer security, digital privacy, and online safety.</descrip></descripGrp><ntig><termGrp><term id="1779261">Microsoft Safety and Security Center</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1781677">Öryggismiðstöð Microsoft</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3345_235384_1108899"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The current cost of replacing an existing asset with a similar asset with equivalent operational capability.</descrip></descripGrp><ntig><termGrp><term id="235384">replacement cost</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1108899">endurnýjunarverð</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33455_2027116_2032196"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The URL for Microsoft OneDrive.</descrip></descripGrp><ntig><termGrp><term id="2027116">OneDrive.com</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2032196">OneDrive.com</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33472_1784123_1988176"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method of classifying and managing active ingredients and items that contain a particular concentration of an active ingredient.</descrip></descripGrp><ntig><termGrp><term id="1784123">potency management</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1988176">styrkleikastjórnun</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33473_1784136_1988161"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An ingredient in a formula that has a specified concentration and potency.</descrip></descripGrp><ntig><termGrp><term id="1784136">active ingredient</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1988161">virkt efni</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33474_1784142_1988163"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process that adjusts the required quantities of ingredients that are used in the production of a formula based on the level of potency of active ingredient of a specific inventory batch.</descrip></descripGrp><ntig><termGrp><term id="1784142">batch balancing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1988163">jöfnun virkra efna í uppskrift</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33475_1784268_1988169"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of ingredient in a formula whose quantities can be adjusted. This adjustment is based on the difference between the quantities of active ingredient that are estimated and the quantities of active ingredient inventory batches that are reserved based on the potency of active ingredient.</descrip></descripGrp><ntig><termGrp><term id="1784268">compensating ingredient</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1988169">jöfnunarefni</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33476_1784270_1988171"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of ingredient in a formula that is used to increase the total quantity of a product. The filler ingredient has no chemical influence on any of the active ingredients in the formulation.</descrip></descripGrp><ntig><termGrp><term id="1784270">filler ingredient</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1988171">fylliefni</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33477_1784271_1988177"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The practice of classifying and managing characteristics of items so that products with similar characteristics can be scheduled to be produced together.</descrip></descripGrp><ntig><termGrp><term id="1784271">product sequencing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1988177">lotuhópar</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33478_1784273_1988175"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The practice of configuring items so that their product characteristics and shelf life information can be updated based on their ingredients.</descrip></descripGrp><ntig><termGrp><term id="1784273">lot inheritance</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1988175">lotuerfðir</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33482_1785145_2030171"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A computing services model that uses a network of remote servers hosted on the internet to store, manage, and process data, rather than a local server or a personal computer.</descrip></descripGrp><ntig><termGrp><term id="1785145">cloud</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2030171">ský</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33485_1785148_2030174"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The composition of two or more distinct cloud infrastructures (private, community, or public) which remain unique entities, but are bound together by standardized or proprietary technology that enables data and application portability (e.g., cloud bursting for load balancing between clouds).</descrip></descripGrp><ntig><termGrp><term id="1785148">hybrid cloud</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2030174">blandað ský</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33487_1785150_2288874"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A cloud-computing model that allows users to develop, run, manage, and deploy applications within a cloud infrastructure, using supported technologies, without building and maintaining said infrastructure.</descrip></descripGrp><ntig><termGrp><term id="1785150">platform as a service</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2288874">verkvangur sem þjónusta (PaaS)</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33487_1785153_2288874"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A cloud-computing model that allows users to develop, run, manage, and deploy applications within a cloud infrastructure, using supported technologies, without building and maintaining said infrastructure.</descrip></descripGrp><ntig><termGrp><term id="1785153">PaaS</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2288874">verkvangur sem þjónusta (PaaS)</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33487_2748866_2288874"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A cloud-computing model that allows users to develop, run, manage, and deploy applications within a cloud infrastructure, using supported technologies, without building and maintaining said infrastructure.</descrip></descripGrp><ntig><termGrp><term id="2748866">platform-as-a-service</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2288874">verkvangur sem þjónusta (PaaS)</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33488_1785151_2030175"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The capability of provisioning storage, networks, processing as well as other resources where the user can deploy and run software.</descrip></descripGrp><ntig><termGrp><term id="1785151">infrastructure as a service</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2030175">IaaS-þjónusta</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33488_1785154_2030175"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The capability of provisioning storage, networks, processing as well as other resources where the user can deploy and run software.</descrip></descripGrp><ntig><termGrp><term id="1785154">IaaS</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2030175">IaaS-þjónusta</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33501_1788113_2139791"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mode that enables presenters to select one person’s video feed so that every participant in the meeting sees that participant only.</descrip></descripGrp><ntig><termGrp><term id="1788113">Video Spotlight</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2139791">Vídeófókus</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33503_1788117_2610756"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that broadcasts user presence in a OneNote notebook and supports real-time synchronization for users who are editing the same page.</descrip></descripGrp><ntig><termGrp><term id="1788117">Notebook Presence</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2610756">Viðvera í glósubók</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33522_1791370_2338686"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An informative notice displayed to email senders while they’re composing a message that they might be violating a data loss prevention (DLP) policy.</descrip></descripGrp><ntig><termGrp><term id="1791370">policy tip</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2338686">ábending um reglu</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33560_1795065_2635173"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of features that identify, monitor and protect sensitive information.</descrip></descripGrp><ntig><termGrp><term id="1795065">data loss prevention</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2635173">gagnatapsvörn</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33560_2626811_2635173"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of features that identify, monitor and protect sensitive information.</descrip></descripGrp><ntig><termGrp><term id="2626811">DLP</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2635173">gagnatapsvörn</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33565_1802638_2184262"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A signal that tells your Xbox Live and Facebook friends that you want to play a particular game, and notifies you when friends are playing or want to play that game.</descrip></descripGrp><ntig><termGrp><term id="1802638">beacon</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term