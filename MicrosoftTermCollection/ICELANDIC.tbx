><descrip type="definition">A template that can be created and used to quickly place repeat orders.</descrip></descripGrp><ntig><termGrp><term id="3104373">order template</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="3105112">pöntunarsniðmát</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54675_3104374_3105114"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An extension that facilitates communication between Commerce (and associated components) and a payment service.</descrip></descripGrp><ntig><termGrp><term id="3104374">payment connector</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="3105114">greiðslutengill</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54676_3104375_3105115"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A page that provides detailed information about a product, and lets customers select product options such as a size, style, and color. A PDP should showcase all the product information that a customer requires to make a purchase decision.</descrip></descripGrp><ntig><termGrp><term id="3104375">PDP</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="3105115">PDP</term><termNote type="geographicalUsage">I