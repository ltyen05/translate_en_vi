</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28172_1468796_1477822"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To calculate, assign, and allocate the cost of economic resources acquired, produced, or delivered by an organization.</descrip></descripGrp><ntig><termGrp><term id="1468796">costed</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1477822">kostnaðarreikna og -úthluta</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28173_1468797_1478185"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of calculating, assigning, and allocating the cost of economic resources  acquired, produced, or delivered by an organization.</descrip></descripGrp><ntig><termGrp><term id="1468797">costing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1478185">kostnaðarútreikningur</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28195_1475068_1479016"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A marketing practice to use odd numbers that are marginally less than their nearest round number to set prices.</descrip><