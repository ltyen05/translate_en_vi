erting encrypted content back into its original form to make it readable again.</descrip></descripGrp><ntig><termGrp><term id="692">decryption</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="570300">dulráðning</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12804_233325_1109305"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A calendar that defines the capacity and work time in a production system, for use in managing work centers or work center groups.</descrip></descripGrp><ntig><termGrp><term id="233325">working time calendar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1109305">vinnutímadagatal</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12813_140907_571281"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An image that has been captured electronically with a digital camera or scanner.</descrip></descripGrp><ntig><termGrp><term id="140907">digital photo</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="571281">stafræn mynd</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumb