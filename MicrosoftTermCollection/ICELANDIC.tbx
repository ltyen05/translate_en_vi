 xml:lang="en-US"><descripGrp><descrip type="definition">The feature that allows leaders to encourage open dialog and feedback across communities and teams through news, Ask Me Anything (AMA) events, surveys, and more in Viva Engage.</descrip></descripGrp><ntig><termGrp><term id="3099042">Leadership Corner</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="3101569">Leiðtogahorn</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54542_3099043_3101567"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The set of metrics available to Viva suite licensed customers that allows users to gain a deeper understanding of engagement and trends happening across Viva Engage.</descrip></descripGrp><ntig><termGrp><term id="3099043">Advanced Analytics</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="3101567">Ítarlegri greiningar</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54550_3099235_3100823"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ad format in PromoteIQ that generally ranks at the top of a retailer's website, and features images of products.</descrip></descripGrp><ntig><termGrp><term id="3099235">Product Listing Ad</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termG