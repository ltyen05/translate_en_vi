te builder</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="3105118">vefsvæðissmiður</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54680_3104379_3105119"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A module that lets users browse across multiple sites by providing an easy way to switch between sites and select their preferred shopping site when a business has different sites across markets, regions, and locales.</descrip></descripGrp><ntig><termGrp><term id="3104379">site picker</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="3105119">vefsvæðaval</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54681_3104380_3105120"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A programming element that lets a screen reader pass over navigation elements and ads on a Web site and go directly to the desired content.</descrip></descripGrp><ntig><termGrp><term id="3104380">skip link</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="3105120">miðunartengill</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54682_3104381_3105121"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A module that is used to add space between sections on your page to allow for different layout and design options.</descrip></descripGrp><ntig><termGrp><term id="3104381">spacer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="3105121">bil</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5469_177200_571426"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A message sent to the user or administrator of a system where the recipient may be a human or an automated notification manager.</descrip></descripGrp><ntig><termGrp><term id="177200">notification</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="571426">tilkynning</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54694_3105975_3121078"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The tree-planting initiative sponsored by Microsoft by which players grow a virtual seed into a tree by completing tasks on the weather page. Once the virtual tree is grown, Microsoft sponsors the planting of a real tree.</descrip></descripGrp><ntig><termGrp><term id="3105975">E-tree</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNum