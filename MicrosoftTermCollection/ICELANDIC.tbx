></termEntry><termEntry id="52751_2956731_2996389"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Of a function, the state of either never decreasing or never increasing as its independent variable increases.</descrip></descripGrp><ntig><termGrp><term id="2956731">Monotonicity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2996389">Einhalli</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52752_2956732_2996325"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A complex number, usually denoted with i, that is defined by i2=-1.</descrip></descripGrp><ntig><termGrp><term id="2956732">imaginary unit</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2996325">þvereining</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52753_2956733_2996322"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Of a complex number a+bi, where a and b are real numbers, the value b.</descrip></descripGrp><ntig><termGrp><term id="2956733">imaginary part</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2996322">þverhluti</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52754_2956734_2996267"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A function whose derivative is a given function, an indefinite integral.</descrip></descripGrp><ntig><termGrp><term id="2956734">antiderivative</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2996267">stofnfall</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52755_2956735_2996391"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An identity that expresses the Pythagorean theorem in terms of trigonometric functions.</descrip></descripGrp><ntig><termGrp><term id="2956735">Pythagorean Identity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2996391">Pýþagórísk aljafna</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52756_2956736_2996407"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mnemonic device for computing the determinant of a 3x3 matrix named after the French mathematician Pierre Frédéric Sarrus.</descrip></descripGrp><ntig><termGrp><term id="2956736">Sarrus' Rule</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2996407">Regla Sarrusar</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52757_2956737_2996422"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">For a polynomial sorted by degree, the last monomial term.</descrip></descripGrp><ntig><termGrp><term id="2956737">trailing term</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2996422">undirliður</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52758_2956738_2996298"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A way of representing repeated multiplications of the same number by writing the number as a base with the number of repeats written as a small number to its upper right.</descrip></descripGrp><ntig><termGrp><term id="2956738">exponential form</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2996298">mynd veldisvísis</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52759_2956739_2996396"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mathematical root expressed with a radical sign, generally a square root or cube root.</descrip></descripGrp><ntig><termGrp><term id="2956739">radical form</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2996396">mynd rótar</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52760_2956740_2996386"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The capability that gives the user instantaneous access to a device by using a remote shell connection, granting them the power to do in-depth investigative work and take immediate response actions to promptly contain identified threats in real time.</descrip></descripGrp><ntig><termGrp><term id="2956740">Live Response</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2996386">Lifandi svörun</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52773_2997773_2997808"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Information Excel function that returns TRUE if the value is any error value.</descrip></descripGrp><ntig><termGrp><term id="2997773">ISERROR</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2997808">ISERROR</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammatica