tig></langSet></termEntry><termEntry id="27421_1370627_1427911"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A production process designed using Lean principles.</descrip></descripGrp><ntig><termGrp><term id="1370627">production flow</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1427911">framleiðsluflæði</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27422_1370628_1426802"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The number of item requirements that are carried on a kanban based on a kanban rule.</descrip></descripGrp><ntig><termGrp><term id="1370628">kanban product quantity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1426802">kanban-afurðafjöldi</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27423_1370629_1426711"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A product family grouping that is used for forecast and demand scheduling.</descrip></descripGrp><ntig><termGrp><term id="1370629">item allocation key</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1426711">úthlutunarlykill vöru</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNot