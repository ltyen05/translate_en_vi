on of keystrokes that can be used to perform a task that would otherwise require a mouse or other pointing device.</descrip></descripGrp><ntig><termGrp><term id="317464">key combination</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="570850">flýtilykill</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2000_72983_570850"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A combination of keystrokes that can be used to perform a task that would otherwise require a mouse or other pointing device.</descrip></descripGrp><ntig><termGrp><term id="72983">keyboard shortcut</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="570850">flýtilykill</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20056_694301_2309930"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A person who has been invited to an event.</descrip></descripGrp><ntig><termGrp><term id="694301">invitee</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2309930">boðsgestur</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></te