the data increases or decreases quickly and then levels out.</descrip></descripGrp><ntig><termGrp><term id="592362">logarithmic trendline</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1822669">lógaritmísk leitnilína</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16514_592363_1822670"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A curved trendline that is used when data fluctuates.</descrip></descripGrp><ntig><termGrp><term id="592363">polynomial trendline</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1822670">margliða leitnilína</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16516_592365_1822671"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A curved trendline that is used with data sets that compare measurements that increase at a specific rate.</descrip></descripGrp><ntig><termGrp><term id="592365">power trendline</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1822671">kraftleitnilína</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16518_592368_1822672"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A curved trendline that is used when data values rise or fall at constantly increasing rates.</descrip></descripGrp><ntig><termGrp><term id="592368">exponential trendline</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1822672">leitnilína með veldisvísi</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16519_592369_1822673"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A trendline that smoothes out fluctuations in data to show a pattern or trend more clearly.</descrip></descripGrp><ntig><termGrp><term id="592369">moving average trendline</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1822673">leitnilína hlaupandi meðaltals</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16533_592383_1956477"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A certificate that represents the public-key portion of a token-signing certificate. A verification certificate is stored in the trust policy and used by the federation server in one organization to verify that incoming security tokens have been issued by valid federation servers in the organization's farm and in other organizations.</descrip></descripGrp><ntig><termGrp><term id="592383">verification certificate</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1956477">sannprófunarvottorð</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1654_234919_571631"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A wizard that allows third-party developers to achieve the same look in their dialog boxes as Aero.</descrip></descripGrp><ntig><termGrp><term id="234919">Aero Wizard</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="571631">Aero-leiðsagnarforrit</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16577_592433_1485217"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To ensure that all data sources that are used by a KPI or scorecard are available.</descrip></descripGrp><ntig><termGrp><term id="592433">validate</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1485217">staðfesta</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1658_115875_1956451"><langSet xml:lang="en-US"><descripGrp><descrip type="