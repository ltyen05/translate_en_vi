><termGrp><term id="1987078">innskráningarupplýsingar</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12369_2749763_570298"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Information that includes identification and proof of identification that is used to gain access to local and network resources.</descrip></descripGrp><ntig><termGrp><term id="2749763">credential</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="570298">skilríki</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12369_606_1987078"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Information that includes identification and proof of identification that is used to gain access to local and network resources.</descrip></descripGrp><ntig><termGrp><term id="606">credentials</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1987078">innskráningarupplýsingar</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12369_606_570298"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Information that includes identification and proof of identification that is used to gain access to local and network resources.</descrip></descripGrp><ntig><termGrp><term id="606">credentials</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="570298">skilríki</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12370_17867_570445"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The technology that is based on the Component Object Model (COM) that enables interoperability among ActiveX components, including OLE components. Formerly referred to as OLE Automation.</descrip></descripGrp><ntig><termGrp><term id="17867">Automation</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="570445">sjálfvirkni</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12381_121120_571139"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that consists of advanced text wrap functionality, allowing the user to select from various styles to specify how text flows around objects or graphics in a document.</descrip></descripGrp><ntig><termGrp><term id="121120">text wrapping</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="571139">textaskrið</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12382_34696_570576"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The three-dimensional space that is defined by a set of coordinates for representing color on devices such as monitors, scanners, and printers. For example, in the LAB color space, the colors are defined in terms of their luminance or whiteness (L), redness-greenness (A), and yellowness-blueness (B); the HVC system uses hue (H), value (V), and chroma (C). The two most common color space models are RGB and YUV.</descrip></descripGrp><ntig><termGrp><term id="34696">color space</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="570576">litavídd</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12382_34697_570576"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The three-dimensional space that is defined by a set of coordinates for representing color on devices such as monitors, scanners, and printers. For example, in the LAB color space, the colors are defined in terms of their luminance or whiteness (L), redness-greenness (A), and yellowness-blueness (B); the HVC system uses hue (H), value (V), and chroma (C). The two most common color space models are RGB and YUV.</descrip></descripGrp><ntig><termGrp><term id="34697">color space model</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="570576">litavídd</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12383_63110_1485206"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of breaking a word between syllables at the end of a line or to separate the parts of a compound word.</descrip></descripGrp><ntig><termGrp><term id="63110">hyphenation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1485206">orðskipting</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12386_46887_1956287"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A 32-bit integer that identifies a property set.</descrip></descripGrp><ntig><termGrp><term id="46887">dispatch ID</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1956287">sendingarkenni</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12387_262437_571716"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An encryption algorithm that uses a 56-bit key and maps a 64-bit input block to a 64-bit output block. The key appears to be a 64-bit key, but one bit in each of the eight bytes is used for odd parity, resulting in 56 bits of usable key.</descrip></descripGrp><ntig><termGrp><term id="262437">Data Encryption Standard</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="571716">DES-staðall</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12387_262437_571717"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An encryption algorithm that uses a 56-bit key and maps a 64-bit input block to a 64-bit output block. The key appears to be a 64-bit key, but one bit in each of the eight bytes is used for odd parity, resulting in 56 bits of usable key.</descrip></descripGrp><ntig><termGrp><term id="262437">Data Encryption Standard</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="571717">DES</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12387_262438_571716"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An encryption algorithm that uses a 56-bit key and maps a 64-bit input block to a 64-bit output block. The key appears to be a 64-bit key, but one bit in each of the eight bytes is used for odd parity, resulting in 56 bits of usable key.</descrip></descripGrp><ntig><termGrp><term id="262438">DES</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="571716">DES-staðall</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12387_262438_571717"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An encryption algorithm that uses a 56-bit key and maps a 64-bit input block to a 64-bit output block. The key appears to be a 64-bit key, but one bit in each of the eight bytes is used for odd parity, resulting in 56 bits of usable key.</descrip></descripGrp><ntig><termGrp><term id="262438">DES</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="571717">DES</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1239_25547_1977256"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The indication that the phone is busy.</descrip></descripGrp><ntig><termGrp><term id="25547">busy signal</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1977256">merkið „á tali“</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12393_258668_1109283"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A special kind of transformation whereby an XML document is converted from one XML schema to another.</descrip></descripGrp><ntig><termGrp><term id="258668">schema mapping</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1109283">vörpun skema</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12394_235364_1109284"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To withdraw items from inventory for production or distribution.</descrip></descripGrp><ntig><termGrp><term id="235364">pick</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1109284">taka til</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12395_231972_1822565"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Total values for all cells in a row or all cells in a column of a PivotTable report. Values in a grand total row or column are calculated by using the same summary function used in the data area of the PivotTable report.</descrip></descripGrp><ntig><termGrp><term id="231972">PivotTable grand totals</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1822565">PivotTable-heildarsamtala</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="124_53143_570732"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The inability of a computer system or related device to operate reliably or to operate at all.</descrip></descripGrp><ntig><termGrp><term id="53143">failure</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="570732">bilun</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12400_52903_2418560"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In geometry and computer graphics, one side of a solid object, such as a cube.</descrip></descripGrp><ntig><termGrp><term id="52903">face</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2418560">flötur</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12402_494898_640099"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The reversal of an inventory transaction, using the same cost for the reversing transaction, for example a return order or a credit memo, as was used in the original transaction.</descrip></descripGrp><ntig><termGrp><term id="494898">exact cost reversing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="640099">nákvæm bakfærsla kostnaðar</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12405_184041_1822532"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mode that enables the user to move a document by dragging it. Panning mode is available when a Word document is displayed on a preview pane.</descrip></descripGrp><ntig><termGrp><term id="184041">panning mode</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1822532">flettistilling</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1241_31081_409065"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A calculated value that is used to test data for the presence of errors that can occur when data is transmitted or when it is written to disk. The checksum is calculated for a given chunk of data by sequentially combining all the bytes of data with a series of arithmetic or logical operations. After the data is transmitted or stored, a new checksum is calculated in the same way using the (possibly faulty) transmitted or stored data. If the two checksums do not match, an error has occurred, and the data should be transmitted or stored again. Checksums cannot detect all errors, and they cannot be used to correct erroneous data.</descrip></descripGrp><ntig><termGrp><term id="31081">checksum</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="409065">prófsumma</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12412_1056070_1955006"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A calendaring feature that automatically manages resources. Resource requests are automatically accepted or denied depending on availability and policies.</descrip></descripGrp><ntig><termGrp><term id="1056070">Booking Attendant</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1955006">Tilfangabókari</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12412_307447_1955006"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A calendaring feature that automatically manages resources. Resource requests are automatically accepted or denied depending on availability and policies.</descrip></descripGrp><ntig><termGrp><term id="307447">Resource Booking Attendant</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1955006">Tilfangabókari</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12419_237283_1860035"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An enhanced spell-check feature that looks at words before or after the word in question to assess proper usage. This allows the software to flag correctly-spelled words as 'wrong' if the usage appears to be incorrect.</descrip></descripGrp><ntig><termGrp><term id="237283">Contextual Spelling</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1860035">samhengisnæm ritvilluvörn</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1243_233034_1108807"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Current good manufacturing practices for the manufacture, packaging, and holding of finished pharmaceuticals and drugs.</descrip></descripGrp><ntig><termGrp><term id="233034">good manufacturing practice</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1108807">GMP</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1243_233034_1108808"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Current good manufacturing practices for the manufacture, packaging, and holding of finished pharmaceuticals and drugs.</descrip></descripGrp><ntig><termGrp><term id="233034">good manufacturing practice</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1108808">góðir framleiðsluhættir</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Other</termNote><termNot