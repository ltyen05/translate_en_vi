/langSet></termEntry><termEntry id="27079_1364978_1426822"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A document that documents unique characteristics for a case.</descrip></descripGrp><ntig><termGrp><term id="1364978">knowledge article</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1426822">þekkingarskrá</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27080_1364979_1427010"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A party that contributes to a process or assumes a role in a relationship.</descrip></descripGrp><ntig><termGrp><term id="1364979">participant</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1427010">þátttakandi</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27081_1364980_1427013"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A person or organization that participates in economic activities.</descrip></descripGrp><ntig><termGrp><term id="1364980">party</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1427013">aðili</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27082_1364981_1427030"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">One or more rules or procedures that operationalize internal controls.</descrip></descripGrp><ntig><termGrp><term id="1364981">policy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1427030">regla</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27085_1365268_1428703"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A condition-action pair that prescribes the action taken when the condition is met.</descrip></descripGrp><ntig><termGrp><term id="1365268">rule</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1428703">regla</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27086_1365271_1428786"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The entities that are outside the organization’s operational boundary. Materials that come from the technosphere are bought or sold, rather than acquired from the environment.</descrip></descripGrp><ntig><termGrp><term id="1365271">technosphere</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1428786">fjærumhverfi</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27087_1365280_1426708"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Standards and guidelines that were developed by the International Organization for Standardization (ISO) to help organizations minimize the negative effect their operations have on the environment and to comply with applicable laws and regulations.</descrip></descripGrp><ntig><termGrp><term id="1365280">ISO 14000</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1426708">ISO 14000</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27089_1365286_1425650"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The X++ event that is raised when a data value in a table changes.</descrip></descripGrp><ntig><termGrp><term id="1365286">data event</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1425650">gagnatilvik</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2709_121473_571144"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Of, pertaining to, or being an object or image having or appearing to have all three spatial dimensions (length, width, and depth).</descrip></descripGrp><ntig><termGrp><term id="121473">three-dimensional</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="571144">þrívítt</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2709_320453_571144"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Of, pertaining to, or being an object or image having or appearing to have all three spatial dimensions (length, width, and depth).</descrip></descripGrp><ntig><termGrp><term id="320453">3-D</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="571144">þrívítt</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2709_494869_571144"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Of, pertaining to, or being an object or image having or appearing to have all three spatial dimensions (length, width, and depth).</descrip></descripGrp><ntig><termGrp><term id="494869">3D</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="571144">þrívítt</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote typ