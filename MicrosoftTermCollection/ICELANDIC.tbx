<termEntry id="16175_1508829_1822948"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An area at the left side in some dialog boxes, such as Save As, Open, and Insert Picture that contains shortcuts to various folders.</descrip></descripGrp><ntig><termGrp><term id="1508829">Places Bar</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1822948">Staðastika</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16175_477172_1822948"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An area at the left side in some dialog boxes, such as Save As, Open, and Insert Picture that contains shortcuts to various folders.</descrip></descripGrp><ntig><termGrp><term id="477172">My Places bar</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1822948">Staðastika</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16176_143109_1822470"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A margin setting that adds extra space to the side or top margin of a document you plan to bind. A gutter margin ensures that text isn't obscured by the binding.</descrip></descripGrp><ntig><termGrp><term id="143109">gutter margin</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1822470">kjalvíddarspássía</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16181_235331_1109459"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method of inventory valuation in which inventory is assumed for accounting purposes to move in the order it was received, regardless of its actual physical movement.</descrip></descripGrp><ntig><termGrp><term id="235331">FIFO inventory valuation method</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1109459">FIFO-birgðamatsaðferð</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16181_235332_1109459"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method of inventory valuation in which inventory is assumed for accounting purposes to move in the order it was received, regardless of its actual physical movement.</descrip></descripGrp><ntig><termGrp><term id="235332">first in, first out inventory valuation method</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1109459">FIFO-birgðamatsaðferð</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16183_1608214_2855346"><langSet xml:lang