on in the year of the acquisition of the asset and the year of the disposal of the asset.</descrip></descripGrp><ntig><termGrp><term id="258371">depreciation convention</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1467933">afskriftarregla</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12871_316306_571992"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To wait for incoming traffic, calls or connection requests on a port.</descrip></descripGrp><ntig><termGrp><term id="316306">listen</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="571992">hlusta</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12872_1790611_570776"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To be unresponsive.</descrip></descripGrp><ntig><termGrp><term id="1790611">stop responding</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="570776">frjósa</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12874_276553_571825"><langSet xml:l