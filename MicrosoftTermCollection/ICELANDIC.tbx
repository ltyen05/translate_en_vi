rip type="definition">The service for wireless products that allows users to send and receive brief messages consisting of text and numbers to and from mobile phones and devices.</descrip></descripGrp><ntig><termGrp><term id="725996">SMS</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1767703">SMS</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20595_726386_2020811"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A virtual community that provides people with opportunities to interact (via blogs, chats, newsgroups, webcasts, user groups, and forums) with Microsoft employees, experts, and peers in order to share knowledge and news about Microsoft technology.</descrip></descripGrp><ntig><termGrp><term id="726386">Microsoft community</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2020811">Microsoft-samfélagið</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20600_726850_1170962"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The sound made by a mobile device or other phone to indicate an incoming call or message, for example, a series of beeps or an audio recording.</descrip></descripGrp><ntig><termGrp><term id="726850">ringtone</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig>