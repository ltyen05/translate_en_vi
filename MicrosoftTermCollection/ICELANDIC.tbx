ch creates the set, and then returns that set to Microsoft Office Excel.</descrip></descripGrp><ntig><termGrp><term id="2955564">CUBESET</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2966635">CUBESET</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52353_2955565_2966636"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Cube Excel function that returns the number of items in a set.</descrip></descripGrp><ntig><termGrp><term id="2955565">CUBESETCOUNT</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2966636">CUBESETCOUNT</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52354_2955566_2966637"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Cube Excel function that returns an aggregated value from a cube.</descrip></descripGrp><ntig><termGrp><term id="2955566">CUBEVALUE</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2966637">CUBEVALUE</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></lan