te><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="47517_2676868_2704179"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of plan used to control the delivery of base pay and awards. An employee's fixed base pay and merit increases are controlled through fixed compensation plans. The payment of incentive pay, such as bonus payments, performance awards, stock options, and grants, and also one-time awards, are controlled through variable compensation plans.</descrip></descripGrp><ntig><termGrp><term id="2676868">compensation plan</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2704179">launafyrirkomulag</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="47520_2676871_2704182"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Integral types where labels are assigned to a subset of the values; these can be used in place of literals to make code more readable and maintainable.</descrip></descripGrp><ntig><termGrp><term id="2676871">enumeration</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2704182">upptalning</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="47521_2676872_2704183"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A configuration to generate electronic reports, for both incoming and outgoing electronic documents in accordance with the legal requirements of various countries/regions.</descrip></descripGrp><ntig><termGrp><term id="2676872">ER configuration</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2704183">skilgreining rafrænnar skýrslugerðar</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="47522_2676873_2704184"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An amount that does not change in itself but to which other amounts can be added or deducted from.</descrip></descripGrp><ntig><termGrp><term id="2676873">flat amount</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2704184">slétt upphæð</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="47523_2676874_2704185"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Additional benefit or compensation complementing a worker's base salary, normally in kind.</descrip></descripGrp><ntig><termGrp><term id="2676874">fringe benefit</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2704185">jaðarfríðindi</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="47524_2676875_2704186"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An amount deducted from a worker's salary, for example, for tax purposes.</descrip></descripGrp><ntig><termGrp><term id="2676875">garnishment</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2704186">frádráttur frá launum</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="47526_2676877_2704189"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">an increase based on the employee’s pay rate as of the cycle end date and the increase percent found in the fixed increase budget for the employee’s department, labor union, and location that has to do with an employee's efficiency or meeting agreed performance targets.</descrip></descripGrp><ntig><termGrp><term id="2676877">merit increase</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2704189">verðleikaaukning</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="47527_2676878_2704190"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The structured process by which employees leave an organization.</descrip></descripGrp><ntig><termGrp><term id="2676878">offboarding</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2704190">ráðstafanir vegna starfsloka</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="47529_2676880_2704192"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Interval that workers are paid in. A pay cycle determines how often payroll is run and the specific days that workers are paid on.</descrip></descripGrp><ntig><termGrp><term id="2676880">pay cycle</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2704192">greiðsluferli</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="47530_2676881_2704193"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Duration and frequency established for a pay cycle to run. For example, monthly, bi-monthly etc.</descrip></descripGrp><ntig><termGrp><term id="2676881">pay period</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2704193">launatímabil</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="47531_2676882_2704194"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Document showing all calculations for worker deductions and employer contributions for benefits and taxes, how benefit accruals have been processed, and the worker’s net pay determined.</descrip></descripGrp><ntig><termGrp><term id="2676882">pay statement</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2704194">launayfirlit</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="47532_2676883_2704195"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A payment journal is a type of general journal, where you register payments.</descrip></descripGrp><ntig><termGrp><term id="2676883">payment journal</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2704195">greiðslubók</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="47533_2676884_2704196"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Execution of a pay cycle</descrip></descripGrp><ntig><termGrp><term id="2676884">payment run</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2704196">launakeyrsla</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="47534_2676885_2704197"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A performance journal holds information that relates to employees and their your goals or how they have performed during a period.</descrip></descripGrp><ntig><termGrp><term id="2676885">performance journal</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2704197">frammistöðubók</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="47535_2676886_2704198"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Personnel actions are additional steps that you must complete when you perform certain personnel-related tasks. Examples of tasks that might require personnel actions are when you create new positions, modify existing position values, hire new workers, transfer workers, change worker compensation, change position assignments, or terminate workers.</descrip></descripGrp><ntig><termGrp><term id="2676886">personnel action</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2704198">starfsmannaaðgerð</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="47536_2676887_2704199"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The accounting rules that are applied when earnings are posted that are generated for this earning code. The main account for distributions is based on the department, job, and worker selections for each posting rule.</descrip></descripGrp><ntig><termGrp><term id="2676887">posting rule</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2704199">bókunarregla</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="47537_2676888_2704200"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Codes related to an extra earning paid to an employee when specific conditions are met, e.g. overtime, etc.</descrip></descripGrp><ntig><termGrp><term id="2676888">premium code</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2704200">bónusgreiðslukóði</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="47538_2676889_2704201"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The record buffer is a memory area for storing Web object variables and database field values that are directly output to or input from a database.</descrip></descripGrp><ntig><termGrp><term id="2676889">record buffer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2704201">færslubiðminni</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="47539_2676890_2704202"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A signing limit defines the largest financial commitment that a worker is authorized to make on behalf of an employer. As a direct result of a worker's spending activity, and approval of the spending activity by the worker's manager, the organization may form a contractual relationship with a third party.</descrip></descripGrp><ntig><termGrp><term id="2676890">signing limit</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2704202">ráðningartakmörkun</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="47540_2676891_2704203"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Engine that calculates tax amounts for a certain transaction, it is an essential part of the configurable business application experience in Microsoft Dynamics 365 for Finance and Operations. It's highly customizable and lets a business user, functional consultant, or power user configure tax rules that determine tax applicability, calculation, posting, and settlement, based on legal and business requirements.</descrip></descripGrp><ntig><termGrp><term id="2676891">tax engine</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2704203">skattkerfi</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="47541_2676892_2704204"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tax data classifier based on the Tax Identification Number (TIN) and used for tax calculation and reporting in Dynamics 365 for Finance and Operations.</descrip></descripGrp><ntig><termGrp><term id="2676892">Tax Identification Dimension</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2704204">auðkenningarvídd skatts</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="47543_2676894_2704206"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Mandatory deductions on a salary to meet local or other tax requirements.</descrip></descripGrp><ntig><termGrp><term id="2676894">tax levy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2704206">skattaálagning</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="47544_2676895_2704207"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Tax regions are geographic areas where a specific set of payroll taxes applies. Generally, tax regions correspond to the cities or towns where your workers reside or work.</descrip></descripGrp><ntig><termGrp><term id="2676895">tax region</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2704207">skattumdæmi</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="47545_2676896_2704208"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The recoverable tax amounts of a tax component</descrip></descripGrp><ntig><termGrp><term id="2676896">tax setoff</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2704208">skattjöfnun</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="47546_2676897_2704209"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A taxable document is an abstract representation of a document that enables tax calculation in an enterprise resource planning (ERP) system.</descrip></descripGrp><ntig><termGrp><term id="2676897">taxable document</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2704209">skattskylt skjal</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="47547_2676898_2704210"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Task associated with a template belonging to a process or workflow.</descrip></descripGrp><ntig><termGrp><term id="2676898">template task</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2704210">sniðmátsverk</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="47548_2676899_2704211"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Negotiated agreement between an employer and a labor union</descrip></descripGrp><ntig><termGrp><term id="2676899">union agreement</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2704211">stéttarfélagssamningur</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="47550_2676901_2704191"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The structured process by which new employees become successfully integrated into the organization and acquire knowledge, skills and behaviors that increase their effectiveness.</descrip></descripGrp><ntig><termGrp><term id="2676901">onboarding</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2704191">nýliðun</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNot