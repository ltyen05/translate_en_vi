7730_2948228"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A computer where the operating system, monitor, speakers, microphone, and sometimes camera, are all integrated in a single unit.</descrip></descripGrp><ntig><termGrp><term id="2947730">all-in-one</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2948228">sambyggð tölva</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23556_2947730_2948229"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A computer where the operating system, monitor, speakers, microphone, and sometimes camera, are all integrated in a single unit.</descrip></descripGrp><ntig><termGrp><term id="2947730">all-in-one</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2948229">Sambyggð tölva</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23562_1087966_2873395"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The practice of working in one location (often at home) and communicating with a main office at a different location through a personal computer equipped with a modem and communications software.</descrip></descripGrp><ntig><termGrp><term id="1087966">teleworking</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig>