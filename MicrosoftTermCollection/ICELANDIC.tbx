53">IPV</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1109466">verðfrávik reiknings</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16621_593053_1109467"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The difference between the price on a packing slip and the invoice line price. The invoice price variance is determined when purchase invoices are compared to purchase receipts.</descrip></descripGrp><ntig><termGrp><term id="593053">IPV</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1109467">frávik reikningsverðs</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16622_592966_1109468"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In allocations, an entry used to balance the account, dimension, or other field information for the allocation destination. Offset entries typically clear or reduce the source amounts.</descrip></descripGrp><ntig><termGrp><term id="592966">offset entry</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1109468">mótfærsla</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16625_593036_1109469"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The difference between the cost price and the actual production price. The production variance is determined when the production order is calculated.</descrip></descripGrp><ntig><termGrp><term id="593036">production variance</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1109469">framleiðslufrávik</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16625_593037_1109469"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The difference between the cost price and the actual production price. The production variance is determined when the production order is calculated.</descrip></descripGrp><ntig><termGrp><term id="593037">PV</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1109469">framleiðslufrávik</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16627_593040_1109471"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method for calculating allocations by using weighted values.</descrip></descripGrp><ntig><termGrp><term id="593040">fixed weight allocation method</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></te