Set xml:lang="en-US"><descripGrp><descrip type="definition">A team type in Microsoft Teams for Education that allows teachers and students to collaborate on group projects, assignments, and more.</descrip></descripGrp><ntig><termGrp><term id="2870703">Class Team</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2870978">Bekkjarteymi</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50713_2870704_2870977"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A team type in Microsoft Teams for Education that allows teachers and students to collaborate on group projects, assignments, and more.</descrip></descripGrp><ntig><termGrp><term id="2870704">Class</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2870977">Bekkur</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50713_2870704_2870978"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A team type in Microsoft Teams for Education that allows teachers and students to collaborate on group projects, assignments, and more.</descrip></descripGrp><ntig><termGrp><term id="2870704">Class</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2870978">Bekkjarteymi</term><termNote type="geographicalUsage">I