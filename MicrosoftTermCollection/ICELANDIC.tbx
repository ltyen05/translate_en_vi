rm><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2741051">viðskiptagagnagrunnur</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34800_2014211_2033357"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A named group of dimension values.</descrip></descripGrp><ntig><termGrp><term id="2014211">dimension value set</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2033357">víddargildissamstæða</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34801_2014212_2033346"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A code in a column definition that restricts or suppresses the data in a column, such as row formatting, details, and amounts.</descrip></descripGrp><ntig><termGrp><term id="2014212">column restriction</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2033346">dálktakmörkun</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34802_2014214_2033351"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A header in a report that is automatically updated each time the report is generated, according to the base period that is defined in the column definition.</descrip></descripGrp><ntig><termGrp><term id="2014214">conditional spanning header</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2033351">fyrirsögn með skilyrt umfang</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34803_2014235_2033341"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A text-based variable in a column definition that is automatically updated each time that a report is generated.</descrip></descripGrp><ntig><termGrp><term id="2014235">Autotext code</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2033341">sjálfvirkur textakóði</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34804_2014236_2033350"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A code in a column definition that displays or does not display a specified column, depending on certain variables or values in the column definition. If the values or variables in the specified report column do not meet the conditions of the code, the column is not displayed or printed in the report.</descrip></descripGrp><ntig><termGrp><term id="2014236">conditional print control code</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2033350">Kóðar fyrir skilyrtar stillingar fyrir prentun</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34805_2014237_2033347"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A value in a column definition that identifies the type of information that is displayed in that column, such as descriptive text, a calculation, financial dimensions, or an accounting attribute.</descrip></descripGrp><ntig><termGrp><term id="2014237">column type</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2033347">dálkgerð</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34806_2014238_2033366"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A code in a report definition that determines whether posted, unposted, or both posted and unposted financial data transactions are included in the report.</descrip></descripGrp><ntig><termGrp><term id="2014238">provisional code</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2033366">tímabundinn kóði</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34807_2014239_2033377"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A transaction that has been entered into the financial data, but that has not yet been posted.</descrip></descripGrp><ntig><termGrp><term id="2014239">unposted transaction</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2033377">óbókuð færsla</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34808_2014240_2033344"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The reporting period that is specified in the report definition, displayed as years. The column definition can refer to the base year to specify report columns for relative time periods.</descrip></descripGrp><ntig><termGrp><term id="2014240">base year</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2033344">grunnár</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34809_2014241_2033369"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The URL or network location where a generated report is stored.</descrip></descripGrp><ntig><termGrp><term id="2014241">report link</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2033369">skýrslutengill</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34810_2014242_2033354"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In a column definition, the list of dimensions that limit the data that is displayed for a report.</descrip></descripGrp><ntig><termGrp><term id="2014242">dimension filter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2033354">víddarafmörkun</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34811_2014243_2033365"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A row that is included in the data of a report but that is not printed or displayed when the report is generated, such as for complex calculations, or the graphic design of a report.</descrip></descripGrp><ntig><termGrp><term id="2014243">non-printing row</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2033365">lína sem ekki er til prentunar</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34812_2014244_2033362"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A text statement that can be used for calculations, and that specifies certain conditions for the data and the resulting behavior for when those conditions are met. The statement uses the terms If, Then, and Else to identify the conditions and results.</descrip></descripGrp><ntig><termGrp><term id="2014244">IF/THEN/ELSE statement</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2033362">IF/THEN/ELSE-yrðing</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34813_2014245_2033364"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that uses the highest and lowest values from a row definition or reporting tree definition to search for accounts or dimensions that are missing from the row definition or reporting tree definition, but that exist in the financial data.</descrip></descripGrp><ntig><termGrp><term id="2014245">missing account analysis</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2033364">reikningsgreiningu vantar</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34814_2014246_2033348"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A worksheet link that combines references to cells in an external worksheet file into the same link column that is used in a report to link to accounts or dimensions.</descrip></descripGrp><ntig><termGrp><term id="2014246">combined worksheet link</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2033348">sameinaður vinnublaðstengill</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34815_2014247_2033363"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In a row definition of a report, the column that contains the links to dimensions and external worksheet files that will be used in a report.</descrip></descripGrp><ntig><termGrp><term id="2014247">link column</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2033363">tengladálkur</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34816_2014248_2033375"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A worksheet link that accesses multiple rows and columns of data in an external worksheet file into a report, or that associates one or more external worksheet files with one or more reporting units in the reporting tree of a report.</descrip></descripGrp><ntig><termGrp><term id="2014248">separate worksheet link</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2033375">aðskilinn vinnublaðstengill</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34817_2014249_2033359"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in the Desktop Viewer that displays the comments in a report and any charts that were created from report data.</descrip></descripGrp><ntig><termGrp><term id="2014249">Fact pane</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2033359">Upplýsingasvæði</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34818_2014250_2033358"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows a user to access the Microsoft Dynamics ERP system from the account level of a report to obtain more information.</descrip></descripGrp><ntig><termGrp><term id="2014250">Drill to Dynamics</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2033358">Kafa í Dynamics</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34819_2014268_2020328"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The maximum limit of a cumulative transaction value, up to which a tax on the transaction value is not calculated.</descrip></descripGrp><ntig><termGrp><term id="2014268">cumulative threshold</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2020328">heildarþröskuldur</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34820_2014269_2020332"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The maximum limit of an individual transaction value that is a part of a cumulative transaction value, up to which a tax on the transaction value is not calculated. The exceptional threshold is applied to an individual transaction value that is a part of a cumulative transaction value that is within the cumulative threshold.</descrip></descripGrp><ntig><termGrp><term id="2014269">exceptional threshold</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2020332">undantekningarþröskuldur</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34821_2014270_2020345"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The maximum limit of a transaction value, up to which a tax on the transaction value is not calculated.</descrip></descripGrp><ntig><termGrp><term id="2014270">transaction threshold</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2020345">færsluþröskuldur</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34822_2014271_2020347"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The maximum limit of a cumulative transaction value, up to which a tax on the transaction value is calculated by using concessional rates instead of standard rates.</descrip></descripGrp><ntig><termGrp><term id="2014271">turnover threshold</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2020347">veltuþröskuldur</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34823_2014314_2020325"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of reserving dates and times for the pickup and delivery of truckloads of goods at specific warehouse locations.</descrip></descripGrp><ntig><termGrp><term id="2014314">appointment scheduling</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2020325">bókun móts</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34824_2014315_2020334"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A permanent location that is assigned to an item in a warehouse. Multiple items can have the same fixed location, and a single item can have multiple fixed locations.</descrip></descripGrp><ntig><termGrp><term id="2014315">fixed location</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2020334">föst staðsetning</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34825_2014316_2020335"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A person or company contracted by a customer to consolidate loads into shipments and then transport and deliver those loads to specified destinations.</descrip></descripGrp><ntig><termGrp><term id="2014316">freight forwarder</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2020335">flutningsmiðlari</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34826_2014317_2020339"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A freight delivery route that entails two or more stops, where the carrier delivers loads either from a single supplier to multiple buyers or from multiple suppliers to a single buyer.</descrip></descripGrp><ntig><termGrp><term id="2014317">milk run</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2020339">samflutningar</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34827_2014318_2020342"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The selection of carrier routes for transporting freight from origin points to destination points.</descrip></descripGrp><ntig><termGrp><term id="2014318">routing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2020342">leiðir</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34828_2014320_2020333"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tool that you can use to categorize inventory items for quick searching. Filters also restrict the availability of items to customers, vendors, and warehouse processes.</descrip></descripGrp><ntig><termGrp><term id="2014320">filter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2020333">sía</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34829_2014321_2020327"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of warehouse-related work items of the same type, based on user-defined criteria (such as location and inventory number).</descrip></descripGrp><ntig><termGrp><term id="2014321">cluster</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2020327">klasi</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34830_2014322_2020331"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A warehouse process where you can control inventory items for multiple orders, shipments, loads, or waves at the docks when inbound items are received or outbound items are loaded.</descrip></descripGrp><ntig><termGrp><term id="2014322">dock management</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2020331">dreifingarstjórnun</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34834_2014332_2020326"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The estimated taxes from production and supply chain that apply to an item or service.</descrip></descripGrp><ntig><termGrp><term id="2014332">approximate taxes</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2020326">áætlaður skattur</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34835_2014333_2020329"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An inventory counting method where items that are stored in different warehouse locations are counted to verify the on-hand inventory levels and to facilitate inventory-level corrections.</descrip></descripGrp><ntig><termGrp><term id="2014333">cycle counting</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2020329">regluleg talning</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34836_2014335_2020337"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A unique number that is assigned to a warehouse entity such as a pallet, bin, cart, or individual item for tracking inventory. You can use this number to ascertain the item location, item quantity, product dimension, and tracking dimension of the entity.</descrip></descripGrp><ntig><termGrp><term id="2014335">license plate number</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2020337">númeraplötunúmer</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34837_2014337_2020341"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An inventory management process in which a warehouse location is automatically or manually restocked based on predefined criteria to maintain the correct inventory levels at the location.</descrip></descripGrp><ntig><termGrp><term id="2014337">replenishment</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2020341">áfylling</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34838_2014338_2020343"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A quantity of freight that is created against a source document such as a sales order, purchase order, or transfer order, and that is transported from an origin point to a destination point. You can consolidate inbound or outbound shipments that are going to the same destination point into a single load.</descrip></descripGrp><ntig><termGrp><term id="2014338">shipment</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2020343">sending</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34839_2014339_2020348"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A logical grouping of warehouse work items that is created by means of a wave template configuration, processed either automatically or manually, and then released to pick the items for production or shipping.</descrip></descripGrp><ntig><termGrp><term id="2014339">wave</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2020348">bylgja</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34840_2014340_2020349"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The entire range of inventory-related tasks that are performed by a company's warehouse employees. The creation of warehouse work is triggered either automatically by user-defined settings or manually by a worker. Each work item is performed on a mobile device by a warehouse worker.</descrip></descripGrp><ntig><termGrp><term id="2014340">work</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2020349">vinna</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34841_2014457_2020346"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A sales order, purchase order, or transfer order that is ready for transportation planning.</descrip></descripGrp><ntig><termGrp><term id="2014457">transportation demand</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2020346">flutningseftirspurn</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34872_2015001_2284377"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An index structure that stores graph nodes and edges and their associated data.</descrip></descripGrp><ntig><termGrp><term id="2015001">graph index</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2284377">yfirlit grafa</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34876_2015005_2725816"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The control that lets users change their photo, presence, and other public information.</descrip></descripGrp><ntig><termGrp><term id="2015005">My profile</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2725816">Notandaupplýsingar mínar</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34904_2015313_2021544"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The calculated value-added tax (VAT) amount that is not due until the invoice is paid. This amount is posted to an unrealized purchase VAT account and can be claimed only after the receipt of a receipt/tax invoice or a tax invoice.</descrip></descripGrp><ntig><termGrp><term id="2015313">unrealized VAT</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2021544">óinnleystur VSK</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34904_2015314_2021544"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The calculated value-added tax (VAT) amount that is not due until the invoice is paid. This amount is posted to an unrealized purchase VAT account and can be claimed only after the receipt of a receipt/tax invoice or a tax invoice.</descrip></descripGrp><ntig><termGrp><term id="2015314">deferred input VAT</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2021544">óinnleystur VSK</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34906_2015316_2021543"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The calculated value-added tax (VAT) amount that is not due until the invoice is paid. This amount is posted to an unrealized sales VAT account and can be claimed only after a receipt or tax invoice is printed.</descrip></descripGrp><ntig><termGrp><term id="2015316">unrealized sales VAT</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2021543">óinnleystur útskattur</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34906_2015317_2021543"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The calculated value-added tax (VAT) amount that is not due until the invoice is paid. This amount is posted to an unrealized sales VAT account and can be claimed only after a receipt or tax invoice is printed.</descrip></descripGrp><ntig><termGrp><term id="2015317">deferred output VAT</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2021543">óinnleystur útskattur</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34907_2015318_2021539"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The tax on an organization’s purchases or input supplies, which is levied on the purchase price.</descrip></descripGrp><ntig><termGrp><term id="2015318">input VAT</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2021539">innskattur</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34907_2015319_2021539"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The tax on an organization’s purchases or input supplies, which is levied on the purchase price.</descrip></descripGrp><ntig><termGrp><term id="2015319">purchase VAT</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2021539">innskattur</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34908_2015320_2021541"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The tax on an organization’s sales, which is levied on the sales price.</descrip></descripGrp><ntig><termGrp><term id="2015320">output VAT</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2021541">útskattur</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34908_2015321_2021541"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The tax on an organization’s sales, which is levied on the sales price.</descrip></descripGrp><ntig><termGrp><term id="2015321">sales VAT</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2021541">útskattur</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34910_2015323_2021542"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A branch office that is used to record value-added tax (VAT) and inventory movement. All the branch offices of a VAT-registered legal entity are referred to as tax branches. Each tax branch uses the same tax registration number as the head office of the legal entity.</descrip></descripGrp><ntig><termGrp><term id="2015323">tax branch</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2021542">skattstofa</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3494_308304_571921"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A person who creates or maintains a weblog.</descrip></descripGrp><ntig><termGrp><term id="308304">blogger</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="571921">bloggari</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3495_160383_571401"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An area that shows available network connections and helps users quickly connect to the most appropriate one.</descrip></descripGrp><ntig><termGrp><term id="160383">Connection Manager</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="571401">Tengingastjórnun</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34963_2017376_2341304"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of search rules that also groups a related set of queries.</descrip></descripGrp><ntig><termGrp><term id="2017376">search topic</term><termN