Set xml:lang="en-US"><descripGrp><descrip type="definition">A number that gives a general indication of the performance capability of your computer's hardware.</descrip></descripGrp><ntig><termGrp><term id="234820">system rating</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="571623">einkunn kerfis</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6484_136942_1485182"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A ready-made button that the user can insert into his/her presentation and define hyperlinks for.</descrip></descripGrp><ntig><termGrp><term id="136942">action button</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1485182">aðgerðahnappur</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6486_310254_571944"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An entity at one end of a point-to-point LAN/WLAN segment that is requesting authenticated access to the network.</descrip></descripGrp><ntig><termGrp><term id="310254">supplicant</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="571944">beiðandi</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote typ