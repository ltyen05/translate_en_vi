ng="en-US"><descripGrp><descrip type="definition">Text or some other element used in an application as an indicator that the user should enter in his or her own text.</descrip></descripGrp><ntig><termGrp><term id="146400">placeholder text</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1822497">staðgengilstexti</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10410_397225_409023"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Text that is added to email messages in transport to provide information that supports the sending organization's compliance policies, warnings about unknown or unverified email senders, or other information as determined by the sending organization. Exchange Server 2007 allows the administrator to use transport rules to target disclaimers based on specific criteria.</descrip></descripGrp><ntig><termGrp><term id="397225">disclaimer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="409023">fyrirvari</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10414_270278_571821"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A line that separates the numerator and denominator of a fraction.</descrip></descripGrp><ntig><termGrp><term id="270278">fraction bar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">S