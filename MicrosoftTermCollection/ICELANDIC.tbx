49"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A predefined dimension that is used to differentiate between different modeling scenarios. For example, you can use this dimension to track values for budget, actual, and forecasted scenarios for any given period of time. It is automatically included with every model.</descrip></descripGrp><ntig><termGrp><term id="419229">Scenario</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1984549">bókarkóði</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15781_347932_572226"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The field on a form in which the cursor or pointer is positioned.</descrip></descripGrp><ntig><termGrp><term id="347932">active field</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="572226">virkur reitur</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15784_139149_571257"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An index file with two columns: the first column lists the text in the document that you want to index, and the second column lists the index entries to generate from the text in the first column.</descrip></descripGrp><ntig><termGrp><term id="139149">concordance file</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singu