ig><termGrp><term id="1365340">vendor invoice</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1430986">reikningur lánardrottins</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27099_1365343_2139786"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application that lets you route and queue incoming calls to designated persons for a special purpose, such as customer service. The queue holds callers until an agent answers the call.</descrip></descripGrp><ntig><termGrp><term id="1365343">Response Group</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2139786">Svarhópur</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2710_1508527_1485167"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The vertical reference line on a grid, chart, or graph that has horizontal and vertical dimensions.</descrip></descripGrp><ntig><termGrp><term id="1508527">y axis</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1485167">lóðréttur ás</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected