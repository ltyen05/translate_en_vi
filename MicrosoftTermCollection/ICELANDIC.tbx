nition">The deviation from an exact value resulting from the use of rounding.</descrip></descripGrp><ntig><termGrp><term id="640511">rounding difference</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1984579">sléttunarmismunur</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17362_640511_1984581"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The deviation from an exact value resulting from the use of rounding.</descrip></descripGrp><ntig><termGrp><term id="640511">rounding difference</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1984581">sléttunarvilla</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17362_640512_1984579"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The deviation from an exact value resulting from the use of rounding.</descrip></descripGrp><ntig><termGrp><term id="640512">rounding error</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1984579">sléttunarmismunur</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17362_640512_1984581"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The deviation from an exact value resulting from the use of rounding.</descrip></descripGrp><ntig><termGrp><term id="640512">rounding error</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1984581">sléttunarvilla</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17363_640513_1984560"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To total amounts vertically. The resulting sum can be checked against a total obtained by cross-footing (adding amounts horizontally).</descrip></descripGrp><ntig><termGrp><term id="640513">foot</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1984560">leggja saman</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17364_640514_1984556"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To add amounts across a row (horizontally). The resulting total can be checked against a total obtained by footing (adding amounts vertically).</descrip></descripGrp><ntig><termGrp><term id="640514">cross-foot</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1984556">leggja saman dálka</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17365_640515_1984575"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A segment of a general ledger account code that corresponds to a category within the overall structure of the organization, such as location, division, department, area, task, project, or product.</descrip></descripGrp><ntig><termGrp><term id="640515">responsibility account code segment</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1984575">ábyrgðarhluti</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17365_640516_1984575"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A segment of a general ledger account code that corresponds to a category within the overall structure of the organization, such as location, division, department, area, task, project, or product.</descrip></descripGrp><ntig><termGrp><term id="640516">responsibility segment</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1984575">ábyrgðarhluti</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17366_640517_1984592"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A currency that can be used to convert between two other currencies for which there is no direct exchange rate table available. The triangulation currency must have available exchange rates with both of the currencies to be converted. The first currency can be converted into the common (triangulation) currency, and then the common currency can be converted into the second currency.</descrip></descripGrp><ntig><termGrp><term id="640517">triangulation currency</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1984592">þríhliðunargjaldmiðill</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17367_640518_1984552"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">One of three primary elements (row worksheet, column worksheet, and reporting tree) used to construct a report in Management Reporter.</descrip></descripGrp><ntig><termGrp><term id="640518">building block</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1984552">eining</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17368_640519_1984571"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A structured set of files (row worksheets, column worksheets and reporting trees) that are combined to create a financial report.</descrip></descripGrp><ntig><termGrp><term id="640519">report library</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1984571">skýrslusafn</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17370_640672_652837"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The balancing of two transactions, such as a payment and an invoice. The purpose of a settlement is to reduce the outstanding balance between the transactions to zero.</descrip></descripGrp><ntig><termGrp><term id="640672">settlement</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="652837">jöfnun</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17371_640679_652825"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The code that represents the cause for a certain action.</descrip></descripGrp><ntig><termGrp><term id="640679">reason code</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="652825">ástæðukóði</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17372_640684_1984551"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A virtual container that holds a particular category of items or data.</descrip></descripGrp><ntig><termGrp><term id="640684">bucket</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1984551">rammi</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17373_640685_1109517"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The date at which something goes into effect or becomes applicable.</descrip></descripGrp><ntig><termGrp><term id="640685">effective date</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1109517">virk dagsetning</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17373_640685_1984557"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The date at which something goes into effect or becomes applicable.</descrip></descripGrp><ntig><termGrp><term id="640685">effective date</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1984557">gildisdagsetning</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17373_645361_1109517"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The date at which something goes into effect or becomes applicable.</descrip></descripGrp><ntig><termGrp><term id="645361">active date</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1109517">virk dagsetning</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17373_645361_1984557"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The date at which something goes into effect or becomes applicable.</descrip></descripGrp><ntig><termGrp><term id="645361">active date</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1984557">gildisdagsetning</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17375_640688_1984589"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To rearrange and resize open files or windows into vertical tiles that display next to one another without overlapping.</descrip></descripGrp><ntig><termGrp><term id="640688">tile vertically</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1984589">raða lóðrétt</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17376_640701_652758"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A quantifiable, standardized measurement of  the risk of loss resulting from inadequate or failed business processes.</descrip></descripGrp><ntig><termGrp><term id="640701">key risk indicator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="652758">áhættumælikvarði</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17376_640701_652760"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A quantifiable, standardized measurement of  the risk of loss resulting from inadequate or failed business processes.</descrip></descripGrp><ntig><termGrp><term id="640701">key risk indicator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="652760">KRI (áhættumælikvarði)</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17376_640702_652758"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A quantifiable, standardized measurement of  the risk of loss resulting from inadequate or failed business processes.</descrip></descripGrp><ntig><termGrp><term id="640702">KRI</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="652758">áhættumælikvarði</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17376_640702_652760"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A quantifiable, standardized measurement of  the risk of loss resulting from inadequate or failed business processes.</descrip></descripGrp><ntig><termGrp><term id="640702">KRI</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="652760">KRI (áhættumælikvarði)</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17380_640755_652810"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">One or more recommendation work streams that are bundled and executed simultaneously and time-constrained, and which use compensation information for a group of employees to create date-specific employee compensation records. A process event can be as simple as an anniversary-based merit increase for one employee, or as complex as an annual enterprise-wide combined compensation process.</descrip></descripGrp><ntig><termGrp><term id="640755">process event</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="652810">vinnslutilvik</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17381_640756_652673"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A structure of compensation levels that includes broad ranges of pay per level and is generally defined by grouping jobs with similar aggregate levels of responsibility. Pay for individual jobs is often linked to the external market. Bands are also typically differentiated by the variable compensation awards available at each band. Broad banding eliminates the hierarchy and narrow ranges of graded structures and allows ranges to overlap (for example, the 90th percentile of Band B equals the 10th percentile of Band C). Broad bands do not contain midpoints and generally do not have fixed minimums or maximums (for example, allowing pay that is either below a minimum or above a maximum rate within a band because the external market determines a specific job rate). Companies can store additional reference points for a band, such as a 50th percentile (or Control Point), 25th and 75th percentile, and base variable compensation on one of those points.</descrip></descripGrp><ntig><termGrp><term id="640756">broad band</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="652673">launarim</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17382_640757_652790"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A compensation level structure that defines discrete ranges of pay per level, and are generally defined by hierarchical levels of authority within a company. Jobs are typically evaluated by a point system that places them at a grade relative to others within the company. Pay rates for a grade are typically determined by using equivalent groups of jobs in the marketplace as benchmarks. Graded structures are narrower than bands, and are typically discrete (for example, pay ranges do not overlap). Grade pay ranges have a fixed minimum, midpoint (or control point), and maximum reference points. Compa-ratios and range utilization are measures used to analyze an employee’s pay relative to their range. Companies can set additional reference points for a grade, such as 25th and 75th percentile, and base variable compensation on one of those points.</descrip></descripGrp><ntig><termGrp><term id="640757">pay grade</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="652790">launaflokkur</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17387_641212_1485220"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A container with a set of properties that can be configured to control the organization and format of Web Parts on a Web Part Page.</descrip></descripGrp><ntig><termGrp><term id="641212">Web Part zone</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1485220">Vefhlutasvæði</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1739_149687_1170726"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A formula that checks whether a given value is valid for a particular field.</descrip></descripGrp><ntig><termGrp><term id="149687">validation formula</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1170726">prófunarformúla</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17392_641335_652847"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A compensation level structure that defines discrete amounts of pay per level. Pay is described as a specific amount, and frequency is usually expressed as hourly. For example, one step may have ten increasing, specific rates of hourly pay. Pay increases move an employee from one rate to another within a step for a specific reason, such as the length of tenure or improved skills.</descrip></descripGrp><ntig><termGrp><term id="641335">step compensation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="652847">uppbót í hlutabréfum</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="174_138672_2725813"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A hierarchical organization of media clips that users can create, import, add additional clips collections to, move, or copy clips from one collection into it.</descrip></descripGrp><ntig><termGrp><term id="138672">clip collection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2725813">klippusafn</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1740_231978_1822568"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">For automatic subtotals and worksheet outlines, all rows or columns that summarize detail data. Summary data usually is adjacent to and below the detail data.</descrip></descripGrp><ntig><termGrp><term id="231978">summary data</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1822568">samantektargögn</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1741_128742_2593107"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Teleconferencing in which video images are transmitted among the various geographically separated participants in a meeting.</descrip></descripGrp><ntig><termGrp><term id="128742">video conferencing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2593107">myndfundir</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17419_645117_1485221"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of reusable settings that describes the shared attributes and behaviors of a list item, a document, or a folder.</descrip></descripGrp><ntig><termGrp><term id="645117">content type</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1485221">efnisgerð</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17422_645120_1822678"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Stored on a server or client computer that is configured to control access to content by using information rights management (IRM) technology.</descrip></descripGrp><ntig><termGrp><term id="645120">rights-managed</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1822678">stýrt með heimildum</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17423_645348_1109518"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An accumulation of numeric data that can be used for reporting purposes, such as yearly taxable earnings for the T4 or W 2 statement, or used in a calculation. For example, Canada Pension Plan, Social Security, Medicare, and withholding taxes are based on accumulators. The contents of an accumulator can be manually adjusted, preset, and deleted.</descrip></descripGrp><ntig><termGrp><term id="645348">accumulator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1109518">uppsafnari</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17424_645349_1109519"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A code that represents a specific numerical calculation that returns a numeric amount.</descrip></descripGrp><ntig><termGrp><term id="645349">calculation code</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1109519">útreikningskóði</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17425_645350_1109520"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A code that represents a period of time measured by starting and ending dates.</descrip></descripGrp><ntig><termGrp><term id="645350">date period code</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1109520">tímabilskóði</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17426_645351_1109521"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A code that represents the department in which an employee performs a job.</descrip></descripGrp><ntig><termGrp><term id="645351">department organization code</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1109521">deildarkóði</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17427_645352_1109522"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A code that represents the type of earnings paid to an employee.</descrip></descripGrp><ntig><termGrp><term id="645352">earning code</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1109522">tekjukóði</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17428_645353_1109523"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A unique alphanumeric identifier that is associated with an employee.</descrip></descripGrp><ntig><termGrp><term id="645353">employee ID</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1109523">kenni starfsmanns</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17429_645354_1109524"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A unique identifier that is associated to an employee’s job.</descrip></descripGrp><ntig><termGrp><term id="645354">job ID</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1109524">vinnslukenni</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17430_645355_1109525"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A code that represents the physical location where an employee works in the organization.</descrip></descripGrp><ntig><termGrp><term id="645355">location code</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1109525">staðsetningarkóði</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17431_645356_1109526"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A code that represents the type of work performed by an employee within the organization.</descrip></descripGrp><ntig><termGrp><term id="645356">occupation code</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1109526">starfskóði</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termE