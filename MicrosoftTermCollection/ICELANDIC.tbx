Number">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="570440">hljóð</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10452_107217_3041765"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In color management, the purity of a color's hue, moving from gray to the pure color.</descrip></descripGrp><ntig><termGrp><term id="107217">saturation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="3041765">mettun</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10454_235424_1109152"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A specific task in the manufacturing process.</descrip></descripGrp><ntig><termGrp><term id="235424">operation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1109152">aðgerð</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10459_116136_2179029"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of markup in markup languages. A start tag is the starting element of a tag pair which contains metainformation about some part of the text.</descrip></desc