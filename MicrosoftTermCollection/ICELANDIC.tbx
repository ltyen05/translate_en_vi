et><langSet xml:lang="is"><ntig><termGrp><term id="2834632">Námsefni</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50047_2834194_2834630"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An effect applied to the background of a design, image or video call where the background is obscured but the speaker's image remains clear.</descrip></descripGrp><ntig><termGrp><term id="2834194">blur</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2834630">móða</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50047_2834194_3137410"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An effect applied to the background of a design, image or video call where the background is obscured but the speaker's image remains clear.</descrip></descripGrp><ntig><termGrp><term id="2834194">blur</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="3137410">bakgrunnsmóða</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50047_2849656_2834630"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An effect applied to the background of a design, image or video call where the background is obscured but the speaker's image remains clear.</descrip></descripGrp><ntig><termGrp><term id="2849656">background blur</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2834630">móða</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50047_2849656_3137410"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An effect applied to the background of a design, image or video call where the background is obscured but the speaker's image remains clear.</descrip></descripGrp><ntig><termGrp><term id="2849656">background blur</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="3137410">bakgrunnsmóða</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50078_2834844_2953357"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mode used when you are giving a presentation that unmutes your microphone for the duration of the presentation.</descrip></descripGrp><ntig><termGrp><term id="2834844">presenter mode</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2953357">kynnisstilling</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5008_139790_1822451"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A modal, custom pop-up form that asks users for additional information or to display a message.</descrip></descripGrp><ntig><termGrp><term id="139790">custom dialog box</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1822451">sérstilltur svargluggi</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50089_2834942_2838002"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in Outlook for mobile that helps users listen, triage and reply to emails while on the go (such as when travelling in a car).</descrip></descripGrp><ntig><termGrp><term id="2834942">Play My Emails</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2838002">Spila tölvupóst</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50090_2834944_2837999"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in Excel for the web that enables users to create, run and record automated scripts in Excel and use them across platforms. By creating an Office Script, users can create background tasks that run automatically in the cloud and update their spreadsheet automatically, enabling information to continuously be up-to-date with no action required on the user's part. This helps users to run their businesses more efficiently anytime and anywhere - without needed coding knowledge.</descrip></descripGrp><ntig><termGrp><term id="2834944">Office Scripts</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2837999">Office-forskriftir</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50091_2834946_2837988"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Set of audit features and capabilities offered within our Microsoft 365 E3 SKU. These include providing audit logs of high-level events to help compliance reporting needs and additional features from new non-Office 365 products such as Microsoft Defender Advanced Threat Protection.</descrip></descripGrp><ntig><termGrp><term id="2834946">Audit</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2837988">Eftirlit</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50092_2834947_2837990"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A template within Advanced eDiscovery that enables compliance officers to monitor communications for certain roles within the organization, making it easier to meet regulatory requirements or internal policies.</descrip></descripGrp><ntig><termGrp><term id="2834947">Communication compliance</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2837990">Samskiptaeftirlit</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50093_2834948_2837989"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Office 365 feature that calls out a person’s most important to-dos and consolidates them in one convenient email to help the person better prepare for the day ahead (or specific part of the day/week depending on the settings for receiving email).</descrip></descripGrp><ntig><termGrp><term id="2834948">Briefing</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2837989">Verkefnayfirlit</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50094_2834949_2837992"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Microsoft Teams, a digital bulletin board where you can pin notes, ideas, and inspiration to share in your team space.</descrip></descripGrp><ntig><termGrp><term id="2834949">Corkboard</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2837992">Korktafla</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50095_2834950_2838001"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of features that work across tenant (and hybrid) boundaries, including cross-tenant people search, cross-tenant identity and data migration and data migration to/from on-premises deployments.</descrip></descripGrp><ntig><termGrp><term id="2834950">Organization Relationships</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2838001">Tengingar milli tölvupóstkerfa</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50096_2834951_2837996"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An offering/program that gives end users the ability to get the full Microsoft Teams experience that their company may already have for other licensed users in their organization.</descrip></descripGrp><ntig><termGrp><term id="2834951">Microsoft Teams Exploratory</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2837996">Kynningarleið Microsoft Teams</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50097_2834952_2837993"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature within the Microsoft 365 security portfolio that helps prevent inappropriate or accidental copying or sharing of sensitive information that lives on endpoints (i.e. devices, specifically Windows 10 devices).</descrip></descripGrp><ntig><termGrp><term id="2834952">Endpoint Data Loss Prevention</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2837993">Gagnatapsvörn á endastað</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50098_2834953_2838006"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature within Microsoft Outlook and Microsoft Teams that helps users quickly close the loop on an e-mail, either by sending a quick response or by taking a suggested action, such as scheduling a meeting, creating a task, sending a file etc.</descrip></descripGrp><ntig><termGrp><term id="2834953">Suggested Actions</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2838006">Tillögur að aðgerðum</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50099_2834954_2837998"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A device-based license of Office 365 that will allow commercial IT admins to assign an Office 365 ProPlus license to a device rather than to a user with an AAD identity. This solution provides a device-based subscription model that mirrors the user-based subscription model in ease of management and sign-in.</descrip></descripGrp><ntig><termGrp><term id="2834954">Office 365 ProPlus (device)</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2837998">Office 365 ProPlus (tæki)</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="501_140730_1822455"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The range of cells that you select to hold the summarized data in a consolidation. The destination area can be on the same worksheet as the source data or on a different worksheet. A worksheet can contain only one consolidation.</descrip></descripGrp><ntig><termGrp><term id="140730">destination area</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1822455">viðtökusvæði</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50100_2834955_2838003"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature within Microsoft Teams that helps a teacher make a Reading Assignment, lets the student record themselves reading, and then submit to the teacher for miscue analysis. Additionally, the computer will “listen” to the person read, and then gives computer generated “miscue analysis” feedback automatically to the teacher.</descrip></descripGrp><ntig><termGrp><term id="2834955">Reading Progress</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2838003">Lestrarframvinda</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50101_2834956_2838005"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The name of a podcast that will provide stories and advice from experts in the trenches, and give listeners access to the best of security analytics, security personalities, and security researchers.</descrip></descripGrp><ntig><termGrp><term id="2834956">Security Unlocked</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2838005">Security Unlocked</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50102_2834957_2837987"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application mounting capability for MSIX packaged apps whereby apps are mounted to a device/virtual machine (VM) from a remote file server location and all data transfer happens over the Azure's back end.</descrip></descripGrp><ntig><termGrp><term id="2834957">MSIX app attach</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2837987">forritatenging</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50102_2834957_2837997"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application mounting capability for MSIX packaged apps whereby apps are mounted to a device/virtual machine (VM) from a remote file server location and all data transfer happens over the Azure's back end.</descrip></descripGrp><ntig><termGrp><term id="2834957">MSIX app attach</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2837997">MSIX-forritatenging</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50102_2834958_2837987"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application mounting capability for MSIX packaged apps whereby apps are mounted to a device/virtual machine (VM) from a remote file server location and all data transfer happens over the Azure's back end.</descrip></descripGrp><ntig><termGrp><term id="2834958">app attach</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2837987">forritatenging</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50102_2834958_2837997"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application mounting capability for MSIX packaged apps whereby apps are mounted to a device/virtual machine (VM) from a remote file server location and all data transfer happens over the Azure's back end.</descrip></descripGrp><ntig><termGrp><term id="2834958">app attach</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2837997">MSIX-forritatenging</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50103_2834961_2837994"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A service offering that enables enterprise customers to become the controller (GDPR) for Windows diagnostic data collected from devices enrolled under this service. With this service, data will be governed by Microsoft’s Online Services Terms, and stored in a high compliance boundary, separate from Windows diagnostic data that Microsoft collects as controller.</descrip></descripGrp><ntig><termGrp><term id="2834961">Enterprise Data Processor Service for Windows</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2837994">Vinnsluþjónusta fyrirtækjagagna fyrir Windows</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50105_2834963_2838004"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Office 365 feature that detects when a reply-all or conversation mail storm is brewing in your mail service and temporarily blocks subsequent reply-alls to the thread while issuing a bounce back message (NDR) to the sender who is attempting to reply all. After a "cool down" period (e.g. 2 to 4 hours), the feature will remove the block and allow emails on the thread again (some exceptions can be made during the cool down).</descrip></descripGrp><ntig><termGrp><term id="2834963">Reply-All Storm Protection</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2838004">Vörn gegn svörum á alla</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50115_2835484_2841307"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A page in the Office 365 Security &amp; Compliance Center where the user can turn on audit logging and search the unified audit log to view user and administrator activity in the Office 365 organization.</descrip></descripGrp><ntig><termGrp><term id="2835484">Audit log search</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2841307">Leit í eftirlitsannál</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50116_2835485_2841309"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To tap a device screen twice and on the second tap, hold one's finger or stylus in place.</descrip></descripGrp><ntig><termGrp><term id="2835485">double tap and hold</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2841309">pikka tvisvar og halda</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50117_2835490_2841329"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A regular telephone number meant for a single user to receive and place calls. User numbers can be assigned to any PSTN Calling user.</descrip></descripGrp><ntig><termGrp><term id="2835490">user number</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2841329">notandanúmer</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50118_2835492_2841326"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Skype telephone number that is used for audio conferencing, auto attendants, or a call queue</descrip></descripGrp><ntig><termGrp><term id="2835492">service number</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2841326">þjónustunúmer</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50122_2835501_2841320"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Chat running during the meeting and related to the meeting topic.</descrip></descripGrp><ntig><termGrp><term id="2835501">meeting chat</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2841320">fundarspjall</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50124_2835509_2841312"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A civic address--with an optional place</descrip></descripGrp><ntig><termGrp><term id="2835509">emergency location</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2841312">neyðarstaðsetning</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50124_2835509_2841313"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A civic address--with an optional place</descrip></descripGrp><ntig><termGrp><term id="2835509">emergency location</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2841313">staðsetning neyðartilviks</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50124_2835527_2841312"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A civic address--with an optional place</descrip></descripGrp><ntig><termGrp><term id="2835527">emergency response location</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2841312">neyðarstaðsetning</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50124_2835527_2841313"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A civic address--with an optional place</descrip></descripGrp><ntig><termGrp><term id="2835527">emergency response location</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2841313">staðsetning neyðartilviks</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50124_2835531_2841312"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A civic address--with an optional place</descrip></descripGrp><ntig><termGrp><term id="2835531">ERL</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2841312">neyðarstaðsetning</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50124_2835531_2841313"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A civic address--with an optional place</descrip></descripGrp><ntig><termGrp><term id="2835531">ERL</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2841313">staðsetning neyðartilviks</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50125_2835510_2841311"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A civic address--the physical or street address of a place of business for your organization that is used to route emergency calls to the appropriate dispatch authorities and to assist in locating the emergency caller.</descrip></descripGrp><ntig><termGrp><term id="2835510">emergency address</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2841311">heimilisfang fyrir neyðarþjónustu</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50127_2835544_2841314"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The public organizations whose job is to take quick action to deal with emergencies when they occur, especially the fire brigade, the police, and the ambulance service.</descrip></descripGrp><ntig><termGrp><term id="2835544">emergency services</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2841314">neyðarþjónusta</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50128_2835552_2841315"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A function - when enabled, Teams retrieves policy and location information from the service and includes that information as part of the emergency call.</descrip></descripGrp><ntig><termGrp><term id="2835552">enhanced emergency services</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2841315">aukin neyðarþjónusta</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50130_2835555_2841328"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A measured employee that interacts with other collaborators in meetings and with email.</descrip></descripGrp><ntig><termGrp><term id="2835555">time investor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2841328">tímafjárfestir</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50131_2835558_2841319"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The employees to whom your Workplace Analytics administrator assigned licenses during setup. After license assignment, Workplace Analytics extracts Office 365 data about meetings, email, unscheduled calls, and instant messages for these people. If you are an analyst or limited analyst, this is the population that you can analyze within Workplace Analytics. The number of measured employees can help determine whether you have good data coverage for analysis.</descrip></descripGrp><ntig><termGrp><term id="2835558">measured employee</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2841319">mældur starfsmaður</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50132_2835563_2841310"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A number that identifies an emergency location.</descrip></descripGrp><ntig><termGrp><term id="2835563">Emergency Location Identification Number</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2841310">auðkennisnúmer neyðarstaðsetningar</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50132_2835565_2841310"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A number that identifies an emergency location.</descrip></descripGrp><ntig><termGrp><term id="2835565">ELIN</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2841310">auðkennisnúmer neyðarstaðsetningar</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50133_2835566_2841330"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The time between the person's first email or meeting and the last email or meeting in a day, counted from Monday to Friday, with a minimum of four hours and a maximum of 16 hours per day.</descrip></descripGrp><ntig><termGrp><term id="2835566">workweek span</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2841330">lengd vinnuviku</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50134_2835567_2841308"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A number that translates into the value of the emergency dial string.</descrip></descripGrp><ntig><termGrp><term id="2835567">dial mask</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2841308">hraðvalsnúmer</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50136_2835569_2841316"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Non-scheduled business time periods that last less than two hours.</descrip></descripGrp><ntig><termGrp><term id="2835569">fragmented hours</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2841316">dreifður tími</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50138_2835571_2841321"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Typically a floor, building, wing, or office number. Place is associated with an emergency address to give a more exact location within a building.</descrip></descripGrp><ntig><termGrp><term id="2835571">place</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2841321">staður</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50139_2835572_2841325"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An emergency address that is assigned to each Calling Plan user; it is sometimes referred to as a static emergency address or address of record.</descrip></descripGrp><ntig><termGrp><term id="2835572">registered address</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2841325">skráð heimilisfang</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5015_358327_572248"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of taking a single-table database and breaking it into a set of smaller, related tables, with each table focused on a single topic or grouping of information.</descrip></descripGrp><ntig><termGrp><term id="358327">normalization</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="572248">skipulagning</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50150_2836048_2841306"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The speed at which an object rotates or revolves relative to another position, such as with respect to the x, y, and z axes. It is measured with a gyrometer.</descrip></descripGrp><ntig><termGrp><term id="2836048">angular velocity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2841306">hornhraði</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50151_2836049_2841318"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A sensor that measures angular velocity.</descrip></descripGrp><ntig><termGrp><term id="2836049">gyrometer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2841318">snúningshraðamælir</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50152_2836052_2841305"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A sensor that returns G-force values with respect to the x, y, and z axes.</descrip></descripGrp><ntig><termGrp><term id="2836052">accelerometer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2841305">hröðunarmælir</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50153_2836056_2841317"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Gravitational force equivalent - A measurement of the type of force per unit mass – typically acceleration – that causes a perception of weight.</descrip></descripGrp><ntig><termGrp><term id="2836056">G-force</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2841317">aðdráttarkraftur</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50156_2836765_2841899"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A search carried out on the audit log to view user and administrator activity in an Office 365 organization, for example, to find if a user viewed a specific document or purged an item from their mailbox.</descrip></descripGrp><ntig><termGrp><term id="2836765">audit log search</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2841899">leit í eftirlitsannál</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50158_2836783_2852957"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Microsoft's multilingual machine translation cloud service, offering both text and speech translation, which is integrated across multiple consumer, developer, and enterprise products.</descrip></descripGrp><ntig><termGrp><term id="2836783">Microsoft Translator</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2852957">Microsoft Translator</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50159_2836785_2852960"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Microsoft Translator app designed for use by teachers, students and parents in education. Used for language translation but also for students who are deaf or hard of hearing, dyslexic, or having trouble taking notes.</descrip></descripGrp><ntig><termGrp><term id="2836785">Translator for Education</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2852960">Þýðingar fyrir skóla</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50163_2837378_2900337"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of guiding report creators to use datasets that are either certified or verified.</descrip></descripGrp><ntig><termGrp><term id="2837378">endorsement</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2900337">framsal</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50168_2837893_2838654"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The engagement channel that enables chat operators to connect with customers in real-time.</descrip></descripGrp><ntig><termGrp><term id="2837893">Chat for Dynamics 365</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2838654">Spjall fyrir Dynamics 365</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50169_2837894_2838655"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The add-on that expands and unifies the core capabilities of Omnichannel for Customer Service. It empowers contact centers to provide seamless, more personalized customer service across a wide range of channels.</descrip></descripGrp><ntig><termGrp><term id="2837894">Digital Messaging</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2838655">Stafræn skilaboðaþjónusta</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50170_2837895_2838656"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The extensible framework that enables building immersive communication experiences with third-party channel providers.</descrip></descripGrp><ntig><termGrp><term id="2837895">Dynamics 365 Channel Integration Framework</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2838656">Dynamics 365-rammi fyrir samþættingu söluleiða</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50171_2837896_2838657"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that uses the power of Microsoft Azure AI to take call recording data and provide actionable insights based on the content of the phone call.</descrip></descripGrp><ntig><termGrp><term id="2837896">Dynamics 365 for Call Intelligence</term><termNote type="part