grant a person, computer process, or device access to certain information, services or functionality.</descrip></descripGrp><ntig><termGrp><term id="17417">authorize</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1758796">heimila</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10171_213821_1109142"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An official notice of a bank debit transaction.</descrip></descripGrp><ntig><termGrp><term id="213821">debit advice</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1109142">skuldfærslutilkynning</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10179_143328_1822474"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A bar marked off in units of measure (such as inches) that is displayed across the top of the document window.</descrip></descripGrp><ntig><termGrp><term id="143328">horizontal ruler</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1822474">lárétt reglustika</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1018_32207_570558"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To press and release a mouse button once without moving the mouse, usually to select or deselect an item or to activate a program or program feature.</descrip></descripGrp><ntig><termGrp><term id="32207">click</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="570558">smella</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10180_131401_571197"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An image that appears as the background to a document. Generally faded and transparent, so that text can be clearly read over it.</descrip></descripGrp><ntig><termGrp><term id="131401">watermark</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="571197">vatnsmerki</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10186_126193_2304665"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To remove oneself as a recipient on a mailing list.</descrip></descripGrp><ntig><termGrp><term id="126193">unsubscribe</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2304665">hætta áskrift</term><termNote type="geo