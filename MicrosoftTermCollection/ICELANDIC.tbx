.</descrip></descripGrp><ntig><termGrp><term id="2014201">row code</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2033372">línukóði</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34793_2014202_2033360"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To hold a row of a report in a static position so that the row continues to be displayed as you scroll up or down in the report.</descrip></descripGrp><ntig><termGrp><term id="2014202">freeze horizontal</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2033360">festa lárétt</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34794_2014203_2033361"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To hold a column of a report in a static position so that the column continues to be displayed as you scroll right or left in the report.</descrip></descripGrp><ntig><termGrp><term id="2014203">freeze vertical</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2033361">festa lóðrétt</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34795_2014204_2033367"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A building block that uses a row definition, a column definition, and an optional reporting tree definition to build a report.</descrip></descripGrp><ntig><termGrp><term id="2014204">report definition</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2033367">skýrsluskilgreining</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34796_2014205_2033343"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The row of a report that is used for percentage calculations in a column definition.</descrip></descripGrp><ntig><termGrp><term id="2014205">base row</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2033343">grunnlína</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34797_2014206_2033371"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A building block that contains individual reporting units and is arranged like an organizational chart.</descrip></descripGrp><ntig><termGrp><term id="2014206">reporting tree definition</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="203337