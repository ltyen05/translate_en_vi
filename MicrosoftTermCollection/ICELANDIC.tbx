_570703"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A menu that drops from the menu bar when requested and remains open without further action until the user closes it or chooses a menu item.</descrip></descripGrp><ntig><termGrp><term id="2767716">pulldown menu</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="570703">fellivalmynd</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45_2767717_570703"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A menu that drops from the menu bar when requested and remains open without further action until the user closes it or chooses a menu item.</descrip></descripGrp><ntig><termGrp><term id="2767717">pull-down menu</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="570703">fellivalmynd</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45_48540_570703"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A menu that drops from the menu bar when requested and remains open without further action until the user closes it or chooses a menu item.</descrip></descripGrp><ntig><termGrp><term id="48540">drop-down menu</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="570703">fellivalmynd</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="450_36297_1822376"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A character that indicates a relationship between two or more  expressions.</descrip></descripGrp><ntig><termGrp><term id="36297">comparison operator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1822376">samanburðarvirknitákn</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45000_2539099_2598092"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The act of selling an asset usually a long term asset that has been depreciated over its useful life like production equipment. The transaction will either have a positive or negative effect on the company's balance sheet.</descrip></descripGrp><ntig><termGrp><term id="2539099">fixed assets disposal</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2598092">ráðstöfun eigna</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45001_2539100_2598093"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A subsidiary in a group with which you perform intercompany transactions.</descrip></descripGrp><ntig><termGrp><term id="2539100">intercompany partner</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2598093">millifyrirtækjafélagi</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45002_2539101_2598094"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A calculation or estimate of inventory levels to help ensure optimal inventory control.</descrip></descripGrp><ntig><termGrp><term id="2539101">inventory forecast</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2598094">birgðaspá</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45003_2539102_2598095"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The current amount of a product that a business has in stock.</descrip></descripGrp><ntig><termGrp><term id="2539102">inventory level</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2598095">birgðastaða</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45004_2539104_2598096"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A warranty where the manufacturer offers to pay a technician to replace or fix a defective product.</descrip></descripGrp><ntig><termGrp><term id="2539104">labor warranty</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2598096">ábyrgð á vinnu</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45005_2539105_2598097"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Short-term investments that mature in less than one year. Liquid funds allow investors access to their funds should the need or desire arise with no penalty. The maturity of liquid funds range from three months to one year, offering the investor an opportunity to see a return on investments without tying their assets up for long periods of time.</descrip></descripGrp><ntig><termGrp><term id="2539105">liquid fund</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2598097">lausafé</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45006_2539106_2598098"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A line on a business document that contains text only, such as a note to a customer, and therefore does not create a financial entry when posted.</descrip></descripGrp><ntig><termGrp><term id="2539106">non-transactional text line</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2598098">færslulaus textalína</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45007_2539107_2598099"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The amount of a product which is available and the amount which is wanted by customers.</descrip></descripGrp><ntig><termGrp><term id="2539107">supply and demand</term><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2598099">framboð og eftirspurn</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45009_2539111_2598100"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The network of retailers, distributors, transporters, storage facilities and suppliers that participate in the sale, delivery and production of a particular product.</descrip></descripGrp><ntig><termGrp><term id="2539111">supply chain</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2598100">aðfangakeðja</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termE