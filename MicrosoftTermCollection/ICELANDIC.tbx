agreement.</descrip></descripGrp><ntig><termGrp><term id="2886754">lessee</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2887438">leigjandi</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51142_2886755_2887439"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A person who conveys the right to use real or personal property or services under a lease agreement.</descrip></descripGrp><ntig><termGrp><term id="2886755">lessor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2887439">leigusali</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51143_2886756_2887440"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A lease for which the underlying asset is of low value.</descrip></descripGrp><ntig><termGrp><term id="2886756">low-value lease</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2887440">leiga verðlítillar eignar</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51144_2886757_2887441"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of lease that allows for the use of an asset but does not convey ownership rights of the asset.</descrip></descripGrp><ntig><termGrp><term id="2886757">operating lease</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2887441">rekstrarleigusamningur</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51145_2886758_2887442"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In accounting, a remaining value of an asset after it has been fully depreciated.</descrip></descripGrp><ntig><termGrp><term id="2886758">residual value</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2887442">hrakvirði</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51146_2886759_2887443"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In accounting, the lessee's license to hold, operate, or occupy the leased property or item over the lease term.</descrip></descripGrp><ntig><termGrp><term id="2886759">right-of-use asset</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2887443">afnotaréttur af eign</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender