pe="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1108762">ACRS</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="100_258334_1108761"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A system of depreciation that assigns depreciation methods to different classes of assets. Created by the Economic Recovery Tax Act of 1981 for U.S. tax purposes and modified by the Tax Reform Act of 1986.</descrip></descripGrp><ntig><termGrp><term id="258334">ACRS</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1108761">flýtiafskrift</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="100_258334_1108762"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A system of depreciation that assigns depreciation methods to different classes of assets. Created by the Economic Recovery Tax Act of 1981 for U.S. tax purposes and modified by the Tax Reform Act of 1986.</descrip></descripGrp><ntig><termGrp><term id="258334">ACRS</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1108762">ACRS</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1000_93390_571011"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A specification for connecting users on an Ethernet network to the Internet through a broadband connection, such as a single DSL line, wireless device, or cable modem. Using PPPoE and a broadband modem, LAN users can gain individual authenticated access to high-speed data networks. By combining Ethernet and Point-to-Point Protocol (PPP), PPPoE provides an efficient way to create a separate connection for each user to a remote server.</descrip></descripGrp><ntig><termGrp><term id="93390">Point-to-Point Protocol over Ethernet</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="571011">PPPoE-samskiptareglur</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1000_93390_571012"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A specification for connecting users on an Ethernet network to the Internet through a broadband connection, such as a single DSL line, wireless device, or cable modem. Using PPPoE and a broadband modem, LAN users can gain individual authenticated access to high-speed data networks. By combining Ethernet and Point-to-Point Protocol (PPP), PPPoE provides an efficient way to create a separate connection for each user to a remote server.</descrip></descripGrp><ntig><termGrp><term id="93390">Point-to-Point Protocol over Ethernet</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="571012">PPPoE</term><termNote type="geographicalUsage">ISL</termNote><termNote