type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27288_1368085_1419316"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The service that is provided by a credit card processor that validates that the billing address provided by a card holder matches the information on file with the issuing bank.</descrip></descripGrp><ntig><termGrp><term id="1368085">address verification service</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1419316">sannprófun aðseturs</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27288_1368085_1419326"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The service that is provided by a credit card processor that validates that the billing address provided by a card holder matches the information on file with the issuing bank.</descrip></descripGrp><ntig><termGrp><term id="1368085">address verification service</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1419326">sannprófun aðseturs (AVS)</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27289_1368086_1419317"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The number of days in a time period used to report an overdue customer payment balance.</descrip></descripGrp><ntig><termGrp><term id="1368086">aging period</term><te