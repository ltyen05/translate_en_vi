artOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13772_52156_570727"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to a type of access to data in a database that is shared over a network. When you open a database in exclusive mode, you prevent others from opening the database.</descrip></descripGrp><ntig><termGrp><term id="52156">exclusive</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="570727">einka-</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13776_5615_570369"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A supplemental program that can extend the capabilities of an application program.</descrip></descripGrp><ntig><termGrp><term id="5615">add-in</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="570369">innbót</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1378_232556_1108812"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The designation of a quantity of inventory on a purchase order for a specific sales order or production schedule.</descrip></descripGrp><ntig><termGrp><term id="232556">reservation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1108812">frátekning</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13787_397179_1954977"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of recipients that are created to expedite the mass emailing of messages and other information. Unlike a mail-enabled universal distribution group, a mail-enabled USG can also be used to assign permissions. When email is sent to a mail-enabled USG, all members of that group receive a copy of the message.</descrip></descripGrp><ntig><termGrp><term id="397179">mail-enabled universal security group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1954977">almennur póstöryggishópur</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13788_213533_1961855"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To tap twice quickly on a screen or touchpad.</descrip></descripGrp><ntig><termGrp><term id="213533">double-tap</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1961855">pikka tvisvar</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1379_120227_571133"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The suite of networking protocols arranged in four layers, which are called the link layer, internet layer, transport layer, and application layer, and that includes IP in the internet layer and TCP in the transport layer.</descrip></descripGrp><ntig><termGrp><term id="120227">TCP/IP</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="571133">TCP/IP</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1379_120228_571133"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The suite of networking protocols arranged in four layers, which are called the link layer, internet layer, transport layer, and application layer, and that includes IP in the internet layer and TCP in the transport layer.</descrip></descripGrp><ntig><termGrp><term id="120228">Transmission Control Protocol/Internet Protocol</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="571133">TCP/IP</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13805_135723_571223"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To adjust the perspective of an image or document in order to view a larger area on the screen at one time, as if viewed from farther away.</descrip></descripGrp><ntig><termGrp><term id="135723">zoom out</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="571223">minnka aðdrátt</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13809_88455_570971"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The menu choice that allows a user to customize application behavior.</descrip></descripGrp><ntig><termGrp><term id="88455">Options</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="570971">valkostir</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1382_228748_1108813"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The increase in the value of an asset calculated as the difference in the value of the asset when two economic events occur and when the difference is recognized on the occurrence of the second event as an increase in wealth.</descrip></descripGrp><ntig><termGrp><term id="228748">realized gain</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1108813">innleystur hagnaður</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13821_137076_1170865"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The sheet that you're working on in a workbook. The name on the tab of the active sheet is bold.</descrip></descripGrp><ntig><termGrp><term id="137076">active sheet</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1170865">virkt blað</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13829_237385_571677"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A customizable toolbar that provides one-click access to commands.</descrip></descripGrp><ntig><termGrp><term id="237385">Quick Access Toolbar</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="571677">flýtistika</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13835_141250_571287"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A control on a menu, toolbar, dialog box, or data access page that displays a list of options when you click the small arrow next to the list box.</descrip></descripGrp><ntig><termGrp><term id="141250">drop-down list box</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="571