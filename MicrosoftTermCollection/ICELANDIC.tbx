r">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2858379">tengill til að deila</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50475_2857362_2858346"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The shared sense of belonging that builds cohesion within a defined team, helping teammates to work as one.</descrip></descripGrp><ntig><termGrp><term id="2857362">collective identity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2858346">sameiginlegt auðkenni</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50476_2857364_2858380"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ability to take into account not just yourself and your teammates, but also the context that surrounds you.</descrip></descripGrp><ntig><termGrp><term id="2857364">situational awareness</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2858380">næmi á aðstæður</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50477_2857366_2858345"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ability to sense the emotions of others and recognize the impact that one’s actions may have on others.</descrip></descripGrp><ntig><termGrp><term id="2857366">co-awareness</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2858345">með-vitund</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50478_2857368_2858348"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The productive force that emerges when a team harnesses their differences, as a result of nurturing and balancing the other key team dynamics: team purpose, collective identity, awareness, inclusion, trust and vulnerability.</descrip></descripGrp><ntig><termGrp><term id="2857368">constructive tension</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2858348">uppbyggjandi spenna</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50479_2857369_2858342"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The joint understanding of self and others that enables teams to navigate interpersonal dynamics and foster team cohesion.</descrip></descripGrp><ntig><termGrp><term id="2857369">awareness and inclusion</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2858342">vitund og meðtalning</term><termNote type="geographicalU