umber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1170945">XML-eining</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19295_652267_1822724"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A switch (\#) or instruction that specifies how Microsoft Word will display the numeric result of a field.</descrip></descripGrp><ntig><termGrp><term id="652267">numeric picture switch</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1822724">tölusniðrofi</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19296_652268_1822725"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A switch (\*) or instruction that specifies the capitalization, numeral style, and character formatting that Microsoft Word uses in a field result.</descrip></descripGrp><ntig><termGrp><term id="652268">format switch</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1822725">sniðrofi</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1930_46651_570680"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A device used to store information.</descrip></descripGrp><ntig><termGrp><term id="46651">disk</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="570680">diskur</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19300_652272_1170946"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to information that shows what has actually occurred. For example, the actual start date for a task is the day that the task actually started.</descrip></descripGrp><ntig><termGrp><term id="652272">actual</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1170946">raun-</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19300_652272_1170947"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to information that shows what has actually occurred. For example, the actual start date for a task is the day that the task actually started.</descrip></descripGrp><ntig><termGrp><term id="652272">actual</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1170947">raunverulegt</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19301_652273_1485243"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The percentage of a resource's capacity that is designated for a specific assignment.</descrip></descripGrp><ntig><termGrp><term id="652273">allocation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1485243">úthlutun</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19302_652274_1792689"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An allowed path from one state to another.</descrip></descripGrp><ntig><termGrp><term id="652274">transition</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1792689">umbreyting</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19311_652285_1764388"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Having a digital signature.</descrip></descripGrp><ntig><termGrp><term id="652285">digitally signed</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1764388">með stafrænni undirskrift</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="g