ical Excel function that returns covariance, the average of the products of paired deviations.</descrip></descripGrp><ntig><termGrp><term id="2955554">COVAR</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2966625">COVAR</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52343_2955555_2966626"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Statistical Excel function that returns covariance, the average of the products of paired deviations.</descrip></descripGrp><ntig><termGrp><term id="2955555">COVARIANCE.P</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2966626">COVARIANCE.P</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52344_2955556_2966627"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Statistical Excel function that returns the sample covariance, the average of the products deviations for each data point pair in two data sets.</descrip></descripGrp><ntig><termGrp><term id="2955556">COVARIANCE.S</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2966627">COVARIANCE.S</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</ter