installed. In impairment accounting, the impairment cost is distributed when the construction of an asset is complete.</descrip></descripGrp><ntig><termGrp><term id="2223107">under-construction</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2251757">í byggingu</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38389_2223111_2251745"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A benefit on taxable income to reduce the tax that an employee is liable to pay on gross wages.</descrip></descripGrp><ntig><termGrp><term id="2223111">pre-tax deduction</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2251745">frádráttur fyrir skatt</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38391_2223116_2251751"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The depreciation ratio that is used in the calculation of special depreciation for assets.</descrip></descripGrp><ntig><termGrp><term id="2223116">special depreciation ratio</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2251751">sérstakt afskriftarhlutfall</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote ty