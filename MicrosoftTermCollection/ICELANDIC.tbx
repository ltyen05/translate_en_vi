U</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2902888">stjórnunareining</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51593_2902151_2902893"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An isolated group within an organizational structure that has little to no interaction with other groups, often leading to a lack of collaboration and other negative outcomes.</descrip></descripGrp><ntig><termGrp><term id="2902151">silo</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2902893">byrgi</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51606_2902290_2902903"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The phone feature that allows the user to view, send, receive, and download SMS and MMS text messages.</descrip></descripGrp><ntig><termGrp><term id="2902290">Messages</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2902903">Skilaboð</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51608_2902292_2902902"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The phone feature that allows the user to make and receive calls.</descrip></descripGrp><ntig><termGrp><term id="2902292">Calls</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2902902">Símtöl</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51609_2902293_2902904"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The phone feature that allows the user to control notification settings.</descrip></descripGrp><ntig><termGrp><term id="2902293">Notifications</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2902904">Tilkynningar</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51610_2902294_2902901"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that allows users to access the apps installed on their phone or other mobile device.</descrip></descripGrp><ntig><termGrp><term id="2902294">Apps</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2902901">Forrit</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Plura