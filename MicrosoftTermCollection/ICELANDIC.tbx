><termEntry id="32854_1707246_1823164"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that synchronizes SAP roles and SharePoint user profiles, which enables administrators to secure SharePoint objects such as sites, lists and items using SAP roles.</descrip></descripGrp><ntig><termGrp><term id="1707246">Role Sync</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1823164">Hlutverkasamstilling</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32861_1707459_1823165"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process that populates data to the Office Telemetry Log.</descrip></descripGrp><ntig><termGrp><term id="1707459">Office telemetry logging</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1823165">Office-fjarmælingaskráning</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32862_1707461_1823166"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A stylistic variation on a font that provides an alternative to its default appearance.</descrip></descripGrp><ntig><termGrp><term id="1707461">stylistic set</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1823166">stíluppsetning</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32867_1707634_1723907"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The operating system designed for enthusiasts and business/technical pros that includes all of the features in Windows 8, plus features for encryption, virtualization, PC management, and domain connectivity.</descrip></descripGrp><ntig><termGrp><term id="1707634">Windows 8 Pro</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1723907">Windows 8 Pro</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32868_1707637_1723368"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The operating system for PCs and tablets powered by x86 (32-bit) and AMD (64-bit) processors that includes an updated Windows Explorer, Task Manager, better multi-monitor support, and fast language switching.</descrip></descripGrp><ntig><termGrp><term id="1707637">Windows 8</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1723368">Windows 8</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32869_1707640_1723938"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The operating system only available pre-installed on PCs and tablets powered by ARM processors that helps enable new thin and lightweight form factors with impressive battery life. Windows RT includes touch-optimized versions of Microsoft Word, Excel, PowerPoint, and OneNote.</descrip></descripGrp><ntig><termGrp><term id="1707640">Windows RT</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1723938">Windows RT</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32870_1707648_1723918"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A downloadable pack that adds features to Windows 8 or Windows 8 Single Language editions to move them to a Windows 8 Pro edition with Windows Media Center installed.</descrip></descripGrp><ntig><termGrp><term id="1707648">Windows 8 Pro Pack</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1723918">Windows 8 Pro Pack</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32871_1707658_1723901"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An edition of Windows 8 that is available only through volume licensing.</descrip></descripGrp><ntig><termGrp><term id="1707658">Windows 8 Enterprise</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1723901">Windows 8 Enterprise</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32872_1707665_1723936"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An edition of Windows 8 designed to make Windows affordable to mainstream consumers in emerging markets.</descrip></descripGrp><ntig><termGrp><term id="1707665">Windows 8 Single Language</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1723936">Windows 8 Single Language</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32873_1708234_1723896"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A media pack add-on to Windows 8 Pro that upgrades the edition to include Windows Media Center.</descrip></descripGrp><ntig><termGrp><term id="1708234">Windows 8 Media Center Pack</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1723896">Windows 8 Media Center Pack</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32878_1709112_1760546"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The button or slider on tablets and convertible tablets that rotates the display.</descrip></descripGrp><ntig><termGrp><term id="1709112">rotation lock button</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1760546">hnappur fyrir snúningslás</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32879_1709128_1823168"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Exchange mailbox that is associated with a SharePoint site, enabling users to access documents and email related to group projects through either Outlook or SharePoint.</descrip></descripGrp><ntig><termGrp><term id="1709128">site mailbox</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1823168">pósthólf vefsvæðis</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32884_1710098_1723926"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An edition of Windows 8 Pro that contains Windows Media Center.</descrip></descripGrp><ntig><termGrp><term id="1710098">Windows 8 Pro with Media Center</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1723926">Windows 8 Pro með Media Center</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32886_1713361_1823169"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Authenticated access that can be granted to external partners and clients to enable sharing of selected SharePoint Online content.</descrip></descripGrp><ntig><termGrp><term id="1713361">external access</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1823169">ytri aðgangur</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32887_1713362_1823170"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A unique link that provides external users anonymous access to selected documents stored in SharePoint Online, with no sign in required.</descrip></descripGrp><ntig><termGrp><term id="1713362">guest link</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1823170">gestatengill</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32888_1713387_2293863"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables rich visualizations for interactive data exploration, presentation and reporting in SharePoint and Excel.</descrip></descripGrp><ntig><termGrp><term id="1713387">Power View</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2293863">Power View</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32893_1713523_1723931"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The release candidate release of the Windows 8 operating system.</descrip></descripGrp><ntig><termGrp><term id="1713523">Windows 8 Release Preview</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1723931">Windows 8 Release Preview</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32895_1713527_1748481"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An automated proactive scan that triggers when NTFS detects a corruption. The scan is equivalent to the scan phase of chkdsk and finds and logs all corruptions to an internal file. This scan runs during maintenance hours, can be triggered from the Explorer, or manually run from a command line. When this scan is running in the background, some NTFS operations may be blocked.</descrip></descripGrp><ntig><termGrp><term id="1713527">Proactive Scanner</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1748481">forvirk skönnun</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32896_1713528_1748508"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A registry setting that allows the DHCP client to transmit more messages to the server to obtain an IP address when the PC is in connected standby mode. This setting can increase power consumption but can also help resolve IP address (IPv4 or IPv6) problems more quickly.</descrip></descripGrp><ntig><termGrp><term id="1713528">aggressive address acquisition retry</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1748508">ágeng öflun vistfangs</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32897_1713529_1748498"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A service within Remote Desktop Services responsible for aggregating RemoteApp programs and desktops that are published to end users from across the entire deployment. It ensure only users with appropriate rights can access published resources. The resources are used to display error messages that, for example, might say that the publishing service is unavailable. This can help the admin debug their deployment.</descrip></descripGrp><ntig><termGrp><term id="1713529">Central Publishing service</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1748498">þjónusta fyrir miðlæga birtingu</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32899_1713532_1748447"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The capability to sign in to a PC by using a four-digit code.</descrip></descripGrp><ntig><termGrp><term id="1713532">PIN sign-in</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1748447">innskráning með PIN-númeri</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3290_142330_1170740"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A color that that is currently selected for drawing or displaying text on the screen.</descrip></descripGrp><ntig><termGrp><term id="142330">foreground color</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1170740">forgrunnslitur</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32900_1713533_1748450"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A software setting that disables display rotation.</descrip></descripGrp><ntig><termGrp><term id="1713533">rotation lock</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1748450">snúningslás</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32907_1718118_1823172"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Collectively, the SharePoint service applications that write to ULS logs using shared code for automated document processing.</descrip></descripGrp><ntig><termGrp><term id="1718118">Office Automation Services</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1823172">Office Automation Services</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32908_1718119_1823178"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An instrumentation and logging platform that provides monitoring, reporting and log viewing capabilities for Office servers and services.</descrip></descripGrp><ntig><termGrp><term id="1718119">ULS</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1823178">Samræmd skráningarþjónusta</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32908_1722438_1823178"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An instrumentation and logging platform that provides monitoring, reporting and log viewing capabilities for Office servers and services.</descrip></descripGrp><ntig><termGrp><term id="1722438">Unified Logging Service</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1823178">Samræmd skráningarþjónusta</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32909_1718122_1823173"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application-hosting architecture that relies on cloud-based services. Application logic and data are typically hosted on a distributed set of services on the Internet, connected through web APIs, and authenticated with server-to-server authentication technologies such as OAuth.</descrip></descripGrp><ntig><termGrp><term id="1718122">Cloud App Model</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1823173">skýjaforritaskipan</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32925_1718267_1823175"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A menu item that lets the user open a document using a different application than the one associated with the document type.</descrip></descripGrp><ntig><termGrp><term id="1718267">Open with</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1823175">Opna með</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3293_83637_570935"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">On a Web page, a grouping of hyperlinks for getting around in that particular Web site.</descrip></descripGrp><ntig><termGrp><term id="83637">navigation bar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="570935">yfirlitsstika</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32930_1719344_2321085"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Data that shows how products are used including where, how often, with which other software and hardware. This data is used to identify user needs and experiences as well as potential marketing and product improvement opportunities over time. Partners and Microsoft can better understand what happens between planning, lab testing, sales data, and real world scenarios over time.</descrip></descripGrp><ntig><termGrp><term id="1719344">telemetry</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2321085">fjarmælingar</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp