ermEntry><termEntry id="37017_2844863_2851123"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Microsoft 365 Apps for business (formerly Office 365 Business) is a small business-level subscription offering that includes Office applications (e.g., Outlook, Word, Excel, PowerPoint, Access (PC only), Publisher (PC only) and cloud file storage and sharing (OneDrive).</descrip></descripGrp><ntig><termGrp><term id="2844863">Microsoft 365 Apps for business</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2851123">Microsoft 365-forrit fyrir fyrirtæki</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3702_86681_1587517"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method of translating images of printed text into machine-encoded text.</descrip></descripGrp><ntig><termGrp><term id="86681">OCR</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1587517">OCR-lína</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3702_86681_570954"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method of translating images of printed text into machine-encoded text.</descrip></descripGrp><ntig><termGrp><term id="86681">OCR</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lan