28169">3D Selfie</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2328664">þrívíddarsjálfsmynd</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40033_2328170_2328667"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A 3D printing format that allows design applications to send 3D models to other applications, platforms, services, and printers.​</descrip></descripGrp><ntig><termGrp><term id="2328170">3MF</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2328667">3MF</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40034_2328171_2328670"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The rectangular boundaries of the object to be scanned.​​</descrip></descripGrp><ntig><termGrp><term id="2328171">boundary cube</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2328670">jaðarkubbur</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40035_2328172_2328680"><langSet xml:lang="en-US"><descripGrp><descrip type="defini