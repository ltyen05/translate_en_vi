box or uses Xbox Live.</descrip></descripGrp><ntig><termGrp><term id="2531623">Xbox analytics</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2919019">Xbox-greining</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44982_2531624_2539664"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app that allows users to change their Xbox avatars, start fresh with brand new ones, or take pictures of their avatars to share with friends. Users can also export avatars as 3D models for 3D printing or for use in Paint 3D.</descrip></descripGrp><ntig><termGrp><term id="2531624">Xbox Avatars</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2539664">Spilaramyndir</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44982_2531624_2539665"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app that allows users to change their Xbox avatars, start fresh with brand new ones, or take pictures of their avatars to share with friends. Users can also export avatars as 3D models for 3D printing or for use in Paint 3D.</descrip></descripGrp><ntig><termGrp><term id="2531624">Xbox Avatars</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><