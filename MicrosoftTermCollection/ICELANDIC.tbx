nuous flow. The digital media is played by client software as it is received.</descrip></descripGrp><ntig><termGrp><term id="151854">streaming</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2228747">straumspilun efnis</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4353_2227182_2228747"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method of delivering digital media across a network in a continuous flow. The digital media is played by client software as it is received.</descrip></descripGrp><ntig><termGrp><term id="2227182">media streaming</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2228747">straumspilun efnis</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43582_2464277_2926799"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app destination for solutions that extend the capabilities of the technology you already own.</descrip></descripGrp><ntig><termGrp><term id="2464277">Microsoft AppSource</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2926799">Microsoft AppSource</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43582_2464281_2926799"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app destination for solutions that extend the capabilities of the technology you already own.</descrip></descripGrp><ntig><termGrp><term id="2464281">AppSource</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2926799">Microsoft AppSource</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43593_2464340_2466310"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The offer for Office 365 that is for the European market.</descrip></descripGrp><ntig><termGrp><term id="2464340">Microsoft Office 365 Germany</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2466310">Microsoft Office 365 Germany</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43597_2464345_2776121"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A data structure that is used to create a digital transaction ledger that, instead of resting with a single provider, is shared among a distributed network of computers. The result is a more open, transparent, and publicly verifiable system for digital transactions.</descrip></descripGrp><ntig><termGrp><term id="2464345">blockchain</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2776121">bitakeðja</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43608_2464387_2465703"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A UI screen that appears in the Network flyout when a paid Wi-Fi hotspot is in range and paid Wi-Fi plans are available from Windows Store. A customer can then tap Connect with a data plan to open the Paid Wi-Fi &amp; Cellular app, choose a paid Wi-Fi data plan that’s offered from Windows Store, and then buy a plan using the payment information that’s stored in their Microsoft account.</descrip></descripGrp><ntig><termGrp><term id="2464387">Connect with a data plan</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2465703">tengjast með gagnaáskrift</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4362_153205_571369"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A high-speed Internet connection. Broadband connections are typically 256 kilobytes per second (KBps) or faster.</descrip></descripGrp><ntig><termGrp><term id="153205">broadband connection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="571369">breiðbandstenging</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43627_2465102_2469196"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Any very simple computer program that outputs or displays the words "Hello World" in some form to the user. Such a program is often created as an example, to introduce the basic syntax of a programming language to students or others new to that language.</descrip></descripGrp><ntig><termGrp><term id="2465102">Hello World</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2469196">Halló, heimur</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43628_2781062_2785081"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The offer for OneDrive for Business that includes Office Online and that is available through the User purchase subscription program.</descrip></descripGrp><ntig><termGrp><term id="2781062">OneDrive for Business with Office on the web (user purchased)</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2785081">OneDrive for Business með Office á vefnum (keypt af notanda)</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43630_2816015_2834806"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The offer for the Office suite, email, instant messaging, HD video conferencing, 1 TB personal file storage and sharing, advanced security, analytics and PSTN conferencing targeted at government organizations. It includes all the features of Office 365 Government Community G3 plus unified communications with Skype for Business Server, advanced eDiscovery with predictive coding and text analytics, Exchange Online Advanced Threat Protection, personal and organizational analytics, Audio Conferencing, and other services.</descrip></descripGrp><ntig><termGrp><term id="2816015">Office 365 Government G5</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2834806">Office 365 Government G5</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43662_2465860_2517455"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A web application on Xbox.com that allows Xbox One or PC gamers to design and purchase their own Xbox Wireless controller.</descrip></descripGrp><ntig><termGrp><term id="2465860">Xbox Design Lab</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2517455">Xbox Design Lab</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4367_103601_1170757"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A measure of the fineness of detail in an image or text, usually as produced by a monitor or printer.</descrip></descripGrp><ntig><termGrp><term id="103601">resolution</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1170757">upplausn</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4368_228376_1108934"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A form that Australian businesses file to report and pay taxes.</descrip></descripGrp><ntig><termGrp><term id="228376">business activity statement</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1108934">BAS</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4368_228376_1108935"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A form that Australian businesses file to report and pay taxes.</descrip></descripGrp><ntig><termGrp><term id="228376">business activity statement</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1108935">viðskiptaskýrsla</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</