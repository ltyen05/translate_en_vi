08"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A package that does not contain AL code, but only the final artifacts used by the server at runtime. Runtime packages allow developers to protect the intellectual property represented by their AL source code.</descrip></descripGrp><ntig><termGrp><term id="2953545">runtime package</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2953608">keyrslupakki</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52216_2953546_2953609"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process that allows a delegated admin to record AL code that runs on the server, and once it has run, debug the recorded snapshot in Visual Studio Code.</descrip></descripGrp><ntig><termGrp><term id="2953546">snapshot debugging</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2953609">kembing skyndimyndar</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52217_2953547_2953604"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Business Central online feature that users can enable to gather additional log information on the operation that is causing problem. Microsoft Support gets more details about the problematic operation, leading to a quicker resolution.</descrip></descripGrp><ntig><termGrp><term id="2953547">additional l