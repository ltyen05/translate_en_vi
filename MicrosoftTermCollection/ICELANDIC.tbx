icalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45157_2550041_2553552"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The filter that users can apply to a photo or video clip, which gives it a feeling of energy, and the purple light you might see before an electrical storm. This is also the name of a theme that applies this filter along with a related text style and music.</descrip></descripGrp><ntig><termGrp><term id="2550041">Electric</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2553552">Rafmagnað</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45158_2550043_2553571"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The filter that users can apply to a photo or video clip, which gives it a golden brownish hue like sand.</descrip></descripGrp><ntig><termGrp><term id="2550043">Sandy</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2553571">Sandgult</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45159_2550044_2553561"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The filter that users can apply to a photo or video clip, which gives it a cheerful, playful, sunny feeling. This is also the name of a theme that applies this filter along with a related text style and music.</descrip></descripGrp><ntig><termGrp><term id="2550044">Joy</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2553561">Gleði</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45160_2550045_2553144"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The filter that users can apply to a photo or video clip, which gives it a yellow tone.</descrip></descripGrp><ntig><termGrp><term id="2550045">Citrus</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2553144">Sítrus</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45161_2550046_2553565"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The filter that users can apply to a photo or video clip, which has a coarse texture and hard edges like metal.</descrip></descripGrp><ntig><termGrp><term id="2550046">Metallic</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2553565">Málmkennt</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</term