grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2188039">safn í skýinu</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33569_1802886_2188060"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The amount of data the user can download/upload through the carrier's network each month without being billed additional charges.</descrip></descripGrp><ntig><termGrp><term id="1802886">data limit</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2188060">innifalið gagnamagn</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33570_2164314_2178852"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The pre-loaded app that allows users to better monitor and manage their data usage on their phone or PC. It can notify users when they are close to their cellular data limit and delay some data-intensive tasks until the phone or PC is connected to Wi-Fi.</descrip></descripGrp><ntig><termGrp><term id="2164314">Data usage</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2178852">Gagnanotkun</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33571_1802888_2188090"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The button label to note that the user does not like a suggestion in Local Scout.</descrip></descripGrp><ntig><termGrp><term id="1802888">dislike</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2188090">líkar ekki</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33576_1803504_2188155"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The default room name in the Rooms feature of the People Hub. Based on the concept of the "family room" in many homes, in which family and guests gather for group activities.</descrip></descripGrp><ntig><termGrp><term id="1803504">Family Room</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2188155">Fjölskyldusvæði</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33577_1803505_2188837"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A place on the phone where families (or other close-knit groups) can stay in touch. Rooms take the form of a panorama that lives in the People Hub. The panorama includes a family chat card, a shared calendar, a shared photo album, and a shared notebook. Users ask others to join their Room via an SMS invite.</descrip></descripGrp><ntig><termGrp><term id="1803505">room</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2188837">svæði</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33578_1803510_2188157"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An NFC-enabled card (like a credit card) that users can use for payments or other transactions even when the phone is locked.</descrip></descripGrp><ntig><termGrp><term id="1803510">fast card</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2188157">hraðkort</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33579_1803511_2188192"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A flash mode used to set off the flash automatically according to the ambient light conditions.</descrip></descripGrp><ntig><termGrp><term id="1803511">flash auto</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2188192">sjálfvirkt flass</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33580_1803512_2188199"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A flash mode when the phone's built-in camera flash is set to off.</descrip></descripGrp><ntig><termGrp><term id="1803512">flash off</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2188199">slökkt á flassi</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33581_1803513_2188202"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A flash mode when the phone's built-in camera flash is set to on.</descrip></descripGrp><ntig><termGrp><term id="1803513">flash on</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2188202">kveikt á flassi</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33582_1803514_2188218"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A camera on the front of an electronic device (such as a smartphone), which faces the user. This allows the user to video chat with another person also using a front-facing device. It may also be used to take videos and pictures.</descrip></descripGrp><ntig><termGrp><term id="1803514">front</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2188218">myndavél að framan</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33583_1803517_2066105"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Skype To Go number that is used like a calling card, that allows a user to enter a number manually and dial any phone number.</descrip></descripGrp><ntig><termGrp><term id="1803517">Access number</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2066105">aðgangsnúmer</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33584_1803518_2188239"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A text message thread between a group of people (usually more than 2). It allows you to keep all the replies from people in one thread, so that you can see the whole conversation.</descrip></descripGrp><ntig><termGrp><term id="1803518">group text</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2188239">hópskilaboð</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33585_1803519_1992313"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app that provides easy access to Help and how-to content as well as helpful tips for users.</descrip></descripGrp><ntig><termGrp><term id="1803519">Help+Tips</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1992313">Hjálp og ábendingar</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33586_1803521_2066176"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A product that enables a user to call mobile phones and landlines from a mobile phone or landline via Skype.</descrip></descripGrp><ntig><termGrp><term id="1803521">Skype To Go number</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2066176">Skype To Go-númer</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33587_1803522_2188298"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An APN (Access Point Name) that determines the cellular data networks to which a phone can connect. It includes information about what kind of connection, security, and type of IP address the phone should use for the Internet connection.</descrip></descripGrp><ntig><termGrp><term id="1803522">Internet APN</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2188298">Netaðgangsstaður</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33588_1803523_2188385"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The APN (Access Point Name) a phone can use to send MMS messages (text messages with multimedia files attached).</descrip></descripGrp><ntig><termGrp><term id="1803523">MMS APN</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2188385">MMS-aðgangsstaður</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33589_1803524_2188340"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The company or organization that issued the user the card they're adding to their wallet. For example, an issuer could be a bank.</descrip></descripGrp><ntig><termGrp><term id="1803524">issuer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2188340">útgefandi</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33591_1803526_2188342"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The title of the screen prompting the user to sign in to his existing Microsoft account or to create a Microsoft account. By using the Microsoft account, Windows Phone will keep the user's important information and belongings synchronized in one place, helping keep the user's life organized and harmonious.</descrip></descripGrp><ntig><termGrp><term id="1803526">Keep your life in sync</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2188342">Allt á einum stað</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33593_1803746_2188346"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app that helps parents provide their children with controlled access to their phones. In Kid's Corner, kids can only use the apps, games, and other content that parents select.</descrip></descripGrp><ntig><termGrp><term id="1803746">Kid's Corner</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2188346">Barnahornið</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33594_1803747_2188347"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">List of the top players in a game or other competition on Xbox Live.</descrip></descripGrp><ntig><termGrp><term id="1803747">leaderboard</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2188347">stigatafla</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33594_3144583_2188347"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">List of the top players in a game or other competition on Xbox Live.</descrip></descripGrp><ntig><termGrp><term id="3144583">Xbox leaderboard</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2188347">stigatafla</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33595_1803748_2188348"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A first or third-party application that works with the Windows Phone camera to offer additional features and functionality for users taking and editing pictures.</descrip></descripGrp><ntig><termGrp><term id="1803748">lens</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2188348">linsa</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33596_1803750_2188374"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A relationship of being a member of an organization, such as a gym or club.</descrip></descripGrp><ntig><termGrp><term id="1803750">membership</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2188374">aðild</term><termNote type="geographicalUsage">ISL</termNote><ter