termNote></termGrp></ntig></langSet></termEntry><termEntry id="18583_650937_1822693"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A phone number format for dialing any call from any location or with a calling card.</descrip></descripGrp><ntig><termGrp><term id="650937">international format</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1822693">alþjóðlegt snið</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18585_650939_1170935"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A line that connects fields between two tables and shows how the data is related. The type of join indicates which records are selected for the query's result set.</descrip></descripGrp><ntig><termGrp><term id="650939">join line</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1170935">tengilína</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18587_650941_1170936"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The special characters used to extend the joiner between two Arabic characters. Used to improve the appearance of justified text by visually lengthening words rather than increasing the spacing between words. Can also function like a hyphen.</descrip></descripGrp><ntig><termGrp><term id="650941">kashidas</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1170936">kashidas</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18590_650944_1485227"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Resolving resource conflicts or overallocations by delaying or splitting certain tasks. When Project levels a resource, its selected assignments are distributed and rescheduled.</descrip></descripGrp><ntig><termGrp><term id="650944">leveling</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1485227">útjöfnun</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18594_650948_1170937"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of cascading style sheet that exists in a separate file and is referenced throughout one or more Web pages.</descrip></descripGrp><ntig><termGrp><term id="650948">linked style sheet</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1170937">tengt stílblað</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18598_650952_1822694"><langSet xml:lang="e