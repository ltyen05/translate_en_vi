n point</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1645593">CDP</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="30512_1516655_1649823"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A certificate extension that indicates where the certificate revocation list for a CA can be retrieved. It can contain none, one, or many HTTP, file, or LDAP URLs.</descrip></descripGrp><ntig><termGrp><term id="1516655">certificate revocation list distribution point</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1649823">dreifingarstaður fyrir lista yfir afturkölluð vottorð</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="30512_1516656_1645593"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A certificate extension that indicates where the certificate revocation list for a CA can be retrieved. It can contain none, one, or many HTTP, file, or LDAP URLs.</descrip></descripGrp><ntig><termGrp><term id="1516656">CDP</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1645593">CDP</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="30512_1516656_1649823"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A certificate extension that indicates where the certificate revocation list for a CA can be retrieved. It can contain none, one, or many HTTP, file, or LDAP URLs.</descrip></descripGrp><ntig><termGrp><term id="1516656">CDP</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1649823">dreifingarstaður fyrir lista yfir afturkölluð vottorð</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="30513_1516657_1649885"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In a public key infrastructure hierarchy, the certification authority that that issues certificates to users and computers.</descrip></descripGrp><ntig><termGrp><term id="1516657">issuing certification authority</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1649885">vottunaraðili sem gefur út</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="30513_1516658_1649885"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In a public key infrastructure hierarchy, the certification authority that that issues certificates to users and computers.</descrip></descripGrp><ntig><termGrp><term id="1516658">issuing CA</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1649885">vottunaraðili sem gefur út</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="30517_1516667_1649816"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A configuration mode for the Certificate Enrollment Web Service in which it will only process renewal requests.</descrip></descripGrp><ntig><termGrp><term id="1516667">renewal only mode</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1649816">endurnýjunarstilling</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="30520_1516672_1649631"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A hexadecimal string that contains the SHA-1 hash of the certificate.</descrip></descripGrp><ntig><termGrp><term id="1516672">thumbprint</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1649631">fingrafar</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3053_253746_2806261"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A client that waits for and accepts relayed connections.</descrip></descripGrp><ntig><termGrp><term id="253746">listener</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2806261">hlustandi</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="30553_1517506_1696093"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Server Manager and Event Viewer, the urgency of an event or error condition, system fault, failure, or action by either the system or the user. Severity can be any of four industry-standard values: Information, Warning, Error, or Critical. These values are defined in the Event Viewer Help.</descrip></descripGrp><ntig><termGrp><term id="1517506">severity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1696093">alvarleiki</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3056_1738272_570324"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A computer that acts as a source of information or signals. The host computer provides services, such as news, mail, or data, to computers that connect to it. The term can refer to almost any kind of computer, from a centralized mainframe that is a host to its terminals, to a server that is host to its clients, to a desktop PC that is host to its devices, such as printers and scanners.</descrip></descripGrp><ntig><termGrp><term id="1738272">host computer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="570324">hýsill</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3056_1770_570324"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A computer that acts as a source of information or signals. The host computer provides services, such as news, mail, or data, to computers that connect to it. The term can refer to almost any kind of computer, from a centralized mainframe that is a host to its terminals, to a server that is host to its clients, to a desktop PC that is host to its devices, such as printers and scanners.</descrip></descripGrp><ntig><termGrp><term id="1770">host</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="570324">hýsill</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3058_71776_570840"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A pointing device used mainly but not exclusively for computer games. A joystick has a base, on which control buttons can be mounted, and a vertical stem, which the user can move in any direction to control the movement of an object on the screen.</descrip></descripGrp><ntig><termGrp><term id="71776">joystick</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="570840">stýripinni</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="30589_1517629_1649820"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process that builds one or more certificate paths. The certificate paths may or may not trace up to a self-signed or root certificate.</descrip></descripGrp><ntig><termGrp><term id="1517629">certificate chaining</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1649820">keðjutenging vottorða</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="30590_1517630_1645574"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A certificate extension used by the certificate chaining engine to determine what certificate was used to sign a presented certificate. The AKI can contain the issuer name, serial number, public key information, or no information at all. By matching the information in a certificate’s AKI extension to a CA certificate’s Subject Key Identifier (SKI) extension, a certificate chain can be built.</descrip></descripGrp><ntig><termGrp><term id="1517630">Authority Key Identifier</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1645574">AKI</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="30590_1517630_1649127"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A certificate extension used by the certificate chaining engine to determine what certificate was used to sign a presented certificate. The AKI can contain the issuer name, serial number, public key information, or no information at all. By matching the information in a certificate’s AKI extension to a CA certificate’s Subject Key Identifier (SKI) extension, a certificate chain can be built.</descrip></descripGrp><ntig><termGrp><term id="1517630">Authority Key Identifier</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1649127">lykilauðkenni vottunaraðila</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="30590_1517631_1645574"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A certificate extension used by the certificate chaining engine to determine what certificate was used to sign a presented certificate. The AKI can contain the issuer name, serial number, public key information, or no information at all. By matching the information in a certificate’s AKI extension to a CA certificate’s Subject Key Identifier (SKI) extension, a certificate chain can be built.</descrip></descripGrp><ntig><termGrp><term id="1517631">AKI</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1645574">AKI</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="30590_1517631_1649127"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A certificate extension used by the certificate chaining engine to determine what certificate was used to sign a presented certificate. The AKI can contain the issuer name, serial number, public key information, or no information at all. By matching the information in a certificate’s AKI extension to a CA certificate’s Subject Key Identifier (SKI) extension, a certificate chain can be built.</descrip></descripGrp><ntig><termGrp><term id="1517631">AKI</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1649127">lykilauðkenni vottunaraðila</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="30592_1517953_1758741"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An order process where an item is assembled to satisfy a sales order just before the order is shipped to the customer.</descrip></descripGrp><ntig><termGrp><term id="1517953">assemble to order</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1758741">setja saman í pöntun</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="30593_1517955_1758742"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An order process where an item is assembled and then put away in the warehouse as a sellable item.</descrip></descripGrp><ntig><termGrp><term id="1517955">assemble to stock</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1758742">setja saman í birgðir</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="30594_1517961_1758784"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A content of a kit item that may consist of one or more components (that are raw materials, regular sellable items, or kit items), resources, and text comments.</descrip></descripGrp><ntig><termGrp><term id="1517961">assembly list</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1758784">samsetningarlisti</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="30596_1517981_1758805"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To commit to a particular payment amount, causing those funds to eventually be transferred from the issuing bank to the merchant's account in the acquiring bank.</descrip></descripGrp><ntig><termGrp><term id="1517981">capture</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1758805">fanga</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="30599_1517982_1758841"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A pick where the quantity handled is higher than the required quantity of the source document.</descrip></descripGrp><ntig><termGrp><term id="1517982">overpick</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1758841">umframtínsla</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3060_87569_1169795"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In reference to one or more computers, connected to a network.</descrip></descripGrp><ntig><termGrp><term id="87569">online</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1169795">á neti</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3060_87569_570962"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In reference to one or more computers, connected to a network.</descrip></descripGrp><ntig><termGrp><term id="87569">online</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="570962">tengdur</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="30600_1517983_1758842"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An entity that is responsible for deducting the money from the customer credit card account and moving the money to or from the merchant's account. The user of the payment service will have to sign up with one or more payment providers.</descrip></descripGrp><ntig><termGrp><term id="1517983">payment provider</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1758842">greiðsluþjónustuaðili</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="30604_1518363_1758808"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A timeframe that is used to avoid minor rescheduling of existing supply out in time. Changes from the supply date until one dampener period from the supply date will not generate any action messages.</descrip></descripGrp><ntig><termGrp><term id="1518363">dampener period</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1758808">hömlutímabil</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="30605_1518364_1758824"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of account in the general ledger for inventory transactions that await further processing, but whose interim value must be visible in the general ledger.</descrip></descripGrp><ntig><termGrp><term id="1518364">interim account</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1758824">bráðabirgðareikningur</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3061_147916_1822508"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mark that shows where a deletion, insertion, or other editing change has been made in a document.</descrip></descripGrp><ntig><termGrp><term id="147916">revision mark</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1822508">endurskoðunarmerki</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="30611_1518906_1758855"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A timeframe that defines the recurring planning horizon of the item and defines the frequency for checking if projected inventory reaches or goes below the reorder point.</descrip></descripGrp><ntig><termGrp><term id="1518906">time bucket</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1758855">tímarammi</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="30613_1518908_1758834"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A period of time that is used to accumulate multiple supply needs into one supply order. From the first planned supply, the system accumulates all supply needs in the following lot accumulation period into one supply, which is placed on the date of the first supply.</descrip></descripGrp><ntig><termGrp><term id="1518908">lot accumulation period</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1758834">lotusöfnunartímabil</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="30617_1519075_1758809"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Holds bin content that can only be picked for the dedicated resource, such as a machine center, that uses the bin in question</descrip></descripGrp><ntig><termGrp><term id="1519075">dedicated bin</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1758809">sérstakt hólf</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="30619_1519077_1758835"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An expense that is not registered or included in source types. You must create it manually. Manual expenses can include expenses such as salaries, interest on credit, or planned investments.</descrip></descripGrp><ntig><termGrp><term id="1519077">manual expense</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1758835">handskráður kostnaður</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="30620_1519078_1758836"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Revenue that is not registered or not included in source types. You must create it manually. Manual revenues can include revenue such as rental income, interest from financial assets, or new private capital.</descrip></descripGrp><ntig><termGrp><term id="1519078">manual revenue</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1758836">handskráðar tekjur</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="30621_1519079_1758850"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The physical operation that places the item in a stage bin.</descrip></descripGrp><ntig><termGrp><term id="1519079">stage pick</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1758850">biðtínsla</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="30622_1519080_1758837"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The bin at a dedicated area that contains items or components that are replenished manually. The items are included on component lists like a production BOM for obtaining an exact registration for cost and invoicing purposes, but they are not important or common enough to include on pick lines.</descrip></descripGrp><ntig><termGrp><term id="1519080">open shop floor bin</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1758837">hólfkóti opins vinnslusalar</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3065_142836_571295"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A program that transforms a picture stored in one file format to another format so that it can be displayed in a specific graphics program.</descrip></descripGrp><ntig><termGrp><term id="142836">graphic filter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="571295">myndefnissía</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3065_142837_571295"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A program that transforms a picture stored in one file format to another format so that it can be displayed in a specific graphics program.</descrip></descripGrp><ntig><termGrp><term id="142837">graphics filter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="571295">myndefnissía</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3068_79974_2741055"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A flag that marks a message for follow up or with a request for someone else.</descrip></descripGrp><ntig><termGrp><term id="79974">message flag</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2741055">flagg skeytis</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3069_44932_570655"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The location (drive, folder, or directory) to which a file is copied or moved.</descrip></descripGrp><ntig><termGrp><term id="44932">destination</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="570655">endastaður</term><termNote type="geographicalUsage">ISL</termNot