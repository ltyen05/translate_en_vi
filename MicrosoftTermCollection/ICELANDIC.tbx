US"><descripGrp><descrip type="definition">A feature that identifies people using computers near you so that you can use features and programs that use peer-to-peer technology.</descrip></descripGrp><ntig><termGrp><term id="262727">People Near Me</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="571758">Fólk í næsta nágrenni</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11912_320959_1109253"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An item assembled for sale using a bill of materials.</descrip></descripGrp><ntig><termGrp><term id="320959">finished good</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1109253">fullbúin vara</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11914_39698_570619"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Any device that changes electrical signals or computer data from one form to another. For example, an analog-to-digital converter translates analog signals to digital signals.</descrip></descripGrp><ntig><termGrp><term id="39698">converter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="570619">umbreytir</term><termNote type="geographicalUsage">ISL</termNote>