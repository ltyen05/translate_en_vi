98_2858264_2859682"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The number of hours the person spent in meetings with at least one other person.</descrip></descripGrp><ntig><termGrp><term id="2858264">meeting hours</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2859682">fundastundir</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50499_2858268_2859676"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The number of hours the person spent sending and reading email.</descrip></descripGrp><ntig><termGrp><term id="2858268">email hours</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2859676">tölvupóststundir</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50500_2858270_2859693"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The lack of opposition between work and other life roles. It is the state of equilibrium in which demands of personal life, professional life, and family life are equal.</descrip></descripGrp><ntig><termGrp><term id="2858270">work-life balance</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2859693">jafnvægi vinnu og einkalífs</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50501_2858273_2859686"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">When referring to a manager, or to a meeting involving a manager, "skip-level" refers to the employee's manager's manager, sometimes referred to as "second line manager". A skip-level manager is the manager of the employee's manager. A skip-level meeting is a meeting between an employee and the manager of his or her manager.</descrip></descripGrp><ntig><termGrp><term id="2858273">skip-level</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2859686">hlaupa yfir stjóra</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50502_2858291_2859675"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collective name for character images with multiple poses, emotions and props.</descrip></descripGrp><ntig><termGrp><term id="2858291">cutout people</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2859675">úrklippur af fólki</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50507_2860396_2861432"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A function in Office apps for mobile phones that allows users to make content (text, buttons, etc.) larger.</descrip></descripGrp><ntig><termGrp><term id="2860396">large content viewer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2861432">stór efnisskoðari</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50508_2860488_2860917"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows users to import their financial transactions into Excel so they can view and organize their finances in one place and obtain personalized insights.</descrip></descripGrp><ntig><termGrp><term id="2860488">Money in Excel</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2860917">Peningar í Excel</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50509_2860564_2860919"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft marketing campaign to promote The Art of Teamwork [50467], a framework, toolkit, and digital curriculum to equip our customers with the tools to practice the five key dynamics to successful teamwork.</descrip></descripGrp><ntig><termGrp><term id="2860564">The Art of Teamwork Campaign</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2860919">The Art of 