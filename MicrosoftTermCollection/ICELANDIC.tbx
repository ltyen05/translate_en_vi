termEntry><termEntry id="16637_593054_1109481"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The distribution line for the destination company on an allocation transaction.</descrip></descripGrp><ntig><termGrp><term id="593054">destination distribution line</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1109481">dreifingarlína áfangastaðar</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16639_593057_1109482"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The estimate of sales volume based on the sales volume from previous time periods.</descrip></descripGrp><ntig><termGrp><term id="593057">base forecast</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1109482">grunnspá</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16640_593058_1109483"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The maximum length of time for which future operations are planned.</descrip></descripGrp><ntig><termGrp><term id="593058">time horizon</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1109483">hámarkstími</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNot