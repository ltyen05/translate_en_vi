S"><descripGrp><descrip type="definition">The high definition optical disc format which uses a smaller focus blue-violet 405 nm laser allowing higher precision and storage density. A competitor to Blu-ray Disc.</descrip></descripGrp><ntig><termGrp><term id="346954">HD movie</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="572209">Háskerpukvikmynd</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1155_145640_571315"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A frame that can contain check boxes, toggle buttons, and option buttons on a form, report, or data access page. You use an option group to present alternatives from which the user can select a single option.</descrip></descripGrp><ntig><termGrp><term id="145640">option group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="571315">valkostaflokkur</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11550_235334_1109208"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An order that is generated to fulfill an item requirement and that cannot be modified as to quantity or time.</descrip></descripGrp><ntig><termGrp><term id="235334">firm planned order</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1109208">staðfest tillaga</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11555_233056_1109209"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The decrease in the value of an asset calculated as the difference in the value of the asset when two economic events occur and when the difference is recognized on the occurrence of the second event as a reduction in wealth.</descrip></descripGrp><ntig><termGrp><term id="233056">realized loss</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1109209">innleyst tap</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11558_181384_1956405"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A dialog box that displays information about an object in the interface.</descrip></descripGrp><ntig><termGrp><term id="181384">properties page</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1956405">eiginleikasíða</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11563_109159_1955008"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A data structure that contains security information associated with a protected object. Security descriptors include information about who owns the object, who can access it and in what way, and what types of access are audited.</descrip></descripGrp><ntig><termGrp><term id="109159">security descriptor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1955008">öryggislýsing</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11564_235069_571641"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A technology that allows for ease of creating a new or expanding an existing wireless network. This setup can be done automatically using a USB flash driver or manually through a Wireless Network Setup wizard.</descrip></descripGrp><ntig><termGrp><term id="235069">Windows Connect Now</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="571641">Tengihjálp Windows</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11567_216558_571534"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To arrange to receive a product or use a service regularly.</descrip></descripGrp><ntig><termGrp><term id="216558">subscribe</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="571534">gerast áskrifandi</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11568_397198_408920"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mailbox server that is installed in a Windows failover cluster. A clustered mailbox server is used in both cluster continuous replication (CCR) and single copy cluster (SCC) configurations. A clustered mailbox server was called an Exchange Virtual Server in previous versions of Exchange Server.</descrip></descripGrp><ntig><termGrp><term id="397198">clustered mailbox server</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="408920">klasaður pósthólfaþjónn</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11572_233120_1109211"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of projects that are invoiced from the same invoice proposal.</descrip></descripGrp><ntig><termGrp><term id="233120">invoice project</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1109211">reikningsverk</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11576_358360_1955012"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of components and services that enable voice, fax, and email messages to be stored in a user's single mailbox. Users can also access their Microsoft Exchange Server 2007 mailbox from a telephone or a computer.</descrip></descripGrp><ntig><termGrp><term id="358360">Unified Messaging server role</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1955012">hlutverk UM-þjóns</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11579_233128_1109212"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The component or product that is covered by a service agreement.</descrip></descripGrp><ntig><termGrp><term id="233128">service object</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1109212">þjónustuhlutur</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11584_308343_571931"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A graphic ad that is the full height of a page and normally 120 pixels wide.</descrip></descripGrp><ntig><termGrp><term id="308343">skyscraper</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="571931">lóðréttur auglýsingaborði</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech"