x, and Median.</descrip></descripGrp><ntig><termGrp><term id="761390">boxplot</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2290966">graf með kassa og skegg</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17456_648311_1170909"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that tracks and stores a record of a shared document when it is first created, and each time it is edited.</descrip></descripGrp><ntig><termGrp><term id="648311">version history</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1170909">útgáfuferill</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17465_648455_1956313"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Conditions that users specify to limit which records are included in the result set of a query.</descrip></descripGrp><ntig><termGrp><term id="648455">filter criteria</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1956313">síuskilyrði</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><t