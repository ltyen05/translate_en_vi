t xml:lang="en-US"><descripGrp><descrip type="definition">The status that a user can select that indicates that he/she is in a conference call.</descrip></descripGrp><ntig><termGrp><term id="2018751">In a conference call</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2139825">Í fundarsímtali</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Adverb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34978_2018753_2139839"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The presence status that indicates that a users' presence is not known.</descrip></descripGrp><ntig><termGrp><term id="2018753">Unknown</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2139839">Óþekkt</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34984_2019395_2025368"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A search feature that provides immediate results to users.</descrip></descripGrp><ntig><termGrp><term id="2019395">Instant Search</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2025368">Hraðleit</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type