term lease</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2887445">skammtímaleiga</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51149_2886762_2887446"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An asset that is subject to a lease, for which the right to use that asset has been provided by a lessor to a lessee.</descrip></descripGrp><ntig><termGrp><term id="2886762">underlying asset</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2887446">eign sem liggur til grundvallar</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5115_334561_2188082"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The status notification that the device is in the process of dialing a phone number.</descrip></descripGrp><ntig><termGrp><term id="334561">Dialing</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2188082">Hringir</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51150_2886763_2887447"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An accounting estimate of the number of years an asset is likely to remain in service for the purpose of cost-effective revenue generation.</descrip></descripGrp><ntig><termGrp><term id="2886763">useful life</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2887447">nýtingartími</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51151_2886768_2887094"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The organizational email account that the users log in to Office 365 with, such as an account from Windows Azure Active Directory (Windows Azure AD).</descrip></descripGrp><ntig><termGrp><term id="2886768">authentication email</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2887094">sannvottunarpóstur</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51152_2886769_2887095"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A parameter/argument supplied to the program when it is invoked. It is used to control program from outside instead of hard coding that value inside the code.</descrip></descripGrp><ntig><termGrp><term id="2886769">command-line argument</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2887095">frumbreyta skipanalínu</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51153_2886770_2887096"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The security token that provides a way for an add-in to uniquely identify an add-in user. By establishing the user's identity, developers can implement a single sign-on (SSO) authentication scheme for their back-end service that enables customers who are using Outlook add-ins to connect to their service without logging in.</descrip></descripGrp><ntig><termGrp><term id="2886770">Exchange identity token</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2887096">Exchange-kennimerki</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51154_2886771_2887097"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A multimedia object used as a representation of a content object in virtual scenes, e.g. 3D models, images, video and audio sequences, and texts.</descrip></descripGrp><ntig><termGrp><term id="2886771">media object</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2887097">margmiðlunarhlutur</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51155_2886772_2887098"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Web services based on the OData protocol, allowing users to show Business Central data and update that data in a Business Central database.</descrip></descripGrp><ntig><termGrp><term id="2886772">OData web services</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2887098">OData-vefþjónusta</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51156_2886773_2887099"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Dynamics 365 Business Central feature that accelerates repetitive entry of records by providing an alternate path through editable fields on a page. It changes the behavior of the Enter key to be different from the Tab key, moving the focus to the next Quick Entry field across the page and skipping over non-essential fields.</descrip></descripGrp><ntig><termGrp><term id="2886773">Quick Entry</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2887099">flýtifærsla</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51163_2887244_2888128"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The product that uses artificial intelligence to process content across existing Microsoft technologies in order to organize content and expertise into a knowledge network based around relationships among topics, content, and people.</descrip></descripGrp><ntig><termGrp><term id="2887244">Project Cortex</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2888128">Project Cortex</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51164_2887245_2888129"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The line an error gets underscored with in apps like Word or Outlook during spell check.</descrip></descripGrp><ntig><termGrp><term id="2887245">squiggle</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2888129">hlykkjalína</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51165_2887246_2888123"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To orchestrate a collaboration session.</descrip></descripGrp><ntig><termGrp><term id="2887246">host</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2888123">hýsa</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51166_2887247_2888125"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature of sharing access to the user's current location, letting others see what their geographical position is.</descrip></descripGrp><ntig><termGrp><term id="2887247">location sharing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2888125">staðsetningardeiling</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51168_2887249_2888127"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The act of using a smartphone app to block and filter websites and apps, monitor chats and texts, manage screen time, and perform other functions related to controlling and reporting on that phone's activities, usually with the aim towards making the phone safer to use by children.</descrip></descripGrp><ntig><termGrp><term id="2887249">phone monitoring</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2888127">símavöktun</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5117_262544_1170770"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A visual effect that imparts a quality of translucency to windows.</descrip></descripGrp><ntig><termGrp><term id="262544">glass</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termN