Grp><descrip type="definition">A 13-digit international barcode standard maintained by GS1.</descrip></descripGrp><ntig><termGrp><term id="639819">EAN</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="652718">EAN</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17097_639819_652721"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A 13-digit international barcode standard maintained by GS1.</descrip></descripGrp><ntig><termGrp><term id="639819">EAN</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="652721">Evrópuvörunúmer</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17098_639820_652833"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A benchmark job description provided by the administrator of a salary survey (usually a third party) that allows different companies to compare their internal jobs to a standard description found in the marketplace.</descrip></descripGrp><ntig><termGrp><term id="639820">salary survey reference job</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="652833">viðmiðunarstarf launakönnunar</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote