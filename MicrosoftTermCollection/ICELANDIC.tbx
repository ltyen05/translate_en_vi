pGrp><descrip type="definition">The distance or period of time between a specified start point and a specified end point. For example, the length of an audio or video clip is usually measured in minutes and seconds.</descrip></descripGrp><ntig><termGrp><term id="319158">length</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="572087">lengd</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="512_14369_1792621"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of chart that displays the trend of values over time or categories. By displaying the sum of the plotted values, an area chart also shows the relationship of parts to a whole.</descrip></descripGrp><ntig><termGrp><term id="14369">area chart</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1792621">svæðarit</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5121_73528_1822396"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of symbolic resolution where a symbol is resolved to a specific software routine during program execution instead of during program compilation, enabling polymorphism in object-oriented programs.</descrip></descripGrp><ntig><termGrp><term id="73528">late binding</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1822396">sein binding</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5121_73529_1822396"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of symbolic resolution where a symbol is resolved to a specific software routine during program execution instead of during program compilation, enabling polymorphism in object-oriented programs.</descrip></descripGrp><ntig><termGrp><term id="73529">dynamic binding</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1822396">sein binding</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5122_233258_1108964"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An individual item that is a component of a kit.</descrip></descripGrp><ntig><termGrp><term id="233258">kit line</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1108964">lína í setti</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5123_26059_570505"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To store frequently used data values in a special memory subsystem for quick access.</descrip></descripGrp><ntig><termGrp><term id="26059">cache</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="570505">vista í skyndiminni</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51236_2889600_2890353"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that limits battery charging capacity to 50%, which slows the aging process and prolongs battery longevity.</descrip></descripGrp><ntig><termGrp><term id="2889600">Battery Limit Mode</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2890353">Takmörkunarstilling rafhlöðu</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51237_2889601_2890350"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that helps protect a battery from the cumulative negative effects of consistent and recurrent use at high temperatures or high states of charge by monitoring battery conditions continuously and implementing a limited number of permanent reductions in charging voltage if these adverse conditions are detected.</descrip></descripGrp><ntig><termGrp><term id="2889601">Battery Lifespan Saver</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2890350">Sparnaður en