mmunications, lawyers and their clients will feel free to discuss sensitive legal matters thoroughly.</descrip></descripGrp><ntig><termGrp><term id="1177084">attorney-client privilege</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1956229">trúnaðarsamningur</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25576_1177085_1956210"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A function that corresponds to the "Then" part of a rule (If-Then) and is used to specify what is to be done when a condition evaluates as true.</descrip></descripGrp><ntig><termGrp><term id="1177085">action</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1956210">aðgerð</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25577_1177086_1956236"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A specific word or phrase that is specified on the basis of an organization's messaging policy and used in keyword filtering (content filtering) to identify and prevent unwanted email messages from being delivered to users in the organization.</descrip></descripGrp><ntig><termGrp><term id="1177086">bad word</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1956236">bannorð</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25578_1177087_1956436"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The runspace on the datacenter (host) server, which contains the commands used by the remote user in a client-side session.</descrip></descripGrp><ntig><termGrp><term id="1177087">server-side session</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1956436">lota þjónsmegin</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25579_1177088_1956252"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Windows PowerShell session on a user's local computer, which has the basic Windows PowerShell commands available to it.</descrip></descripGrp><ntig><termGrp><term id="1177088">client-side session</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1956252">lota biðlaramegin</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25582_1177091_1956215"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mailbox that has been accessed at least once in the last 30 days.</descrip></descripGrp><ntig><termGrp><term id="1177091">active mailbox</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1956215">virkt pósthólf</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25583_1177092_1956266"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A directory, database, file, or other data repository that is typically offsite and that needs to be accessed remotely.</descrip></descripGrp><ntig><termGrp><term id="1177092">connected data source</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1956266">tengdur gagnagjafi</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25584_1177093_1956299"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft Identity Lifecycle Manager (ILM) 2007 management agent provided by Microsoft to connect to Outlook Live. It is an ILM component that consists of properties, rules, and rules extensions that determine how an object is processed.</descrip></descripGrp><ntig><termGrp><term id="1177093">Outlook Live Management Agent</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1956299">ELMA</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25584_1177093_1956383"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft Identity Lifecycle Manager (ILM) 2007 management agent provided by Microsoft to connect to Outlook Live. It is an ILM component that consists of properties, rules, and rules extensions that determine how an object is processed.</descrip></descripGrp><ntig><termGrp><term id="1177093">Outlook Live Management Agent</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1956383">Umsjónarmiðlari Outlook Live</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25584_1177245_1956299"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft Identity Lifecycle Manager (ILM) 2007 management agent provided by Microsoft to connect to Outlook Live. It is an ILM component that consists of properties, rules, and rules extensions that determine how an object is processed.</descrip></descripGrp><ntig><termGrp><term id="1177245">OLMA</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1956299">ELMA</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25584_1177245_1956383"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft Identity Lifecycle Manager (ILM) 2007 management agent provided by Microsoft to connect to Outlook Live. It is an ILM component that consists of properties, rules, and rules extensions that determine how an object is processed.</descrip></descripGrp><ntig><termGrp><term id="1177245">OLMA</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1956383">Umsjónarmiðlari Outlook Live</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25584_1354408_1956299"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft Identity Lifecycle Manager (ILM) 2007 management agent provided by Microsoft to connect to Outlook Live. It is an ILM component that consists of properties, rules, and rules extensions that determine how an object is processed.</descrip></descripGrp><ntig><termGrp><term id="1354408">ELMA</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1956299">ELMA</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25584_1354408_1956383"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft Identity Lifecycle Manager (ILM) 2007 management agent provided by Microsoft to connect to Outlook Live. It is an ILM component that consists of properties, rules, and rules extensions that determine how an object is processed.</descrip></descripGrp><ntig><termGrp><term id="1354408">ELMA</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1956383">Umsjónarmiðlari Outlook Live</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25585_1177094_1956286"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A person who has a business need to search the mailboxes in their organization for email and other message types that contain specific keywords.</descrip></descripGrp><ntig><termGrp><term id="1177094">discovery manager</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1956286">leitarstjóri</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25588_1177100_1956312"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">People outside the Outlook Live organization who can be added to public groups and displayed in your organization's address book and other address lists. External contacts have email addresses outside the organization and can't sign in to your domain.</descrip></descripGrp><ntig><termGrp><term id="1177100">external contact</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1956312">ytri tengiliður</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25589_1177102_1956314"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The state that a Windows Live ID takes when the user account with which it is associated is deleted from Outlook Live, but the Windows Live ID for the account isn't deleted. The credentials for that Windows Live ID are still valid and recognized, but the Windows Live ID is put into a forced rename state. If someone tries to sign in using that Windows Live ID and its password, they're asked to rename the Windows Live ID. They can rename the Windows Live ID, but because the new email address can't exist in the Outlook Live domain, the Windows Live ID is no longer functional in Outlook Live.</descrip></descripGrp><ntig><termGrp><term id="1177102">forced rename state</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1956314">þvinguð endurnefning</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25593_1177108_1956363"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Identity Lifecycle Manager (ILM) 2007 object that has been projected into the metaverse from a connector space object and is linked to at least one object in the connector space. A metaverse entry represents the aggregated view of objects from one or several connected data sources.</descrip></descripGrp><ntig><termGrp><term id="1177108">metaverse entry</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1956363">færsla í lýsigagnageymslu</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25594_1177109_1956380"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The set of numbers found in the MX server field in the MX Record Configuration section on the Domain Settings page of the Windows Live Admin Center. The MX token value is unique for each domain. It is required to create an MX record or a CNAME record at DNS hosting services.</descrip></descripGrp><ntig><termGrp><term id="1177109">MX token</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1956380">MX-kóði</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25595_1177111_1956386"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The address by which a Exchange Server recipient object is recognized in a foreign messaging system. In Outlook Live, proxy addresses let people receive email that is sent to different email addresses.</descrip></descripGrp><ntig><termGrp><term id="1177111">proxy address</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1956386">önnur netföng</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25595_1177111_1956409"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The address by which a Exchange Server recipient object is recognized in a foreign messaging system. In Outlook Live, proxy addresses let people receive email that is sent to different email addresses.</descrip></descripGrp><ntig><termGrp><term id="1177111">proxy address</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1956409">vistfang staðgengilsþjóns</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25595_1218373_1956386"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The address by which a Exchange Server recipient object is recognized in a foreign messaging system. In Outlook Live, proxy addresses let people receive email that is sent to different email addresses.</descrip></descripGrp><ntig><termGrp><term id="1218373">other e-mail address</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1956386">önnur netföng</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25595_1218373_1956409"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The address by which a Exchange Server recipient object is recognized in a foreign messaging system. In Outlook Live, proxy addresses let people receive email that is sent to different email addresses.</descrip></descripGrp><ntig><termGrp><term id="1218373">other e-mail address</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1956409">vistfang staðgengilsþjóns</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25597_1177114_1956416"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A specially-configured domain that defines settings for mail flow based on the destination domain of each email message. Administrators can configure specific settings for a specific destination domain, or configure default settings for all destination domains. In this way, they can control the types of messages that are sent to a domain. They can also apply message format policies and acceptable character sets for messages that are sent from users in their organization to the remote domain.</descrip></descripGrp><ntig><termGrp><term id="1177114">remote domain</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1956416">ytra lén</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25599_1177116_1956442"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Simple Mail Transfer Protocol (SMTP) address space or domain suffix that is shared by two different messaging systems. For example, you may have to share the SMTP address space between Microsoft Exchange and a third-party email system, or between Exchange environments that are configured in different Active Directory forests. In these scenarios, users in each email system have the same domain suffix as part of their email addresses.</descrip></descripGrp><ntig><termGrp><term id="1177116">shared address space</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1956442">samnýtt vistfang</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25599_1177116_1956448"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Simple Mail Transfer Protocol (SMTP) address space or domain suffix that is shared by two different messaging systems. For example, you may have to share the SMTP address space between Microsoft Exchange and a third-party email system, or between Exchange environments that are configured in different Active Directory forests. In these scenarios, users in each email system have the same domain suffix as part of their email addresses.</descrip></descripGrp><ntig><termGrp><term id="1177116">shared address space</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1956448">skipt lén</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25599_1177117_1956442"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Simple Mail Transfer Protocol (SMTP) address space or domain suffix that is shared by two different messaging systems. For example, you may have to share the SMTP address space between Microsoft Exchange and a third-party email system, or between Exchange environments that are configured in different Active Directory forests. In these scenarios, users in each email system have the same domain suffix as part of their email addresses.</descrip></descripGrp><ntig><termGrp><term id="1177117">split domain</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1956442">samnýtt vistfang</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25599_1177117_1956448"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Simple Mail Transfer Protocol (SMTP) address space or domain suffix that is shared by two different messaging systems. For example, you may have to share the SMTP address space between Microsoft Exchange and a third-party email system, or between Exchange environments that are configured in different Active Directory forests. In these scenarios, users in each email system have the same domain suffix as part of their email addresses.</descrip></descripGrp><ntig><termGrp><term id="1177117">split domain</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1956448">skipt lén</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25609_1177142_1822880"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A specialized activation option available for approved Microsoft Volume Licensing customers that enables customers to use public key infrastructure (PKI) and digital certificates (or “tokens,” typically stored on smart cards) to activate Windows Vista Enterprise and Windows Server 2008 SP2 locally without contacting either customer-hosted KMS or the Microsoft-hosted activation service using MAK.</descrip></descripGrp><ntig><termGrp><term id="1177142">token-based activation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1822880">ræsing með merki</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25611_1177146_2672081"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A physical card on which a product key is printed.</descrip></descripGrp><ntig><termGrp><term id="1177146">product key card</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2672081">vörulykilskort</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25611_2667272_2672081"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A physical card on which a product key is printed.</descrip></descripGrp><ntig><termGrp><term id="2667272">PKC</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2672081">vörulykilskort</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2564_11046_1696102"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In operating systems, the process of reserving memory for use by a program.</descrip></descripGrp><ntig><termGrp><term id="11046">allocation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1696102">úthlutun geymslurýmis</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2564_1593445_1696102"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In operating systems, the process of reserving memory for use by a program.</descrip></descripGrp><ntig><termGrp><term id="1593445">storage allocation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1696102">úthlutun geymslurýmis</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2564_693442_1696102"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In operating systems, the process of reserving memory for use by a program.</descrip></descripGrp><ntig><termGrp><term id="693442">memory allocation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1696102">úthlutun geymslurýmis</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25674_1177476_1822881"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A gallery to which users can add reusable content to be displayed in Quick Parts and the Building Blocks Organizer.</descrip></descripGrp><ntig><termGrp><term id="1177476">Quick Parts gallery</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1822881">Flýtihlutasafn</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25683_1177653_1956288"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A service that runs Domain Name System (DNS) servers. Most, but not all, domain name registrars include DNS hosting service with registration.</descrip></descripGrp><ntig><termGrp><term id="1177653">DNS hosting service</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1956288">DNS-hýsingarþjónusta</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25695_1179897_1792690"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An online process that confirms whether installed software was properly activated.</descrip></descripGrp><ntig><termGrp><term id="1179897">validation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1792690">staðfesting</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25738_1231857_1822887"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A format for user assistance content that presents simple steps on a given topic that enable a user to begin using a feature quickly.</descrip></descripGrp><ntig><termGrp><term id="1231857">Quick start</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1822887">Flýtiræsing</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25739_1186759_1956223"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A search query syntax that helps produce more precise search results by using targeted queries that search specific properties in a message type. AQS defines certain keywords which can be used to refine the search query, such as specifying boolean operations on searched terms (AND, OR, NOT) as well as to specify further filters based on file metadata or file type. It can also be used to limit results from specific information stores like regular files, offline files cache, or email stores.</descrip></descripGrp><ntig><termGrp><term id="1186759">Advanced Query Syntax</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1956223">ítarleg fyrirspurnamálskipan</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25739_1230149_1956223"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A search query syntax that helps produce more precise search results by using targeted queries that search specific properties in a message type. AQS defines certain keywords which can be used to refine the search query, such as specifying boolean operations on searched terms (AND, OR, NOT) as well as to specify further filters based on file metadata or file type. It can also be used to limit results from specific information stores like regular files, offline files cache, or email stores.</descrip></descripGrp><ntig><termGrp><term id="1230149">AQS</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1956223">ítarleg fyrirspurnamálskipan</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2574_90847_570982"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The quality of sameness or equivalence, in the case of computers usually referring to an error-checking procedure in which the number of 1s must always be the same --either even or odd-- for each group of bits transmitted without error.</descrip></descripGrp><ntig><termGrp><term id="90847">parity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="570982">samsvörun</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25740_1403948_1956308"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The web-based management tool for Microsoft Exchange administrators and enterprise email users.</descrip></descripGrp><ntig><termGrp><term id="1403948">Exchange Control Panel</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1956308">stjórnborð Exchange</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25740_1403948_2795313"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The web-based management tool for Microsoft Exchange administrators and enterprise email users.</descrip></descripGrp><ntig><termGrp><term id="1403948">Exchange Control Panel</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2795313">EAC</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25740_1755528_1956308"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The web-based management tool for Microsoft Exchange administrators and enterprise email users.</descrip></descripGrp><ntig><termGrp><term id="1755528">Exchange admin center</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1956308">stjórnborð Exchange</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25740_1755528_2795313"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The web-based management tool for Microsoft Exchange administrators and enterprise email users.</descrip></descripGrp><ntig><termGrp><term id="1755528">Exchange admin center</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2795313">EAC</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25740_1756842_1956308"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The web-based management tool for Microsoft Exchange administrators and enterprise email users.</descrip></descripGrp><ntig><termGrp><term id="1756842">Exchange Administration Center</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1956308">stjórnborð Exchange</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25740_1756842_2795313"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The web-based management tool for Microsoft Exchange administrators and enterprise email users.</descrip></descripGrp><ntig><termGrp><term id="1756842">Exchange Administration Center</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2795313">EAC</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25740_2794247_1956308"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The web-based management tool for Microsoft Exchange administrators and enterprise email users.</descrip></descripGrp><ntig><termGrp><term id="2794247">EAC</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1956308">stjórnborð Exchange</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25740_2794247_2795313"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The web-based management tool for Microsoft Exchange administrators and enterprise email users.</descrip></descripGrp><ntig><termGrp><term id="2794247">EAC</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2795313">EAC</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25741_1186781_1956350"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The primary navigation tab for mail flow management features in Outlook Live: Transport rules, called “rules” in Outlook Live service; Supervision policies, including closed campus supervision policy and bad words supervision policy, and anti-bullying supervision policy; IP safelisting; Domain types: hosted or shared.</descrip></descripGrp><ntig><termGrp><term id="1186781">Mail Control</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1956350">Póststjórnun</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25742_1186782_1956365"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Web-based management interface for Live@edu administrators. Administrators enroll their domain there initially, and then use the portal to keep their contact information up to date; access DNS record information; view the status of enrolled domains; manage IP safelists; request support for single sign-on; submit or escalate a support request; link to all other resources.</descrip></descripGrp><ntig><termGrp><term id="1186782">Microsoft Live@edu Service Management Portal</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1956365">þjónustustjórnunargátt Microsoft Live@edu</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25743_1186784_1956458"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of email policy settings that can help primary and secondary school administrators comply with some requirements of the Children's Internet Protection Act (CIPA). Using these policy settings, administrators can control who can send email to and receive email from the users in their organization, and filter and reject email that contains objectionable words.</descrip></descripGrp><ntig><termGrp><term id="1186784">supervision policy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1956458">umsjónarstefna</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25744_1187169_1956254"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">E-mail policy settings that apply inbound and outbound email restrictions so students can send email to or receive email from addresses inside the organization only. Administrators can set up organization-wide exceptions so email can be sent to or from specific domains and public groups. Administrators can also configure per-user exceptions so students can send email to and receive email from specific addresses outside the organization.</descrip></descripGrp><ntig><termGrp><term id="1187169">closed campus supervision policy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1956254">umsjónarstefna fyrir lokað skólanet</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25745_1187170_1956226"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An email policy that administrators use to prevent a bully from sending email messages to specific people by adding the bully's email address as an entry on the "victim's" supervision list. This functionality supports anti-harassment policies in schools and other organizations.</descrip></descripGrp><ntig><termGrp><term id="1187170">anti-bullying supervision policy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1956226">umsjónarstefna eineltis</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25747_1188776_1956457"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An individual item on the list of email addresses or users that are subject to or excepted from the actions of the closed campus supervision policy or anti-bullying supervision policy. For example, a bully's email address would be an entry on the supervision list of a "victim", and a parent's email address might be added as an entry on the supervision list of their child, who is a student subject to the closed campus supervision policy.</descrip></descripGrp><ntig><termGrp><term id="1188776">supervision list entry</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1956457">færsla á umsjónarlista</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25748_1188777_1956456"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The list of email addresses or users that are subject to or excepted from the actions of the closed campus supervision policy or anti-bullying supervision policy.</descrip></descripGrp><ntig><termGrp><term id="1188777">supervision list</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1956456">umsjónarlisti</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25749_1188778_1956237"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">E-mail policy settings that prevent sending and receiving email that has specifically banned content. Administrators can use this policy to reject email that contains profanity or other objectionable words, also known as "bad words".</descrip></descripGrp><ntig><termGrp><term id="1188778">bad word supervision policy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1956237">umsjónarstefna bannorða</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25750_1188779_1956374"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of user accounts that are being submitted in a CSV file for migration from an on-premises messaging system to an email system in the cloud.</descrip></descripGrp><ntig><termGrp><term id="1188779">migration batch</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1956374">flutningshópur</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25751_1188780_1956375"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The action of submitting a migration batch for migration from an on-premises messaging system to an email system in the cloud.</descrip></descripGrp><ntig><termGrp><term id="1188780">migration batch request</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1956375">hópflutningsbeiðni</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25753_1188783_1956273"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The time span between the start and end dates.</descrip></descripGrp><ntig><termGrp><term id="1188783">date range</term><termNote type="partOfSp