tig><termGrp><term id="601610">work in process</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="640157">verk í vinnslu</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16686_601619_640086"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The UI field that specifies the role of a document approver.</descrip></descripGrp><ntig><termGrp><term id="601619">Approval Type</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="640086">Tegund samþykktar</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16687_601620_640089"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A container for label and control pairs and for complex controls such as grids.</descrip></descripGrp><ntig><termGrp><term id="601620">band</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="640089">greiningartímabil</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16687_601620_652880"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A container for label and control pairs and for complex controls such as grids.</descrip></descripGrp><ntig><termGrp><term id="601620">band</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="652880">braut</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16688_601621_640090"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A posting which registers which items were used, how much time was spent and what costs were incurred for a service. This type of posting does not increase the amount for which the customer will be invoiced.</descrip></descripGrp><ntig><termGrp><term id="601621">consume</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="640090">nota</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16689_601624_640094"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An icon depicting a stack of papers that represent filtered lists. The cue appears in the Activities home part on the Role Center. The height of each cue roughly represents the number of entities in the underlying list; as the number of entities increases, the height of the cue increases.</descrip></descripGrp><ntig><termGrp><term id="601624">cue</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="640094">bending</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16689_601624_652882"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An icon depicting a stack of papers that represent filtered lists. The cue appears in the Activities home part on the Role Center. The height of each cue roughly represents the number of entities in the underlying list; as the number of entities increases, the height of the cue increases.</descrip></descripGrp><ntig><termGrp><term id="601624">cue</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="652882">bunki</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16689_602464_640094"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An icon depicting a stack of papers that represent filtered lists. The cue appears in the Activities home part on the Role Center. The height of each cue roughly represents the number of entities in the underlying list; as the number of entities increases, the height of the cue increases.</descrip></descripGrp><ntig><termGrp><term id="602464">stack</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="640094">bending</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16689_602464_652882"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An icon depicting a stack of papers that represent filtered lists. The cue appears in the Activities home part on the Role Center. The height of each cue roughly represents the number of entities in the underlying list; as the number of entities increases, the height of the cue increases.</descrip></descripGrp><ntig><termGrp><term id="602464">stack</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="652882">bunki</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16690_601625_640100"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A UI part on the right-side of a list place or task page that can contains graphs, lists, details or links. It provides an at-a-glance view of relevant information in a convenient way, helping to provide insights and intelligence about customer accounts, supplies, shipping status, financial status of an account, etc.</descrip></descripGrp><ntig><termGrp><term id="601625">FactBox</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="640100">Upplýsingakassi</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16691_601626_640101"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A container for label and control pairs and for complex controls such as grids. It groups and organizes complex information into simple, manageable groups. As it displays the information that makes up the form it cannot be removed from the page. FastTabs are used on task pages and they can be collapsed and expanded. The FastTab is an essential part of the form it is on and is the evolution of the tabs in Navision.</descrip></descripGrp><ntig><termGrp><term id="601626">FastTab</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="640101">Flýtiflipi</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16692_601627_640134"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A control that provides the essential user interface needed for a task, making the interaction straightforward.  This feature shows only the most most relevant and most often used information options in a simple format.</descrip></descripGrp><ntig><termGrp><term id="601627">Quick Path</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="640134">Flýtileið</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16693_601628_640139"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A page that provides quick access to information that is regularly viewed, such as a list of activities and links to forms and reports that are used frequently.</descrip></descripGrp><ntig><termGrp><term id="601628">Role Center</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="640139">Mitt hlutverk</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16694_601629_640140"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to a Microsoft Dynamics software design that focuses on the users’ role rather than the structure of the database.</descrip></descripGrp><ntig><termGrp><term id="601629">RoleTailored</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="640140">Hlutverkamiðað</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16697_601660_1696054"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Microsoft site that provides a comprehensive listing of updates that can be distributed over a corporate network.</descrip></descripGrp><ntig><termGrp><term id="601660">Microsoft Update Catalog</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1696054">Microsoft Update-listinn</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16698_605441_640154"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of permissions to objects in the database. Users who have been assigned the role can access these objects with the permissions specified in the role. The permissions determine what the user can do with the object – read, insert, modify, delete or execute.</descrip></descripGrp><ntig><termGrp><term id="605441">user role</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="640154">notandahlutverk</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1670_252087_1108826"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A classifier that characterizes the magnitude or extent of a quantifiable property of an object or activity.</descrip></descripGrp><ntig><termGrp><term id="252087">dimension</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1108826">vídd</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16701_607526_640152"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The amount of something that is consumed over a period of time.</descrip></descripGrp><ntig><termGrp><term id="607526">usage</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="640152">notkun</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16714_608219_1109487"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The portion of inventory that is not allocated and which can be used to fulfill new orders and requirements.</descrip></descripGrp><ntig><termGrp><term id="608219">available to promise</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1109487">ATP</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16714_608219_1109488"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The portion of inventory that is not allocated and which can be used to fulfill new orders and requirements.</descrip></descripGrp><ntig><termGrp><term id="608219">available to promise</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1109488">ATP-afhendingarspá</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16714_608220_1109487"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The portion of inventory that is not allocated and which can be used to fulfill new orders and requirements.</descrip></descripGrp><ntig><termGrp><term id="608220">ATP</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1109487">ATP</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16714_608220_1109488"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The portion of inventory that is not allocated and which can be used to fulfill new orders and requirements.</descrip></descripGrp><ntig><termGrp><term id="608220">ATP</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1109488">ATP-afhendingarspá</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16715_608222_1109489"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The employee who is responsible for creating a demand plan.</descrip></descripGrp><ntig><termGrp><term id="608222">demand planner</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1109489">ábyrgðarmaður eftirspurnaráætlunar</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16716_608226_1109490"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The estimated future demand for a product family. A demand plan is similar to a sales forecast, but if the demand cannot be met, the sales will be less than the demand.</descrip></descripGrp><ntig><termGrp><term id="608226">demand plan</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1109490">eftirspurnaráætlun</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16717_608320_1109491"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A code that indicates the method by which a returned item should be processed.</descrip></descripGrp><ntig><termGrp><term id="608320">disposition code</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1109491">ráðstöfunarkóði</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16718_608321_1109492"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The employee who is responsible for the overall sales and operations plan.</descrip></descripGrp><ntig><termGrp><term id="608321">executive planner</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1109492">skipulagsstjóri</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16719_608323_1109493"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The method that is used to register item consumption for a BOM line against a production order.</descrip></descripGrp><ntig><termGrp><term id="608323">flushing principle</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1109493">losunarregla</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16720_608331_1109494"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A code structure that defines a hierarchy.</descrip></descripGrp><ntig><termGrp><term id="608331">hierarchy provider</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1109494">stigveldisveita</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16721_608332_1109495"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A journal that tracks the status of RFQs.</descrip></descripGrp><ntig><termGrp><term id="608332">RFQ journal</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1109495">færslubók t