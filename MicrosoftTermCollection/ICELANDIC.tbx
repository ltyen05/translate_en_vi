d by Financial Standards.</descrip></descripGrp><ntig><termGrp><term id="601582">revenue recognition</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="640138">tekjuskráning</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16678_601588_640084"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The approval status for an entry.</descrip></descripGrp><ntig><termGrp><term id="601588">approval status</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="640084">samþykktarstaða</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16678_601588_640143"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The approval status for an entry.</descrip></descripGrp><ntig><termGrp><term id="601588">approval status</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="640143">staða</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16678_601589_640084"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The approval status for an entry.</descrip></desc