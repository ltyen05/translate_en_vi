h">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51109_2885548_2886678"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An app that helps users be more productive at work, such as Office apps.</descrip></descripGrp><ntig><termGrp><term id="2885548">productivity app</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2886678">aðstoðarforrit</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51113_2886072_2886636"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The United States holiday celebrated on June 14 that commemorates the adoption of the flag of the United States.</descrip></descripGrp><ntig><termGrp><term id="2886072">Flag Day</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2886636">Fánadagur</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51114_2886073_2886637"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Croatian national holiday celebrated on May 30 to commemorate the constitution of the first modern multi-party Croatian Parliament.</descrip></descripGrp><ntig><termGrp><term id="2886073">Statehood Day</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2886637">Ríkisstöðudagur</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5112_136266_571224"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Microsoft Windows multimedia file format for sound and videos that uses the Microsoft Resource Interchange File Format (RIFF) specification.</descrip></descripGrp><ntig><termGrp><term id="136266">Audio Video Interleaved</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="571224">AVI</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5112_136267_571224"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Microsoft Windows multimedia file format for sound and videos that uses the Microsoft Resource Interchange File Format (RIFF) specification.</descrip></descripGrp><ntig><termGrp><term id="136267">AVI</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="571224">AVI</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51121_2886734_2887418"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An accounting technique used to periodically lower the book value of a loan or intangible asset over a set period of time.</descrip></descripGrp><ntig><termGrp><term id="2886734">amortization</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2887418">afskrift</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51122_2886735_2887419"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A series of payments made at equal intervals.</descrip></descripGrp><ntig><termGrp><term id="2886735">annuity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2887419">afborgun</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51123_2886736_2887420"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A big one-time payment at the end of the lease with lower monthly payments throughout the lease term.</descrip></descripGrp><ntig><termGrp><term id="2886736">balloon payment</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2887420">kúlulán</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51124_2886737_2887421"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A lease agreement that allows the lessee to purchase the leased asset at the end of the lease period at a lower price.</descrip></descripGrp><ntig><termGrp><term id="2886737">bargain purchase agreement</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2887421">kaupleigusamningur</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51125_2886738_2887422"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A liability resulting from the difference between actual cash paid and the straight-line expense recorded on the lessee's financial statements.</descrip></descripGrp><ntig><termGrp><term id="2886738">deferred rent</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2887422">frestaðar leigugreiðslur</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51126_2886739_2887423"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Any expenditure not included in the minimum ongoing payments associated with a lease. The lessee reimburses the lessor for any executory costs incurred by the lessor. Examples of executory costs are property taxes, insurance, and maintenance expenses.</descrip></descripGrp><ntig><termGrp><term id="2886739">executory cost</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2887423">rekstrarkostnaður</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51127_2886740_2887424"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A rational and unbiased estimate of the potential market price of an asset.</descrip></descripGrp><ntig><termGrp><term id="2886740">fair value</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2887424">gangvirði</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51128_2886741_2887425"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of lease in which a finance company is typically the legal owner of the asset for the duration of the lease, while the lessee not only has operating control over the asset, but also some share of the economic risks and returns from the change in the valuation of the underlying asset.</descrip></descripGrp><ntig><termGrp><term id="2886741">finance lease</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2887425">fjármögnunarleigusamningur</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51129_2886742_2887426"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A fee charged when a lessee uses the real property after their lease expiration date.</descrip></descripGrp><ntig><termGrp><term id="2886742">holdover fee</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2887426">framhaldsleigugjald</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51130_2886743_2887427"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A permanent reduction in the carrying value of an asset below its fair value or recoverable amount, which occurs when it is deemed improbable that the lease receivable will be recovered in accordance with the contractual terms of the lease.</descrip></descripGrp><ntig><termGrp><term id="2886743">impairment</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2887427">virðisrýrnun</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51131_2886744_2887428"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An interest rate the lessee would have to pay to borrow the value of the asset over a similar term length and with similar security.</descrip></descripGrp><ntig><termGrp><term id="2886744">incremental borrowing rate</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2887428">vextir á nýju lánsfé</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51132_2886745_2887429"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An interest rate that is tied to a specific benchmark with rate changes based on the movement of the benchmark.</descrip></descripGrp><ntig><termGrp><term id="2886745">index rate</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2887429">vaxtavísitala</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51133_2886746_2887430"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A cost that is directly associated with negotiating and completing an agreement.</descrip></descripGrp><ntig><termGrp><term id="2886746">initial direct cost</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2887430">stofnkostnaður</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51134_2886747_2887431"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A non-operating expense shown on the income statement. It represents interest payable on any borrowings – bonds, loans, convertible debt or lines of credit.</descrip></descripGrp><ntig><termGrp><term id="2886747">interest expense</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2887431">vaxtakostnaður</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51135_2886748_2887432"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A legal agreement in which the right to use real or personal property or services is conveyed over a limited amount of time and for some form of payment.</descrip></descripGrp><ntig><termGrp><term id="2886748">lease</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2887432">leigusamningur</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51136_2886749_2887433"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A payment made by the lessor to the company as an incentive to sign the lease.</descrip></descripGrp><ntig><termGrp><term id="2886749">lease incentive</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2887433">leiguhvati</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51137_2886750_2887434"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In accounting, a financial obligation to make the payments arising from a lease, measured on a discounted basis.</descrip></descripGrp><ntig><termGrp><term id="2886750">lease liability</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2887434">leiguskuldbinding</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51138_2886751_2887435"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An amount provided by the lessee on a regular basis to the owner of the property or services for a specific period of time in exchange for use.</descrip></descripGrp><ntig><termGrp><term id="2886751">lease payment</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2887435">leigugreiðsla</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51139_2886752_2887436"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Fixed, non-cancelable period for which a lease agreement is in force.</descrip></descripGrp><ntig><termGrp><term id="2886752">lease term</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:l