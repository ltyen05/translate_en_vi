h">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2251725">stjórntæki</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38395_2223132_2251750"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A 17-character alphanumeric identifier for a control unit and its manufacturer. The first five characters denote the manufacturer and the remaining 12 characters denote the control unit.</descrip></descripGrp><ntig><termGrp><term id="2223132">serial number (control unit)</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2251750">raðnúmer (stjórntæki)</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38399_2223248_2236700"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Sway Design feature that allows users to change the navigation and layout model of a particular Sway document.</descrip></descripGrp><ntig><termGrp><term id="2223248">Structure</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2236700">Skipuleggja</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38400_2225054_2288865"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tool that lets you create, view, and modify business process libraries and flowcharts for Microsoft Dynamics AX.</descrip></descripGrp><ntig><termGrp><term id="2225054">Business process modeler</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2288865">Viðskiptaferlavinnsla</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38401_2225085_2288866"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tool that you can use to deploy Microsoft Dynamics AX 2012 R3 environments on Microsoft Azure.</descrip></descripGrp><ntig><termGrp><term id="2225085">Cloud-hosted environments</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2288866">Umhverfi í skýi</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38402_2225087_2288867"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tool that helps you manage support incidents by letting you create a virtual machine (VM) in Microsoft Azure that has the same hotfixes installed as your local environment.</descrip></descripGrp><ntig><termGrp><term id="2225087">Cloud-powered support</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2288867">Stuðningur í skýi</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38403_2225095_2288868"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tool that lets you copy a configuration from one instance of Microsoft Dynamics AX 2012 R3 to another.</descrip></descripGrp><ntig><termGrp><term id="2225095">Configuration manager (beta)</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2288868">Grunnstillingastjórnun (beta)</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38404_2225099_2288873"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tool that helps you estimate the number of licenses that an organization will need for Microsoft Dynamics AX 2012. It provides a shared workspace that lets you  model default and customized roles, and then automatically calculate the required client access licenses (CALs).</descrip></descripGrp><ntig><termGrp><term id="2225099">License sizing estimator</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2288873">Leyfaáætlun</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38405_2225102_2288871"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tool that provides an automated rough first estimate of the hardware needs of an environment.</descrip></descripGrp><ntig><termGrp><term id="2225102">Infrastructure estimator</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2288871">Vélbúnaðaráætlun</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38406_2225104_2288872"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A search engine that you can use to quickly search for Knowledge Base (KB) articles, hotfixes requested by customers and partners, proactive fixes, regulatory features, and workarounds for reported issues. You can also see which reported issues are in the process of being fixed. You can download released hotfixes, see which code objects are affected, and see the code changes introduced by the hotfix.</descrip></descripGrp><ntig><termGrp><term id="2225104">Issue search</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2288872">Vandamálaleit</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38407_2225105_2288869"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An automated tool that validates the customer’s model files against Microsoft Dynamics AX best-practice rules for tables, classes, forms, and enums. It then generates reports, including a summary report that is displayed on the site, a detailed Microsoft Excel report that lists all issues, and a developer report that the developer can load in the Microsoft Dynamics AX development environment.</descrip></descripGrp><ntig><termGrp><term id="2225105">Customization analysis</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2288869">Sérstillingargreining</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38409_2225125_2288879"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A data-gathering tool that can help you describe your projected or current usage of a Microsoft Dynamics AX 2012 implementation. You can use the data from the Usage profiler for a variety of purposes, such as estimating infrastructure sizing.</descrip></descripGrp><ntig><termGrp><term id="2225125">Usage profiler</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2288879">Notkunarupplýsingar</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38410_2225126_2288876"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A page in Lifecycle Services (LCS) that contains common questions found on requests for proposals (RFPs), and recommended answers.</descrip></descripGrp><ntig><termGrp><term id="2225126">RFP responses</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2288876">Svör við tilboðsbeiðni</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38411_2225130_2288864"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tool that lets users see and try out available beta and preview products.</descrip></descripGrp><ntig><termGrp><term id="2225130">Beta feature management</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2288864">Stjórnun beta-eiginleika</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38412_2225134_2288875"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tool that lets partners and customers configure Microsoft Dynamics AX 2012 by using a cloud-based, interview-style questionnaire. The questionnaire uses general terminology about business processes instead of terms that are specific to Microsoft Dynamics AX.</descrip></descripGrp><ntig><termGrp><term id="2225134">RapidStart</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2288875">RapidStart</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38413_2225142_2288877"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A cloud-based tool that helps administrators monitor and understand the health of one or more Microsoft Dynamics AX environments.</descrip></descripGrp><ntig><termGrp><term id="2225142">System diagnostics</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2288877">Kerfisgreining</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38414_2225143_2288878"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tool that helps users plan a full-version upgrade to Microsoft Dynamics AX 2012 from Microsoft Dynamics AX 4.0 or Microsoft Dynamics AX 2009, or a minor version or in-place upgrades from one version of AX 2012 to another.</descrip></descripGrp><ntig><termGrp><term id="2225143">Upgrade analysis</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2288878">Uppfærslugreining</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38416_2226110_2229024"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The service that is installed as part of the MultiPoint role on server and ensures that some MultiPoint configuration settings remain set to keep Windows MultiPoint Server running smoothly.</descrip></descripGrp><ntig><termGrp><term id="2226110">Windows MultiPoint Server Repair Service</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2229024">Viðgerðaþjónusta Windows MultiPoint Server</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38418_2226112_2228783"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in the Messaging app that detects whether an SMS message is spam, based on its content.</descrip></descripGrp><ntig><termGrp><term id="2226112">smart blocking</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2228783">snjöll útilokun</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38419_2227157_2228680"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A keypad that is available in Programmer mode, which allows the user to look at numbers represented as various combinations of 1s and 0s, and to toggle between 1 and 0 for each binary bit to form a new number.</descrip></descripGrp><ntig><termGrp><term id="2227157">bit toggling keypad</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2228680">takkaborð fyrir bitabreytingar</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38420_2227158_2228682"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of thematically related apps, games, music tracks, videos, or other items available for purchase or download in the Store. A thematic group of editorially chosen apps and games for merchandising or marketing purposes.</descrip></descripGrp><ntig><termGrp><term id="2227158">Collection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2228682">Safn</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38421_2227159_2228684"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows the user to select a color and increase or decrease the vibrancy of that color in an image.</descrip></descripGrp><ntig><termGrp><term id="2227159">color boost</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2228684">líflegri litir</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38422_2227160_2791367"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The menu invoked with a shortcut key (Windows + G) when gaming that allows users to take a screenshot, take a 30 second clip of a game, and adjust volume controls.</descrip></descripGrp><ntig><termGrp><term id="2227160">Game Bar</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2791367">Game Bar</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38423_2227161_2228720"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The platform on which the operating system runs on form factors other than PCs, tablets, and phones.</descrip></descripGrp><ntig><termGrp><term id="2227161">IoT</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2228720">IoT</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38423_2227161_2269625"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The platform on which the operating system runs on form factors other than PCs, tablets, and phones.</descrip></descripGrp><ntig><termGrp><term id="2227161">IoT</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2269625">Internet hlutanna</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38423_2268355_2228720"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The platform on which the operating system runs on form factors other than PCs, tablets, and phones.</descrip></descripGrp><ntig><termGrp><term id="2268355">Internet of Things</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2228720">IoT</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38423_2268355_2269625"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The platform on which the operating system runs on form factors other than PCs, tablets, and phones.</descrip></descripGrp><ntig><termGrp><term id="2268355">Internet of Things</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2269625">Internet hlutanna</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38424_2227162_2228757"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A broad set of all the user's local and cloud-based content, including documents, apps, settings, photos, videos, music, and email.  Cortana or Bing can search this content and return it in search results.</descrip></descripGrp><ntig><termGrp><term id="2227162">my stuff</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2228757">gögnin mín</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38426_2227164_2229004"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A note, handwritten or typed, that can be added by the user directly on webpages from within the browser.</descrip></descripGrp><ntig><termGrp><term id="2227164">Web Note</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2229004">vefglósa</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38427_2227165_2229006"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The edition of Windows 10 available through volume licensing, that is designed for education institutions, and includes all of the features of Windows 10 Pro, plus some other features like virtualization, management, DirectAccess, and BranchCache.</descrip></descripGrp><ntig><termGrp><term id="2227165">Windows 10 Education</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2229006">Windows 10 Education</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38428_2227166_2229007"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The edition of Windows 10 that is available only through volume licensing, is designed for businesses, and includes all of the features of Windows 10 Pro, plus some other features like virtualization, management, DirectAccess, and BranchCache.</descrip></descripGrp><ntig><termGrp><term id="2227166">Windows 10 Enterprise</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2229007">Windows 10 Enterprise</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38429_2227167_2229016"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The edition of Windows 10 designed for HoloLens.</descrip></descripGrp><ntig><termGrp><term id="2227167">Windows 10 Holographic</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2229016">Windows 10 Holographic</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38430_2227168_2229017"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The edition of Windows 10 designed for home users.</descrip></descripGrp><ntig><termGrp><term id="2227168">Windows 10 Home</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote