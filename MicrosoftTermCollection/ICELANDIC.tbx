wsing session. This helps prevent anyone else who might be using your computer from seeing where you visited and what you looked at on the Web.</descrip></descripGrp><ntig><termGrp><term id="1030897">InPrivate Browsing</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2279962">InPrivate-vefskoðun</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22186_1081740_1953883"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that blocks third-party web content that could potentially track someone's web activity.</descrip></descripGrp><ntig><termGrp><term id="1081740">InPrivate Filtering</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1953883">rakningarvörn</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22186_1509231_1953883"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that blocks third-party web content that could potentially track someone's web activity.</descrip></descripGrp><ntig><termGrp><term id="1509231">Tracking Protection</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1953883">rakningarvörn</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNou