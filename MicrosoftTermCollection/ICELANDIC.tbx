witch between applications, control the operating system and even fill out forms on the web.</descrip></descripGrp><ntig><termGrp><term id="1167216">Windows Speech Recognition</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2262033">Windows-talgreining</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25008_1765219_1767697"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A text-based post on Twitter.</descrip></descripGrp><ntig><termGrp><term id="1765219">Tweet</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1767697">Twitter-færsla</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25008_1765219_2192378"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A text-based post on Twitter.</descrip></descripGrp><ntig><termGrp><term id="1765219">Tweet</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2192378">tíst</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25008_2060482_1767697"><langSet xml:lang="en-US