 values other than 1 or 0 are accepted, but they are always interpreted as 1.</descrip></descripGrp><ntig><termGrp><term id="359698">bit</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1792630">biti</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40694_2360413_2362332"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A movie or TV show that can be watched instantly and in high definition.</descrip></descripGrp><ntig><termGrp><term id="2360413">instant-on HD</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2362332">háskerpa á augabragði</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40697_2360416_2362366"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The collection title for the music albums that are on sale in the Movie Store.</descrip></descripGrp><ntig><termGrp><term id="2360416">Music deals</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2362366">Tónlistartilboð</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntr