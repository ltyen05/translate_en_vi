exported to an XML file, which is then imported to the target server.</descrip></descripGrp><ntig><termGrp><term id="375737">cloned configuration</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="378605">klónuð samskipan</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10567_232824_1822590"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A graphic or other object that is inserted in the drawing layer so that you can position it precisely on the page or in front of or behind text or other objects.</descrip></descripGrp><ntig><termGrp><term id="232824">floating object</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1822590">svífandi hlutur</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10572_24731_1822371"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A toolbar that is part of an application when it's installed on your computer.</descrip></descripGrp><ntig><termGrp><term id="24731">built-in toolbar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1822371">innbyggð tækjastika</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</ter