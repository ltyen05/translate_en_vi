Note><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52131_2946707_2947241"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that allows IT pros and admins to set up internal SharePoint Online sites within their organizations and populate them with training videos customized to their end users.</descrip></descripGrp><ntig><termGrp><term id="2946707">Microsoft 365 learning pathways</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2947241">Námsleiðir Microsoft 365</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52131_2946708_2947240"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that allows IT pros and admins to set up internal SharePoint Online sites within their organizations and populate them with training videos customized to their end users.</descrip></descripGrp><ntig><termGrp><term id="2946708">learning pathways</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2947240">námsleiðir</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52131_2946708_2947241"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that allows IT pros and admins to set up internal SharePoint Online sites within their organizations and populate them with training videos customized to their end users.</descrip></descripGrp><ntig><termGrp><term id="2946708">learning pathways</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2947241">Námsleiðir Microsoft 365</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52139_2946739_2947246"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature in Teams that helps the remote worker reinstate the division between work time and home time by scheduling time at the beginning of the workday to prepare for work and at the end of the workday to reflect, celebrate accomplishments, plan the next day's tasks, or meditate with Headspace.</descrip></descripGrp><ntig><termGrp><term id="2946739">virtual commute</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2947246">sýndarferð til og frá vinnu</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52143_2947723_2948262"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An XML document that specifies a list of sites, their compatibility mode, and their intended browser.</descrip></descripGrp><ntig><termGrp><term id="2947723">Enterprise Mode Site List</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2948262">Svæðalisti fyr