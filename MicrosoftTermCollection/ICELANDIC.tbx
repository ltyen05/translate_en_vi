><descrip type="definition">The order in which objects are placed in a layer. An object higher in the stack will cover up (appear on top of) one lower in the stack.</descrip></descripGrp><ntig><termGrp><term id="135739">z-order</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1108865">samfelluröð</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2320_494337_1108865"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The order in which objects are placed in a layer. An object higher in the stack will cover up (appear on top of) one lower in the stack.</descrip></descripGrp><ntig><termGrp><term id="494337">stack order</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1108865">samfelluröð</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2320_494338_1108865"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The order in which objects are placed in a layer. An object higher in the stack will cover up (appear on top of) one lower in the stack.</descrip></descripGrp><ntig><termGrp><term id="494338">Z order</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1108865">samfelluröð</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2320_662101_1108865"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The order in which objects are placed in a layer. An object higher in the stack will cover up (appear on top of) one lower in the stack.</descrip></descripGrp><ntig><termGrp><term id="662101">z order</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1108865">samfelluröð</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23200_1062908_1171124"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables Tablet PC users to convert an ink drawing to a standard OfficeArt shape, which can be formatted with colors and effects exactly as if it were inserted using “Insert Shape.”</descrip></descripGrp><ntig><termGrp><term id="1062908">Convert to Shape</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1171124">Breyta í form</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23201_1062909_1171125"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables presenters to capture all the elements of a live presentation, including narration, slides, mouse clicks, A/V playback, and laser pointer highlights. The user can select which presentation aspects to record.</descrip></descripGrp><ntig><termGrp><term id="1062909">Record Slide Show</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1171125">Taka upp kynningu</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23214_1064085_1650237"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A map view created from aerial photos that shows buildings, roads, and geographical features.</descrip></descripGrp><ntig><termGrp><term id="1064085">aerial view</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1650237">loftmynd</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2323_61200_3042386"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to the base-16 number system represented by the digits 0 through 9 and the uppercase or lowercase letters A (equivalent to decimal 10) through F (equivalent to decimal 15). Hexadecimal values are commonly used in HTML code to identify colors.</descrip></descripGrp><ntig><termGrp><term id="61200">hex</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="3042386">sextándakerfi</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2323_61201_3042386"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to the base-16 number system represented by the digits 0 through 9 and the uppercase or lowercase letters A (equivalent to decimal 10) through F (equivalent to decimal 15). Hexadecimal values are commonly used in HTML code to identify colors.</descrip></descripGrp><ntig><termGrp><term id="61201">hexadecimal</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="3042386">sextándakerfi</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2325_347934_572227"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The InfoPath design environment in which you can create or modify a form template.</descrip></descripGrp><ntig><termGrp><term id="347934">design mode</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="572227">hönnunarsnið</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2327_460715_1108866"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An activity performed, or to be performed, by a user for planning or running a campaign. A campaign activity includes additional, campaign-specific information, such as budgets and vendor names.</descrip></descripGrp><ntig><termGrp><term id="460715">campaign activity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1108866">verkþáttur herferðar</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2328_21412_2577196"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To associate two pieces of information with one another.</descrip></descripGrp><ntig><termGrp><term id="21412">bind</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2577196">binda</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2328_21412_570474"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To associate two pieces of information with one another.</descrip></descripGrp><ntig><termGrp><term id="21412">bind</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="570474">bindast</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23319_1072508_2433673"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The XML-based vector image format for two-dimensional graphics that supports interactivity and animation and that maintains an image's appearance regardless of screen size or print size.</descrip></descripGrp><ntig><termGrp><term id="1072508">Scalable Vector Graphics</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2433673">SVG</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23319_1072508_2610752"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The XML-based vector image format for two-dimensional graphics that supports interactivity and animation and that maintains an image's appearance regardless of screen size or print size.</descrip></descripGrp><ntig><termGrp><term id="1072508">Scalable Vector Graphics</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2610752">SVG-mynd</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23319_1072509_2433673"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The XML-based vector image format for two-dimensional graphics that supports interactivity and animation and that maintains an image's appearance regardless of screen size or print size.</descrip></descripGrp><ntig><termGrp><term id="1072509">SVG</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2433673">SVG</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23319_1072509_2610752"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The XML-based vector image format for two-dimensional graphics that supports interactivity and animation and that maintains an image's appearance regardless of screen size or print size.</descrip></descripGrp><ntig><termGrp><term id="1072509">SVG</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2610752">SVG-mynd</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2333_146857_1170735"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Row or column labels that are printed at the top of or on the left side of every page on a printed worksheet.</descrip></descripGrp><ntig><termGrp><term id="146857">print titles</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1170735">prenttitlar</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23331_1073321_1171126"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A slide show mode that displays content in a manageable window that can be resized and features navigation buttons. This mode is optimized for reviewing presentations, allowing users to get the full experience, complete with animations and media, while performing other tasks, such as taking notes.</descrip></descripGrp><ntig><termGrp><term id="1073321">Reading View</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1171126">Lesgluggi</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23333_1087526_1171127"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows users to easily add links to content within other content (e.g. pages, sections, section groups) and provides quick navigation through these links. The feature operates in the same manner that links work in wikis.</descrip></descripGrp><ntig><termGrp><term id="1087526">linking</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1171127">tenging</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23334_1073349_1171128"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that highlights new or changed content in a shared notebook that the user has not yet read.</descrip></descripGrp><ntig><termGrp><term id="1073349">Unread Changes</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1171128">Ólesnar breytingar</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23335_1073356_1485259"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A high-level linear representation of a project schedule that can be easily formatted, annotated, and copied and pasted from Project into other Office applications.</descrip></descripGrp><ntig><termGrp><term id="1073356">timeline</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1485259">tímalína</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23336_1073640_1860023"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that identifies the author of unread new or changed content in a shared notebook.</descrip></descripGrp><ntig><termGrp><term id="1073640">Author Marks</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1860023">höfundamerki</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23347_1074772_1485260"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A task pane that helps form designers to build and manage custom business rules for use in their forms.</descrip></descripGrp><ntig><termGrp><term id="1074772">Rules Manager</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1485260">reglustjórnun</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23348_1074773_1485261"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A pre-defined table style that allows users to change the look and feel of a form.</descrip></descripGrp><ntig><termGrp><term id="1074773">layout style</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1485261">útlitssnið</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23349_1074775_1485262"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows form designers to select from a gallery of pre-built rules to make their forms dynamic.</descrip></descripGrp><ntig><termGrp><term id="1074775">Quick Rules</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1485262">flýtireglur</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23351_1074778_1485263"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A pre-defined layout that users can select for their InfoPath form sections. Options include single column, two-column, three-column, and four-column layouts.</descrip></descripGrp><ntig><termGrp><term id="1074778">section layout</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1485263">útlit hluta</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23352_1216614_1485264"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An environment in the InfoPath client that enables users to fill out forms (as opposed to designing them). It must be used if the forms to be filled out are not browser-compatible.</descrip></descripGrp><ntig><termGrp><term id="1216614">InfoPath Filler</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1485264">InfoPath Filler</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23352_1216691_1485264"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An environment in the InfoPath client that enables users to fill out forms (as opposed to designing them). It must be used if the forms to be filled out are not browser-compatible.</descrip></descripGrp><ntig><termGrp><term id="1216691">Microsoft InfoPath Filler</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1485264">InfoPath Filler</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23361_1074891_2072797"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The combination of hardware (touchscreen or touchpad) and software elements that provides a way to control programs by touching multiple points on the screen simultaneously.</descrip></descripGrp><ntig><termGrp><term id="1074891">multi-touch</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2072797">fjölsnertiskipanir</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="234_237832_1485153"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An object created using drawing tools or commands.</descrip></descripGrp><ntig><termGrp><term id="237832">shape</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1485153">form</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">