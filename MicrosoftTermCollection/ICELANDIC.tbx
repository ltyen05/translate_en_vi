Set xml:lang="en-US"><descripGrp><descrip type="definition">A provider of services that are related to the transportation of goods by road. The GTA issues a consignment note.</descrip></descripGrp><ntig><termGrp><term id="2223101">goods transport agency</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2251734">flutningsfyrirtæki</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38386_2223101_2553178"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A provider of services that are related to the transportation of goods by road. The GTA issues a consignment note.</descrip></descripGrp><ntig><termGrp><term id="2223101">goods transport agency</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2553178">FLF</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38386_2223103_2251734"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A provider of services that are related to the transportation of goods by road. The GTA issues a consignment note.</descrip></descripGrp><ntig><termGrp><term id="2223103">GTA</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2251734">flutningsfyrirtæki</term><termNote type="geographicalUsage">ISL</t