 xml:lang="en-US"><descripGrp><descrip type="definition">To transfer closing account balances from one accounting period to opening account balances in the subsequent accounting period.</descrip></descripGrp><ntig><termGrp><term id="1467971">carry forward</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1477807">yfirfæra</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27861_1467972_1478693"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A repeatable process that improves or maintains performance.</descrip></descripGrp><ntig><termGrp><term id="1467972">practice</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1478693">æfing</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27862_1467973_1478694"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A repeatable sequence of steps that are followed in a specific order to meet the requirements of a task.</descrip></descripGrp><ntig><termGrp><term id="1467973">procedure</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1478694">ferli</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</term