e></termGrp></ntig></langSet></termEntry><termEntry id="4986_37166_1172495"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A device capable of processing information, storing data, and producing a desired result based on instructions provided.</descrip></descripGrp><ntig><termGrp><term id="37166">computer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1172495">tölva</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49860_2819434_2826121"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The MMD device profile that offers the greatest power to the local user (ability to install apps, etc.). Intended for use typically by developers, field engineers, etc.</descrip></descripGrp><ntig><termGrp><term id="2819434">Power user device profile</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2826121">tækisforstilling yfirnotanda</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49861_2819436_2826130"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The MMD device profile that is more &amp;quot;locked down&amp;quot; to preserve the security of sensitive data. Intended for handling sensitive data such as medical records.</descrip></descripGrp><ntig><termGrp><term id="2819436">Sensitive data device profile</term><termNote type="partOfSpeech">Nou