>Flokkunarskrifstofa fyrir kvikmyndir og bókmenntir</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4070_319490_2684990"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A previous name of the government body which independently applied and enforced interactive game ratings in Australia and New Zealand.</descrip></descripGrp><ntig><termGrp><term id="319490">OFLC</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2684990">Flokkunarskrifstofa fyrir kvikmyndir og bókmenntir</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40700_2360425_2362421"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The view that shows the recent items you have played.</descrip></descripGrp><ntig><termGrp><term id="2360425">Recent plays</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2362421">Spilað nýlega</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40701_2360426_2362451"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A pass that provides access to all current and future episodes of a TV show season, usually sold at a discount price.</descrip></descripGrp><ntig><termGrp><term id="2360426">season pass</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2362451">áskrift að þáttaröð</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40703_2360428_2362492"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A library that contains your video files.</descrip></descripGrp><ntig><termGrp><term id="2360428">video library</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2362492">myndbandasafn</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40705_2360433_2362458"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The collection title for songs that are in the top N% of sales.</descrip></descripGrp><ntig><termGrp><term id="2360433">Top-selling songs</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2362458">Mest seldu lögin</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40706_2360434_2362372"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The category in Windows Store Movies &amp; TV section that shows the movies and TV shows purchased and rented by you as well as your videos in Movies &amp; TV app.</descrip></descripGrp><ntig><termGrp><term id="2360434">My movies &amp; TV</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2362372">Mínar kvikmyndir og sjónvarpsþættir</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40707_2360435_2362414"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To order an item that is currently not available.</descrip></descripGrp><ntig><termGrp><term id="2360435">pre-order</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2362414">forpanta</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4071_120587_571136"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A measurement used for high-capacity data storage. One terabyte equals 240, or 1,099,511,627,776, bytes, although it is commonly interpreted as simply one trillion bytes.</descrip></descripGrp><ntig><termGrp><term id="120587">terabyte</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="571136">terabæti</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4071_120587_571520"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A measurement used for high-capacity data storage. One terabyte equals 240, or 1,099,511,627,776, bytes, although it is commonly interpreted as simply one trillion bytes.</descrip></descripGrp><ntig><termGrp><term id="120587">terabyte</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="571520">TB</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4071_211565_571136"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A measurement used for high-capacity data storage. One terabyte equals 240, or 1,099,511,627,776, bytes, although it is commonly interpreted as simply one trillion bytes.</descrip></descripGrp><ntig><termGrp><term id="211565">TB</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="571136">terabæti</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4071_211565_571520"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A measurement used for high-capacity data storage. One terabyte equals 240, or 1,099,511,627,776, bytes, although it is commonly interpreted as simply one trillion bytes.</descrip></descripGrp><ntig><termGrp><term id="211565">TB</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="571520">TB</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40745_2362004_2365893"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The area in a Lync meeting where content is presented.</descrip></descripGrp><ntig><termGrp><term id="2362004">content stage</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2365893">efnissvæði</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40746_2362005_2365993"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In a Lync desktop sharing session, the owner of the session can give everyone in the session control, which means that participants can then work together in the same file or desktop and see each other’s changes immediately. Participants can "request," "take," "release," and "give back" control. Only one person can be "in control" at a time.</descrip></descripGrp><ntig><termGrp><term id="2362005">control</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2365993">stjórnun</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40748_2362007_2365997"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A named collection of contacts in the Contacts list.</descrip></descripGrp><ntig><termGrp><term id="2362007">group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2365997">hópur</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40749_2362008_2366004"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To remove yourself from a conference call that will continue without you.</descrip></descripGrp><ntig><termGrp><term id="2362008">leave call</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2366004">yfirgefa símtal</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40751_2362010_2366042"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To rejoin a window back into an original window which it had been popped out from previously.</descrip></descripGrp><ntig><termGrp><term id="2362010">pop in</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2366042">fella inn í</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40752_2362011_2366038"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To separate an area of a UI into a new window.</descrip></descripGrp><ntig><termGrp><term id="2362011">pop out</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2366038">opna í sérglugga</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40753_2362012_2366085"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows someone to share documents or applications with others. The user may also choose to give another person control of an application or the user's computer.</descrip></descripGrp><ntig><termGrp><term id="2362012">program sharing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2366085">forritadeiling</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40755_2362014_2366048"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The team responsible for administering use of a multiuser computer system, communications system, or both. A system administrator performs such duties as assigning user accounts and passwords, establishing security access levels, allocating storage space, and watching for unauthorized access.</descrip></descripGrp><ntig><termGrp><term id="2362014">support team</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2366048">þjónustudeild</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40756_2362015_2366090"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to contacts who are currently Offline.</descrip></descripGrp><ntig><termGrp><term id="2362015">unavailable</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2366090">ekki viðlátin/n</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40756_2362015_2727870"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to contacts who are currently Offline.</descrip></descripGrp><ntig><termGrp><term id="2362015">unavailable</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2727870">ekki viðlátin(n)</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40757_2362016_2366093"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Viewing the presentation asynchronously from what the presenter is presenting (i.e. "Presenter View").</descrip></descripGrp><ntig><termGrp><term id="2362016">view privately</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="2366093">skoða einslega</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="408_181420_1792675"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A database instance that makes data available for replication to other servers.</descrip></descripGrp><ntig><termGrp><term id="181420">publisher</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1792675">útgefandi</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="408_359265_1792675"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A database instance that makes data available for replication to other servers.</descrip></descripGrp><ntig><termGrp><term id="359265">publisher database</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="is"><ntig><termGrp><term id="1792675">útgefandi</term><termNote type="geographicalUsage">ISL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Mascu