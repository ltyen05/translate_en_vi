raphicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39475_2298835_2300711"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The service for downloading Windows updates and Windows Store apps from sources in addition to Microsoft and sending them to other PCs in a local network or on the Internet reducing the amount of Internet bandwidth needed.</descrip></descripGrp><ntig><termGrp><term id="2298835">Delivery Optimization</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2300711">Windows Update ഡെലിവറി ഒപ്റ്റിമൈസേഷൻ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39486_2300114_2304725"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The access level that allows consumers who are on a small-screen device and have not signed into an Office 365 app with a subscription to do basic editing.</descrip></descripGrp><ntig><termGrp><term id="2300114">core editing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2304725">പ്രാഥമിക ചിട്ടപ്പെടുത്തൽ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39487_2300132_2304750"><langSet xml:lang="en-US"><descripGrp><descrip ty