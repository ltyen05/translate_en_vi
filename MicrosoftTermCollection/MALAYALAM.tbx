oadtest file is opened. It displays a tree structure of nodes.</descrip></descripGrp><ntig><termGrp><term id="237246">Load Test Editor</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1241509">ലോഡ് പരിശോധന എഡിറ്റര്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="756_106608_1425486"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An on-screen scale marked off in inches or other units of measure and used to show line widths, tab settings, paragraph indents, and so on.</descrip></descripGrp><ntig><termGrp><term id="106608">ruler</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1425486">അളവുകോല്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7561_306402_490467"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A filter effect in Windows Movie Maker.</descrip></descripGrp><ntig><termGrp><term id="306402">Rotate 180</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="490467">തിരിക്കുക 180</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7566_184262_490020"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A delay that occurs while data is processed or delivered.</descrip></descripGrp><ntig><termGrp><term id="184262">latency</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="490020">വൈകല്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7570_140476_1229723"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The .pst data file used as the main delivery location for your email messages.</descrip></descripGrp><ntig><termGrp><term id="140476">default data file</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1229723">സ്ഥിരസ്ഥിതി ഡാറ്റാ ഫയല്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7571_170485_489977"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">One of a collection of drivers that responds to the same IRPs. Layered driver describes the highest-level and lowest-level drivers in a chain of layered drivers that process the same IRPs, along with all intermediate drivers in the chain.</descrip></descripGrp><ntig><termGrp><term id="170485">layered driver</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="489977">പടലിത ഡ്രൈവര്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7581_237287_1877936"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows creation of mathematical formulas in documents, including the insertion of mathematical symbols inside designated "math zones" which perform automatic formatting to convert fractions, etc.</descrip></descripGrp><ntig><termGrp><term id="237287">Equation Builder</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1877936">സമവാക്യ ബില്‍ഡര്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7583_416276_1241510"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file that contains information about a particular database schema and how Data Generator will generate data for it.</descrip></descripGrp><ntig><termGrp><term id="416276">data generation plan</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1241510">ഡാറ്റാ ഉല്പാദന പദ്ധതി</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7584_130154_489737"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A portion of unique computer code contained in a virus. Antivirus programs search for known virus signatures to identify infected programs and files.</descrip></descripGrp><ntig><termGrp><term id="130154">virus signature</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="489737">വൈറസ് ഒപ്പ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7590_375744_1960925"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that lets a Microsoft Outlook user who has a Microsoft Exchange email account work offline, either by choice or due to a connection problem. A copy of the user's mailbox is stored on their computer and is frequently updated from the mail server. Any changes that are made while a connection to the server is not available are synchronized automatically when a connection becomes available.</descrip></descripGrp><ntig><termGrp><term id="375744">Cached Exchange Mode</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1960925">കാഷെചെയ്‍ത Exchange മോഡ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7593_147682_1877843"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In a formula, the address of a cell based on the relative position of the cell that contains the formula and the cell referred to. If you copy the formula, the reference automatically adjusts.</descrip></descripGrp><ntig><termGrp><term id="147682">relative reference</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1877843">റിലേറ്റീവ് റഫറന്‍സ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7593_147682_1877970"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In a formula, the address of a cell based on the relative position of the cell that contains the formula and the cell referred to. If you copy the formula, the reference automatically adjusts.</descrip></descripGrp><ntig><termGrp><term id="147682">relative reference</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1877970">റിലേറ്റീവ് സെല്‍ റഫറന്‍സ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7593_461709_1877843"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In a formula, the address of a cell based on the relative position of the cell that contains the formula and the cell referred to. If you copy the formula, the reference automatically adjusts.</descrip></descripGrp><ntig><termGrp><term id="461709">relative cell reference</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1877843">റിലേറ്റീവ് റഫറന്‍സ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7593_461709_1877970"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In a formula, the address of a cell based on the relative position of the cell that contains the formula and the cell referred to. If you copy the formula, the reference automatically adjusts.</descrip></descripGrp><ntig><termGrp><term id="461709">relative cell reference</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1877970">റിലേറ്റീവ് സെല്‍ റഫറന്‍സ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="76_39968_489163"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method of protecting the rights of an originator of a creative work, such as a text, a piece of music, a painting, or a computer program, through law.</descrip></descripGrp><ntig><termGrp><term id="39968">copyright</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="489163">പകര്‍പ്പവകാശം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7603_148245_1877847"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The visual representation of a script on a Web page that you open in a Microsoft Office program.</descrip></descripGrp><ntig><termGrp><term id="148245">script anchor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1877847">സ്‌ക്രിപ്റ്റ് ആങ്കര്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7604_137569_1877771"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In an organization chart, a shape that is placed below and connected to any other shape with an elbow connector. This shape is placed above any additional subordinate shapes for the particular superior shape it is attached to.</descrip></descripGrp><ntig><termGrp><term id="137569">assistant shape</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1877771">അസിസ്റ്റന്റ് ആകാരം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7604_1509002_1877771"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In an organization chart, a shape that is placed below and connected to any other shape with an elbow connector. This shape is placed above any additional subordinate shapes for the particular superior shape it is attached to.</descrip></descripGrp><ntig><termGrp><term id="1509002">assistant box</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1877771">അസിസ്റ്റന്റ് ആകാരം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7612_47524_489231"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In windowing environments, such as the Apple Macintosh and Microsoft Windows, an on-screen window (enclosed work area) in which the user can create, view, or work on a document.</descrip></descripGrp><ntig><termGrp><term id="47524">document window</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="489231">ഡോക്യുമെന്‍റ് ജാലകം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7625_187159_1241511"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A number that represents the position of the column in a set of columns. So, if a table has 3 columns, named Name, Address, and Zip, in that order, their ordinals are 0, 1, and 2.</descrip></descripGrp><ntig><termGrp><term id="187159">column ordinal</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1241511">നിര ക്രമസൂചകം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7628_144937_1877823"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows multiple design templates to be applied to a single presentation.</descrip></descripGrp><ntig><termGrp><term id="144937">multiple masters</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1877823">ഒന്നിലധികം മാസ്റ്ററുകള്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7630_187506_1241512"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The phases a solution goes through from the time it is conceived until the time it is retired from service.</descrip></descripGrp><ntig><termGrp><term id="187506">life cycle</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1241512">ജീവചക്രം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7631_134267_489767"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In a spreadsheet program, a file containing a number of related worksheets.</descrip></descripGrp><ntig><termGrp><term id="134267">workbook</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="489767">വര്‍ക്ക്‌ബുക്ക്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></