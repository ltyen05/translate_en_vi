peech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15469_237181_1241971"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The point at which the rate of fixed bugs exceeds the rate of found bugs. Bug convergence is a visible indication that the team is making progress against the active bug count. It is a sign that the project end is within reach.</descrip></descripGrp><ntig><termGrp><term id="237181">bug convergence</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1241971">ബഗ്ഗു കേന്ദ്രീകരിക്കല്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15474_535444_1241972"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A list of tests that can be selected and managed from Test Manager.</descrip></descripGrp><ntig><termGrp><term id="535444">test list</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1241972">പരിശോധന ലിസ്റ്റ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15476_72470_489388"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In database management, an identifier for a record or group of records in a datafile.</descrip></descripGrp><ntig><termGrp><term id="72470">key</term><termNot