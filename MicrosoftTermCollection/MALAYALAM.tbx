244">Project Cortex</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2888335">പ്രോജക്റ്റ് Cortex</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51164_2887245_2888336"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The line an error gets underscored with in apps like Word or Outlook during spell check.</descrip></descripGrp><ntig><termGrp><term id="2887245">squiggle</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2888336">പിഴ സൂചക വര</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51165_2887246_2888332"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To orchestrate a collaboration session.</descrip></descripGrp><ntig><termGrp><term id="2887246">host</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2888332">ഹോസ്റ്റുചെയ്യുക</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51166_2887247_2888333"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature of sharing access to the user's current location, letting others see what their geographical position is.</descrip></descripGrp><ntig><termGrp><term id="2887247">location sharing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2888333">ലൊക്കേഷൻ പങ്കിടൽ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51168_2887249_2888334"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The act of using a smartphone app to block and filter websites and apps, monitor chats and texts, manage screen time, and perform other functions related to controlling and reporting on that phone's activities, usually with the aim towards making the phone safer to use by children.</descrip></descripGrp><ntig><termGrp><term id="2887249">phone monitoring</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2888334">ഫോൺ നിരീക്ഷണം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5117_262544_1229939"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A visual effect that imparts a quality of translucency to windows.</descrip></descripGrp><ntig><termGrp><term id="262544">glass</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1229939">വിന്‍ഡോ ഗ്ളാസ്</term><termNote type="geographicalUsage">IND</termNote