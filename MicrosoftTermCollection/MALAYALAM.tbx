9100"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In communications, a channel connecting two switching stations. A trunk usually carries a large number of calls at the same time.</descrip></descripGrp><ntig><termGrp><term id="2843750">voice trunk</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2849100">വോയ്‌സ് ട്രങ്ക്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2397_137813_489798"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A three-dimensional edge effect that is applied to the border of an object.</descrip></descripGrp><ntig><termGrp><term id="137813">bevel</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="489798">ത്രിമാനവാക്ക്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24_537631_1241087"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A component that can be registered as part of the ASP.NET request lifecycle and that can read or change the request or response as it is processed. HttpModules are often used to perform special tasks that need to monitor each request, such as security or site statistics.</descrip></descripGrp><ntig><termGrp><term id="537631">HTTP module</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml: