r">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="490211">ഘടകഭാഗം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1236_42543_1877713"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file consisting of data in the form of text, numbers, or graphics, as distinct from a program file of commands and instructions.</descrip></descripGrp><ntig><termGrp><term id="42543">data file</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1877713">ഡാറ്റ ഫയല്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12360_245056_1241787"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The degree of process improvement across a predefined set of process areas in which all goals within the set are attained.</descrip></descripGrp><ntig><termGrp><term id="245056">maturity level</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1241787">പക്വ നില</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12362_464497_1961279"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">User's perception about the utility usability and desirability of a product as they integrate it into their lives and their family system. The user experience will be the differentiator that drives adoption and use of hardware software and services.</descrip></descripGrp><ntig><termGrp><term id="464497">user experience</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1961279">ഉപയോക്തൃ അനുഭവം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12363_121418_1877756"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In an online forum, such as a newsgroup, a series of messages or articles in which replies to a message are nested directly under it instead of arranged in chronological or alphabetical order.</descrip></descripGrp><ntig><termGrp><term id="121418">threaded discussion</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1877756">ത്രെഡുചെയ്‌തിരിക്കുന്ന ചര്‍ച്ച</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12363_648609_1877756"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In an online forum, such as a newsgroup, a series of messages or articles in which replies to a message are nested directly under it instead of arranged in chronological or alphabetical order.</descrip></descripGrp><ntig><termGrp><term id="648609">discussion thread</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1877756">ത്രെഡുചെയ്‌തിരിക്കുന്ന ചര്‍ച്ച</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12368_536539_1241788"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An ASP.NET server control that belongs to the System.Web.UI.WebControls namespace. Web server controls are richer and more abstract than HTML server controls.</descrip></descripGrp><ntig><termGrp><term id="536539">Web server control</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1241788">വെബ് സെര്‍വര്‍ നിയന്ത്രണം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12369_1977874_1986222"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Information that includes identification and proof of identification that is used to gain access to local and network resources.</descrip></descripGrp><ntig><termGrp><term id="1977874">sign-in info</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1986222">സൈന്‍-ഇന്‍ വിവരം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1236