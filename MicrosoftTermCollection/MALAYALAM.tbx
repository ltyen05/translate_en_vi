of link types with other artifacts of that type. Some examples are Source file, defect, requirement, test result, build.</descrip></descripGrp><ntig><termGrp><term id="187023">artifact type</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1241713">മനുഷ്യനിര്‍മ്മിത തരം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11280_133179_1707361"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A utility that enables the user to locate and open files and folders.</descrip></descripGrp><ntig><termGrp><term id="133179">Windows Explorer</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1707361">ഫയല്‍ എക്സ്പ്ലോറര്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11280_133179_489756"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A utility that enables the user to locate and open files and folders.</descrip></descripGrp><ntig><termGrp><term id="133179">Windows Explorer</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="489756">Windows Explorer</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote t