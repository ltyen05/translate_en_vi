147_2641257"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Excel function that returns a value or a subset of values from a provided reference.</descrip></descripGrp><ntig><termGrp><term id="2637147">SUBSET</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2641257">SUBSET</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46849_2637148_2641250"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office Lens feature that allows users to use ink to annotate their photos.</descrip></descripGrp><ntig><termGrp><term id="2637148">Ink annotations</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2641250">ഇങ്ക് വ്യാഖ്യാനങ്ങൾ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46851_2637200_2641258"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Excel function that returns a list of unique values in a list or range and that uses a language code (ll-CC) provided as an argument to determine sorting behavior.</descrip></descripGrp><ntig><termGrp><term id="2637200">UNIQUE.INTL</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2641258">UNIQUE.INTL</term><termNote t