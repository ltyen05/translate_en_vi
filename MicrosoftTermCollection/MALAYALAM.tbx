definition">The abstract type of an endpoint, which defines common characteristics of a class of endpoints. Examples include, Web Site Endpoint, Http Client Endpoint, Http Server Endpoint.</descrip></descripGrp><ntig><termGrp><term id="186950">abstract endpoint definition</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1241366">സംക്ഷിപ്ത അവസാനബിന്ദു നിര്‍വ്വചനം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49170_2785561_2789439"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A body of proof that is to be presented in a legal proceeding to convince a judge or jury of alleged facts in a case.</descrip></descripGrp><ntig><termGrp><term id="2785561">evidence</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2789439">തെളിവ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49171_2785562_2789442"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of documents that a user has grouped together as evidence in a data investigation.</descrip></descripGrp><ntig><termGrp><term id="2785562">evidence set</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2789442">രേഖാ സഞ്ജയം</term><termNote type="geographic