7179">പ്രിയപ്പെട്ടവ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38601_2244486_2257286"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The navigation layout that presents content in a single column on the page and that allows user to navigate from top to bottom.​​</descrip></descripGrp><ntig><termGrp><term id="2244486">Vertical</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2257286">ലംബം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38602_2244487_2257254"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Structure that places content along the horizontal axis and allows users to navigate through it from left and right.</descrip></descripGrp><ntig><termGrp><term id="2244487">Panorama</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2257254">പനോരമ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38603_2244846_2257165"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Sway feature that allows a user to click on an embedded image to see any of the following: a hig