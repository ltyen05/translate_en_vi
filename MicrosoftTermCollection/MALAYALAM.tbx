 task pane that allows users to view and customize specific paragraph and text style properties.</descrip></descripGrp><ntig><termGrp><term id="210477">style inspector</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1877885">ശൈലി ഇന്‍‌സ്‌പെക്‌ടര്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8887_62829_1241583"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file format that can be viewed using a Web browser. With this file format, you can publish your reports directly to your Intranet or web site.</descrip></descripGrp><ntig><termGrp><term id="62829">HTML file</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1241583">HTML ഫയല്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8891_308309_2015843"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Add-in software that provides partially localized user interfaces for particular computer programs in languages not supported by localized versions of those programs.</descrip></descripGrp><ntig><termGrp><term id="308309">Language Interface Pack</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2015843">ഭാഷാ സമ്പർക്കമുഖ പായ്ക്ക്</term><termNote type="geographi