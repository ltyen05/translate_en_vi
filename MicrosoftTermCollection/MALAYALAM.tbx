estination.</descrip></descripGrp><ntig><termGrp><term id="2459049">guided navigation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2460956">നിർദ്ദേശത്തോടൊപ്പമുള്ള നാവിഗേഷൻ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35715_2065925_2196233"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The sound the phone makes when the user receives a text message.</descrip></descripGrp><ntig><termGrp><term id="2065925">text tone</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2196233">ടെസ്റ്റ് ടോൺ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35716_2065926_2196215"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature where users can add contacts that they call frequently so that they can get to their numbers quickly rather than going through the Contact list in People.</descrip></descripGrp><ntig><termGrp><term id="2065926">speed dial</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2196215">വേഗ ഡയൽ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35718_2067023_2196167"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A list of contacts users can call (i.e. only shows contacts that have phone numbers associated with them).</descrip></descripGrp><ntig><termGrp><term id="2067023">phone book</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2196167">ഫോൺ ബുക്ക്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35719_2067024_2200993"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature on the phone to enroll in and manage a workplace account.</descrip></descripGrp><ntig><termGrp><term id="2067024">workplace</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2200993">തൊഴിലിടം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35720_2067025_2196267"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An account provided by a company that allows users to install apps or hubs provided by that company, and that governs the company policies applied to the phone.</descrip></descripGrp><ntig><termGrp><term id="2067025">workplace account</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2196267">തൊഴിലിട അക്കൗണ്ട്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35721_2067026_2196237"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Local public transportation; the vehicles used for such transport.</descrip></descripGrp><ntig><termGrp><term id="2067026">transit</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2196237">ട്രാൻസിറ്റ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35722_2067027_2196178"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that allows the user to connect the phone to an external display (a PC monitor, for instance) and then display the phone screen on the external display.</descrip></descripGrp><ntig><termGrp><term id="2067027">project my screen</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2196178">എന്റെ സ്ക്രീൻ പ്രൊജക്റ്റ് ചെയ്യുക</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35723_2067028_2196219"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The option that provides driving or walking directions to the user where the app provides both spoken and visual instructions at the right time for the user to act on those instructions.</descrip></descripGrp><ntig><termGrp><term id="2067028">start voice nav</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2196219">ശബ്ദ നാവി ആരംഭിക്കുക</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35723_2067028_2201003"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The option that provides driving or walking directions to the user where the app provides both spoken and visual instructions at the right time for the user to act on those instructions.</descrip></descripGrp><ntig><termGrp><term id="2067028">start voice nav</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2201003">ടേൺ-ബൈ-ടേൺ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35723_2067029_2196219"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The option that provides driving or walking directions to the user where the app provides both spoken and visual instructions at the right time for the user to act on those instructions.</descrip></descripGrp><ntig><termGrp><term id="2067029">turn-by-turn</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2196219">ശബ്ദ നാവി ആരംഭിക്കുക</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35723_2067029_2201003"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The option that provides driving or walking directions to the user where the app provides both spoken and visual instructions at the right time for the user to act on those instructions.</descrip></descripGrp><ntig><termGrp><term id="2067029">turn-by-turn</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2201003">ടേൺ-ബൈ-ടേൺ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35724_2067030_2198734"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A camera option that enables users to capture moving subjects by snapping multiple photos on shutter press and allowing the user to pick the best one or just accept the photo recommended by the software.</descrip></descripGrp><ntig><termGrp><term id="2067030">burst mode</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2198734">ബഴ്സ്റ്റ് മോഡ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35725_2067031_2196249"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The phone's LED light used during video capture to help exposure in dark conditions.</descrip></descripGrp><ntig><termGrp><term id="2067031">video light</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2196249">വീഡിയോ ലൈറ്റ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35726_2067032_2196223"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that allows you to sync some of the settings on your phone across all of your Windows 8 devices.</descrip></descripGrp><ntig><termGrp><term id="2067032">sync my settings</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2196223">എന്റെ ക്രമീകരണങ്ങൾ സമന്വയിപ്പിക്കുക</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35727_2067033_2201542"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To touch an NFC-capable device to a tag, an NFC reader, or another device to wirelessly transfer content or information.</descrip></descripGrp><ntig><termGrp><term id="2067033">tap</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2201542">സ്പര്‍ശിക്കുക</term><termNote type="geographicalUsage">IND</ter