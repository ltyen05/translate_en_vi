ype="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="3044311">Microsoft Purview ഉപഭോക്തൃ കീ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46353_2612185_2612930"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The consumer-friendly name for virtualization-based security (VBS). The VBS service in Windows 10 uses hardware virtualization features to create and isolate a secure region of memory from the normal operating system.</descrip></descripGrp><ntig><termGrp><term id="2612185">Core isolation</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2612930">കോർ ഒറ്റപ്പെടൽ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46354_2612186_2612931"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of open tabs, including applications, files, pages, or websites, which can be saved together and re-opened together when you want to continue with that set of tabs.</descrip></descripGrp><ntig><termGrp><term id="2612186">set</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2612931">ഗണം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46355_2612189_2612933"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The most important person in a video that you create using the video remix feature in Microsoft Photos. When ​the user selects a person as the "star," then photos and video clip​s of that person will be featured more prominently than other content in the video.​</descrip></descripGrp><ntig><termGrp><term id="2612189">star</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2612933">സ്റ്റാർ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46356_2612191_2615025"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The pre-release version of Microsoft People app.</descrip></descripGrp><ntig><termGrp><term id="2612191">People Preview</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2615025">Microsoft പീപ്പിൾ പ്രിവ്യൂ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46356_2612191_2615026"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The pre-release version of Microsoft People app.</descrip></descripGrp><ntig><termGrp><term id="2612191">People Preview</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalN