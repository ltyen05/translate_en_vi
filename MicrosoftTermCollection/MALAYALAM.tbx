fSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2353299">എന്റർപ്രൈസ് കൺട്രോൾ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40504_2353123_2353302"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The modern implementation of Windows PowerShell built on .NET Core. It includes a command-line shell, scripting language, and automation engine, providing IT administrators comprehensive control and automation of system administration tasks across multiple platforms.</descrip></descripGrp><ntig><termGrp><term id="2353123">PowerShell Core</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2353302">PowerShell Core</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40511_2353386_2354204"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The group of add-ons for Office 2016 that includes one or more of the following: proofing tools, an LIP, a language pack, and/or a spellchecker.</descrip></descripGrp><ntig><termGrp><term id="2353386">Office 2016 Language Accessory Pack</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2354204">Office 2016 Language Accessory Pack</term><termNote type="geographicalUsage">IND</termNote><termNote type="part