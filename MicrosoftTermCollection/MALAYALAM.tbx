/termEntry><termEntry id="727_126759_2764454"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user account name (sometimes referred to as the user logon name) and a domain name identifying the domain in which the user account is located and which is the standard usage for logging on to a Windows domain.</descrip></descripGrp><ntig><termGrp><term id="126759">user principal name</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2764454">ഉപയോക്തൃ പ്രാഥമിക നാമം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="727_126760_2764454"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user account name (sometimes referred to as the user logon name) and a domain name identifying the domain in which the user account is located and which is the standard usage for logging on to a Windows domain.</descrip></descripGrp><ntig><termGrp><term id="126760">UPN</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2764454">ഉപയോക്തൃ പ്രാഥമിക നാമം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7271_170000_489976"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To verify that your software product is a legal copy and is installed in compliance with the Microsoft Software License Terms.</descrip></descripGrp><ntig><termGrp><term id="170000">activate</t