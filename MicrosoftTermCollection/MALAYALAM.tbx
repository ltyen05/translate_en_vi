/termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1877706">പ്രോം‌പ്റ്റ് ടോണ്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10627_129129_489729"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To cause an application to display information on a computer or device screen.</descrip></descripGrp><ntig><termGrp><term id="129129">view</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="489729">കാണിക്കുക</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10633_545687_1877976"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A view that shows the headings of a document indented to represent their level in the document's structure. You can also use this view to work with master documents.</descrip></descripGrp><ntig><termGrp><term id="545687">outline layout view</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1877976">ഔട്ട്‌ലൈന്‍ ലേഔട്ട് കാഴ്‌ച</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10635_2037689_490427"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of trojan used to notify an attacker when the software has been installed.</descrip></descripGrp><ntig><termGrp><term id="2037689">trojan notifier</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="490427">ട്രോജന്‍ നോട്ടിഫയര്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10636_536512_1241684"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A compiler takes the Java bytecode (which is machine-independent) and compiles it on demand into native code for the target machine, giving faster execution. Since JIT compilers operate on the client machine, they preserve the platform-independence of the compiled Java program.</descrip></descripGrp><ntig><termGrp><term id="536512">just-in-time compiler</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1241684">JIT കംപൈലര്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10636_536512_1241685"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A compiler takes the Java bytecode (which is machine-independent) and compiles it on demand into native code for the target machine, giving faster execution. Since JIT compilers operate on the client machine, they preserve the platform-independence of the compiled Java program.</descrip></descripGrp><ntig><termGrp><term id="536512">just-in-time compiler</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1241685">സമയത്തിനുമാത്രം സമ്പാദിനി</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10636_71337_1241684"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A compiler takes the Java bytecode (which is machine-independent) and compiles it on demand into native code for the target machine, giving faster execution. Since JIT compilers operate on the client machine, they preserve the platform-independence of the compiled Java program.</descrip></descripGrp><ntig><termGrp><term id="71337">JIT compiler</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1241684">JIT കംപൈലര്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10636_71337_1241685"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A compiler takes the Java bytecode (which is machine-independent) and compiles it on demand into native code for the target machine, giving faster execution. Since JIT compilers operate on the client machine, they preserve the platform-independence of the compiled Java program.</descrip></descripGrp><ntig><termGrp><term id="71337">JIT compiler</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1241685">സമയത്തിനുമാത്രം സമ്പാദിനി</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10637_2754105_2759387"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that supplies callers with information and performs an action without the intervention of a human operator, automatically routing calls based on selections made by the caller.</descrip></descripGrp><ntig><termGrp><term id="2754105">auto attendant</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2759387">ഓട്ടോ അറ്റൻഡന്റ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10637_2754105_2759388"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that supplies callers with information and performs an action without the intervention of a human operator, automatically routing calls based on selections made by the caller.</descrip></descripGrp><ntig><termGrp><term id="2754105">auto attendant</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2759388">ക്ലൗഡ് ഓട്ടോ അറ്റൻഡന്റ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10637_2754779_2759387"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that supplies callers with information and performs an action without the intervention of a human operator, automatically routing calls based on selections made by the caller.</descrip></descripGrp><ntig><termGrp><term id="2754779">Cloud auto attendant</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2759387">ഓട്ടോ അറ്റൻഡന്റ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10637_2754779_2759388"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that supplies callers with information and performs an action without the intervention of a human operator, automatically routing calls based on selections made by the caller.</descrip></descripGrp><ntig><termGrp><term id="2754779">Cloud auto attendant</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2759388">ക്ലൗഡ് ഓട്ടോ അറ്റൻഡന്റ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10647_543489_1241686"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Team Foundation link between two work items.</descrip></descripGrp><ntig><termGrp><term id="543489">related link</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet x