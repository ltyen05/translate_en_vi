ig></langSet></termEntry><termEntry id="19382_658448_1805327"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ability of one element to see or refer to another. For one element to send a message to another element, the latter must be visible to the former.</descrip></descripGrp><ntig><termGrp><term id="658448">visibility</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1805327">దృశ్యమానత</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19402_658527_1878063"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The primary address that is used in mail merges.</descrip></descripGrp><ntig><termGrp><term id="658527">mailing address</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1878063">മെയിലിംഗ് വിലാസം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19408_1031397_2601818"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A computer simulation of a physical object in which length, width, and depth are real attributes: a model, with x-, y-, and z-axes, that can be rotated for viewing from different angles.</descrip></descripGrp><ntig><termGrp><term id="1031397">three-dimensional model</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet 