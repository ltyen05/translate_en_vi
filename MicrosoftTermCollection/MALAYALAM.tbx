reate a three-dimensional object.</descrip></descripGrp><ntig><termGrp><term id="52839">extrusion</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2433261">എക്സ്ട്രൂഷൻ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2367_535439_1241240"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Any class that is marked with the TestClass attribute.</descrip></descripGrp><ntig><termGrp><term id="535439">test class</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1241240">പരിശോധനാ ക്ലാസ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23692_1088842_2754741"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of test cases and their associated test configuration information and the iteration when it is planned to run these tests.</descrip></descripGrp><ntig><termGrp><term id="1088842">test plan</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2754741">സാധൂകരണ പദ്ധതി</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEnt