on">The hardware-based security feature that prevents unauthorized access to a computer by providing full-volume encryption and integrity checking of boot components.</descrip></descripGrp><ntig><termGrp><term id="266797">BitLocker</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="490391">BitLocker ഡ്രൈവ് എന്‍‌ക്രിപ്ഷന്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16006_276546_490353"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The hardware-based security feature that prevents unauthorized access to a computer by providing full-volume encryption and integrity checking of boot components.</descrip></descripGrp><ntig><termGrp><term id="276546">BitLocker Drive Encryption</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="490353">BitLocker</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16006_276546_490391"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The hardware-based security feature that prevents unauthorized access to a computer by providing full-volume encryption and integrity checking of boot components.</descrip></descripGrp><ntig><termGrp><term id="276546">BitLocker Drive Encryption</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="490391">BitLocker ഡ്രൈവ് എന്‍‌ക്രിപ്ഷന്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16015_373997_1425551"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application that contains a linked or embedded OLE object from another application.</descrip></descripGrp><ntig><termGrp><term id="373997">container</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1425551">കണ്ടെയിനര്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16015_38570_1425551"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application that contains a linked or embedded OLE object from another application.</descrip></descripGrp><ntig><termGrp><term id="38570">container application</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1425551">കണ്ടെയിനര്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16024_147515_1242004"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A data type that is represented by a reference (similar to a pointer) to the type's actual value. If a reference type is assigned to a variable, that variable references (or "points to") the original value. No copy is made. Reference types comprise classes, interfaces, delegates, and boxed value types.</descrip></descripGrp><ntig><termGrp><term id="147515">reference type</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1242004">പരാമര്‍ശ തരം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16034_269339_490378"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file system defined by the Optical Storage Technology Association (OSTA) that is the successor to the CD-ROM file system (CDFS). UDF is used for removable disk media like DVD, CD, and magneto-optic (MO) disks.</descrip></descripGrp><ntig><termGrp><term id="269339">Universal Disk Format</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="490378">യൂണിവേഴ്സല്‍ ഡിസ്ക് ഫോര്‍മാറ്റ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16034_269339_490379"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file system defined by the Optical Storage Technology Association (OSTA) that is the successor to the CD-ROM file system (CDFS). UDF is used for removable disk media like DVD, CD, and magneto-optic (MO) disks.</descrip></descripGrp><ntig><termGrp><term id="269339">Universal Disk Format</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="490379">UDF</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16034_269340_490378"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file system defined by the Optical Storage Technology Association (OSTA) that is the successor to the CD-ROM file system (CDFS). UDF is used for removable disk media like DVD, CD, and magneto-optic (MO) disks.</descrip></descripGrp><ntig><termGrp><term id="269340">UDF</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="490378">യൂണിവേഴ്സല്‍ ഡിസ്ക് ഫോര്‍മാറ്റ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16034_269340_490379"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file system defined by the Optical Storage Technology Association (OSTA) that is the successor to the CD-ROM file system (CDFS). UDF is used for removable disk media like DVD, CD, and magneto-optic (MO) disks.</descrip></descripGrp><ntig><termGrp><term id="269340">UDF</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="490379">UDF</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelect