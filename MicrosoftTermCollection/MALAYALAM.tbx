><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56115_3156316_3160041"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables users to search the web with two search engines simultaneously.</descrip></descripGrp><ntig><termGrp><term id="3156316">dual search</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="3160041">ഡ്യുവൽ തിരയൽ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56116_3156317_3160042"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables users in Edge to centralize all their active media in one place and lets them manage each audio and video playback, without having to navigate any tabs.</descrip></descripGrp><ntig><termGrp><term id="3156317">media control center</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="3160042">മീഡിയ കൺട്രോൾ കേന്ദ്രം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56117_3156318_3160043"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in Edge that allows users to highlight text within a PDF that’s in one language and translate