efinition">A group of different visualization patterns and interactions for content shown in Sway.</descrip></descripGrp><ntig><termGrp><term id="2139120">card</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2257138">കാർഡ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37481_2139121_2257202"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Sway card that allows the user to select one or more pieces or types of content and change what is selected into a heading.</descrip></descripGrp><ntig><termGrp><term id="2139121">Header</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2257202">ശീർഷകം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37482_2139122_2257269"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Sway card that shows individual pieces of content sequentially, allowing forward and backward navigation one piece of content at a time.</descrip></descripGrp><ntig><termGrp><term id="2139122">Slideshow</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2257269">സ്ലൈഡ്‌ഷോ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNot