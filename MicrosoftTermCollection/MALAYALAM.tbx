1484854_2726395"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Software Assurance benefit delivered by Microsoft Certified Partner that consists of one to fifteen days of planning the deployment of Microsoft Office Software for a specific organization.</descrip></descripGrp><ntig><termGrp><term id="1484854">Microsoft Desktop Deployment Planning Services</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2726395">Microsoft ഡെസ്‌ക്‌ടോപ്പ് ഡിപ്‌ളോയ്‌മെന്‍റ് പ്ലാനിംഗ് സേവനങ്ങള്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28426_1486692_2688608"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An entity that represents a service at the Key Distribution Center (KDC). The service principal has a name and an associated key. A subclass of principal, a service principal generally does not correspond to a human user of the system, but rather to an automated service providing a resource, such as a file server.</descrip></descripGrp><ntig><termGrp><term id="1486692">service principal</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2688608">സേവന പ്രിൻസിപ്പൽ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2846_297003_1228930"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A trojan that captures and/or transmits passwords to an attacker.</descrip></descripGrp><ntig><termGrp><term id="297003">password stealer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1228930">രഹസ്യവാക്ക് മോഷ്ടാവ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2846_297003_2720533"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A trojan that captures and/or transmits passwords to an attacker.</descrip></descripGrp><ntig><termGrp><term id="297003">password stealer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2720533">പാസ്‌വേഡ് മോഷ്‌ടാവ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28462_1488403_1961077"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that allows the preservation of items in user mailboxes and the protection of the items from deletion by users or automated processes.</descrip></descripGrp><ntig><termGrp><term id="1488403">Litigation Hold</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1961077">ലിറ്റിഗേഷന്‍ ഹോള്‍ഡ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28541_1489075_1931305"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A service under which customers can acquire and redeem points for certain online services and digital products.</descrip></descripGrp><ntig><termGrp><term id="1489075">Microsoft Points</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1931305">Microsoft പോയിന്റുകള്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28593_1489612_2074223"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process of repeated installation of a product, feature, tool, kit, pack, etc.</descrip></descripGrp><ntig><termGrp><term id="1489612">reinstallation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2074223">പുനർസംസ്ഥാപനം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="286_157947_1241108"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">On Windows-based computers, a user account that is a member of the computer’s local Administrators group or a member of a group that is a member of the local Administrators group, such as the Domain Admins group in a Windows domain. This is the first account that is created when you install an operating system on a new workstation, stand-alone server, or member server. By default, this account has the highest level of administrative access to the local computer.</descrip></descripGrp><ntig><termGrp><term id="157947">administrator account</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1241108">അടങ്ങിയിരിക്കുന്ന അഡ്മിനിസ്ട്രേറ്റര്‍ അക്കൌണ്ട്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="286_157947_1241109"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">On Windows-based computers, a user account that is a member of the computer’s local Administrators group or a member of a group that is a member of the local Administrators group, such as the Domain Admins group in a Windows domain. This is the first account that is created when you install an operating system on a new workstation, stand-alone server, or member server. By default, this account has the highest level of administrative access to the local computer.</descrip></descripGrp><ntig><termGrp><term id="157947">administrator account</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1241109">അടങ്ങിയിരിക്കുന്ന അഡ്മിനിസ്ട്രേറ്റര്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="286_616490_1241108"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">On Windows-based computers, a user account that is a member of the computer’s local Administrators group or a member of a group 