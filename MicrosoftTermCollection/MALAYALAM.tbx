l:lang="ml-IN"><ntig><termGrp><term id="2680910">Microsoft Secure Score</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43759_2468787_2471936"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The cloud service that enables customers to generate encryption keys on premises and send them securely to Azure-managed hardware security modules where they can be decrypted and used.</descrip></descripGrp><ntig><termGrp><term id="2468787">BYOK</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2471936">സ്വന്തം കീ ഉപയോഗിക്കുക</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43759_2468787_2471937"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The cloud service that enables customers to generate encryption keys on premises and send them securely to Azure-managed hardware security modules where they can be decrypted and used.</descrip></descripGrp><ntig><termGrp><term id="2468787">BYOK</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2471937">BYOK</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43759_2468788_2471936"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The cloud service that enables customers to generate encryption keys on premises and send them securely to Azure-managed hardware security modules where they can be decrypted and used.</descrip></descripGrp><ntig><termGrp><term id="2468788">Bring Your Own Key</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2471936">സ്വന്തം കീ ഉപയോഗിക്കുക</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43759_2468788_2471937"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The cloud service that enables customers to generate encryption keys on premises and send them securely to Azure-managed hardware security modules where they can be decrypted and used.</descrip></descripGrp><ntig><termGrp><term id="2468788">Bring Your Own Key</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2471937">BYOK</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43761_2469253_2471941"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Word print layout that allows horizontal movement between pages in a document.</descrip></descripGrp><ntig><termGrp><term id="2469253">Page-Stack navigation</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2471941">പേജ്-സ്‌റ്റാക്ക് നാവിഗേഷൻ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43762_2469812_2472777"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Sound that is spatialized or is precisely located around a listener in 3D space. Developers can use spatial sound in an application to convincingly place sounds in a 3D space all around the user. Sounds will then seem as if they are coming from real physical objects even though the user may only be using regular stereo headphones.</descrip></descripGrp><ntig><termGrp><term id="2469812">spatial sound</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2472777">സ്പാഷ്യൽ ശബ്ദം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43768_2470183_2472778"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Technology that enables a 3D graphics processor to display the image at the moment it is rendered for more fluid and better detailed gameplay, and for reducing or eliminating lag, stutter and frame tearing.</descrip></descripGrp><ntig><termGrp><term id="2470183">variable refresh rate</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2472778">വേരിയബിൾ പുതുക്കൽ നിരക്ക്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43768_2470183_2472780"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Technology that enables a 3D graphics processor to display the image at the moment it is rendered for more fluid and better detailed gameplay, and for reducing or eliminating lag, stutter and frame tearing.</descrip></descripGrp><ntig><termGrp><term id="2470183">variable refresh rate</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2472780">VRR</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43768_2470196_2472778"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Technology that enables a 3D graphics processor to display the image at the moment it is rendered for more fluid and better detailed gameplay, and for reducing or eliminating lag, stutter and frame tearing.</descrip></descripGrp><ntig><termGrp><term id="2470196">VRR</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2472778">വേരിയബിൾ പുതുക്കൽ നിരക്ക്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43768_2470196_2472780"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Technology that enables a 3D graphics processor to display the image at the moment it is rendered for more fluid and better detailed gameplay, and for reducing or eliminating lag, stutter and frame tearing.</descrip></descripGrp><ntig><termGrp><term id="2470196">VRR</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2472780">VRR</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43769_2470203_2474804"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office 365 Advanced Threat Protection reporting feature that gives users interactive, personalized visual reports of the threats to their organization, provides context for attacks, and that provides actionable steps for protection.</descrip></descripGrp><ntig><termGrp><term id="2470203">Threat explorer</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2474804">ഭീഷണി എക്‌സ്‌പ്ലോറർ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43799_2470927_2472202"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The lightweight markup language with plain text formatting syntax designed to be converted to HTML and other formats and that is used to format readme files, write messages in online discussion forums, and create rich text using a plain text editor.</descrip></descripGrp><ntig><termGrp><term id="2470927">Markdown</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2472202">Markdown</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43800_2470929_2472203"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Word add-in that converts Markdown documents to Word format for editing and then converts the Word document back to Markdown format, using the Paragraph, Table, List, and Range objects.</descrip></descripGrp><ntig><termGrp><term id="2470929">Markdown editor</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2472203">Markdown editor</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43813_2471611_2477339"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A numerical summary of an organization's security posture based on system configurations, user behavior and other security related measurements that represents the extent to which an organization has adopted security controls in their Microsoft environment which can help offset the risk of being breached.</descrip></descripGrp><ntig><termGrp><term id="2471611">secure score</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2477339