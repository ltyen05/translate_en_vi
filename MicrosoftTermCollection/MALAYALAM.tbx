 type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15641_2772978_2776160"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The "digital persona" by which other users recognize and interact with you.</descrip></descripGrp><ntig><termGrp><term id="2772978">digital identity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2776160">ഡിജിറ്റൽ ഐഡന്റിറ്റി</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15641_2772978_490108"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The "digital persona" by which other users recognize and interact with you.</descrip></descripGrp><ntig><termGrp><term id="2772978">digital identity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="490108">ഐഡന്‍റിറ്റി</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1565_116540_489662"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To halt a process or action, typically without restoring the prior state.</descrip></descripGrp><ntig><termGrp><term id="116540">stop</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="489662">നിറുത്തുക</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15653_187777_1241981"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An endpoint through which an application system exposes or provides a service of some kind.</descrip></descripGrp><ntig><termGrp><term id="187777">provider endpoint</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1241981">ദാതാവ് അവസാനബിന്ദു</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15653_187777_1241982"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An endpoint through which an application system exposes or provides a service of some kind.</descrip></descripGrp><ntig><termGrp><term id="187777">provider endpoint</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1241982">സേവന അവസാനബിന്ദു</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15653_535326_1241981"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An endpoint through which an application system exposes or provides a service of some kind.</descrip></descripGrp><ntig><termGrp><term id="535326">service endpoint</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1241981">ദാതാവ് അവസാനബിന്ദു</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15653_535326_1241982"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An endpoint through which an application system exposes or provides a service of some kind.</descrip></descripGrp><ntig><termGrp><term id="535326">service endpoint</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1241982">സേവന അവസാനബിന്ദു</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15656_233566_1241983"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A change that has been made in one enlistment but has not yet been submitted to the database for publishing and permanent record.</descrip></descripGrp><ntig><termGrp><term id="233566">pending change</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1241983">അവശേഷിക്കുന്ന മാറ്റം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15658_149708_1241984"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A data type that is represented by the type's actual value. If a value type is assigned to a variable, that variable is given a fresh copy of the value. (This is in contrast to a reference type, where assignment does not create a copy.) Value types are usually created on a method's stack frame, rather than in the garbage-collected heap. A value type can be boxed, which is a process that creates a corresponding reference type.</descrip></descripGrp><ntig><termGrp><term id="149708">value type</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1241984">മൂല്യതരം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1567_187416_1241215"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature of the common language runtime, conceptually similar to C++ templates, that allows classes, structures, interfaces, and methods to have placeholders (generic type parameters) for the data types they store and manipulate. Generic types are a form of parameterized types.</descrip></descripGrp><ntig><termGrp><term id="187416">generics</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1241215">ദശാംശസമ്പ്രദായത്തെ സഹായിക്കുന്ന പോളീമോര്‍ഫിസം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1567_537561_1241215"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature of the common language runtime, conceptually similar to C++ templates, that allows classes, structures, interfaces, and methods to have placeholders (generic type parameters) for the data types they store and manipulate. Generic types are a form of parameterized types.</descrip></descripGrp><ntig><termGrp><term id="537561">parametric polymorphism</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1241215">ദശാംശസമ്പ്രദായത്തെ സഹായിക്കുന്ന പോളീമോര്‍ഫിസം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15677_147745_489884"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The order in which changes are propagated from replica to replica. Topology determines how quickly changes in another replica appear in your replica.</descrip></descripGrp><ntig><termGrp><term id="147745">replica set topology</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="489884">ശരിപ്പകര്‍പ്പ് ഗണ ക്രമീകരണരീതി</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15677_147745_490825"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The order in which changes are propagated from replica to replica. Topology determines how quickly changes in another replica appear in your replica.</descrip></descripGrp><ntig><termGrp><term id="147745">replica set topology</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="490825">ക്രമീകരണരീതി</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15677_359275_489884"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The order in which changes are propagated from replica to replica. Topology determines how quickly changes in another replica appear in your replica.</descrip></descripGrp><ntig><termGrp><term id="359275">topology</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="489884">ശരിപ്പകര്‍പ്പ് ഗണ ക്രമീകരണരീതി</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15677_359275_490825"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The order in which changes are propagated from replica to replica. Topology determines how quickly changes in another replica appear in your replica.</descrip></descripGrp><ntig><termGrp><term id="359275">topology</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="490825">ക്രമീകരണരീതി</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15684_35399_489124"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An instruction to a computer program that, when issued by the user, causes an action to be carried out.</descrip></descripGrp><ntig><termGrp><term id="35399">command</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="489124">കമാന്‍ഡ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15689_536051_1241985"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of ASP.NET mobile control that contains other controls and provides visual groupings of controls and content.</descrip></descripGrp><ntig><termGrp><term id="536051">container control</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1241985">കണ്ടെയ്നര്‍ നിയന്ത്രണം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1569_415524_1950772"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tool that converts Visual Basic for Applications macros that are opened or saved in a previous format.</descrip></descripGrp><ntig><termGrp><term id="415524">VBA Converter</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig>