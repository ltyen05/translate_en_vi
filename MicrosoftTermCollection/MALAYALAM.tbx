ove an email into a user's inbox from quarantine.</descrip></descripGrp><ntig><termGrp><term id="2623853">release</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2626208">റിലീസ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46618_2623854_2626207"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A cyber attack where an intruder engages with the targeted system to gather information about vulnerabilities or steal login information.</descrip></descripGrp><ntig><termGrp><term id="2623854">reconnaissance</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2626207">നിരീക്ഷണം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46620_2623856_2624415"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An attack where an attacker attempts to log in into all accounts across a specific domain using only one password, thus avoiding being locked out of any one account.</descrip></descripGrp><ntig><termGrp><term id="2623856">password spray attack</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2624415">പാസ്‌വേഡ് സ്‌പ്രേ ആക്രമണം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</te