</langSet></termEntry><termEntry id="11303_232405_1229759"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The status applied to blocks of time in a user's Calendar to indicate that the user will be away.</descrip></descripGrp><ntig><termGrp><term id="232405">Out of Office</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1229759">ഓഫീസിന് വെളിയില്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11304_18811_488993"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The color against which characters and graphics are displayed.</descrip></descripGrp><ntig><termGrp><term id="18811">background color</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="488993">പശ്ചാത്തല വര്‍ണം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11305_1133783_2770465"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An on/off control within a graphical user interface that when clicked remains "down" (appearing to be pressed) until it is clicked again.</descrip></descripGrp><ntig><termGrp><term id="1133783">sticky button</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2770465">ടോഗിൾ സ്വിച്ച്</term><termNote type="geographica