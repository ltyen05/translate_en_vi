</termEntry><termEntry id="12222_146338_1877832"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A field that is assigned a series orientation in a PivotChart report. In a chart, series are represented in the legend.</descrip></descripGrp><ntig><termGrp><term id="146338">PivotChart series field</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1877832">PivotChart ശ്രേണി ഫീല്‍ഡ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12227_237787_1241775"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A condition where users believe that a feature does not meet the expectations set by the market, competitors, previous experiences, or promises.</descrip></descripGrp><ntig><termGrp><term id="237787">feature dissatisfaction</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1241775">അസംതൃപ്തമായ വിശേഷത</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1223_147636_1877841"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A link that uses a relative URL.</descrip></descripGrp><ntig><termGrp><term id="147636">relative link</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1877841">റിലേറ്റീവ് ലിങ്ക്</term><termNote type