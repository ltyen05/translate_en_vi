">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2703300">ഭീഷണി മാനേജുമെന്റ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="47930_2701275_2703298"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An email whose purpose is to scam users, steal their data, or take control of their devices.</descrip></descripGrp><ntig><termGrp><term id="2701275">malicious mail</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2703298">ക്ഷുദ്ര മെയിൽ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="47932_2701277_2703301"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office 365 Security &amp; Compliance Center feature that allows admins to track ongoing security problems and campaigns as well as general trends and queries.</descrip></descripGrp><ntig><termGrp><term id="2701277">Threat tracker</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2703301">ഭീഷണി ട്രാക്കർ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id=