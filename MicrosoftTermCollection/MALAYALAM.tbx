</termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1878017">കോഡ് പാളി</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17814_650174_1878018"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A keyword or phrase with an associated color that helps you keep track of items, such as messages, contacts, and appointments. You can use color categories to easily find, sort, filter, or group items.</descrip></descripGrp><ntig><termGrp><term id="650174">color category</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1878018">വര്‍ണ്ണ വിഭാഗം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17815_650175_1878019"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The part of PivotTable view that contains column fields.</descrip></descripGrp><ntig><termGrp><term id="650175">column area</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1878019">നിര ഏരിയ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17816_1507691_1229365"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A supplemental program with the filename extension .dll or .exe that extends the capabilities of a program by adding custom commands and specialized features.</descrip></descripGrp><ntig><termGrp><term id="1507691">Component Object Model add-in</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1229365">COM ആഡ്-ഇന്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17816_650176_1229365"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A supplemental program with the filename extension .dll or .exe that extends the capabilities of a program by adding custom commands and specialized features.</descrip></descripGrp><ntig><termGrp><term id="650176">COM add-in</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1229365">COM ആഡ്-ഇന്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1782_130364_2632128"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The representation of information and data in the form of an image, diagram, or animation. For example, some databases can interpret and show data in the form of a two- or three-dimensional model.</descrip></descripGrp><ntig><termGrp><term id="130364">visualization</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2632128">ഡാറ്റ ദൃശ്യവൽക്കരണം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1782_2396693_2632128"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The representation of information and data in the form of an image, diagram, or animation. For example, some databases can interpret and show data in the form of a two- or three-dimensional model.</descrip></descripGrp><ntig><termGrp><term id="2396693">visual</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2632128">ഡാറ്റ ദൃശ്യവൽക്കരണം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1782_2626823_2632128"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The representation of information and data in the form of an image, diagram, or animation. For example, some databases can interpret and show data in the form of a two- or three-dimensional model.</descrip></descripGrp><ntig><termGrp><term id="2626823">data visualization</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2632128">ഡാറ്റ ദൃശ്യവൽക്കരണം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17823_650183_1229366"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A format, such as cell shading or font color, that Excel automatically applies to cells if a specified condition is true.</descrip></descripGrp><ntig><termGrp><term id="650183">conditional format</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1229366">സോപാധികഫോര്‍മാറ്റ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17826_650186_1229367"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The type of Web Part connection. For example, the Provide Row To connection type passes a row of data from one Web Part to another Web Part.</descrip></descripGrp><ntig><termGrp><term id="650186">connection type</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1229367">കണക്ഷന്‍ ഇനം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17827_650187_1878020"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A view of an individual contact that contains all the information stored in the contact.</descrip></descripGrp><ntig><termGrp><term id="650187">contact form</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1878020">കോണ്‍‌ടാക്റ്റ് ഫോം</term><termNote type="geographicalUsage">IND</