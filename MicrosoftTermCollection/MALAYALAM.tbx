e type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31651_1608229_1878296"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Visio-based design surface that enables users to create and edit workflows visually by manipulating shapes that represent actions and conditions.</descrip></descripGrp><ntig><termGrp><term id="1608229">Visual Designer</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1878296">വിഷ്വല്‍ ഡിസൈനര്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31659_1608235_1775590"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The name of a product in the store that appears to customers. To the end user, this is the name of the product.</descrip></descripGrp><ntig><termGrp><term id="1608235">app name</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1775590">പ്രയോഗ നാമം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31660_1608236_2242588"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file that contains the app manifest, executable files, text and image resource files, and other files that make up the app for a single platform.</descrip></descripGrp><ntig><termGrp><term id="1608236">app package</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2242588">ആപ് പാക്കേജ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31663_1608239_1775591"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Collected data about an app, such as analytics of download, usage, in-application transaction, customer ratings provided by the Windows Store developer portal. This type of information helps developers clearly understand how their applications are doing in the Windows market.</descrip></descripGrp><ntig><termGrp><term id="1608239">App Summary</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1775591">പ്രയോഗ സംഗ്രഹം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31664_1608240_1640446"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Windows Store service that enables end users to update apps one at a time or all at the same time for all apps purchased through the Windows Store.</descrip></descripGrp><ntig><termGrp><term id="1608240">App Update</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1640446">പ്രയോഗം കാലികമാക്കല്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSe