ific currency.</descrip></descripGrp><ntig><termGrp><term id="41397">currency symbol</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="489169">നാണയ മുദ്ര</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13405_94512_489567"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">One or more fields that uniquely identify each record in a table.</descrip></descripGrp><ntig><termGrp><term id="94512">primary key</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="489567">പ്രൈമറി കീ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13407_121010_1877754"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The way text is displayed in a document, how it behaves and breaks according to settings.</descrip></descripGrp><ntig><termGrp><term id="121010">text flow</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1877754">ടെക്‌സ്റ്റ് ഫ്ലോ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13408_299899_490452"><langSet xml:lang="en-US"><descripGrp><descri