rmGrp><term id="320022">MTE</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1961135">MTE</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3838_47370_489226"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A toolbar that is attached to one edge of the program window. When you drag a toolbar below the program title bar or to the left, right, or bottom edge of the window, the toolbar snaps into place on the edge of the program window.</descrip></descripGrp><ntig><termGrp><term id="47370">docked toolbar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="489226">ഡോക്ക് ചെയ്യപ്പെട്ട ഉപകരണബാര്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38399_2223248_2234882"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Sway Design feature that allows users to change the navigation and layout model of a particular Sway document.</descrip></descripGrp><ntig><termGrp><term id="2223248">Structure</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2234882">ഘടന</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38416_2226110_2232264"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The service that is installed as part of the MultiPoint role on server and ensures that some MultiPoint configuration settings remain set to keep Windows MultiPoint Server running smoothly.</descrip></descripGrp><ntig><termGrp><term id="2226110">Windows MultiPoint Server Repair Service</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2232264">Windows MultiPoint Server റിപ്പെയർ സേവനം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38418_2226112_2232231"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in the Messaging app that detects whether an SMS message is spam, based on its content.</descrip></descripGrp><ntig><termGrp><term id="2226112">smart blocking</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2232231">സ്മാർട്ട് തടയൽ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38419_2227157_2232194"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A keypad that is available in Programmer mode, which allows the user to look at numbers represented as various combinations of 1s and 0s, and to toggle between 1 and 0 for each binary bit to form a new number.</descrip></descripGrp><ntig><termGrp><term id="2227157">bit toggling keypad</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2232194">ബിറ്റ് ടോഗ്ലിംഗ് കീപാഡ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38420_2227158_2232206"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of thematically related apps, games, music tracks, videos, or other items available for purchase or download in the Store. A thematic group of editorially chosen apps and games for merchandising or marketing purposes.</descrip></descripGrp><ntig><termGrp><term id="2227158">Collection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2232206">ശേഖരം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38421_2227159_2232210"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows the user to select a color and increase or decrease the vibrancy of that color in an image.</descrip></descripGrp><ntig><termGrp><term id="2227159">color boost</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2232210">കളർ ബൂസ്റ്റ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38422_2227160_2791372"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The menu invoked with a shortcut key (Windows + G) when gaming that allows users to take a screenshot, take a 30 second clip of a game, and adjust volume controls.</descrip></descripGrp><ntig><termGrp><term id="2227160">Game Bar</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2791372">Game Bar</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38423_2227161_2232223"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The platform on which the operating system runs on form factors other than PCs, tablets, and phones.</descrip></descripGrp><ntig><termGrp><term id="2227161">IoT</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2232223">IoT</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38423_2227161_2269496"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The platform on which the operating system runs on form factors other than PCs, tablets, and phones.</descrip></descripGrp><ntig><termGrp><term id="2227161">IoT</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2269496">ഇന്റെർനെറ്റ് ഓഫ് തിംഗ്സ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38423_2268355_2232223"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The platform on which the operating system runs on form factors other than PCs, tablets, and phones.</descrip></descripGrp><ntig><termGrp><term id="2268355">Internet of Things</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2232223">IoT</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38423_2268355_2269496"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The platform on which the operating system runs on form factors other than PCs, tablets, and phones.</descrip></descripGrp><ntig><termGrp><term id="2268355">Internet of Things</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2269496">ഇന്റെർനെറ്റ് ഓഫ് തിംഗ്സ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38424_2227162_2232227"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A broad set of all the user's local and cloud-based content, including documents, apps, settings, photos, videos, music, and email.  Cortana or Bing can search this content and return it in search results.</descrip></descripGrp><ntig><termGrp><term id="2227162">my stuff</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2232227">എന്‍റെ സ്റ്റഫ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38426_2227164_2232236"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A note, handwritten or typed, that can be added by the user directly on webpages from within the browser.</descrip></descripGrp><ntig><termGrp><term id="2227164">Web Note</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2232236">വെബ് നോട്ട്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38427_2227165_2232239"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The edition of Windows 10 available through volume licensing, that is designed for education institutions, and includes all of the features of Windows 10 Pro, plus some other features like virtualization, management, DirectAccess, and BranchCache.</descrip></descripGrp><ntig><termGrp><term id="2227165">Windows 10 Education</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2232239">Windows 10 Education</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38428_2227166_2232242"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The edition of Windows 10 that is available only through volume licensing, is designed for businesses, and includes all of the features of Windows 10 Pro, plus some other features like virtualization, management, DirectAccess, and BranchCache.</descrip></descripGrp><ntig><termGrp><term id="2227166">Windows 10 Enterprise</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2232242">Windows 10 Enterprise</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38429_2227167_2232246"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The edition of Windows 10 designed for HoloLens.</descrip></descripGrp><ntig><termGrp><term id="2227167">Windows 10 Holographic</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2232246">Windows 10 Holographic</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38430_2227168_2232249"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The edition of Windows 10 designed for home users.</descrip></descripGrp><ntig><termGrp><term id="2227168">Windows 10 Home</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2232249">Windows 10 Home</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38431_2227169_2232254"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The edition of Windows 10 optimized for fixed function IoT devices.</descrip></descripGrp><ntig><termGrp><term id="2227169">Windows 10 IoT Core</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2232254">Windows 10 IoT Core</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38432_2227170_2232256"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The edition of Windows 10 for a range of powerful IoT devices that provides granular lockdown capabilities, Win32 and modern app support.</descrip></descripGrp><ntig><termGrp><term id="2227170">Windows 10 IoT Enterprise</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2232256">Windows 10 IoT Enterprise</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38434_2227172_2232336"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The edition of Windows 10 designed to run on mobile devices.</descrip></descripGrp><ntig><termGrp><term id="2227172">Windows 10 Mobile</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2232336">Windows 10 Mobile</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38435_2227173_2232338"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Enterprise edition of Windows 10 for mobile phones.</descrip></descripGrp><ntig><termGrp><term id="2227173">Windows 10 Mobile Enterprise</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2232338">Windows 10 Mobile Enterprise</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38436_2227174_2232261"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The edition of Windows 10 designed for enthusiasts and businesses that includes the features of Home edition while also allowing an organization to manage the device, set policies, control encryption, control updates, and login remotely.</descrip></descripGrp><ntig><termGrp><term id="2227174">Windows 10 Pro</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2232261">Windows 10 Pro</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38437_2227175_2232221"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft technology that provides access to Windows devices using biometric authentication or a PIN.</descrip></descripGrp><ntig><termGrp><term id="2227175">Windows Hello</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2232221">Hello</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38437_2227175_2232263"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft technology that provides access to Windows devices using biometric authentication or a PIN.</descrip></descripGrp><ntig><termGrp><term id="2227175">Windows Hello</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2232263">Windows Hello</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><