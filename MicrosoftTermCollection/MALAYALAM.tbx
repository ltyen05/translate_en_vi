</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="488864">ചെറുതാക്കുക</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14523_360144_490843"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A window that displays the SQL statement for the current query or that is used to create an SQL-specific query (union, pass-through, or data definition). When you create a query in Design view, Access constructs the SQL equivalent in SQL view.</descrip></descripGrp><ntig><termGrp><term id="360144">SQL view</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="490843">SQL കാഴ്ച</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14526_360146_490845"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A query that asks a question about the data stored in your tables and returns a result set in the form of a datasheet, without changing the data.</descrip></descripGrp><ntig><termGrp><term id="360146">select query</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="490845">തിരയല്‍ ചോദ്യം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14528_276550_1995121"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A single location in Windows where you can adjust mobile PC settings.</descrip></descripGrp><ntig><termGrp><term id="276550">Windows Mobility Center</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1995121">Windows മൊബിലിറ്റി കേന്ദ്രം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14533_188005_1241912"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type that is referenced in a project and that IntelliSense and the C# compiler cannot match to a declaration.</descrip></descripGrp><ntig><termGrp><term id="188005">unbound type</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1241912">സ്വതന്ത്ര തരം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14534_21247_489013"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file that contains encoded information that is interpreted according to the application that created it. In general, a binary file can be edited only by the application in which it was created.</descrip></descripGrp><ntig><termGrp><term id="21247">binary file</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="489013">ബൈനറി ഫയല്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14540_373951_1425545"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An interactive technology in Microsoft Excel or Access that can show dynamic views of the same data from a list or a database.</descrip></descripGrp><ntig><termGrp><term id="373951">Microsoft PivotTable</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1425545">PivotTable</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14540_373952_1425545"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An interactive technology in Microsoft Excel or Access that can show dynamic views of the same data from a list or a database.</descrip></descripGrp><ntig><termGrp><term id="373952">PivotTable</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1425545">PivotTable</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14543_231973_490119"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Microsoft Office Web Component that allows you to create a structure similar to an Excel PivotTable report. Users can view the PivotTable list in a Web browser and change its layout in a manner similar to an Excel PivotTable report.</descrip></descripGrp><ntig><termGrp><term id="231973">PivotTable list</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="490119">PivotTable ലിസ്റ്റ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14555_95472_2688604"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To cue the user that the system is requesting input or action.</descrip></descripGrp><ntig><termGrp><term id="95472">prompt</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2688604">പ്രോം‍പ്റ്റ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14562_318120_490581"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The button on your pointing device that you use to display shortcut menus or other program-specific features.</descrip></descripGrp><ntig><termGrp><term id="318120">right mouse button</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="490581">വലതു മൌസ് ബട്ടണ്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14563_188073_1241914"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SQL Server 2005 feature that provides the ability to have more than one pending request per connection, in particular to have more than one default result set open per connection. SQL Server 2000 and earlier restricted the programming model such that at any point in time there would be at most one pending request on a given session, blocking the driver from sending requests to the server until the entire result set is consumed.</descrip></descripGrp><ntig><termGrp><term id="188073">multiple active result set</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1241914">MARS</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14563_188073_1772475"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SQL Server 2005 feature that provides the ability to have more than one pending request per connection, in particular to have more than one default result set open per connection. SQL Server 2000 and earlier restricted the programming model such that at any point in time there would be at most one pending request on a given session, blocking the driver from sending requests to the server until the entire result set is consumed.</descrip></descripGrp><ntig><termGrp><term id="188073">multiple active result set</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1772475">നിരവധി സജീവ ഫലം സജ്ജീകരിക്കല്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14563_188074_1241914"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SQL Server 2005 feature that provides the ability to have more than one pending request per connection, in particular to have more than one default result set open per connection. SQL Server 2000 and earlier restricted the programming model such that at any point in time there would be at most one pending request on a given session, blocking the driver from sending requests to the server until the entire result set is consumed.</descrip></descripGrp><ntig><termGrp><term id="188074">MARS</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1241914">MARS</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14563_188074_1772475"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SQL Server 2005 feature that provides the ability to have more than one pending request per connection, in particular to have more than one default result set open per connection. SQL Server 2000 and earlier restricted the programming model such that at any point in time there would be at most one pending request on a given session, blocking the driver from sending requests to the server until the entire result set is consumed.</descrip></descripGrp><ntig><termGrp><term id="188074">MARS</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1772475">നിരവധി സജീവ ഫലം സജ്ജീകരിക്കല്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14564_20028_1241915"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A class from which other classes are derived by inheritance.</descrip></descripGrp><ntig><termGrp><term id="20028">base class</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1241915">അടിസ്ഥാനക്ലാസ്സ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14564_2505152_1241915"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A class from which other classes are derived by inheritance.</descrip></descripGrp><ntig><termGrp><term id="2505152">root class</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1241915">അടിസ്ഥാനക്ലാസ്സ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14574_123914_1229794"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Confidence in the reliability of an entity or service and the information that it provides.</descrip></descripGrp><ntig><termGrp><term id="123914">trust</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1229794">വിശ്വാസം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14579_60118_489317"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user interface control that facilitates modification of an object's appearance, position, or behavior.</descrip></descripGrp><ntig><termGrp><term id="60118">handle</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="489317">കൈകാര്യംചെയ്യല്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14584_358355_1960987"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A technology that ensures that a mobile device automatically retrieves new email from the Microsoft Exchange server. Direct Push uses a longstanding HTTPS connection that is maintained by the mobile device to push new email messages, Calendar, Contacts, and Tasks notifications from the server to the device.</descrip></descripGrp><ntig><termGrp><term id="358355">Direct Push</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1960987">ഡയറക്‌ട് പുഷ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14585_329892_490721"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A change to an account to correct or update the balance.</descrip></descripGrp><ntig><termGrp><term id="329892">adjustment</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="490721">ക്രമീകരണം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14597_233561_1241916"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A template used to manage the conditions under which a single solution or a set of solutions will be built.</descrip></descripGrp><ntig><termGrp><term id="233561">build type</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1241916">ബില്‍ഡ് തരം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14606_211370_490058"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The date by which some task or action should be completed.</descrip></descripGrp><ntig><termGrp><term id="211370">due date</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="490058">നിയുക്ത ദിവസം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14609_183539_2463762"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An artificial intelligence program that performs a task on a network as an agent for a user or another program.</descrip></descripGrp><ntig><termGrp><term id="183539">bot</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2463762">ബോട്ട്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14609_183540_2463762"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An artificial intelligence program that performs a task on a network as an agent for a user or another program.</descrip></descripGrp><ntig><termGrp><term id="183540">robot</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2463762">ബോട്ട്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14610_25574_489037"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A graphic element that appears similar to a physical button or keyboard key in the UI. A button is "pressed" by clicking on it with a mouse, by hitting ENTER or RETURN on the keyboard (if the button has the focus) or tapping by a finger.</descrip></descripGrp><ntig><termGrp><term id="25574">button</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="489037">ബട്ടണ്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14611_123792_1229795"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An automated tool that helps find and fix specific problems on your computer.</descrip></descripGrp><ntig><termGrp><term id="123792">troubleshooter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1229795">ട്രബിള്‍ഷൂട്ടര്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14612_73965_489412"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The key on the keyboard that is labeled with a left arrow.</descrip></descripGrp><ntig><termGrp><term id="73965">left arrow</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="489412">ഇടത് അമ്പ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14617_93343_489557"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of industry-standard framing and authentication protocols that are included with Windows to ensure interoperability with other remote access software. PPP negotiates configuration parameters for multiple layers of the Open Systems Interconnection (OSI) model. The Internet standard for serial communications, PPP defines how data packets are exchanged with other Internet-based systems using a modem connection. PPP is documented in RFC 1661.</descrip></descripGrp><ntig><termGrp><term id="93343">Point-to-Point Protocol</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="489557">പോയിന്‍റ്-ടു-പോയിന്‍റ് പ്രോട്ടോക്കോള്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14617_93343_489558"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of industry-standard framing and authentication protocols that are included with Windows to ensure interoperability with other remote access software. PPP negotiates configuration parameters for multiple layers of the Open Systems Interconnection (OSI) model. The Internet standard for serial communications, PPP defines how data packets are exchanged with other Internet-based systems using a modem connection. PPP is documented in RFC 1661.</descrip></descripGrp><ntig><termGrp><term id="93343">Point-to-Point Protocol</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="489558">PPP</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammatica