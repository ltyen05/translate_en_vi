Entry id="1682_114990_1877746"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An array (arrangement of items) in which many of the entries are identical, commonly zero. It is not possible to define precisely when an array is sparse, but it is clear that at some point, usually when about one-third of the array consists of identical entries, it becomes worthwhile to redefine the array.</descrip></descripGrp><ntig><termGrp><term id="114990">sparse array</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1877746">ചിതറിക്കിടക്കുന്ന അറേ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16823_619890_1242086"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A font effect in which lowercase text appears as capital letters in a font size that is even smaller than small caps.</descrip></descripGrp><ntig><termGrp><term id="619890">petite caps</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1242086">പെറ്റൈറ്റ് വലിയക്ഷരങ്ങള്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16823_619892_1242086"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A font effect in which lowercase text appears as capital letters in a font size that is even smaller than small caps.</descrip></descripGrp><ntig><termGrp><term id="619892">petite capitals</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1242086">പെറ്റൈറ്റ് വലിയക്ഷരങ്ങള്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16829_2460878_1369481"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of user account that allows complete access to the computer or program. Administrators can make any desired changes. This account type is not recommended for daily use, and should only be used when necessary.</descrip></descripGrp><ntig><termGrp><term id="2460878">admin account</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1369481">അഡ്മിനിസ്ട്രേറ്റര്‍ അക്കൌണ്ട്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16829_621421_1369481"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of user account that allows complete access to the computer or program. Administrators can make any desired changes. This account type is not recommended for daily use, and should only be used when necessary.</descrip></descripGrp><ntig><termGrp><term id="621421">administrator account</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1369481">അഡ്മിനിസ്ട്രേറ്റര്‍ അക്കൌണ്ട്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1685_42287_3025526"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of creating a link between a property and a source. The source can be local or external.</descrip></descripGrp><ntig><termGrp><term id="42287">data binding</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="3025526">ഡാറ്റ ബൈൻഡിംഗ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1685_494335_3025526"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of creating a link between a property and a source. The source can be local or external.</descrip></descripGrp><ntig><termGrp><term id="494335">binding</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="3025526">ഡാറ്റ ബൈൻഡിംഗ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1686_90627_1230025"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A distinct chunk of text that is indicated by formatting such as indentation, numbering, or a new line.</descrip></descripGrp><ntig><termGrp><term id="90627">paragraph</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1230025">ഖണ്ഡിക</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1688_74871_1228916"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In word processing, a string of characters displayed or printed in a single horizontal row.</descrip></descripGrp><ntig><termGrp><term id="74871">line</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1228916">ലൈന്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16907_627846_1425553"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The date when a project or task is scheduled to begin.</descrip></descripGrp><ntig><termGrp><term id="627846">begin date</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1425553">ആരംഭ തീയതി</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16907_627847_1425553"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The date when a project or task is scheduled to begin.</descrip></descripGrp><ntig><termGrp><term id="627847">start date</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1425553">ആരംഭ തീയതി</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16924_629472_1960976"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The name automatically assigned to an object by a program or process when the user does not specify an alternative.</descrip></descripGrp><ntig><termGrp><term id="629472">default name</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1960976">സ്ഥിരസ്ഥിതി നാമം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16927_629486_1960981"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user-defined description of a particular device.</descrip></descripGrp><ntig><termGrp><term id="629486">device name</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1960981">ഉപകരണ നാമം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16930_2737154_2754929"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The administrator account that can manage all aspects of the Exchange product.</descrip></descripGrp><ntig><termGrp><term id="2737154">Exchange service administrator</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2754929">Exchange അഡ്‌മിനിസ്‌ട്രേറ്റർ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16930_629571_2754929"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The administrator account that can manage all aspects of the Exchange product.</descrip></descripGrp><ntig><termGrp><term id="629571">Exchange administrator</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2754929">Exchange അഡ്‌മിനിസ്‌ട്രേറ്റർ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1695_397155_1961019"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A hidden item that contains information about an event sink, information about what events will trigger the event sink, and options that tell when or under what conditions the event sink will be triggered. The event registration item is created in the same folder that is being monitored for events.</descrip></descripGrp><ntig><termGrp><term id="397155">event registration item</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1961019">ഇവന്‍റ് രജിസ്‌ട്രേഷന്‍ ഇനം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16957_629941_1960955"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A dialog box in which a user confirms that he or she wants a specified action to occur, usually by clicking OK.</descrip></descripGrp><ntig><termGrp><term id="629941">confirmation dialog box</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1960955">സ്ഥിരീകരണ ഡയലോഗ് ബോക്‌സ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16959_629943_1242087"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A DBMS (database management system) designed to be run in a client/server environment. These DBMS provide a stand-alone database engine that provides rich support for SQL and transactions. They are accessed through DBMS-based drivers. For example, Oracle, Informix, DB/2, or Microsoft SQL Server.</descrip></descripGrp><ntig><termGrp><term id="629943">database server</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1242087">ഡാറ്റാ ബേസ് സെര്‍വര്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16960_629944_1961007"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A three-digit string of numbers, such as 5.1.2., that indicates the status of an attempt to deliver an email message.</descrip></descripGrp><ntig><termGrp><term id="629944">DSN code</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1961007">DSN കോഡ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16962_629946_1961009"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The value that is applied to a specific DWORD.</descrip></descripGrp><ntig><termGrp><term id="629946">DWORD value</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1961009">DWORD മൂല്യം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16963_629993_1878008"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A unique view for displaying appointments, tasks, and other information in the form of a Web page. You can customize the Outlook Today page for your organization, or for individuals or groups within your organization, to display the information most relevant to them.</descrip></descripGrp><ntig><termGrp><term id="629993">Outlook Today</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1878008">Outlook Today</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16967_636292_1242088"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A LINQ query that is not evaluated until it is iterated over, either with a foreach statement (C#) or a For Each statement (Visual Basic), or by manually using the underlying GetEnumerator and MoveNext methods.</descrip></descripGrp><ntig><termGrp><term id="636292">deferred query</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1242088">വൈകിയ അന്വേഷണം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16968_636294_1242089"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The clause that introduces a data source and a range variable in a query expression.</descrip></descripGrp><ntig><termGrp><term id="636294">From clause</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1242089">ഉപവാക്യത്തില്‍ നിന്ന്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16969_636298_1242090"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A LINQ query that is evaluated immediately. Any query that returns a single value, as opposed to a sequence of values, or that is terminated by a call to ToList, ToArray, ToDictionary, or ToLookup.</descrip></descripGrp><ntig><termGrp><term id="636298">immediate query</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1242090">തൊട്ടടുത്ത അന്വേഷണം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16972_636303_1241763"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The set of standard query operators that is available in all LINQ queries, and the rules that define the structure of a LINQ query.</descrip></descripGrp><ntig><termGrp><term id="636303">query pattern</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1241763">LINQ മാതൃക</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16972_636303_1242091"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The set of standard query operators that is available in all LINQ queries, and the rules that define the structure of a LINQ query.</descrip></descripGrp><ntig><termGrp><term id="636303">query pattern</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1242091">അന്വേഷണമാതൃക</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16972_636304_1241763"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The set of standard query operators that is available in all LINQ queries, and the rules that define the structure of a LINQ query.</descrip></descripGrp><ntig><termGrp><term id="636304">LINQ pattern</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1241763">LINQ മാതൃക</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16972_636304_1242091"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The set of standard query operators that is available in all LINQ queries, and the rules that define the structure of a LINQ query.</descrip></descripGrp><ntig><termGrp><term id="636304">LINQ pattern</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1242091">അന്വേഷണമാതൃക</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16973_636305_1241764"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A technology that makes it possible to query over any enumerable object in ADO.NET by using the LINQ programming model. LINQ to ADO.NET consists of three related LINQ technologies: LINQ to DataSet, LINQ to SQL, and LINQ to Entities.</descrip></descripGrp><ntig><termGrp><term id="636305">LINQ to ADO.NET</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1241764">LINQ to ADO.NET</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16974_636306_1241765"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A LINQ technology that makes it easier and faster to query over data cached in a DataSet object. The queries are expressed in the programming language itself and not as string literals embedded in the application code.</descrip></descripGrp><ntig><termGrp><term id="636306">LINQ to DataSet</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1241765">LINQ ഡാറ്റാസെറ്റിലേക്ക്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16975_636307_1241766"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A LINQ technology that enables developers to create flexible, strongly typed queries against the Entity Framework by using LINQ expressions and the LINQ Standard Query Operators.</descrip></descripGrp><ntig><termGrp><term id="636307">LINQ to Entities</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1241766">LINQ സ്വത്വത്തിലേക്ക്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16976_636308_1241767"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The use of LINQ to query in-memory data such as arrays and lists.</descrip></descripGrp><ntig><termGrp><term id="636308">LINQ to Objects</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1241767">LINQ ഓബ്ജറ്റിലേക്ക്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16977_636309_1241768"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A LINQ technology that provides a run-time infrastructure for managing relational data as objects. In LINQ to SQL, the data model of a relational database is mapped to an object model expressed in the programming language of the developer.</descrip></descripGrp><ntig><termGrp><term id="636309">LINQ to SQL</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1241768">LINQ to SQL</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16978_636310_1242092"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An in-memory programming interface that makes it possible to work with XML from within the .NET Framework programming languages.</descrip></descripGrp><ntig><termGrp><term id="636310">LINQ to XML</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1242092">LINQ to XML</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16979_636311_1242093"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process in which the compiler infers the type of a local variable that is declared with the var keyword in C# or without an As clause in Visual Basic. The compiler infers the type of the variable from the type of the initializer expression.</descrip></descripGrp><ntig><termGrp><term id="636311">local type inference</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1242093">പ്രാദേശികതര നിഗമനം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16980_636312_1242094"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A query expressed as a direct method call to one or more Standard Query Operators.</descrip></descripGrp><ntig><termGrp><term id="636312">method-based query</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1242094">രീതി അടിസ്ഥാന അന്വേഷണം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16981_636313_1242095"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ability to target code to specific versions (for example, 2.0, 3.5, 4, or 4.5) of the .NET Framework.</descrip></descripGrp><ntig><termGrp><term id="636313">multitargeting</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1242095">മള്‍ട്ടി ലക്ഷ്യംചെയ്യല്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16982_636314_1242096"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tool that provides a visual design surface for creating LINQ to SQL entity classes and associations (relationships) based on objects in a database. The Object Relational Designer also provides functionality to map stored procedures and functions to System.Data.Linq.DataContext methods for returning data and manipulating entity classes.</descrip></descripGrp><ntig><termGrp><term id="636314">Object Relational Designer</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1242096">O/R ഡിസൈനര്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16982_636315_1242096"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tool that provides a visual design surface for creating LINQ to SQL entity classes and associations (relationships) based on objects in a database. The Object Relational Designer also provides functionality to map stored procedures and functions to System.Data.Linq.DataContext methods for returning data and manipulating entity classes.</descrip></descripGrp><ntig><termGrp><term id="636315">O/R Designer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1242096">O/R ഡിസൈനര്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16984_636759_1242097"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The selection in a query of a subset of the properties or columns in the data source.</descrip></descripGrp><ntig><termGrp><term id="636759">projection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1242097">പ്രൊജക്ഷന്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16986_636885_1242098"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The C# =&gt; operator that is used to separate the parameters and the body of a lambda expression.</descrip></descripGrp><ntig><termGrp><term id="636885">lambda operator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1242098">ലാംഡ ഓപ്പറേറ്റര്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16987_636889_1242099"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A contextual keyword in C# and Visual Basic that designates the query clause of a query expression. For example, from, join, and select are query keywords in C#, and From, Join, and Select are query keywords in Visual basic.</descrip></descripGrp><ntig><termGrp><term id="636889">query keyword</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1242099">അന്വേഷണ കീവേര്‍ഡ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16988_636890_1242100"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A variable that stores a query, as opposed to the results of a query.</descrip></descripGrp><ntig><termGrp><term id="636890">query variable</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1242100">അന്വേഷണ വേരിയബിള്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16990_636901_1242101"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The type of the query variable in a LINQ query. The type of the variable that represents the data source is also a queryable type. A queryable type can be implicitly or explicitly typed, but in either case it must be a generic IEnumerable or IQueryable type.</descrip></descripGrp><ntig><termGrp><term id="636901">queryable type</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1242101">അന്വേഷണാത്മക തരം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16991_636903_1242102"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The pop-up window that displays the complete declaration for an identifier when the pointer rests on the identifier in a code editor window.</descrip></descripGrp><ntig><termGrp><term id="636903">Quick Info tooltip</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1242102">ദ്രുത ഇന്‍ഫോ ഉപകരണടിപ്പുകള്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16995_636997_1242103"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A single clause of a query expression. There are several different query clauses, each identified by its initiating query keyword. For instance, the "from/From clause" refers to clauses like "From c In customers" in Visual Basic, or "from c in customers" in C#.</descrip></descripGrp><ntig><termGrp><term id="636997">query clause</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1242103">ഉപവാക്യ അന്വേഷണം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="170_502935_1229859"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A part of the user interface dedicated to a particular purpose, such as "instant message area."</descrip></descripGrp><ntig><termGrp><term id="502935">area</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1229859">ഏരിയ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1700_122674_1425493"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of viewing and updating the actual progress of tasks so that you can see progress across time, evaluate slippage of tasks, compare scheduled or baseline data to actual data, and check the completion percentage of tasks and your project.</descrip></descripGrp><ntig><termGrp><term id="122674">tracking</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1425493">ട്രാക്ക്ചെയ്യല്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1701_130254_1805328"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The programming language designed at Microsoft that was derived from BASIC and that was designed to enable the easy development of visual applications and components in Windows.</descrip></descripGrp><ntig><termGrp><term id="130254">Visual Basic</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1805328">Visual Basic</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1701_370712_1805328"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The programming language designed at Microsoft that was derived from BASIC and that was designed to enable the easy development of visual applications and components in Windows.</descrip></descripGrp><ntig><termGrp><term id="370712">VB</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1805328">Visual Basic</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17010_638614_1242104"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In ASP.NET, built-in functionality for common application tasks. ASP.NET includes application services for authentication (ASP.NET membership), persistent per-user information (profile properties), and more.</descrip></descripGrp><ntig><termGrp><term id="638614">application service</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1242104">പ്രയോഗസേവനം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17011_638615_1242105"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The layer of AJAX functionality that takes care of communication between the browser and the server.</descrip></descripGrp><ntig><termGrp><term id="638615">asynchronous communication layer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1242105">സമയബന്ധിതമല്ലാത്ത ആശയവിനിമയപടലം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17014_638618_1242106"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Windows-based applications, built-in functionality to access ASP.NET application services for common application tasks, including remote login, roles, and application settings.</descrip></descripGrp><ntig><termGrp><term id="638618">client application service</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1242106">ക്ലയന്‍റ് പ്രയോഗസേവനം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17015_638624_1242107"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In ASP.NET, a control that encapsulates functionality that is implemented in JavaScript and that defines behavior in the browser. Extender controls are associated with existing Web server controls to add the extender's behavior to that control. For example, an extender control can add a watermark to any TextBox control or drag-and-drop behavior to a variety of ASP.NET Web server controls.</descrip></descripGrp><ntig><termGrp><term id="638624">extender control</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1242107">എക്സ്റ്റന്‍റഡര്‍ നിയന്ത്രണം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17015_640460_1242107"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In ASP.NET, a control that encapsulates functionality that is implemented in JavaScript and that defines behavior in the browser. Extender controls are associated with existing Web server controls to add the extender's behavior to that control. For example, an extender control can add a watermark to any TextBox control or drag-and-drop behavior to a variety of ASP.NET Web server controls.</descrip></descripGrp><ntig><termGrp><term id="640460">extender</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1242107">എക്സ്റ്റന്‍റഡര്‍ നിയന്ത്രണം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17016_1230087_1242108"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application service such as authentication, profile properties, or roles, that can be accessed by any non-ASP.NET application that can read and send messages in SOAP format. WCF services enable different types of applications to share common data, such as user credentials for logging in.</descrip></descripGrp><ntig><termGrp><term id="1230087">WCF service</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1242108">Windows ആശയവിനിമയ ആധാര പ്രയോഗ സേവനം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17016_1230087_2046487"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application service such as authentication, profile properties, or roles, that can be accessed by any non-ASP.NET application that can read and send messages in SOAP format. WCF services enable different types of applications to share common data, such as user credentials for logging in.</descrip></descripGrp><ntig><termGrp><term id="1230087">WCF service</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2046487">WCF സേവനം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17016_638625_1242108"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application service such as authentication, profile properties, or roles, that can be accessed by any non-ASP.NET application that can read and send messages in SOAP format. WCF services enable different types of applications to share common data, such as user credentials for logging in.</descrip></descripGrp><ntig><termGrp><term id="638625">Windows Communication Foundation application service</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1242108">Windows ആശയവിനിമയ ആധാര പ്രയോഗ സേവനം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17016_638625_2046487"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application service such as authentication, profile properties, or roles, that can be accessed by any non-ASP.NET application that can read and send messages in SOAP format. WCF services enable different types of applications to share common data, such as user credentials for logging in.</descrip></descripGrp><ntig><termGrp><term id="638625">Windows Communication Foundation application service</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2046487">WCF സേവനം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17017_638627_1242110"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A unified request processing pipeline that is running in Integrated mode. In the integrated pipeline, custom modules and handlers in a Web application can be configured to subscribe to notifications for all requests to the application, not just requests for ASP.NET-specific resources.</descrip></descripGrp><ntig><termGrp><term id="638627">integrated pipeline</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1242110">ഇന്‍റഗ്രേറ്റഡ് പൈപ്പ് ലൈന്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17018_638628_1242111"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A pre-compilation technology for managed code that compiles Common Intermediate Language (CIL) to native code on the end-user computer prior to application run time. It is an alternative to JIT compilation.</descrip></descripGrp><ntig><termGrp><term id="638628">native image generation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1242111">തദ്ദേശീയ ഇമേജ് ഉല്‍പ്പാദനം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17018_638628_1242112"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A pre-compilation technology for managed code that compiles Common Intermediate Language (CIL) to native code on the end-user computer prior to application run time. It is an alternative to JIT compilation.</descrip></descripGrp><ntig><termGrp><term id="638628">native image generation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1242112">NGen</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17018_638629_1242111"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A pre-compilation technology for managed code that compiles Common Intermediate Language (CIL) to native code on the end-user computer prior to application run time. It is an alternative to JIT compilation.</descrip></descripGrp><ntig><termGrp><term id="638629">NGen</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1242111">തദ്ദേശീയ ഇമേജ് ഉല്‍പ്പാദനം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17018_638629_1242112"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A pre-compilation technology for managed code that compiles Common Intermediate Language (CIL) to native code on the end-user computer prior to application run time. It is an alternative to JIT compilation.</descrip></descripGrp><ntig><termGrp><term id="638629">NGen</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1242112">NGen</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17019_638630_1242113"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of refreshing only a region of a Web page during an asynchronous postback. This is typically accomplished by using UpdatePanel controls. Partial-page rendering is an important feature of AJAX technology.</descrip></descripGrp><ntig><termGrp><term id="638630">partial-page rendering</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1242113">ഭാഗികമായ പേജ് അവതരണം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17020_638631_1242114"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of technologies consisting of a client-side script framework, server controls, and more.</descrip></descripGrp><ntig><termGrp><term id="638631">Asynchronous JavaScript And XML</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1242114">സമയബന്ധിതമല്ലാത്ത ജാവാസ്ക്രിപ്റ്റും XML-ഉം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17020_638631_1242115"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of technologies consisting of a client-side script framework, server controls, and more.</descrip></descripGrp><ntig><termGrp><term id="638631">Asynchronous JavaScript And XML</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1242115">AJAX</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17020_638632_1242114"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of technologies consisting of a client-side script framework, server controls, and more.</descrip></descripGrp><ntig><termGrp><term id="638632">AJAX</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1242114">സമയബന്ധിതമല്ലാത്ത ജാവാസ്ക്രിപ്റ്റും XML-ഉം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17020_638632_1242115"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of technologies consisting of a client-side script framework, server controls, and more.</descrip></descripGrp><ntig><termGrp><term id="638632">AJAX</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1242115">AJAX</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17023_638777_1242116"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In the .NET Framework add-in programming model, an assembly that contains interfaces or abstract base classes, and represents the add-in's view of the methods and types used to communicate with a host.</descrip></descripGrp><ntig><termGrp><term id="638777">add-in view</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1242116">ദര്‍ശനം ഉള്‍പ്പെടുത്തല്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17024_638778_1242117"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In the .NET Framework add-in programming model, an assembly that contains one or more classes, and converts data to and from the add-in view and the contract. Depending on the direction of the call, the adapter is either converting from a view to a contract or from a contract to a view.</descrip></descripGrp><ntig><termGrp><term id="638778">add-in-side adapter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1242117">പാര്‍ശ്വ അഡാപ്റ്റര്‍ ഉള്‍പ്പെടുത്തല്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17026_638780_1242118"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In the .NET Framework add-in programming model, an assembly that contains interfaces or abstract base classes, and represents the host's view of the methods and types used to communicate with an add-in.</descrip></descripGrp><ntig><termGrp><term id="638780">host view of the add-in</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1242118">ഉള്‍പ്പെടുത്തലിന്‍റെ ഹോസ്റ്റ് ദര്‍ശനം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17027_638781_1242119"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In ASP.NET, the process of sending Web page data (plus viewstate and other necessary metadata) from the browser to the server without a complete postback and without blocking the user from continuing to work in the page. Asynchronous postbacks are an important feature of AJAX technology.</descrip></descripGrp><ntig><termGrp><term id="638781">asynchronous postback</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1242119">സമയബന്ധിതമല്ലാത്ത പോസ്റ്റ് ബാക്ക്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1703_142906_1230026"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A line added to a chart that makes it easier to view and evaluate data.</descrip></descripGrp><ntig><termGrp><term id="142906">gridline</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1230026">ഗ്രിഡ് ലൈന്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17036_2629683_2644560"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft volume licensing contract designed for large companies and government organizations that provides a license grant on a perpetual basis.</descrip></descripGrp><ntig><termGrp><term id="2629683">EA</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2644560">എന്റർപ്രൈസ് കരാർ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17036_639060_2644560"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft volume licensing contract designed for large companies and government organizations that provides a license grant on a perpetual basis.</descrip></descripGrp><ntig><termGrp><term id="639060">Enterprise Agreement</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2644560">എന്റർപ്രൈസ് കരാർ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1704_148331_1241217"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of rules established by the administrator that defines security permissions to protect resources.</descrip></descripGrp><ntig><termGrp><term id="148331">security policy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1241217">സുരക്ഷാ പോളിസി</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1706_3257_488888"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A program that invokes other programs in order to accomplish its tasks.</descrip></descripGrp><ntig><termGrp><term id="3257">script</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="488888">സ്ക്രിപ്റ്റ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1707_81769_489470"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The action of pressing and releasing one of the mouse buttons.</descrip></descripGrp><ntig><termGrp><term id="81769">mouse click</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="489470">മൗസ് ക്ലിക്ക്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17083_2461916_1242120"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A function that returns a single value, such as a string, integer, or bit value.</descrip></descripGrp><ntig><termGrp><term id="2461916">scalar function</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1242120">SVF</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17083_639793_1242120"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A function that returns a single value, such as a string, integer, or bit value.</descrip></descripGrp><ntig><termGrp><term id="639793">scalar-valued function</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1242120">SVF</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17083_639794_1242120"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A function that returns a single value, such as a string, integer, or bit value.</descrip></descripGrp><ntig><termGrp><term id="639794">SVF</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1242120">SVF</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17085_639796_1358878"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A measure of how closely results match a customer's search keywords.</descrip></descripGrp><ntig><termGrp><term id="639796">relevance</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1358878">പ്രാധാന്യം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17087_2414535_1242121"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user-defined function that returns a table.</descrip></descripGrp><ntig><termGrp><term id="2414535">TVF</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1242121">പട്ടിക മൂല്യം ചെയ്ത ഫങ്ഷന്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17087_639798_1242121"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user-defined function that returns a table.</descrip></descripGrp><ntig><termGrp><term id="639798">table-valued function</term><termNote type="partOfSpeech">Noun</termN