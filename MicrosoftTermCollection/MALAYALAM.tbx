="52735_2956715_2990072"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The largest positive integer that is a factor/divisor of each of a given set of integers.</descrip></descripGrp><ntig><termGrp><term id="2956715">greatest common factor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2990072">ഉത്തമ സാധാരണ ഘടകം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52736_2956716_2990059"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Of a number or expression, a number which, when raised to a specified power, yields the specified number or expression.</descrip></descripGrp><ntig><termGrp><term id="2956716">root</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2990059">വർഗ്ഗമൂലം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52737_2956717_2990076"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An expression consisting of three terms.</descrip></descripGrp><ntig><termGrp><term id="2956717">trinomial</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2990076">ത്രിപദം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</te