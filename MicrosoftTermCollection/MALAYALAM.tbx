ote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2617265">STP</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4645_39469_1229931"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Windows program that collects and displays for users the system-level features of the computer, including hardware and software setup and configuration.</descrip></descripGrp><ntig><termGrp><term id="39469">Control Panel</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1229931">നിയന്ത്രണപാനല്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4646_184693_2720081"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The status that a user selects to indicate to others that he/she does not want to be interrupted.</descrip></descripGrp><ntig><termGrp><term id="184693">Do Not Disturb</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2720081">ശല്യപ്പെടുത്തരുത്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4646_2729705_2720081"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The status that a user selects to indicate to others that he/she does not want to be interrupted.</descrip></descripGrp><ntig><termGrp><term id="2729705">Do not disturb</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2720081">ശല്യപ്പെടുത്തരുത്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46478_2615085_2618737"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The security feature that protects your device by providing startup and runtime protections that the operating system can validate and report on.</descrip></descripGrp><ntig><termGrp><term id="2615085">System Guard</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2618737">സിസ്റ്റം ഗാർഡ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46479_2615093_2618740"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The remote attestation service that checks the health of Windows 10-based devices to allow or deny access to networks, apps, or services, based on whether devices prove to be healthy.</descrip></descripGrp><ntig><termGrp><term id="2615093">Windows Health Attestation Service</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2618740">Windows ഹെൽത്ത് അറ്റസ്റ്റേഷൻ സേവനം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46481_2615123_2618735"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The area in Windows Defender Security Center that helps customers keep their devices refreshed and up to date with the latest version of Windows 10. Device health advisor monitors the device and provides information and recommendations in a Health report to address common issues with storage capacity, device drivers, battery life, or Windows Update.</descrip></descripGrp><ntig><termGrp><term id="2615123">Device performance &amp; health</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2618735">ഉപകരണ പ്രവർത്തനവും ആരോഗ്യവും</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4649_50166_1877717"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A typographical unit of measure that is equal in width to the point size of a particular font. For many fonts, this is equal to the width of a capital M, from which the em space takes its name.</descrip></descripGrp><ntig><termGrp><term id="50166">em space</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1877717">em സ്‌പെയ്‌സ്</term><termNote type="geographicalUsage">IND</ter