To start recording the amount of time worked on a shift.</descrip></descripGrp><ntig><termGrp><term id="2713700">clock in</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2720052">സമയം രേഖപ്പെടുത്താൻ തുടങ്ങുക</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48089_2713701_2720053"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To stop recording the amount of time worked during a shift.</descrip></descripGrp><ntig><termGrp><term id="2713701">clock out</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2720053">സമയം രേഖപ്പെടുത്തുന്നത് നിർത്തുക</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48090_2713973_2720062"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To pick up a call that has been parked.</descrip></descripGrp><ntig><termGrp><term id="2713973">unpark</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2720062">കൈമാറി വന്ന കോളെടുക്കുക</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id