otSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20087_694562_2200385"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To take action to not answer a call. The call goes to voice mail if that service is available.</descrip></descripGrp><ntig><termGrp><term id="694562">ignore</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2200385">അവഗണിക്കുക</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20091_694566_2199987"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The person who is calling another person or place.</descrip></descripGrp><ntig><termGrp><term id="694566">caller</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2199987">കോളർ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20093_694568_1977214"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To accept an incoming telephone call.</descrip></descripGrp><ntig><termGrp><term id="694568">answer</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1977214">മറുപടി നൽകുക</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote