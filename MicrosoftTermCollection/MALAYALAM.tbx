drop-down list</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="490100">ഡ്രോപ്പ്-ഡൌണ്‍ ലിസ്റ്റ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10894_475180_490100"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A list that can be opened to reveal all choices for a given field.</descrip></descripGrp><ntig><termGrp><term id="475180">picklist</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="490100">ഡ്രോപ്പ്-ഡൌണ്‍ ലിസ്റ്റ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10894_721653_490100"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A list that can be opened to reveal all choices for a given field.</descrip></descripGrp><ntig><termGrp><term id="721653">dropdown list</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="490100">ഡ്രോപ്പ്-ഡൌണ്‍ ലിസ്റ്റ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10899_234822_490189"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To make resources, such as folders, printers, records, etc., unavailable to others.</descrip></descripGrp><ntig><termGrp><term id="234822">unshare</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="490189">പങ്കിടാതിരിക്കുക</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1090_96031_1241183"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A planned and systematic means for assuring that defined standards, practices, procedures, and methods are applied to the project and its results.</descrip></descripGrp><ntig><termGrp><term id="96031">QA</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1241183">QA</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1090_96031_1241184"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A planned and systematic means for assuring that defined standards, practices, procedures, and methods are applied to the project and its results.</descrip></descripGrp><ntig><termGrp><term id="96031">QA</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1241184">ഗുണനിലവാര വാഗ്ദാനം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termN