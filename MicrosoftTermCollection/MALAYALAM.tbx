<ntig><termGrp><term id="1878181">ഗണം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1250_530462_2290155"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A grouping of dimension members or items from a data source that are named and treated as a single unit and can be referenced or reused multiple times.</descrip></descripGrp><ntig><termGrp><term id="530462">named set</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2290155">നാമമുള്ള ഗണം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12505_131084_489746"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In a graphical user interface such as Windows, a pattern or picture in the screen background that can be chosen by the user.</descrip></descripGrp><ntig><termGrp><term id="131084">wallpaper</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="489746">വാള്‍‌പേപ്പര്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12509_543484_1241798"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Team Foundation link between two work items that represent the same work item. In practice, t