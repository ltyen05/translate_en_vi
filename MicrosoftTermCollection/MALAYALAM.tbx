hat is used to replace traditional PBXs, and enables key calling capabilities.</descrip></descripGrp><ntig><termGrp><term id="2947840">Teams Phone</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2930636">Microsoft Teams ഫോൺ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52042_2947840_2949291"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The overall telephony workload for Microsoft Teams, including the core cloud-based call control system that is used to replace traditional PBXs, and enables key calling capabilities.</descrip></descripGrp><ntig><termGrp><term id="2947840">Teams Phone</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2949291">Teams ഫോൺ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52043_2930012_2930203"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that appears in the Excel home tab, powered by AI, that helps people analyze their data by providing summaries, visual and significant trends and insights, and allows Natural Language Queries about the data.</descrip></descripGrp><ntig><termGrp><term id="2930012">Analyze Data</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id