.</descrip></descripGrp><ntig><termGrp><term id="592553">PCL</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2725284">PCL</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4280_592553_2725286"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A value between 1 and 8 that is assigned to a message based on its content and that reflects the likelihood that the message is phishing.</descrip></descripGrp><ntig><termGrp><term id="592553">PCL</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2725286">ഫിഷിംഗ് വിശ്വാസ നില</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4281_88221_2480177"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To explicitly decline to participate.</descrip></descripGrp><ntig><termGrp><term id="88221">opt out</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2480177">ഓപ്റ്റ് ഔട്ട് ചെയ്യുക</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4282_147657_1877842"><langSet xml:lang="en