nciled.</descrip></descripGrp><ntig><termGrp><term id="2753781">page conflict</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2757336">പേജ് പൊരുത്തക്കേട്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48679_2753782_2757330"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A total amount of time spent at work emailing, in meetings, and on chats or calls.</descrip></descripGrp><ntig><termGrp><term id="2753782">collaboration time</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2757330">കൊളാബറേഷൻ സമയം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48682_2753813_2757340"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A number that identifies a row in an Excel sheet in order, starting at 1.</descrip></descripGrp><ntig><termGrp><term id="2753813">row index</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2757340">വരി സൂചിക</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48683_2753814_2