 subscription.</descrip></descripGrp><ntig><termGrp><term id="2390287">companion app</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2395340">കമ്പാനിയൻ ആപ്സ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4228_96236_1877738"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">During software upgrades, the product that is already installed on the machine, i.e. the version to be upgraded.</descrip></descripGrp><ntig><termGrp><term id="96236">qualifying product</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1877738">ക്വാളിഫൈ ചെയ്‌ത ഉല്‍പ്പന്നം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42290_2393212_2394170"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app that integrates caller ID, block and filter, and quiet hours functionality to both Calling and Messaging apps on Windows mobile phones. This version is for markets other than China.</descrip></descripGrp><ntig><termGrp><term id="2393212">ID &amp; Filter (global)</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2394170">ID-യും ഫിൽട്ടറും (ആഗോളം)</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun