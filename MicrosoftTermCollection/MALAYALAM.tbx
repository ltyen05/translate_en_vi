13"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A series of redirecting web links that are designed to hide malicious websites.</descrip></descripGrp><ntig><termGrp><term id="1379720">link chain</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1461413">ലിങ്ക് ചെയിന്‍‌</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27516_1379721_1461418"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An email address that's attached to a mobile phone by a mobile provider and used for messaging transmitted over an email service.</descrip></descripGrp><ntig><termGrp><term id="1379721">mobile address</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1461418">മൊബൈല്‍‌ വിലാസം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27516_1517452_1461418"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An email address that's attached to a mobile phone by a mobile provider and used for messaging transmitted over an email service.</descrip></descripGrp><ntig><termGrp><term id="1517452">mobile email address</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1461418">മൊബൈല്‍‌ വിലാസം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27518_1379723_1461424"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A web address (URL) of a folder or photo album on OneDrive that allows access to anyone who visits the webpage. Visitors don't need to have explicit sharing permissions to the folder or album, sign in to Windows Live, or even have a Windows Live ID.</descrip></descripGrp><ntig><termGrp><term id="1379723">public link</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1461424">പൊതു ലിങ്ക്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2752_47550_489232"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of possible values for an independent variable in a function or for a database attribute.</descrip></descripGrp><ntig><termGrp><term id="47550">domain</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="489232">ഡൊമൈന്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27524_1379731_1461428"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A quick view that displays only the email messages that contain shipment information, such as a tracking number and web link.</descrip></descripGrp><ntig><termGrp><term id="1379731">Shipping updates</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1461428">ഷിപ്പിംഗ് അപ്‌ഡേറ്റുകള്‍‌</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27527_1379734_2290176"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The tooltip displayed when pointing to a personal folder icon on the Manage folders page on the Windows Live Devices website.</descrip></descripGrp><ntig><termGrp><term id="1379734">Synced folder</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2290176">സമന്വിത ഫോൾഡർ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27535_1380057_1461468"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The visible name of the information sent to Microsoft via Windows Error Reporting if the Windows Live Essential Installer crashes.</descrip></descripGrp><ntig><termGrp><term id="1380057">Windows Live Troubleshooting Data</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1461468">Windows Live ട്രബിള്‍ഷൂട്ടിംഗ്‌ ഡാറ്റ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27536_1380058_1461469"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">End-user operating system updates that support the use of selected current release technologies on previous versions of the Windows operating system.</descrip></descripGrp><ntig><termGrp><term id="1380058">Windows Platform Update</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1461469">Windows പ്ലാറ്റ്‌ഫോം അപ്‌ഡേറ്റ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27536_1381790_1461469"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">End-user operating system updates that support the use of selected current release technologies on previous versions of the Windows operating system.</descrip></descripGrp><ntig><termGrp><term id="1381790">Platform Update for Windows Vista</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1461469">Windows പ്ലാറ്റ്‌ഫോം അപ്‌ഡേറ്റ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2755_550_488827"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A chunk of data that a Web server sends to a browser, which in turn saves it and sends it back when accessing the Web server again.</descrip></descripGrp><ntig><termGrp><term id="550">cookie</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="488827">കുക്കി</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27555_1381690_1517373"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A website or service that a customer can connect to in order to share what they've been doing on other websites, see their friends and their updates from other services in Windows Live, or share their Windows Live activity on other websites.</descrip></descripGrp><ntig><termGrp><term id="1381690">service</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1517373">സേവനം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27556_1381691_1461241"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A service that a user has connected to Windows Live.</descrip></descripGrp><ntig><termGrp><term id="1381691">connected service</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1461241">കണക്‌ട് ചെയ്‌ത സേവനം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2756_237244_1241261"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An attempt to model the effect of many users accessing a server at the same time. Load tests do not generate actual load with actual users, but rather simulated load with virtual users.</descrip></descripGrp><ntig><termGrp><term id="237244">load simulation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1241261">ലോഡ് അനുകരണം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27565_1382243_2290175"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A folder someone using Windows Live Sync is synchronizing between computers.</descrip></descripGrp><ntig><termGrp><term id="1382243">synced folder</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2290175">സമന്വിത ഫോൾഡർ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27578_1385957_1427467"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that allows users to navigate directly to the webpage of the top-ranked search result when a search is performed in the address bar.</descrip></descripGrp><ntig><termGrp><term id="1385957">Address Bar Top Result</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalN