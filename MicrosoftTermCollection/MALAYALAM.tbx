2735736_2739096"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The view contains a set of cards that contain information on security and compliance trends and that track the protection status of an organization’s identities, data, devices, apps, and infrastructure.</descrip></descripGrp><ntig><termGrp><term id="2735736">Monitoring &amp; reports</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2739096">നിരീക്ഷണവും റിപ്പോർട്ടുകളും</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48405_2736256_2746170"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The button that initiates a proactive search for security threats.</descrip></descripGrp><ntig><termGrp><term id="2736256">Start hunting</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2746170">കണ്ടെത്തൽ ആരംഭിക്കുക</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48406_2736257_2746152"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The card that allows users to hunt for email related activities that put users and data at risk, and take action against the threats.</descrip></descripGrp><ntig><termGrp><term id="2736257">Email &amp; data</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote><