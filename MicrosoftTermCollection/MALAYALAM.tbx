ition">An option that switches the view from the display of HTML source code to the display of Web page content.</descrip></descripGrp><ntig><termGrp><term id="232822">Exit HTML Source</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1877920">HTML ഉറവിടത്തില്‍ നിന്ന് പുറത്തുകടക്കുക</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15383_2482719_2485782"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The primary circuit board in a computer that contains most of the basic components of the system.</descrip></descripGrp><ntig><termGrp><term id="2482719">baseboard</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2485782">ബേസ്‌ബോർഡ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15383_81653_2485782"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The primary circuit board in a computer that contains most of the basic components of the system.</descrip></descripGrp><ntig><termGrp><term id="81653">motherboard</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2485782">ബേസ്‌ബോർഡ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender