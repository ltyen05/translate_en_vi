n">A Microsoft Bookings user with an admin role.</descrip></descripGrp><ntig><termGrp><term id="2929086">Bookings admin</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2929342">Bookings അഡ്‌മിൻ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52006_2929515_2929545"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Windows Server file sharing feature that allows users to set caps on the portion of network capacity taken up by traffic using the SMB protocol.</descrip></descripGrp><ntig><termGrp><term id="2929515">SMB bandwidth limit</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2929545">SMB ബാന്‍ഡ്‌വിഡ്ത്ത് പരിധി</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52008_2929517_2929546"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Windows feature that uses hardware virtualization to create and isolate a secure region of memory from the normal operating system which can be used to host security solutions.</descrip></descripGrp><ntig><termGrp><term id="2929517">virtualization-based security</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2929546">VBS</term><termNote type="geographicalUsage">IND</termNote><termNote typ