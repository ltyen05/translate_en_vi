OfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="3146277">Z മുതൽ A വരെ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29132_3145165_3146277"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A sort order in which text strings are arranged in reverse alphabetical order, numerical values are arranged from largest to smallest, and dates and times are arranged from newest to oldest.</descrip></descripGrp><ntig><termGrp><term id="3145165">Z to A</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="3146277">Z മുതൽ A വരെ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29146_1636440_1878370"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A source that returns a set of search results for a given search query. The source can be a search service in the local server farm or another server farm, or another search engine that is compliant with the OpenSearch protocol.</descrip></descripGrp><ntig><termGrp><term id="1636440">result source</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1878370">ഫലത്തിന്‍റെ ഉറവിടം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29149_1506722_2304738"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A container for items that are deleted. Items in this container are visible to users with the appropriate permissions and to site collection administrators.</descrip></descripGrp><ntig><termGrp><term id="1506722">first-stage Recycle Bin</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2304738">ഒന്നാം ഘട്ട പുനരുപയോഗപെട്ടി</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29193_1644672_1878412"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Web Part that renders named objects or named items in a workbook, such as tables, charts, slicers or a named range of cells.</descrip></descripGrp><ntig><termGrp><term id="1644672">named item view</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1878412">പേരുനല്‍കിയ ഇനങ്ങളുടെ കാഴ്‌ച</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2921_187030_1241265"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A line leading from a field or property to a shape that represents that field or property's type.</descrip></descripGrp><ntig><termGrp><term id="187030">association line</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1241265">സംയോജന വര</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2923_59620_489315"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method of specifying software behavior by system administrators. Administrators set policies that are used to control how software features behave.</descrip></descripGrp><ntig><termGrp><term id="59620">Group Policy</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="489315">ഗ്രൂപ്പ് പോളിസി</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29256_1506853_2304749"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A container for items that have been deleted from a first-stage Recycle Bin. Items in a second-stage Recycle Bin are visible only to site collection administrators.</descrip></descripGrp><ntig><termGrp><term id="1506853">second-stage Recycle Bin</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2304749">രണ്ടാം ഘട്ട പുനരുപയോഗപെട്ടി</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></lan