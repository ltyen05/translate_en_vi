</termEntry><termEntry id="12998_83321_489480"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A value that represents the result of an invalid calculation.</descrip></descripGrp><ntig><termGrp><term id="83321">not a number</term><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="489480">സംഖ്യ അല്ല</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13002_42491_489177"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of writing new data to computer memory.</descrip></descripGrp><ntig><termGrp><term id="42491">data entry</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="489177">ഡാറ്റാ എന്‍‌ട്രി</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13006_309435_490508"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A visual indication that represents the current location being played within the selected media.</descrip></descripGrp><ntig><termGrp><term id="309435">playhead</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="490508">പ്ലേഹെഡ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="gra