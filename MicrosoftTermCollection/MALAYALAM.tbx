><descrip type="definition">The client library that can be used to make calls to Microsoft Graph.</descrip></descripGrp><ntig><termGrp><term id="2506547">Microsoft Graph Client Library</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2512829">Microsoft ഗ്രാഫ് ക്ലയന്റ് ലൈബ്രറി</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44560_2506548_2512837"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A packet of bytes meant to transfer a small amount of data between programs.</descrip></descripGrp><ntig><termGrp><term id="2506548">token</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2512837">ടോക്കൺ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44561_2506549_2512839"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An opaque token provided by Microsoft Graph to a notification URL that needs to be provided back to Microsoft Graph in order to validate ownership of the notification URL.</descrip></descripGrp><ntig><termGrp><term id="2506549">validation token</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2512839">സാധൂകരണ ടോക്കൺ</term><termNote type="geographicalUsage">IND</termNote><termNote t