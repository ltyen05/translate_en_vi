_488881"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A communications device that converts between digital data from a computer or terminal and analog audio signals that can pass through a standard telephone line.</descrip></descripGrp><ntig><termGrp><term id="2912">modulator/demodulator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="488881">മോഡുലേറ്റര്‍ / ഡിമോഡുലേറ്റര്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="689_108242_489613"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">On the IBM PC/XT and AT and compatible keyboards, a key on the top row of the numeric keypad that controls the effect of the cursor control keys and sometimes prevents the screen from scrolling. On the enhanced and Macintosh keyboards, this key is to the right of the function keys on the top row. Many modern applications ignore the Scroll Lock setting.</descrip></descripGrp><ntig><termGrp><term id="108242">SCROLL LOCK key</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="489613">SCROLL LOCK കീ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6894_318712_490620"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A statement that the text or program code contained within the item on which the notice appears is the intellectual property of Microsoft (or other 