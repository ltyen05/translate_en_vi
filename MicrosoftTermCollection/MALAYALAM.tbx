="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21098_766643_2290150"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The worldwide collection of networks and gateways that use the TCP/IP suite of protocols to communicate with one another.</descrip></descripGrp><ntig><termGrp><term id="766643">mesh</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2290150">ഇന്‍റർനെറ്റ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21099_766650_1242187"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An instance of a channel endpoint participating in the mesh that implements the Peer Channel Protocol.</descrip></descripGrp><ntig><termGrp><term id="766650">peer node</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1242187">തുല്യ നോഡ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21104_766799_1229462"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of computing resources such as programs and virtual desktops that enable a user to accomplish a set of related tasks.</descrip></descripGrp><ntig><termGrp><term id="766799">workspace</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1229462">വര്‍ക്ക് സ്പെയ്സ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21106_766801_1229463"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The entity that offers a remote workspace, typically the IT department of the user’s employer, a business partner or vendor, or less commonly, a commercial application service provider. The publisher may use a digital certificate to represent its identity and use it to sign the remote resource files (e.g. RDP files) and the workspace description (e.g. Web Service feed).</descrip></descripGrp><ntig><termGrp><term id="766801">publisher</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1229463">പ്രസാധകന്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21113_766809_1229464"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Silent and unexpected process termination by the process itself or by another application.</descrip></descripGrp><ntig><termGrp><term id="766809">silent process exit</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1229464">സൈലന്‍റ് പ്രോസസ് പുറത്താക്കല്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21114_766811_1229465"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To shut down a core processor for power saving purpose.</descrip></descripGrp><ntig><termGrp><term id="766811">park</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1229465">പാര്‍ക്ക് ചെയ്യുക</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21115_766812_1229466"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To reopen a core processor that had been parked for power saving purpose.</descrip></descripGrp><ntig><termGrp><term id="766812">unpark</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1229466">പാര്‍ക്ക് മാറ്റുക</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21116_766813_1229467"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature of Windows Media Player that allows users to remove gaps between tracks that they burn to audio CDs.</descrip></descripGrp><ntig><termGrp><term id="766813">gapless CD burning</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1229467">വിടവില്ലാത്ത ബേണ്‍ചെയ്യല്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21116_766816_1229467"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature of Windows Media Player that allows users to remove gaps between tracks that they burn to audio CDs.</descrip></descripGrp><ntig><termGrp><term id="766816">gapless burning</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1229467">വിടവില്ലാത്ത ബേണ്‍ചെയ്യല്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21117_766814_1229468"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Existing in reference to the removal of silences or clicks between tracks when they are burnt to an audio CD or when they are played back from the CD.</descrip></descripGrp><ntig><termGrp><term id="766814">gapless</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1229468">വിടവില്ലാത്ത</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21120_766842_1229469"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A unique identifier made from four otherwise separate pieces of information. For example, a color can be specified by a black, yellow, magenta and cyan quad.</descrip></descripGrp><ntig><termGrp><term id="766842">quad</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1229469">ചതുരം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21126_766858_1229470"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Any information (e.g. account numbers, sensitive data, etc.) with a title and some free-form text that can be stored in a secure manner in a personal vault.</descrip></descripGrp><ntig><termGrp><term id="766858">secure note</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1229470">സുരക്ഷിത കുറിപ്പ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21128_766863_1229471"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To make an object, such as a file, accessible.</descrip></descripGrp><ntig><termGrp><term id="766863">open</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1229471">തുറക്കുക</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21129_766864_1242188"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To fetch the top (most recently added) element of a stack, removing that element from the stack in the process.</descrip></descripGrp><ntig><termGrp><term id="766864">pop</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1242188">പോപ്പ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2113_1130279_490657"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The symbol or character used to indicate that a word, phrase, symbol, or design is a trademark, but not a registered trademark.</descrip></descripGrp><ntig><termGrp><term id="1130279">™</term><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="490657">വ്യാപാര മുദ്ര</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2113_319159_490657"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The symbol or character used to indicate that a word, phrase, symbol, or design is a trademark, but not a registered trademark.</descrip></descripGrp><ntig><termGrp><term id="319159">trademark symbol</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="490657">വ്യാപാര മുദ്ര</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2113_319160_490657"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The symbol or character used to indicate that a word, phrase, symbol, or design is a trademark, but not a registered trademark.</descrip></descripGrp><ntig><termGrp><term id="319160">TRADE MARK SIGN</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="490657">വ്യാപാര മുദ്ര</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21183_767128_1242189"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To call 32-bit code from 16-bit code, or vice versa. Thunking involves, in large part, the translation to and from 16-bit segment offset memory addressing and 32-bit flat, or linear, memory addressing.</descrip></descripGrp><ntig><termGrp><term id="767128">thunk</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1242189">തങ്ക്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21197_767142_1229472"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that replicates the animation associated with a source object to one or more target objects.</descrip></descripGrp><ntig><termGrp><term id="767142">Animation Painter</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1229472">ആനിമേഷന്‍ പെയിന്‍റര്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21199_767144_1229473"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An abstract grouping of similar animation effects.</descrip></descripGrp><ntig><termGrp><term id="767144">animation style</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1229473">ആനിമേഷന്‍ ശൈലി</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21200_767145_1229474"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An effect that a user can apply to an image to achieve a specific artistic look.</descrip></descripGrp><ntig><termGrp><term id="767145">artistic effect</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1229474">കലാവൈഭവം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21201_767146_1229475"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A visual representation of an audio signal over time.</descrip></descripGrp><ntig><termGrp><term id="767146">audio waveform</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1229475">ശബ്ദതരംഗരൂപം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21202_767148_1229476"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An image editing feature that allows a user to isolate the foreground portion of an image and make the background transparent.</descrip></descripGrp><ntig><termGrp><term id="767148">Background Removal</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1229476">പശ്ചാത്തലം മാറ്റല്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21203_767149_1944533"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An option that removes narrations and laser pointer gestures or timings from a presentation or from a specific slide.</descrip></descripGrp><ntig><termGrp><term id="767149">Clear Recordings</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1944533">റിക്കാര്‍ഡ് ചെയ്‍തത് മായ്ക്കുക</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2121_375_488822"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An area of memory reserved for temporarily holding data before that data is used by a receiving device or application. Buffering protects against the interruption of data flow.</descrip></descripGrp><ntig><termGrp><term id="375">buffer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="488822">ബഫര്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21211_767324_1878079"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of cryptographic algorithms specified by the US National Security Agency to provide an interoperable standard for government and industry.</descrip></descripGrp><ntig><termGrp><term id="767324">Suite B</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1878079">സ്യൂട്ട് B</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21212_767327_1229478"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ability of software to support customer-preferred algorithms for encryption, hashing, entropy and digital signatures.</descrip></descripGrp><ntig><termGrp><term id="767327">cryptographic agility</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1229478">ക്രിപ്റ്റോഗ്രാഫിക് കഴിവ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21212_767327_1229479"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ability of software to support customer-preferred algorithms for encryption, hashing, entropy and digital signatures.</descrip></descripGrp><ntig><termGrp><term id="767327">cryptographic agility</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1229479">ക്രിപ്റ്റോ കഴിവ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21212_767328_1229478"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ability of software to support customer-preferred algorithms for encryption, hashing, entropy and digital signatures.</descrip></descripGrp><ntig><termGrp><term id="767328">crypto agility</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1229478">ക്രിപ്റ്റോഗ്രാഫിക് കഴിവ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21212_767328_1229479"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ability of software to support customer-preferred algorithms for encryption, hashing, entropy and digital signatures.</descrip></descripGrp><ntig><termGrp><term id="767328">crypto agility</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1229479">ക്രിപ്റ്റോ കഴിവ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21213_767329_1805275"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The portion of InfoPath used to design forms.</descrip></descripGrp><ntig><termGrp><term id="767329">Designer</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1805275">డిజైనర్</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21217_767333_1425589"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To remove a user's changes from the Microsoft Office Document Cache without deleting the file on the server or removing the latest version downloaded from the server from the Office Document Cache.</descrip></descripGrp><ntig><termGrp><term id="767333">discard changes</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1425589">മാറ്റങ്ങള്‍ ഉപേക്ഷിക്കുക</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21227_767357_1413267"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A security feature that validates files before allowing them to be loaded by the application, in order to protect against file format vulnerabilities.</descrip></descripGrp><ntig><termGrp><term id="767357">Office File Validation</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1413267">ഓഫീസ് ഫയല്‍ സാധൂകരണം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21227_767357_1944549"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A security feature that validates files before allowing them to be loaded by the application, in order to protect against file format vulnerabilities.</descrip></descripGrp><ntig><termGrp><term id="767357">Office File Validation</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1944549">Office ഫയല്‍ സാധൂകരണം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21244_767583_1229481"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows end users and IT admins to control which file types and versions can be opened and saved in the application.</descrip></descripGrp><ntig><termGrp><term id="767583">File Block</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1229481">ഫയല്‍ തടയല്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21253_767590_1229482"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows the user to superimpose a dot over a presentation and control its position with the mouse. The appearance of the dot is similar to that of a traditional laser pointer, and it is broadcast to all presentation viewers and can be recorded into video (Save to Video).</descrip></descripGrp><ntig><termGrp><term id="767590">Laser Pointer</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1229482">ലേസര്‍ പോയിന്‍റര്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21261_767627_1242190"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To remove from a queue.</descrip></descripGrp><ntig><termGrp><term id="767627">dequeue</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1242190">ക്യൂപാലിക്കാതിരിക്കല്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21265_767631_1944554"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An option that initiates an email response addressed to all of the recipients on the To or Cc lines of the original message.</descrip></descripGrp><ntig><termGrp><term id="767631">Reply to All</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1944554">എല്ലാവര്‍ക്കും മറുപടി</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21265_767632_1944554"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An option that initiates an email response addressed to all of the recipients on the To or Cc lines of the original message.</descrip></descripGrp><ntig><termGrp><term id="767632">Reply All</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1944554">എല്ലാവര്‍ക്കും മറുപടി</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21277_768421_1229484"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The mode of Windows Photo Viewer which consists of a top level window displaying one photograph at a time, with navigation controls.</descrip></descripGrp><ntig><termGrp><term id="768421">Photo Viewer</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1229484">ഫോട്ടോ വ്യൂവര്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21278_768422_1229485"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mode of Windows Photo Viewer which displays full-screen slide shows for photos.</descrip></descripGrp><ntig><termGrp><term id="768422">Slideshow</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1229485">സ്ലൈഡ് പ്രദര്‍ശനം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21290_768424_1229486"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A recordable media (such as CD-RW) to which you can only write once without reformatting.</descrip></descripGrp><ntig><termGrp><term id="768424">single session-only disc</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1229486">ഒരു സെഷന്‍ മാത്രമുള്ള ഡിസ്ക്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21291_768440_1413263"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A recordable media to which you can write several times without reformatting.</descrip></descripGrp><ntig><termGrp><term id="768440">multi session-capable disc</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1413263">വിവിധ സെഷന് ശേഷിയുള്ള ഡിസ്ക്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21299_768624_1229488"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that is added to the Microsoft Office Compatibility Pack to open Word, Excel, and PowerPoint binary format files and securely convert them to the Office 2007 file formats.</descrip></descripGrp><ntig><termGrp><term id="768624">Microsoft Office Isolated Conversion Environment</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1229488">MOICE</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21299_768625_1229488"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that is added to the Microsoft Office Compatibility Pack to open Word, Excel, and PowerPoint binary format files and securely convert them to the Office 2007 file formats.</descrip></descripGrp><ntig><termGrp><term id="768625">MOICE</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1229488">MOICE</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="213_187482_1241105"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An object or routine for traversing the items in a list, array, collection, or stream one at a time.</descrip></descripGrp><ntig><termGrp><term id="187482">iterator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1241105">ആവര്‍ത്തിതം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="213_187482_1241106"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An object or routine for traversing the items in a list, array, collection, or stream one at a time.</descrip></descripGrp><ntig><termGrp><term id="187482">iterator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1241106">എണ്ണമെടുക്കല്‍ ഉപാധി</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="213_378454_1241105"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An object or routine for traversing the items in a list, array, collection, or stream one at a time.</descrip></descripGrp><ntig><termGrp><term id="378454">enumerator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1241105">ആവര്‍ത്തിതം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="213_378454_1241106"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An object or routine for traversing the items in a list, array, collection, or stream one at a time.</descrip></descripGrp><ntig><termGrp><term id="378454">enumerator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1241106">എണ്ണമെടുക്കല്‍ ഉപാധി</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21300_1054681_1765299"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that makes Outlook auto-complete lists available through the default Exchange mailbox.</descrip></descripGrp><ntig><termGrp><term id="1054681">Suggested Contacts</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1765299">നിര്‍ദ്ദേശിച്ച കോണ്‍ടാക്റ്റുകള്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21301_769458_1229490"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A common credential store and interface that is used to save and manage user credentials, such as user names and passwords, so you can easily log on to Web sites and connect to other resources, such as computers.</descrip></descripGrp><ntig><termGrp><term id="769458">Credential Manager</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1229490">ക്രെഡെന്‍ഷ്യല്‍ മാനേജര്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21302_769460_1229491"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of credentials that users can create, store and manage in Credential Manager.</descrip></descripGrp><ntig><termGrp><term id="769460">vault</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1229491">വാള്‍ട്ട്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21303_769462_1229492"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of vault that contains Web passwords and secure notes that you can place on a USB flash drive and use on another computer.</descrip></descripGrp><ntig><termGrp><term id="769462">personal vault</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1229492">സ്വകാര്യവാള്‍ട്ട്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21309_769803_2200196"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To remove data permanently from a storage medium. This is usually done by replacing existing data with zeros or meaningless text or, in magnetic media, by disturbing the magnetic particles' physical arrangement, either with the erase head or with a large magnet.</descrip></descripGrp><ntig><termGrp><term id="769803">erase</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2200196">മായ്ക്കുക</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2131_397166_1961042"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process of permanently deleting something by removing it from the store or moving it to the dumpster when dumpster functionality is enabled.</descrip></descripGrp><ntig><termGrp><term id="397166">hard delete</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1961042">ശാശ്വതമായ ഇല്ലാതാക്കല്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21319_769843_1242191"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To execute one or more statements or instructions repeatedly. Statements or instructions so executed are said to be in a loop.</descrip></descripGrp><ntig><termGrp><term id="769843">iterate</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1242191">ആവര്‍ത്തിതം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2132_125577_1228924"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">When referring to a device, to remove the corresponding device drivers from the hard disk and physically remove the device from the computer.</descrip></descripGrp><ntig><termGrp><term id="125577">uninstall</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1228924">അണ്‍ഇന്‍സ്റ്റാള്‍ ചെയ്യുക</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2132_125577_489713"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">When referring to a device, to remove the corresponding device drivers from the hard disk and physically remove the device from the computer.</descrip></descripGrp><ntig><termGrp><term id="125577">uninstall</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="489713">അണ്‍ഇന്‍സ്റ്റാള്‍ചെയ്യുക</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21322_769845_1425590"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A control in a form that consists of an actionable image. At run time the user can click the image to run rules or actions similar to a button.</descrip></descripGrp><ntig><termGrp><term id="769845">picture button</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1425590">ചിത്ര ബട്ടണ്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21329_769992_2855779"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To forward a piece of data from one part of a program to another.</descrip></descripGrp><ntig><termGrp><term id="769992">pass</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2855779">കൈമാറുക</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21333_770402_2196255"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A note that contains recorded information.</descrip></descripGrp><ntig><termGrp><term id="770402">voice note</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2196255">ശബ്ദ കുറിപ്പ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21334_2675561_2400108"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft app that creates sticky notes that can be shared between devices, that cloud sync, that are stored on Exchange, and that provide contextual reminders and actions that can be performed based on the content.</descrip></descripGrp><ntig><termGrp><term id="2675561">Microsoft Sticky Notes</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2400108">സ്റ്റിക്കി നോട്ടുകൾ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21334_2675561_2676799"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft app that creates sticky notes that can be shared between devices, that cloud sync, that are stored on Exchange, and that provide contextual reminders and actions that can be performed based on the content.</descrip></descripGrp><ntig><termGrp><term id="2675561">Microsoft Sticky Notes</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2676799">Microsoft സ്‌റ്റിക്കി നോട്ടുകൾ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21334_770408_2400108"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft app that creates sticky notes that can be shared between devices, that cloud sync, that are stored on Exchange, and that provide contextual reminders and actions that can be performed based on the content.</descrip></descripGrp><ntig><termGrp><term id="770408">Sticky Notes</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2400108">സ്റ്റിക്കി നോട്ടുകൾ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21334_770408_2676799"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft app that creates sticky notes that can be shared between devices, that cloud sync, that are stored on Exchange, and that provide contextual reminders and actions that can be performed based on the content.</descrip></descripGrp><ntig><termGrp><term id="770408">Sticky Notes</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2676799">Microsoft സ്‌റ്റിക്കി നോട്ടുകൾ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21335_770428_2412570"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An individual piece of content that resembles a physical sticky note, is displayed across multiple apps and platforms, and that is created using Sticky Notes.</descrip></descripGrp><ntig><termGrp><term id="770428">sticky note</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2412570">സ്റ്റിക്കി നോട്ട്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21348_771258_3045983"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To continue movement, as with the cursor or a search operation, to the beginning or to a new starting point rather than stopping when the end of a series is reached. For example, the screen cursor might wrap around to the first column of the next line rather than stopping when it reaches the last column of the current line. Likewise, a program starting a search or replace operation in the middle of a document might be instructed to wrap around to the beginning rather than stop when it reaches the end of the document.</descrip></descripGrp><ntig><termGrp><term id="771258">wrap around</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="3045983">റാപ് അറൗണ്ട്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2135_50719_1241235"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ability of an object to hide its internal data and methods, making only the intended parts of the object programmatically accessible.</descrip></descripGrp><ntig><termGrp><term id="50719">encapsulation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1241235">സംക്ഷേപണം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21353_1177078_1229493"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables presenters in the rich client to broadcast a slide show to remote viewers watching in a Web browser. Throughout the presentation, the remote attendees will see the current slide being shown by the presenter.</descrip></descripGrp><ntig><termGrp><term id="1177078">PowerPoint Broadcast Slide Show</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1229493">സംപ്രേക്ഷണ സ്ലൈഡ് പ്രദര്‍ശനം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21353_772635_1229493"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables presenters in the rich client to broadcast a slide show to remote viewers watching in a Web browser. Throughout the presentation, the remote attendees will see the current slide being shown by the presenter.</descrip></descripGrp><ntig><termGrp><term id="772635">Broadcast Slide Show</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1229493">സംപ്രേക്ഷണ സ്ലൈഡ് പ്രദര്‍ശനം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21354_1075942_1229494"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A labeled group of consecutive slides that helps the user navigate and organize presentations.</descrip></descripGrp><ntig><termGrp><term id="1075942">presentation section</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1229494">വിഭാഗം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21354_1075942_1229495"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A labeled group of consecutive slides that helps the user navigate and organize presentations.</descrip></descripGrp><ntig><termGrp><term id="1075942">presentation section</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1229495">പ്രദര്‍ശന വിഭാഗം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</t