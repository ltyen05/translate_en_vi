</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4972_75877_1229937"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In information processing, an operation performed by the computer at hand rather than by a remote computer.</descrip></descripGrp><ntig><termGrp><term id="75877">local</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1229937">ലോക്കല്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4973_141204_1944537"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In line and area charts, lines that extend from a data point to the category (x) axis. Useful in area charts to clarify where one data marker ends and the next begins.</descrip></descripGrp><ntig><termGrp><term id="141204">drop lines</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1944537">ഡ്രോപ്പ് ലൈനുകള്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4974_137439_1241368"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A boundary that the common language runtime establishes around objects created within the same application scope (that is, anywhere along the sequence of object activations