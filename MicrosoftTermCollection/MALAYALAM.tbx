mNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="919_362557_1961170"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An HTTP authentication protocol that encodes but does not encrypt username and password.</descrip></descripGrp><ntig><termGrp><term id="362557">plaintext authentication</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1961170">പ്ലയ്‌ന്‍‍ടെക്‌സ്റ്റ് ഓതന്‍റിക്കേഷന്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9190_536345_1241610"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A component of ADO.NET that provides access to data from a relational data source. A .NET Framework data provider contains classes to connect to a data source, execute commands at the data source, and return query results from the data source, including the ability to execute commands within transactions. A .NET Framework data provider also contains classes to populate a DataSet with results from a data source and propagate changes in a DataSet back to the data source.</descrip></descripGrp><ntig><termGrp><term id="536345">.NET Framework data provider</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1241610">.NET ചട്ടക്കൂട് ഡാറ്റാ ദാതാവ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9201_185833_3013167"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A common menu item that enables the user to select how the contents of the current program are displayed.</descrip></descripGrp><ntig><termGrp><term id="185833">View</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="3013167">കാഴ്ച</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9204_494727_2352858"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A UI container that docks to a pane, can be part of a panel group, and is represented by a tab.</descrip></descripGrp><ntig><termGrp><term id="494727">panel</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2352858">പാനൽ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9206_85254_1877733"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A space that is used to prevent multiple words from breaking if they fall at the end of a line.</descrip></descripGrp><ntig><termGrp><term id="85254">nonbreaking space</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1877733">നോണ്‍‌ബ്രേക്കിംഗ് സ്‌പെയ്‌സ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9216_187916_1241611"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The analysis of the source or object code of a program without executing the code. Typically the analysis is designed to detect errors.</descrip></descripGrp><ntig><termGrp><term id="187916">static analysis</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1241611">അചലമായ വിശ്ലേഷണം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9219_88069_1229737"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A domain controller that has been assigned one or more special roles in an Active Directory domain.</descrip></descripGrp><ntig><termGrp><term id="88069">operations master</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1229737">പ്രക്രിയ മാസ്റ്റര്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="922_1177130_1228910"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process for removing redundant data from a digital media file or stream to reduce its size or the bandwidth used.</descrip></descripGrp><ntig><termGrp><term id="1177130">data compaction</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1228910">കംപ്രസ് ചെയ്യല്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="922_37103_1228910"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process for removing redundant data from a digital media file or stream to reduce its size or the bandwidth used.</descrip></descripGrp><ntig><termGrp><term id="37103">compression</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1228910">കംപ്രസ് ചെയ്യല്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9221_141157_1877795"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A fundamental data type that holds double-precision floating-point numbers. It's stored as a 64-bit number ranging in value from approximately -1.797E308 to -4.940E-324 (negative), from 4.94E-324 to 1.797E308 (positive), and 0.</descrip></descripGrp><ntig><termGrp><term id="141157">Double data type</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1877795">ഇരട്ട ഡാറ്റ തരം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9225_25521_2199978"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to the state of a phone line when it is in use.</descrip></descripGrp><ntig><termGrp><term id="25521">busy</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2199978">തിരക്കിൽ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9233_187898_1241612"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A server capable of manipulating (i.e. starting and stopping) services remotely on other machines.</descrip></descripGrp><ntig><termGrp><term id="187898">Service Control Manager</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1241612">സേവന നിയന്ത്രണ മാനേജര്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9233_187898_1241613"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A server capable of manipulating (i.e. starting and stopping) services remotely on other machines.</descrip></descripGrp><ntig><termGrp><term id="187898">Service Control Manager</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1241613">SCM</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9233_187899_1241612"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A server capable of manipulating (i.e. starting and stopping) services remotely on other machines.</descrip></descripGrp><ntig><termGrp><term id="187899">SCM</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1241612">സേവന നിയന്ത്രണ മാനേജര്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9233_187899_1241613"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A server capable of manipulating (i.e. starting and stopping) services remotely on other machines.</descrip></descripGrp><ntig><termGrp><term id="187899">SCM</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1241613">SCM</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9238_116710_489663"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A precompiled collection of SQL statements and optional control-of-flow statements stored under a name and processed as a unit. They are stored in an SQL database and can be run with one call from an application.</descrip></descripGrp><ntig><termGrp><term id="116710">stored procedure</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="489663">സ്റ്റോര്‍ഡ് പ്രൊസീജിയര്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9239_145825_1944553"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A worksheet view that displays the areas to be printed and the locations of page breaks. The area to be printed is displayed in white, automatic page breaks appear as dashed lines, and manual page breaks appear as solid lines.</descrip></descripGrp><ntig><termGrp><term id="145825">page break preview</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1944553">പേജ് ബ്രേക്ക് പ്രിവ്യൂ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9241_558509_1229739"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of software functionality designed to solve a specific problem or to provide a new functionality to the user.</descrip></descripGrp><ntig><termGrp><term id="558509">feature</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1229739">സവിശേഷത</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9242_143427_489852"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A field that stores hyperlink addresses.</descrip></descripGrp><ntig><termGrp><term id="143427">hyperlink field</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="489852">ഹൈപ്പര്‍‌ലിങ്ക് മണ്ഡലം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9248_268851_490365"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Files that are used to help detect harmful or unwanted software and to prevent it from installing or running on your computer.</descrip></descripGrp><ntig><termGrp><term id="268851">definitions</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="490365">നിര്‍വചനങ്ങള്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9253_187509_1241614"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables you to configure the style of the lines or images that are displayed between nodes in a TreeView control.</descrip></descripGrp><ntig><termGrp><term id="187509">Line Image Generator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1241614">വര ഇമേജ് ജനറേറ്റര്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9255_298014_490451"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A button on the message toolbar that compares the names in the To, Cc, and Bcc boxes against the names in the Address Book and against those contact folders that you've specified as Outlook Address Books.</descrip></descripGrp><ntig><termGrp><term id="298014">Check Names</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="490451">പേരുകള്‍ പരിശോധിക്കുക</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9259_397168_2793763"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A filtering list that is used by the Connection Filter agent in Exchange Server 2007. IP addresses on the IP Block list are considered spam. Messages originating from an IP address that is on the IP Block list are stopped from entering the Exchange organization.</descrip></descripGrp><ntig><termGrp><term id="397168">IP Block list</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2793763">IP തടയൽ ലിസ്‌റ്റ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9260_321121_490678"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user interface element that provides users with a quick and easy way to navigate across a large group of opened Web pages by providing the user with a visual representation of all of the opened thumbnails. Through this visualization, the user can easily spot and select a desired thumbnail.</descrip></descripGrp><ntig><termGrp><term id="321121">Quick Tabs</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="490678">ദ്രുത ടാബുകള്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9263_464723_1242220"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A library resource consisting of a guest operating system profile, a hardware profile, and one or more virtual hard disks (.vhd files), which can be used to create a new virtual machine. Computer identify information must have been removed from the .vhd file that contains the operating system files by using the System Preparation tool (Sysprep). Self-service users must use designated templates to create their virtual machines.</descrip></descripGrp><ntig><termGrp><term id="464723">virtual machine template</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1242220">അയഥാര്‍ഥ യന്ത്ര ടെംപ്ലേറ്റ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9263_464723_1242221"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A library resource consisting of a guest operating system profile, a hardware profile, and one or more virtual hard disks (.vhd files), which can be used to create a new virtual machine. Computer identify information must have been removed from the .vhd file that contains the operating system files by using the System Preparation tool (Sysprep). Self-service users must use designated templates to create their virtual machines.</descrip></descripGrp><ntig><termGrp><term id="464723">virtual machine template</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1242221">ടെംപ്ലേറ്റ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9263_466975_1242220"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A library resource consisting of a guest operating system profile, a hardware profile, and one or more virtual hard disks (.vhd files), which can be used to create a new virtual machine. Computer identify information must have been removed from the .vhd file that contains the operating system files by using the System Preparation tool (Sysprep). Self-service users must use designated templates to create their virtual machines.</descrip></descripGrp><ntig><termGrp><term id="466975">template</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1242220">അയഥാര്‍ഥ യന്ത്ര ടെംപ്ലേറ്റ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9263_466975_1242221"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A library resource consisting of a guest operating system profile, a hardware profile, and one or more virtual hard disks (.vhd files), which can be used to create a new virtual machine. Computer identify information must have been removed from the .vhd file that contains the operating system files by using the System Preparation tool (Sysprep). Self-service users must use designated templates to create their virtual machines.</descrip></descripGrp><ntig><termGrp><term id="466975">template</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1242221">ടെംപ്ലേറ്റ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9265_187075_1241615"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The definition of the build process. A build event lets you specify an action to occur at a specific time in the build process. For example, you could use a build event to register a file with regsvr32.exe after the project finishes building.</descrip></descripGrp><ntig><termGrp><term id="187075">build event</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1241615">ബില്‍ഡ് ഇവെന്‍റ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9267_271505_1241616"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A query that is saved for all users of a project.</descrip></descripGrp><ntig><termGrp><term id="271505">project query</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1241616">പ്രോജക്റ്റ് അന്വേഷണം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9273_144584_489860"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A "document that contains a set of separate files or subdocuments.</descrip></descripGrp><ntig><termGrp><term id="144584">master document</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="489860">മാസ്റ്റര്‍ പ്രമാണം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9274_1507614_1241617"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A string that is used to identify a user or entity to an operating system, directory service, or distributed system. For example, in Windows® integrated authentication, a login name uses the form "DOMAIN\username."</descrip></descripGrp><ntig><termGrp><term id="1507614">login name</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1241617">ലോഗിന്‍ ID</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9274_76690_1241617"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A string that is used to identify a user or entity to an operating system, directory service, or distributed system. For example, in Windows® integrated authentication, a login name uses the form "DOMAIN\username."</descrip></descripGrp><ntig><termGrp><term id="76690">login ID</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1241617">ലോഗിന്‍ ID</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9275_237771_490246"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of column that displays the results of mathematical or logical operations or expressions instead of stored data.</descrip></descripGrp><ntig><termGrp><term id="237771">calculated column</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="490246">മൂല്യാനുസാരി നിര</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9278_318317_490601"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An audio CD that contains both audio and other multimedia content.</descrip></descripGrp><ntig><termGrp><term id="318317">enhanced audio CD</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="490601">ശേഷികൂട്ടിയ ഓഡിയോ CD</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="928_177550_1961292"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Windows Server 2003 technology that supports creation of single point-in-time shadow copies - also known as snapshots - of single or multiple volumes without impacting file server performance. Volume Shadow Copy Service also supports backups of open files.</descrip></descripGrp><ntig><termGrp><term id="177550">Volume Shadow Copy Service</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1961292">വോളിയം ഷാഡോ കോപ്പി സേവനം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="928_177550_1961293"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Windows Server 2003 technology that supports creation of single point-in-time shadow copies - also known as snapshots - of single or multiple volumes without impacting file server performance. Volume Shadow Copy Service also supports backups of open files.</descrip></descripGrp><ntig><termGrp><term id="177550">Volume Shadow Copy Service</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1961293">VSS</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="928_177551_1961292"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Windows Server 2003 technology that supports creation of single point-in-time shadow copies - also known as snapshots - of single or multiple volumes without impacting file server performance. Volume Shadow Copy Service also supports backups of open files.</descrip></descripGrp><ntig><termGrp><term id="177551">VSS</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1961292">വോളിയം ഷാഡോ കോപ്പി സേവനം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="928_177551_1961293"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Windows Server 2003 technology that supports creation of single point-in-time shadow copies - also known as snapshots - of single or multiple volumes without impacting file server performance. Volume Shadow Copy Service also supports backups of open files.</descrip></descripGrp><ntig><termGrp><term id="177551">VSS</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1961293">VSS</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9284_21852_489020"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The speed at which binary digits are transmitted.</descrip></descripGrp><ntig><termGrp><term id="21852">bit rate</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="489020">ബിറ്റ് നിരക്ക്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9284_21853_489020"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The speed at which binary digits are transmitted.</descrip></descripGrp><ntig><termGrp><term id="21853">bitrate</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="489020">ബിറ്റ് നിരക്ക്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9295_93713_1641602"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To change a program in order to be able to run it on a different platform.</descrip></descripGrp><ntig><termGrp><term id="93713">port</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1641602">പരിഷ്കരിക്കുക</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9299_237015_490227"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows you to set up your computer so that when you insert a device or media, it will play automatically and you won't have to select your preferences every time.</descrip></descripGrp><ntig><termGrp><term id="237015">AutoPlay</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="490227">സ്വയംപ്ലേചെയ്യല്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="93_148267_2725287"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A page where users can search for other pages on the Internet or intranet and then go to the searched for page.</descrip></descripGrp><ntig><termGrp><term id="148267">search page</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2725287">തിരയൽ പേജ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9304_85837_1229740"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A list in which each item or block of text is preceded by a number.</descrip></descripGrp><ntig><termGrp><term id="85837">numbered list</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1229740">നമ്പര്‍ചെയ്ത ലിസ്റ്റ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9305_232851_490143"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A document area that contains a range of text distinct from other areas of text in a document. For example, if a document includes body text, footnotes, and headers, it contains a main text story, footnotes story, and headers story.</descrip></descripGrp><ntig><termGrp><term id="232851">story</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="490143">സ്റ്റോറി</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9308_397142_1960986"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An authentication method that prompts the user for a user name and a password, also called credentials, which are hashed with other data before being transmitted over the network. Digest authentication is available only on domains that have domain controllers that are running Microsoft Windows Server operating systems.</descrip></descripGrp><ntig><termGrp><term id="397142">Digest authentication</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1960986">ഡൈജസ്റ്റ് ഓതന്‍റിക്കേഷന്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="931_91234_1961164"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A private telephone network in an organization. Individual telephone numbers or extension numbers are supported, and calls are automatically routed to them. Users can call each other using extensions. They can also place calls to outside numbers.</descrip></descripGrp><ntig><termGrp><term id="91234">PBX</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1961164">PBX</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="931_91235_1961164"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A private telephone network in an organization. Individual telephone numbers or extension numbers are supported, and calls are automatically routed to them. Users can call each other using extensions. They can also place calls to outside numbers.</descrip></descripGrp><ntig><termGrp><term id="91235">Private Branch Exchange</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1961164">PBX</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9314_294464_490413"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Personal configurations of a program or operating system.</descrip></descripGrp><ntig><termGrp><term id="294464">personal settings</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="490413">സ്വകാര്യ സജ്ജീകരണം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9320_318777_489260"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The – character, based on the width of an uppercase N and used primarily as a connecting element, especially with numbers.</descrip></descripGrp><ntig><termGrp><term id="318777">EN DASH</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="489260">en ഡാഷ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9320_318777_490646"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The – character, based on the width of an uppercase N and used primarily as a connecting element, especially with numbers.</descrip></descripGrp><ntig><termGrp><term id="318777">EN DASH</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="490646">ന്യൂന ചിഹ്നം</term><termNote type="geographicalUsage">IND</termNote><termNote type="part