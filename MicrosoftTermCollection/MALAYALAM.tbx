ote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1444_43230_489183"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of data formatted to allow for easy search and retrieval.</descrip></descripGrp><ntig><termGrp><term id="43230">database</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="489183">ഡാറ്റാബേസ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14441_304428_1229792"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A symbol used to represent the Control key on the keyboard. For example, ^Z means "hold the Control key down and press the Z key."</descrip></descripGrp><ntig><termGrp><term id="304428">caret</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1229792">കേരറ്റ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14443_148138_1241909"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The environment, such as ASP.NET, Internet Explorer, or the Windows shell, in which the common language runtime is typically started and managed. Runtime hosts create application domains in which to run managed code on behalf of the user. See also application domaincpgloA, common language runtimecpgloC, managed codecpgloM.</descrip></descripGrp><ntig><termGrp><term id="148138">runtime host</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1241909">പ്രവര്‍ത്തി സമയ ഹോസ്റ്റ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1446_46257_489215"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An object in a filesystem that contains files and other directories.</descrip></descripGrp><ntig><termGrp><term id="46257">directory</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="489215">ഡയറക്ടറി</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14472_126262_489717"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To accept changes to data in a record.</descrip></descripGrp><ntig><termGrp><term id="126262">update</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="489717">കാലികമാക്കുക</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14483_237219_12