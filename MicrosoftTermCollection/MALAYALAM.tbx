 type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52992_3012678_3013126"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The link in Teams that allows a user to access and add applications like Forms or PowerApps.</descrip></descripGrp><ntig><termGrp><term id="3012678">Apps</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="3013126">ആപ്പുകൾ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52993_3012679_3013143"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The high-fidelity music mode in Teams that offers a richer sound experience when the user transmits music to listeners.</descrip></descripGrp><ntig><termGrp><term id="3012679">Music</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="3013143">സംഗീതം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52994_3012680_3013160"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The link in Teams that allows users to access a participant roster which shows a list of people present in a meeting.</descrip></descripGrp><ntig><termGrp><term id="3012680">People</term><termNote type="partOfSpee