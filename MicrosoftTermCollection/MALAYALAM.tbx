ermNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="3041994">ജാലകത്തിലുള്ള ഗെയിം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53367_3041362_3041997"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Gaming that utilizes a display format in which the game is put into a window that can be moved around and resized.</descrip></descripGrp><ntig><termGrp><term id="3041362">windowed gaming</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="3041997">ജാലകത്തിലുള്ള ഗെയിമിംഗ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53368_3041363_3041662"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Gaming that utilizes a display format in which the game/application is run in a window at full-screen size without a border, creating the experience of full-screen gaming while also allowing for other overlays on top of the game, similar to the windowed gaming experience.</descrip></descripGrp><ntig><termGrp><term id="3041363">borderless-windowed gaming</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="3041662">ബോർഡർ രഹിത ജാലകത്തിലുള്ള ഗെയിമിംഗ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="