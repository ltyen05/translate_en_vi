20_1358916"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An instance that begins when someone signs into a web service or program.</descrip></descripGrp><ntig><termGrp><term id="1331120">session</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1358916">സെഷന്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2668_237838_2741197"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The option under the Columns heading on the Report window that allows users to select columns that contain tracking information such as "Created By" and "Modified On".</descrip></descripGrp><ntig><termGrp><term id="237838">Tracking Columns</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2741197">നിരകൾ ട്രാക്കുചെയ്യൽ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26685_1346459_1358942"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The display name UI label used when there isn’t a display name value available, as when data can't be retrieved or someone hasn’t completely filled out their profile.</descrip></descripGrp><ntig><termGrp><term id="1346459">Someone on Windows Live</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-I