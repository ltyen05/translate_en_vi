 Lookup</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2303421">സ്മാർട്ട് ലുക്കപ്പ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39471_2294327_2303410"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that automatically generates a preview of a link pasted into email, showing a snippet of content from a webpage or video.</descrip></descripGrp><ntig><termGrp><term id="2294327">Link Preview</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2303410">ലിങ്ക് പ്രിവ്യൂ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39472_2906525_2303416"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The service that provides suggestions to users for improving the design of their documents that can be applied with a single tap.</descrip></descripGrp><ntig><termGrp><term id="2906525">Designer</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2303416">PowerPoint ഡിസൈനർ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termN