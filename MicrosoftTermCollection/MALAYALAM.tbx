fSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1242034">വെബ് ഭാഗങ്ങളുടെ പേജ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16363_747618_1242034"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An ASP.NET Web page that includes Web Parts controls that let users personalize the page, such as selecting the information to display.</descrip></descripGrp><ntig><termGrp><term id="747618">Web Part Page</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1242034">വെബ് ഭാഗങ്ങളുടെ പേജ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16364_1636235_2196171"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An 8-digit code used to unlock the SIM card. A Personal Unlocking Key is a type of personal identification number (PIN).</descrip></descripGrp><ntig><termGrp><term id="1636235">PIN unlock key</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2196171">PIN അൺലോക്ക് കീ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16364_1636235_2196180"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An 8-digit code used to unlock the SIM card. A Personal Unlocking Key is a type of personal identification number (PIN).</descrip></descripGrp><ntig><termGrp><term id="1636235">PIN unlock key</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2196180">PUK</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16364_339963_2196171"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An 8-digit code used to unlock the SIM card. A Personal Unlocking Key is a type of personal identification number (PIN).</descrip></descripGrp><ntig><termGrp><term id="339963">Personal Unlocking Key</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2196171">PIN അൺലോക്ക് കീ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16364_339963_2196180"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An 8-digit code used to unlock the SIM card. A Personal Unlocking Key is a type of personal identification number (PIN).</descrip></descripGrp><ntig><termGrp><term id="339963">Personal Unlocking Key</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2196180">PUK</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16364_339964_2196171"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An 8-digit code used to unlock the SIM card. A Personal Unlocking Key is a type of personal identification number (PIN).</descrip></descripGrp><ntig><termGrp><term id="339964">PUK</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2196171">PIN അൺലോക്ക് കീ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16364_339964_2196180"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An 8-digit code used to unlock the SIM card. A Personal Unlocking Key is a type of personal identification number (PIN).</descrip></descripGrp><ntig><termGrp><term id="339964">PUK</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2196180">PUK</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16365_338551_490745"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An item provided and signed by the DCE security server that is both a proof of identity and a list of group memberships.</descrip></descripGrp><ntig><termGrp><term id="338551">privilege attribute certificate</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="490745">പ്രിവിലേജ് ആട്രിബ്യൂട്ട് സര്‍ട്ടിഫിക്കറ്റ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16365_338551_490748"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An item provided and signed by the DCE security server that is both a proof of identity and a list of group memberships.</descrip></descripGrp><ntig><termGrp><term id="338551">privilege attribute certificate</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="490748">PAC</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16365_338565_490745"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An item provided and signed by the DCE security server that is both a proof of identity and a list of group memberships.</descrip></descripGrp><ntig><termGrp><term id="338565">PAC</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="490745">പ്രിവിലേജ് ആട്രിബ്യൂട്ട് സര്‍ട്ടിഫിക്കറ്റ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16365_338565_490748"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An item provided and signed by the DCE security server that is both a proof of identity and a list of group memberships.</descrip></descripGrp><ntig><termGrp><term id="338565">PAC</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="490748">PAC</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16370_566113_1242035"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A control that allows the creator of a load test scenario to adjust the distribution of tests, browser types, and network types, expressed as percentages. You adjust the percentages by moving sliders.</descrip></descripGrp><ntig><termGrp><term id="566113">mix control</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1242035">മിശ്രണ നിയന്ത്രണം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16371_566126_1242036"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The threshold at which alerts are triggered. There are two types of thresholds: warning and critical. Counter set definitions contain predefined thresholds for many key performance indicators.</descrip></descripGrp><ntig><termGrp><term id="566126">counter threshold</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1242036">കൌണ്ടര്‍ പ്രവേശനകവാടം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1639_148511_1230024"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A workbook that is configured to allow multiple users on a network to view and make changes at the same time. Each user who saves the workbook sees the changes that are made by other users.</descrip></descripGrp><ntig><termGrp><term id="148511">shared workbook</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1230024">പങ്കിട്ട വര്‍ക്ക്ബുക്ക്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16400_568187_1242037"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A class whose definition is split over two or more source files. Each source file contains a section of the class definition, and all parts are combined when the application is compiled.</descrip></descripGrp><ntig><termGrp><term id="568187">partial class</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1242037">ഭാഗിക ക്ലാസ്സ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16403_583314_1242038"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A rule that clarifies whether an acronym is to be spelt with upper- or lowercase letter or a mix.</descrip></descripGrp><ntig><termGrp><term id="583314">acronym casing guideline</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1242038">അക്രോണിം കേസുചെയ്യുന്ന സൂചനകള്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16404_583699_1242039"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An attribute that tells the CLR to remove the implicit LinkDemands. By default, strongly named, fully trusted assemblies are given an implicit LinkDemand for FullTrust on every public and protected method of every publicly visible class. Essentially, any code that someone outside of your assembly could use as an entry point into your code is protected with this demand.</descrip></descripGrp><ntig><termGrp><term id="583699">Allow Partially Trusted Callers Attribute</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1242039">ഭാഗികമായി വിശ്വാസമുള്ള കോളേഴ്സിന്‍റെ ധര്‍മം അനുവദിക്കല്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16405_583705_1242228"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A background process that receives, runs, and reports on Team Foundation Server builds and other property settings on a single computer. The build agent communicates with the build controller, usually located on another computer.</descrip></descripGrp><ntig><termGrp><term id="583705">build agent</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1242228">ബില്‍ഡ് ഏജന്‍റ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16406_583706_1242229"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of build activities and the conditions under which the workflow is activated, that together build a single solution or a set of solutions in a team project.</descrip></descripGrp><ntig><termGrp><term id="583706">build definition</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1242229">ബില്‍ഡ് നിര്‍വചനം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16408_583767_1242040"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The degree of coupling to unique classes through parameters, local variables, return types, method calls, generic or template instantiations, base classes, interface implementations, fields defined on external types, and attribute decoration.</descrip></descripGrp><ntig><termGrp><term id="583767">class coupling</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1242040">ക്ലാസ്സ് കപ്ലിംഗ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16409_583769_1242041"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A software measure that provides developers better insight into the code they are developing. By taking advantage of code metrics, developers can understand which types and/or methods should be reworked or more thoroughly tested. Development teams can identify potential risks, understand the current state of a project, and track progress during software development.</descrip></descripGrp><ntig><termGrp><term id="583769">code metric</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1242041">കോഡ് മെട്രിക്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16410_583773_1242042"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An operator that subtracts 1 from its operand depending on the position of the operator.</descrip></descripGrp><ntig><termGrp><term id="583773">decrement operator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1242042">ക്ഷയിച്ച ഓപ്പറേറ്റര്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16411_583774_1242043"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An operator that increases an integer typically by 1.</descrip></descripGrp><ntig><termGrp><term id="583774">increment operator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1242043">വര്‍ദ്ധന ഓപ്പറേറ്റര്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16412_583780_1242044"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An SDK that provides access to debug information stored in program database (.pdb) files generated by Microsoft post-compiler tools.</descrip></descripGrp><ntig><termGrp><term id="583780">Debug Interface Access SDK</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1242044">SDK പൊതുപ്രതലം പ്രവേശനം ഡീബഗ്ഗു ചെയ്യല്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16412_583780_1242045"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An SDK that provides access to debug information stored in program database (.pdb) files generated by Microsoft post-compiler tools.</descrip></descripGrp><ntig><termGrp><term id="583780">Debug Interface Access SDK</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1242045">DIA SDK</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16412_583782_1242044"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An SDK that provides access to debug information stored in program database (.pdb) files generated by Microsoft post-compiler tools.</descrip></descripGrp><ntig><termGrp><term id="583782">DIA SDK</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1242044">SDK പൊതുപ്രതലം പ്രവേശനം ഡീബഗ്ഗു ചെയ്യല്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16412_583782_1242045"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An SDK that provides access to debug information stored in program database (.pdb) files generated by Microsoft post-compiler tools.</descrip></descripGrp><ntig><termGrp><term id="583782">DIA SDK</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1242045">DIA SDK</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16413_583812_1242046"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The name given to a programming entity, such as a class or a variable.</descrip></descripGrp><ntig><termGrp><term id="583812">specifier</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1242046">വിശേഷകം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16414_583814_2576085"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature of an integrated development environment (IDE) that provides logical code elements that the user can select from a drop-down menu while coding.</descrip></descripGrp><ntig><termGrp><term id="583814">IntelliSense</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2576085">IntelliSense</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16415_583815_1242047"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A value between 0 and 100 that represents the relative ease of maintaining the code. A high value means better maintainability.</descrip></descripGrp><ntig><termGrp><term id="583815">maintainability index</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1242047">സംരക്ഷിക്കാവുന്ന സൂചിക</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16416_583822_1242048"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A class designed to serialize and deserialize objects.</descrip></descripGrp><ntig><termGrp><term id="583822">serialization class</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1242048">പരമ്പരയാക്കല്‍ ക്ലാസ്സ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16417_583828_1242049"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in Visual Studio Team Edition that records the actions you perform while you browse a Web site. As you move through the site, recorded requests are added to the Web test.</descrip></descripGrp><ntig><termGrp><term id="583828">Web Test Recorder</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1242049">വെബ് പരിശോധന റെക്കോര്‍ഡര്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16418_583829_1242050"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A program that assists partners in building, integrating, and selling applications, tools, components, and even entire programming languages with Visual Studio 2005 and Visual Studio 2005 Team System. The VSIP program offers unique benefits to all its members—developers, tools ISVs, and line of business and infrastructure ISVs.</descrip></descripGrp><ntig><termGrp><term id="583829">Visual Studio Industry Partner Program</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1242050">വിഷ്വല്‍ സ്റ്റുഡിയോ വ്യവസായ പങ്കാളിത്ത പ്രോഗ്രാം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16418_583829_1242051"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A program that assists partners in building, integrating, and selling applications, tools, components, and even entire programming languages with Visual Studio 2005 and Visual Studio 2005 Team System. The VSIP program offers unique benefits to all its members—developers, tools ISVs, and line of business and infrastructure ISVs.</descrip></descripGrp><ntig><termGrp><term id="583829">Visual Studio Industry Partner Program</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1242051">VSIP പ്രോഗ്രാം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16418_583831_1242050"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A program that assists partners in building, integrating, and selling applications, tools, components, and even entire programming languages with Visual Studio 2005 and Visual Studio 2005 Team System. The VSIP program offers unique benefits to all its members—developers, tools ISVs, and line of business and infrastructure ISVs.</descrip></descripGrp><ntig><termGrp><term id="583831">VSIP Program</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1242050">വിഷ്വല്‍ സ്റ്റുഡിയോ വ്യവസായ പങ്കാളിത്ത പ്രോഗ്രാം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16418_583831_1242051"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A program that assists partners in building, integrating, and selling applications, tools, components, and even entire programming languages with Visual Studio 2005 and Visual Studio 2005 Team System. The VSIP program offers unique benefits to all its members—developers, tools ISVs, and line of business and infrastructure ISVs.</descrip></descripGrp><ntig><termGrp><term id="583831">VSIP Program</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1242051">VSIP പ്രോഗ്രാം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16419_583832_1242052"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A sequence of object initializers that are assigned to the collection elements in the same statement in which the collection is constructed.</descrip></descripGrp><ntig><termGrp><term id="583832">element initializer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1242052">ഘടകാംശ ആരംഭകാരി</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16419_584055_1242052"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A sequence of object initializers that are assigned to the collection elements in the same statement in which the collection is constructed.</descrip></descripGrp><ntig><termGrp><term id="584055">collection initializer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1242052">ഘടകാംശ ആരംഭകാരി</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16420_583833_1242053"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An assignment statement that is executed when the variable's class is initialized.</descrip></descripGrp><ntig><termGrp><term id="583833">variable initializer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1242053">വേരിയബിള്‍ ആരംഭകാരി</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16422_583835_1242054"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A sequence of variable initializers that are assigned to the array elements in the same statement in which the array is declared.</descrip></descripGrp><ntig><termGrp><term id="583835">array initializer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1242054">അണി ആരംഭകാരി</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16423_584059_1242055"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An attack that attempts to send executable scripts to your application with the intent of having other users run it. A typical script injection attack sends script to a page that stores the script in a database, so that another user who views the data inadvertently runs the code.</descrip></descripGrp><ntig><termGrp><term id="584059">script injection attack</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1242055">സ്ക്രിപ്റ്റ് സന്നിവേശിപ്പിക്കല്‍ ആക്രമണം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16425_584063_1242056"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An attack that attempts to compromise your database (and potentially the computer on which the database is running) by creating SQL commands that are executed instead of, or in addition to, the commands that you have built into your application.</descrip></descripGrp><ntig><termGrp><term id="584063">SQL injection attack</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1242056">SQL സന്നിവേശിപ്പിക്കല്‍ ആക്രമണം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16427_3099101_1242057"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A control that is used with a window that does not have enough display area to show all of its content. The pager control allows the user to scroll to the area of the window that is not currently in view.</descrip></descripGrp><ntig><termGrp><term id="3099101">pager</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1242057">പേജര്‍ നിയന്ത്രണം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16427_584196_1242057"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A control that is used with a window that does not have enough display area to show all of its content. The pager control allows the user to scroll to the area of the window that is not currently in view.</descrip></descripGrp><ntig><termGrp><term id="584196">pager control</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1242057">പേജര്‍ നിയന്ത്രണം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16428_584203_1242058"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A cryptographic function that generates key material from a secret value.</descrip></descripGrp><ntig><termGrp><term id="584203">key derivation function</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1242058">കീ ഡെറിവേഷന്‍ ഫങ്ഷന്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16428_584203_1242059"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A cryptographic function that generates key material from a secret value.</descrip></descripGrp><ntig><termGrp><term id="584203">key derivation function</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1242059">KDF</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16428_584214_1242058"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A cryptographic function that generates key material from a secret value.</descrip></descripGrp><ntig><termGrp><term id="584214">KDF</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1242058">കീ ഡെറിവേഷന്‍ ഫങ്ഷന്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16428_584214_1242059"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A cryptographic function that generates key material from a secret value.</descrip></descripGrp><ntig><termGrp><term id="584214">KDF</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1242059">KDF</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16429_584209_1242060"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An enumerated constant that indicates how an IXmlWriter produces the standalone attribute of the XML declaration. The following are the possible values: omit, yes, no.</descrip></descripGrp><ntig><termGrp><term id="584209">XML standalone</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1242060">XML സ്റ്റാന്‍റ് എലോണ്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16430_584216_1242061"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The thread, or object within a process, that detects the presence of media.</descrip></descripGrp><ntig><termGrp><term id="584216">media sense thread</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1242061">മീഡിയാ സെന്‍സ് ത്രെഡ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16431_584217_1242062"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A remote method invocation sent from a client (typically a web browser) to a web server over the HTTP protocol. Examples include GET, POST, PUT, etc.</descrip></descripGrp><ntig><termGrp><term id="584217">HTTP method</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1242062">HTTP രീതി</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16432_584220_1242063"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A binary tree that minimizes the product of a leaf’s weight and its distance from the root, for all leaves.</descrip></descripGrp><ntig><termGrp><term id="584220">Huffman tree</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1242063">ഹഫ്മാന്‍ ശാഖി</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16434_584223_1242064"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A clause that specifies the amount by which the loop counter is incremented each time a For...Next loop is traversed. In the following example, "Step 2" is the step clause: For loopCounter = 1 to 100 Step 2</descrip></descripGrp><ntig><termGrp><term id="584223">step clause</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1242064">ഉപവാക്യം കടക്കുക</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16435_584224_1242065"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The command that runs if the dependency is not current.</descrip></descripGrp><ntig><termGrp><term id="584224">inference rule</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1242065">നിഗമന നിയമം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16438_584264_1877979"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A column chart subtype that compares values across categories. The categories are organized horizontally, and values vertically, to emphasize variation over time.</descrip></descripGrp><ntig><termGrp><term id="584264">clustered column chart</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1877979">ക്ലസ്റ്റര്‍ ചെയ്‌ത നിര ചാര്‍ട്ട്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16439_584277_1877980"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A column chart subtype that compares the percentage that each value contributes to a total across categories.</descrip></descripGrp><ntig><termGrp><term id="584277">100% stacked column chart</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1877980">100% അടുക്കിയ നിര ചാര്‍ട്ട്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16440_584278_1877981"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A column chart subtype that compares data points along two axes.</descrip></descripGrp><ntig><termGrp><term id="584278">3-D column chart</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1877981">3-D നിര ചാര്‍ട്ട്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16441_584279_1877982"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A variation on a column chart that uses cylinder shapes instead of rectangular columns.</descrip></descripGrp><ntig><termGrp><term id="584279">cylinder chart</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1877982">സിലിണ്ടര്‍ ചാര്‍ട്ട്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16442_584280_1877983"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A variation on a column chart that uses cone shapes instead of rectangular columns.</descrip></descripGrp><ntig><termGrp><term id="584280">cone chart</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1877983">കോണ്‍ ചാര്‍ട്ട്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16443_584281_1877984"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A variation on a column chart that uses pyramid shapes instead of rectangular columns.</descrip></descripGrp><ntig><termGrp><term id="584281">pyramid chart</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1877984">പിരമിഡ് ചാര്‍ട്ട്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16444_584282_1877985"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A stacked column chart that creates the effect of floating columns by making the first data series invisible. The result is a chart that depicts minimum and maximum values.</descrip></descripGrp><ntig><termGrp><term id="584282">floating column chart</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1877985">ഫ്ലോട്ടിംഗ് നിര ചാര്‍ട്ട്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16445_584286_1877986"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A bar chart subtype that compares the percentage that each value contributes to a total across categories.</descrip></descripGrp><ntig><termGrp><term id="584286">100% stacked bar chart</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1877986">100% അടുക്കിയ ബാര്‍ ചാര്‍ട്ട്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16446_584288_1877987"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A variation on a bar chart that uses cone shapes instead of horizontal rectangles.</descrip></descripGrp><ntig><termGrp><term id="584288">horizontal cone chart</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1877987">തിരശ്ചീന കോണ്‍ ചാര്‍ട്ട്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16447_584290_1877988"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A variation on a bar chart that uses pyramid shapes instead of horizontal rectangles.</descrip></descripGrp><ntig><termGrp><term id="584290">horizontal pyramid chart</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1877988">തിരശ്ചീന പിരമിഡ് ചാര്‍ട്ട്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16448_584291_1877989"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A variation on a bar chart that uses cylinder shapes instead of horizontal rectangles.</descrip></descripGrp><ntig><termGrp><term id="584291">horizontal cylinder chart</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1877989">തിരശ്ചീന സിലിണ്ടര്‍ ചാര്‍ട്ട്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16449_584337_1242066"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method that constitutes a query pattern and that is implemented by a LINQ provider for a specific domain. Standard query operators are defined in the System.Linq.Enumerable class.</descrip></descripGrp><ntig><termGrp><term id="584337">standard query operator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1242066">സ്റ്റാന്‍ഡേര്‍ഡ് അന്വേഷണ ഓപ്പറേറ്റര്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16450_584392_1242067"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A diagram element that represents a class in a domain-specific language.</descrip></descripGrp><ntig><termGrp><term id="584392">domain class</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1242067">ഡൊമൈന്‍ ക്ലാസ്സ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16451_3031363_1242068"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A custom language that targets a problem domain and defines the problem at a high level of abstraction.</descrip></descripGrp><ntig><termGrp><term id="3031363">DSL</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1242068">ഡൊമൈന്‍ സ്പഷ്ടമായ ഭാഷ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16451_584393_1242068"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A custom language that targets a problem domain and defines the problem at a high level of abstraction.</descrip></descripGrp><ntig><termGrp><term id="584393">domain-specific language</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1242068">ഡൊമൈന്‍ സ്പഷ്ടമായ ഭാഷ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16452_584778_1242069"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A diagram element that represents an embedding or reference relationship in a domain-specific language.</descrip></descripGrp><ntig><termGrp><term id="584778">domain relationship</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1242069">ഡൊമൈന്‍ ബന്ധുത്വം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16453_584779_1242070"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To restore individual file revisions from a shelveset to your workspace.</descrip></descripGrp><ntig><termGrp><term id="584779">unshelve</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1242070">ഷെല്‍ഫ് സ്ഥാപിക്കാതിരിക്കല്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16454_584781_1242071"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application that has some sort of customization, such as an application-level add-in or a document-level customization, for which the application acts as a host.</descrip></descripGrp><ntig><termGrp><term id="584781">host application</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1242071">ഹോസ്റ്റ് പ്രയോഗം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16455_584782_1242072"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An object that is native to a host application (such as Microsoft Office Word or Microsoft Office Excel) to which data binding and events have been added. Examples of host controls include Bookmark controls and ListObject controls.</descrip></descripGrp><ntig><termGrp><term id="584782">host control</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1242072">ഹോസ്റ്റ് നിയന്ത്രണം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16456_584783_1242073"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An object that is native to a host application (such as Microsoft Office Word or Microsoft Office Excel) to which you can add host controls. Examples of host items include Document and Worksheet.</descrip></descripGrp><ntig><termGrp><term id="584783">host item</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1242073">ഹോസ്റ്റ് ഇനം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16457_584784_1242074"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application in the system that is not yet bound to a logical server on the deployment diagram.</descrip></descripGrp><ntig><termGrp><term id="584784">unbound application</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1242074">സ്വതന്ത്ര പ്രയോഗം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16458_584845_1242075"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A supplemental program that modifies or adds functionality to an existing program or application. The modifications are available to the application at all times.</descrip></descripGrp><ntig><termGrp><term id="584845">application-level add-in</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1242075">പ്രയോഗ-നില ഉള്‍പ്പെടുത്തുക</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16459_584846_1242076"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A report in XML- or HTML-format that is associated with a deployment diagram. You can use these reports to create installation and deployment scripts.</descrip></descripGrp><ntig><termGrp><term id="584846">deployment report</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1242076">ഉപയോഗിക്കല്‍ റിപ്പോര്‍ട്ട്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16460_584850_1242077"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A customizable extension to Microsoft Office Outlook forms.</descrip></descripGrp><ntig><termGrp><term id="584850">form region</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1242077">രൂപ മേഖല</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16461_584854_1242078"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A preconfigured logical server in the Toolbox that you can use to define logical servers on the logical datacenter diagram.</descrip></descripGrp><ntig><termGrp><term id="584854">logical server prototype</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1242078">ലോജിക്കല്‍ സെര്‍വര്‍ ആദ്യതരം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16462_584855_1242079"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The top-level application system for which you are defining and evaluating deployment. The System View window displays all applications in the system, including the full expansion of all systems in the root system.</descrip></descripGrp><ntig><termGrp><term id="584855">root application system</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1242079">മൂലപ്രയോഗസിസ്റ്റം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16463_584856_1242080"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application-level add-in or document-level customization. Generally, an extension to Microsoft Office that is created by using Visual Studio Tools for Office.</descrip></descripGrp><ntig><termGrp><term id="584856">managed code extension</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular<