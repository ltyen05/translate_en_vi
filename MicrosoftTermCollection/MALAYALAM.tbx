693151"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft web browser.</descrip></descripGrp><ntig><termGrp><term id="299920">Internet Explorer</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1693151">Internet Explorer</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13579_392123_1693151"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft web browser.</descrip></descripGrp><ntig><termGrp><term id="392123">Windows Internet Explorer</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1693151">Internet Explorer</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13587_25017_2485783"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To combine products for sale as a lot. Frequently, operating system software and some widely used applications are bundled with a computer system for sale.</descrip></descripGrp><ntig><termGrp><term id="25017">bundle</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2485783">ബണ്ടിൽ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termN