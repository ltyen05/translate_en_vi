conveyed through highlighting.</descrip></descripGrp><ntig><termGrp><term id="55239">focus</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1877721">ഫോക്കസ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12544_76022_489425"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A security group that can be granted rights and permissions only to resources on the computer on which the group is created. Local groups can have any user accounts that are local to the computer as members, as well as users, groups, and computers from a domain to which the computer belongs.</descrip></descripGrp><ntig><termGrp><term id="76022">local group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="489425">പ്രാദേശിക സംഘം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12545_1984166_1241801"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A block of memory reserved for index and table data pages.</descrip></descripGrp><ntig><termGrp><term id="1984166">buffer cache</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1241801">ബഫര്‍ പൂള്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="gramma