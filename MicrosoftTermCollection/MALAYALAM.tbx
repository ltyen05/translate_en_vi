64"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The most trusted certification authority (CA), which is at the top of a certification hierarchy. The root CA has a self-signed certificate.</descrip></descripGrp><ntig><termGrp><term id="1513452">root CA</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1641864">അടിസ്ഥാന CA</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35766_2068029_2196250"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ability to emulate the functionality of traditional smart cards, but instead of requiring the purchase of additional hardware, it uses technology that users already own and are more likely to have with them at all times.</descrip></descripGrp><ntig><termGrp><term id="2068029">virtual smart card</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2196250">വെർച്വൽ സ്മാർട്ട് കാർഡ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35767_2068030_2196126"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An option in the viewfinder for available lens apps.</descrip></descripGrp><ntig><termGrp><term id="2068030">lens picker</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><