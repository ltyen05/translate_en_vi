25488"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A data type used in some programming languages, notably C, to declare variables that can store floating-point numbers.</descrip></descripGrp><ntig><termGrp><term id="1520">float</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1425488">ഫ്ളോട്ട്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11330_360145_490844"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A program you use to view, print, and electronically mail a snapshot, such as a report snapshot.</descrip></descripGrp><ntig><termGrp><term id="360145">Snapshot Viewer</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="490844">സ്നാപ്‌ഷോട്ട് വ്യൂവര്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11332_397182_1961103"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A managed folder that appears in Outlook by default, to which messaging records management has been applied, and whose the retention and journaling is controlled by managed content settings that are applied to the folder.</descrip></descripGrp><ntig><termGrp><term id="397182">managed default folder</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"