03_2006875"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A series of 11 alphanumeric characters used by the Indian Financial System to identify banks participating in the NEFT system and to route transactions between banks.</descrip></descripGrp><ntig><termGrp><term id="1993203">IFSC code</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2006875">IFSC കോഡ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34520_1993206_2006591"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A commercial bank in Brazil.</descrip></descripGrp><ntig><termGrp><term id="1993206">Banco do Brasil</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2006591">ബാന്‍‌കോ ഡോ ബ്രസീല്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34521_1993207_2006786"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A series of 9 digits used to identify Russian Federation banks for routing transactions.</descrip></descripGrp><ntig><termGrp><term id="1993207">bank BIK</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2006786">BIK</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termN