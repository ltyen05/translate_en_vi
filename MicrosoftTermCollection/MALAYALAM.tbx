">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1241631">ജീവിത ശൈലി ക്ഷണികചിത്രം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9648_233439_1961182"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An audio message played over the telephone to explain valid options to users.</descrip></descripGrp><ntig><termGrp><term id="233439">prompt</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1961182">പ്രോം‍പ്റ്റ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="965_317875_490574"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To display the subentries contained within a folder or outline view.</descrip></descripGrp><ntig><termGrp><term id="317875">expand</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="490574">വികസിപ്പിക്കുക</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9651_138544_1877779"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A visual cue to indicate which formatting will be applied when you double-click: a left-aligned, centered, or right-aligned