d PC-compatible computers, a key whose function changes depending on the application program. Usually it erases the character under the cursor, although in some applications it can erase selected text or graphics.</descrip></descripGrp><ntig><termGrp><term id="44281">DELETE key</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="489189">DELETE കീ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12848_541884_1241822"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A generic entity that all other entities in the system inherit base functionality from.</descrip></descripGrp><ntig><termGrp><term id="541884">base entity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1241822">അടിസ്ഥാന അസ്തിത്വം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12850_271514_1241823"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The purpose, driving factors, and background for building the system. The goal of the project vision is to align the team around a central purpose.</descrip></descripGrp><ntig><termGrp><term id="271514">project vision</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1241823">പ്രോജക്റ്റ് വിഷന്‍</term><termNote type="g