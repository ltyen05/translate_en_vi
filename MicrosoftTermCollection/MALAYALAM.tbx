-IN"><ntig><termGrp><term id="2826384">ലൈറ്റ് മോഡ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49918_2924850_2924974"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A visual display mode in the user interface of some Office applications, such as OneNote and Outlook, that uses a light background.</descrip></descripGrp><ntig><termGrp><term id="2924850">Light</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2924974">ലൈറ്റ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49919_2823678_2826387"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A digital file that resembles, or is an image of, a printout.</descrip></descripGrp><ntig><termGrp><term id="2823678">virtual printout</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2826387">അയഥാർത്ഥ പ്രിന്റൗട്ട്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4992_251889_1241376"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of work item that records a constraint on the system such as performance, load, stress, security mechanism, or platfor