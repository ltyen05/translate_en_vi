p><descrip type="definition">Saved objects associated with a map, such as a locations and routes.</descrip></descripGrp><ntig><termGrp><term id="2099909">favorites</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2344944">പ്രിയപ്പെട്ടവ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="369_530823_1241121"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A subset of ANSI SQL with semantic changes adapted to Windows Management Instrumentation (WMI).</descrip></descripGrp><ntig><termGrp><term id="530823">WMI Query Language</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1241121">WMI അന്വേഷണഭാഷ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="369_530823_1241122"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A subset of ANSI SQL with semantic changes adapted to Windows Management Instrumentation (WMI).</descrip></descripGrp><ntig><termGrp><term id="530823">WMI Query Language</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1241122">WQL</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNo