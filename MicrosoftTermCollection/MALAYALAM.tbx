4741">FTE</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39489_2300781_2304747"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A unit of measure for the workload of an employed person or a student that allows comparison to one full-time workload in the particular environment.</descrip></descripGrp><ntig><termGrp><term id="2300781">full-time equivalent</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2304747">മുഴുവൻ സമയ സമാനം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39489_2300782_2304741"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A unit of measure for the workload of an employed person or a student that allows comparison to one full-time workload in the particular environment.</descrip></descripGrp><ntig><termGrp><term id="2300782">FTE</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2304741">FTE</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39489_2300782_2304747"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A unit of measure for the workload of an employed person or a student that allows compari