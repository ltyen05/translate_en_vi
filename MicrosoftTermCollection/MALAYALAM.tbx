pGrp><descrip type="definition">A wizard in Smart Device Development. It is used to create an MFC DLL project. The users get a working starter application that has built-in functionality that, when it is compiled, will implement the basic features of a DLL.</descrip></descripGrp><ntig><termGrp><term id="187617">MFC Smart Device DLL Wizard</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1241950">MFC സ്മാര്‍ട്ട് ഉപാധിDLL വിസാര്‍ഡ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15111_131155_489747"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The restarting of a running computer without first turning off the power.</descrip></descripGrp><ntig><termGrp><term id="131155">warm boot</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="489747">ഊഷ്മള ബൂട്ട്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15111_131155_489748"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The restarting of a running computer without first turning off the power.</descrip></descripGrp><ntig><termGrp><term id="131155">warm boot</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="489748">ഊഷ്മള ആരംഭം</term><termNote type="geographicalUsage">IND