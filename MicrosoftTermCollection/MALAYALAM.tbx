26"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The offer for Microsoft 365 that includes business services—email, file storage and sharing, Office Online, meetings and IM, and more. Office applications not included.</descrip></descripGrp><ntig><termGrp><term id="2815537">Office 365 E1</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2815826">Office 365 E1</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49755_2815538_2815847"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The offer for Microsoft 365 that includes Skype for Business integrations with telephone system, Office 365 Advanced Threat Protection, Customer Lockbox,Power BI Pro, as well as both the Microsoft Office desktop apps and the online versions. It includes all the features of ProPlus and Office 365 E1 plus security and compliance tools, such as legal hold, data loss prevention, and more.</descrip></descripGrp><ntig><termGrp><term id="2815538">Office 365 E3</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2815847">Office 365 E3</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49756_2815539_2815868"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The offer for Microsoft 365 that includes Skype for Business integrations with telephone system, Office 365 Advanced Threat Protection, Customer Lockbox,Power BI Pro, as well as both the Microsoft Office desktop apps and the online versions. It includes all the features of Office 365 E3 plus advanced security, analytics, and voice capabilities.</descrip></descripGrp><ntig><termGrp><term id="2815539">Office 365 E5</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2815868">Office 365 E5</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4976_237199_1241371"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A point at which a technical project document (requirements specification, functional specification, etc.) or developed component of the solution cannot change without significant justification and approval by key project stakeholders.</descrip></descripGrp><ntig><termGrp><term id="237199">code freeze</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1241371">കോഡ് മരവിപ്പിക്കല്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49764_2815600_2818337"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of user account attributes, segments, "block" and/or "allow" policies, and policy application definitions that together establish information barriers within an organization.</descrip></descripGrp><ntig><termGrp