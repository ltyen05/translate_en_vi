ll characters in a run have the same directional properties.</descrip></descripGrp><ntig><termGrp><term id="1508864">run</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1878276">റണ്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29481_1508936_1878277"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A reading order and alignment setting that is commonly used in controls that display text. When you select the Context setting, the reading order is determined by the first strong character (not a numeral or special character) that you type.</descrip></descripGrp><ntig><termGrp><term id="1508936">Context</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1878277">സന്ദര്‍ഭം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29483_1508938_1878278"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In an outline, to change a heading to body text or to a lower heading level: for example, to change from Heading 5 to Heading 6.</descrip></descripGrp><ntig><termGrp><term id="1508938">demote</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1878278">തരംതാഴ്‌ത്തുക</term><termNote type="geographicalUsage">IND</ter