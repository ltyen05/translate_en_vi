le corresponds to the value in the matching field or fields of many records in the related table.</descrip></descripGrp><ntig><termGrp><term id="87506">one-to-many relationship</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1229721">ഒന്നില്‍ നിന്ന് പലതിലേക്കുള്ള ബന്ധം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7376_1146759_489303"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A class of computer programs in which one or more users interact with the computer as a form of entertainment.</descrip></descripGrp><ntig><termGrp><term id="1146759">video game</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="489303">ഗെയിം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7376_57639_489303"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A class of computer programs in which one or more users interact with the computer as a form of entertainment.</descrip></descripGrp><ntig><termGrp><term id="57639">game</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="489303">ഗെയിം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7376_730281_489303"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A class of computer programs in which one or more users interact with the computer as a form of entertainment.</descrip></descripGrp><ntig><termGrp><term id="730281">computer game</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="489303">ഗെയിം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7384_46146_489213"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A technology that allows certain devices, such as hard disks and CD or DVD drives, to transfer information directly through the computer's memory without using the computer's processor. DMA improves the performance of the device and frees the computer's processor so it can perform other tasks.</descrip></descripGrp><ntig><termGrp><term id="46146">direct memory access</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="489213">ഡയറക്ട് മെമ്മറി അക്സസ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7384_46146_489214"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A technology that allows certain devices, such as hard disks and CD or DVD drives, to transfer information directly through the computer's memory without using the computer's processor. DMA improves the performance of the device and frees the computer's processor so it can perform other tasks.</descrip></descripGrp><ntig><termGrp><term id="46146">direct memory access</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="489214">DMA</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7384_46147_489213"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A technology that allows certain devices, such as hard disks and CD or DVD drives, to transfer information directly through the computer's memory without using the computer's processor. DMA improves the performance of the device and frees the computer's processor so it can perform other tasks.</descrip></descripGrp><ntig><termGrp><term id="46147">DMA</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="489213">ഡയറക്ട് മെമ്മറി അക്സസ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7384_46147_489214"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A technology that allows certain devices, such as hard disks and CD or DVD drives, to transfer information directly through the computer's memory without using the computer's processor. DMA improves the performance of the device and frees the computer's processor so it can perform other tasks.</descrip></descripGrp><ntig><termGrp><term id="46147">DMA</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="489214">DMA</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7389_217332_2196110"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A digital cellular phone technology (standard) first deployed in 1992. GSM uses narrowband TDMA, which allows eight simultaneous calls on the same radio frequency.</descrip></descripGrp><ntig><termGrp><term id="217332">Global System for Mobile Communications</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2196110">GSM</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7389_217333_2196110"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A digital cellular phone technology (standard) first deployed in 1992. GSM uses narrowband TDMA, which allows eight simultaneous calls on the same radio frequency.</descrip></descripGrp><ntig><termGrp><term id="217333">GSM</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2196110">GSM</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7395_46512_489218"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A notice that warns that the manufacturer of the product limits liability in certain situations/uses.</descrip></descripGrp><ntig><termGrp><term id="46512">disclaimer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="489218">നിരാകരണം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7413_43971_1241497"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To restore the contents of a compressed file to its original form.</descrip></descripGrp><ntig><termGrp><term id="43971">decompress</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1241497">മര്‍ദ്ദം കുറയ്ക്കുക</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7413_736800_1241497"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To restore the contents of a compressed file to its original form.</descrip></descripGrp><ntig><termGrp><term id="736800">uncompress</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1241497">മര്‍ദ്ദം കുറയ്ക്കുക</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="gram