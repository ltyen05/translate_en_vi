607">target application</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2726925">സുരക്ഷിത സ്‌റ്റോര്‍ ടാർഗെറ്റ് ആപ്ലിക്കേഷൻ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25056_2718607_2726927"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An external data source that users connect to using Secure Store.</descrip></descripGrp><ntig><termGrp><term id="2718607">target application</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2726927">ടാർഗെറ്റ് ആപ്ലിക്കേഷൻ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25056_2718608_2726925"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An external data source that users connect to using Secure Store.</descrip></descripGrp><ntig><termGrp><term id="2718608">Secure Store target application</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2726925">സുരക്ഷിത സ്‌റ്റോര്‍ ടാർഗെറ്റ് ആപ്ലിക്കേഷൻ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25056_2718608_2726927"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An external data source that users connect to using Secure Store.</descrip></descripGrp><ntig><termGrp><term id="2718608">Secure Store target application</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2726927">ടാർഗെറ്റ് ആപ്ലിക്കേഷൻ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25060_1167275_1878190"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An item in the global address list that provides an easy way to send messages to a group of people. A public group can include any item from a global address list, including other public groups.</descrip></descripGrp><ntig><termGrp><term id="1167275">public group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1878190">പൊതു ഗ്രൂപ്പ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25061_1167276_2927918"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process used to try to locate the name of a person, from a directory or other information store, based on a telephone number.</descrip></descripGrp><ntig><termGrp><term id="1167276">reverse number lookup</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><t