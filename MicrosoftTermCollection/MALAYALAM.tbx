Set><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2497387">സ്നിപ്പിംഗ് ടൂൾ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20848_748169_1229430"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To mark an email conversation so that all current and future messages in the conversation are automatically moved to the Deleted Items folder.</descrip></descripGrp><ntig><termGrp><term id="748169">ignore</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1229430">അവഗണിക്കുക</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20849_748170_1229431"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A special control that shows pictures, names and titles of people who are attending a meeting, or who are the recipients of an email message.</descrip></descripGrp><ntig><termGrp><term id="748170">Attendee/Recipient List</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1229431">ഹാജരായവര്‍/സ്വീകര്‍ത്താവ് ലിസ്റ്റ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20851_1140414_2818339"><langSet xml:lang="en-US"><descripGrp><descri