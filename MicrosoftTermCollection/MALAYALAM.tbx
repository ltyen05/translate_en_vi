tig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2596172">ഉള്ളടക്ക പായ്‌ക്ക്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46031_2594560_2793767"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A repository to store secrets in an encrypted way.</descrip></descripGrp><ntig><termGrp><term id="2594560">secured secret store</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2793767">രഹസ്യ സ്‌റ്റോർ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46031_2793216_2793767"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A repository to store secrets in an encrypted way.</descrip></descripGrp><ntig><termGrp><term id="2793216">secret store</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2793767">രഹസ്യ സ്‌റ്റോർ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46046_2594916_2597628"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The area in Windows Defender Security Center where people can see, access, and troubleshoot features related to their accounts, including device login, Windows Hello, Dynamic Lock, and other convenience and security features related to accounts and login.</descrip></descripGrp><ntig><termGrp><term id="2594916">account protection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2597628">അക്കൗണ്ട് പരിരക്ഷ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46047_2594920_2597629"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The area in Windows Defender Security Center, within Ransomware protection, where customers can set up or initiate file restores with cloud providers, to help recover from a ransomware attack (which often encrypts files).</descrip></descripGrp><ntig><termGrp><term id="2594920">Ransomware data recovery</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2597629">റാൻസംവെയർ ഡാറ്റ കണ്ടെത്തൽ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46048_2594927_2597630"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In the Windows Defender Security Center, the area within the Virus &amp; threat protection section (pillar), where customers can find and use features to help prevent or recover from ransomware attacks.​</descrip></descripGrp><ntig><termGrp><term id="2594927">Ransomware protection</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2597630">റാൻസംവെയർ പരിരക്ഷ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46049_2594936_2597631"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Windows Defender Security Center, the area within the Virus &amp; threat protection section (pillar) where customers can see the history of the threats found on their devices.</descrip></descripGrp><ntig><termGrp><term id="2594936">Threat history</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2597631">ഭീഷണി ചരിത്രം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46050_2594944_2597632"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Windows Defender Security Center app on Windows 10, the area within the Virus &amp; threat protection section (pillar) where customers can see information about ​the definitions being used to recognize the latest threats on their device, and check for updates to those definitions.</descrip></descripGrp><ntig><termGrp><term id="2594944">Virus &amp; threat protection updates</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2597632">വൈറസ് - ഭീഷണി പരിരക്ഷാ അപ്‌ഡേറ്റുകൾ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46052_3029685_3029956"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app that allows users to make and receive calls and texts, check notifications, and instantly access their Android device's photos and apps from their Windows PC.</descrip></descripGrp><ntig><termGrp><term id="3029685">Phone Link</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="3029956">ഫോൺ ലിങ്ക്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46061_2595007_2602896"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The participant in the Xbox Insider Program.</descrip></descripGrp><ntig><termGrp><term id="2595007">Xbox Insider</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2602896">Xbox Insider</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46061_2595007_3114576"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The participant in the Xbox Insider Program.</descrip></descripGrp><ntig><termGrp><term id="2595007">Xbox Insider</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml