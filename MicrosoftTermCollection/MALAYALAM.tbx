ch">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1229501">പ്രതിഫലിക്കുക</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21417_777441_1229502"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Windows feature that enables users to share pictures, music, videos, documents, and printers with other people on a home network.</descrip></descripGrp><ntig><termGrp><term id="777441">Windows HomeGroup</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1229502">ഹോംഗ്രൂപ്പ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21417_779020_1229502"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Windows feature that enables users to share pictures, music, videos, documents, and printers with other people on a home network.</descrip></descripGrp><ntig><termGrp><term id="779020">HomeGroup</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1229502">ഹോംഗ്രൂപ്പ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21430_3007378_3009267"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Snipping Tool, a tool to draw an irregular line, such as a circle or a triangle, around an object that you want to capture.</descrip></descripGrp><ntig><termGrp><term id="3007378">Free-form mode</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="3009267">ഫ്രീ-ഫോം മോഡ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21430_777464_3009267"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Snipping Tool, a tool to draw an irregular line, such as a circle or a triangle, around an object that you want to capture.</descrip></descripGrp><ntig><termGrp><term id="777464">Free-form Snip</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="3009267">ഫ്രീ-ഫോം മോഡ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21431_3007379_3009268"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Snipping Tool, a tool to capture the entire screen, similar to pressing PRINT SCREEN.</descrip></descripGrp><ntig><termGrp><term id="3007379">Full-screen mode</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="3009268">പൂർണ്ണ സ്ക്രീൻ മോഡ്</term><t