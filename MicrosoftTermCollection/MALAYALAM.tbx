ry><termEntry id="1155_145640_489868"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A frame that can contain check boxes, toggle buttons, and option buttons on a form, report, or data access page. You use an option group to present alternatives from which the user can select a single option.</descrip></descripGrp><ntig><termGrp><term id="145640">option group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="489868">ഐച്ഛിക സംഘം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11551_187996_1241724"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The file used in ClickOnce applications to grant an elevated level of trust to a managed application. Trust licenses must be signed by trust license issuers, which must be installed on a client computer prior to deploying the ClickOnce application.</descrip></descripGrp><ntig><termGrp><term id="187996">trust license</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1241724">വിശ്വസിക്കാവുന്ന ലൈസന്‍സ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11558_181384_1961183"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A dialog box that displays information about an object in the interface.</descrip></descripGrp><ntig><termGrp><term id="181384">properties page</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1961183">പ്രോപ്പര്‍ട്ടികള്‍ പേജ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11563_109159_1241725"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A data structure that contains security information associated with a protected object. Security descriptors include information about who owns the object, who can access it and in what way, and what types of access are audited.</descrip></descripGrp><ntig><termGrp><term id="109159">security descriptor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1241725">സുരക്ഷാ നിര്‍ദ്ദേശിനി</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11563_109159_1961485"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A data structure that contains security information associated with a protected object. Security descriptors include information about who owns the object, who can access it and in what way, and what types of access are audited.</descrip></descripGrp><ntig><termGrp><term id="109159">security descriptor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1961485">സുരക്ഷ ഡിസ്‌ക്രിപ്റ്റര്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="pa