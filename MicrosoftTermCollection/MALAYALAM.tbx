d</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26524_1275651_1961173"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An account that can receive mail using the POP3 protocol.</descrip></descripGrp><ntig><termGrp><term id="1275651">POP-enabled account</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1961173">POP-പ്രാപ്‌തമാക്കിയ അക്കൌണ്ട്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26525_1275652_1961179"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The email address that appears in the E-Mail Options section of the user's mailbox in the Web management interface for Outlook Live.</descrip></descripGrp><ntig><termGrp><term id="1275652">primary e-mail address</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1961179">പ്രാഥമിക ഇ-മെയില്‍‌ വിലാസം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26526_1275654_1961193"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An object that represents a user or resource in Outlook, generally a mail message addressee.</descrip></descripGrp><ntig><termGrp><term id="1275654">recipient object</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1961193">സ്വീകര്‍തൃ ഓബ്‌ജക്‌ട്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26527_1275656_1961195"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The domain that an administrator has registered with a domain registrar.</descrip></descripGrp><ntig><termGrp><term id="1275656">registered domain</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1961195">രജിസ്റ്റര്‍ ചെയ്‌ത ഡൊമെയ്ന്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26529_1275659_1961240"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process by which a user presses and holds a key on their mobile phone keypad to dial a specific phone number.</descrip></descripGrp><ntig><termGrp><term id="1275659">speed dialing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1961240">സ്‍പീഡ് ഡയലിംഗ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26530_1275661_1961004"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The settings, related to the domain, a user needs to configure to get messaging up and running.</descrip></descripGrp><ntig><termGrp><term id="1275661">domain settings</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1961004">ഡൊമെയ്‌ന്‍ സജ്ജീകരണങ്ങള്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26531_1275663_2720056"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To transfer a call to a holding point instead of holding the call at the phone device.</descrip></descripGrp><ntig><termGrp><term id="1275663">park</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2720056">കൈമാറുക</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26535_1275693_2855785"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To answer a call by dialing the associated number on the network where it has been parked.</descrip></descripGrp><ntig><termGrp><term id="1275693">retrieve</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2855785">വീണ്ടെടുക്കുക</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26550_1275968_1878234"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The listing of contents created by bookmarking blocks of text and creating the table of contents of the bookmarked area.</descrip></descripGrp><ntig><termGrp><term id="1275968">ookmark TOC</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1878234">ബുക്ക്‌മാര്‍ക്ക് TOC</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26554_1276172_2290186"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The window that contains the user's workbook of tabbed sheets.</descrip></descripGrp><ntig><termGrp><term id="1276172">workbook window</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2290186">വർക്ക്ബുക്ക് വിൻഡോ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26555_1276173_1425618"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A prewritten formula that simplifies the process of entering calculations and enables the user to use formulas that might be difficult to build from scratch.</descrip></descripGrp><ntig><termGrp><term id="1276173">function</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1425618">കാര്യപ്രവര്‍ത്തനം</term><termNote type="geographi