/termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5965_187866_1241433"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An optional file system folder that contains current copies of all files in a project. The shadow folder provides a location from which to view the files without accessing the Visual SourceSafe database and serves as a convenient place to build or compile the project.</descrip></descripGrp><ntig><termGrp><term id="187866">shadow folder</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1241433">നിഴല്‍ ഫോള്‍ഡര്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5967_25496_489036"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to time when a person is already scheduled for another task and is not available.</descrip></descripGrp><ntig><termGrp><term id="25496">busy</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="489036">തിരക്കുള്ള</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5970_232410_490124"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The customizable address book used to store frequently used email addresses</descrip></descripGrp><ntig><termGrp><term id="232410">Personal Address Book</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="490124">സ്വകാര്യ വിലാസ പുസ്തകം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5973_137523_489794"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A task that has been sent to someone as a task request in an email message.</descrip></descripGrp><ntig><termGrp><term id="137523">assigned task</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="489794">നിയോഗിക്കപ്പെട്ട ചുമതല</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5976_14610_1877703"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of constants that is a component of an array formula.</descrip></descripGrp><ntig><termGrp><term id="14610">array constant</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1877703">അറേ കോണ്‍‌സ്റ്റന്റ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5980_138014_1241434"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The conversion of a value type instance to an object, which implies that the instance will carry full type information at run time and will be allocated in the heap. The Microsoft intermediate language (MSIL) instruction set's box instruction converts a value type to an object by making a copy of the value type and embedding it in a newly allocated object.</descrip></descripGrp><ntig><termGrp><term id="138014">boxing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1241434">പെട്ടിയിലാക്കല്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5983_346955_1676692"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A place where one lives.</descrip></descripGrp><ntig><termGrp><term id="346955">home</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1676692">വീട്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6000_536317_1241435"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Any code placed on a central server that is meant to be downloaded and run by multiple clients. Mobile code can be distributed using Web servers, FTP servers, file shares, and so on. Typically, users run mobile code from the intranet and Internet zones.</descrip></descripGrp><ntig><termGrp><term id="536317">mobile code</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet 