3163_1229498"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that alerts users to potential issues with email recipients before the message is sent.</descrip></descripGrp><ntig><termGrp><term id="773163">MailTips</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1229498">മെയില്‍ടിപ്പുകള്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21362_773197_1413255"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To establish a Bluetooth link or connection between two Bluetooth–enabled devices.</descrip></descripGrp><ntig><termGrp><term id="773197">pair</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1413255">ജോടിയാക്കുക</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21366_773418_2244546"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To make a single file out of a set of files using a program such as compress, gzip, or PKZIP.</descrip></descripGrp><ntig><termGrp><term id="773418">zip</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2244546">സിപ്പുചെയ്യുക</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="g