170_1241604"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A disfavored persona or persona with the objective of gaining access to an asset.</descrip></descripGrp><ntig><termGrp><term id="237170">adversary</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1241604">പ്രതിയോഗി</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9029_237170_1241605"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A disfavored persona or persona with the objective of gaining access to an asset.</descrip></descripGrp><ntig><termGrp><term id="237170">adversary</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1241605">അതൃപ്തിയുളള ബാഹ്യവ്യക്തിത്വം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9029_237217_1241604"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A disfavored persona or persona with the objective of gaining access to an asset.</descrip></descripGrp><ntig><termGrp><term id="237217">disfavored persona</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1241604">പ്രതിയോഗി</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotS