ular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2036698">Windows 8.1 Enterprise</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35417_2029755_2036712"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The edition of Windows 8.1 designed to make Windows affordable to mainstream consumers in emerging markets.</descrip></descripGrp><ntig><termGrp><term id="2029755">Windows 8.1 Single Language</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2036712">Windows 8.1 Single Language</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35418_2029756_2036708"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The edition of Windows 8.1 Pro that contains Windows Media Center.</descrip></descripGrp><ntig><termGrp><term id="2029756">Windows 8.1 Pro with Media Center</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2036708">Media Center-മൊത്തുള്ള Windows 8.1 Pro</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35438_2030882_2040342"><langSet xml:lang="en-US"><descripGrp><descrip type