serial port</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="489253">കമ്മ്യൂണിക്കേഷന്‍സ് പോര്‍ട്ട്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9331_49777_489254"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A serial communications port used to connect a device, such as a modem, printer, or mobile device, to a computer.</descrip></descripGrp><ntig><termGrp><term id="49777">serial port</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="489254">സീരിയല്‍ പോര്‍ട്ട്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9332_210450_1877879"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The formal name for Excel 12 file format. The Excel XML Format has an open, royalty-free specification, and is the technology licensed to external parties.</descrip></descripGrp><ntig><termGrp><term id="210450">Excel XML Format</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1877879">Excel XML ഫോര്‍മാറ്റ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9334_397201_1961096"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of object that has an email address on a domain in the organization, but the object does not have a mailbox in the domain at which to receive messages. The object appears in the global address list, which allows other people in the organization to easily locate or send a message to that person, but the administrator does not need to manage an unnecessary mailbox. Contacts, users, and even folders can be mail-enabled.</descrip></descripGrp><ntig><termGrp><term id="397201">mail-enabled object</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1961096">മെയില്‍-പ്രാപ്‌തമാക്കിയ ഓബ്‌ജക്‌ട്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9336_119369_489680"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A database object that stores data in records (rows) and fields (columns). The data is usually about a particular category of things, such as employees or orders.</descrip></descripGrp><ntig><termGrp><term id="119369">table</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="489680">പട്ടിക</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="934_76743_489431"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A distinctive symbol that identifies a person,