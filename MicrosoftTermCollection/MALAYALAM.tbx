d="502926">downloader</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2720536">ട്രോജന്‍ ഡൗണ്‍‌ലോഡര്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13678_502926_490426"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A trojan that accesses remote Web sites in order to download and install malicious or potentially unwanted software to the computer that the Trojan has infected.</descrip></descripGrp><ntig><termGrp><term id="502926">downloader</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="490426">ട്രോജന്‍ ഡൌണ്‍‌ലോഡര്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13679_277388_2325588"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An authentication credential similar to a password, consisting of numbers.</descrip></descripGrp><ntig><termGrp><term id="277388">passcode</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2325588">പാസ്‌കോഡ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13683_110861_1229780"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A computer that provides shared resources, such as files or printers, to network users.</descrip></descripGrp><ntig><termGrp><term id="110861">server</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1229780">സെര്‍വര്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13685_536650_1241756"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The common user interface elements rendered around each Web Parts part control within a given zone. The chrome for a part control includes a border, a title bar, and the icons, title text, and verbs menu that appear within the title bar. The appearance of the chrome is set at the zone level and applies to all part controls in a zone. The rendering of chrome and of individual System.Web.UI.WebControls.WebParts.WebPart controls is handled by the System.Web.UI.WebControls.WebParts.WebPartChrome class.</descrip></descripGrp><ntig><termGrp><term id="536650">chrome</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1241756">ക്രോം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13698_14395_1229008"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A number that identifies each telephone service area in a country/region and is used as a dialing prefix.</descrip></descripGrp><ntig><termGrp><term id="14395">area code</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1229008">സ്ഥലകോഡ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13701_88326_489516"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To configure a device or application so that it performs better. For example, to fine-tune a program so that it runs more quickly or takes up less space.</descrip></descripGrp><ntig><termGrp><term id="88326">optimize</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="489516">ഏകതാനമാക്കുക</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1371_141114_1425491"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Properties, such as title, subject, and author, that are stored with each data access page.</descrip></descripGrp><ntig><termGrp><term id="141114">document properties</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1425491">പ്രമാണ ഗുണവിശേഷതകള്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13724_2346152_2799816"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A named set of deliverables (software components) produced, usually by compiling, from a discrete set of source versions.</descrip></descripGrp><ntig><termGrp><term id="2346152">BLD</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2799816">ബിൽഡ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13724_24639_2799816"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A named set of deliverables (software components) produced, usually by compiling, from a discrete set of source versions.</descrip></descripGrp><ntig><termGrp><term id="24639">build</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2799816">ബിൽഡ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13726_261538_490274"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A software control that incorporates ActiveX technology.</descrip></descripGrp><ntig><termGrp><term id="261538">ActiveX control</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="490274">ActiveX നിയന്ത്രണം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13734_187111_1241848"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A window in Visual Studio Class Designer that you can use to configure the members of a type. By default, the Class Details Window appears automatically when you open a new class diagram.</descrip></descripGrp><ntig><termGrp><term id="187111">Class Details Window</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1241848">ക്ലാസ്സ് വിശദാംശ ജാലകം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1374_210475_1425492"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to a type of layout consisting of a collection of “Row-Wise Groupings”. A stacked layout most resembles a form with name/value pairs (label, textbox).</descrip></descripGrp><ntig><termGrp><term id="210475">stacked</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1425492">സഞ്ചിത</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13742_19852_489001"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A chart that uses horizontal bars to illustrate comparisons among individual data ite