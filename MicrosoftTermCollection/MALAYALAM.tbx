e</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2384332">മൊബൈൽ ഉപകരണം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12345_763955_2420377"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A piece of handheld equipment such as a portable music or video player, PDA (personal digital assistant), mobile phone, tablet or warehouse device that works on its own but can also be connected to a computer.</descrip></descripGrp><ntig><termGrp><term id="763955">handheld device</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2420377">മൊബൈൽ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12345_81161_2384332"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A piece of handheld equipment such as a portable music or video player, PDA (personal digital assistant), mobile phone, tablet or warehouse device that works on its own but can also be connected to a computer.</descrip></descripGrp><ntig><termGrp><term id="81161">mobile device</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2384332">മൊബൈൽ ഉപകരണം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="gramma