termGrp><term id="1951229">Windows Push വിജ്ഞാപന സേവനം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31641_1635641_1951231"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature of Windows for sending tile updates and notifications to users.</descrip></descripGrp><ntig><termGrp><term id="1635641">WNS</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1951231">WNS</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31647_1608225_1878293"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The act of checking a visual workflow to ensure that the shapes and connections are valid.</descrip></descripGrp><ntig><termGrp><term id="1608225">shape-level validation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1878293">ആകാര-ലെവല്‍ മൂല്യനിര്‍ണ്ണയം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31649_1608227_1878294"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mode of Word Automation Services in which requests are processed synchronously, rather than in batches.</descrip></descripGrp><ntig><termGrp><t