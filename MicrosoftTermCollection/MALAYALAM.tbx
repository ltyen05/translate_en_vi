mber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53664_3054433_3056237"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Windows 365 capability that allows the user to boot directly to your Cloud PC.</descrip></descripGrp><ntig><termGrp><term id="3054433">Windows 365 Boot</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="3056237">Windows 365 ബൂട്ട്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53665_3054434_3056242"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Windows 365 capability that allows the user to swipe between desktop and a Cloud PC/Windows 365 environment as part of task view.</descrip></descripGrp><ntig><termGrp><term id="3054434">Windows 365 Switch</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="3056242">Windows 365 സ്വിച്ച്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53668_3055383_3059906"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to device features that can detect if someone is coming or going from a device, triggering the device to wake or lock.</descrip></descripGrp><ntig><termGrp><term id="3055383">presence sensing</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="3059906">സാന്നിധ്യം തിരിച്ചറിയൽ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53669_3055384_3056233"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Windows feature on select devices with a sensor to detect motion as someone approaches so the device powers back on.</descrip></descripGrp><ntig><termGrp><term id="3055384">wake on approach</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="3056233">അടുക്കുമ്പോൾ ഉണരുക</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53670_3055385_3056172"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Windows feature on select devices with the proper sensor to detect motion as someone walks away from their device so it powers down/sleeps to save power.</descrip></descripGrp><ntig><termGrp><term id="3055385">lock on leave</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="3056172">അകലുമ്പോൾ ലോക്ക് ചെയ്യുക</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53671_3055386_3059889"><langSet xml: