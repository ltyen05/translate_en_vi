</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50124_2835531_2837820"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A civic address--with an optional place</descrip></descripGrp><ntig><termGrp><term id="2835531">ERL</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2837820">അടിയന്തിര ലൊക്കേഷൻ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50124_2835531_2837822"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A civic address--with an optional place</descrip></descripGrp><ntig><termGrp><term id="2835531">ERL</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2837822">അടിയന്തിര പ്രതികരണ ലൊക്കേഷൻ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50124_2835531_2837825"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A civic address--with an optional place</descrip></descripGrp><ntig><termGrp><term id="2835531">ERL</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2837825">ERL</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50125_2835510_2837819"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A civic address--the physical or street address of a place of business for your organization that is used to route emergency calls to the appropriate dispatch authorities and to assist in locating the emergency caller.</descrip></descripGrp><ntig><termGrp><term id="2835510">emergency address</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2837819">അടിയന്തിര വിലാസം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50127_2835544_2837823"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The public organizations whose job is to take quick action to deal with emergencies when they occur, especially the fire brigade, the police, and the ambulance service.</descrip></descripGrp><ntig><termGrp><term id="2835544">emergency services</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2837823">അടിയന്തിരഘട്ട സേവനങ്ങൾ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50128_2835552_2837824"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A function - when enabled, Teams retrieves policy and location information from the service and includes that information as part of the emergency call.</descrip></descripGrp><ntig><termGrp><term id="2835552">enhanced emergency services</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2837824">വിപുലീകൃത അടിയന്തിരഘട്ട സേവനങ്ങൾ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50130_2835555_2837838"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A measured employee that interacts with other collaborators in meetings and with email.</descrip></descripGrp><ntig><termGrp><term id="2835555">time investor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2837838">ടൈം ഇൻവെസ്‌റ്റർ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50131_2835558_2837829"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The employees to whom your Workplace Analytics administrator assigned licenses during setup. After license assignment, Workplace Analytics extracts Office 365 data about meetings, email, unscheduled calls, and instant messages for these people. If you are an analyst or limited analyst, this is the population that you can analyze within Workplace Analytics. The number of measured employees can help determine whether you have good data coverage for analysis.</descrip></descripGrp><ntig><termGrp><term id="2835558">measured employee</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2837829">നിശ്ചിത ജീവനക്കാർ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50132_2835563_2837818"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A number that identifies an emergency location.</descrip></descripGrp><ntig><termGrp><term id="2835563">Emergency Location Identification Number</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2837818">ELIN</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50132_2835563_2837821"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A number that identifies an emergency location.</descrip></descripGrp><ntig><termGrp><term id="2835563">Emergency Location Identification Number</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2837821">അടിയന്തിര ലൊക്കേഷൻ തിരിച്ചറിയൽ നമ്പർ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50132_2835565_2837818"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A number that identifies an emergency location.</descrip></descripGrp><ntig><termGrp><term id="2835565">ELIN</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2837818">ELIN</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50132_2835565_2837821"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A number that identifies an emergency location.</descrip></descripGrp><ntig><termGrp><term id="2835565">ELIN</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2837821">അടിയന്തിര ലൊക്കേഷൻ തിരിച്ചറിയൽ നമ്പർ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50133_2835566_2837840"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The time between the person's first email or meeting and the last email or meeting in a day, counted from Monday to Friday, with a minimum of four hours and a maximum of 16 hours per day.</descrip></descripGrp><ntig><termGrp><term id="2835566">workweek span</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2837840">പ്രവർത്തന സമയം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50134_2835567_2837816"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A number that translates into the value of the emergency dial string.</descrip></descripGrp><ntig><termGrp><term id="2835567">dial mask</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2837816">ഡയൽ മാസ്‌ക്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50136_2835569_2837826"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Non-scheduled business time periods that last less than two hours.</descrip></descripGrp><ntig><termGrp><term id="2835569">fragmented hours</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2837826">അവിചാരിത കാലയളവ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50138_2835571_2837831"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Typically a floor, building, wing, or office number. Place is associated with an emergency address to give a more exact location within a building.</descrip></descripGrp><ntig><termGrp><term id="2835571">place</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2837831">സ്ഥലം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50139_2835572_2837836"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An emergency address that is assigned to each Calling Plan user; it is sometimes referred to as a static emergency address or address of record.</descrip></descripGrp><ntig><termGrp><term id="2835572">registered address</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2837836">രജിസ്‌റ്റർ ചെയ്‌ത വിലാസം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5015_358327_490817"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of taking a single-table database and breaking it into a set of smaller, related tables, with each table focused on a single topic or grouping of information.</descrip></descripGrp><ntig><termGrp><term id="358327">normalization</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="490817">ലഘൂകരണം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50150_2836048_2837814"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The speed at which an object rotates or revolves relative to another position, such as with respect to the x, y, and z axes. It is measured with a gyrometer.</descrip></descripGrp><ntig><termGrp><term id="2836048">angular velocity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2837814">കോണീയ പ്രവേഗം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50151_2836049_2837828"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A sensor that measures angular velocity.</descrip></descripGrp><ntig><termGrp><term id="2836049">gyrometer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2837828">ജൈറോമീറ്റർ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50152_2836052_2837813"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A sensor that returns G-force values with respect to the x, y, and z axes.</descrip></descripGrp><ntig><termGrp><term id="2836052">accelerometer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2837813">ആക്‌സിലറോമീറ്റർ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50153_2836056_2837827"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Gravitational force equivalent - A measurement of the type of force per unit mass – typically acceleration – that causes a perception of weight.</descrip></descripGrp><ntig><termGrp><term id="2836056">G-force</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2837827">G-ഫോഴ്‌സ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50156_2836765_2841110"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A search carried out on the audit log to view user and administrator activity in an Office 365 organization, for example, to find if a user viewed a specific document or purged an item from their mailbox.</descrip></descripGrp><ntig><termGrp><term id="2836765">audit log search</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2841110">ഓഡിറ്റ് ലോഗ് തിരയൽ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50158_2836783_2850964"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Microsoft's multilingual machine translation cloud service, offering both text and speech translation, which is integrated across multiple consumer, developer, and enterprise products.</descrip></descripGrp><ntig><termGrp><term id="2836783">Microsoft Translator</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2850964">Microsoft ട്രാൻസ്‌ലേറ്റർ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50159_2836785_2850968"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Microsoft Translator app designed for use by teachers, students and parents in education. Used for language translation but also for students who are deaf or hard of hearing, dyslexic, or having trouble taking notes.</descrip></descripGrp><ntig><termGrp><term id="2836785">Translator for Education</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2850968">വിദ്യാഭ്യാസ ആവശ്യങ്ങൾക്കായുള്ള ട്രാൻസ്‌ലേറ്റർ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50187_2838775_2841115"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An approach to machine translation that uses an artificial neural network to predict the likelihood of a sequence of words, typically modeling entire sentences in a single integrated model.</descrip></descripGrp><ntig><termGrp><term id="2838775">neural machine translation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2841115">ന്യൂറൽ മെഷീൻ വിവർത്തനം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50187_2838775_2841116"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An approach to machine translation that uses an artificial neural network to predict the likelihood of a sequence of words, typically modeling entire sentences in a single integrated model.</descrip></descripGrp><ntig><termGrp><term id="2838775">neural machine translation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2841116">NMT</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50187_2839428_2841115"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An approach to machine translation that uses an artificial neural network to predict the likelihood of a sequence of words, typically modeling entire sentences in a single integrated model.</descrip></descripGrp><ntig><termGrp><term id="2839428">NMT</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2841115">ന്യൂറൽ മെഷീൻ വിവർത്തനം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50187_2839428_2841116"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An approach to machine translation that uses an artificial neural network to predict the likelihood of a sequence of words, typically modeling entire sentences in a single integrated model.</descrip></descripGrp><ntig><termGrp><term id="2839428">NMT</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2841116">NMT</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50188_2839431_2841106"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in Excel that records actions performed on an Excel sheet and saves them to a script. Henceforth, the actions can be performed automatically by running the script.</descrip></descripGrp><ntig><termGrp><term id="2839431">Action Recorder</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2841106">പ്രവർത്തന റെക്കോർഡർ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50189_2839432_2841118"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Name of an Excel dialog used to start the the Action Recorder.</descrip></descripGrp><ntig><termGrp><term id="2839432">Record Actions</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2841118">പ്രവർത്തനങ്ങൾ റെക്കോർഡ് ചെയ്യുക</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50190_2839434_2841112"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Name of a feature in Excel that allows users to edit scripts.</descrip></descripGrp><ntig><termGrp><term id="2839434">Code Editor</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2841112">കോഡ് എഡിറ്റർ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50194_2839796_2841108"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tool used to set a Yammer network to native mode, to address any network incompatibilities, to provide information on the quantity and usage of private unlisted groups in the network, and other functions.</descrip></descripGrp><ntig><termGrp><term id="2839796">Alignment Tool</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2841108">അലൈൻമെന്റ് ഉപകരണം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50195_2839821_2841107"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A report that provides information about the quantity and usage of external groups, files previously uploaded in private messages, the activity of network guests, and other information a Yammer network.</descrip></descripGrp><ntig><termGrp><term id="2839821">Alignment Report</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2841107">അലൈൻമെന്റ് റിപ്പോർട്ട്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50196_2839890_2841111"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An entity that shares the controller role with another entity to ensure GDPR compliance.</descrip></descripGrp><ntig><termGrp><term id="2839890">co-controller</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2841111">കോ‌-കൺട്രോളർ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50196_2839890_2841114"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An entity that shares the controller role with another entity to ensure GDPR compliance.</descrip></descripGrp><ntig><termGrp><term id="2839890">co-controller</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2841114">ജോയിന്റ് കൺട്രോളർ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50196_2839891_2841111"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An entity that shares the controller role with another entity to ensure GDPR compliance.</descrip></descripGrp><ntig><termGrp><term id="2839891">joint controller</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2841111">കോ‌-കൺട്രോളർ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50196_2839891_2841114"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An entity that shares the controller role with another entity to ensure GDPR compliance.</descrip></descripGrp><ntig><termGrp><term id="2839891">joint controller</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2841114">ജോയിന്റ് കൺട്രോളർ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50197_2839915_2841117"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The processing of personal data in such a manner that the personal data can no longer be attributed to a specific data subject without the use of additional information, provided that such additional information is kept separately and is subject to technical and organisational measures to ensure that the personal data are not attributed to an identified or identifiable natural person.</descrip></descripGrp><ntig><termGrp><term id="2839915">pseudonymisation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2841117">അപരവൽക്കരണം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50197_2839918_2841117"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The processing of personal data in such a manner that the personal data can no longer be attributed to a specific data subject without the use of additional information, provided that such additional information is kept separately and is subject to technical and organisational measures to ensure that the personal data are not attributed to an identified or identifiable natural person.</descrip></descripGrp><ntig><termGrp><term id="2839918">pseudonymization</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2841117">അപരവൽക്കരണം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50216_2841643_2843116"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A person who handles a call to a business such as to fill service requests, place orders, or connect to another respondent or another call.</descrip></descripGrp><ntig><termGrp><term id="2841643">call agent</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2843116">ഏജന്റ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50216_2841643_2843120"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A person who handles a call to a business such as to fill service requests, place orders, or connect to another respondent or another call.</descrip></descripGrp><ntig><termGrp><term id="2841643">call agent</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2843120">കോൾ ഏജന്റ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50216_2841644_2843116"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A person who handles a call to a business such as to fill service requests, place orders, or connect to another respondent or another call.</descrip></descripGrp><ntig><termGrp><term id="2841644">agent</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2843116">ഏജന്റ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50216_2841644_2843120"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A person who handles a call to a business such as to fill service requests, place orders, or connect to another respondent or another call.</descrip></descripGrp><ntig><termGrp><term id="2841644">agent</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2843120">കോൾ ഏജന്റ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50217_2841650_2843123"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In a call queue, a method of sending calls to agents whereby routing of incoming calls is balanced so that each call agent gets the same number of calls from the queue.</descrip></descripGrp><ntig><termGrp><term id="2841650">round robin</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2843123">റൗണ്ട് റോബിൻ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50218_2841689_2843122"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A representation of the network requirements for connecting Microsoft Teams and cloud voice across an organization's physical locations using network details, teams usage, sites and Microsoft recommended personas (office workers, remote workers, and Teams room system).</descrip></descripGrp><ntig><termGrp><term id="2841689">network plan</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2843122">നെറ്റ്‌വർക്ക് പ്ലാൻ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50219_2841716_2843121"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature of the Microsoft Teams Admin Center that shows detailed information about the devices, networks, and connectivity related to the calls and meetings for each user in a Microsoft Teams or Skype for Business tenant account. It is displayed on the user's Call History tab.</descrip></descripGrp><ntig><termGrp><term id="2841716">Call Analytics</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2843121">കോൾ അനലിറ്റിക്‌സ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50220_2841736_2843117"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Information that gives insight into usage patterns and activity.</descrip></descripGrp><ntig><termGrp><term id="2841736">analytics</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2843117">അനലിറ്റിക്‌സ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50221_2841755_2843118"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Microsoft teams, name of a tab on the Manage teams dialog that displays team analytics.</descrip></descripGrp><ntig><termGrp><term id="2841755">Analytics</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2843118">അനലിറ്റിക്‌സ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50222_2841766_2843119"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In a call queue, a method of sending calls to agents whereby the first call in the queue rings all call agents at the same time. The first call agent to pick up the call gets the call.</descrip></descripGrp><ntig><termGrp><term id="2841766">attendant routing</term><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2843119">അറ്റന്‍ഡന്‍റ് റൂട്ടിംഗ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50231_2842090_2848155"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To remove marked-up documents or data from a machine learning system and from the training process.</descrip></descripGrp><ntig><termGrp><term id="2842090">unseed</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2848155">വിവരങ്ങൾ നീക്കം ചെയ്യുക</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50232_2842091_2848140"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To manipulate data intended to be parsed or otherwise processed by a software program in order to trigger hangs, exceptions, or crashes in the target application.</descrip></descripGrp><ntig><termGrp><term id="2842091">fuzz</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2848140">ഫസ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50233_2842092_2848143"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A software program or tool that performs fuzz testing.</descrip></descripGrp><ntig><termGrp><term id="2842092">fuzzer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2848143">ഫസർ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50234_2842093_2848141"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Invalid or random data used in fuzz testing.</descrip></descripGrp><ntig><termGrp><term id="2842093">fuzz</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2848141">ഫസ് ചെയ്യുക</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50235_2842094_2848136"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">During an active meeting, to invite more people to join the meeting by dialing their phone number.</descrip></descripGrp><ntig><termGrp><term id="2842094">dial out</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2848136">ഡയൽ ഔട്ട് ചെയ്യുക</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50235_2842095_2848136"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">During an active meeting, to invite more people to join the meeting by dialing their phone number.</descrip></descripGrp><ntig><termGrp><term id="2842095">dial-out</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2848136">ഡയൽ ഔട്ട് ചെയ്യുക</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50236_2842096_2848135"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To join a conference call when the invited guest initiates the connection by phoning or by connecting through a computer with a conference ID or PIN. Contrast with dial out.</descrip></descripGrp><ntig><termGrp><term id="2842096">dial in</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2848135">ഡയൽ ചെയ്യുക</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50237_2842097_3000089"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A formula for finding any power of a binomial without multiplying at length. According to the theorem, it is possible to expand the polynomial (x + y)n into a polynomial sum expression.</descrip></descripGrp><ntig><termGrp><term id="2842097">binomial theorem</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="3000089">ദ്വിപദപ്രമേയം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50238_2842098_2848152"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A function that automatically changes passwords after a certain time interval.</descrip></descripGrp><ntig><termGrp><term id="2842098">password rotation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2848152">പാസ്‌വേഡ് റൊട്ടേഷൻ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50239_2842099_2848151"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An account that provides access to Office 365.</descrip></descripGrp><ntig><termGrp><term id="2842099">Office 365 account</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2848151">Office 365 അക്കൗണ്ട്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50240_2842100_2848153"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A PowerPoint feature that allows the user to enter rehearsal mode and while speaking receive on-screen guidance about pacing, inclusive language, use of filler words, and culturally insensitive phrases. At the end of each rehearsal session, a detailed report with metrics for additional practice is provided.</descrip></descripGrp><ntig><termGrp><term id="2842100">Presenter Coach</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2848153">അവതാരക കോച്ച്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50241_2842101_2848137"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An optional feature of Skype for Business Server that allows meeting attendees to join the audio portion of a meeting by calling in to the meeting from a phone.</descrip></descripGrp><ntig><termGrp><term id="2842101">dial-in conferencing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2848137">ഡയൽ-ഇൻ കോണ്‍ഫറന്‍സിംഗ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50242_2842102_2848146"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature of Microsoft Teams that lets users share their incoming calls with colleagues so that the colleagues can answer calls that occur while the user is unavailable.</descrip></descripGrp><ntig><termGrp><term id="2842102">group call pickup</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2848146">ഗ്രൂപ്പ് കോൾ പിക്കപ്പ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50243_2842105_2848139"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Property of a private team that shows up in search results and is included in suggestions in the team gallery.</descrip></descripGrp><ntig><termGrp><term id="2842105">discoverable</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2848139">കണ്ടെത്താനാകുന്നത്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50244_2842106_2848138"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of moving from physical to digital technologies in the workplace. An example is the adoption of cloud storage, which facilitates moving from physical offices to virtual ones.</descrip></descripGrp><ntig><termGrp><term id="2842106">digital workspace transformation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2848138">ഡിജിറ്റൽ വർക്ക്‌സ്‌പെയ്‌സ് ട്രാൻസ്‌ഫർമേഷൻ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50245_2842107_2848145"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A view in Microsoft Project that lists project information (tasks and milestones) in a table-like layout.</descrip></descripGrp><ntig><termGrp><term id="2842107">Grid view</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2848145">ഗ്രിഡ് കാഴ്‌ച</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50246_2842108_2848154"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A view in Microsoft Project that shows the timeline of project activities and their dependencies.</descrip></descripGrp><ntig><termGrp><term id="2842108">Timeline view</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2848154">ടൈംലൈൻ കാഴ്‌ച</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50247_2842109_2848147"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A program for security software providers that gives them early access to vulnerability information so that they can provide updated protections to customers faster.</descrip></descripGrp><ntig><termGrp><term id="2842109">Microsoft Active Protections Program</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2848147">MAPP</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50247_2842109_2848148"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A program for security software providers that gives them early access to vulnerability information so that they can provide updated protections to customers faster.</descrip></descripGrp><ntig><termGrp><term id="2842109">Microsoft Active Protections Program</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2848148">Microsoft Active Protections