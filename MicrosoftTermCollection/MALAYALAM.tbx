ripGrp><ntig><termGrp><term id="141578">evidence</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1241694">തെളിവ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1081_537098_1241182"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A filter that uses a custom method to evaluate the specified data.</descrip></descripGrp><ntig><termGrp><term id="537098">delegated evaluator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1241182">പ്രതിനിധീകരിച്ച മൂല്യനിര്‍ണയിനി</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1082_27628_489058"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A toggle key that, when on, shifts the alphabetic characters on the keyboard to uppercase.</descrip></descripGrp><ntig><termGrp><term id="27628">CAPS LOCK</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="489058">CAPS LOCK</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1082_27628_489059"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A toggle key that, when on, shifts the alphabetic characters on the keyboard to uppercase.</descrip></descripGrp><ntig><termGrp><term id="27628">CAPS LOCK</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="489059">CAPS LOCK കീ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1082_27629_489058"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A toggle key that, when on, shifts the alphabetic characters on the keyboard to uppercase.</descrip></descripGrp><ntig><termGrp><term id="27629">CAPS LOCK key</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="489058">CAPS LOCK</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1082_27629_489059"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A toggle key that, when on, shifts the alphabetic characters on the keyboard to uppercase.</descrip></descripGrp><ntig><termGrp><term id="27629">CAPS LOCK key</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="489059">CAPS LOCK കീ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNot