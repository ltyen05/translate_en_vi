><term id="2106000">mix view</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2196145">കാഴ്ച ഒന്നിച്ചാക്കുക</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37007_2106001_2196055"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that allows small business and consumers to lock down the phone or tablet running Windows to only allow the use of specific apps.</descrip></descripGrp><ntig><termGrp><term id="2106001">Apps Corner</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2196055">ആപ്സ് കോർണർ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37008_2106002_2196153"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A surface that appears on the phone screen with a “soft” key for the Back, Start and Search button. User gets to choose whether it should be visible or not.</descrip></descripGrp><ntig><termGrp><term id="2106002">nav bar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2196153">എന്റെ ബാർ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37017_2844863_2867768"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Microsoft 365 Apps for business (formerly Office 365 Business) is a small business-level subscription offering that includes Office applications (e.g., Outlook, Word, Excel, PowerPoint, Access (PC only), Publisher (PC only) and cloud file storage and sharing (OneDrive).</descrip></descripGrp><ntig><termGrp><term id="2844863">Microsoft 365 Apps for business</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2867768">ബിസിനസ്സിനുള്ള Microsoft 365 ആപ്പുകൾ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3702_86681_489502"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method of translating images of printed text into machine-encoded text.</descrip></descripGrp><ntig><termGrp><term id="86681">OCR</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="489502">OCR</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3702_86681_489503"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method of translating images of printed text into machine-encoded text.</descrip></descripGrp><ntig><termGrp><term id="86681">OCR</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="489503">ഒപ്റ്റിക്കല്‍ കാരക്ടര്‍ റെക്കൊഗ്നിഷന്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3702_86682_489502"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method of translating images of printed text into machine-encoded text.</descrip></descripGrp><ntig><termGrp><term id="86682">optical character recognition</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="489502">OCR</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3702_86682_489503"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method of translating images of printed text into machine-encoded text.</descrip></descripGrp><ntig><termGrp><term id="86682">optical character recognition</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="489503">ഒപ്റ്റിക്കല്‍ കാരക്ടര്‍ റെക്കൊഗ്നിഷന്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37033_2816013_2834535"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office 365 subscription, hosted in the Government Community Cloud environment, for government organizations that need communication and collaboration tools and the ability to read and do lightweight editing of documents with the Office Online. It includes all the features of Exchange Online Government Plan 1 plus cloud file storage and sharing, online meetings and instant messaging, HD videoconferencing, intranet and team sites, and other services.</descrip></descripGrp><ntig><termGrp><term id="2816013">Office 365 Government G1</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2834535">Office 365 Government G1</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37034_2816014_2834536"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office 365 subscription, hosted in the Government Community Cloud environment, that is the best plan for government organizations that need full productivity, communication and collaboration tools with the familiar Office suite, including Office Online. It includes all the features of Office 365 Government Community G1 plus Office desktop applications, personalized search and discovery, self-service business intelligence, enterprise management of apps, eDiscovery tools, hosted voicemail with auto-attendant capabilities, and other services.</descrip></descripGrp><ntig><termGrp><term id="2816014">Office 365 Government G3</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2834536">Office 365 Government G3</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37041_2113983_2198580"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app used to provide product feedback that results from the Windows Insider Program.</descrip></descripGrp><ntig><termGrp><term id="2113983">Windows Feedback</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2198580">Windows ഫീഡ്‌ബാക്ക്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37043_2113317_2573398"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The external program that enables participants (called "Insiders") to provide feedback on Windows new features.</descrip></descripGrp><ntig><termGrp><term id="2113317">Insider Program</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2573398">Insider പ്രോഗ്രാം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37043_2113317_2573401"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The external program that enables participants (called "Insiders") to provide feedback on Windows new features.</descrip></descripGrp><ntig><termGrp><term id="2113317">Insider Program</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammatica