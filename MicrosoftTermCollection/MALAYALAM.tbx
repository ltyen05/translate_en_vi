provides email storage and advanced scheduling services for Microsoft Office Outlook users. The Mailbox server role also includes public folders, which provide a foundation for workflow, document sharing, and other forms of collaboration.</descrip></descripGrp><ntig><termGrp><term id="413296">Mailbox server role</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1961094">മെയില്‍‍ബോക്‌സ് സെര്‍വര്‍ റോള്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15079_187549_1241948"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A logical representation of an actual or physical deployment datacenter environment.</descrip></descripGrp><ntig><termGrp><term id="187549">logical datacenter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1241948">ലോജിക്കല്‍ ഡാറ്റാ കേന്ദ്രം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1508_44527_2739859"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To refuse, object, block, or oppose the state of a resource or process.</descrip></descripGrp><ntig><termGrp><term id="44527">deny</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2739859">നിഷേധിക്കുക</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15086_5913_488908"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An integrated proofing tool used to search on common words and display synonyms.</descrip></descripGrp><ntig><termGrp><term id="5913">thesaurus</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="488908">ശബ്ദകോശം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15088_140956_489835"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A control that appears dimmed on a form or data access page. A disabled control cannot get the focus and will not respond to mouse clicks.</descrip></descripGrp><ntig><termGrp><term id="140956">disabled control</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="489835">അപ്രാപ്തമാക്കിയ നിയന്ത്രണം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1509_101960_489596"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The likelihood of a computer system or device continuing to function over a given period of time and under specified conditions.</descrip></descripGrp><ntig><termGrp><term id="101960">reliability</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="489596">വിശ്വാസ്യത</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15094_347947_490801"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A control on a form that contains other controls in a table format and that repeats as needed. Users can insert multiple rows when filling out the form.</descrip></descripGrp><ntig><termGrp><term id="347947">repeating table</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="490801">ആവര്‍ത്തന പട്ടിക</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15096_187386_1241949"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A File Server Resource Manager option that is used to define a namespace for a file screen, file screen exception, or storage report. It consists of a set of file name patterns, which in turn determine whether files are included or excluded from a group.</descrip></descripGrp><ntig><termGrp><term id="187386">file group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1241949">ഫയല്‍ സംഘം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="gramma