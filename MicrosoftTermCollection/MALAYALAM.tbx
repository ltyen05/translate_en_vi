ck activity involving establishing communications to report status, relay reconnaissance results, receive additional commands, or transmit stolen data.</descrip></descripGrp><ntig><termGrp><term id="2819510">C&amp;C</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2823510">C&amp;C</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48463_2819510_2823511"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Attack activity involving establishing communications to report status, relay reconnaissance results, receive additional commands, or transmit stolen data.</descrip></descripGrp><ntig><termGrp><term id="2819510">C&amp;C</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2823511">C2</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48466_2738461_2742998"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The view that integrates Advanced eDiscovery with the Microsoft 365 compliance center.</descrip></descripGrp><ntig><termGrp><term id="2738461">eDiscovery</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2742998">eDiscovery</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Proper