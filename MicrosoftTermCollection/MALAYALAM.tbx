="definition">To put into use.</descrip></descripGrp><ntig><termGrp><term id="343631">apply</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="490757">പ്രയോഗിക്കുക</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19418_658956_2198609"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A color or image that appears behind the content of a visual element, for example, behind the text that is displayed in a TextBox control or on your graphical user interface.</descrip></descripGrp><ntig><termGrp><term id="658956">background</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2198609">പശ്ചാത്തലം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19425_659081_3041663"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An interface control for setting the color of a brush or the color of a property on an object (such as Background).</descrip></descripGrp><ntig><termGrp><term id="659081">color editor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="3041663">കളർ പിക്കർ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote>