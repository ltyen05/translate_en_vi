exclusive</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1229009">എക്സ്ക്ലൂസീവ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13776_5615_488904"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A supplemental program that can extend the capabilities of an application program.</descrip></descripGrp><ntig><termGrp><term id="5615">add-in</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="488904">ആഡ്-ഇന്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13786_536371_1241851"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An XML-based markup language used to specify content and the user interface for narrowband devices, including cellular phones and pagers. WML is part of WAP.</descrip></descripGrp><ntig><termGrp><term id="536371">Wireless Markup Language</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1241851">വയര്‍ലസ് അടയാളപ്പെടുത്തുന്ന ഭാഷ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13786_536371_1241852"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An XML-based markup language used to specify content and the user interface for narrowband devices, including cellular phones and pagers. WML is part of WAP.</descrip></descripGrp><ntig><termGrp><term id="536371">Wireless Markup Language</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1241852">WML</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13786_536372_1241851"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An XML-based markup language used to specify content and the user interface for narrowband devices, including cellular phones and pagers. WML is part of WAP.</descrip></descripGrp><ntig><termGrp><term id="536372">WML</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1241851">വയര്‍ലസ് അടയാളപ്പെടുത്തുന്ന ഭാഷ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13786_536372_1241852"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An XML-based markup language used to specify content and the user interface for narrowband devices, including cellular phones and pagers. WML is part of WAP.</descrip></descripGrp><ntig><termGrp><term id="536372">WML</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1241852">WML</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13787_397179_1961098"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of recipients that are created to expedite the mass emailing of messages and other information. Unlike a mail-enabled universal distribution group, a mail-enabled USG can also be used to assign permissions. When email is sent to a mail-enabled USG, all members of that group receive a copy of the message.</descrip></descripGrp><ntig><termGrp><term id="397179">mail-enabled universal security group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1961098">മെയില്‍-പ്രാപ്‌തമാക്കിയ ആഗോള സുരക്ഷാ ഗ്രൂപ്പ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13788_213533_1959025"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To tap twice quickly on a screen or touchpad.</descrip></descripGrp><ntig><termGrp><term id="213533">double-tap</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1959025">രണ്ടുതവണ സ്പർശിക്കുക</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1379_120227_489685"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The suite of networking protocols arranged in four layers, which are called the link layer, internet layer, transport layer, and application layer, and that includes IP in the internet layer and TCP in the transport layer.</descrip></descripGrp><ntig><termGrp><term id="120227">TCP/IP</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="489685">TCP/IP</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1379_120227_489686"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The suite of networking protocols arranged in four layers, which are called the link layer, internet layer, transport layer, and application layer, and that includes IP in the internet layer and TCP in the transport layer.</descrip></descripGrp><ntig><termGrp><term id="120227">TCP/IP</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="489686">ട്രാന്‍‌സ്മിഷന്‍ കണ്‍‌ട്രോള്‍ പ്രോട്ടോക്കോള്‍ / ഇന്‍റര്‍‌നെറ്റ് പ്രോട്ടോക്കോള്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1379_120228_489685"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The suite of networking protocols arranged in four layers, which are called the link layer, internet layer, transport layer, and application layer, and that includes IP in the internet layer and TCP in the transport layer.</descrip></descripGrp><ntig><termGrp><term id="120228">Transmission Control Protocol/Internet Protocol</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="489685">TCP/IP</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1379_120228_489686"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The suite of networking protocols arranged in four layers, which are called the link layer, internet layer, transport layer, and application layer, and that includes IP in the internet layer and TCP in the transport layer.</descrip></descripGrp><ntig><termGrp><term id="120228">Transmission Control Protocol/Internet Protocol</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="489686">ട്രാന്‍‌സ്മിഷന്‍ കണ്‍‌ട്രോള്‍ പ്രോട്ടോക്കോള്‍ / ഇന്‍റര്‍‌നെറ്റ് പ്രോട്ടോക്കോള്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13792_537611_1241853"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Programming using parametric polymorphism.</descrip></descripGrp><ntig><termGrp><term id="537611">generic programming</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1241853">ജനറിക് പ്രോഗ്രാമിംങ്ങ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13801_340167_1241854"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A standard protocol for providing Internet communications and advanced telephony services on phones, pagers, PDAs, and other wireless terminals.</descrip></descripGrp><ntig><termGrp><term id="340167">Wireless Application Protocol</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1241854">വയര്‍ലസ് ആപ്ലിക്കേഷന്‍ പ്രോട്ടോക്കോള്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13801_340167_1241855"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A standard protocol for providing Internet communications and advanced telephony services on phones, pagers, PDAs, and other wireless terminals.</descrip></descripGrp><ntig><termGrp><term id="340167">Wireless Application Protocol</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1241855">WAP</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13801_340168_1241854"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A standard protocol for providing Internet communications and advanced telephony services on phones, pagers, PDAs, and other wireless terminals.</descrip></descripGrp><ntig><termGrp><term id="340168">WAP</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1241854">വയര്‍ലസ് ആപ്ലിക്കേഷന്‍ പ്രോട്ടോക്കോള്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13801_340168_1241855"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A standard protocol for providing Internet communications and advanced telephony services on phones, pagers, PDAs, and other wireless terminals.</descrip></descripGrp><ntig><termGrp><term id="340168">WAP</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1241855">WAP</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13805_135723_1229010"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To adjust the perspective of an image or document in order to view a larger area on the screen at one time, as if viewed from farther away.</descrip></descripGrp><ntig><termGrp><term id="135723">zoom out</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1229010">സൂംഔട്ട് ചെയ്യുക</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13809_88455_489519"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The menu choice that allows a user to customize application behavior.</descrip></descripGrp><ntig><termGrp><term id="88455">Options</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="489519">ഐച്ഛികങ്ങള്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13810_17921_1241856"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application that enables its objects, methods, and properties to be controlled by other applications through Automation.</descrip></descripGrp><ntig><termGrp><term id="17921">Automation server</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1241856">സ്വയം പ്രവര്‍ത്തിക്കുന്ന സെര്‍വര്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13815_89046_1241857"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A message that can be sent to one or more recipients across one or more messaging systems or be posted to a folder in a message store.</descrip></descripGrp><ntig><termGrp><term id="89046">outgoing message</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1241857">പുറത്തേക്കു പോകുന്ന സന്ദേശം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13821_137076_1229781"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The sheet that you're working on in a workbook. The name on the tab of the active sheet is bold.</descrip></descripGrp><ntig><termGrp><term id="137076">active sheet</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1229781">സജീവ ഷീറ്റ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13822_148878_1241858"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A name that consists of an assembly's identity-its simple text name, version number, and culture information (if provided)-strengthened by a public key and a digital signature generated over the assembly. Because the assembly manifest contains file hashes for all the files that constitute the assembly implementation, it is sufficient to generate the digital signature over just the one file in the assembly that contains the assembly manifest. Assemblies with the same strong name are expected to be identical.</descrip></descripGrp><ntig><termGrp><term id="148878">strong name</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1241858">പങ്കിട്ട പേര്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13822_536954_1241858"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A name that consists of an assembly's identity-its simple text name, version number, and culture information (if provided)-strengthened by a public key and a digital signature generated over the assembly. Because the assembly manifest contains file hashes for all the files that constitute the assembly implementation, it is sufficient to generate the digital signature over just the one file in the assembly that contains the assembly manifest. Assemblies with the same strong name are expected to be identical.</descrip></descripGrp><ntig><termGrp><term id="536954">shared name</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1241858">പങ്കിട്ട പേര്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13829_237385_490244"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A customizable toolbar that provides one-click access to commands.</descrip></descripGrp><ntig><termGrp><term id="237385">Quick Access Toolbar</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="490244">ദ്രുത പ്രവേശന ഉപകരണബാര്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13835_141250_1779043"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A control on a menu, toolbar, dialog box, or data access page that displays a list of options when you click the small arrow next to the list box.</descrip></descripGrp><ntig><termGrp><term id="141250">drop-down list box</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1779043">ഡ്രോപ്പ്-ഡൌണ് ലിസ്റ്റ് ബോക്സ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13838_306445_489369"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A card, plug, or other device that connects pieces of hardware with the computer so that information can be moved from place to place. For example, standardized interfaces such as RS-232-C standard and SCSI enable communications between computers and printers or disks.</descrip></descripGrp><ntig><termGrp><term id="306445">hardware interface</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="489369">പൊതുപ്രതലം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13838_306445_490475"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A card, plug, or other device that connects pieces of hardware with the computer so that information can be moved from place to place. For example, standardized interfaces such as RS-232-C standard and SCSI enable communications between computers and printers or disks.</descrip></descripGrp><ntig><termGrp><term id="306445">hardware interface</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="490475">ഹാര്‍ഡ് വെയര്‍ പൊതുപ്രതലം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13838_68604_489369"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A card, plug, or other device that connects pieces of hardware with the computer so that information can be moved from place to place. For example, standardized interfaces such as RS-232-C standard and SCSI enable communications between computers and printers or disks.</descrip></descripGrp><ntig><termGrp><term id="68604">interface</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="489369">പൊതുപ്രതലം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13838_68604_490475"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A card, plug, or other device that connects pieces of hardware with the computer so that information can be moved from place to place. For example, standardized interfaces such as RS-232-C standard and SCSI enable communications between computers and printers or disks.</descrip></descripGrp><ntig><termGrp><term id="68604">interface</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="490475">ഹാര്‍ഡ് വെയര്‍ പൊതുപ്രതലം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13839_460702_1241859"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A database that is installed with Microsoft SQL Server and that provides the template for new user databases. SQL Server creates a database by copying in the contents of the model database and then expanding the new database to the size requested.</descrip></descripGrp><ntig><termGrp><term id="460702">model database</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1241859">മോഡല്‍ ഡാറ്റാബേസ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13842_253769_1229782"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A setting in which existing characters are replaced with newly typed characters.</descrip></descripGrp><ntig><termGrp><term id="253769">overtype mode</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1229782">ഓവര്‍ടൈപ് മോഡ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13846_61010_489321"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A capability of many programs and operating systems to display advice or instructions for using their features when so requested by the user, as by a screen button or menu item or a function key.</descrip></descripGrp><ntig><termGrp><term id="61010">help</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="489321">സഹായം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13846_61011_489321"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A capability of many programs and operating systems to display advice or instructions for using their features when so requested by the user, as by a screen button or menu item or a function key.</descrip></descripGrp><ntig><termGrp><term id="61011">online help</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="489321">സഹായം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13851_187369_1241860"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A string that contains information about an abnormal condition or error that occurs during the execution of a program.</descrip></descripGrp><ntig><termGrp><term id="187369">exception string</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1241860">ഒഴിവാക്കപ്പെട്ട സ്ട്രിംഗ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1386_32466_1241198"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A script consisting of statements that appear on the HTML page. The script is executed by the browser either when the document is loaded, or in response to an event such as a button click.</descrip></descripGrp><ntig><termGrp><term id="32466">client script</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1241198">ക്ലൈന്‍റ് സ്ക്രിപ്റ്റ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13862_187404_1241861"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to applications or forms that have greater security permissions and complete access to the system resources and other components on a user's computer.</descrip></descripGrp><ntig><termGrp><term id="187404">fully trusted</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1241861">പൂര്‍ണമായി വിശ്വസിക്കാവുന്ന</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13863_107546_2530662"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In facsimile and other optical technologies, to move a light-sensitive device across an image-bearing surface such as a page of text, converting the light and dark areas on the surface to binary digits that can be interpreted by a computer.</descrip></descripGrp><ntig><termGrp><term id="107546">scan</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2530662">സ്‌കാൻ ചെയ്യുക</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13863_107546_489609"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In facsimile and other optical technologies, to move a light-sensitive device across an image-bearing surface such as a page of text, converting the light and dark areas on the surface to binary digits that can be interpreted by a computer.</descrip></descripGrp><ntig><termGrp><term id="107546">scan</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="489609">സ്കാന്‍‌ചെയ്യുക</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13865_185672_2075796"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A small graphical symbol the user can insert into instant messages.</descrip></descripGrp><ntig><termGrp><term id="185672">emoticon</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2075796">ഇമോട്ടിക്കോണ്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13868_127558_1241862"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A software module that, when called by a Visual Basic application, produces a control that adds some desired feature to the application. A VBX is a separate executable file, usually written in C, that is dynamically linked to the application at run time and can be used by other applications, including some applications not developed in Visual Basic. Although VBX technology was developed by Microsoft, most VBXs have been written by third-party developers. VBXs are still in use, but the technology has been superseded by OCXs and ActiveX controls.</descrip></descripGrp><ntig><termGrp><term id="127558">VBX</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1241862">VBX</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13868_690493_1241862"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A software module that, when called by a Visual Basic application, produces a control that adds some desired feature to the application. A VBX is a separate executable file, usually written in C, that is dynamically linked to the application at run time and can be used by other applications, including some applications not developed in Visual Basic. Although VBX technology was developed by Microsoft, most VBXs have been written by third-party developers. VBXs are still in use, but the technology has been superseded by OCXs and ActiveX controls.</descrip></descripGrp><ntig><termGrp><term id="690493">Visual Basic eXtension</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1241862">VBX</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13873_122536_489705"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An individual song or other discrete piece of audio content.</descrip></descripGrp><ntig><termGrp><term id="122536">track</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="489705">ട്രാക്ക്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13873_640881_489705"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An individual song or other discrete piece of audio content.</descrip></descripGrp><ntig><termGrp><term id="640881">audio track</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="489705">ട്രാക്ക്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13874_120089_489684"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A button that represents an item or program that is open and running on your computer. For example, if you open Microsoft Word, and then minimize it, it will be displayed as a taskbar button, which you can then click when you want to maximize it.</descrip></descripGrp><ntig><termGrp><term id="120089">taskbar button</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="489684">ചുമതലാബാര്‍ ബട്ടണ്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13875_397173_1961085"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mail-enabled Active Directory contact that contains information about people or organizations that exist outside an Exchange Server organization. Each mail contact has an external email address.</descrip></descripGrp><ntig><termGrp><term id="397173">mail contact</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1961085">മെയില്‍ കോണ്‍ടാക്റ്റ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13878_187630_1241863"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A debugging feature that hides non-user code so that it does not appear in the debugger windows.</descrip></descripGrp><ntig><termGrp><term id="187630">My Code</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1241863">എന്‍റെ കോഡ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13883_43673_489184"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To detect, locate, and correct logical or syntactical errors in a program or malfunctions in hardware. In hardware contexts, the term troubleshoot is the term more often used, especially when the problem is a major one.</descrip></descripGrp><ntig><termGrp><term id="43673">debug</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="489184">ഡീബഗ്ഗുചെയ്യുക</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13886_186958_1241864"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The abstract type of an application server, which defines common characteristics of a class of logical application servers including the set of supported abstract endpoint definitions.</descrip></descripGrp><ntig><termGrp><term id="186958">abstract server definition</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1241864">അബ്സ്ട്രാക്റ്റ് സെര്‍വര്‍ നിയന്ത്രണം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13888_237793_1229783"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A testing process that supplies structured but invalid input to software application programming interfaces (APIs) and network interfaces to maximize the likelihood of detecting errors that might lead to software vulnerabilities.</descrip></descripGrp><ntig><termGrp><term id="237793">fuzz testing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1229783">ഫസിങ്ങ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13888_237793_1241865"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A testing process that supplies structured but invalid input to software application programming interfaces (APIs) and network interfaces to maximize the likelihood of detecting errors that might lead to software vulnerabilities.</descrip></descripGrp><ntig><termGrp><term id="237793">fuzz testing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1241865">fuzz പരിശോധിക്കല്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13888_237793_2848142"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A testing process that supplies structured but invalid input to software application programming interfaces (APIs) and network interfaces to maximize the likelihood of detecting errors that might lead to software vulnerabilities.</descrip></descripGrp><ntig><termGrp><term id="237793">fuzz testing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2848142">ഫസ് ടെസ്‌റ്റിംഗ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13888_237793_2848144"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A testing process that supplies structured but invalid input to software application programming interfaces (APIs) and network interfaces to maximize the likelihood of detecting errors that might lead to software vulnerabilities.</descrip></descripGrp><ntig><termGrp><term id="237793">fuzz testing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2848144">ഫസിംഗ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13888_767358_1229783"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A testing process that supplies structured but invalid input to software application programming interfaces (APIs) and network interfaces to maximize the likelihood of detecting errors that might lead to software vulnerabilities.</descrip></descripGrp><ntig><termGrp><term id="767358">fuzzing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1229783">ഫസിങ്ങ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13888_767358_1241865"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A testing process that supplies structured but invalid input to software application programming interfaces (APIs) and network interfaces to maximize the likelihood of detecting errors that might lead to software vulnerabilities.</descrip></descripGrp><ntig><termGrp><term id="767358">fuzzing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1241865">fuzz പരിശോധിക്കല്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13888_767358_2848142"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A testing process that supplies structured but invalid input to software application programming interfaces (APIs) and network interfaces to maximize the likelihood of detecting errors that might lead to software vulnerabilities.</descrip></descripGrp><ntig><termGrp><term id="767358">fuzzing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2848142">ഫസ് ടെസ്‌റ്റിംഗ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13888_767358_2848144"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A testing process that supplies structured but invalid input to software application programming interfaces (APIs) and network interfaces to maximize the likelihood of detecting errors that might lead to software vulnerabilities.</descrip></descripGrp><ntig><termGrp><term id="767358">fuzzing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="2848144">ഫസിംഗ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13892_536535_1241866"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A section of the Web.config file where you specify values for specific mobile devices. These values are used to create device-specific content.</descrip></descripGrp><ntig><termGrp><term id="536535">device filter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1241866">ഉപാധി അരിപ്പകള്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13894_297011_490431"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A program that installs other potentially unwanted software, such as adware or spyware. The license agreement of the bundling program may require these other components in order to function.</descrip></descripGrp><ntig><termGrp><term id="297011">software bundler</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="490431">സോഫ്റ്റ്‌വെയര്‍ ബണ്ട്‌ലര്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13902_142582_1877803"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A microphone feature that allows your input to be amplified so that it is made louder for use by the system.</descrip></descripGrp><ntig><termGrp><term id="142582">gain adjustment</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1877803">ശബ്‌ദലഭ്യത ക്രമീകരണം</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13907_109815_1877743"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An executable program file that contains one or more compressed text or data files. When a user runs the program, it uncompresses the compressed files and stores them on the user's hard drive.</descrip></descripGrp><ntig><termGrp><term id="109815">self-extracting file</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1877743">സ്വയം എക്‌സ്‌ട്രാക്റ്റുചെയ്യുന്ന ഫയല്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13915_107179_1241867"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in some versions of Windows that allows applications to include speech recognition or convert text to speech.</descrip></descripGrp><ntig><termGrp><term id="107179">SAPI</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1241867">SAPI</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13915_107180_1241867"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in some versions of Windows that allows applications to include speech recognition or convert text to speech.</descrip></descripGrp><ntig><termGrp><term id="107180">Speech API</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1241867">SAPI</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13915_512277_1241867"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in some versions of Windows that allows applications to include speech recognition or convert text to speech.</descrip></descripGrp><ntig><termGrp><term id="512277">Speech Application Programming Interface</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1241867">SAPI</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13920_23913_489030"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Of or relating to communications systems in which the medium of transmission (such as a wire or fiber-optic cable) carries multiple messages at a time, each message modulated on its own carrier frequency by a modem.</descrip></descripGrp><ntig><termGrp><term id="23913">broadband</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="489030">ബ്രോഡ്‌ബാന്‍ഡ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13926_299909_1229011"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Windows technology that collects data when the system crashes or stops responding and sends it to Microsoft.</descrip></descripGrp><ntig><termGrp><term id="299909">Windows Error Reporting</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1229011">Windows തെറ്റ് റിപ്പോര്‍ട്ട് ചെയ്യല്‍</term><termNote type="geographica