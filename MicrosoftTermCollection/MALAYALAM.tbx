ech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1960893">alt ടെക്സ്റ്റ്</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12177_57803_1241771"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of adjusting an image input signal to correctly display on a particular device.</descrip></descripGrp><ntig><termGrp><term id="57803">gamma correction</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1241771">ഗാമാ തിരുത്തല്‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12180_237293_1877937"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables the user to access Outlook data over the Internet without a VPN connection.</descrip></descripGrp><ntig><termGrp><term id="237293">Outlook Anywhere</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ml-IN"><ntig><termGrp><term id="1877937">Outlook Anywhere</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12188_187770_1241772"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A data provi