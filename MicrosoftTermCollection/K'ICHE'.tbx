remaining too hard to be economically solved by computers.</descrip></descripGrp><ntig><termGrp><term id="747522">CAPTCHA</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="2049038">k'amb'ejanik HIP</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="543_747523_2049038"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A challenge meant to be easily solved by humans, while remaining too hard to be economically solved by computers.</descrip></descripGrp><ntig><termGrp><term id="747523">Completely Automated Public Turing test to tell Computers and Humans Apart</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="2049038">k'amb'ejanik HIP</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5434_119301_1906520"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A location on the horizontal ruler that indicates how far to indent text or where to begin a column of text.</descrip></descripGrp><ntig><termGrp><term id="119301">tab stop</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1906520">uxo'laxik tz'ib'</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGen