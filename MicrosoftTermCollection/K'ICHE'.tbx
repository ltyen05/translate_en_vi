set up a different receive folder for each message class that you handle or use one folder for all of the classes.</descrip></descripGrp><ntig><termGrp><term id="1275574">incoming mail</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1906471">rokikib'al oqxa'n</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14121_65267_1906471"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A message that has been sent across one or more messaging systems. It may have been sent only to you or to many other recipients. Incoming messages are placed in a receive folder designated to hold messages of a particular class. You can set up a different receive folder for each message class that you handle or use one folder for all of the classes.</descrip></descripGrp><ntig><termGrp><term id="65267">incoming message</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1906471">rokikib'al oqxa'n</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14125_118591_1595859"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The person responsible for setting up and managing local computers, stand-alone servers, member servers, or domain controllers. An administrator performs such duties as assigning user accounts and passwords, establishing security access levels, watching for unauthorized access, allocating storage space, and helping users with networking problems.</descrip></descripGrp><ntig><termGrp><term id="118591">system administrator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1595859">kemchajinel</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14125_118591_1773050"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The person responsible for setting up and managing local computers, stand-alone servers, member servers, or domain controllers. An administrator performs such duties as assigning user accounts and passwords, establishing security access levels, watching for unauthorized access, allocating storage space, and helping users with networking problems.</descrip></descripGrp><ntig><termGrp><term id="118591">system administrator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1773050">kemchajinel rech kemwokchakub'al</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14125_118592_1595859"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The person responsible for setting up and managing local computers, stand-alone servers, member servers, or domain controllers. An administrator performs such duties as assigning user accounts and passwords, establishing security access levels, watching for unauthorized access,