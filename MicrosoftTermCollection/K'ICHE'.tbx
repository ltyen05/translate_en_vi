<term id="53143">failure</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1596124">man utz taj</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12405_184041_1906729"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mode that enables the user to move a document by dragging it. Panning mode is available when a Word document is displayed on a preview pane.</descrip></descripGrp><ntig><termGrp><term id="184041">panning mode</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1906729">ucholajil ilib'al</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12419_237283_1906857"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An enhanced spell-check feature that looks at words before or after the word in question to assess proper usage. This allows the software to flag correctly-spelled words as 'wrong' if the usage appears to be incorrect.</descrip></descripGrp><ntig><termGrp><term id="237283">Contextual Spelling</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1906857">Tz'ib'anem cholokib'al</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGend