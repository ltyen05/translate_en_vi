et xml:lang="qut-GT"><ntig><termGrp><term id="1596393">kemwach</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7703_145418_1906654"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The file on your hard disk that contains offline folders. The offline folder file has an .ost extension. You can create it automatically when you set up Outlook, or when you first make a folder available offline.</descrip></descripGrp><ntig><termGrp><term id="145418">offline folder file</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1906654">kemk'olb'al chak man t'iqital taj</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7712_130661_1596622"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An area of storage on a hard disk. A volume is formatted by using a file system, such as NTFS, and has a drive letter assigned to it. A single hard disk can have multiple volumes. Some volumes can span multiple hard disks.</descrip></descripGrp><ntig><termGrp><term id="130661">volume</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1596622">kemunimal</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></la