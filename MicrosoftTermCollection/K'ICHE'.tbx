type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1592192">aninaqil oqxa'n kech winaqil man e tiqil taj</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21543_777733_1592269"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The helper program that can store sign-in information for multiple Windows Live IDs.</descrip></descripGrp><ntig><termGrp><term id="777733">Windows Live Sign-in Assistant</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1592269">Tob'anel chech majb'al chak pa Windows Live</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21545_777735_1907127"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that offers improved security by loading a document in a read-only view, rather than in the full editor, for scenarios that pose a greater potential security risk.</descrip></descripGrp><ntig><termGrp><term id="777735">Protected View</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1907127">Ilb'al chajitalik</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21546_777736_1907128"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A package containing everything you need to show one or many PowerPoint presentations on another computer. This package can be saved to a folder or burned to a CD.</descrip></descripGrp><ntig><termGrp><term id="777736">presentation package</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1907128">le k'utunsanem rech le k'olchak</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21549_777739_1907129"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows the user to indicate that a document is trusted, and therefore can be opened without security notifications, so long as the file path and creation time of the document remain unchanged.</descrip></descripGrp><ntig><termGrp><term id="777739">Trusted Documents</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1907129">Wokwujchak q'a'lib'al k'u'xaj</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21550_777740_1653564"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A list that displays someone's recent activity on Windows Store apps such as Messaging and Facebook.</descrip></descripGrp><ntig><termGrp><term id="777740">what's new</term><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1653564">k'ak' jastaq</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21551_777741_2319245"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The contact picture label that indicates someone has been invited to do something, but has not responded yet.</descrip></descripGrp><ntig><termGrp><term id="777741">Invited</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="2319245">Sik'im</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21553_777744_1592295"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The link to the webpage where a user manages photos and albums.</descrip></descripGrp><ntig><termGrp><term id="777744">Photos</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1592295">e Wachib'al</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21554_777746_1592288"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The link to the main landing/start page on Windows Live.</descrip></descripGrp><ntig><termGrp><term id="777746">Home</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1592288">Jeqb'al</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21563_777782_1596418"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Windows library that allows users to store, manage and share all their recorded TV items.</descrip></descripGrp><ntig><termGrp><term id="777782">Recorded TV Library</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1596418">K'olwokaj q'axwachib'al</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21573_777813_1907130"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows you to preview the appearance of a formatting option or command before actually applying it to selected text or objects.</descrip></descripGrp><ntig><termGrp><term id="777813">Live Preview</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1907130">K'utwachinem</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21635_779036_1697271"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Windows feature that provides a direct connection to a corporate network for people working outside of the office. It is a superior alternative to VPN.</descrip></descripGrp><ntig><termGrp><term id="779036">DirectAccess</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1697271">DirectAccess</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21637_779040_1990376"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A PC (desktop and beyond) search platform that allows search of the local hard drive plus network locations like SharePoint sites and the Internet.</descrip></descripGrp><ntig><termGrp><term id="779040">Windows Search</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1990376">Windows Search</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21638_1276167_1595837"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of attributes that define a user's access to a given service or application.</descrip></descripGrp><ntig><termGrp><term id="1276167">identity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1595837">kemb'i'aj</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21638_779054_1595837"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of attributes that define a user's access to a given service or application.</descrip></descripGrp><ntig><termGrp><term id="779054">account</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1595837">kemb'i'aj</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21640_779056_1999750"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To break a connection.</descrip></descripGrp><ntig><termGrp><term id="779056">disconnect</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1999750">utoq'ob'exik</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21755_779690_1907132"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show a progression, a timeline, or sequential steps in a task, process, or workflow. Works well for illustrating both Level 1 and Level 2 text.</descrip></descripGrp><ntig><termGrp><term id="779690">Accent Process</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1907132">Q'axnem uya'ik</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21756_779691_1907133"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show groups of information or sequential steps in a task, process, or workflow. Emphasizes the interaction or relationships among the groups of information.</descrip></descripGrp><ntig><termGrp><term id="779691">Alternating Flow</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1907133">Ukab' k'iyarempatan</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21757_779692_1907134"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show either related or contrasting concepts with some connection, such as opposing forces. The first two lines of Level 1 text are used for text in the arrows. Unused text does not appear, but remains available if you switch layouts.</descrip></descripGrp><ntig><termGrp><term id="779692">Arrow Ribbon</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1907134">xaq'ab' re ch'ab'</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21758_779693_1595905"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to compare or show the relationship between two ideas. Each of the first two lines of Level 1 text corresponds to text at the top of one side of the center point. Emphasizes Level 2 text, which is limited to four shapes on each side of the center point. The balance tips towards the side with the most shapes containing Level 2 text. Unused text does not appear, but remains available if you switch layouts.</descrip></descripGrp><ntig><termGrp><term id="779693">Balance</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1595905">upanik'ajilal</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21759_779694_1907135"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show a progression or sequential steps in a task, process, or workflow. Maximizes both horizontal and vertical display space for shapes.</descrip></descripGrp><ntig><termGrp><term id="779694">Basic Bending Process</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1907135">Q'axnem kotokik qas kachokonik</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21760_779695_1907136"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show non-sequential or grouped blocks of information. Maximizes both horizontal and vertical display space for shapes.</descrip></descripGrp><ntig><termGrp><term id="779695">Basic Block List</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1907136">Ucholajil ub'antajik ruka'am rib' qas kachokonik</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21761_779696_1907137"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show a progression; a timeline; sequential steps in a task, process, or workflow; or to emphasize movement or direction. Level 1 text appears inside an arrow shape while Level 2 text appears below the arrow shapes.</descrip></descripGrp><ntig><termGrp><term id="779696">Basic Chevron Process</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1907137">Q'axnem cheuron qas kachokonik</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21762_779697_1907138"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to represent a continuing sequence of stages, tasks, or events in a circular flow. Emphasizes the stages or steps rather than the connecting arrows or flow. Works best with Level 1 text only.</descrip></descripGrp><ntig><termGrp><term id="779697">Basic Cycle</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1907138">K'utunsanwachib'al qas kachokonik</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21763_779698_1907139"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show the relationship of components to a whole in quadrants. The first four lines of Level 1 text appear in the quadrants. Unused text does not appear, but remains available if you switch layouts.</descrip></descripGrp><ntig><termGrp><term id="779698">Basic Matrix</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1907139">Wokob'al qas kachokonik</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21764_779699_1907140"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show how individual parts form a whole. The first seven lines of Level 1 text correspond to the evenly distributed wedge or pie shapes. The top Level 1 text shape appears outside of the rest of the pie for emphasis. Unused text does not appear, but remains available if you switch layouts.</descrip></descripGrp><ntig><termGrp><term id="779699">Basic Pie</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1907140">Setesik kemwokib'al qas kachokonik</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21765_779700_1907141"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show a progression or sequential steps in a task, process, or workflow.</descrip></descripGrp><ntig><termGrp><term id="779700">Basic Process</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1907141">Q'axnem chak qas kachokonik</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21766_779701_1907142"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show proportional, interconnected, or hierarchical relationships with the largest component on the bottom and narrowing up. Level 1 text appears in the pyramid segments and Level 2 text appears in shapes alongside each segment.</descrip></descripGrp><ntig><termGrp><term id="779701">Basic Pyramid</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1907142">K'utb'al tz'uq qas kachokonik</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21767_779702_1907143"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show the relationship to a central idea in a cycle. The first line of Level 1 text corresponds to the central shape, and its Level 2 text corresponds to the surrounding circular shapes. Unused text does not appear, but remains available if you switch layouts.</descrip></descripGrp><ntig><termGrp><term id="779702">Basic Radial</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1907143">Uk'u'x uq'alajsaxik na'oj qas kachokonik</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21768_779703_1907144"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show containment, gradations, or hierarchical relationships. The first five lines of Level 1 text are associated with a circle. Unused text does not appear, but remains available if you switch layouts.</descrip></descripGrp><ntig><termGrp><term id="779703">Basic Target</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1907144">Rayib'al eqele'mal qas kachokonik</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21769_779704_1907145"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show sequential steps in a task, process, or workflow, or to show timeline information. Works well with both Level 1 and Level 2 text.</descrip></descripGrp><ntig><termGrp><term id="779704">Basic Timeline</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1907145">Juch' rech kajb'al qas kachokonik</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21770_779705_1907146"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show overlapping or interconnected relationships. The first seven lines of Level 1 text correspond with a circle. If there are four or fewer lines of Level 1 text, the text is inside the circles. If there are more than four lines of Level 1 text, the text is outside of the circles. Unused text does not appear, but remains available if you switch layouts.</descrip></descripGrp><ntig><termGrp><term id="779705">Basic Venn</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1907146">K'utb'al Venn qas kachokonik</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21771_779706_1907147"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show non-sequential or grouped blocks of information. The small circular shapes are designed to contain pictures. Works well for illustrating both Level 1 and Level 2 text. Maximizes both horizontal and vertical display space for shapes.</descrip></descripGrp><ntig><termGrp><term id="779706">Bending Picture Accent List</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1907147">Ucholajil ruk' taq setesik chi uxe'</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21772_779707_1907148"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to represent a continuing sequence of stages, tasks, or events in a circular flow. Emphasizes the stages or steps rather than the connecting arrows or flow.</descrip></descripGrp><ntig><termGrp><term id="779707">Block Cycle</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1907148">K'utunsanwachib'al rech q'atetb'al</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21773_779708_1907149"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show a progression through several processes that make up an overall workflow. Also works for illustrating contrasting processes. The Level 1 text corresponds to the first arrow shape on the left, while the Level 2 text corresponds to horizontal sub-steps for each shape that contains Level 1 text.</descrip></descripGrp><ntig><termGrp><term id="779708">Chevron List</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1907149">Ucholajil le cheuron</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21774_779709_1907150"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show a long or non-linear sequence or steps in a task, process, or workflow. Works best with Level 1 text only. Maximizes both horizontal and vertical display space for shapes.</descrip></descripGrp><ntig><termGrp><term id="779709">Circular Bending Process</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1907150">Q'axnem kotokik ruk' setesik</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21775_779710_1907151"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show a progression, a timeline, or sequential steps in a task, process, or workflow, or to emphasize movement or direction. Can be used to emphasize information in the starting shape. Works best with Level 1 text only.</descrip></descripGrp><ntig><termGrp><term id="779710">Closed Chevron Process</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1907151">Q'axnem rech cheuron tz'apitalik</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21776_779711_1907152"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show a timeline or sequential steps in a task, process, or workflow. Works best with Level 1 text because each line of Level 1 text appears inside the arrow shape. Level 2 text appears outside the arrow shape.</descrip></descripGrp><ntig><termGrp><term id="779711">Continuous Arrow Process</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1907152">q'axnem rech ch'ab' amaq'el</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21777_779712_1907153"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show a progression or sequential steps in a task, process, or workflow. Works best with minimal Level 1 and Level 2 text.</descrip></descripGrp><ntig><termGrp><term id="779712">Continuous Block Process</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1907153">Ruk'a'am rib' amaq'el</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21778_779713_1907154"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to represent a continuing sequence of stages, tasks, or events in a circular flow. Emphasizes the connection between all components. Works best with Level 1 text only.</descrip></descripGrp><ntig><termGrp><term id="779713">Continuous Cycle</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1907154">K'utunsanwachib'al amaq'el</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21779_779714_1907155"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show groups of interconnected information. The circular shapes are designed to contain pictures.</descrip></descripGrp><ntig><termGrp><term id="779714">Continuous Picture List</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1907155">Kemucholajil wachib'al amaq'el</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21780_779715_1907156"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show ideas or concepts that converge to a central point. Works best with Level 1 text only.</descrip></descripGrp><ntig><termGrp><term id="779715">Converging Arrows</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1907156">Ch'ab' k'utb'al tzij</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21781_779716_1907157"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show relationships of concepts or components to a central idea in a cycle. The first line of Level 1 text corresponds to the central circular shape and the lines of Level 2 text correspond to the surrounding rectangular shapes. Unused text does not appear, but remains available if you switch layouts.</descrip></descripGrp><ntig><termGrp><term id="779716">Converging Radial</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1907157">Uk'u'x uq'alajsaxik k'utb'al na'oj</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21782_779717_1907158"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show two opposing ideas or concepts. Each of the first two lines of Level 1 text corresponds to an arrow and works well with Level 2 text. Unused text does not appear, but remains available if you switch layouts.</descrip></descripGrp><ntig><termGrp><term id="779717">Counterbalance Arrows</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1907158">Ch'ab' rech ujunumaxik tzij</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21783_779718_1907159"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show the relationship to a central idea in a cyclical progression. Each of the first four lines of Level 1 text corresponds to a wedge or pie shape, and Level 2 text appears in a rectangular shape to the side of the wedge or pie shape. Unused text does not appear, but remains available if you switch layouts.</descrip></descripGrp><ntig><termGrp><term id="779718">Cycle Matrix</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1907159">Wokob'al re k'utwachib'al</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21784_779719_1907160"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used with large amounts of Level 2 text to show a progression through stages.</descrip></descripGrp><ntig><termGrp><term id="779719">Detailed Process</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1907160">Q'axnem rech ucholajil</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21785_779720_1907161"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show ideas or concepts that progress outward from a central source. Works best with Level 1 text only.</descrip></descripGrp><ntig><termGrp><term id="779720">Diverging Arrows</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1907161">Ch'ab' rech taq juch' xuquje' lik'ilik</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21786_779721_1907162"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show relationships to a central idea in a cycle. The first Level 1 line of text corresponds to the central circular shape. Emphasizes the surrounding circles rather than the central idea. Unused text does not appear, but remains available if you switch layouts.</descrip></descripGrp><ntig><termGrp><term id="779721">Diverging Radial</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1907162">Uk'u'x uq'alajisaxik na'oj rech taq juch' xuquje' lik'ilik</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21787_779722_1907163"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show sequential steps or tasks that depict a plan or result. The last Level 1 line of text appears after the equals sign (=).Works best with Level 1 text only.</descrip></descripGrp><ntig><termGrp><term id="779722">Equation</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1907163">Junamil ajilanem</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21788_779723_1907164"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show the filtering of information or how parts merge into a whole. Emphasizes the final outcome. Can contain up to four lines of Level 1 text; the last of these four Level 1 text lines appears below the funnel and the other lines correspond to a circular shape. Unused text does not appear, but remains available if you switch layouts.</descrip></descripGrp><ntig><termGrp><term id="779723">Funnel</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1907164">Kemchayub'al</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21789_779724_1907165"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show interlocking ideas. Each of the first three lines of Level 1 text corresponds to a gear shape, and their corresponding Level 2 text appears in rectangles next to the gear shape. Unused text does not appear, but remains available if you switch layouts.</descrip></descripGrp><ntig><termGrp><term id="779724">Gear</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1907165">Uware' ch'ich'</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21790_779725_1907166"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show the placement of concepts along two axes. Emphasizes the individual components rather than the whole. The first four lines of Level 1 text appear in the quadrants. Unused text does not appear, but remains available if you switch layouts.</descrip></descripGrp><ntig><termGrp><term id="779725">Grid Matrix</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1907166">Kajib' taq uxukut wokob'al</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21791_779726_1907167"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show groups and sub-groups of information, or steps and sub-steps in a task, process, or workflow. Level 1 text corresponds to the top-level horizontal shapes, and Level 2 text corresponds to vertical sub-steps under each related top-level shape. Works well for emphasizing sub-groups or sub-steps, hierarchical information, or multiple lists of information.</descrip></descripGrp><ntig><termGrp><term id="779726">Grouped List</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1907167">Mulital cholajil</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21792_779727_1907168"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show hierarchical relationships progressing from top to bottom.</descrip></descripGrp><ntig><termGrp><term id="779727">Hierarchy</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1907168">Eqele'mal</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21793_779728_1907169"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show hierarchical relationships progressing across groups. Can also be used to group or list information.</descrip></descripGrp><ntig><termGrp><term id="779728">Hierarchy List</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1907169">Ucholajil rech eqele'mal</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21794_779729_1907170"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show non-sequential or grouped lists of information. Works well with large amounts of text. All text has the same level of emphasis, and direction is not implied.</descrip></descripGrp><ntig><termGrp><term id="779729">Horizontal Bullet List</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1907170">Ucholajil rech retz'eb'alil q'e't</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21795_779730_1907171"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show hierarchical relationships progressing horizontally. Works well for decision trees.</descrip></descripGrp><ntig><termGrp><term id="779730">Horizontal Hierarchy</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1907171">q'etal eqele'mal</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21796_779731_1907172"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show non-sequential or grouped information with an emphasis on related pictures. The top shapes are designed to contain pictures.</descrip></descripGrp><ntig><termGrp><term id="779731">Horizontal Picture List</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1907172">q'e'tal cholaj rech wachib'al</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21797_779732_1907173"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show hierarchical relationships progressing horizontally and grouped hierarchically. Emphasizes heading or level 1 text. The first line of Level 1 text appears in the shape at the beginning of the hierarchy, and the second and all subsequent lines of Level 1 text appear at the top of the tall rectangles.</descrip></descripGrp><ntig><termGrp><term id="779732">Horizontal Labeled Hierarchy</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1907173">Eqele'mal q'e't kojom retal</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21798_779733_1907174"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show proportional, or interconnected, or hierarchical relationships with the largest component on the top and narrowing down. Level 1 text appears in the pyramid segments and Level 2 text appears in shapes alongside each segment.</descrip></descripGrp><ntig><termGrp><term id="779733">Inverted Pyramid</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1907174">Xulan uwi' oxtz'aq</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21799_779734_1907175"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show hierarchical relationships progressing from top to bottom and grouped hierarchically. Emphasizes heading or level 1 text. The first line of Level 1 text appears in the shape at the beginning of the hierarchy, and all subsequent lines of Level 1 text appear to the left of the tall rectangles.</descrip></descripGrp><ntig><termGrp><term id="779734">Labeled Hierarchy</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1907175">Eqele'mal kojom retal</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21800_779735_1907176"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show overlapping relationships in a sequence. Works best with Level 1 text only.</descrip></descripGrp><ntig><termGrp><term id="779735">Linear Venn</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1907176">Juch' Venn</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21801_779736_1907177"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to represent a continuing sequence of stages, tasks, or events that can occur in any direction.</descrip></descripGrp><ntig><termGrp><term id="779736">Multidirectional Cycle</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1907177">Sutchak k'i ub'e'al</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21802_779737_1907178"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show containment relationships. Each of the first three lines of Level 1 text correspond to the upper left text in the shapes, and Level 2 text corresponds to the smaller shapes. Works best with minimal Level 2 lines of text. Unused text does not appear, but remains available if you switch layouts.</descrip></descripGrp><ntig><termGrp><term id="779737">Nested Target</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1907178">uk'olb'al eyeb'al</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21803_779738_1907179"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to represent a continuing sequence of stages, tasks, or events in a circular flow. Each shape has the same level of importance. Works well when direction does not need to be indicated.</descrip></descripGrp><ntig><termGrp><term id="779738">Nondirectional Cycle</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1907179">sutchak maj ub'e'al</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21804_779739_1907180"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show two opposing ideas, or ideas that diverge from a central point. Each of the first two lines of Level 1 text corresponds to an arrow. Unused text does not appear, but remains available if you switch layouts.</descrip></descripGrp><ntig><termGrp><term id="779739">Opposing Arrows</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1907180">Taq ch'ab' ujalom utza'm</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21805_779740_1907181"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show hierarchical information or reporting relationships in an organization. The assistant shape and the Org Chart hanging layouts are available with this layout.</descrip></descripGrp><ntig><termGrp><term id="779740">Organization Chart</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1907181">K'utwachib'al</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21806_779741_1907182"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show grouped or related information. The small shapes on the upper corners are designed to contain pictures. Emphasizes Level 2 text over Level 1 text, and is a good choice for large amounts of Level 2 text.</descrip></descripGrp><ntig><termGrp><term id="779741">Picture Accent List</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1907182">Cholajil rech ajawatal e wachib'al</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21807_779742_1907183"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show sequential steps in a task, process, or workflow. The rectangular shapes in the background are designed to contain pictures.</descrip></descripGrp><ntig><termGrp><term id="779742">Picture Accent Process</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1907183">Q'axnem rech ajawatal e wachib'al</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21808_779743_1907184"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show non-sequential or grouped blocks of information. The top shapes are designed to contain pictures and pictures are emphasized over text. Works well for pictures with short text captions.</descrip></descripGrp><ntig><termGrp><term id="779743">Picture Caption List</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1907184">Chol sutaq rech taq ub'i le e wachib'al</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21809_779744_1907185"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show information illustrating a process or workflow. Level 1 text appears in the circular shapes and Level 2 text appears in the arrow shapes. Works best for minimal text and to emphasize movement or direction.</descrip></descripGrp><ntig><termGrp><term id="779744">Process Arrows</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1907185">Ch'ab' uq'alajisab'al chak</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21810_779745_1907186"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show multiple groups of information or steps and sub-steps in a task, process, or workflow. Level 1 text corresponds to the top horizontal shapes, and Level 2 text corresponds to vertical sub-steps under each related top-level shape.</descrip></descripGrp><ntig><termGrp><term id="779745">Process List</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1907186">Cholajil rech uq'alajisab'al k'i chak</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21811_779746_1907187"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show proportional, interconnected, or hierarchical relationships. Text appears in the rectangular shapes on top of the pyramid background</descrip></descripGrp><ntig><termGrp><term id="779746">Pyramid List</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1907187">Cholajil pa tz'uq</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21812_779747_1907188"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show the relationship to a central idea. Emphasizes both information in the center circle and how information in the outer ring of circles contributes to the central idea. The first Level 1 line of text corresponds to the central circle, and its Level 2 text corresponds to the outer ring of circles. Unused text does not appear, but remains available if you switch layouts.</descrip></descripGrp><ntig><termGrp><term id="779747">Radial Cycle</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1907188">K'utunsanwachib'al ch'aweb'al</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21813_779748_1907189"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show relationships to a central idea in a cycle. The center shape can contain a picture. Level 1 text appears in the smaller circles and any related Level 2 text appears to the side of the smaller circles.</descrip></descripGrp><ntig><termGrp><term id="779748">Radial List</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1907189">Cholajil ch'aweb'al</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21814_779749_1907190"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show both overlapping relationships and the relationship to a central idea in a cycle. The first line of Level 1 text corresponds to the central shape and the lines of Level 2 text correspond to the surrounding circular shapes. Unused text does not appear, but remains available if you switch layouts.</descrip></descripGrp><ntig><termGrp><term id="779749">Radial Venn</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1907190">Venn uk'u'x uq'alajisaxik</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21815_779750_1907191"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show a progression or sequential steps in a task, process, or workflow. Maximizes both horizontal and vertical display space for shapes. Does not emphasize directionality.</descrip></descripGrp><ntig><termGrp><term id="779750">Repeating Bending Process</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1907191">Ukamulixik q'axnem kotokik</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21816_779751_1907192"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show a progression or a sequence of stages, tasks, or events in a circular flow. Emphasizes the interconnected pieces. Each of the first seven lines of Level 1 text corresponds to a wedge or pie shape. Unused text does not appear, but remains available if you switch layouts.</descrip></descripGrp><ntig><termGrp><term id="779751">Segmented Cycle</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1907192">Tastal k'utunsanwachib'al</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21817_779752_1907193"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show a progression or sequential steps in a task, process, or workflow. Emphasizes Level 2 text, since each line appears in a separate shape.</descrip></descripGrp><ntig><termGrp><term id="779752">Segmented Process</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1907193">Tastal q'axnem</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21818_779753_1907194"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show containment, proportional, or interconnected relationships. The first nine lines of Level 1 text appear in the triangular shapes. Unused text does not appear, but remains available if you switch layouts. Works best with Level 1 text only.</descrip></descripGrp><ntig><termGrp><term id="779753">Segmented Pyramid</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1907194">Tastal tz'u'q</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21819_779754_1907195"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show groups of information or steps in a task, process, or workflow. Circular shapes contain Level 1 text, and the corresponding rectangles contain Level 2 text. Works well for numerous details and minimal Level 1 text.</descrip></descripGrp><ntig><termGrp><term id="779754">Stacked List</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1907195">Nutum cholajil</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21820_779755_1907196"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show a downward progression through stages. Each of the first five lines of Level 1 text corresponds with a rectangle. Unused text does not appear, but remains available if you switch layouts.</descrip></descripGrp><ntig><termGrp><term id="779755">Staggered Process</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1907196">Nututal q'axnem</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21821_779756_1907197"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show groups of information built from top to bottom, and the hierarchies within each group. This layout does not contain connecting lines.</descrip></descripGrp><ntig><termGrp><term id="779756">Table Hierarchy</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1907197">Eqele'mal xukutb'al</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21822_779757_1907198"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show grouped or related information of equal value. The first Level 1 line of text corresponds to the top shape and its Level 2 text is used for the subsequent lists.</descrip></descripGrp><ntig><termGrp><term id="779757">Table List</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1907198">Kemq'e'tk'olib'al Jamalik</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21823_779758_1907199"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show interrelated or overlapping information. Each of the first seven lines of Level 1 text appears in the rectangular shape. Unused text does not appear, but remains available if you switch layouts. Works well with both Level 1 and Level 2 text.</descrip></descripGrp><ntig><termGrp><term id="779758">Target List</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1907199">Rayb'al cholajil</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21824_779759_1907200"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to represent a continuing sequence of stages, tasks, or events in a circular flow. Emphasizes the arrows or flow rather than the stages or steps. Works best with Level 1 text only.</descrip></descripGrp><ntig><termGrp><term id="779759">Text Cycle</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1907200">K'utunsanwachib'al woktzij</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21825_779760_1907201"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show the relationships of four quadrants to a whole. The first line of Level 1 text corresponds to the central shape, and the first four lines of Level 2 text appear in the quadrants. Unused text does not appear, but remains available if you switch layouts.</descrip></descripGrp><ntig><termGrp><term id="779760">Titled Matrix</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1907201">Wokob'al k'ojob'al</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21826_779761_1907202"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show grouped or related information of equal value. Works well with large amounts of text.</descrip></descripGrp><ntig><termGrp><term id="779761">Trapezoid List</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1907202">Ucholajil jupuq chomanik</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21827_779762_1907203"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show a progression or steps that trend upward in a task, process, or workflow. Each of the first five lines of Level 1 text corresponds to a point on the arrow. Works best with minimal text. Unused text does not appear, but remains available if you switch layouts.</descrip></descripGrp><ntig><termGrp><term id="779762">Upward Arrow</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1907203">Paqal uwach ch'ab'</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21828_779763_1907204"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show a progression or sequential steps in a task, process, or workflow that move toward a common goal. Works well for bulleted lists of information.</descrip></descripGrp><ntig><termGrp><term id="779763">Vertical Arrow List</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1907204">Chol sutaq tak'al ch'ab'</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21829_779764_1907205"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show a progression or sequential steps in a task, process, or workflow. Maximizes both horizontal and vertical display space for shapes. Places more emphasis on the interrelationships among the shapes than on direction or movement.</descrip></descripGrp><ntig><termGrp><term id="779764">Vertical Bending Process</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1907205">Q'axnem kotol tak'alik</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21830_779765_1907206"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show groups of information or steps in a task, process, or workflow. Works well with large amounts of Level 2 text. A good choice for text with a main point and multiple sub-points.</descrip></descripGrp><ntig><termGrp><term id="779765">Vertical Block List</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1907206">Ucholajil tak'al ruk'a'am rib'</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21831_779766_1907207"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show several groups of information, especially groups with large amounts of Level 2 text. A good choice for bulleted lists of information.</descrip></descripGrp><ntig><termGrp><term id="779766">Vertical Box List</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1907207">Ucholajil tak'al kajxukutb'al</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21832_779767_1907208"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show non-sequential or grouped blocks of information. Works well for lists with long headings or top-level information.</descrip></descripGrp><ntig><termGrp><term id="779767">Vertical Bullet List</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1907208">Ucholajil tak'al retz'eb'alil</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21833_779768_1907209"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show a progression or sequential steps in a task, process, or workflow, or to emphasize movement or direction. Emphasizes Level 2 text over Level 1 text, and is a good choice for large amounts of Level 2 text.</descrip></descripGrp><ntig><termGrp><term id="779768">Vertical Chevron List</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1907209">Ucholajil tak'al cheurones</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21834_779769_1907210"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show sequential steps or tasks that depict a plan or result. The last Level 1 line of text appears after the arrow. Works best with Level 1 text only.</descrip></descripGrp><ntig><termGrp><term id="779769">Vertical Equation</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1907210">Tak'al ub'ek'i'alil</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21835_779770_1907211"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show non-sequential or grouped blocks of information. The small circles are designed to contain pictures.</descrip></descripGrp><ntig><termGrp><term id="779770">Vertical Picture Accent List</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1907211">Ucholajil ruk' setesa'q pa umox</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21836_779771_1907212"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show non-sequential or grouped blocks of information. The small shapes on the left are designed to contain pictures.</descrip></descripGrp><ntig><termGrp><term id="779771">Vertical Picture List</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1907212">Chol sutaq tak'al rech wachib'al</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21837_779772_1907213"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show a progression or sequential steps in a task, process, or workflow from top to bottom. Works best with Level 1 text, since the vertical space is limited.</descrip></descripGrp><ntig><termGrp><term id="779772">Vertical Process</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1907213">Q'axnem tak'alik</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21838_779838_1907214"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show overlapping relationships. A good choice for emphasizing growth or gradation. Works best with Level 1 text only. The first seven lines of Level 1 text correspond to a circular shape. Unused text does not appear, but remains available if you switch layouts.</descrip></descripGrp><ntig><termGrp><term id="779838">Stacked Venn</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1907214">Venn nutum</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21839_779839_2628357"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Having the ability to make decisions based on predictions driven by machine learning analysis.</descrip></descripGrp><ntig><termGrp><term id="779839">intelligent</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="2628357">sak'aj</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21847_779972_2436300"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Marked by the use of serifs. For example, Goudy is a serif typeface, whereas Helvetica is a sans serif typeface.</descrip></descripGrp><ntig><termGrp><term id="779972">serif</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="2436300">serif</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21873_780192_1907215"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A formula giving the roots of a quadratic equation.</descrip></descripGrp><ntig><termGrp><term id="780192">quadratic formula</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1907215">Cholajb'anikil kajxkutil</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21906_780474_1596401"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A company that provides services or content for its customers.</descrip></descripGrp><ntig><termGrp><term id="780474">provider</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1596401">wokk'ayij</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21926_780637_2531278"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application that is both a digital still camera and a digital video camera.</descrip></descripGrp><ntig><termGrp><term id="780637">camera</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="2531278">esab'al wachib'al</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2194_126360_1773060"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Of, pertaining to, or characterized by capital letters.</descrip></descripGrp><ntig><termGrp><term id="126360">uppercase</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1773060">nim retaltz'ib'</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21951_1080693_1595888"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To expose a virtual disk to the user, backed by a file.</descrip></descripGrp><ntig><termGrp><term id="1080693">attach</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1595888">kemk'utik</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21957_781802_1807081"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The administrative task of making remote resources available to its users, setting policies that control how users will connect, how they will find the remote resources, and what settings users will connect with.</descrip></descripGrp><ntig><termGrp><term id="781802">publishing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1807081">kemtzijob'enem</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21990_782330_1596424"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To uninstall all software on a computer and reinstall a new Windows image.</descrip></descripGrp><ntig><termGrp><term id="782330">re-image</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1596424">k'ak' ujeqeb'axik wachib'al</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Verb<