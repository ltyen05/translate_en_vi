_2432492_2436993"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To create, highlight, or erase content using ink.</descrip></descripGrp><ntig><termGrp><term id="2432492">draw</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="2436993">utz'ajik</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42887_2432493_2436996"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tool that allows users to use ink to draw using their mouse, finger, or an inking tool, and whose ink resembles pencil graphite.</descrip></descripGrp><ntig><termGrp><term id="2432493">pencil</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="2436996">che' tz'ib'ab'al</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42888_2432494_2436995"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tool that allows users to use ink to draw using their mouse, finger, or an inking tool, and whose ink resembles traditional pen ink.</descrip></descripGrp><ntig><termGrp><term id="2432494">pen</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="2436995">kemtz'ib'ab'al</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partO