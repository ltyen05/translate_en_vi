p files and printers.</descrip></descripGrp><ntig><termGrp><term id="782774">homegroup password</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1772966">retokib'al molajil pa le achoch</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20703_746420_1595974"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An action that removes redundant messages from an email conversation to reduce information overload and improve readability.</descrip></descripGrp><ntig><termGrp><term id="746420">Clean Up</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1595974">Usu'ik</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20704_746421_1907096"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A fork within a conversation, where more than one reply was made to a single email and caused a split in the conversation.</descrip></descripGrp><ntig><termGrp><term id="746421">branch</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1907096">Kemq'ab'ib'al</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote typ