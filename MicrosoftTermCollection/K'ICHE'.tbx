></descripGrp><ntig><termGrp><term id="2329250">assignee</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="2339758">ya'talik</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40086_2329251_2339973"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to items marked with a star.</descrip></descripGrp><ntig><termGrp><term id="2329251">starred</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="2339973">kojom ch'umil chech</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40087_2329252_2339971"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An indication for a priority in a list or other organizational structure.</descrip></descripGrp><ntig><termGrp><term id="2329252">star</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="2339971">ch'umil</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40091_2329597_2338369"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An emai