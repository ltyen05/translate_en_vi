ech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="2142339">Woktz'ib' Microsoft pa nimk'atz</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37325_2116471_2142340"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A handle that appears on objects or text insertion points when a user taps on them making selection easier.</descrip></descripGrp><ntig><termGrp><term id="2116471">selection handle</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="2142340">Rilawachixik cha'b'alil</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37332_2119511_2142337"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The command that appears in both email and UX that allows users to put folders in their OneDrive list and allows them to sync those folders offline.</descrip></descripGrp><ntig><termGrp><term id="2119511">Add to my OneDrive</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="2142337">Chaya' pa nuOneDrive</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></l