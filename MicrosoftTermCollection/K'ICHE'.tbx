h an Internet service provider.</descrip></descripGrp><ntig><termGrp><term id="236993">web connection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1596230">tiqkemam tzijob'elil</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11225_231967_1906777"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tool that helps you create or edit a formula and also provides information about functions and their arguments.</descrip></descripGrp><ntig><termGrp><term id="231967">Formula Palette</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1906777">tz'ajb'al cholajb'anikil</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11225_231967_1906954"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tool that helps you create or edit a formula and also provides information about functions and their arguments.</descrip></descripGrp><ntig><termGrp><term id="231967">Formula Palette</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1906954">k'iyisanel rech cholajb'anikil</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote t