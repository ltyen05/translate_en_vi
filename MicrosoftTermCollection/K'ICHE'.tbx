5">k'utwachib'al rech uq'e'teb'al</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13742_210086_1906431"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A chart that uses horizontal bars to illustrate comparisons among individual data items.</descrip></descripGrp><ntig><termGrp><term id="210086">bar graph</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1906431">K'utwachib'al rech uq'eteb'al</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13742_210086_1906745"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A chart that uses horizontal bars to illustrate comparisons among individual data items.</descrip></descripGrp><ntig><termGrp><term id="210086">bar graph</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1906745">k'utwachib'al rech uq'e'teb'al</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13747_21789_1595917"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A picture made from a series of small dots, much like a piece of graph paper with certain squares filled in to form shapes and lines.</descrip></descripGrp>