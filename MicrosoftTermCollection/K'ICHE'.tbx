ticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6962_312045_1906910"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A cell that is referred to by a formula in another cell. For example, if cell D10 contains the formula =B5, cell B5 is a precedent to cell D10.</descrip></descripGrp><ntig><termGrp><term id="312045">precedent</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1906910">nab'e b'ixkil</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6977_340130_2748179"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To switch between active calls.</descrip></descripGrp><ntig><termGrp><term id="340130">swap</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="2748179">uk'exik</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6985_58943_1807010"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A gradual progression.</descrip></descripGrp><ntig><termGrp><term id="58943">gradient</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1807010">elesam uchuq'ab'il</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="699_68675_1807023"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In object-oriented programming, a language that lets a program or object written in one language communicate with another program written in an unknown language. An IDL is used to define interfaces between client and server programs. For example, an IDL can provide interfaces to remote CORBA objects.</descrip></descripGrp><ntig><termGrp><term id="68675">interface definition language</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1807023">IDL</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="699_731998_1807023"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In object-oriented programming, a language that lets a program or object written in one language communicate with another program written in an unknown language. An IDL is used to define interfaces between client and server programs. For example, an IDL can provide interfaces to remote CORBA objects.</descrip></descripGrp><ntig><termGrp><term id="731998">IDL</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1807023">IDL</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7010_1249014_1596369"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An auxiliary software component that extends or enhances the features of other software.</descrip></descripGrp><ntig><termGrp><term id="1249014">callout</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1596369">kemtz'aqatib'al</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7010_93031_1596369"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An auxiliary software component that extends or enhances the features of other software.</descrip></descripGrp><ntig><termGrp><term id="93031">plug-in</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1596369">kemtz'aqatib'al</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7016_184182_1906736"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The hierarchical HTML tag structure of an opened HTML document that appears in a window docked beneath the quick tag selector.</descrip></descripGrp><ntig><termGrp><term id="184182">Quick Tag Tree</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1906736">Uche'al aninaq taq retwokaj</term><termNote type="geographicalUsage">GTM</termNote><termNote type="pa