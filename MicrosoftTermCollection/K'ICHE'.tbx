 xml:lang="en-US"><descripGrp><descrip type="definition">A service or feature that renders the audio content of a television or video program as text on the screen. These captions are usually visible only if decoded or activated.</descrip></descripGrp><ntig><termGrp><term id="592578">closed captioning</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="2184833">choltz'ib'</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16607_592811_1596610"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A numeric or other designation appended to a product name to identify a particular release.​</descrip></descripGrp><ntig><termGrp><term id="592811">version</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1596610">q'ataj</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16609_592813_1772914"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An effect applied to a graphical object that typically reduces the difference between the outline of the object and the graphical area next to it.</descrip></descripGrp><ntig><termGrp><term id="592813">blur</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1772914">kemch'utinsanem</term><termNote type="geo