 xml:lang="en-US"><descripGrp><descrip type="definition">The Excel function that returns text that occurs between two given substrings in a given string.</descrip></descripGrp><ntig><termGrp><term id="2368196">TEXTBETWEEN</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="2375307">TEXTBETWEEN</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41830_2368197_2375304"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Excel function that looks for a value in one range and returns a reference to the cell in the corresponding position of another range.</descrip></descripGrp><ntig><termGrp><term id="2368197">CLOOKUP</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="2375304">CLOOKUP</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41836_2368390_2613067"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The tool that aids in reading comprehension by displaying a reading-focused view with optimized font spacing, and by reading text aloud while highlighting it, breaking words down into syllables, and translating text.</descrip></descripGrp><ntig><termGrp><term id="2368390">Immersive Reader</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="2613067">Nim ucholajil sik'inel uwach.</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4185_418556_1807079"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To make data ready and available for subsequent distribution and deployment in a server environment.</descrip></descripGrp><ntig><termGrp><term id="418556">publish</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1807079">kemtzijob'exik</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41855_2374281_2379205"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A privacy setting that allows the operating system, apps, and services to detect a user's approximate location (within several miles/km), without sharing their exact location.</descrip></descripGrp><ntig><termGrp><term id="2374281">general location</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="2379205">k'olib'al rech uk'iyal</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41856_2374312_2379204"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A location that you can set for your device that can be used by Windows, apps, and services when an exact location isn't available, such as on a desktop PC without GPS.​ ​</descrip></descripGrp><ntig><termGrp><term id="2374312">default location</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="2379204">k'olib'al ya'om chi uloq</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4188_136987_1595840"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To make a chart sheet or worksheet the active, or selected, sheet. The sheet that you activate determines which menu bar and toolbars are displayed.</descrip></descripGrp><ntig><termGrp><term id="136987">activate</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1595840">uk'asuxik</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41880_2370579_2372811"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A biometric authentication feature that that enables signing in to your device, apps, online services, and networks by face recognition.</descrip></descripGrp><ntig><termGrp><term id="2370579">Windows Hello face</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="2372811">pa