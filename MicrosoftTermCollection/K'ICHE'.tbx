><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15359_234915_1595861"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The visual experience of the premium Windows Vista editions. Windows Aero builds on the Basic and Standard user experiences to offer customers our best-designed, highest-performing desktop environment. A noticeable element of the new Windows Aero experience is the professional-looking, transparent glass design, which creates an open, lightweight environment but more importantly enables users to focus on their content rather than the interface.</descrip></descripGrp><ntig><termGrp><term id="234915">Authentic, Energetic, Reflective, and Open</term><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1595861">Aero</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15359_777773_1595861"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The visual experience of the premium Windows Vista editions. Windows Aero builds on the Basic and Standard user experiences to offer customers our best-designed, highest-performing desktop environment. A noticeable element of the new Windows Aero experience is the professional-looking, transparent glass design, which creates an open, lightweight environment but more importantly enables users to focus on their content rather than the interface.</descrip></descripGrp><ntig><termGrp><term id="777773">Windows Aero</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1595861">Aero</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15369_71392_1596240"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A specified amount of processing performed as a unit by a computer.</descrip></descripGrp><ntig><termGrp><term id="71392">job</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1596240">kemchak</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15382_232822_1906822"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An option that switches the view from the display of HTML source code to the display of Web page content.</descrip></descripGrp><ntig><termGrp><term id="232822">Exit HTML Source</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1906822">Elem rech etalil HTML</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15396_148352_1906690"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">E-mail accounts and folders tha