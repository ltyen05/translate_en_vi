89_1906741"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">One of the presets for 3D rotation effects. When selected, specifies that the object will be rotated off-axis.</descrip></descripGrp><ntig><termGrp><term id="186189">off-axis</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1906741">elenaq chirij sutib'al</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1898_67709_1596222"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To load the program and installation files onto your computer or device so that the program runs correctly.</descrip></descripGrp><ntig><termGrp><term id="67709">install</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1596222">ujeqeb'axik</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1901_92735_1596361"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A symbolic value used in place of a real value that is unknown or unavailable at the current time, or that is not displayed for security reasons.</descrip></descripGrp><ntig><termGrp><term id="92735">placeholder</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1596361">retal uk'olib'al</term><termNote type=