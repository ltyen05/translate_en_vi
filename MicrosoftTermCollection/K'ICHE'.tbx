09_2077586"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A voice session that can be conducted between two or more telephones, two or more devices (such as computers or smartphones), or between two or more such devices and telephones.</descrip></descripGrp><ntig><termGrp><term id="418609">call</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="2077586">sik'inem</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6190_142020_1906612"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The small black square in the lower-right corner of a selected cell that can be used to copy data and to fill adjacent cells with a series of data.</descrip></descripGrp><ntig><termGrp><term id="142020">fill handle</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1906612">ilonel rech nojisab'al</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6196_144404_1906639"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of information service used to configure messaging programs to send and receive email.</descrip></descripGrp><ntig><termGrp><term id="144404">mail delivery service</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1906639">chak patan rech ujachik taqoqxa'n</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6197_76338_1772982"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file that stores messages generated by an application, service, or operating system that are used to track the operations performed.</descrip></descripGrp><ntig><termGrp><term id="76338">log file</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1772982">k'olchak rech cholwujil</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="62_3160_1596402"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A server located on a network between client software, such as a Web browser, and another server. It intercepts all requests to the server to determine whether it can fulfill them itself. If not, it forwards the request to another server.</descrip></descripGrp><ntig><termGrp><term id="3160">proxy server</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1596402">tiqpatanel</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6200_50329_1596097"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To insert information created in one program, such as a chart, an equation, an image, a video or a font, into another program or Web page.</descrip></descripGrp><ntig><termGrp><term id="50329">embed</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1596097">kemunimik</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6202_70557_1596233"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To reverse something or change it to its opposite.</descrip></descripGrp><ntig><termGrp><term id="70557">invert</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1596233">solkopixik</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6208_147957_1906686"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A field that can show formatting and graphics, such as an embedded object, and not just text.</descrip></descripGrp><ntig><termGrp><term id="147957">rich text field</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1906686">kemk'olib'al rech uq'inomal woktzij</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="621_121364_1773057"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of object within a process that runs program instructions. Using multiple threads allows concurrent operations within a process and enables one process to run different parts of its program on different processors simultaneously. A thread has its own set of registers, its own kernel stack, a thread environment block, and a user stack in the address space of its process.</descrip></descripGrp><ntig><termGrp><term id="121364">thread</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1773057">cholmanem pa tukelam</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6224_144653_1906641"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A placeholder for text or pictures that you insert into your document.</descrip></descripGrp><ntig><termGrp><term id="144653">merge field</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1906641">Kemk'olib'al rech kemwokib'al</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6231_144677_1906642"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A single cell that is created by combining two or more selected cells. The cell reference for a merged cell is the upper-left cell in the original selected range.</descrip></descripGrp><ntig><termGrp><term id="144677">merged cell</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1906642">k'olq'e'tal xolotalik</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6232_141181_1806987"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An area upon which users can draw multiple shapes, such that the shapes can be moved and resized as a unit.</descrip></descripGrp><ntig><termGrp><term id="141181">drawing canvas</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1806987">uperajil wachib'al</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6239_264786_1906881"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A view for delivering a presentation that provides the presenter with additional options for viewing and controlling its delivery.</descrip></descripGrp><ntig><termGrp><term id="264786">Presenter View</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1906881">K'utunsanel Ilik</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6247_318716_1595864"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of compositions or memorabilia of a specific type or for a particular purpose, such as audio recordings, photographs, or documents.</descrip></descripGrp><ntig><termGrp><term id="318716">album</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1595864">cholk'olib'al</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6250_105621_1596447"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A return to a previous stable condition, as when the contents of a hard disk are restored from a backup after a destructive hard disk error.</descrip></descripGrp><ntig><termGrp><term id="105621">rollback</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1596447">tzalijisanem</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="626_61316_1596188"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Not visible to the user.</descrip></descripGrp><ntig><termGrp><term id="61316">hidden</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="qut