oun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40109_2330388_2338366"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that enables customers to satisfy stringent SEC Rule 17a-4 record retention requirements with advanced administrative controls for archiving such as restricting changes to archiving policies and preventing such policies from being turned off or removed.</descrip></descripGrp><ntig><termGrp><term id="2330388">Preservation Lock</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="2338366">Chajib'al q'ateb'al</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40111_2330390_2335771"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A generic reference to an organization's Windows Store for Business to offer specific content to their users, and for users to download approved content.</descrip></descripGrp><ntig><termGrp><term id="2330390">private store</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="2335771">k'ayib'al rech echeb'alil</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40112_2330405_2335769"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A map downloa