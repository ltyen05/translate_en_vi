ug and Play installation, which enables you to connect and disconnect devices without shutting down or restarting your computer.</descrip></descripGrp><ntig><termGrp><term id="125903">universal serial bus</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1816999">USB</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4190_125903_1817000"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An external bus that supports Plug and Play installation, which enables you to connect and disconnect devices without shutting down or restarting your computer.</descrip></descripGrp><ntig><termGrp><term id="125903">universal serial bus</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1817000">kemq'axeb'al rech unimal ucholajij</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4190_125904_1816999"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An external bus that supports Plug and Play installation, which enables you to connect and disconnect devices without shutting down or restarting your computer.</descrip></descripGrp><ntig><termGrp><term id="125904">USB</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1816999">USB</term><t