>Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16176_143109_1906619"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A margin setting that adds extra space to the side or top margin of a document you plan to bind. A gutter margin ensures that text isn't obscured by the binding.</descrip></descripGrp><ntig><termGrp><term id="143109">gutter margin</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1906619">uchi' wokwuj</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16190_184195_1906737"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Content has been hashed and verified as valid against the signature. The certificate used to verify the signature is “valid” in the sense that it has a relationship to a trusted certificate authority (and isn’t expired, etc.)</descrip></descripGrp><ntig><termGrp><term id="184195">Signed - verified</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1906737">Juch'um-junamam</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16213_2167436_2185514"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A hard plastic disc on a mouse that is perpendicular to the mouse surface. It is normally located between the left and right mouse buttons and is used for scrolling.</descrip></descripGrp><ntig><termGrp><term id="2167436">mouse wheel</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="2185514">ub'inib'al ch'o</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16213_534934_2185514"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A hard plastic disc on a mouse that is perpendicular to the mouse surface. It is normally located between the left and right mouse buttons and is used for scrolling.</descrip></descripGrp><ntig><termGrp><term id="534934">scroll wheel</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="2185514">ub'inib'al ch'o</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1622_234771_1596167"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to Microsoft software which is published by Microsoft, properly licensed, and fully supported by Microsoft or a trusted partner.</descrip></descripGrp><ntig><termGrp><term id="234771">genuine</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1596167">qas rajawal</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16223_237296_1906862"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows the user to select from a gallery of pre-defined formatting styles and apply them quickly to tables, text, charts, drawing objects and SmartArt graphics.</descrip></descripGrp><ntig><termGrp><term id="237296">Quick Styles</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1906862">Le aninaq taq ub'antajik</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16225_232420_1906806"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A secure email feature that lets you add sensitivity labels, such as Internal Use Only, to the message header. Security labels in your organization are controlled by security policies set up by your email administrator.</descrip></descripGrp><ntig><termGrp><term id="232420">security label</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1906806">Retwokaj rech chajinem</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16250_174770_1906719"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A rectangle with sizing handles that surrounds a selected object or objects.</descrip></descripGrp><ntig><termGrp><term id="174770">selection rectangle</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1906719">nim kajib' uxukut rech ucha'ik</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16250_645093_1906719"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A rectangle with sizing handles that surrounds a selected object or objects.</descrip></descripGrp><ntig><termGrp><term id="645093">selection box</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1906719">nim kajib' uxukut rech ucha'ik</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16263_10901_1595867"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To position objects or text relative to some point, such as the page margin.</descrip></descripGrp><ntig><termGrp><term id="10901">align</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1595867">cholsuk'ub'anik</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Adverb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16276_263115_1807046"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to a file format that allows for VBA code. Examples of file extensions for macro-enabled formats are .docm, .pptm, .xlsm.</descrip></descripGrp><ntig><termGrp><term id="263115">macro-enabled</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1807046">kachakun chi rech macros</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16290_237379_2314775"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in Office Server that provides a workflow for document review.</descrip></descripGrp><ntig><termGrp><term id="237379">Document Review</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="2314775">Uq'atuxik wokwujchak</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16315_140027_1906585"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A dialog box that displays one complete record at a time. You can use data forms to add, change, locate, and delete records.</descrip></descripGrp><ntig><termGrp><term id="140027">data form</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1906585">le juq'attzij rech nojisab'altzij</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16317_209984_1571008"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Windows Media Player, a database that contains information about digital media files on a computer, a network drive, or the Internet.</descrip></descripGrp><ntig><termGrp><term id="209984">library</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1571008">k'olno'j chak</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16317_209984_1596263"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Windows Media Player, a database that contains information about digital media files on a computer, a network drive, or the Internet.</descrip></descripGrp><ntig><termGrp><term id="209984">library</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1596263">k'olno'j kemchak</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16319_119343_1807118"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">One or more rows of cells commonly used to display numbers and other items for quick reference and analysis.</descrip></descripGrp><ntig><termGrp><term id="119343">table</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1807118">kemq'e'tk'olib'al</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16322_143641_2314821"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The cell in which each input value from a data table is substituted. Any cell on a worksheet can be the input cell. Although the input cell does not need to be part of the data table, the formulas in data tables must refer to the input cell.</descrip></descripGrp><ntig><termGrp><term id="143641">input cell</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="2314821">k'olq'e'tal rech okib'al</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16327_163539_2314828"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The adjustment of the spacing between two characters to create the appearance of even spacing, fit text to a given space, and adjust line breaks.</descrip></descripGrp><ntig><termGrp><term id="163539">kerning</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="2314828">Uxo'ltz'ib'</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16337_117385_1596544"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">One character (or more) printed slightly below the baseline of surrounding text.</descrip></descripGrp><ntig><termGrp><term id="117385">subscript</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1596544">uq'ab' ucholajil</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16338_210449_1906748"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The core component of the Excel Server that includes the full Excel calculation functionality. It loads and saves Excel workbooks, queries and refreshes external data, calculates workbooks, and provides the calculated results to the caller.</descrip></descripGrp><ntig><termGrp><term id="210449">Excel Calculation Server</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1906748">Ajpataninel q'etam rech Excel</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16344_18758_1595902"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In the context of processes or tasks that are part of an operating system or program, operating without interaction with the user while the user is working on another task.</descrip></descripGrp><ntig><termGrp><term id="18758">background</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1595902">wachupam</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16348_318717_1596127"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To advance audio or video playback at a speed that is faster than normal.</descrip></descripGrp><ntig><termGrp><term id="318717">fast forward</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1596127">kab'in pa aninaqil</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16358_210492_1596357"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of attack that tries to trick users into revealing personal information, such as credit card numbers, bank accounts, or passwords, often using links to fake websites included in emails and chat messages.</descrip></descripGrp><ntig><termGrp><term id="210492">phishing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1596357">ujalwach winaqil</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16365_338551_1773002"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An item provided and signed by the DCE security server that is both a proof of identity and a list of group memberships.</descrip></descripGrp><ntig><termGrp><term id="338551">privilege attribute certificate</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1773002">PAC</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16365_338551_1773544"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An item provided and signed by the DCE security server that is both a proof of identity and a list of group memberships.</descrip></descripGrp><ntig><termGrp><term id="338551">privilege attribute certificate</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1773544">kemq'alajisanel winaqil</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16365_338565_1773002"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An item provided and signed by the DCE security server that is both a proof of identity and a list of group memberships.</descrip></descripGrp><ntig><termGrp><term id="338565">PAC</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:la