 magazine</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="2599926">tzijolwuj</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8026_149177_1906698"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Any characteristic of text, such as font, size, style, color, or effect such as subscript or superscript.</descrip></descripGrp><ntig><termGrp><term id="149177">text attributes</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1906698">ub'anik woktzij</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="803_44794_1596049"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The work area on a computer screen that simulates the top of an actual desk. The desktop contains the Recycle Bin and other icons (shortcuts to programs, files, folders, and various types of documents such as letters, reports, or pictures) that you can arrange on the electronic desktop just as you would arrange real objects on top of a desk.</descrip></descripGrp><ntig><termGrp><term id="44794">desktop</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1596049">ilwach chak</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8030_37385_1906444"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To join sequentially (for example, to combine the two strings "hello" and "there" into the single string "hello there").</descrip></descripGrp><ntig><termGrp><term id="37385">concatenate</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1906444">wiqb'al tz'ib'</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8036_116444_1596534"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A horizontal window at the bottom of a parent window in which an application can display various kinds of status information. The status bar can be divided into parts to display more than one type of information.</descrip></descripGrp><ntig><termGrp><term id="116444">status bar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1596534">uq'etb'al kemub'antajik</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8040_149410_2314959"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A query that uses the UNION operator to combine the results of two or more select queries.</descrip></descripGrp><ntig><termGrp><term id="149410">union query</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="2314959">Uta'ik rech uxolik</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8043_94462_1596381"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In word processors and other applications, the feature that formats a document for printing but displays it on the video monitor rather than sending it directly to the printer.</descrip></descripGrp><ntig><termGrp><term id="94462">preview</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1596381">k'utwachinem</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="807_22891_1596530"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of starting or resetting a computer or a device. When first turned on (cold boot) or reset (warm boot), the computer runs the software that loads and starts the computer's operating system, which prepares it for use.</descrip></descripGrp><ntig><termGrp><term id="22891">bootstrap</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1596530">umajik</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="807_730299_1596530"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of starting or resetting a computer or a device. When first turned on (cold boot) or reset (warm boot), the computer runs the software that loads and starts the computer's operating system, which prepares it for use.</descrip></descripGrp><ntig><termGrp><term id="730299">startup</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1596530">umajik</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="808_264640_1906879"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A fraction that is written on a downward angle: the diagonal fraction bar is placed down and to the right of the numerator, and the denominator is slightly down and to the right of the fraction bar.</descrip></descripGrp><ntig><termGrp><term id="264640">skewed fraction</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1906879">juch'aqaptzij xsachik</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8085_262737_2748175"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An authentication protocol that provides a mechanism for mutual authentication between a client and a server, or between one server and another, before a network connection is opened between them.</descrip></descripGrp><ntig><termGrp><term id="262737">Kerberos</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="2748175">Kerberos</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8085_636858_2748175"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An authentication protocol that provides a mechanism for mutual authentication between a client and a server, or between one server and another, before a network connection is opened between them.</descrip></descripGrp><ntig><termGrp><term id="636858">Kerberos authentication</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="2748175">Kerberos</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8090_360150_1906930"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ActiveX Database Objects (ADO) object used to contain a result set. It also exhibits cursor behavior depending on the recordset properties set by an application. ADO recordsets are mapped to OLE DB rowsets.</descrip></descripGrp><ntig><termGrp><term id="360150">recordset</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1906930">k'olcholchak</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8095_117241_1906518"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To send something in for consideration.</descrip></descripGrp><ntig><termGrp><term id="117241">submit</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1906518">uk'utik</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8099_265320_1906888"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A folder where a collection of PowerPoint slides is shared.</descrip></descripGrp><ntig><termGrp><term id="265320">Slide Library</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1906888">Slide Library</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8102_42162_1906449"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A short horizontal line used as a punctuation mark.</descrip></descripGrp><ntig><termGrp><term id="42162">dash</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1906449">Rab'juch'</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8123_234529_1596139"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A graphic that indicates follow-up action is required, or otherwise identifies an important item.</descrip></descripGrp><ntig><termGrp><term id="234529">flag</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1596139">retwokaj</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8125_359995_2314832"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that uses a minimum amount of data to display the general layout of a report.</descrip></descripGrp><ntig><termGrp><term id="359995">Layout Preview</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="2314832">Nab'e rilik wokob'al</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8136_396927_1806985"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A World Wide Web Consortium specification that describes the structure of dynamic HTML and XML documents in a way that allows them to be manipulated through a Web browser.</descrip></descripGrp><ntig><termGrp><term id="396927">Document Object Model</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1806985">DOM</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8136_396928_1806985"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A World Wide Web Consortium specification that describes the structure of dynamic HTML and XML documents in a way that allows them to be manipulated through a Web browser.</descrip></descripGrp><ntig><termGrp><term id="396928">DOM</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1806985">DOM</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8150_212894_1596529"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A menu containing important and frequently used programs, folders, and utilities. To open the Start menu, click the Start button on the taskbar.</descrip></descripGrp><ntig><termGrp><term id="212894">Start menu</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1596529">majba'l Cholchakub'al</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8156_232394_1906791"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Appears to the left of a meeting or appointment (or all the way around the item when selected), indicating time status as free, tentative, busy, out of office, or no information available. Visible only in Day and Work Week view.</descrip></descripGrp><ntig><termGrp><term id="232394">availability indicator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1906791">Jamal kiwach k'utunsanelab'</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8160_16016_1595887"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To include an external document, a file, or an executable program with a message.</descrip></descripGrp><ntig><termGrp><term id="16016">attach</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1595887">kemtaqanik</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8163_32059_1595975"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To remove the data or settings currently present on an entity.</descrip></descripGrp><ntig><termGrp><term id="32059">clear</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammatical