rated physical keyboard.</descrip></descripGrp><ntig><termGrp><term id="1504985">slate</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1667164">okib'al chi q'ab'aj</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2905_136563_1772920"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of CD-ROM that can be written (only once) on a CD recorder and read on a CD-ROM drive.</descrip></descripGrp><ntig><termGrp><term id="136563">compact disc-recordable</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1772920">CDR</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2905_136564_1772920"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of CD-ROM that can be written (only once) on a CD recorder and read on a CD-ROM drive.</descrip></descripGrp><ntig><termGrp><term id="136564">CD-R</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1772920">CDR</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2908_38136_1772929"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ability of hardware devices, software packages, or a computer itself to work with network devices or with other hardware devices, software packages, or a computer over a network connection.</descrip></descripGrp><ntig><termGrp><term id="38136">connectivity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1772929">kemtiqchakunem</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29146_1636440_1907469"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A source that returns a set of search results for a given search query. The source can be a search service in the local server farm or another server farm, or another search engine that is compliant with the OpenSearch protocol.</descrip></descripGrp><ntig><termGrp><term id="1636440">result source</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1907469">uk'amarem rech uxe'al</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29149_1506722_2307984"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A container for items that are deleted. Items in this container are visible to users with the appropriate permissions and to site collection administrators.</descrip></descripGrp><ntig><termGrp><term id="1506722">first-stage Recycle Bin</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="2307984">nab'e ucholajil utzaqob'al kamulib'al</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29193_1644672_1907510"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Web Part that renders named objects or named items in a workbook, such as tables, charts, slicers or a named range of cells.</descrip></descripGrp><ntig><termGrp><term id="1644672">named item view</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1907510">kemtz'aqatil ub'ina'am majb'al rilik</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2923_59620_1772959"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method of specifying software behavior by system administrators. Administrators set policies that are used to control how software features behave.</descrip></descripGrp><ntig><termGrp><term id="59620">Group Policy</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1772959">Molajil k'amal b'e</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29256_1506853_2307990"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A container for items that have been deleted from a first-stage Recycle Bin. Items in a second-stage Recycle Bin are visible only to site collection administrators.</descrip></descripGrp><ntig><termGrp><term id="1506853">second-stage Recycle Bin</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="2307990">ukab' ucholajil utzaqob'al kamulib'al</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29257_1506854_1592242"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A symmetric encryption key shared by two entities, such as between a user and the domain controller (DC), with a long lifetime. A password is a common example of a secret key. When used in a context that implies Kerberos only, a principal's secret key.</descrip></descripGrp><ntig><termGrp><term id="1506854">secret key</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1592242">awatal okpitz'b'al</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="293_147704_1906683"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A reference to data stored in a document from another program.</descrip></descripGrp><ntig><termGrp><term id="1