p><term id="2314774">Raqan uq'ab' le wokwujchak</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4314_343665_2314913"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The element in an XML document that contains all other elements. It is the top-level element of an XML document and must be the first element in the document.</descrip></descripGrp><ntig><termGrp><term id="343665">document element</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="2314913">Uk'u'xal raqan uq'ab'</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43147_2443106_2449208"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Editor feature that that identifies potentially vague adjectives and offers suggestion for more concrete adjectives.​</descrip></descripGrp><ntig><termGrp><term id="2443106">Vague Adjectives</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="2449208">Taq Q'alb'i'aj man Q'alaj taj</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4315_211448_1807037"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method used w