erm><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1906897">ucholajil rech taq juch'</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1205_397999_1768800"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A contract that restricts disclosure of confidential information or proprietary knowledge.</descrip></descripGrp><ntig><termGrp><term id="397999">NDA</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1768800">uwujil ri chomatal rij pa uwi' kub'ib'al k'u'x</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1205_85315_1768800"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A contract that restricts disclosure of confidential information or proprietary knowledge.</descrip></descripGrp><ntig><termGrp><term id="85315">non-disclosure agreement</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1768800">uwujil ri chomatal rij pa uwi' kub'ib'al k'u'x</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12069_150202_1596584"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The pairing of two or more actions that are performed together as a single action; the action succeeds or fails as a whole.</descrip></descripGrp><ntig><termGrp><term id="150202">transaction</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1596584">tob'jachanem</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12106_65506_1596209"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To displace the left or right edge of a text item, such as a block or a line, relative to the margin or to another text item.</descrip></descripGrp><ntig><termGrp><term id="65506">indent</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1596209">uya'ik uchi'</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12108_140776_1906596"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">For automatic subtotals and worksheet outlines, the subtotal rows or columns that are totaled by summary data. Detail data is typically adjacent to and either above or to the left of the summary data.</descrip></descripGrp><ntig><termGrp><term id="140776">detail data</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-