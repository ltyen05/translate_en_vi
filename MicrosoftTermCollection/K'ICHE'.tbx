id="29420_1507690_1907359"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Microsoft Office Web Component that provides interactive charting functionality on a Web page. You can illustrate data in a chart and give users the ability to change data, change chart options, and see changes reflected in the chart.</descrip></descripGrp><ntig><termGrp><term id="1507690">Chart Component</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1907359">Kemwokib'al rech ch'aqapil</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29429_1508178_1907360"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A character that is part of the set that makes up a particular language, such as vowels and consonants.</descrip></descripGrp><ntig><termGrp><term id="1508178">strong character</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1907360">ko uk'u'x</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29439_1508552_1907361"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application that parses code and markup in a page to help ensure that only trusted code and markup is run on a computer, server farm, or server cluster.</descrip></descripGrp><ntig><termGrp><term id="1508552">safe mode parser</term><termNote type="partOfSpeech">Noun</termNote><termN