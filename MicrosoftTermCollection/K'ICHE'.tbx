ct to public WiFi hotspots, paying per minute with Skype Credit.</descrip></descripGrp><ntig><termGrp><term id="1810823">Skype WiFi</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="2077657">UWiFi Skype</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33707_1810831_2077656"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An electronic coupon that can be bought from selected retail outlets to top up Skype Credit.</descrip></descripGrp><ntig><termGrp><term id="1810831">Skype voucher</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="2077656">T'in uwujil Skype</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33708_1811255_2077659"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A free internet call between two or more Skype users.</descrip></descripGrp><ntig><termGrp><term id="1811255">Skype-to-Skype call</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="2077659">Sik'inem Skype-pa-Skype</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</term