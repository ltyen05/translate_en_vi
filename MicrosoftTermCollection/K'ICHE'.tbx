ctive</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1571019">ajchi' k'olchak</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6387_110103_1596483"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The degree of confidentiality of an email message or calendar item, ranging from normal to confidential.</descrip></descripGrp><ntig><termGrp><term id="110103">sensitivity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1596483">kub'ib'al k'u'x</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6387_110103_1907094"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The degree of confidentiality of an email message or calendar item, ranging from normal to confidential.</descrip></descripGrp><ntig><termGrp><term id="110103">sensitivity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1907094">q'at kub'ib'al k'u'x</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6387_725767_1596483"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The degree of confidentiality of an email message or calendar item, ranging from normal to confidential.</descrip></descripGrp><ntig><termGrp><term id="725767">sensitivity level</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1596483">kub'ib'al k'u'x</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6387_725767_1907094"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The degree of confidentiality of an email message or calendar item, ranging from normal to confidential.</descrip></descripGrp><ntig><termGrp><term id="725767">sensitivity level</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1907094">q'at kub'ib'al k'u'x</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6388_232427_1906811"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A number between 1 and 53 that is assigned to each week of the year, where the first week of the year is the first week that contains a Thursday.</descrip></descripGrp><ntig><termGrp><term id="232427">week number</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1906811">rajilab'alil le wuqq'ij</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><ter