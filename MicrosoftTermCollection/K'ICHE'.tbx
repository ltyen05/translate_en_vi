ctions, or operators in a cell that together produce a new value.</descrip></descripGrp><ntig><termGrp><term id="56116">formula</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1906464">Cholajb'anikil</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="522_150128_1592225"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To reconcile the differences between two sets of stored data, where once the differences are determined, both sets are updated to be the same.</descrip></descripGrp><ntig><termGrp><term id="150128">synchronize</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1592225">junumanik</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="522_150128_1596552"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To reconcile the differences between two sets of stored data, where once the differences are determined, both sets are updated to be the same.</descrip></descripGrp><ntig><termGrp><term id="150128">synchronize</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1596552">junamaxik</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGe