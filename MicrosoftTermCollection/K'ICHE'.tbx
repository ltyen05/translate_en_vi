11798_2085540_2105778"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A line printed above, below, or to the side of some element, either to set that item off from the remainder of the page or to improve the look of the page. Footnotes, for example, often appear below a short rule that sets them off from the main text on the page. The thickness of a rule is typically measured in points. (A point is approximately 1/72 inch.)</descrip></descripGrp><ntig><termGrp><term id="2085540">rule line</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="2105778">juch' etab'al</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1180_89323_1596328"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To extend over and cover a part of something.</descrip></descripGrp><ntig><termGrp><term id="89323">overlap</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1596328">uch'uqub'exik</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11800_118815_1667188"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The information about a computer that's derived from the System Information program.</descrip></descripGrp><ntig><termGrp><term id="118815">system info</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1667188">uq'alajisaxik ri kemwokchakub'al</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11803_89506_2305064"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A role that controls how permissions are set and can grant permissions to others.</descrip></descripGrp><ntig><termGrp><term id="89506">owner</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="2305064">ajchoq'e</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11804_118547_1596553"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of entities working together to accomplish a task.</descrip></descripGrp><ntig><termGrp><term id="118547">system</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1596553">kemwokchakub'al</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11805_121970_1906529"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The slide that stores information from the design template pertaining to styles on title slides, including placeholder sizes and positions, background design, and color schemes.</descrip></descripGrp><ntig><termGrp><term id="121970">title master</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1906529">ub'i' le k'amb'alb'e</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1181_144723_1906644"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Margins of the left page are a mirror image of those of the right page. That is, the inside margins are the same width, and the outside margins are the same width.</descrip></descripGrp><ntig><termGrp><term id="144723">mirror margins</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1906644">ujunamil uchi' wuj</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11810_210490_1596111"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A networking standard that uses cables to provide network access. Ethernet is the most widely installed technology for connecting computers.</descrip></descripGrp><ntig><termGrp><term id="210490">Ethernet</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1596111">Ethernet</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11820_125350_1596595"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A character-encoding standard developed by the Unicode Consortium that represents almost all of the written languages of the world. The Unicode character repertoire has multiple representation forms, including UTF-8, UTF-16, and UTF-32. Most Windows interfaces use the UTF-16 form.</descrip></descripGrp><ntig><termGrp><term id="125350">Unicode</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1596595">Unicode</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11821_77656_1772975"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of display that uses a liquid compound having a polar molecular structure, sandwiched between two transparent electrodes. When an electric field is applied, the molecules align with the field, forming a crystalline arrangement that polarizes the light passing through it. A polarized filter laminated over the electrodes blocks polarized light. In this way, a grid of electrodes can selectively "turn on" a cell, or a pixel, containing the liquid crystal material, turning it dark.</descrip></descripGrp><ntig><termGrp><term id="77656">LCD</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1772975">LCD</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11821_77658_1772975"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of display that uses a liquid compound having a polar molecular structure, sandwiched between two transparent electrodes. When an electric field is applied, the molecules align with the field, forming a crystalline arrangement that polarizes the light passing through it. A polarized filter laminated over the electrodes blocks polarized light. In this way, a grid of electrodes can selectively "turn on" a cell, or a pixel, containing the liquid crystal material, turning it dark.</descrip></descripGrp><ntig><termGrp><term id="77658">liquid crystal display</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1772975">LCD</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11832_231956_1906767"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A reference to a range that spans two or more worksheets in a workbook.</descrip></descripGrp><ntig><termGrp><term id="231956">3-D reference</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1906767">Tzijob'em 3-D</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11847_23740_2314721"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A location in a program at which execution is halted so that a programmer can examine the program's status, the contents of variables, and so on.</descrip></descripGrp><ntig><termGrp><term id="23740">breakpoint</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="2314721">Q'atb'al</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11859_1468785_2012169"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A unique bank registration number that a bank uses to identify itself.</descrip></descripGrp><ntig><termGrp><term id="1468785">transit number</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="2012169">Retal ja k'olpwaq</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11859_1468785_2012171"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A unique bank registration number that a bank uses to identify itself.</descrip></descripGrp><ntig><termGrp><term id="1468785">transit number</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="2012171">ajilab'al rech ub'e'al rech le ja k'olme'r</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><t