mNote></termGrp></ntig></langSet></termEntry><termEntry id="11249_1166159_1596212"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Light that is beyond red in the color spectrum. While the light is not visible to the human eye, infrared transmitters and receivers can send and receive infrared signals.</descrip></descripGrp><ntig><termGrp><term id="1166159">infrared light</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1596212">ilob'al kaq q'aq'</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11249_66343_1596212"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Light that is beyond red in the color spectrum. While the light is not visible to the human eye, infrared transmitters and receivers can send and receive infrared signals.</descrip></descripGrp><ntig><termGrp><term id="66343">infrared</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1596212">ilob'al kaq q'aq'</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11249_66344_1596212"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Light that is beyond red in the color spectrum. While the light is not visible to the human eye, infrared transmitters and receivers can send and receive infrared signals.</descrip></descripGrp><ntig><termGrp><term id="66344">IR</term><termNote type="partOfSpeec