2389171"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A value that is used in Microsoft Points to enable efficient micropayments and prepaid purchase for cash based consumers (including kids/teens, as well as emerging and developing markets) and provide a mechanism to directly reward loyal customers.</descrip></descripGrp><ntig><termGrp><term id="226560">point</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="2389171">rajilab'alil</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2767_226561_2389171"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A value that is used in Microsoft Points to enable efficient micropayments and prepaid purchase for cash based consumers (including kids/teens, as well as emerging and developing markets) and provide a mechanism to directly reward loyal customers.</descrip></descripGrp><ntig><termGrp><term id="226561">p</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="2389171">rajilab'alil</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2771_28634_1595954"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A directory of information about data sets, files, or a database. It usually describes where a data set, file or database entity is located and may also include other information, such as the type of