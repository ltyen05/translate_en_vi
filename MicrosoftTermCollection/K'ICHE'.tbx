1124_49644_1595876"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of routines that an application uses to request and carry out lower-level services performed by a computer's or device's operating system. These routines usually carry out maintenance tasks such as managing files and displaying information.</descrip></descripGrp><ntig><termGrp><term id="49644">application program interface</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1595876">API</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1124_49645_1595876"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of routines that an application uses to request and carry out lower-level services performed by a computer's or device's operating system. These routines usually carry out maintenance tasks such as managing files and displaying information.</descrip></descripGrp><ntig><termGrp><term id="49645">application programming interface</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1595876">API</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11245_59333_1807011"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A sequence of shades ranging from black through white, used in computer graphics to add detail to images or to represent a color image on a monochrome out