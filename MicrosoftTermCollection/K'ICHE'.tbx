22"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that makes automatic versions of user documents during each autosave operation and allows the user to revert to previous copies of the document with ease.</descrip></descripGrp><ntig><termGrp><term id="773112">Office Auto-Revisions</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1907122">Office nik'onem-pa-tukelam</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21360_773163_1907123"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that alerts users to potential issues with email recipients before the message is sent.</descrip></descripGrp><ntig><termGrp><term id="773163">MailTips</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1907123">No'jib'al taqoqxa'nib'al pa kematz'ib'</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21362_773197_1596332"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To establish a Bluetooth link or connection between two Bluetooth–enabled devices.</descrip></descripGrp><ntig><termGrp><term id="773197">pair</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1596332">tiqjeq