2912_1596280"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A communications device that converts between digital data from a computer or terminal and analog audio signals that can pass through a standard telephone line.</descrip></descripGrp><ntig><termGrp><term id="2912">modulator/demodulator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1596280">k'ulchajanel nimk'atz</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="689_108242_1596469"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">On the IBM PC/XT and AT and compatible keyboards, a key on the top row of the numeric keypad that controls the effect of the cursor control keys and sometimes prevents the screen from scrolling. On the enhanced and Macintosh keyboards, this key is to the right of the function keys on the top row. Many modern applications ignore the Scroll Lock setting.</descrip></descripGrp><ntig><termGrp><term id="108242">SCROLL LOCK key</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1596469">pitz'b'al Bloq Despl</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6904_108595_2319270"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To try to locate something (a file, a folder, a computer, a text).</descrip></descripGrp><ntig><termGrp><term id="108595">search<