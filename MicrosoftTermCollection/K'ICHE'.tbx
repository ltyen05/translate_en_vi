y id="9674_149113_1906696"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A list of the captions for pictures, charts, graphs, slides, or other illustrations in a document, along with the numbers of the pages the captions appear on.</descrip></descripGrp><ntig><termGrp><term id="149113">table of figures</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1906696">kemq'e'tk'olib'al rech juq'attzij</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9679_334563_1596115"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To close software, such as a program or application.</descrip></descripGrp><ntig><termGrp><term id="334563">exit</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1596115">elik</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9685_117466_2315014"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To perform the basic mathematical operation of deducting something from something else.</descrip></descripGrp><ntig><termGrp><term id="117466">subtract</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="2315014">Relesaxik</term><termNote type="geographicalUsage">GTM</termNote><termNote type="pa