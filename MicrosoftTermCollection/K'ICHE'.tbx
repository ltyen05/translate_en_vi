publisher may use a digital certificate to represent its identity and use it to sign the remote resource files (e.g. RDP files) and the workspace description (e.g. Web Service feed).</descrip></descripGrp><ntig><termGrp><term id="766801">publisher</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1596404">kemtzijonel</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21114_766811_1807069"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To shut down a core processor for power saving purpose.</descrip></descripGrp><ntig><termGrp><term id="766811">park</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1807069">utak'ab'axik</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21120_766842_1773016"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A unique identifier made from four otherwise separate pieces of information. For example, a color can be specified by a black, yellow, magenta and cyan quad.</descrip></descripGrp><ntig><termGrp><term id="766842">quad</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1773016">cholwujil</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">