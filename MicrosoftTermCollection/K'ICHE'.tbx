descrip type="definition">A field that's assigned a column orientation in a PivotTable report. Items associated with a column field are displayed as column labels.</descrip></descripGrp><ntig><termGrp><term id="231959">column field</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1906769">Tak'aljuch' rech kemk'olib'al</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15457_461710_2599924"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Excel feature that identifies invalid worksheet data, formulas, or formatting and proposes corrections.</descrip></descripGrp><ntig><termGrp><term id="461710">error checking</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="2599924">uq'atuxik k'axk'olil</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15459_303758_1596628"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An upgrade option that allows users to upgrade from one edition of Windows to another by purchasing the upgrade online. It is enabled by Software Licensing Services (SLS) technology which allows a digital lincense to determine what features are enabled or disabled allowing Microsoft to sell either additional licenses or product upgrades through digital licenses (PUP-DL). Customers may either buy full packaged product (FPP) or upgrade quickly and conveniently electronically.</descrip></descripGrp><ntig><termGrp><term id="303758">Windows Anytime Upgrade</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1596628">Windows Anytime Upgrade</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15459_303760_1596628"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An upgrade option that allows users to upgrade from one edition of Windows to another by purchasing the upgrade online. It is enabled by Software Licensing Services (SLS) technology which allows a digital lincense to determine what features are enabled or disabled allowing Microsoft to sell either additional licenses or product upgrades through digital licenses (PUP-DL). Customers may either buy full packaged product (FPP) or upgrade quickly and conveniently electronically.</descrip></descripGrp><ntig><termGrp><term id="303760">WAU</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1596628">Windows Anytime Upgrade</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15476_72470_1596249"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In database management, an identifier for a record or group of records in a datafile.</descrip></descripGrp><ntig><termGrp><term id="72470">key</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1596249">pitz'b'al</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15482_174671_1596274"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A number used to indicate the cost of a route in the Internet Protocol (IP) routing table that enables the selection of the best route among possible multiple routes to the same destination.</descrip></descripGrp><ntig><termGrp><term id="174671">metric</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1596274">rajilab'alil nimk'atz</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15490_2510_1906412"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An unsolicited and typically unwelcome message, often commercial or political in nature, transmitted via the Internet as a mass mailing (sometimes as if from a fictitious user or domain) to a large number of recipients.</descrip></descripGrp><ntig><termGrp><term id="2510">junk e-mail</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="qut-GT"><ntig><termGrp><term id="1906412">taqoqxa'nib'al na ajawam taj</term><termNote type="geographicalUsage">GTM</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Sin