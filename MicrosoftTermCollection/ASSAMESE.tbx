n for a user whose regular account is not in a trusted domain. A local account cannot be used to log on interactively. Further, a local account created in one domain cannot be used in a trusted domain.</descrip></descripGrp><ntig><termGrp><term id="253747">local account</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="2709132">স্থানীয় একাউণ্ট</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9534_258951_433436"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The degree of precision and exactness with which one entity represents another.</descrip></descripGrp><ntig><termGrp><term id="258951">fidelity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="433436">বিশ্বস্ততা</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9536_61276_432489"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">For a computer system, to be in an inactive state, but not shut off. When the computer is switched back on, the desktop is restored exactly as it was.</descrip></descripGrp><ntig><termGrp><term id="61276">hibernate</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="432489">হাইবাৰনেট কৰক</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9543_415057_1852806"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A member of a dimension whose value is calculated at run time by using an expression. Calculated member values can be derived from the values of other members.</descrip></descripGrp><ntig><termGrp><term id="415057">calculated member</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1852806">গণণিত সদস্য</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9547_177819_433152"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A document that contains general release information and late changes. It is one of the deliverables leading to the release readiness approved milestone.</descrip></descripGrp><ntig><termGrp><term id="177819">release notes</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="433152">উন্মোচন টীকা</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9552_266832_1852788"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A secondary data source that is accessible to users who fill out forms offline. When a user is online, data from the data source is stored on the user’s computer so that it can appear in controls when the form is offline.</descrip></descripGrp><ntig><termGrp><term id="266832">offline data source</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1852788">অফলাইন ডাটা উত্স</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9555_139836_1256989"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A field you can create. A custom field can be a blank, combination, or formula field.</descrip></descripGrp><ntig><termGrp><term id="139836">custom field</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1256989">কাষ্টম ফিল্ড</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9561_179696_433164"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A selection technique that involves dragging out a bounding outline (also referred to as a marquee) to define the selected objects.</descrip></descripGrp><ntig><termGrp><term id="179696">region selection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="433164">অঞ্চল চয়নকৰণ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="gra