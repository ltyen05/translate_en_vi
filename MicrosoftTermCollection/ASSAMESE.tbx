uter programs in languages not supported by localized versions of those programs.</descrip></descripGrp><ntig><termGrp><term id="308309">Language Interface Pack</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="2015585">লেংগুৱেজ ইণ্টাৰফেচ পেক</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8891_308309_2015587"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Add-in software that provides partially localized user interfaces for particular computer programs in languages not supported by localized versions of those programs.</descrip></descripGrp><ntig><termGrp><term id="308309">Language Interface Pack</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="2015587">LIP</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8891_308310_2015585"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Add-in software that provides partially localized user interfaces for particular computer programs in languages not supported by localized versions of those programs.</descrip></descripGrp><ntig><termGrp><term id="308310">LIP</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="2015585">লেংগুৱেজ ইণ্টাৰফেচ পেক</term><te