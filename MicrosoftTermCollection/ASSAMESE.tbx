aticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3372_374687_1256908"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A data type used to hold date and time information.</descrip></descripGrp><ntig><termGrp><term id="374687">datetime</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1256908">তাৰিখ/সময়</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33720_1814248_2063734"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The status that indicates a user is signed out of his/her account and that he/she is not able to receive calls or IMs.</descrip></descripGrp><ntig><termGrp><term id="1814248">Offline</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="2063734">অফলাইন</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33721_1814249_2063735"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The status that indicates a user is signed in to his/her account.</descrip></descripGrp><ntig><termGrp><term id="1814249">Online</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="2063735">অনলাইন</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33722_1814262_2063762"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Skype product that allows a user to call directly to Skype from landlines and mobile phones.</descrip></descripGrp><ntig><termGrp><term id="1814262">Skype Number</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="2063762">Skype নম্বৰ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33723_1814251_2063763"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An organization that cooperates with Skype; the cooperation ranges from developing mutual software to selling products specially tailored for the organization.</descrip></descripGrp><ntig><termGrp><term id="1814251">Skype partner</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="2063763">Skype অংশীদাৰ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33724_1814252_2063736"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To pay for a paid feature at the moment the feature is used. For example, to pay for Skype's calling phones feature with Skype Credit that is either already owned or purchased specially for the occasion.</descrip></descripGrp><ntig><termGrp><term id="1814252">pay as you go</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="2063736">ব্যৱহাৰ অনুসৰি পৰিশোধ কৰক</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33725_1814253_2063738"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To pay once a month for using Skype paid features such as calling phones or sending SMS messages; e.g., to pay for a monthly subscription.</descrip></descripGrp><ntig><termGrp><term id="1814253">pay monthly</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="2063738">মাহিলী পৰিশোধ কৰক</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33726_1814254_2063739"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables users to preview photos and send them to contacts.</descrip></descripGrp><ntig><termGrp><term id="1814254">photo sharing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="2063739">ফটো ভাগ-বতৰা</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNo