ech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1258440">কুকি</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27555_1381690_1518995"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A website or service that a customer can connect to in order to share what they've been doing on other websites, see their friends and their updates from other services in Windows Live, or share their Windows Live activity on other websites.</descrip></descripGrp><ntig><termGrp><term id="1381690">service</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1518995">সেৱা</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27565_1382243_1519035"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A folder someone using Windows Live Sync is synchronizing between computers.</descrip></descripGrp><ntig><termGrp><term id="1382243">synced folder</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1519035">চিনক্ৰ’নাইজ কৰি থোৱা ফ’ল্ডাৰ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27578_1385957_1426819"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that allows users to navigate directly to the webpage of the top-ranked search result when a search is performed in the address bar.</descrip></descripGrp><ntig><termGrp><term id="1385957">Address Bar Top Result</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1426819">ঠিকনা দণ্ডিকা শীৰ্ষ ফলাফল</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27584_1387192_1931285"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The return to a customer's account of funds that were used to purchase an item. This may occur as a result of a customer's contacting a bank to dispute a credit-card transaction.</descrip></descripGrp><ntig><termGrp><term id="1387192">chargeback</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1931285">চাৰ্জবেক</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27587_1387436_1426812"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that lists files downloaded from the Internet, shows the location of each downloaded file, and allows the user to pause downloads, open files, and take other actions.</descrip></descripGrp><ntig><termGrp><term id="1387436">Download Manager</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1426812">ডাউনলোড পৰিচালক</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27588_1387437_1426821"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A client-server program accessed over a network that uses a web browser as the interface for the end user.</descrip></descripGrp><ntig><termGrp><term id="1387437">web application</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1426821">ৱেব প্ৰয়োগ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27588_1406417_1426821"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A client-server program accessed over a network that uses a web browser as the interface for the end user.</descrip></descripGrp><ntig><termGrp><term id="1406417">web app</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1426821">ৱেব প্ৰয়োগ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27595_1387750_1853101"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An audience member who is not physically located i