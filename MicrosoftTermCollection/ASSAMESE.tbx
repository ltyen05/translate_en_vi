Entry><termEntry id="50539_2862041_2862557"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A web-hosted technology product such as file storage, webmail, search engines, and calendar management.</descrip></descripGrp><ntig><termGrp><term id="2862041">service</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="2862557">সেৱা</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50540_2862042_2862556"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Microsoft web-hosted technology product such as Bing, MSN, OneDrive, Outlook.com, Devices, and Profile, all of which are accessed via a Microsoft account.</descrip></descripGrp><ntig><termGrp><term id="2862042">Microsoft Service</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="2862556">Microsoft সেৱা</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50547_2862401_2863001"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature in Microsoft Edge that notifies users whenever a password that they have saved through the browser has been identified as compromised.</descrip></descripGrp><ntig><termGrp><term id="2862401">Password Monitor</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="2863001">পাছৱৰ্ড মনিটৰ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50548_2862405_2863003"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft Edge feature that allows users to select, copy, and paste content that they find across the Web while maintaining the source site's formatting, spacing, and text so the copy looks like the original.</descrip></descripGrp><ntig><termGrp><term id="2862405">Smart copy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="2863003">স্মাৰ্ট প্ৰতিলিপি</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50549_2862409_2863005"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that lets Microsoft Edge users move their horizontal tabs at the top of the browser to a vertical pane at the right side of their screen.</descrip></descripGrp><ntig><termGrp><term id="2862409">vertical tabs</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="2863005">উলম্ব টেবসমূহ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50559_2862649_2863011"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of renewing one's energy over the course of a full night's sleep.</descrip></descripGrp><ntig><termGrp><term id="2862649">nightly recharge</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="2863011">নৈশ ৰিচাৰ্জ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50572_2864258_2864273"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A daily personalized email sent by Cortana to Office 365 users containing tasks and commitments made by the user, a summary of the user's meetings, and relevant documents for the user's day, all using information extracted from the user's Office 365 messages.</descrip></descripGrp><ntig><termGrp><term id="2864258">Cortana Briefing</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="2864273">Cortana ব্ৰিফিং</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50572_2864258_2864275"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A daily personalized email sent by Cortana to Office 365 users containing tasks and commitments made by the user, a summary of the user's meetings, and relevant documents for the user's day, all using information extracted from the user's Office 365 messages.</descrip></descripGrp><ntig><termGrp><term id="2864258">Cortana Briefing</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="2864275">Cortana ব্ৰিফিং ইমেইল</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50572_2864259_2864273"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A daily personalized email sent by Cortana to Office 365 users containing tasks and commitments made by the user, a summary of the user's meetings, and relevant documents for the user's day, all using information extracted from the user's Office 365 messages.</descrip></descripGrp><ntig><termGrp><term id="2864259">Cortana Briefing email</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="2864273">Cortana ব্ৰিফিং</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50572_2864259_2864275"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A daily personalized email sent by Cortana to Office 365 users containing tasks and commitments made by the user, a summary of the user's meetings, and relevant documents for the user's day, all using information extracted from the user's Office 365 messages.</descrip></descripGrp><ntig><termGrp><term id="2864259">Cortana Briefing email</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="2864275">Cortana ব্ৰিফিং ইমেইল</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50578_2864897_2864950"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that protects sensitive information on disk and makes it inaccessible to attackers when the device is locked using encryption keys that are temporarily wiped from the device and only made available when the device is unlocked.</descrip></descripGrp><ntig><termGrp><term id="2864897">personal information encryption</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="2864950">ব্যক্তিগত তথ্যৰ এনক্ৰিপশ্বন</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50578_2864898_2864950"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that protects sensitive information on disk and makes it inaccessible to attackers when the device is locked using encryption keys that are temporarily wiped from the device and only made available when the device is unlocked.</descrip></descripGrp><ntig><termGrp><term id="2864898">Data Protection under Lock</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="2864950">ব্যক্তিগত তথ্যৰ এনক্ৰিপশ্বন</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50578_2864899_2864950"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that protects sensitive information on disk and makes it inaccessible to attackers when the device is locked using encryption keys that are temporarily wiped from the device and only made available when the device is unlocked.</descrip></descripGrp><ntig><termGrp><term id="2864899">DPL</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="2864950">ব্যক্তিগত তথ্যৰ এনক্ৰিপশ্বন</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50579_2864948_2864951"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The option in Microsoft Photos that allows the user to adjust the brightest part of a photo to be either darker or brighter.</descrip></descripGrp><ntig><termGrp><term id="2864948">Highlights</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="2864951">হাইলাইটসমূহ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50591_2865796_2865830"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A headless app in the Microsoft Store that contains OpenGL and OpenCL API mapping layers on top of DirectX 12 that enable OpenCL and OpenGL apps to run with GPU acceleration in environments where there is no IHV OpenCL or OpenGL driver (for example, on Windows 10 ARM-based PCs).</descrip></descripGrp><ntig><termGrp><term id="2865796">OpenCL™ and OpenGL® Compatibility Pack</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="2865830">OpenCL™ আৰু OpenGL® সুসমতা পেক</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5060_129154_432898"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In relational database management systems, a logical table created through the specification of one or more relational operations on one or more tables. A view is equivalent to a divided relation in the relational model.</descrip></descripGrp><ntig><termGrp><term id="129154">view</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="432898">দৰ্শন</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50607_2866400_2866446"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The search function in Microsoft Edge that lets users select text or images on web pages, then open the right-click context menu to search and view results in a sidebar to the right of the browser tab while keeping the current website visible.</descrip></descripGrp><ntig><termGrp><term id="2866400">sidebar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="2866446">পাৰ্শ্বদণ্ডিকা</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50666_2867744_2867780"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The option in Microsoft Edge in which a customer can copy a URL and paste as a visual link, which provides a card with a key image and title, as well as additional information from the page where available.</descrip></descripGrp><ntig><termGrp><term id="2867744">web preview</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="2867780">ৱেব পূৰ্বলোকন</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50672_2868545_2870011"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Two apps that are grouped together by the customer, so both apps open at the same time.​</descrip></descripGrp><ntig><termGrp><term id="2868545">app group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="2870011">এপ্প্‌ৰ গোট</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50673_2868546_2870020"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To enlarge an app on a dual-screen device so that it goes across both screens.</descrip></descripGrp><ntig><termGrp><term id="2868546">maximize</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="2870020">সর্বাধিক কৰক</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50674_2868547_2870018"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To reorient a dual-screen device that is folded in order to see the other screen.</descrip></descripGrp><ntig><termGrp><term id="2868547">flip</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="2870018">ফ্লিপ কৰক</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50675_2868548_2870019"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To move one screen of a dual-screen device backward.</descrip></descripGrp><ntig><termGrp><term id="2868548">fold</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="2870019">ফ'ল্ড কৰক</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50679_2868550_2870015"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An app that has been designed specifically for dual-screen devices.</descrip></descripGrp><ntig><termGrp><term id="2868550">Dual-screen enhanced app</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="2870015">দ্বৈত-স্ক্ৰীণৰ উন্নত এপ্প্‌</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50681_2868552_2870016"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The hinge that holds the two screens together on the Surface Duo dual-screen device.</descrip></descripGrp><ntig><termGrp><term id="2868552">Dynamic 360° Hinge</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="2870016">Dynamic 360° Hinge</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5069_160054_433121"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A technique for converting a color in one color space to another color space. Typically, this conversion is from YUV colors from a video source to RGB for display.</descrip></descripGrp><ntig><termGrp><term id="160054">color-space conversion</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="433121">ৰং-স্থান পৰিবৰ্ত্তন</term><termNote ty