ment</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="2877046">এচাইনমেণ্ট</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50915_2877863_2878107"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To provide notification of a problem, bug, crash, violation, etc. via a form submission.</descrip></descripGrp><ntig><termGrp><term id="2877863">report</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="2878107">প্ৰতিবেদন কৰক</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50926_2878203_2878278"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft Business solution designed for small businesses and powered by Microsoft 365 and Windows 10, with device management and security features.</descrip></descripGrp><ntig><termGrp><term id="2878203">Microsoft 365 Small Business Premium</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="2878278">Microsoft 365 Small Business Premium</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50963_2879286_2879312"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An inspection of devices, mailboxes, and other types of entities performed automatically in response to various detections, after which remediation actions might be taken on malicious and suspicious items found during the investigation.</descrip></descripGrp><ntig><termGrp><term id="2879286">automated investigation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="2879312">স্বয়ংক্ৰিয় তদন্ত</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50964_2879287_2879313"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A threat remediation mechanism that automatically applies various actions, such as file quarantine or deletion of persistence mechanism in the registry, based on the results of a corresponding automated investigation.</descrip></descripGrp><ntig><termGrp><term id="2879287">automatic remediation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="2879313">স্বয়ংক্ৰিয় প্ৰতিকাৰ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50965_2879288_2879311"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A query-based proactive threat hunting capability that provides flexible options for locating undetected breach activity as well as network assets that require attention.</descrip></descripGrp><ntig><termGrp><term id="2879288">advanced hunting</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="2879311">উন্নত হাণ্টিং</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50966_2879289_2879315"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A repository of reports about emerging threats, including specific incidents and campaigns, threat techniques, and vulnerabilities.</descrip></descripGrp><ntig><termGrp><term id="2879289">threat analytics</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="2879315">ভাবুকিৰ বিশ্লেষণ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50967_2879290_2879314"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A malware detonation service that customers can use to submit suspicious files for automated analysis.</descrip></descripGrp><ntig><termGrp><term id="2879290">deep analysis</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="2879314">গভীৰ বিশ্লেষণ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGr