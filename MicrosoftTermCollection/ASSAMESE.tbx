><term id="2244478">Design panel</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="2255925">ডিজাইন পেনেল</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38597_2244480_2256082"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Sway card that takes a set of cards and creates a group out of them with a particular visualization pattern.</descrip></descripGrp><ntig><termGrp><term id="2244480">group card</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="2256082">গোট কাৰ্ড</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38598_2244481_2256137"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The gallery that holds all the Style options that can be applied to a sway.</descrip></descripGrp><ntig><termGrp><term id="2244481">Style gallery</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="2256137">শৈলী গেলাৰী</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38599_2244483_2255941"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The option that shows the set of fonts that can be applied to a sway.</descrip></descripGrp><ntig><termGrp><term id="2244483">Font choices</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="2255941">ফ’ণ্ট পচন্দসমূহ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="386_93737_432729"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A hardware- or software-based interface used to transfer information between a computer and other devices. Hardware ports are physical connections that are visible on the outside of the computer. Software ports are the numbered gateways in programs that software programs use to exchange information.</descrip></descripGrp><ntig><termGrp><term id="93737">port</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="432729">পৰ্ট</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38600_2244485_2255936"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Design feature that allows users to save particular Designs, Styles, or Structures for easy use or access later.</descrip></descripGrp><ntig><termGrp><term id="2244485">Favorites</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></l