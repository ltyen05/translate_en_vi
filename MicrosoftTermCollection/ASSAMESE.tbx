sis</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1853193">দ্ৰুত বিশ্লেষণ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31899_1626610_1853194"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mode that is optimized for reading or viewing content and does not support edit functionality.</descrip></descripGrp><ntig><termGrp><term id="1626610">Read mode</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1853194">পঢ়া মোড</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="319_48012_432404"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To press and release a mouse button twice in rapid succession without moving the mouse. Double-clicking is a means of rapidly selecting and activating a program or program feature.</descrip></descripGrp><ntig><termGrp><term id="48012">double-click</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="432404">দুবাৰ-ক্লিক কৰক</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></lan