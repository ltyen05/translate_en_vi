nition">The ink effect that resembles the color and texture of lava.</descrip></descripGrp><ntig><termGrp><term id="2556943">lava</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="2558904">লাভা</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45294_2556950_2558900"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature applied to an object on the screen to change its visual appearance often to cause a certain reaction.</descrip></descripGrp><ntig><termGrp><term id="2556950">effect</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="2558900">প্ৰভাৱ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="453_346972_1258426"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Without difficulty.</descrip></descripGrp><ntig><termGrp><term id="346972">easily</term><termNote type="partOfSpeech">Adverb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1258426">সহজতে</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Adverb</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45305_2556986_2557278"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The name of the premium experience for mixed reality when used with PC hardware that can support higher resolution/quality graphics.</descrip></descripGrp><ntig><termGrp><term id="2556986">Windows Mixed Reality Ultra</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="2557278">Windows Mixed Reality Ultra</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4531_168151_433137"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To add a special visual or sound effect to text or an object. For example, you can have your text bullet points fly in from the left, one word at a time, or hear the sound of applause when a picture is uncovered.</descrip></descripGrp><ntig><termGrp><term id="168151">animate</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="433137">এনিমেট</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4544_140325_432994"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A connection that specifies the name, type, location, and, optionally, other information about a database file or server.</descrip></descripGrp><ntig><termGrp><term id="140325">database connection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></l