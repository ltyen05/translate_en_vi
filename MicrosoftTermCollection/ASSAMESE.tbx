ion">A horizontal bar at the top of a window that displays the name of the window.</descrip></descripGrp><ntig><termGrp><term id="679024">caption bar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="432869">শীৰ্ষক দণ্ডিকা</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2138_165180_433135"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A single character that represents a sequence of characters, usually a combination of a base character and one or more diacritics.</descrip></descripGrp><ntig><termGrp><term id="165180">precomposed character</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="433135">পূর্বৰচিত বৰ্ণ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21381_1102876_1257213"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that displays a definition or translation of a word or piece of text in a ScreenTip when the pointer is moved over the selection.</descrip></descripGrp><ntig><termGrp><term id="1102876">Mini Translator</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1257213">ক্ষুদ্ৰ অনুবাদক</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21402_775135_2371310"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A radio network that provides coverage for cellular telephone communications.</descrip></descripGrp><ntig><termGrp><term id="775135">cellular network</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="2371310">চেলুলাৰ নেটৱৰ্ক</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21402_775136_2371310"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A radio network that provides coverage for cellular telephone communications.</descrip></descripGrp><ntig><termGrp><term id="775136">cellular</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="2371310">চেলুলাৰ নেটৱৰ্ক</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21407_776107_1257214"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To copy driver binaries, install services, and add registry keys for one or more drivers from a driver package onto a system, without the context of a specific device. A system can be booted from reflected drivers, however full device installation may still be required in order to enable full driver functionality.</descrip></descripGrp><ntig><termGrp><term id="776107">reflect</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1257214">প্ৰতিফলিত কৰক</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21417_777441_1257215"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Windows feature that enables users to share pictures, music, videos, documents, and printers with other people on a home network.</descrip></descripGrp><ntig><termGrp><term id="777441">Windows HomeGroup</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1257215">গৃহগোট</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21417_779020_1257215"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Windows feature that enables users to share pictures, music, videos, documents, and printers with other people on a home network.</descrip></descripGrp><ntig><termGrp><term id="779020">HomeGroup</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1257215">গৃহগোট</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote