tocol security (IPsec).</descrip></descripGrp><ntig><termGrp><term id="262694">Internet Key Exchange</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="433485">ইন্টাৰনেট কী বিনিময়</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9583_262694_433486"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A protocol that establishes the security association and shared keys necessary for computers to communicate by using Internet Protocol security (IPsec).</descrip></descripGrp><ntig><termGrp><term id="262694">Internet Key Exchange</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="433486">IKE</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9583_262695_433485"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A protocol that establishes the security association and shared keys necessary for computers to communicate by using Internet Protocol security (IPsec).</descrip></descripGrp><ntig><termGrp><term id="262695">IKE</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="433485">ইন্টাৰনেট কী বিনিময়</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote typ