Grp><ntig><termGrp><term id="2312654">Quick Filter</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="2359656">বাৰ্তা সূচীৰ বাবে ক্ষিপ্ৰ ফিল্টাৰসমূহ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39856_2357846_2319946"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Outlook feature that allows users to sort and display email based on predefined criteria.</descrip></descripGrp><ntig><termGrp><term id="2357846">Quick Filters for message list</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="2319946">দ্ৰুত ফিল্টাৰ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39856_2357846_2359656"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Outlook feature that allows users to sort and display email based on predefined criteria.</descrip></descripGrp><ntig><termGrp><term id="2357846">Quick Filters for message list</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="2359656">বাৰ্তা সূচীৰ বাবে ক্ষিপ্ৰ ফিল্টাৰসমূহ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39857_2312655_2427461"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Outlook feature that intelligently presorts email across all email accounts.</descrip></descripGrp><ntig><termGrp><term id="2312655">Focused Inbox</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="2427461">দৃষ্টি নিবদ্ধ ইনবক্স</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39858_2312656_2427462"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The menu selection that allows users to move emails from the focused inbox into the Other category.</descrip></descripGrp><ntig><termGrp><term id="2312656">Move to Non-Focused Inbox</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="2427462">অনা-দৃষ্টি নিবদ্ধ ইনবক্সলৈ লৈ যাওক</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39864_2322624_2325370"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The wireless personal area network technology, launched in 2010 and marketed as Bluetooth Smart, used for transmitting data over distances as much as 100 meters. Cost and power consumption are low while maintaining a communication range similar to Bluetooth BR/EDR, the other widely-used version of Bluetooth</descrip></descripGrp><ntig><termGrp><term id="2322624">Bluetooth Smart</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="2325370">Bluetooth Smart</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39866_2315181_2319845"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Bluetooth Low Energy device that sends static information, such as location or ID, to devices within its area.</descrip></descripGrp><ntig><termGrp><term id="2315181">beacon</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="2319845">বিকন</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3987_141789_1955143"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A placeholder text that included the field character, field type, and instructions, and that that shows where specified information from a data source will appear such that the elements in a field that generate a field's result.</descrip></descripGrp><ntig><termGrp><term id="141789">field code</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1955143">ফিল্ড ক'ড</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39877_2315966_2319877"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature for maps of the interior of some public places, such as the businesses inside a mall, or the gates, businesses, and other services inside an airport.</descrip></descripGrp><ntig><termGrp><term id="2315966">venue map</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="2319877">ভেনু মেপ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39878_2316274_2319859"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Of, pertaining to, or characteristic of apps or services made available in an enterprise to help with particular business and process needs.</descrip></descripGrp><ntig><termGrp><term id="2316274">line-of-business</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="2319859">ব্যৱসায়ৰ-লাইন</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39878_2316274_2319860"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Of, pertaining to, or characteristic of apps or services made available in an enterprise to help with particular business and process needs.</descrip></descripGrp><ntig><termGrp><term id="2316274">line-of