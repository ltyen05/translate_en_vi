149_432977"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An index file with two columns: the first column lists the text in the document that you want to index, and the second column lists the index entries to generate from the text in the first column.</descrip></descripGrp><ntig><termGrp><term id="139149">concordance file</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="432977">সূচি ফাইল</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15795_160318_433123"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To assign a drive letter, port, or computer name to a shared resource so that you can use it.</descrip></descripGrp><ntig><termGrp><term id="160318">connect</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="433123">সংযোগ কৰক</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15796_233422_1403646"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To automatically remove items to another folder periodically or delete them, based on the amount of time that they have been in the folder.</descrip></descripGrp><ntig><termGrp><term id="233422">AutoArchive</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="140