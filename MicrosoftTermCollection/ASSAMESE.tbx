</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="2063731">লাইভ ষ্ট্ৰীমিং</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33625_1805619_2063732"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A piece of information supplied by the user that appears in the mood panel beside the user's Skype Name for other users to see.</descrip></descripGrp><ntig><termGrp><term id="1805619">mood message</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="2063732">মুড বাৰ্তা</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33626_1805620_2063733"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A field next to the user's Skype Name for typing a mood message.</descrip></descripGrp><ntig><termGrp><term id="1805620">mood panel</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="2063733">মুড পেনেল</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33627_1805621_2063730"><langSet xml:lang="en-US"><descripGrp><descrip type="definit