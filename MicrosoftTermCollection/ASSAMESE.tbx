oun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1804335">ডাটা বিন্দু</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17851_650211_1852868"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A character that is used to separate the day, month, and year when date values are formatted. The characters are determined by system settings or by the Format function.</descrip></descripGrp><ntig><termGrp><term id="650211">date separator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1852868">ডাটা পৃথককাৰী</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17854_650214_1257084"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The font that a program uses by default to display text.</descrip></descripGrp><ntig><termGrp><term id="650214">default font</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1257084">ডিফল্ট ফ'ণ্ট</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17859_650219_1425271"><langSet xml:lang="en-US"><descripGrp><descrip type="definition