<descrip type="definition">A group of physical disks that can be managed together.</descrip></descripGrp><ntig><termGrp><term id="1596723">storage pool</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1644387">সঞ্চয়াগাৰ পুল</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31104_1596724_1644434"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of one or more physical disks from a previously created storage pool.</descrip></descripGrp><ntig><termGrp><term id="1596724">virtual disk</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1644434">ভাৰ্টুৱেল ডিক্স</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31118_1630222_1642336"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method of starting the computer that speeds boot time by ending the user session and hibernating the computer, rather than shutting down all running services.</descrip></descripGrp><ntig><termGrp><term id="1630222">fast startup</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1642336">দ্ৰুত ষ্টাৰ্টআপ্</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote