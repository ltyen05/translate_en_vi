t></termEntry><termEntry id="39880_2320100_2323201"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app for PC and Surface Hub that helps you connect a phone or PC to the Surface Hub display, or to another PC. On Surface Hub, it also allows you to switch between devices that are connected to the Surface Hub.​</descrip></descripGrp><ntig><termGrp><term id="2320100">Connect</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="2323201">সংযোগ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39882_2320437_2323205"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app for purchasing cellular data that is packaged with cellular enabled Dell devices that include a Microsoft SIM card.</descrip></descripGrp><ntig><termGrp><term id="2320437">Dell NetReady</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="2323205">Dell NetReady</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39889_2321509_2323234"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The collection of TV shows that are in the top N% of ratings.</descrip></descripGrp><ntig><termGrp><term id="2321509">Top-rated TV shows</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langS