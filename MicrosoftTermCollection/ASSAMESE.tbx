47_3053673_3054721"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of security procedures and tools that broadly protect sensitive enterprise information from misuse, unauthorized access, disruption, or destruction. It encompasses physical and environmental security, access control, and cybersecurity.</descrip></descripGrp><ntig><termGrp><term id="3053673">information security</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="3054721">তথ্যৰ নিৰাপত্তা</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53647_3053673_3054722"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of security procedures and tools that broadly protect sensitive enterprise information from misuse, unauthorized access, disruption, or destruction. It encompasses physical and environmental security, access control, and cybersecurity.</descrip></descripGrp><ntig><termGrp><term id="3053673">information security</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="3054722">InfoSec</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53647_3053674_3054721"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of security procedures and tools that broadly protect sensitive enterprise information from misuse, unauthorized access, disruption, or destructi