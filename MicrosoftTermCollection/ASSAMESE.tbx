k on an embedded image to see any of the following: a high resolution version of it, a link to where the image was found, as well as related images.</descrip></descripGrp><ntig><termGrp><term id="2244846">Detail view</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="2255926">সবিশেষ দৰ্শন</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38605_2244852_2255901"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Sway button that allows users to create a bulleted list out of their text.</descrip></descripGrp><ntig><termGrp><term id="2244852">Bulleted list</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="2255901">বুলেটযুক্ত সূচী</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38625_2244876_2256096"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Sway button that allows users to create a numbered list out of their text.</descrip></descripGrp><ntig><termGrp><term id="2244876">Numbered list</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="2256096">সংখ্যাযুক্ত সূচী</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termN