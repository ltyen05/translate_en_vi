mNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="2255871">Windows Insider সম্প্ৰদায় ফ'ৰাম</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3871_232400_1256919"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to time when an individual has nothing scheduled and appears as  available.</descrip></descripGrp><ntig><termGrp><term id="232400">free</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1256919">মুক্ত</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38721_2255320_2255773"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A catalog of information for apps, games, movies and TV shows based on dynamic information such as new or fastest rising, top free, best rated, and top paid.</descrip></descripGrp><ntig><termGrp><term id="2255320">chart</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="2255773">চাৰ্ট</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3873_231624_433275"><langS