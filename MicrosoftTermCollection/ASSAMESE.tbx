rmNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2782_308818_433674"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An organization that provides a connection to the internet and services related to that.</descrip></descripGrp><ntig><termGrp><term id="308818">IAP</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="433674">IAP</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27850_1465579_2327520"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A class of notification that is generated by user-defined rules meant to inform him/her of events, conditions, and status changes.</descrip></descripGrp><ntig><termGrp><term id="1465579">alert</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="2327520">সতৰ্ক</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27852_1465584_2607841"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The collective of attack vectors through which a system can be attacked successfully.</descrip></descripGrp><ntig><termGrp><term id="1465584">attack surface</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="2607841">সংবেদনশীল ক্ষেত্ৰ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27934_1468118_2624395"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A view where the preview area is centered and the thumbnails that immediately precede and follow the current thumbnail are adjacent to the preview area.</descrip></descripGrp><ntig><termGrp><term id="1468118">carousel view</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="2624395">কেৰোজেল দৰ্শন</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2796_3846_1403604"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Self-propagating malicious software that can automatically distribute itself from one computer to another through network connections. A worm can take harmful action, such as consuming network or local system resources, possibly causing a denial of service attack.</descrip></descripGrp><ntig><termGrp><term id="3846">worm</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1403604">ৱৰ্ম</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28_2656622_2657651"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A piece of the user interface (UI) in Outlook Web Access that can be hosted in iframes as part of other Web applications such as SharePoint Portal Server portals. Outlook Web Access exposes a set of Outlook Web Access Web Part URLs that allow other applications to request certain portions of the Outlook Web Access UI. For example, another application can load the Outlook Web Access Web Part URL for the Inbox, Calendar, or Contact folder into an iframe hosted in that application.</descrip></descripGrp><ntig><termGrp><term id="2656622">Outlook Web App Web Part</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="2657651">Outlook Web App ৱেব পাৰ্ট</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="280_114555_432813"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To organize information, such as a list of files, in a particular order. For example, a list of files can be sorted alphabetically by name in ascending or descending order.</descrip></descripGrp><ntig><termGrp><term id="114555">sort</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="432813">চৰ্ট কৰক</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2803_232424_1852757"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The list of tasks in Calendar.</descrip></descripGrp><ntig>