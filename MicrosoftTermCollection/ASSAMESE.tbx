igher than other text on a line, such as a footnote reference mark.</descrip></descripGrp><ntig><termGrp><term id="117651">superscript</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1257034">ছুপাৰস্ক্ৰিপ্ট</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1421_145137_2785796"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A network type that a computer is connected to that automatically sets the appropriate firewall settings for the location.</descrip></descripGrp><ntig><termGrp><term id="145137">network location</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="2785796">নেটৱৰ্কৰ অৱস্থান</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14211_213519_2641006"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An order for a SKU that is currently not available for delivery.</descrip></descripGrp><ntig><termGrp><term id="213519">pre-order</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="2641006">প্ৰি-অৰ্ডাৰ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</ter