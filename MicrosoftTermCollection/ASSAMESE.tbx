/descripGrp><ntig><termGrp><term id="2430908">Ink Editor</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="2433590">চিঁয়াহী সম্পাদক</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4288_346910_433938"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To join or link.</descrip></descripGrp><ntig><termGrp><term id="346910">connect</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="433938">সংযোগ কৰক</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42885_2432491_2435317"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tool that allows users to use ink to highlight content using their mouse, finger, or an inking tool, and whose ink resembles a traditional highlighter.</descrip></descripGrp><ntig><termGrp><term id="2432491">highlighter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="2435317">হাইলাইটাৰ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42886_2432492_2435316"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To create, highlight, or erase content using ink.</descrip></descripGrp><ntig><termGrp><term id="2432492">draw</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="2435316">অংকন কৰক</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42887_2432493_2435319"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tool that allows users to use ink to draw using their mouse, finger, or an inking tool, and whose ink resembles pencil graphite.</descrip></descripGrp><ntig><termGrp><term id="2432493">pencil</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="2435319">পেঞ্চিল</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42888_2432494_2435318"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tool that allows users to use ink to draw using their mouse, finger, or an inking tool, and whose ink resembles traditional pen ink.</descrip></descripGrp><ntig><termGrp><term id="2432494">pen</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="2435318">পেন</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42889_2432495_2435322"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A button that is activated when clicked once, and when clicked a second time, opens a menu that allows the user to modify the mode of the selected tool.</descrip></descripGrp><ntig><termGrp><term id="2432495">secondary action button</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="2435322">গৌণ কাৰ্য্য বুটাম</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42890_2432497_2435323"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A menu that is opened via a secondary action button and that gives users one or more options for changing the mode of the selected tool.</descrip></descripGrp><ntig><termGrp><term id="2432497">secondary action menu</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="2435323">গৌণ কাৰ্য্য মেনু</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42891_2432499_2435321"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An in-ribbon container that holds a collection of buttons and where the user can add additional buttons, reorganize buttons, and scroll through them when they are not all visible within