ipGrp><descrip type="definition">An address similar to a URL that provides network access to an event, such as a live broadcast. Attendees go to this address to view the event from their computers.</descrip></descripGrp><ntig><termGrp><term id="650877">event address</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1257085">ইভেণ্ট ঠিকনা</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18525_650879_1804348"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A text string that unambiguously refers to a hardware or software component under a certain context and can be used to access the data in that component.</descrip></descripGrp><ntig><termGrp><term id="650879">identifier</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1804348">চিনাক্তকাৰী</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18529_650883_1257086"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Data that is stored outside of the application that is currently in use.</descrip></descripGrp><ntig><termGrp><term id="650883">external data</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1257086">বাহ্যিক ডাটা</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18530_650884_1257087"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A range of data that is brought into a worksheet but that originates outside of Excel, such as in a database or text file.</descrip></descripGrp><ntig><termGrp><term id="650884">external data range</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1257087">বাহ্যিক ডাটা পৰিসৰ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18535_650889_1852871"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A pane located on top of the Navigation Pane that has copies of your Inbox, Sent Items, and so on. You can add, remove, and arrange folders in this pane. Collapse or expand the pane by clicking the arrow in the Favorite Folders header.</descrip></descripGrp><ntig><termGrp><term id="650889">Favorite Folders</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1852871">প্ৰিয় ফ'ল্ডাৰসমূহ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18536_650890_1257088"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A button that identifies a field in a PivotTable or PivotChart report. You can drag the field buttons to change the layout of the report, or click the arrows next to the buttons to change the level of detail displayed in the report.</descrip></descripGrp><ntig><termGrp><term id="650890">field button</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1257088">ফিল্ড বুটাম</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18538_650892_1257089"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The part of PivotTable or PivotChart view that contains filter fields.</descrip></descripGrp><ntig><termGrp><term id="650892">filter area</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1257089">ফিল্টাৰ ক্ষেত্ৰ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18539_650893_1257090"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A field in the filter area that you can use to filter data displayed in PivotTable or PivotChart view. Filter fields perform the same functions as page fields in Microsoft Excel PivotTable reports.</descrip></descripGrp><ntig><termGrp><term id="650893">filter field</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1257090">ফিল্টাৰ ফিল্ড</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18542_650896_1425272"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The date that a project or task is scheduled to be completed. This date is based on the task's start date, duration, calendars, predecessor dates, task dependencies, and constraints.</descrip></descripGrp><ntig><termGrp><term id="650896">finish date</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1425272">সমাপ্তি তাৰিখ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18549_650903_1257091"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Internet Web page or intranet page that is associated with an Outlook folder. If a page has been associated with the folder and the option is set, the Web page appears in the Outlook window whenever you select the folder.</descrip></descripGrp><ntig><termGrp><term id="650903">folder home page</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1257091">ফ'ল্ডাৰ গৃহ পৃষ্ঠা</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1855_307383_433647"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of validating software with the manufacturer. Activation confirms the genuine status of a product and that the product key has not been compromised. It establishes a relationship between the software’s product key and a particular installation of that software on a device.</descrip></descripGrp><ntig><termGrp><term id="307383">activation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="433647">সক্ৰিয়কৰণ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18551_650905_1257092"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A location on a computer's hard drive to store a local copy of a form to improve performance when opening a form subsequent times.</descrip></descripGrp><ntig><termGrp><term id="650905">forms cache</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1257092">ফৰ্ম কেশ্ব</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18558_650912_1257093"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method to find a specific value for a cell by adjusting the value of one other cell. When goal seeking, Excel varies the value in a cell that you specify until a formula that's dependent on that cell returns the result you want.</descrip></descripGrp><ntig><termGrp><term id="650912">goal seek</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1257093">লক্ষ্য অন্বেষণ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18559_650913_1804347"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A rank or category assigned to a material resource that denotes functional use but not level of quality. A low-grade resource is not necessarily a low-quality resource.</descrip></descripGrp><ntig><termGrp><term id="650913">grade</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1804347">গ্ৰেড</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1856_52994_1852560"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Expressed as n! (n factorial), the result of multiplying the successive integers from 1 through n; n! equals n x (n - 1) x (n - 2) x ... x 1.</descrip></descripGrp><ntig><termGrp><term id="52994">factorial</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1852560">গৌণিক</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18560_650914_1950842"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The faint vertical and horizontal lines that appear in the drawing window when the grid is turned on. You can use grid lines to help position shapes precisely.</descrip></descripGrp><ntig><termGrp><term id="650914">grid lines</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1950842">গ্ৰিড ৰেখাসমূহ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18561_650915_1257095"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The point that defines the layout of grid lines on the drawing page. A vertical grid line and a horizontal grid line pass through the grid origin, and all other grid lines are drawn at specified intervals from these reference lines.</descrip></descripGrp><ntig><termGrp><term id="650915">grid origin</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1257095">গ্ৰিড মূল</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1858_128261_432895"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The | character.</descrip></descripGrp><ntig><termGrp><term id="128261">vertical bar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="432895">উলম্ব দণ্ডিকা</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1858_128261_432896"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The | character.</descrip></descripGrp><ntig><termGrp><term id="128261">vertical bar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="432896">পাইপ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1858_128262_432895"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The | character.</descrip></descripGrp><ntig><termGrp><term id="128262">VERTICAL LINE</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="432895">উলম্ব দণ্ডিকা</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1858_128262_432896"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The | character.</descrip></descripGrp><ntig><termGrp><term id="128262">VERTICAL LINE</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="432896">পাইপ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1858_128263_432895"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The | character.</descrip></descripGrp><ntig><termGrp><term id="128263">pipe</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="432895">উলম্ব দণ্ডিকা</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1858_128263_432896"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The | character.</descrip></descripGrp><ntig><termGrp><term id="128263">pipe</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="432896">পাইপ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18583_650937_1852872"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A phone number format for dialing any call from any location or with a calling card.</descrip></descripGrp><ntig><termGrp><term id="650937">international format</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1852872">আন্তঃৰাষ্ট্ৰীয় সজ্জা</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18585_650939_1257097"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A line that connects fields between two tables and shows how the data is related. The type of join indicates which records are selected for the query's result set.</descrip></descripGrp><ntig><termGrp><term id="650939">join line</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1257097">যুক্ত ৰেখা</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18587_650941_1257098"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The special characters used to extend the joiner between two Arabic characters. Used to improve the appearance of justified text by visually lengthening words rather than increasing the spacing between words. Can also function like a hyphen.</descrip></descripGrp><ntig><termGrp><term id="650941">kashidas</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1257098">কাচিডাছ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18590_650944_1425273"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Resolving resource conflicts or overallocations by delaying or splitting certain tasks. When Project levels a resource, its selected assignments are distributed and rescheduled.</descrip></descripGrp><ntig><termGrp><term id="650944">leveling</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1425273">স্তৰীকৰণ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18594_650948_1257099"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of cascading style sheet that exists in a separate file and is referenced throughout one or more Web pages.</descrip></descripGrp><ntig><termGrp><term id="650948">linked style sheet</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1257099">যোগসূত্ৰ থকা শৈলী শ্বীট</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18594_650948_1401808"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of cascading style sheet that exists in a separate file and is referenced throughout one or more Web pages.</descrip></descripGrp><ntig><termGrp><term id="650948">linked style sheet</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1401808">লিংক হৈ থকা শৈলী শ্বীট</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18598_650952_1852873"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A character, usually a comma or semicolon, that separates elements in a list.</descrip></descripGrp><ntig><termGrp><term id="650952">list-separator character</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1852873">সূচী-পৃথককাৰী বৰ্ণ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="186_3712_1258423"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To change to a newer, and/or more powerful or sophisticated version of a product.</descrip></descripGrp><ntig><termGrp><term id="3712">upgrade</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1258423">নৱীকৰণ কৰক</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18601_650955_1852874"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A calendar that is based on cycles of the moon phase.</descrip></descripGrp><ntig><termGrp><term id="650955">Lunar calendar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1852874">চান্দ্ৰ কেলেণ্ডাৰ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18604_650958_1852875"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A range in an XML list that has been linked to an element in an XML map.</descrip></descripGrp><ntig><termGrp><term id="650958">mapped range</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1852875">মেপ হৈ থকা প্ৰসাৰ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18605_650959_1425274"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A shape on a stencil that you use repeatedly to create drawings. When you drag a shape from a stencil onto the drawing page, the shape becomes an instance of that master.</descrip></descripGrp><ntig><termGrp><term id="650959">master shape</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1425274">প্ৰমূখ আকৃতি</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18614_650968_1852876"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tone in a picture that is in the middle of the tonal range, between the lightest and darkest tones</descrip></descripGrp><ntig><termGrp><term id="650968">midtone</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1852876">মিডট'ন</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1881_68580_432536"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Software that enables a program to work with the user (the user interface, which can be a command-line interface, menu-driven, or a graphical user interface), with another program such as the operating system, or with the computer's hardware.</descrip></descripGrp><ntig><termGrp><term id="68580">interface</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="432536">ইন্টাৰফেচ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1883_318780_433808"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The = character.</descrip></descripGrp><ntig><termGrp><term id="318780">equal sign</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="433808">সমান চিন</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18831_651182_1852877"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A character that does not have strong right-to-left or left-to-right language attributes.</descrip></descripGrp><ntig><termGrp><term id="651182">neutral character</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1852877">নিৰপেক্ষ বৰ্ণ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18840_651191_1852878"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file you create on your hard disk or a network share to store OLAP source data for a PivotTable or PivotChart report. Offline cube files allow you to keep working when you are not connected to the OLAP server.</descrip></descripGrp><ntig><termGrp><term id="651191">offline cube file</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1852878">অফলাইন কিউব ফাইল</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1885_69963_1256891"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ability for two or more software applications to work together with little effort from the user.</descrip></descripGrp><ntig><termGrp><term id="69963">interoperability</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1256891">আন্ত:সংযোগকৰণ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18851_651202_1425275"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The result of assigning more tasks to a resource than the resource can accomplish in the working time available.</descrip></descripGrp><ntig><termGrp><term id="651202">overallocation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1425275">অতি আৱন্টন</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18860_651211_1804369"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Principles that guide developers as they assign responsibilities to software classes and design system behavior. They are most useful when creating collaboration diagrams where messages imply responsibility.</descrip></descripGrp><ntig><termGrp><term id="651211">patterns</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1804369">আৰ্হি</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18862_651213_1852879"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A field that you use to enter or display how much of a task has been completed. This value is expressed as the percentage of the task duration that has been completed.</descrip></descripGrp><ntig><termGrp><term id="651213">percent complete</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1852879">শতাংশ সম্পূৰ্ণ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18865_651216_1257100"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A view of a list, SharePoint document library, or Web Part Page that is available only to a particular user.</descrip></descripGrp><ntig><termGrp><term id="651216">personal view</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1257100">ব্যক্তিগত দৰ্শন</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18873_651224_1425276"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A schedule of task start and finish dates and resource and cost data.</descrip></descripGrp><ntig><termGrp><term id="651224">plan</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1425276">পৰিকল্পনা</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18876_651227_1852880"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A list of projects within an organization that may share common management of scope, budget, or resources.</descrip></descripGrp><ntig><termGrp><term id="651227">portfolio</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1852880">পোৰ্টফোলিঅ'</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18877_651228_1425277"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Placing elements, such as text and graphics, on a page to let the page author control the exact location and layer order of a page element.</descrip></descripGrp><ntig><termGrp><term id="651228">positioning</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1425277">অৱস্থান</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18878_651229_1852881"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A bookmark that Microsoft Word automatically sets in each document.</descrip></descripGrp><ntig><termGrp><term id="651229">predefined bookmark</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1852881">পূৰ্বনিৰ্ধাৰিত বুকমাৰ্ক</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18891_651242_1425278"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The degree of excellence, or the desired standards, in a product, process, or project.</descrip></descripGrp><ntig><termGrp><term id="651242">quality</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1425278">গুণাগুণ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18892_651243_1852882"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A default color category that is assigned to an item when you click the Categories column for the item in your Inbox or other table view. You set this color category from the Categorize menu.</descrip></descripGrp><ntig><termGrp><term id="651243">Quick Click category</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1852882">দ্ৰুত ক্লিক বৰ্গ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18894_651245_1804350"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To move a task to a lower outline level [to the right] in the Task Name field. When you indent a task, it becomes a subtask of the nearest preceding task at a higher outline level.</descrip></descripGrp><ntig><termGrp><term id="651245">indent</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1804350">ইণ্ডেণ্ট কৰক</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18895_651246_1852883"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A task that occurs repeatedly during the course of a project. For example, you might define the weekly status meeting as a recurring task.</descrip></descripGrp><ntig><termGrp><term id="651246">recurring task</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1852883">পুনৰাৱৰ্তী কাৰ্য</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18908_651259_1852884"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Excel template (.xlt file) that includes one or more queries or PivotTable reports that are based on external data. When you save a report template, Excel saves the query definition but doesn't store the queried data in the template.</descrip></descripGrp><ntig><termGrp><term id="651259">report template</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1852884">ৰিপৰ্ট টেমপ্লেট</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18909_651260_1257101"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A category of reports that all contain similar information.</descrip></descripGrp><ntig><termGrp><term id="651260">report type</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1257101">প্ৰতিবেদন টাইপ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18916_651267_1852885"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A certificate that has been cancelled by a certificate authority (CA) and is no longer valid.</descrip></descripGrp><ntig><termGrp><term id="651267">revoked certificate</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1852885">প্ৰমাণ-পত্ৰ প্ৰত্যাহাৰ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18926_651277_1425279"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A representation of the communication path between actors.</descrip></descripGrp><ntig><termGrp><term id="651277">binding</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp