un</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53046_3014888_3016073"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A diagram for creating medium-fidelity mock-ups of software applications and websites.</descrip></descripGrp><ntig><termGrp><term id="3014888">wireframe diagram</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="3016073">ৱায়াৰফ্ৰেম</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53046_3014888_3016075"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A diagram for creating medium-fidelity mock-ups of software applications and websites.</descrip></descripGrp><ntig><termGrp><term id="3014888">wireframe diagram</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="3016075">ৱায়াৰফ্ৰেমৰ নক্সা</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53046_3014889_3016073"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A diagram for creating medium-fidelity mock-ups of software applications and websites.</descrip></descripGrp><ntig><termGrp><term id="3014889">wireframe</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet