">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="754_113830_432811"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A font effect in which lowercase text appears as capital letters in a reduced font size.</descrip></descripGrp><ntig><termGrp><term id="113830">small caps</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="432811">সৰু কেপছ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="756_106608_1425196"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An on-screen scale marked off in inches or other units of measure and used to show line widths, tab settings, paragraph indents, and so on.</descrip></descripGrp><ntig><termGrp><term id="106608">ruler</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1425196">ৰুলাৰ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7561_306402_433635"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A filter effect in Windows Movie Maker.</descrip></descripGrp><ntig><termGrp><term id="306402">Rotate 180</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><term