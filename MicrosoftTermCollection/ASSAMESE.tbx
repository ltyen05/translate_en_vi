="2829184">স্বয়ংক্ৰিয় অনুবাদ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20749_747350_2829184"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of using a “machine” (in most cases computer software) to translate text from one human language to another.</descrip></descripGrp><ntig><termGrp><term id="747350">machine translation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="2829184">স্বয়ংক্ৰিয় অনুবাদ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20752_747355_1257139"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A pencil tool that works with texture and simulates a real life pencil in stroke.</descrip></descripGrp><ntig><termGrp><term id="747355">natural pencil</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1257139">নেচাৰেল পেঞ্চিল</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20754_747357_1257140"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Windows feature that enables users to easily roll back their PC to an earlier good state while keeping their data safe.</descrip></descripGrp><ntig><termGrp><term id="747357">System Recovery</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1257140">চিষ্টেম পুণৰুদ্ধাৰ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2077_149214_1256894"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A view on a calendar that displays items such as meetings and events from left to right on a time scale and that can incorporate items from multiple calendars.</descrip></descripGrp><ntig><termGrp><term id="149214">timeline</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1256894">সময় ৰেখা</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20781_747562_2843513"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In a call queue, a method of sending calls to agents whereby incoming calls ring all call agents one by one, from the beginning of the call agent list. If an agent dismisses or does not pick up a call, the call will ring the next agent and will try all agents until it is picked up or times out.</descrip></descripGrp><ntig><termGrp><term id="747562">serial routing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="2843513">ক্ৰমিক ৰাউটিং</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20803_3193169_1945941"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process by which multiple authors edit a shared document simultaneously, or collaborate effectively even when they are not online at the same time.</descrip></descripGrp><ntig><termGrp><term id="3193169">coauthoring</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1945941">সহ-সৃষ্টিকৰণ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20803_3193169_3193177"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process by which multiple authors edit a shared document simultaneously, or collaborate effectively even when they are not online at the same time.</descrip></descripGrp><ntig><termGrp><term id="3193169">coauthoring</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="3193177">সহ-সৃষ্টিকৰণ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20803_747620_1945941"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process by which multiple authors edit a shared document simultaneously, or collaborate effectively even when they are not online at the same time.</descrip></descripGrp><ntig><termGrp><term id="747620">co-authoring</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1945941">সহ-সৃষ্টিকৰণ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20803_747620_3193177"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process by which multiple authors edit a shared document simultaneously, or collaborate effectively even when they are not online at the same time.</descrip></descripGrp><ntig><termGrp><term id="747620">co-authoring</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="3193177">সহ-সৃষ্টিকৰণ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20805_1043088_1425298"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A client-side cache for documents that are stored on Web servers. Documents are seamlessly replicated from this local cache, and uploaded to servers as required, enabling faster and more robust file access.</descrip></descripGrp><ntig><termGrp><term id="1043088">Office Document Cache</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1425298">Office নথিপত্ৰ কেশ্ব</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20805_747622_1425298"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A client-side cache for documents that are stored on Web servers. Documents are seamlessly replicated from this local cache, and uploaded to servers as required, enabling faster and more robust file access.</descrip></descripGrp><ntig><termGrp><term id="747622">Microsoft Office Document Cache</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1425298">Office নথিপত্ৰ কেশ্ব</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2081_30138_1256895"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To modify the value of a property or attribute.</descrip></descripGrp><ntig><termGrp><term id="30138">change</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1256895">পৰিৱৰ্তন কৰক</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2081_30138_1401771"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To modify the value of a property or attribute.</descrip></descripGrp><ntig><termGrp><term id="30138">change</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1401771">পৰিবৰ্তন কৰক</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20839_747785_1257142"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that provides access to gallery of frequently-used actions with the touch of a button. Users can customize the gallery to execute a combination of operations in one click.</descrip></descripGrp><ntig><termGrp><term id="747785">Quick Steps</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1257142">দ্ৰুত পদক্ষেপ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20840_747989_1425299"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A frame that contains text, shapes, pictures, or other content. A slide is a digital equivalent to a traditional film slide.</descrip></descripGrp><ntig><termGrp><term id="747989">slide</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1425299">শ্লাইড</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20843_748066_2496987"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Windows tool used to capture a screen shot, or snip, of any object on the screen, and then annotate, save, or share the image.</descrip></descripGrp><ntig><termGrp><term id="748066">Snipping Tool</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="2496987">স্নিপিং টুল</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20848_748169_1257143"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To mark an email conversation so that all current and future messages in the conversation are automatically moved to the Deleted Items folder.</descrip></descripGrp><ntig><termGrp><term id="748169">ignore</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1257143">প্ৰত্যাখ্যান কৰক</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20849_748170_1401819"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A special control that shows pictures, names and titles of people who are attending a meeting, or who are the recipients of an email message.</descrip></descripGrp><ntig><termGrp><term id="748170">Attendee/Recipient List</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1401819">উপস্থিত/প্ৰাপ্তকৰ্তা সূচী</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20851_1140414_2818358"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of people who can answer calls on behalf of someone else.</descrip></descripGrp><ntig><termGrp><term id="1140414">team-call group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="2818358">টীম-কল গোট</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20852_748234_2953860"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A call to a call group that rings the group owner and call group simultaneously. When a member of the group answers the call, the other members get a notification with the status of the call.</descrip></descripGrp><ntig><termGrp><term id="748234">group call</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="2953860">গোট কল</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20854_748237_1852920"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user's work day hours as specified in Microsoft Office Outlook by the day of the week and the start and end times.</descrip></descripGrp><ntig><termGrp><term id="748237">working hours</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1852920">কাম কৰাৰ সময়</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20855_748246_2926834"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To create an indication that the user has an incoming call.</descrip></descripGrp><ntig><termGrp><term id="748246">ring</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="2926834">ৰিং কৰক</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20857_1172884_1853040"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An auto-reply text specified using Outlook's Automatic Replies or Out of Office Assistant.</descrip></descripGrp><ntig><termGrp><term id="1172884">automatic reply</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1853040">স্বয়ংক্ৰিয় প্ৰত্যুত্তৰ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20857_1172884_2595