lected</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="2555513">শান্ত</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45192_2550388_2555500"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The text overlay style in Story Remix, with white outlined, transparent lettering that looks modern, linear, and authentic.</descrip></descripGrp><ntig><termGrp><term id="2550388">Downtown</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="2555500">ডাউনটাউন</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45210_2551936_2555577"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that allows customers to store their users’ Office 365 data in specific Office 365 geographical locations to fulfill regulatory data residency requirements.</descrip></descripGrp><ntig><termGrp><term id="2551936">Multi-Geo Capabilities</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="2555577">Multi-Geo Capabilities</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45210_2551936_2665960