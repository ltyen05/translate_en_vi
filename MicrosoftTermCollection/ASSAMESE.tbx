, and communicating data.</descrip></descripGrp><ntig><termGrp><term id="2137650">Microsoft Excel</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="2674960">Microsoft Excel</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37344_2121838_2674576"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft word processing software for creating Web, email, and print documents.</descrip></descripGrp><ntig><termGrp><term id="2121838">Microsoft Word</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="2674576">Microsoft Word</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37344_2121838_3104413"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft word processing software for creating Web, email, and print documents.</descrip></descripGrp><ntig><termGrp><term id="2121838">Microsoft Word</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="3104413">Word</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termG