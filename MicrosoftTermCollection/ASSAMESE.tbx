tion customers.</descrip></descripGrp><ntig><termGrp><term id="2997864">Windows 11 Education</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="2998015">Windows 11 Education</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52779_2997865_2998071"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The edition of Windows 11 that is based on Windows 11 Pro and optimized for Education customers and can be pre-installed on EDU devices.</descrip></descripGrp><ntig><termGrp><term id="2997865">Windows 11 Pro Education</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="2998071">Windows 11 Pro Education</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52780_2997866_2998067"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The edition of Windows 11 targeting enterprise customers.</descrip></descripGrp><ntig><termGrp><term id="2997866">Windows 11 Enterprise</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="2998067">Windows 11 Enterprise</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote 