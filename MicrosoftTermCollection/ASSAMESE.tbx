rip type="definition">The unique, 25-character code on a prepaid card that adds computer use time to your prepaid computer or that pays for your subscription.</descrip></descripGrp><ntig><termGrp><term id="214131">prepaid card code</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1931342">ট'কেন</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1310_214131_2351959"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The unique, 25-character code on a prepaid card that adds computer use time to your prepaid computer or that pays for your subscription.</descrip></descripGrp><ntig><termGrp><term id="214131">prepaid card code</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="2351959">টোকেন</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13121_359689_1945967"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A OneNote item that has been marked with a note tag.</descrip></descripGrp><ntig><termGrp><term id="359689">tagged note</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1945967">টেগড টোকা</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected<