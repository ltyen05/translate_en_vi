 shows.</descrip></descripGrp><ntig><termGrp><term id="2254379">Movies &amp; TV</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="2255799">চলচিত্ৰ আৰু টিভি</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38705_2254398_3004296"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The unified, component-based software architecture model that provides a large and highly consistent set of APIs across multiple Windows 10-based device families.</descrip></descripGrp><ntig><termGrp><term id="2254398">OneCore</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="3004296">Windows OneCore</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38705_2254398_3004341"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The unified, component-based software architecture model that provides a large and highly consistent set of APIs across multiple Windows 10-based device families.</descrip></descripGrp><ntig><termGrp><term id="2254398">OneCore</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="3004341">OneCore</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><