2"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In a public key infrastructure hierarchy, the certification authority that that issues certificates to users and computers.</descrip></descripGrp><ntig><termGrp><term id="1516657">issuing certification authority</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1642372">প্ৰমাণপত্র প্ৰদানকাৰী অধিকাৰী</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="30513_1516658_1642370"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In a public key infrastructure hierarchy, the certification authority that that issues certificates to users and computers.</descrip></descripGrp><ntig><termGrp><term id="1516658">issuing CA</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1642370">প্ৰমাণপত্র প্ৰদানকাৰী CA</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="30513_1516658_1642372"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In a public key infrastructure hierarchy, the certification authority that that issues certificates to users and computers.</descrip></descripGrp><ntig><termGrp><term id="1516658">issuing CA</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1642372">প্ৰমাণপত্র প্ৰদানকাৰী অধিকাৰী</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="30517_1516667_1643548"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A configuration mode for the Certificate Enrollment Web Service in which it will only process renewal requests.</descrip></descripGrp><ntig><termGrp><term id="1516667">renewal only mode</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1643548">নৱীকৰণ মাত্ৰ ধৰণ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="30520_1516672_1644414"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A hexadecimal string that contains the SHA-1 hash of the certificate.</descrip></descripGrp><ntig><termGrp><term id="1516672">thumbprint</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1644414">ঠাম্বপ্ৰিণ্ট</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="30553_1517506_1694103"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Server Manager and Event Viewer, the urgency of an event or error condition, system fault, failure, or action by either the system or the user. Severity can be any of four industry-standard values: Information, Warning, Error, or Critical. These values are defined in the Event Viewer Help.</descrip></descripGrp><ntig><termGrp><term id="1517506">severity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1694103">গম্ভীৰতা</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3056_1738272_432023"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A computer that acts as a source of information or signals. The host computer provides services, such as news, mail, or data, to computers that connect to it. The term can refer to almost any kind of computer, from a centralized mainframe that is a host to its terminals, to a server that is host to its clients, to a desktop PC that is host to its devices, such as printers and scanners.</descrip></descripGrp><ntig><termGrp><term id="1738272">host computer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="432023">আয়োজক</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3056_1770_432023"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A computer that acts as a source of information or signals. The host computer provides services, such as news, mail, or data, to computers that connect to it. The term can refer to almost any kind of computer, from a centralized mainframe that is a host to its terminals, to a server that is host to its clients, to a desktop PC that is host to its devices, such as printers and scanners.</descrip></descripGrp><ntig><termGrp><term id="1770">host</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="432023">আয়োজক</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3058_71776_432551"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A pointing device used mainly but not exclusively for computer games. A joystick has a base, on which control buttons can be mounted, and a vertical stem, which the user can move in any direction to control the movement of an object on the screen.</descrip></descripGrp><ntig><termGrp><term id="71776">joystick</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="432551">জয়ষ্টিক</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="30589_1517629_1642278"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process that builds one or more certificate paths. The certificate paths may or may not trace up to a self-signed or root certificate.</descrip></descripGrp><ntig><termGrp><term id="1517629">certificate chaining</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1642278">প্ৰমাণপত্ৰ শৃংখলকৰণ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="30590_1517630_1642129"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A certificate extension used by the certificate chaining engine to determine what certificate was used to sign a presented certificate. The AKI can contain the issuer name, serial number, public key information, or no information at all. By matching the information in a certificate’s AKI extension to a CA certificate’s Subject Key Identifier (SKI) extension, a certificate chain can be built.</descrip></descripGrp><ntig><termGrp><term id="1517630">Authority Key Identifier</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1642129">AKI</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="30590_1517630_1642195"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A certificate extension used by the certificate chaining engine to determine what certificate was used to sign a presented certificate. The AKI can contain the issuer name, serial number, public key information, or no information at all. By matching the information in a certificate’s AKI extension to a CA certificate’s Subject Key Identifier (SKI) extension, a certificate chain can be built.</descrip></descripGrp><ntig><termGrp><term id="1517630">Authority Key Identifier</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1642195">অথৰিটি কী আইডেন্টিফায়াৰ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="30590_1517631_1642129"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A certificate extension used by the certificate chaining engine to determine what certificate was used to sign a presented certificate. The AKI can contain the issuer name, serial number, public key information, or no information at all. By matching the information in a certificate’s AKI extension to a CA certificate’s Subject Key Identifier (SKI) extension, a certificate chain can be built.</descrip></descripGrp><ntig><termGrp><term id="1517631">AKI</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1642129">AKI</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="30590_1517631_1642195"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A certificate extension used by the certificate chaining engine to determine what certificate was used to sign a presented certificate. The AKI can contain the issuer name, serial number, public key information, or no information at all. By matching the information in a certificate’s AKI extension to a CA certificate’s Subject Key Identifier (SKI) extension, a certificate chain can be built.</descrip></descripGrp><ntig><termGrp><term id="1517631">AKI</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1642195">অথৰিটি কী আইডেন্টিফায়াৰ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3060_87569_432678"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In reference to one or more computers, connected to a network.</descrip></descripGrp><ntig><termGrp><term id="87569">online</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="432678">অনলাইন</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3061_147916_1852685"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mark that shows where a deletion, insertion, or other editing change has been made in a document.</descrip></descripGrp><ntig><termGrp><term id="147916">revision mark</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1852685">পুনৰীক্ষণ চিহ্ন</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3065_142836_433016"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A program that transforms a picture stored in one file format to another format so that it can be displayed in a specific graphics program.</descrip></descripGrp><ntig><termGrp><term id="142836">graphic filter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="433016">গ্ৰাফিক ফিল্টাৰ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3065_142836_433017"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A program that transforms a picture stored in one file format to another format so that it can be displayed in a specific graphics program.</descrip></descripGrp><ntig><termGrp><term id="142836">graphic filter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="433017">গ্ৰাফিকছ ফিল্টাৰ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3065_142837_433016"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A program that transforms a picture stored in one file format to another format so that it can be displayed in a specific graphics program.</descrip></descripGrp><ntig><termGrp><term id="142837">graphics filter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="433016">গ্ৰাফিক ফিল্টাৰ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3065_142837_433017"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A program that transforms a picture stored in one file format to another format so that it can be displayed in a specific graphics program.</descrip></descripGrp><ntig><termGrp><term id="142837">graphics filter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="433017">গ্ৰাফিকছ ফিল্টাৰ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3068_79974_2741588"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A flag that marks a message for follow up or with a request for someone else.</descrip></descripGrp><ntig><termGrp><term id="79974">message flag</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="2741588">বাৰ্তা ফ্লেগ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3069_44932_432362"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The location (drive, folder, or directory) to which a file is copied or moved.</descrip></descripGrp><ntig><termGrp><term id="44932">destination</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="432362">গন্তব্য স্থান</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="308_475234_2488910"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user who is responsible for a particular record in the system and is frequently allowed to perform actions on the record that other users cannot.</descrip></descripGrp><ntig><termGrp><term id="475234">owner</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="2488910">গৰাকী</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3084_77397_432605"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A location where email is delivered.</descrip></descripGrp><ntig><termGrp><term id="77397">mailbox</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="432605">মেইল বাকচ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="30861_1555644_2774031"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A customer's agreement that provides access to services and where pricing and related terms are governed by the offer chosen for the subscription.</descrip></descripGrp><ntig><termGrp><term id="1555644">subscription</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="2774031">গ্ৰাহকভুক্তি</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3087_178259_2741589"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The mobile, larger form-factor computing device small enough to fit in a coat pocket that uses the Microsoft Windows CE or Windows Mobile operating system.</descrip></descripGrp><ntig><termGrp><term id="178259">Pocket PC</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="2741589">পকেট PC</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="30900_1567772_1853130"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To track content, people, or entities by adding them to a list of things for which you would like to surface updates about changes and activities.</descrip></descripGrp><ntig><termGrp><term id="1567772">follow</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1853130">অনুসৰণ কৰক</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="30961_1579321_1588694"><langSet xml:lang="en-US"><descripGrp><descrip type="definiti