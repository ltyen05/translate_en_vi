</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51095_2884687_2884774"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An unpatched software vulnerability that is unknown to, or unaddressed by, the software's vendor that can be exploited to attack the computer system or network.</descrip></descripGrp><ntig><termGrp><term id="2884687">0-day</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="2884774">শূণ্য-দিন</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51096_2884688_2884776"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Descriptive of any content or feature available to a customer who upgrades from a free service to a paid service, as part of that larger offering.</descrip></descripGrp><ntig><termGrp><term id="2884688">premium</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="2884776">প্ৰিমিয়াম</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51104_2884921_2884985"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The collection of background images for the Windows lock screen and/or the Windows desktop, with hotspots overlaying linking to inf