culating natural logarithms.</descrip></descripGrp><ntig><termGrp><term id="76437">logarithm</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="2997942">ঘাতাংক</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53031_3014789_3059247"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Azure offering that supports Azure Virtual Desktop on Azure Stack HCI.</descrip></descripGrp><ntig><termGrp><term id="3014789">Azure Virtual Desktop on Azure Stack HCI</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="3059247">Azure Stack HCI-ত Azure Virtual Desktop</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53031_3014789_3059250"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Azure offering that supports Azure Virtual Desktop on Azure Stack HCI.</descrip></descripGrp><ntig><termGrp><term id="3014789">Azure Virtual Desktop on Azure Stack HCI</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="3059250">Virtual Desktop on Azure Stack HCI</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote ty