try><termEntry id="1700_122674_1425203"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of viewing and updating the actual progress of tasks so that you can see progress across time, evaluate slippage of tasks, compare scheduled or baseline data to actual data, and check the completion percentage of tasks and your project.</descrip></descripGrp><ntig><termGrp><term id="122674">tracking</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1425203">ট্ৰেকিং</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1701_130254_1804392"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The programming language designed at Microsoft that was derived from BASIC and that was designed to enable the easy development of visual applications and components in Windows.</descrip></descripGrp><ntig><termGrp><term id="130254">Visual Basic</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1804392">Visual Basic</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1701_370712_1804392"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The programming language designed at Microsoft that was derived from BASIC and that was designed to enable the easy development of visual applications and components in Windows.</descrip></descripGrp><ntig><termG