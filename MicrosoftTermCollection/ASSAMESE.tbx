78">সূচীসমূহ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52155_2948053_2948579"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft 365 app that lets users create and share lists that help them track issues, assets, routines, contacts, inventory, and more.</descrip></descripGrp><ntig><termGrp><term id="2948053">Lists</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="2948579">Microsoft সূচীসমূহ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52158_2949266_2949515"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The paid offering of Education Insights.</descrip></descripGrp><ntig><termGrp><term id="2949266">Education Insights Premium</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="2949515">শিক্ষাৰ Insights Premium</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52159_2949267_3006067"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A social network run by the Microsoft News people, enabling users to comment on Microsoft news articles, like and respond to other users' comments, and