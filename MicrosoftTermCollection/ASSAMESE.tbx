><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21005_763871_1401827"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout type that includes layouts designed to show a continual process.</descrip></descripGrp><ntig><termGrp><term id="763871">Cycle</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1401827">চক্ৰ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21006_763872_1906347"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout type that includes layouts designed to show a hierarchical structure, such as an organization chart, or a decision tree.</descrip></descripGrp><ntig><termGrp><term id="763872">Hierarchy</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1906347">পদানুক্ৰম</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21007_763873_1852923"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout type that includes layouts designed to illustrate connections.</descrip></descripGrp><ntig><termGrp><term id="763873">Relationship</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1852923">সম্পৰ্ক</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21008_763874_1257166"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout type that includes layouts designed to show how parts relate to a whole.</descrip></descripGrp><ntig><termGrp><term id="763874">Matrix</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1257166">মেট্ৰিক্স</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21009_763875_1852924"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout type that includes layouts designed to show proportional relationships with the largest component on the top or bottom.</descrip></descripGrp><ntig><termGrp><term id="763875">Pyramid</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1852924">পিৰামিড</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21010_763876_3074428"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The overall design of a page or content set, including text elements, controls, and graphics.</descrip></descripGrp><ntig><termGrp><term id="763876">layout</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="3074428">লেআউট</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21012_1135481_1519022"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The descriptive information about a user that is shown to other users. This editable information is separate from the registration information they provide to establish their Windows Live account. This separation allows users to disclose or conceal personal information as they choose.</descrip></descripGrp><ntig><termGrp><term id="1135481">Windows Live Profile</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1519022">প্ৰ’ফাইল</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21012_763878_1519022"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The descriptive information about a user that is shown to other users. This editable information is separate from the registration information they provide to establish their Windows Live account. This separation allows users to disclose or conceal personal information as they choose.</descrip></descripGrp><ntig><termGrp><term id="763878">profile</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1519022">প্ৰ’ফাইল</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21015_2392175_3104559"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An email address to which password reset information can be sent if a customer forgets the password portion of their Microsoft account.</descrip></descripGrp><ntig><termGrp><term id="2392175">alternate email address</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="3104559">বিকল্প ইমেইল</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21015_3103949_3104559"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An email address to which password reset information can be sent if a customer forgets the password portion of their Microsoft account.</descrip></descripGrp><ntig><termGrp><term id="3103949">alternate email</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="3104559">বিকল্প ইমেইল</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2103_234511_433331"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A name-value pair, separated by an equal sign and included in a tagged element, that modifies features of an element. All XML attribute values are strings enclosed in quotation marks.</descrip></descripGrp><ntig><termGrp><term id="234511">XML attribute</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="433331">XML গুণাগুণ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2104_269344_433550"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An encryption algorithm system included as part of the 802.11 standard, developed by the Institute of Electrical and Electronics Engineers as a security measure to protect wireless LANs from casual eavesdropping. WEP uses a shared secret key to encrypt packets before transmission between wireless LAN devices and monitors packets in transit to detect attempts at modification. WEP offers both 40-bit and 128-bit hardware-based encryption options.</descrip></descripGrp><ntig><termGrp><term id="269344">Wired Equivalent Privacy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="433550">তাঁৰযুক্ত সমতুলীয় গোপনীয়তা</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2104_269344_433551"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An encryption algorithm system included as part of the 802.11 standard, developed by the Institute of Electrical and Electronics Engineers as a security measure to protect wireless LANs from casual eavesdropping. WEP uses a shared secret key to encrypt packets before transmission between wireless LAN devices and monitors packets in transit to detect attempts at modification. WEP offers both 40-bit and 128-bit hardware-based encryption options.</descrip></descripGrp><ntig><termGrp><term id="269344">Wired Equivalent Privacy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="433551">WEP</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2104_269345_433550"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An encryption algorithm system included as part of the 802.11 standard, developed by the Institute of Electrical and Electronics Engineers as a security measure to protect wireless LANs from casual eavesdropping. WEP uses a shared secret key to encrypt packets before transmission between wireless LAN devices and monitors packets in transit to detect attempts at modification. WEP offers both 40-bit and 128-bit hardware-based encryption options.</descrip></descripGrp><ntig><termGrp><term id="269345">WEP</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="433550">তাঁৰযুক্ত সমতুলীয় গোপনীয়তা</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2104_269345_433551"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An encryption algorithm system included as part of the 802.11 standard, developed by the Institute of Electrical and Electronics Engineers as a security measure to protect wireless LANs from casual eavesdropping. WEP uses a shared secret key to encrypt packets before transmission between wireless LAN devices and monitors packets in transit to detect attempts at modification. WEP offers both 40-bit and 128-bit hardware-based encryption options.</descrip></descripGrp><ntig><termGrp><term id="269345">WEP</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="433551">WEP</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2105_545690_1852823"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A view that shows text formatting and a simplified page layout.</descrip></descripGrp><ntig><termGrp><term id="545690">draft view</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1852823">খচৰা দৰ্শন</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21053_766415_1257167"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A disk image provided for use in repairing or reinstalling an installation of Windows.</descrip></descripGrp><ntig><termGrp><term id="766415">recovery image</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1257167">পুনৰুদ্ধাৰ প্ৰতিচ্ছবি</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21089_766591_1257168"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A recognition feature that helps increase input speed and reduce effort by providing users with word completion and next word prediction alternates as the user is writing/typing.</descrip></descripGrp><ntig><termGrp><term id="766591">text prediction</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1257168">পাঠ ভৱিষ্যৎ-বাণী</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21089_766591_1401828"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A recognition feature that helps increase input speed and reduce effort by providing users with word completion and next word prediction alternates as the user is writing/typing.</descrip></descripGrp><ntig><termGrp><term id="766591">text prediction</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1401828">পাঠ পূৰ্বাভাস</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</ter