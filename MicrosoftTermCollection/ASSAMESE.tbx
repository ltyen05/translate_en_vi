<termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3633_44143_432354"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In some dialog boxes, the command button that is selected or highlighted when the dialog box is initially displayed. The default button has a bold border, indicating that it will be chosen automatically if you press ENTER. You can override a default button by clicking Cancel or another command button.</descrip></descripGrp><ntig><termGrp><term id="44143">default button</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="432354">ডিফ'ল্ট বুটাম</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3634_27320_1258444"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To revoke an action by quitting it without saving any changes that it would result in.</descrip></descripGrp><ntig><termGrp><term id="27320">cancel</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1258444">বাতিল কৰক</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3638_53737_432446"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An area in a window or record that stores a single data value.</descrip></descripGrp><ntig><termGrp><term id="53737">field</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="432446">ফিল্ড</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3643_323598_433877"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tool in Windows Vista that backs up the entire computer (OS, settings, and files).</descrip></descripGrp><ntig><termGrp><term id="323598">Complete PC Backup</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="433877">সম্পূর্ণ-PC বেকআপ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3644_116003_432824"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A statistical measure of the amount by which a set of values differs from the arithmetical mean, equal to the square root of the mean of the differences' squares.</descrip></descripGrp><ntig><termGrp><term id="116003">standard deviation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="432824">মান্য বিচ্যুতি</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3655_85228_432660"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A hyphen that is used to prevent a hyphenated word, number, or phrase from breaking if it falls at the end of a line.</descrip></descripGrp><ntig><termGrp><term id="85228">nonbreaking hyphen</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="432660">অবিৰত হাইফেন</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3657_16207_2773994"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A characteristic of an object.</descrip></descripGrp><ntig><termGrp><term id="16207">attribute</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="2773994">গুণাগুণ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3659_319140_433817"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ( character.</descrip></descripGrp><ntig><termGrp><term id="319140">opening parenthesis</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="433817">চন্দ্রবন্ধনী আৰম্ভ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3662_77222_432603"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that makes the screen more readable by people who have low vision by creating a separate window that displays a magnified portion of the screen.</descrip></descripGrp><ntig><termGrp><term id="77222">Magnifier</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="432603">পৰিবৰ্দ্ধক</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36805_2072311_2124378"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that unifies components across applications, such as people, conversations, calendars, emails, and files, to create a seamless collaboration experience. Creating a group anywhere in Microsoft 365 will automatically provision a corresponding Yammer conversation feed, an Outlook inbox and calendar, and a SharePoint document library for every Group member. Groups make these components persistent across applications, so that changes made to components in part of Microsoft 365 will carry through to the others, thus enabling a unified experience.</descrip></descripGrp><ntig><termGrp><term id="2072311">Groups</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="2124378">গোটসমূহ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36805_2072311_2382847"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that unifies components across applications, such as people, conversations, calendars, emails, and files, to create a seamless collaboration experience. Creating a group anywhere in Microsoft 365 will automatically provision a corresponding Yammer conversation feed, an Outlook inbox and calendar, and a SharePoint document library for every Group member. Groups make these components persistent across applications, so that changes made to components in part of Microsoft 365 will carry through to the others, thus enabling a unified experience.</descrip></descripGrp><ntig><termGrp><term id="2072311">Groups</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="2382847">Office 365 গোট</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36805_2072311_2878983"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that unifies components across applications, such as people, conversations, calendars, emails, and files, to create a seamless collaboration experience. Creating a group anywhere in Microsoft 365 will automatically provision a corresponding Yammer conversation feed, an Outlook inbox and calendar, and a SharePoint document library for every Group member. Groups make these components persistent across applications, so that changes made to components in part of Microsoft 365 will carry through to the others, thus enabling a unified experience.</descrip></descripGrp><ntig><termGrp><term id="2072311">Groups</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="gram