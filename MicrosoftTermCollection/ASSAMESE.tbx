ouble mouse click, with or without a modifier key, that can be used to perform a task.</descrip></descripGrp><ntig><termGrp><term id="81864">mouse shortcut</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="432639">মাউচ চমুপথ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12666_50449_1852557"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The state of an uninitialized Variant variable (which returns a VarType of 0).</descrip></descripGrp><ntig><termGrp><term id="50449">empty</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1852557">খালী</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1267_314102_432333"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Shading made up of regularly spaced, intersecting lines.</descrip></descripGrp><ntig><termGrp><term id="314102">hatch</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="432333">ক্ৰছ হেটছ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1267_31410