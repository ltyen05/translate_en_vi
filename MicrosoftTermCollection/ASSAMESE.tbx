hen requested and remains open without further action until the user closes it or chooses a menu item.</descrip></descripGrp><ntig><termGrp><term id="2767716">pulldown menu</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="432412">ড্ৰপ-ডাউন মেনু</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45_2767717_432412"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A menu that drops from the menu bar when requested and remains open without further action until the user closes it or chooses a menu item.</descrip></descripGrp><ntig><termGrp><term id="2767717">pull-down menu</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="432412">ড্ৰপ-ডাউন মেনু</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45_48540_432412"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A menu that drops from the menu bar when requested and remains open without further action until the user closes it or chooses a menu item.</descrip></descripGrp><ntig><termGrp><term id="48540">drop-down menu</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="432412">ড্ৰপ-ডাউন মেনু</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">No