><descrip type="definition">A number that identifies each telephone service area in a country/region and is used as a dialing prefix.</descrip></descripGrp><ntig><termGrp><term id="14395">area code</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="432130">ক্ষেত্ৰ ক'ড</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13701_88326_1258501"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To configure a device or application so that it performs better. For example, to fine-tune a program so that it runs more quickly or takes up less space.</descrip></descripGrp><ntig><termGrp><term id="88326">optimize</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1258501">সৰ্বোৎকৃষ্ট কৰক</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1371_141114_1425201"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Properties, such as title, subject, and author, that are stored with each data access page.</descrip></descripGrp><ntig><termGrp><term id="141114">document properties</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1425201">নথিপত্ৰ ধৰ্মসমূহ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><t