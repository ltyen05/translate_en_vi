r">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="432587">ৰেখা</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16907_627846_1425264"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The date when a project or task is scheduled to begin.</descrip></descripGrp><ntig><termGrp><term id="627846">begin date</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1425264">আৰম্ভণি তাৰিখ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16907_627847_1425264"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The date when a project or task is scheduled to begin.</descrip></descripGrp><ntig><termGrp><term id="627847">start date</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1425264">আৰম্ভণি তাৰিখ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16927_629486_3057387"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user-defined description of a particular device.</descrip></descripGrp><ntig><termGrp><term id="629486">device name</term><termNote type="partOfSpeech">Noun</termNote><termNo