em restrict what their children see.</descrip></descripGrp><ntig><termGrp><term id="346958">parental controls</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1258496">অভিভাৱক নিয়ন্ত্ৰনসমূহ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13028_334517_2063721"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Combined earphone and microphone set that enables hands-free communication.</descrip></descripGrp><ntig><termGrp><term id="334517">headset</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="2063721">হেডছেট</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13038_232525_1852760"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The slide text on the slide master. The master text determines the format of text on all slides as well as the shape of text placeholders and their placement on slides.</descrip></descripGrp><ntig><termGrp><term id="232525">master text</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1852760">মাষ্টাৰ পাঠ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote>