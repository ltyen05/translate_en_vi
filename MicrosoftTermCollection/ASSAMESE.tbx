D</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42859_2430605_2433591"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ribbon button that inverts the colors of the text and background of an application.</descrip></descripGrp><ntig><termGrp><term id="2430605">Night mode</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="2433591">নৈশ মোড</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42862_2430759_2432585"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The button that allows users to change text size for an entire document.</descrip></descripGrp><ntig><termGrp><term id="2430759">text size</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="2432585">পাঠৰ আকাৰ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42863_2430760_2432586"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows users to change letter, word, line, and column spacing to reduce visual crowding.</descrip></descripGrp><ntig><termGrp><term id="2430760">text spacing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</t