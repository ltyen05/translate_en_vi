y field</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1852861">বৰ্গ ফিল্ড</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17800_650160_1852862"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A way to see if a certificate used to sign a message is valid. Outlook can check the status of the certificate from the issuing certification authority's database.</descrip></descripGrp><ntig><termGrp><term id="650160">certificate revocation checking</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1852862">প্ৰমাণপত্ৰ বাতিল বিষয়ক পৰীক্ষণ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17811_650171_1852863"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Visual Basic for Applications, the window that is used to display, edit, and write module-level and procedure code.</descrip></descripGrp><ntig><termGrp><term id="650171">code pane</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1852863">ক'ড ফলক</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17814_650174_1852864"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A keyword or phrase with an associated color that helps you keep track of items, such as messages, contacts, and appointments. You can use color categories to easily find, sort, filter, or group items.</descrip></descripGrp><ntig><termGrp><term id="650174">color category</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1852864">ৰং বৰ্গ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17815_650175_1852865"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The part of PivotTable view that contains column fields.</descrip></descripGrp><ntig><termGrp><term id="650175">column area</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="1852865">স্তম্ভ ক্ষেত্ৰ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17816_1507691_1257078"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A supplemental program with the filename extension .dll or .exe that extends the capabilities of a program by adding custom commands and specialized features.</descrip></descripGrp><ntig><termGrp><term id="1507691">Component Object Model add-in</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig>