.</descrip></descripGrp><ntig><termGrp><term id="2955571">DATEVALUE</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="2959465">DATEVALUE</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5236_155717_2015584"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To decompress, or pull out, files from a compressed form. When you extract a file, an uncompressed copy of the file is placed in the folder you specify. The original file remains in the compressed folder. Compressed files frequently have a .zip file name extension.</descrip></descripGrp><ntig><termGrp><term id="155717">extract</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="2015584">এক্সট্ৰেক্ট কৰক</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52360_2955572_2959466"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Database Excel function that returns the average of selected database entries.</descrip></descripGrp><ntig><termGrp><term id="2955572">DAVERAGE</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="as-IN"><ntig><termGrp><term id="2959466">DAVERAGE</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><