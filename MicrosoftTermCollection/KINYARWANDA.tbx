rtOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11186_59131_504447"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The electronic components that generate the video signal sent through a cable to a video display. The video adapter is usually located on the computer's main system board or on an expansion board, but it is sometimes built into the terminal.</descrip></descripGrp><ntig><termGrp><term id="59131">video card</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="504447">karita videwo</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11186_59134_1688410"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The electronic components that generate the video signal sent through a cable to a video display. The video adapter is usually located on the computer's main system board or on an expansion board, but it is sometimes built into the terminal.</descrip></descripGrp><ntig><termGrp><term id="59134">display adapter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1688410">adabutateri igaragaza</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11186_59134_504447"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The electronic components that generate the video signal sent through a cable to a video display. The video adapter is usually located on the computer's main system board or on an expansion board, but it is sometimes built into the terminal.</descrip></descripGrp><ntig><termGrp><term id="59134">display adapter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="504447">karita videwo</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11191_173848_1910024"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A unit of information transmitted as a whole from one device to another on a network.</descrip></descripGrp><ntig><termGrp><term id="173848">data packet</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1910024">ipaki y'amakurushingiro</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11192_4042_1909822"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Code that is executed by the common language runtime environment rather than directly by the operating system. Managed code applications gain common language runtime services such as automatic garbage collection, runtime type checking and security support, and so on. These services help provide uniform platform- and language-independent behavior of managed-code applications.</descrip></descripGrp><ntig><termGrp><term id="4042">managed code</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1909822">kode icungwa</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11192_4043_1909822"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Code that is executed by the common language runtime environment rather than directly by the operating system. Managed code applications gain common language runtime services such as automatic garbage collection, runtime type checking and security support, and so on. These services help provide uniform platform- and language-independent behavior of managed-code applications.</descrip></descripGrp><ntig><termGrp><term id="4043">safe code</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1909822">kode icungwa</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="112_93994_1696431"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The logon name (and therefore the email address) of an account that is responsible for maintaining email services on a mail server. When an account holder is having trouble with email, a message to postmaster or "postmaster@machine.org.domain.name" will usually reach a human who can solve the problem.</descrip></descripGrp><ntig><termGrp><term id="93994">postmaster</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1696431">postmaster</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11201_235266_2588350"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A quantitative measure of performance that is used to compare the company's products, services, or processes to an external standard. Competitive benchmarks are based on industry best, and process benchmarks are based on best in class.</descrip></descripGrp><ntig><termGrp><term id="235266">benchmark</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="2588350">igipimo fatizo</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11208_102176_504733"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Part of the integrated Routing and Remote Access service that provides remote networking for telecommuters, mobile workers, and system administrators who monitor and manage servers at multiple branch offices. Users can use Network Connections to dial in to remotely access their networks for services such as file and printer sharing, electronic mail, scheduling, and SQL database access.</descrip></descripGrp><ntig><termGrp><term id="102176">remote access</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="504733">ukugerwaho kwitaruye</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11216_564516_1597617"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method of real-time communication over the Internet in which a sender types a message to one or more recipients and the recipient immediately receives the message in a chat area.</descrip></descripGrp><ntig><termGrp><term id="564516">instant messaging</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1597617">IM</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11216_564516_2062426"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method of real-time communication over the Internet in which a sender types a message to one or more recipients and the recipient immediately receives the message in a chat area.</descrip></descripGrp><ntig><termGrp><term id="564516">instant messaging</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="2062426">itumanaho ry’ako kanya</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11216_564517_1597617"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method of real-time communication over the Internet in which a sender types a message to one or more recipients and the recipient immediately receives the message in a chat area.</descrip></descripGrp><ntig><termGrp><term id="564517">IM</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1597617">IM</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11216_564517_2062426"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method of real-time communication over the Internet in which a sender types a message to one or more recipients and the recipient immediately receives the message in a chat area.</descrip></descripGrp><ntig><termGrp><term id="564517">IM</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="2062426">itumanaho ry’ako kanya</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11218_184819_505159"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A connection between the user's device and a server that provides access to the Internet, typically through an Internet service provider.</descrip></descripGrp><ntig><termGrp><term id="184819">Internet connection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="505159">kwinjira kuri