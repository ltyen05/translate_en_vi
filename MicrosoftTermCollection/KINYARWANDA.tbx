</langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1910206">urugero rw'ibifunze</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1682_114990_1909878"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An array (arrangement of items) in which many of the entries are identical, commonly zero. It is not possible to define precisely when an array is sparse, but it is clear that at some point, usually when about one-third of the array consists of identical entries, it becomes worthwhile to redefine the array.</descrip></descripGrp><ntig><termGrp><term id="114990">sparse array</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1909878">umwanya w'ibisa</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1686_90627_1562869"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A distinct chunk of text that is indicated by formatting such as indentation, numbering, or a new line.</descrip></descripGrp><ntig><termGrp><term id="90627">paragraph</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1562869">igika</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1688_74871_504555"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In word processing, a string of characters displayed or printed in a single horizontal row.</descrip></descripGrp><ntig><termGrp><term id="74871">line</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="504555">umurongo</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16907_627846_1576474"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The date when a project or task is scheduled to begin.</descrip></descripGrp><ntig><termGrp><term id="627846">begin date</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1576474">itariki y'itangira</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16907_627847_1576474"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The date when a project or task is scheduled to begin.</descrip></descripGrp><ntig><termGrp><term id="627847">start date</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1576474">itariki y'itangira</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16963_629993_1954306"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A unique view for displaying appointments, tasks, and other information in the form of a Web page. You can customize the Outlook Today page for your organization, or for individuals or groups within your organization, to display the information most relevant to them.</descrip></descripGrp><ntig><termGrp><term id="629993">Outlook Today</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1954306">Outlook muri iki gihe</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="170_502935_1574270"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A part of the user interface dedicated to a particular purpose, such as "instant message area."</descrip></descripGrp><ntig><termGrp><term id="502935">area</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1574270">akanya</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1700_122674_1576547"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of viewing and updating the actual progress of tasks so that you can see progress across time, evaluate slippage of tasks, compare scheduled or baseline data to actual data, and check the completion percentage 