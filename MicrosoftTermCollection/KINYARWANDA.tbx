rvices but have it appear as if it is running on the user's local computer. Users can run RemoteApp programs side by side with their local programs.</descrip></descripGrp><ntig><termGrp><term id="616469">TS RemoteApp</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1754647">RemoteApp</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1679_1370400_505396"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The W3C standard language used for writing XML schema documents.</descrip></descripGrp><ntig><termGrp><term id="1370400">XSD</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="505396">ishushombonera XML</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1679_1536620_505396"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The W3C standard language used for writing XML schema documents.</descrip></descripGrp><ntig><termGrp><term id="1536620">XML schema definition language</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="505396">ishushombonera XML</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote typ