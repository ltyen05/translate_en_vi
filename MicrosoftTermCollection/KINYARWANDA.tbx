ype="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1910047">ikaramu</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10023_234746_505306"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An option on Windows Parental Control that, if selected, creates logs of all the actions performed by a user on the computer.</descrip></descripGrp><ntig><termGrp><term id="234746">Activity Reporting</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="505306">Imenyekanishabikorwa</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10038_295550_505549"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A personal record of experiences, occurrences or proceedings, like a Baby Book or Life Book.</descrip></descripGrp><ntig><termGrp><term id="295550">journal</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="505549">ikinyamakuru</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10039_56540_504435"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">One of many sequential ima