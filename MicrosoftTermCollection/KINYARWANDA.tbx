collection of networks and gateways that use the TCP/IP suite of protocols to communicate with one another.</descrip></descripGrp><ntig><termGrp><term id="766639">peer-to-peer graph</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1696432">karawudi</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21098_766643_1574338"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The worldwide collection of networks and gateways that use the TCP/IP suite of protocols to communicate with one another.</descrip></descripGrp><ntig><termGrp><term id="766643">mesh</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1574338">Interineti</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21098_766643_1696432"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The worldwide collection of networks and gateways that use the TCP/IP suite of protocols to communicate with one another.</descrip></descripGrp><ntig><termGrp><term id="766643">mesh</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1696432">karawudi</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelecte