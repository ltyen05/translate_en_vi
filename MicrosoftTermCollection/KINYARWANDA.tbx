en-US"><descripGrp><descrip type="definition">To move the camera forward or backwards, to zoom in and out the 3D object.</descrip></descripGrp><ntig><termGrp><term id="2414869">zoom</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="2529594">guhindura ingano</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42643_2415081_2489932"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office 365 app that allows users to submit timesheets and report progress on tasks tracked in Project Online.</descrip></descripGrp><ntig><termGrp><term id="2415081">Office 365 Project Time Reporter</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="2489932">Office 365 Project Time Reporter</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42643_2415081_2489933"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office 365 app that allows users to submit timesheets and report progress on tasks tracked in Project Online.</descrip></descripGrp><ntig><termGrp><term id="2415081">Office 365 Project Time Reporter</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="2489933">Time Reporter</term><termNote type="geographica