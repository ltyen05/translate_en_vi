ipGrp><descrip type="definition">In mathematics, an item that is multiplied in a multiplication problem; for example, 2 and 3 are factors in the problem 2 x 3. The prime factors of a number are a set of prime numbers that, when multiplied together, produce the number.</descrip></descripGrp><ntig><termGrp><term id="1091332">factor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="2818456">umubare</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23875_1091338_1574266"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To combine thereby increasing the quantity or size of something.</descrip></descripGrp><ntig><termGrp><term id="1091338">add</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1574266">kongeraho</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2388_415516_1910158"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A name assigned to a cell or group of cells.</descrip></descripGrp><ntig><termGrp><term id="415516">range name</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1910158">izina ry'itsinda</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote t