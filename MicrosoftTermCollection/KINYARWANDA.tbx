">remote control software</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="505572">porogaramu ngenzurirakure</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33697_1808999_2021265"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To put your finger on a touchscreen and then swipe it quickly, lifting your finger off the screen, in the direction you want.</descrip></descripGrp><ntig><termGrp><term id="1808999">flick</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="2021265">kunyatura</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33700_1809907_2062398"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Skype feature that allows users to call directly from Skype to landlines and mobile phones.</descrip></descripGrp><ntig><termGrp><term id="1809907">call phones</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="2062398">guhamagara kuri telefoni</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33701_1809933_2062490"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables the user to store video clips.</descrip></descripGrp><ntig><termGrp><term id="1809933">video storage</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="2062490">ububiko bwa videwo</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33702_1810821_2062477"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The document that covers how users may use Skype software, Skype products, and the Skype website.</descrip></descripGrp><ntig><termGrp><term id="1810821">Terms of Use</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="2062477">Amabwiriza agenga imikoreshereze</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33703_1810823_2062469"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables the user to connect to public WiFi hotspots, paying per minute with Skype Credit.</descrip></descripGrp><ntig><termGrp><term id="1810823">Skype WiFi</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="2062469">Skype WiFi</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Pr