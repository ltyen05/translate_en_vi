peech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="505118">imenyesha</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5471_139235_504947"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of formatting that is applied to cell contents, form controls, Outlook items or other data based on one or more logical conditions.</descrip></descripGrp><ntig><termGrp><term id="139235">conditional formatting</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="504947">igenemiterere kigombero</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5474_142066_504981"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A technique for filtering records in a form, datasheet, or data access page in which you retrieve only records that contain the selected value.</descrip></descripGrp><ntig><termGrp><term id="142066">Filter By Selection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="504981">gushungura hakurikijwe ihitamo</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5477_264641_505476"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A fraction that is written vertically with the numerator on the top and the denominator below, with a horizontal fraction bar between them.</descrip></descripGrp><ntig><termGrp><term id="264641">stacked fraction</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="505476">agace ku mirongo ibiri</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5483_88655_504656"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A number whose form indicates position in an ordered sequence of items, such as first, third, or twentieth.</descrip></descripGrp><ntig><termGrp><term id="88655">ordinal number</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="504656">umubare rutonde</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5487_26569_504184"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Broadly, any device that performs arithmetic operations on numbers. Sophisticated calculators can be programmed for certain functions and can store values in memory, but they differ from computers in several ways: they have a fixed set of commands, they do not recognize text, they cannot retrieve values stored in a data file, and they cannot find and use values generated by a program such as a spreadsheet.</descrip></descripGrp><ntig><termGrp><term id="26569">calculator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="504184">mubazi</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5492_144959_1909975"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Category labels in a chart that, based on worksheet data, are automatically displayed on more than one line in a hierarchy. For example, the heading Produce might appear above a row with headings Tofu, Apples, and Pears.</descrip></descripGrp><ntig><termGrp><term id="144959">multiple-level category labels</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1909975">ibirango by'icyiciro gifite inzego nyinshi</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5506_178166_1805482"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An implementation of Domain Name System (DNS) written and ported to most available versions of the UNIX operating system. The Internet Software Consortium maintains the BIND software.</descrip></descripGrp><ntig><termGrp><term id="178166">Berkeley Internet Name Domain</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1805482">BIND</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5506_178167_1805482"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An implementation of Domain Name System (DNS) written and ported to most available versions of the UNIX operating system. The Internet Software Consortium maintains the BIND software.</descrip></descripGrp><ntig><termGrp><term id="178167">BIND</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1805482">BIND</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5511_55836_504431"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The overall layout or pattern of a document.</descrip></descripGrp><ntig><termGrp><term id="55836">format</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="504431">igenamiterere</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5514_174436_1910026"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A person who uses a computer that is not connected to a network. A local user is most likely someone using a computer at home.</descrip></descripGrp><ntig><termGrp><term id="174436">local user</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1910026">ukoresha wa hafi</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5515_102469_1909873"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A communication mechanism that allows computers to communicate with one another over a network. An RPC consists of a procedure identifier, parameters passed to the procedure, and a value returned to the caller (client computer) after the procedure has executed on the remote system (server computer).</descrip></descripGrp><ntig><termGrp><term id="102469">remote procedure call</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1909873">RPC</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5515_102470_1909873"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A communication mechanism that allows computers to communicate with one another over a network. An RPC consists of a procedure identifier, parameters passed to the procedure, and a value returned to the caller (client computer) after the procedure has executed on the remote system (server computer).</descrip></descripGrp><ntig><termGrp><term id="102470">RPC</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1909873">RPC</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5518_269743_504258"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A standard Windows control that combines text box and list box functions.</descrip></descripGrp><ntig><termGrp><term id="269743">combo box control</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="504258">akazu kifungura</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5518_269743_505518"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A standard Windows control that combines text box and list box functions.</descrip></descripGrp><ntig><termGrp><term id="269743">combo box control</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="505518">kugenzura akazu kifungura</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5518_35264_504258"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A standard Windows control that combines text box and list box functions.</descrip></descripGrp><ntig><termGrp><term id="35264">combo box</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="504258">akazu kifungura</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5518_35264_505518"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A standard Windows control that combines text box and list box functions.</descrip></descripGrp><ntig><termGrp><term id="35264">combo box</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="505518">kugenzura akazu kifungura</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5519_129398_504870"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In a virtual memory system, the address the application uses to reference memory. The kernel and the memory management unit (MMU) translate this address into a physical address before the memory is actually read or written.</descrip></descripGrp><ntig><termGrp><term id="129398">virtual address</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="504870">aderesi idafatika</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5526_55989_1805519"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The attributes of a cell in a spreadsheet, such as its being alphabetic or numeric, the number of digits, the use of commas, and the use of currency signs.</descrip></descripGrp><ntig><termGrp><term id="55989">format</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1805519">imiterere</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5531_147830_505020"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To rerun a query underlying the active form or datasheet in order to reflect changes to the records, display newly added records, and eliminate deleted records.</descrip></descripGrp><ntig><termGrp><term id="147830">requery</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="505020">kuvugurura</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5540_294447_505544"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of settings that affect how a file is printed on the page. Includes paper size and orientation, page margins, headers and footers.</descrip></descripGrp><ntig><termGrp><term id="294447">page setup</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="505544">gutunganya paji</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5545_140096_504956"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A label that provides additional information about a data marker, which represents a single data point or value that originates from a datasheet cell.</descrip></descripGrp><ntig><termGrp><term id="140096">data label</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="504956">akarango k'amakurushingiro</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5552_143288_1909955"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A separate worksheet that lists changes being tracked in a shared workbook, including the name of the person who made the change, when and where it was made, what data was deleted or replaced, and how conflicts were resolved.</descrip></descripGrp><ntig><termGrp><term id="143288">History worksheet</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1909955">Urupapuro rw’amateka</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5559_210496_505189"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A software component that enables message exchange through a specific transport.</descrip></descripGrp><ntig><termGrp><term id="210496">adapter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="505189">adabutateri</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5559_210496_505399"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A software component that enables message exchange through a specific transport.</descrip></descripGrp><ntig><termGrp><term id="210496">adapter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="505399">adabutateri y'itwara</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5559_258665_505189"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A software component that enables message exchange through a specific transport.</descrip></descripGrp><ntig><termGrp><term id="258665">transport adapter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="505189">adabutateri</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</ter