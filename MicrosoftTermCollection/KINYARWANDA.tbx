1910330"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that helps users of some Office applications to improve the accessibility of documents they create.</descrip></descripGrp><ntig><termGrp><term id="777713">Accessibility Checker</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1910330">ingenzurakwinjirwa</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21535_777724_1597621"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An instant message that is transmitted while the sender or recipient is offline.</descrip></descripGrp><ntig><termGrp><term id="777724">offline instant message</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1597621">ubutumwa bwo hanze ya Interineti</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21543_777733_1597409"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The helper program that can store sign-in information for multiple Windows Live IDs.</descrip></descripGrp><ntig><termGrp><term id="777733">Windows Live Sign-in Assistant</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1597409">Imfashakwinjira mu Windows Live</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21545_777735_1910331"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that offers improved security by loading a document in a read-only view, rather than in the full editor, for scenarios that pose a greater potential security risk.</descrip></descripGrp><ntig><termGrp><term id="777735">Protected View</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1910331">Igaragaza rifunze</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21546_777736_1910332"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A package containing everything you need to show one or many PowerPoint presentations on another computer. This package can be saved to a folder or burned to a CD.</descrip></descripGrp><ntig><termGrp><term id="777736">presentation package</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1910332">ahakubiye ibyerekanwa byose</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21549_777739_1910333"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows the user to indicate that a document is trusted, and therefore can be opened without security notifications, so long as the file path and creation time of the document remain unchanged.</descrip></descripGrp><ntig><termGrp><term id="777739">Trusted Documents</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1910333">Inyandiko zemewe</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21550_777740_1653049"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A list that displays someone's recent activity on Windows Store apps such as Messaging and Facebook.</descrip></descripGrp><ntig><termGrp><term id="777740">what's new</term><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1653049">igishya</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21553_777744_1597598"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The link to the webpage where a user manages photos and albums.</descrip></descripGrp><ntig><termGrp><term id="777744">Photos</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1597598">Amafoto</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21554_777746_1597577"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The link to the main landing/start page on Windows Live.</descrip></descripGrp><ntig><termGrp><term id="777746">Home</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1597577">Intangiriro</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21563_777782_1576415"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Windows library that allows users to store, manage and share all their recorded TV items.</descrip></descripGrp><ntig><termGrp><term id="777782">Recorded TV Library</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1576415">Ububiko bwa TV zafashwe</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21573_777813_1910334"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows you to preview the appearance of a formatting option or command before actually applying it to selected text or objects.</descrip></descripGrp><ntig><termGrp><term id="777813">Live Preview</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1910334">Igaragazambere ry'ako kanya</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21635_779036_1697351"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Windows feature that provides a direct connection to a corporate network for people working outside of the office. It is a superior alternative to VPN.</descrip></descripGrp><ntig><termGrp><term id="779036">DirectAccess</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1697351">DirectAccess</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21637_779040_1990201"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A PC (desktop and beyond) search platform that allows search of the local hard drive plus network locations like SharePoint sites and the Internet.</descrip></descripGrp><ntig><termGrp><term id="779040">Windows Search</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1990201">Windows Search</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21638_1276167_1574262"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of attributes that define a user's access to a given service or application.</descrip></descripGrp><ntig><termGrp><term id="1276167">identity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1574262">konti</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21638_779054_1574262"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of attributes that define a user's access to a given service or application.</descrip></descripGrp><ntig><termGrp><term id="779054">account</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1574262">konti</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21640_779056_1998755"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To break a connection.</descrip></descripGrp><ntig><termGrp><term id="779056">disconnect</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1998755">kureka kwihuza</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21755_779690_1910336"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show a progression, a timeline, or sequential steps in a task, process, or workflow. Works well for illustrating both Level 1 and Level 2 text.</descrip></descripGrp><ntig><termGrp><term id="779690">Accent Process</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1910336">Ishimangiragokorwa</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21756_779691_1910337"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show groups of information or sequential steps in a task, process, or workflow. Emphasizes the interaction or relationships among the groups of information.</descrip></descripGrp><ntig><termGrp><term id="779691">Alternating Flow</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1910337">Uruhererekane rundi</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21757_779692_1910338"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show either related or contrasting concepts with some connection, such as opposing forces. The first two lines of Level 1 text are used for text in the arrows. Unused text does not appear, but remains available if you switch layouts.</descrip></descripGrp><ntig><termGrp><term id="779692">Arrow Ribbon</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1910338">Riba y'akambi</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21758_779693_1574277"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to compare or show the relationship between two ideas. Each of the first two lines of Level 1 text corresponds to text at the top of one side of the center point. Emphasizes Level 2 text, which is limited to four shapes on each side of the center point. The balance tips towards the side with the most shapes containing Level 2 text. Unused text does not appear, but remains available if you switch layouts.</descrip></descripGrp><ntig><termGrp><term id="779693">Balance</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1574277">Umunzani</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21759_779694_1910339"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show a progression or sequential steps in a task, process, or workflow. Maximizes both horizontal and vertical display space for shapes.</descrip></descripGrp><ntig><termGrp><term id="779694">Basic Bending Process</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1910339">Igikorwa mpinamashusho cy'ibanze</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21760_779695_1910340"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show non-sequential or grouped blocks of information. Maximizes both horizontal and vertical display space for shapes.</descrip></descripGrp><ntig><termGrp><term id="779695">Basic Block List</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1910340">Urutonde nkumira rw'ibanze</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21761_779696_1910341"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show a progression; a timeline; sequential steps in a task, process, or workflow; or to emphasize movement or direction. Level 1 text appears inside an arrow shape while Level 2 text appears below the arrow shapes.</descrip></descripGrp><ntig><termGrp><term id="779696">Basic Chevron Process</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1910341">Igikorwa cy'amashusho ya V y'ibanze</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21762_779697_1910342"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to represent a continuing sequence of stages, tasks, or events in a circular flow. Emphasizes the stages or steps rather than the connecting arrows or flow. Works best with Level 1 text only.</descrip></descripGrp><ntig><termGrp><term id="779697">Basic Cycle</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1910342">Icyiciro cy'ibanze</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21763_779698_1910343"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show the relationship of components to a whole in quadrants. The first four lines of Level 1 text appear in the quadrants. Unused text does not appear, but remains available if you switch layouts.</descrip></descripGrp><ntig><termGrp><term id="779698">Basic Matrix</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1910343">Inyerekana y'ibanze</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21764_779699_1910344"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show how individual parts form a whole. The first seven lines of Level 1 text correspond to the evenly distributed wedge or pie shapes. The top Level 1 text shape appears outside of the rest of the pie for emphasis. Unused text does not appear, but remains available if you switch layouts.</descrip></descripGrp><ntig><termGrp><term id="779699">Basic Pie</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1910344">Imbonerahamwe ruziga y'ibanze</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21765_779700_1910345"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show a progression or sequential steps in a task, process, or workflow.</descrip></descripGrp><ntig><termGrp><term id="779700">Basic Process</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1910345">Igikorwa cy'ibanze</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21766_779701_1910346"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show proportional, interconnected, or hierarchical relationships with the largest component on the bottom and narrowing up. Level 1 text appears in the pyramid segments and Level 2 text appears in shapes alongside each segment.</descrip></descripGrp><ntig><termGrp><term id="779701">Basic Pyramid</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1910346">Piramide y'ibanze</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21767_779702_1910347"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show the relationship to a central idea in a cycle. The first line of Level 1 text corresponds to the central shape, and its Level 2 text corresponds to the surrounding circular shapes. Unused text does not appear, but remains available if you switch layouts.</descrip></descripGrp><ntig><termGrp><term id="779702">Basic Radial</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1910347">Impuzampembe y'ibanze</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21768_779703_1910348"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show containment, gradations, or hierarchical relationships. The first five lines of Level 1 text are associated with a circle. Unused text does not appear, but remains available if you switch layouts.</descrip></descripGrp><ntig><termGrp><term id="779703">Basic Target</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1910348">Intego y'ibanze</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21769_779704_1910349"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show sequential steps in a task, process, or workflow, or to show timeline information. Works well with both Level 1 and Level 2 text.</descrip></descripGrp><ntig><termGrp><term id="779704">Basic Timeline</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1910349">Ingengabihe y'ibanze</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21770_779705_1910350"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show overlapping or interconnected relationships. The first seven lines of Level 1 text correspond with a circle. If there are four or fewer lines of Level 1 text, the text is inside the circles. If there are more than four lines of Level 1 text, the text is outside of the circles. Unused text does not appear, but remains available if you switch layouts.</descrip></descripGrp><ntig><termGrp><term id="779705">Basic Venn</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1910350">Imbonerahamwe ya Venn y'ibanze</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21771_779706_1910351"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show non-sequential or grouped blocks of information. The small circular shapes are designed to contain pictures. Works well for illustrating both Level 1 and Level 2 text. Maximizes both horizontal and vertical display space for shapes.</descrip></descripGrp><ntig><termGrp><term id="779706">Bending Picture Accent List</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1910351">Urutonde rw'ifoto mpinashusho</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21772_779707_1910352"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to represent a continuing sequence of stages, tasks, or events in a circular flow. Emphasizes the stages or steps rather than the connecting arrows or flow.</descrip></descripGrp><ntig><termGrp><term id="779707">Block Cycle</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1910352">Uruhererekane rw'itsinda</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21773_779708_1910353"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show a progression through several processes that make up an overall workflow. Also works for illustrating contrasting processes. The Level 1 text corresponds to the first arrow shape on the left, while the Level 2 text corresponds to horizontal sub-steps for each shape that contains Level 1 text.</descrip></descripGrp><ntig><termGrp><term id="779708">Chevron List</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1910353">Urutonde rw'amashusho ya V</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21774_779709_1910354"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show a long or non-linear sequence or steps in a task, process, or workflow. Works best with Level 1 text only. Maximizes both horizontal and vertical display space for shapes.</descrip></descripGrp><ntig><termGrp><term id="779709">Circular Bending Process</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1910354">Igikorwa mpinamashusho kizengurutse</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21775_779710_1910355"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show a progression, a timeline, or sequential steps in a task, process, or workflow, or to emphasize movement or direction. Can be used to emphasize information in the starting shape. Works best with Level 1 text only.</descrip></descripGrp><ntig><termGrp><term id="779710">Closed Chevron Process</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1910355">Igikorwa cy'akugarizo</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21776_779711_1910356"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show a timeline or sequential steps in a task, process, or workflow. Works best with Level 1 text because each line of Level 1 text appears inside the arrow shape. Level 2 text appears outside the arrow shape.</descrip></descripGrp><ntig><termGrp><term id="779711">Continuous Arrow Process</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1910356">Igikorwa cy'akambi gakomeza</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21777_779712_1910357"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show a progression or sequential steps in a task, process, or workflow. Works best with minimal Level 1 and Level 2 text.</descrip></descripGrp><ntig><termGrp><term id="779712">Continuous Block Process</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1910357">Igikorwa cy'itsinda rikomeza</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21778_779713_1910358"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to represent a continuing sequence of stages, tasks, or events in a circular flow. Emphasizes the connection between all components. Works best with Level 1 text only.</descrip></descripGrp><ntig><termGrp><term id="779713">Continuous Cycle</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1910358">Icyiciro gikomeza</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21779_779714_1910359"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show groups of interconnected information. The circular shapes are designed to contain pictures.</descrip></descripGrp><ntig><termGrp><term id="779714">Continuous Picture List</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1910359">Urutonde rw'amafoto rukomeza</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21780_779715_1910360"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show ideas or concepts that converge to a central point. Works best with Level 1 text only.</descrip></descripGrp><ntig><termGrp><term id="779715">Converging Arrows</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1910360">Utwambi twinjiramo</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21781_779716_1910361"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show relationships of concepts or components to a central idea in a cycle. The first line of Level 1 text corresponds to the central circular shape and the lines of Level 2 text correspond to the surrounding rectangular shapes. Unused text does not appear, but remains available if you switch layouts.</descrip></descripGrp><ntig><termGrp><term id="779716">Converging Radial</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1910361">Impuzampembe yinjira</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21782_779717_1910362"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show two opposing ideas or concepts. Each of the first two lines of Level 1 text corresponds to an arrow and works well with Level 2 text. Unused text does not appear, but remains available if you switch layouts.</descrip></descripGrp><ntig><termGrp><term id="779717">Counterbalance Arrows</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1910362">Utwambi nyuranyabyerekezo</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21783_779718_1910363"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show the relationship to a central idea in a cyclical progression. Each of the first four lines of Level 1 text corresponds to a wedge or pie shape, and Level 2 text appears in a rectangular shape to the side of the wedge or pie shape. Unused text does not appear, but remains available if you switch layouts.</descrip></descripGrp><ntig><termGrp><term id="779718">Cycle Matrix</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1910363">Inyerekana y’icyiciro</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21784_779719_1910364"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used with large amounts of Level 2 text to show a progression through stages.</descrip></descripGrp><ntig><termGrp><term id="779719">Detailed Process</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1910364">Igikorwa kirambuye</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21785_779720_1910365"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show ideas or concepts that progress outward from a central source. Works best with Level 1 text only.</descrip></descripGrp><ntig><termGrp><term id="779720">Diverging Arrows</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1910365">Utwambi dusohoka</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21786_779721_1910366"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show relationships to a central idea in a cycle. The first Level 1 line of text corresponds to the central circular shape. Emphasizes the surrounding circles rather than the central idea. Unused text does not appear, but remains available if you switch layouts.</descrip></descripGrp><ntig><termGrp><term id="779721">Diverging Radial</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1910366">Impuzampembe isohoka</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21787_779722_1910367"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show sequential steps or tasks that depict a plan or result. The last Level 1 line of text appears after the equals sign (=).Works best with Level 1 text only.</descrip></descripGrp><ntig><termGrp><term id="779722">Equation</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1910367">Inganyagaciro</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21788_779723_1910368"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show the filtering of information or how parts merge into a whole. Emphasizes the final outcome. Can contain up to four lines of Level 1 text; the last of these four Level 1 text lines appears below the funnel and the other lines correspond to a circular shape. Unused text does not appear, but remains available if you switch layouts.</descrip></descripGrp><ntig><termGrp><term id="779723">Funnel</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1910368">Umubirikira</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21789_779724_1910369"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show interlocking ideas. Each of the first three lines of Level 1 text corresponds to a gear shape, and their corresponding Level 2 text appears in rectangles next to the gear shape. Unused text does not appear, but remains available if you switch layouts.</descrip></descripGrp><ntig><termGrp><term id="779724">Gear</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1910369">Vitensi</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21790_779725_1910370"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show the placement of concepts along two axes. Emphasizes the individual components rather than the whole. The first four lines of Level 1 text appear in the quadrants. Unused text does not appear, but remains available if you switch layouts.</descrip></descripGrp><ntig><termGrp><term id="779725">Grid Matrix</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1910370">Inyerekanakazu</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21791_779726_1910371"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show groups and sub-groups of information, or steps and sub-steps in a task, process, or workflow. Level 1 text corresponds to the top-level horizontal shapes, and Level 2 text corresponds to vertical sub-steps under each related top-level shape. Works well for emphasizing sub-groups or sub-steps, hierarchical information, or multiple lists of information.</descrip></descripGrp><ntig><termGrp><term id="779726">Grouped List</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1910371">Urutonde rwakusanyijwe</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21792_779727_1910372"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show hierarchical relationships progressing from top to bottom.</descrip></descripGrp><ntig><termGrp><term id="779727">Hierarchy</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1910372">Uruhererekane</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21793_779728_1910373"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show hierarchical relationships progressing across groups. Can also be used to group or list information.</descrip></descripGrp><ntig><termGrp><term id="779728">Hierarchy List</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1910373">Urutonde rw'uruhererekane</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21794_779729_1910374"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show non-sequential or grouped lists of information. Works well with large amounts of text. All text has the same level of emphasis, and direction is not implied.</descrip></descripGrp><ntig><termGrp><term id="779729">Horizontal Bullet List</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1910374">Urutonde rw’utudomo dutambitse</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21795_779730_1910375"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show hierarchical relationships progressing horizontally. Works well for decision trees.</descrip></descripGrp><ntig><termGrp><term id="779730">Horizontal Hierarchy</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1910375">Uruhererekane rutambitse</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21796_779731_1910376"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show non-sequential or grouped information with an emphasis on related pictures. The top shapes are designed to contain pictures.</descrip></descripGrp><ntig><termGrp><term id="779731">Horizontal Picture List</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1910376">Urutonde rw'amafoto rutambitse</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21797_779732_1910377"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show hierarchical relationships progressing horizontally and grouped hierarchically. Emphasizes heading or level 1 text. The first line of Level 1 text appears in the shape at the beginning of the hierarchy, and the second and all subsequent lines of Level 1 text appear at the top of the tall rectangles.</descrip></descripGrp><ntig><termGrp><term id="779732">Horizontal Labeled Hierarchy</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1910377">Uruhererekane ruriho ibimenyetso rutambitse</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21798_779733_1910378"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show proportional, or interconnected, or hierarchical relationships with the largest component on the top and narrowing down. Level 1 text appears in the pyramid segments and Level 2 text appears in shapes alongside each segment.</descrip></descripGrp><ntig><termGrp><term id="779733">Inverted Pyramid</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1910378">Piramide icuritse</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21799_779734_1910379"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show hierarchical relationships progressing from top to bottom and grouped hierarchically. Emphasizes heading or level 1 text. The first line of Level 1 text appears in the shape at the beginning of the hierarchy, and all subsequent lines of Level 1 text appear to the left of the tall rectangles.</descrip></descripGrp><ntig><termGrp><term id="779734">Labeled Hierarchy</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1910379">Uruhererekane ruriho ibimenyetso</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21800_779735_1910380"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show overlapping relationships in a sequence. Works best with Level 1 text only.</descrip></descripGrp><ntig><termGrp><term id="779735">Linear Venn</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1910380">imbonerahamwe ya Venn murongo</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21801_779736_1910381"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to represent a continuing sequence of stages, tasks, or events that can occur in any direction.</descrip></descripGrp><ntig><termGrp><term id="779736">Multidirectional Cycle</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1910381">Uruhererekane rw’ibyerekezo byinshi</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21802_779737_1910382"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show containment relationships. Each of the first three lines of Level 1 text correspond to the upper left text in the shapes, and Level 2 text corresponds to the smaller shapes. Works best with minimal Level 2 lines of text. Unused text does not appear, but remains available if you switch layouts.</descrip></descripGrp><ntig><termGrp><term id="779737">Nested Target</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1910382">Mubikasano y'icyerekezo</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21803_779738_1910383"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to represent a continuing sequence of stages, tasks, or events in a circular flow. Each shape has the same level of importance. Works well when direction does not need to be indicated.</descrip></descripGrp><ntig><termGrp><term id="779738">Nondirectional Cycle</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1910383">Icyiciro kidafite icyerekezo</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21804_779739_1910384"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show two opposing ideas, or ideas that diverge from a central point. Each of the first two lines of Level 1 text corresponds to an arrow. Unused text does not appear, but remains available if you switch layouts.</descrip></descripGrp><ntig><termGrp><term id="779739">Opposing Arrows</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1910384">Utwambi tubusanye</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21805_779740_1910385"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show hierarchical information or reporting relationships in an organization. The assistant shape and the Org Chart hanging layouts are available with this layout.</descrip></descripGrp><ntig><termGrp><term id="779740">Organization Chart</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1910385">Imbonerahamwe y'inzego z'imirimo</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21806_779741_1910386"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show grouped or related information. The small shapes on the upper corners are designed to contain pictures. Emphasizes Level 2 text over Level 1 text, and is a good choice for large amounts of Level 2 text.</descrip></descripGrp><ntig><termGrp><term id="779741">Picture Accent List</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1910386">Urutonde rw'amashusho atyaye</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21807_779742_1910387"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show sequential steps in a task, process, or workflow. The rectangular shapes in the background are designed to contain pictures.</descrip></descripGrp><ntig><termGrp><term id="779742">Picture Accent Process</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1910387">Imigendekere y'amashusho atyaye</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21808_779743_1910388"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show non-sequential or grouped blocks of information. The top shapes are designed to contain pictures and pictures are emphasized over text. Works well for pictures with short text captions.</descrip></descripGrp><ntig><termGrp><term id="779743">Picture Caption List</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1910388">Urutonde rw'amashusho yafashwe</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21809_779744_1910389"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show information illustrating a process or workflow. Level 1 text appears in the circular shapes and Level 2 text appears in the arrow shapes. Works best for minimal text and to emphasize movement or direction.</descrip></descripGrp><ntig><termGrp><term id="779744">Process Arrows</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1910389">Utwambi tw'imigendekere</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21810_779745_1910390"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show multiple groups of information or steps and sub-steps in a task, process, or workflow. Level 1 text corresponds to the top horizontal shapes, and Level 2 text corresponds to vertical sub-steps under each related top-level shape.</descrip></descripGrp><ntig><termGrp><term id="779745">Process List</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1910390">Utwambi tw'igikorwa</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21811_779746_1910391"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show proportional, interconnected, or hierarchical relationships. Text appears in the rectangular shapes on top of the pyramid background</descrip></descripGrp><ntig><termGrp><term id="779746">Pyramid List</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1910391">Urutonde rwa Piramide</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21812_779747_1910392"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show the relationship to a central idea. Emphasizes both information in the center circle and how information in the outer ring of circles contributes to the central idea. The first Level 1 line of text corresponds to the central circle, and its Level 2 text corresponds to the outer ring of circles. Unused text does not appear, but remains available if you switch layouts.</descrip></descripGrp><ntig><termGrp><term id="779747">Radial Cycle</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1910392">Icyiciro cy'impuzampembe</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21813_779748_1910393"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show relationships to a central idea in a cycle. The center shape can contain a picture. Level 1 text appears in the smaller circles and any related Level 2 text appears to the side of the smaller circles.</descrip></descripGrp><ntig><termGrp><term id="779748">Radial List</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1910393">Urutonde rw'impuzampembe</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21814_779749_1910394"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show both overlapping relationships and the relationship to a central idea in a cycle. The first line of Level 1 text corresponds to the central shape and the lines of Level 2 text correspond to the surrounding circular shapes. Unused text does not appear, but remains available if you switch layouts.</descrip></descripGrp><ntig><termGrp><term id="779749">Radial Venn</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1910394">Imbonerahamwe ya Venn mpuzampembe</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21815_779750_1910395"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show a progression or sequential steps in a task, process, or workflow. Maximizes both horizontal and vertical display space for shapes. Does not emphasize directionality.</descrip></descripGrp><ntig><termGrp><term id="779750">Repeating Bending Process</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1910395">Igikorwa mpinamashusho cyisubiramo</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21816_779751_1910396"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show a progression or a sequence of stages, tasks, or events in a circular flow. Emphasizes the interconnected pieces. Each of the first seven lines of Level 1 text corresponds to a wedge or pie shape. Unused text does not appear, but remains available if you switch layouts.</descrip></descripGrp><ntig><termGrp><term id="779751">Segmented Cycle</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1910396">Icyiciro cyaciwemo ibice</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21817_779752_1910397"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show a progression or sequential steps in a task, process, or workflow. Emphasizes Level 2 text, since each line appears in a separate shape.</descrip></descripGrp><ntig><termGrp><term id="779752">Segmented Process</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1910397">Igikorwa cyaciwemo ibice</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21818_779753_1910398"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show containment, proportional, or interconnected relationships. The first nine lines of Level 1 text appear in the triangular shapes. Unused text does not appear, but remains available if you switch layouts. Works best with Level 1 text only.</descrip></descripGrp><ntig><termGrp><term id="779753">Segmented Pyramid</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1910398">Piramide yaciwemo ibice</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21819_779754_1910399"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show groups of information or steps in a task, process, or workflow. Circular shapes contain Level 1 text, and the corresponding rectangles contain Level 2 text. Works well for numerous details and minimal Level 1 text.</descrip></descripGrp><ntig><termGrp><term id="779754">Stacked List</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1910399">Urutonde rw'imikoro</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21820_779755_1910400"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show a downward progression through stages. Each of the first five lines of Level 1 text corresponds with a rectangle. Unused text does not appear, but remains available if you switch layouts.</descrip></descripGrp><ntig><termGrp><term id="779755">Staggered Process</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1910400">Igikorwa cyo mu byiciro</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21821_779756_1910401"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show groups of information built from top to bottom, and the hierarchies within each group. This layout does not contain connecting lines.</descrip></descripGrp><ntig><termGrp><term id="779756">Table Hierarchy</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1910401">Urukurikirane rw'imbonerahamwe</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21822_779757_1910402"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show grouped or related information of equal value. The first Level 1 line of text corresponds to the top shape and its Level 2 text is used for the subsequent lists.</descrip></descripGrp><ntig><termGrp><term id="779757">Table List</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1910402">Urutonde rw'imbonerahamwe</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21823_779758_1910403"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show interrelated or overlapping information. Each of the first seven lines of Level 1 text appears in the rectangular shape. Unused text does not appear, but remains available if you switch layouts. Works well with both Level 1 and Level 2 text.</descrip></descripGrp><ntig><termGrp><term id="779758">Target List</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1910403">Urutonde ntego</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21824_779759_1910404"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to represent a continuing sequence of stages, tasks, or events in a circular flow. Emphasizes the arrows or flow rather than the stages or steps. Works best with Level 1 text only.</descrip></descripGrp><ntig><termGrp><term id="779759">Text Cycle</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1910404">Icyiciro cy’umwandiko</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21825_779760_1910405"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show the relationships of four quadrants to a whole. The first line of Level 1 text corresponds to the central shape, and the first four lines of Level 2 text appear in the quadrants. Unused text does not appear, but remains available if you switch layouts.</descrip></descripGrp><ntig><termGrp><term id="779760">Titled Matrix</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1910405">Inyerekana y'ibiri kumwe</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21826_779761_1910406"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show grouped or related information of equal value. Works well with large amounts of text.</descrip></descripGrp><ntig><termGrp><term id="779761">Trapezoid List</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1910406">Urutonde rw'amakuru nganyagaciro</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21827_779762_1910407"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show a progression or steps that trend upward in a task, process, or workflow. Each of the first five lines of Level 1 text corresponds to a point on the arrow. Works best with minimal text. Unused text does not appear, but remains available if you switch layouts.</descrip></descripGrp><ntig><termGrp><term id="779762">Upward Arrow</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1910407">Akambi njyejuru</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21828_779763_1910408"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show a progression or sequential steps in a task, process, or workflow that move toward a common goal. Works well for bulleted lists of information.</descrip></descripGrp><ntig><termGrp><term id="779763">Vertical Arrow List</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1910408">Urutonde rw'utwambi duhagaze</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21829_779764_1910409"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show a progression or sequential steps in a task, process, or workflow. Maximizes both horizontal and vertical display space for shapes. Places more emphasis on the interrelationships among the shapes than on direction or movement.</descrip></descripGrp><ntig><termGrp><term id="779764">Vertical Bending Process</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1910409">Igikorwa mpinamashusho gihagaze</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21830_779765_1910410"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show groups of information or steps in a task, process, or workflow. Works well with large amounts of Level 2 text. A good choice for text with a main point and multiple sub-points.</descrip></descripGrp><ntig><termGrp><term id="779765">Vertical Block List</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1910410">Urutonde nkumira ruhagaze</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21831_779766_1910411"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show several groups of information, especially groups with large amounts of Level 2 text. A good choice for bulleted lists of information.</descrip></descripGrp><ntig><termGrp><term id="779766">Vertical Box List</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1910411">Urutonde rw'utuzu duhagaze</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21832_779767_1910412"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show non-sequential or grouped blocks of information. Works well for lists with long headings or top-level information.</descrip></descripGrp><ntig><termGrp><term id="779767">Vertical Bullet List</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1910412">Urutonde rw'utudomo duhagaze</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21833_779768_1910413"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show a progression or sequential steps in a task, process, or workflow, or to emphasize movement or direction. Emphasizes Level 2 text over Level 1 text, and is a good choice for large amounts of Level 2 text.</descrip></descripGrp><ntig><termGrp><term id="779768">Vertical Chevron List</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1910413">Urutonde rw'amashusho ya V ahagaze</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21834_779769_1910414"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show sequential steps or tasks that depict a plan or result. The last Level 1 line of text appears after the arrow. Works best with Level 1 text only.</descrip></descripGrp><ntig><termGrp><term id="779769">Vertical Equation</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1910414">Inganyagaciro ihagaze</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21835_779770_1910415"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show non-sequential or grouped blocks of information. The small circles are designed to contain pictures.</descrip></descripGrp><ntig><termGrp><term id="779770">Vertical Picture Accent List</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1910415">Urutonde rw'amashusho atyaye ahagaze</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21836_779771_1910416"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show non-sequential or grouped blocks of information. The small shapes on the left are designed to contain pictures.</descrip></descripGrp><ntig><termGrp><term id="779771">Vertical Picture List</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1910416">Urutonde rw'amashusho ahagaze</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21837_779772_1910417"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show a progression or sequential steps in a task, process, or workflow from top to bottom. Works best with Level 1 text, since the vertical space is limited.</descrip></descripGrp><ntig><termGrp><term id="779772">Vertical Process</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1910417">Igikorwa gihagaze</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21838_779838_1910418"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show overlapping relationships. A good choice for emphasizing growth or gradation. Works best with Level 1 text only. The first seven lines of Level 1 text correspond to a circular shape. Unused text does not appear, but remains available if you switch layouts.</descrip></descripGrp><ntig><termGrp><term id="779838">Stacked Venn</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1910418">Imbonerahamwe ya Venn icucitse</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21839_779839_2629407"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Having the ability to make decisions based on predictions driven by machine learning analysis.</descrip></descripGrp><ntig><termGrp><term id="779839">intelligent</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="2629407">nyabwenge</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21847_779972_2436224"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Marked by the use of serifs. For example, Goudy is a serif typeface, whereas Helvetica is a sans serif typeface.</descrip></descripGrp><ntig><termGrp><term id="779972">serif</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="2436224">serif</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21873_780192_1910419"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A formula giving the roots of a quadratic equation.</descrip></descripGrp><ntig><termGrp><term id="780192">quadratic formula</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1910419">inzira itanga ibisubizo bine</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21906_780474_1576408"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A company that provides services or content for its customers.</descrip></descripGrp><ntig><termGrp><term id="780474">provider</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1576408">nyakugurisha</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21926_780637_2529583"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application that is both a digital still camera and a digital video camera.</descrip></descripGrp><ntig><termGrp><term id="780637">camera</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="2529583">kamera</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2194_126360_504853"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Of, pertaining to, or characterized by capital letters.</descrip></descripGrp><ntig><termGrp><term id="126360">uppercase</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="504853">inyuguti nkuru</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21951_1080693_1579084"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To expose a virtual disk to the user, backed by a file.</descrip></descripGrp><ntig><termGrp><term id="1080693">attach</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1579084">kugereka</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21957_781802_1805564"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The administrative task of making remote resources available to its users, setting policies that control how users will connect, how they will find the remote resources, and what settings users will connect with.</descrip></descripGrp><ntig><termGrp><term id="781802">publishing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1805564">itangaza</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2196_1261176_2002961"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The act of modifying the pages of a Web site so that its content is more easily discoverable by Internet search engines.</descrip></descripGrp><ntig><termGrp><term id="1261176">SEO</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="2002961">iboneza rya mushakisha</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2196_308342_2002961"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The act of modifying the pages of a Web site so that its content is more easily discoverable by Internet search engines.</descrip></descripGrp><ntig><termGrp><term id="308342">search engine optimization</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="2002961">iboneza rya mushakisha</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21990_782330_1576418"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To uninstall all software on a computer and reinstall a new Windows image.</descrip></descripGrp><ntig><termGrp><term id="782330">re-image</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1576418">gutuza bushya</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21996_782344_1574278"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A small pop-up window that informs users of a non-critical problem or special condition in a control.</descrip></descripGrp><ntig><termGrp><term id="782344">balloon</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1574278">akabaruni</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="220_31883_504231"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A module that can contain the definition for a new object where each instance of a class creates a new object and procedures defined in the module become properties and methods of the object.</descrip></descripGrp><ntig><termGrp><term id="31883">class module</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="504231">ubusobanuro</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22015_782379_2630425"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A computer (usually quite powerful) that is used solely as a network server.</descrip></descripGrp><ntig><termGrp><term id="782379">dedicated server</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="2630425">mugabuzi yabugenewe</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22040_782586_1771261"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A sensor that uses ultrasound, infrared, heat or vibration stimuli to detect movement.</descrip></descripGrp><ntig><termGrp><term id="782586">motion sensor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1771261">icyumvirizo cy’umuyego</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22041_782588_1771362"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A biometric sensor that analyses your eye retina to recognize or authenticate identity.</descrip></descripGrp><ntig><termGrp><term id="782588">retinal scanner</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1771362">sikaneri y’imboni</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22042_782589_1771216"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A category of sensor that can respond to an applied stimulus by generating an electrical signal.</descrip></descripGrp><ntig><termGrp><term id="782589">electrical sensor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1771216">icyumvirizo cy’amashanyarazi</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22043_782590_1771244"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A category of sensor that is used for mechanical measurement of force, scale, pressure, strain, etc.</descrip></descripGrp><ntig><termGrp><term id="782590">mechanical sensor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1771244">icyumvirizo mekanike</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22044_782669_1771217"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A category of sensor that tracks environmental changes such as temperature, atmospheric pressure, humidity, wind speed and wind direction.</descrip></descripGrp><ntig><termGrp><term id="782669">environmental sensor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1771217">icyumvirizo cy’ibidukikije</term><termNote type="geographi