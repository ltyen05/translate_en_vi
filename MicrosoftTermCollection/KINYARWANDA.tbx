76_1764505_1787039"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To reset a system using a method that restores PC settings to defaults but retains a user's files and personalization touches.</descrip></descripGrp><ntig><termGrp><term id="1764505">refresh your PC</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1787039">kugarura ibyari kuri PC yawe</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33281_1764780_1768917"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The service run by the Windows Store team that supports the end-to-end process for registering Windows Store developers and onboarding apps into the Windows Store catalog.</descrip></descripGrp><ntig><termGrp><term id="1764780">dashboard</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1768917">dashibodi</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33281_1764780_1997920"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The service run by the Windows Store team that supports the end-to-end process for registering Windows Store developers and onboarding apps into the Windows Store catalog.</descrip></descripGrp><ntig><termGrp><term id="1764780">dashboard</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNo