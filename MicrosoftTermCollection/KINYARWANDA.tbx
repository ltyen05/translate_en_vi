rp><term id="139328">content class</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="504948">icyiciro cy'ibikubiyemo</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5117_262544_505434"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A visual effect that imparts a quality of translucency to windows.</descrip></descripGrp><ntig><termGrp><term id="262544">glass</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="505434">kubonerana</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5117_777772_505434"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A visual effect that imparts a quality of translucency to windows.</descrip></descripGrp><ntig><termGrp><term id="777772">window glass</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="505434">kubonerana</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5119_319158_505790"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The distance or period of time between a specified start point and a specified end point. For example, the length of an audio or video clip is usually measured in minutes and seconds.</descrip></descripGrp><ntig><termGrp><term id="319158">length</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="505790">uburebure</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="512_14369_1805471"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of chart that displays the trend of values over time or categories. By displaying the sum of the plotted values, an area chart also shows the relationship of parts to a whole.</descrip></descripGrp><ntig><termGrp><term id="14369">area chart</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1805471">umwanya w'igishushanyo</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5121_73528_1909860"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of symbolic resolution where a symbol is resolved to a specific software routine during program execution instead of during program compilation, enabling polymorphism in object-oriented programs.</descrip></descripGrp><ntig><termGrp><term id="73528">late binding</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="