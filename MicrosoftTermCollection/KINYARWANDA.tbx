xml:lang="en-US"><descripGrp><descrip type="definition">A comment created by using a stylus. Microsoft Office Word treats a pen comment like any other drawing object. Pen comments don't appear in the Reviewing Pane, and Word doesn't insert comment marks in the document window.</descrip></descripGrp><ntig><termGrp><term id="232846">pen comment</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1910105">igitekerezo cyanditse n'ikaramu</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33306_1766385_2016575"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature of Bing that enables customers to block sites containing adult (sexually explicit) content. Customers can choose from three levels of filtering: strict (hides adult text and image results); moderate (hides adult images only); and off (doesn't hide any search results).</descrip></descripGrp><ntig><termGrp><term id="1766385">SafeSearch</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="2016575">SafeSearch</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33386_1776723_1781634"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An app that's downloaded from the Microsoft Store and installed automatically to the PC when a user attaches a certified device to the PC, provided that the device