-US"><descripGrp><descrip type="definition">To provide services (often using a server) to client computers that connect from remote locations, for example, to offer Internet access or to be the source for a news or mail service.</descrip></descripGrp><ntig><termGrp><term id="62295">host</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="2412528">gucumbikira</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33272_1764210_1768680"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The version of software that's distributed to manufacturers to build into hardware they will make available when the final software is made generally available.</descrip></descripGrp><ntig><termGrp><term id="1764210">RTM</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1768680">Verisiyo y’abanyenganda</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33272_1764210_1768683"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The version of software that's distributed to manufacturers to build into hardware they will make available when the final software is made generally available.</descrip></descripGrp><ntig><termGrp><term id="1764210">RTM</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></term