ious version of Internet Explorer.</descrip></descripGrp><ntig><termGrp><term id="784819">Compatibility View</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="2016556">Igaragaza ry'imikoranire</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2215_295551_505550"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A report containing news or information, can be printed or distributed electronically.</descrip></descripGrp><ntig><termGrp><term id="295551">newsletter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="505550">akanyamakuru</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2216_143575_1909960"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A discussion comment that is associated with a particular paragraph, image or table.</descrip></descripGrp><ntig><termGrp><term id="143575">inline discussion</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1909960">ikiganiro cyinjijwemo</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2218_210899_1805473"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A data type that will provide support for storing binary files within an Access database. More similar to the SharePoint concept of attachments than the current OLE object fields in Access. The data will be stored as a raw blob within the database.</descrip></descripGrp><ntig><termGrp><term id="210899">Attachment</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1805473">umugereka</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22183_1030868_2244189"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Institute of Electrical and Electronics Engineers (IEEE) 802.11 wireless network in which Service Set Identifier (SSID) suppression is enabled.</descrip></descripGrp><ntig><termGrp><term id="1030868">non-broadcast network</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="2244189">urusobemiyoboro ruhishe</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22183_1030869_2244189"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Institute of Electrical and Electronics Engineers (IEEE) 802.11 wireless network in which Service Set Identifier (SSID) suppression is enabled.</descrip></descripGrp><ntig><termGrp><term id="1030869">hidden network</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="2244189">urusobemiyoboro ruhishe</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22185_1030897_2280893"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that prevents Internet Explorer from storing data about your browsing session. This helps prevent anyone else who might be using your computer from seeing where you visited and what you looked at on the Web.</descrip></descripGrp><ntig><termGrp><term id="1030897">InPrivate Browsing</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="2280893">Gushakisha na InPrivate</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22186_1081740_1953554"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that blocks third-party web content that could potentially track someone's web activity.</descrip></descripGrp><ntig><termGrp><term id="1081740">InPrivate Filtering</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1953554">Kurinda ikurikirana</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termN