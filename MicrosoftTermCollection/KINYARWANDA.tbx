m id="505791">ikimenyetso cy'igicuruzwa cyemewe</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21197_767142_1910313"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that replicates the animation associated with a source object to one or more target objects.</descrip></descripGrp><ntig><termGrp><term id="767142">Animation Painter</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1910313">Musigarangi yo kuyeza</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21199_767144_1910314"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An abstract grouping of similar animation effects.</descrip></descripGrp><ntig><termGrp><term id="767144">animation style</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1910314">imiterere yo kuyeza</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21200_767145_1910315"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An effect that a user can apply to an image to achieve a specific artistic look.</descrip></descripGrp><ntig><termGrp><term id="767145">artistic effect</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1910315">imisusire y'ubuhanzi</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21201_767146_1910316"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A visual representation of an audio signal over time.</descrip></descripGrp><ntig><termGrp><term id="767146">audio waveform</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1910316">amajwi ameze nk'umuvumba</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21202_767148_1910317"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An image editing feature that allows a user to isolate the foreground portion of an image and make the background transparent.</descrip></descripGrp><ntig><termGrp><term id="767148">Background Removal</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1910317">Muvanamo y'imbuganyuma</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21203_767149_1910318"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An option that removes narrations and laser pointer gestures or timings from a presentation or from a specific slide.</descrip></descripGrp><ntig><termGrp><term id="767149">Clear Recordings</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1910318">Gusiba ibyafashwe</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2121_375_503958"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An area of memory reserved for temporarily holding data before that data is used by a receiving device or application. Buffering protects against the interruption of data flow.</descrip></descripGrp><ntig><termGrp><term id="375">buffer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="503958">ububiko gateganyo</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21211_767324_1910319"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of cryptographic algorithms specified by the US National Security Agency to provide an interoperable standard for government and industry.</descrip></descripGrp><ntig><termGrp><term id="767324">Suite B</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1910319">Itsinda B</term>