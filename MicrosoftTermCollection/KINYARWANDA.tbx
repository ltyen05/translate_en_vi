></descripGrp><ntig><termGrp><term id="397188">OAB</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1910149">Agatabo k'aderesi kaboneka hanze ya interineti</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14924_149902_1910018"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A query that retrieves data stored on your intranet or the Internet.</descrip></descripGrp><ntig><termGrp><term id="149902">Web query</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1910018">Ibibazo ku rubuga</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14938_18094_1805475"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A predefined or free-form figure — such as a line, oval, cube, flowchart symbol, banner, or free-form scribble — that the user can insert into a document and then customize.</descrip></descripGrp><ntig><termGrp><term id="18094">AutoShape</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1805475">ishusho mwikora</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSele