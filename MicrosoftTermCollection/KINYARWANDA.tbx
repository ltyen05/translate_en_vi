ilities do not require the use of a dedicated computer.</descrip></descripGrp><ntig><termGrp><term id="2371059">deskless worker</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="2373981">umukozi utagira biro</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41895_2455166_2373981"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An individual whose primary work responsibilities do not require the use of a dedicated computer.</descrip></descripGrp><ntig><termGrp><term id="2455166">desk-free worker</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="2373981">umukozi utagira biro</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="419_39765_504296"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Each of a set of references that together describe the exact position of something with respect to a set of axes (or a row and column).</descrip></descripGrp><ntig><termGrp><term id="39765">coordinate</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="504296">guhuza</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termN