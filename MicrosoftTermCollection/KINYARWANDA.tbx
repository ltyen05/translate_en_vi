ce system programs.</descrip></descripGrp><ntig><termGrp><term id="747784">Office Button</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1910298">Microsoft Office Button</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20655_747784_1910303"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A button that replaces the File menu beginning with some 2007 Microsoft Office system programs.</descrip></descripGrp><ntig><termGrp><term id="747784">Office Button</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1910303">Buto ya Office</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20683_745706_1805494"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An option on the Views menu in File Explorer that shows the most appropriate details for the file type in a flexible layout rather than only showing the details associated with the column headers in the view.</descrip></descripGrp><ntig><termGrp><term id="745706">Content</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1805494">Ibirimo</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><t