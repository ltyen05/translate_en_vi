ition">A logical entity that enables a server to communicate with an iSCSI device over an Internet Protocol (IP) network. Each iSCSI initiator can have one or more network adapters through which communication is established.</descrip></descripGrp><ntig><termGrp><term id="231624">iSCSI initiator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="505242">mutangiza iSCSI</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38762_2258876_2596981"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A commitment for a resource to perform a particular type of work for a particular amount of time that was proposed by a Project manager and reviewed by a Resource Manager.</descrip></descripGrp><ntig><termGrp><term id="2258876">engagement</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="2596981">ubwitabire</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38860_2259500_2263075"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The first-party Windows app for playing commercial and homemade DVD-Video discs.</descrip></descripGrp><ntig><termGrp><term id="2259500">DVD Player</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="226