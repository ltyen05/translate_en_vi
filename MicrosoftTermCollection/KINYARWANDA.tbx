finition">A graphical representation of data where the intensity of color corresponds to the related analytical data. For example, low values in a range appear as blue (cold) and high values as red (hot).</descrip></descripGrp><ntig><termGrp><term id="2593079">heatmap</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="2342880">ikarita y’ubushyuhe</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2599_211415_505201"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Intel microprocessor that uses explicitly parallel instruction set computing and 64-bit memory addressing. "Itanium-based" refers to systems or platforms that are based on the Itanium processor. "Itanium2-based" refers to systems or platforms that are based on the Itanium2 processor. "Itanium architecture-based" refers to systems or platforms that are based on the Itanium and Itanium2 processors.</descrip></descripGrp><ntig><termGrp><term id="211415">Itanium</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="505201">Itaniyomu</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25992_1253847_1653062"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An online community where members can virtually socialize by posting and commenting on a newsfeed, by chatting, and by sharing photos, images, articles, and other content.</descrip></descripGrp><ntig><termGrp><term id="1253847">social network</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1653062">ihuriro ry'abantu</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25992_2696313_1653062"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An online community where members can virtually socialize by posting and commenting on a newsfeed, by chatting, and by sharing photos, images, articles, and other content.</descrip></descripGrp><ntig><termGrp><term id="2696313">network</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1653062">ihuriro ry'abantu</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26004_1256406_1910505"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A short summary of the contents of a document that gives the reader a quick overview of its topic and purpose.</descrip></descripGrp><ntig><termGrp><term id="1256406">abstract</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1910505">incamake</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26050_1262328_2803165"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To merge information from multiple places into one.</descrip></descripGrp><ntig><termGrp><term id="1262328">consolidate</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="2803165">guhuza</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26073_1262378_1910506"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of features that incorporates elements of social networking into the Outlook experience. It provides relevant contextual information about the people whom users interact with in Outlook, based on local data (email and calendar items) and social activity (news feeds and status updates).</descrip></descripGrp><ntig><termGrp><term id="1262378">Outlook Social Connector</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1910506">Impuzambaga ya Outlook</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26073_1262378_1910510"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of features that incorporates elements of social networking into the Outlook experience. It provides relevant contextual information about the people whom users interact with in Outlook, based on local data (email and calendar items) and social activity (news feeds and status updates).</descrip></descripGrp><ntig><termGrp><term id="1262378">Outlook Social Connector</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1910510">OSC</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26073_1262401_1910506"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of features that incorporates elements of social networking into the Outlook experience. It provides relevant contextual information about the people whom users interact with in Outlook, based on local data (email and calendar items) and social activity (news feeds and status updates).</descrip></descripGrp><ntig><termGrp><term id="1262401">OSC</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1910506">Impuzambaga ya Outlook</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26073_1262401_1910510"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of features that incorporates elements of social networking into the Outlook experience. It provides relevant contextual information about the people whom users interact with in Outlook, based on local data (email and calendar items) and social activity (news feeds and statu