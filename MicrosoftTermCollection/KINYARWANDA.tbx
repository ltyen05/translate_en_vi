262699">Personal Area Network</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="505456">PAN</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13210_262700_505455"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A small, Internet Protocol (IP)-based network. It is usually used for short-range, ad-hoc communication between devices and computers. A PAN may also be used to enable connectivity to a larger Local Area Network (LAN), Wide-Area Network (WAN), or the Internet. Windows XP supports the Bluetooth PAN service so you can create Personal Area Networks using Bluetooth.</descrip></descripGrp><ntig><termGrp><term id="262700">PAN</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="505455">umuyoboro wihariye</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13210_262700_505456"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A small, Internet Protocol (IP)-based network. It is usually used for short-range, ad-hoc communication between devices and computers. A PAN may also be used to enable connectivity to a larger Local Area Network (LAN), Wide-Area Network (WAN), or the Internet. Windows XP supports the Bluetooth PAN service so you can create Personal Area Networks using Bluetooth.</descrip></descripGrp><ntig><termGrp><term id="262700">PAN</term><te