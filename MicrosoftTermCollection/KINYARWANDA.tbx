4293"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows the user to apply custom or default markers to items (e.g. Outlook messages or OneNote content) in order to categorize information for easy retrieval and sorting.</descrip></descripGrp><ntig><termGrp><term id="748513">Categories</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1574293">Ibyiciro</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20861_748513_1771374"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows the user to apply custom or default markers to items (e.g. Outlook messages or OneNote content) in order to categorize information for easy retrieval and sorting.</descrip></descripGrp><ntig><termGrp><term id="748513">Categories</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1771374">Utudirishya</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20867_2676671_2680005"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that allows the user to fill cells with data that follows a pattern or that is based on data in other cells.</descrip></descripGrp><ntig><termGrp><term id="2676671">AutoFill</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="2680005">Kwiyuzuzamo</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20867_752822_2680005"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that allows the user to fill cells with data that follows a pattern or that is based on data in other cells.</descrip></descripGrp><ntig><termGrp><term id="752822">Auto Fill</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="2680005">Kwiyuzuzamo</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2087_22056_1805484"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A page where there is no information displayed</descrip></descripGrp><ntig><termGrp><term id="22056">blank page</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1805484">paji iriho ubusa</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20874_757176_1910309"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tool used to turn on language-specific options for the languages one wants to use with a product.</descrip></descripGrp><ntig><termGrp><term id="757176">Language Settings tool</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1910309">Igikoresho cy'igenamiterere ry'indimi</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20884_759071_1576447"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Any hardware or software that can detect events or environmental changes, such as your current location or the amount of light around your computer. For example, a notebook with a location sensor, such as a Global Positioning System (GPS) receiver, can determine your exact location. An ambient light sensor can detect when there is a change in lighting, and then a program can use that information to adjust the brightness of your screen.</descrip></descripGrp><ntig><termGrp><term id="759071">sensor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1576447">gahunahuna</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20888_759108_1574325"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A device that includes an antenna, a radio receiver, and a processor for use with the worldwide GPS (Global Positioning System). A GPS receiver uses position and time information from four GPS satellites to calculate precise information about its current location, its speed of travel, and the current time.</descrip></descripGrp><ntig><termGrp><term id="759108">GPS receiver</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1574325">inyakirizi ya GPS</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20889_759109_1771239"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A category of sensor that can detect the current location of your computer.</descrip></descripGrp><ntig><termGrp><term id="759109">location sensor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1771239">icyumvirizo cy’ahantu</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20907_759640_1771234"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An area within the Windows Control Panel that provides support for sensors such as enabling, disabling or uninstalling sensors and sensor-enabled applications, changing sensor settings, etc.</descrip></descripGrp><ntig><termGrp><term id="759640">Location and Other Sensors</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1771234">Ibyumvirizo by’ahantu n’ibindi</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><ter