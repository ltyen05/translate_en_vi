y a KPI or scorecard are available.</descrip></descripGrp><ntig><termGrp><term id="592433">validate</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1805593">kwemeza</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16584_592444_2591536"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A directory name, used in an address, that corresponds to a physical directory on the server.</descrip></descripGrp><ntig><termGrp><term id="592444">virtual directory</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="2591536">ububiko budafatika</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16594_592578_2193722"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A service or feature that renders the audio content of a television or video program as text on the screen. These captions are usually visible only if decoded or activated.</descrip></descripGrp><ntig><termGrp><term id="592578">closed captioning</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="2193722">insobanuro zifunze</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16607_592811_1576560"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A numeric or other designation appended to a product name to identify a particular release.​</descrip></descripGrp><ntig><termGrp><term id="592811">version</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1576560">verisiyo</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16609_592813_1771671"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An effect applied to a graphical object that typically reduces the difference between the outline of the object and the graphical area next to it.</descrip></descripGrp><ntig><termGrp><term id="592813">blur</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1771671">ikizinga</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16647_594141_1990178"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Software that provides encryption for sensitive data, such as passwords, in applications.</descrip></descripGrp><ntig><termGrp><term id="594141">encryption provider</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1990178">intangisobeka</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16658_600620_1910205"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The round button in the lower left-hand corner of the Windows screen that allows the user to click and display the Start menu.</descrip></descripGrp><ntig><termGrp><term id="600620">Start button</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1910205">Buto yo gutangira</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16665_601385_2626388"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An attack by a malicious user or malicious software on a computer or operating system to find a secret password or a symmetric encryption key by guessing passwords or keys until the correct password or key is discovered.</descrip></descripGrp><ntig><termGrp><term id="601385">key search attack</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="2626388">igitero cyinjira ku ngufu</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16665_601385_2626392"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An attack by a malicious user or malicious software on a computer or operating system to find a secret password or a symmetric encryption key by guessing passwords or keys until the correct password or key is discovered.</descrip></descripGrp><ntig><termGrp><term id="601385">key search attack</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="2626392">igitero cy'ishakisha fatizo</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16665_601386_2626388"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An attack by a malicious user or malicious software on a computer or operating system to find a secret password or a symmetric encryption key by guessing passwords or keys until the correct password or key is discovered.</descrip></descripGrp><ntig><termGrp><term id="601386">brute force attack</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="2626388">igitero cyinjira ku ngufu</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16665_601386_2626392"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An attack by a malicious user or malicious software on a computer or operating system to find a secret password or a symmetric encryption key by guessing passwords or keys until the correct password or key is discovered.</descrip></descripGrp><ntig><termGrp><t