to a browser, which in turn saves it and sends it back when accessing the Web server again.</descrip></descripGrp><ntig><termGrp><term id="550">cookie</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="503963">kuki</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27555_1381690_1597632"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A website or service that a customer can connect to in order to share what they've been doing on other websites, see their friends and their updates from other services in Windows Live, or share their Windows Live activity on other websites.</descrip></descripGrp><ntig><termGrp><term id="1381690">service</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1597632">serivisi</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27565_1382243_1597783"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A folder someone using Windows Live Sync is synchronizing between computers.</descrip></descripGrp><ntig><termGrp><term id="1382243">synced folder</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1597783">ububiko bwahujwe</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpee