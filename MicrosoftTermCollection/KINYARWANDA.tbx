rk resources.</descrip></descripGrp><ntig><termGrp><term id="606">credentials</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1987855">amakuru yo kwinjira</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12369_606_503964"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Information that includes identification and proof of identification that is used to gain access to local and network resources.</descrip></descripGrp><ntig><termGrp><term id="606">credentials</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="503964">umwirondoro</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12370_17867_504121"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The technology that is based on the Component Object Model (COM) that enables interoperability among ActiveX components, including OLE components. Formerly referred to as OLE Automation.</descrip></descripGrp><ntig><termGrp><term id="17867">Automation</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="504121">Kwikora</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12381_121120_504826"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that consists of advanced text wrap functionality, allowing the user to select from various styles to specify how text flows around objects or graphics in a document.</descrip></descripGrp><ntig><termGrp><term id="121120">text wrapping</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="504826">ifunikamwandiko</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12382_34696_504252"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The three-dimensional space that is defined by a set of coordinates for representing color on devices such as monitors, scanners, and printers. For example, in the LAB color space, the colors are defined in terms of their luminance or whiteness (L), redness-greenness (A), and yellowness-blueness (B); the HVC system uses hue (H), value (V), and chroma (C). The two most common color space models are RGB and YUV.</descrip></descripGrp><ntig><termGrp><term id="34696">color space</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="504252">imiterere y'ibara</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12382_34697_504252"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The three-dimensional space that is defined by a set of coordinates for representing color on devices such as monitors, scanners, and printers. For example, in the LAB color space, the colors are defined in terms of their luminance or whiteness (L), redness-greenness (A), and yellowness-blueness (B); the HVC system uses hue (H), value (V), and chroma (C). The two most common color space models are RGB and YUV.</descrip></descripGrp><ntig><termGrp><term id="34697">color space model</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="504252">imiterere y'ibara</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12383_63110_1909855"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of breaking a word between syllables at the end of a line or to separate the parts of a compound word.</descrip></descripGrp><ntig><termGrp><term id="63110">hyphenation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1909855">gutandukanya n'akanyerezo</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12387_262437_505418"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An encryption algorithm that uses a 56-bit key and maps a 64-bit input block to a 64-bit output block. The key appears to be a 64-bit key, but one bit in each of the eight bytes is used for odd parity, resulting in 56 bits of usable key.</descrip></descripGrp><ntig><termGrp><term id="262437">Data Encryption Standard</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="505418">Data Encryption Standard</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12387_262437_505419"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An encryption algorithm that uses a 56-bit key and maps a 64-bit input block to a 64-bit output block. The key appears to be a 64-bit key, but one bit in each of the eight bytes is used for odd parity, resulting in 56 bits of usable key.</descrip></descripGrp><ntig><termGrp><term id="262437">Data Encryption Standard</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="505419">DES</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12387_262438_505418"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An encryption algorithm that uses a 56-bit key and maps a 64-bit input block to a 64-bit output block. The key appears to be a 64-bit key, but one bit in each of the eight bytes is used for odd parity, resulting in 56 bits of usable key.</descrip></descripGrp><ntig><termGrp><term id="262438">DES</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="505418">Data Encryption Standard</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12387_262438_505419"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An encryption algorithm that uses a 56-bit key and maps a 64-bit input block to a 64-bit output block. The key appears to be a 64-bit key, but one bit in each of the eight bytes is used for odd parity, resulting in 56 bits of usable key.</descrip></descripGrp><ntig><termGrp><term id="262438">DES</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="505419">DES</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1239_25547_1978022"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The indication that the phone is busy.</descrip></descripGrp><ntig><termGrp><term id="25547">busy signal</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1978022">ikimenyetso cyo kuvugirwaho</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12395_231972_1910069"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Total values for all cells in a row or all cells in a column of a PivotTable report. Values in a grand total row or column are calculated by using the same summary function used in the data area of the PivotTable report.</descrip></descripGrp><ntig><termGrp><term id="231972">PivotTable grand totals</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1910069">Ibiteranyo rusange bya PivotTable</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="124_53143_504411"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The inability of a computer system or related device to operate reliably or to operate at all.</descrip></descripGrp><ntig><termGrp><term id="53143">failure</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="504411">kudakora</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12405_184041_1910034"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mode that enables the user to move a document by dragging it. Panning mode is available when a Word document is displayed on a preview pane.</descrip></descripGrp><ntig><termGrp><term id="184041">panning mode</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1910034">uburyo bwo kwimura</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12419_237283_505368"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An enhanced spell-check feature that looks at words before or after the word in question to assess proper usage. This allows the software to flag correctly-spelled words as 'wrong' if the usage appears to be incorrect.</descrip></descripGrp><ntig><termGrp><term id="237283">Contextual Spelling</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="505368">Kugenzura imyandikire runaka</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12434_231840_2329059"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To remove unread markers from specified elements in the workspace.</descrip></descripGrp><ntig><termGrp><term id="231840">mark read</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="2329059">kwerekana ko byasomwe</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12439_316643_505701"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An optical device found in scanners and fax machines that moves across the subject being scanned, converts light and dark areas to electrical signals, and sends those signals to the scanning system for processing.</descrip></descripGrp><ntig><termGrp><term id="316643">scan head</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="505701">ijisho sikaneri</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12442_155338_1910294"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of extensions to the Hypertext Transfer Protocol (HTTP) that facilitates collaborative editing and file management between users located remotely from each other on the Internet.</descrip></descripGrp><ntig><termGrp><term id="155338">Web Distributed Authoring and Versioning</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="1910294">Ubwanditsi n'ihangaverisiyo bitangwa ku isi hose (WWDAV)</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12442_155338_505064"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of extensions to the Hypertext Transfer Protocol (HTTP) that facilitates collaborative editing and file management between users located remotely from each other on the Internet.</descrip></descripGrp><ntig><termGrp><term id="155338">Web Distributed Authoring and Versioning</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumbe