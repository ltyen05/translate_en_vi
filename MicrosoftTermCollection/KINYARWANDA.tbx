erm id="1814249">Online</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="2062434">Kuri Interineti</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33722_1814262_2062463"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Skype product that allows a user to call directly to Skype from landlines and mobile phones.</descrip></descripGrp><ntig><termGrp><term id="1814262">Skype Number</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="2062463">Nomero ya Skype</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33723_1814251_2062464"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An organization that cooperates with Skype; the cooperation ranges from developing mutual software to selling products specially tailored for the organization.</descrip></descripGrp><ntig><termGrp><term id="1814251">Skype partner</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="2062464">Umufatanyabikorwa wa Skype</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33724_1814252_2062435"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To pay for a paid feature at the moment the feature is used. For example, to pay for Skype's calling phones feature with Skype Credit that is either already owned or purchased specially for the occasion.</descrip></descripGrp><ntig><termGrp><term id="1814252">pay as you go</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="2062435">kwishyura uko ukoresheje</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33725_1814253_2062437"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To pay once a month for using Skype paid features such as calling phones or sending SMS messages; e.g., to pay for a monthly subscription.</descrip></descripGrp><ntig><termGrp><term id="1814253">pay monthly</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="rw-RW"><ntig><termGrp><term id="2062437">kwishyura buri kwezi</term><termNote type="geographicalUsage">RWA</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33726_1814254_2062438"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables users to preview photos and send them to contacts.</descrip></descripGrp><ntig><termGrp><term id="1814254">photo sharing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber"