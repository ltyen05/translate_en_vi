ermEntry id="10828_245217_474553"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A monitoring option in real-time spyware protection that monitors various types and areas of software activity on your computer.</descrip></descripGrp><ntig><termGrp><term id="245217">agent</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="474553">ಏಜೆಂಟ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10839_2108_473165"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A row, column, or block of buttons or icons, usually displayed across the top of the screen, that represent tasks or commands within the program. The toolbar buttons provide shortcuts to common tasks frequently accessed from the menus.</descrip></descripGrp><ntig><termGrp><term id="2108">toolbar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="473165">ಪರಿಕರ ಪಟ್ಟಿ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10841_180035_474305"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A standard Windows control that is similar to a standard text box, except that it also supports individual character and paragraph properties.</descrip></descripGrp><ntig><termGrp><term id="180035">rich-text box</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></