eficial when you want to view or print a chart or a PivotChart report with its source data or other information in a worksheet.</descrip></descripGrp><ntig><termGrp><term id="141438">embedded chart</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1903028">ಎಂಬೆಡ್ ಮಾಡಿದ ಚಾರ್ಟ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10871_30752_473392"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A graphic or diagram that displays data or the relationships between sets of data in pictorial rather than numeric form.</descrip></descripGrp><ntig><termGrp><term id="30752">chart</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="473392">ಚಾರ್ಟ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10894_225713_474403"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A list that can be opened to reveal all choices for a given field.</descrip></descripGrp><ntig><termGrp><term id="225713">drop-down list</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="474403">ಡ್ರಾಪ್-ಡೌನ್ ಪಟ್ಟಿ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10894_475180_474403"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A list that can be opened to reveal all choices for a given field.</descrip></descripGrp><ntig><termGrp><term id="475180">picklist</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="474403">ಡ್ರಾಪ್-ಡೌನ್ ಪಟ್ಟಿ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10894_721653_474403"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A list that can be opened to reveal all choices for a given field.</descrip></descripGrp><ntig><termGrp><term id="721653">dropdown list</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="474403">ಡ್ರಾಪ್-ಡೌನ್ ಪಟ್ಟಿ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10899_234822_474492"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To make resources, such as folders, printers, records, etc., unavailable to others.</descrip></descripGrp><ntig><termGrp><term id="234822">unshare</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="474492">ಹಂಚದಿರು</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote ty