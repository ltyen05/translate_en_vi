99_2556223"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The content that is transferred from the Xbox service to a console.</descrip></descripGrp><ntig><termGrp><term id="2258899">download</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2556223">ಡೌನ್‌ಲೋಡ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38767_2258900_2556239"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The term for Xbox Live Gold membership sharing privileges on Xbox One.</descrip></descripGrp><ntig><termGrp><term id="2258900">Home Gold</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2556239">ಹೋಮ್ ಗೋಲ್ಡ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38768_2258901_2556252"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A system that allows players to queue up against new players or similarly ranked opponents aiming at moving up in the rankings.</descrip></descripGrp><ntig><termGrp><term id="2258901">matchmaking</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2556252">ಹೊಂದಾಣಿಕೆ ಮಾಡುವಿಕೆ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelec