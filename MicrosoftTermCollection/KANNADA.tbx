US"><descripGrp><descrip type="definition">Attack activity involving establishing communications to report status, relay reconnaissance results, receive additional commands, or transmit stolen data.</descrip></descripGrp><ntig><termGrp><term id="2819510">C&amp;C</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2823436">C2</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48466_2738461_2743024"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The view that integrates Advanced eDiscovery with the Microsoft 365 compliance center.</descrip></descripGrp><ntig><termGrp><term id="2738461">eDiscovery</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2743024">eDiscovery</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48467_2738464_2743028"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft 365 compliance center view that allows users to define policies that capture email, Teams channels and chats, and 3rd-party communications in their organization so it can be examined by reviewers to see if it is compliant with the organization's policies.</descrip></descripGrp><ntig><termGrp><term id="2738464">Supervision</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></