en doing on other websites, see their friends and their updates from other services in Windows Live, or share their Windows Live activity on other websites.</descrip></descripGrp><ntig><termGrp><term id="1381690">service</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1517370">ಸೇವೆ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27556_1381691_1461616"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A service that a user has connected to Windows Live.</descrip></descripGrp><ntig><termGrp><term id="1381691">connected service</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1461616">ಸಂಪರ್ಕ ಹೊಂದಿರುವ ಸೇವೆ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27565_1382243_2290110"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A folder someone using Windows Live Sync is synchronizing between computers.</descrip></descripGrp><ntig><termGrp><term id="1382243">synced folder</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2290110">ಸಿಂಕ್ ಮಾಡಿದ ಫೋಲ್ಡರ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammatical