descrip type="definition">The Financial Excel function that returns the number of days in the coupon period that contains the settlement date.</descrip></descripGrp><ntig><termGrp><term id="2955549">COUPDAYS</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2968496">COUPDAYS</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52338_2955550_2968497"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Financial Excel function that returns the number of days from the settlement date to the next coupon date.</descrip></descripGrp><ntig><termGrp><term id="2955550">COUPDAYSNC</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2968497">COUPDAYSNC</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52339_2955551_2968498"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Financial Excel function that returns the next coupon date after the settlement date.</descrip></descripGrp><ntig><termGrp><term id="2955551">COUPNCD</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2968498">COUPNCD</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNot