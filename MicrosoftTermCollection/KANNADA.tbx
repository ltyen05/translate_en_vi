m><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2328777">ಅತ್ಯುತ್ತಮ ರೇಟ್ ಮಾಡಿದ ಅಪ್ಲಿಗಳು</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33568_1802884_2198057"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A description for music or videos stored in the cloud that users may access from their phone. Used for Xbox Music and any other potential cloud-based media services.</descrip></descripGrp><ntig><termGrp><term id="1802884">cloud collection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2198057">ಕ್ಲೌಡ್ ಸಂಗ್ರಹಣೆ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33569_1802886_2198068"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The amount of data the user can download/upload through the carrier's network each month without being billed additional charges.</descrip></descripGrp><ntig><termGrp><term id="1802886">data limit</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2198068">ಡೇಟಾ ಮಿತಿ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33570_2164314_2177440"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The pre-loaded app that allows users to better monitor and manage their data usage on their phone or PC. It can notify users when they are close to their cellular data limit and delay some data-intensive tasks until the phone or PC is connected to Wi-Fi.</descrip></descripGrp><ntig><termGrp><term id="2164314">Data usage</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2177440">ಡೇಟಾ ಬಳಕೆ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33571_1802888_2198077"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The button label to note that the user does not like a suggestion in Local Scout.</descrip></descripGrp><ntig><termGrp><term id="1802888">dislike</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2198077">ಇಷ್ಟಪಡದಿರು</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33576_1803504_2198089"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The default room name in the Rooms feature of the People Hub. Based on the concept of the "family room" in many homes, in which family and guests gather for group activities.</descrip></descripGrp><ntig><termGrp><term id="1803504">Family Room</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2198089">ಕುಟುಂಬ ಕೊಠಡಿ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33577_1803505_2198202"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A place on the phone where families (or other close-knit groups) can stay in touch. Rooms take the form of a panorama that lives in the People Hub. The panorama includes a family chat card, a shared calendar, a shared photo album, and a shared notebook. Users ask others to join their Room via an SMS invite.</descrip></descripGrp><ntig><termGrp><term id="1803505">room</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2198202">ಕೊಠಡಿ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33578_1803510_2198090"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An NFC-enabled card (like a credit card) that users can use for payments or other transactions even when the phone is locked.</descrip></descripGrp><ntig><termGrp><term id="1803510">fast card</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2198090">ಫಾಸ್ಟ್ ಕಾರ್ಡ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33579_1803511_2198098"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A flash mode used to set off the flash automatically according to the ambient light conditions.</descrip></descripGrp><ntig><termGrp><term id="1803511">flash auto</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2198098">ಫ್ಲ್ಯಾಶ್ ಸ್ವಯಂ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33580_1803512_2198099"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A flash mode when the phone's built-in camera flash is set to off.</descrip></descripGrp><ntig><termGrp><term id="1803512">flash off</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2198099">ಫ್ಲ್ಯಾಶ್ ಆಫ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33581_1803513_2198100"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A flash mode when the phone's built-in camera flash is set to on.</descrip></descripGrp><ntig><termGrp><term id="1803513">flash on</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2198100">ಫ್ಲ್ಯಾಶ್ ಆನ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33582_1803514_2198102"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A camera on the front of an electronic device (such as a smartphone), which faces the user. This allows the user to video chat with another person also using a front-facing device. It may also be used to take videos and pictures.</descrip></descripGrp><ntig><termGrp><term id="1803514">front</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2198102">ಮುಂದೆ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33583_1803517_2074384"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Skype To Go number that is used like a calling card, that allows a user to enter a number manually and dial any phone number.</descrip></descripGrp><ntig><termGrp><term id="1803517">Access number</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2074384">ಪ್ರವೇಶ ಸಂಖ್ಯೆ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33584_1803518_2198107"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A text message thread between a group of people (usually more than 2). It allows you to keep all the replies from people in one thread, so that you can see the whole conversation.</descrip></descripGrp><ntig><termGrp><term id="1803518">group text</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2198107">ಗುಂಪು ಪಠ್ಯ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33585_1803519_1992392"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app that provides easy access to Help and how-to content as well as helpful tips for users.</descrip></descripGrp><ntig><termGrp><term id="1803519">Help+Tips</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1992392">ಸಹಾಯ+ಸುಳಿವುಗಳು</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33586_1803521_2074467"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A product that enables a user to call mobile phones and landlines from a mobile phone or landline via Skype.</descrip></descripGrp><ntig><termGrp><term id="1803521">Skype To Go number</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2074467">Skype To Go ಸಂಖ್ಯೆ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33587_1803522_2198122"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An APN (Access Point Name) that determines the cellular data networks to which a phone can connect. It includes information about what kind of connection, security, and type of IP address the phone should use for the Internet connection.</descrip></descripGrp><ntig><termGrp><term id="1803522">Internet APN</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2198122">ಇಂಟರ್ನೆಟ್ APN</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33588_1803523_2198150"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The APN (Access Point Name) a phone can use to send MMS messages (text messages with multimedia files attached).</descrip></descripGrp><ntig><termGrp><term id="1803523">MMS APN</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2198150">MMS APN</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33589_1803524_2198125"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The company or organization that issued the user the card they're adding to their wallet. For example, an issuer could be a bank.</descrip></descripGrp><ntig><termGrp><term id="1803524">issuer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2198125">ವಿತರಕ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33591_1803526_2198126"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The title of the screen prompting the user to sign in to his existing Microsoft account or to create a Microsoft account. By using the Microsoft account, Windows Phone will keep the user's important information and belongings synchronized in one place, helping keep the user's life organized and harmonious.</descrip></descripGrp><ntig><termGrp><term id="1803526">Keep your life in sync</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2198126">ನಿಮ್ಮ ಬದುಕನ್ನು ಸಿಂಕ್‌ನಲ್ಲಿರಿಸಿ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33593_1803746_2198128"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app that helps parents provide their children with controlled access to their phones. In Kid's Corner, kids can only use the apps, games, and other content that parents select.</descrip></descripGrp><ntig><termGrp><term id="1803746">Kid's Corner</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2198128">ಮಗುವಿನ ಕಾರ್ನರ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33594_1803747_2198354"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">List of the top players in a game or other competition on Xbox Live.</descrip></descripGrp><ntig><termGrp><term id="1803747">leaderboard</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2198354">ಲೀಡರ್‌ಬೋರ್ಡ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33594_3144583_2198354"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">List of the top players in a game or other competition on Xbox Live.</descrip></descripGrp><ntig><termGrp><term id="3144583">Xbox leaderboard</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2198354">ಲೀಡರ್‌ಬೋರ್ಡ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33595_1803748_2198129"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A first or third-party application that works with the Windows Phone camera to offer additional features and functionality for users taking and editing pictures.</descrip></descripGrp><ntig><termGrp><term id="1803748">lens</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2198129">ಲೆನ್ಸ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33596_1803750_2198141"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A relationship of being a member of an organization, such as a gym or club.</descrip></descripGrp><ntig><termGrp><term id="1803750">membership</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2198141">ಸದಸ್ಯತ್ವ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33597_1803751_2198143"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A business or organization that has provided a coupon that can be used at their store.</descrip></descripGrp><ntig><termGrp><term id="1803751">merchant</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2198143">ವ್ಯಾಪಾರಿ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33598_1803752_2198151"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A server that stores MMS message content sent from phones on a mobile operator's network.</descrip></descripGrp><ntig><termGrp><term id="1803752">MMSC</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2198151">MMSC</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33599_1803753_2198152"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A setting where the user provides the date when their monthly data usage resets to 0.</descrip></descripGrp><ntig><termGrp><term id="1803753">monthly reset date</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2198152">ಮಾಸಿಕ ಮರುಹೊಂದಿಕೆ ದಿನಾಂಕ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33602_1803757_2074386"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An organization or person that promotes Skype on its website or (re)sells its regular products.</descrip></descripGrp><ntig><termGrp><term id="1803757">affiliate</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2074386">ಅಂಗಸಂಸ್ಥೆ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33603_1803758_2074387"