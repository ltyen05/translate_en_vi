termEntry id="38605_2244852_2253549"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Sway button that allows users to create a bulleted list out of their text.</descrip></descripGrp><ntig><termGrp><term id="2244852">Bulleted list</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2253549">ಬುಲೆಟ್ ಮಾಡಿದ ಪಟ್ಟಿ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38625_2244876_2253728"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Sway button that allows users to create a numbered list out of their text.</descrip></descripGrp><ntig><termGrp><term id="2244876">Numbered list</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2253728">ಸಂಖ್ಯಾ ಪಟ್ಟಿ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38626_2244888_2253769"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Sway link that opens an email that allows users to report a violation of Sway’s terms of use.</descrip></descripGrp><ntig><termGrp><term id="2244888">Report a violation</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2253769">ಉಲ್ಲಂಘನೆ ವರದಿಮಾಡಿ</term><termNote type="geographicalUsage">IND</termNote><ter