partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2198114">ಹೋಮ್ ಫೋನ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29736_1510059_2198293"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Outlook contact’s professional telephone number. Not a company’s main phone number.</descrip></descripGrp><ntig><termGrp><term id="1510059">work phone</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2198293">ಕೆಲಸದ ಫೋನ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29738_1510063_2198367"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The phone feature that enables speech recognition, pressing and holding the Start button.</descrip></descripGrp><ntig><termGrp><term id="1510063">Speech</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2198367">ಮಾತು</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29753_1510091_2198217"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Usually the spouse or domestic partner of a contact. Detail that can be added to a contact’s profile, listed under "other."</descrip></descripGrp><ntig><termGrp><term id="1510091">significant other</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2198217">ಪ್ರಮುಖ ಇತರೆ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29757_1510112_2198031"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The button that appears during an active phone call, allowing a user to add another person to his/her conference call.</descrip></descripGrp><ntig><termGrp><term id="1510112">add call</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2198031">ಕರೆ ಸೇರಿಸು</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29760_1510117_2198244"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The text string displayed in the status bar for Call Progress, alternating with the callee's name, to prompt the user that he/she can tap the bar to return to the call.</descrip></descripGrp><ntig><termGrp><term id="1510117">tap to expand</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2198244">ವಿಸ್ತರಿಸಲು ತಟ್ಟಿ</term><termNote type="geographicalUsage">IND<