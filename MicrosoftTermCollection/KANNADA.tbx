="31664_1608240_1646433"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Windows Store service that enables end users to update apps one at a time or all at the same time for all apps purchased through the Windows Store.</descrip></descripGrp><ntig><termGrp><term id="1608240">App Update</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1646433">ಅಪ್ಲಿ ನವೀಕರಣ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31668_1611161_1779587"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The stage of an app in the certification process.</descrip></descripGrp><ntig><termGrp><term id="1611161">certification status</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1779587">ಪ್ರಮಾಣಪತ್ರ ಸ್ಥಿತಿ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31670_1612553_1646460"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A link that takes you to a precise location, such as a slide within a presentation, a section of a document, or a specific page within a site, instead of to the main page of the web site.</descrip></descripGrp><ntig><termGrp><term id="1612553">deep link</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1646460">ಡೀಪ್ ಲಿಂಕ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31681_1612562_1903533"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SharePoint site template that provides an entry point for users to access the business intelligence ecosystem.</descrip></descripGrp><ntig><termGrp><term id="1612562">Business Intelligence Center</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1903533">ವ್ಯವಹಾರ ಸುದ್ದಿ ಕೇಂದ್ರ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31683_1612565_1646657"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An API for AtomPub and syndication.</descrip></descripGrp><ntig><termGrp><term id="1612565">Web</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1646657">ವೆಬ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31688_1612737_1646495"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that a developer provides in an app for consumers to buy from within the app through an in-app purchase transaction.</descrip></descripGrp><ntig><termGrp><term id="1612737">in-app offer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1646495">ಅಪ್ಲಿ ಒಳಗಿನ ಕೊಡುಗೆ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31689_1612739_1646498"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A transaction performed by a consumer from within the context of an app to buy additional features for that app.</descrip></descripGrp><ntig><termGrp><term id="1612739">in-app purchase</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1646498">ಅಪ್ಲಿ ಒಳಗಿನ ಖರೀದಿ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3169_232421_1903144"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of shortcuts to folders that can be displayed in the Shortcuts pane.</descrip></descripGrp><ntig><termGrp><term id="232421">shortcut group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1903144">ಶಾರ್ಟ್‌ಕಟ್ ಸಮೂಹ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31692_1612750_1646563"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Applications in Windows Store are distributed with user-based licensing model. Windows runtime and application model will only allow applications that are for user-based license as well as signed by Windows Store to be installed/run on Windows 8.</descrip></descripGrp><ntig><termGrp><term id="1612750">Microsoft License Terms for Consumers</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1646563">ಗ್ರಾಹಕರಿಗೆ Microsoft ಪರವಾನಗಿ ನಿಯಮಗಳು</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31693_1612753_1646523"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Windows 8 all windows portal experiences support and persist Live ID logins streamlining the partner experience when working with multiple services and sites.</descrip></descripGrp><ntig><termGrp><term id="1612753">Microsoft account logins</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1646523">Microsoft ಖಾತೆ ಲಾಗಿನ್‌ಗಳು</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31698_1612764_1646845"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of notification sent via the Microsoft Push Notification Service to an app running on Windows Phone. The format and meaning of the data is determined by the app.</descrip></descripGrp><ntig><termGrp><term id="1612764">raw notification</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1646845">ಅಪರಿಷ್ಕೃತ ಪ್ರಕಟಣೆ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31699_1612765_1646833"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To purchase an app just before downloading and installing it.</descrip></descripGrp><ntig><termGrp><term id="1612765">purchase at download</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1646833">ಡೌನ್‌ಲೋಡ್ ಮೊದಲು ಖರೀದಿ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="317_141659_1319300"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An XML vocabulary that is used to transform XML data to another form, such as HTML, by means of a style sheet that defines presentation rules.</descrip></descripGrp><ntig><termGrp><term id="141659">Extensible Stylesheet Language</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1319300">ಎಕ್ಸ್‌ಟೆನ್ಸಿಬಲ್ ಸ್ಟೈಲ್‌ಶೀಟ್ ಭಾಷೆ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="317_141659_474145"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An XML vocabulary that is used to transform XML data to another form, such as HTML, by means of a style sheet that defines presentation rules.</descrip></descripGrp><ntig><termGrp><term id="141659">Extensible Stylesheet Language</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="474145">ನುಡಿ ವಿಸ್ತರಿಸುವ ಶೈಲಿಹಾಳೆ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="317_141659_474146"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An XML vocabulary that is used to transform XML data to another form, such as HTML, by means of a style sheet that defines presentation rules.</descrip></descripGrp><ntig><termGrp><term id="141659">Extensible Stylesheet Language</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="474146">XSL</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="317_141660_1319300"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An XML vocabulary that is used to transform XML data to another form, such as HTML, by means of a style sheet that defines presentation rules.</descrip></descripGrp><ntig><termGrp><term id="141660">XSL</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id