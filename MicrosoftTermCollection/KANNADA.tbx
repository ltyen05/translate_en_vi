ammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19800_685897_1251124"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file that contains the data that a program will process and store in a destination file.</descrip></descripGrp><ntig><termGrp><term id="685897">source file</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1251124">ಮೂಲ ಫಾಯಿಲ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19800_685897_1308139"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file that contains the data that a program will process and store in a destination file.</descrip></descripGrp><ntig><termGrp><term id="685897">source file</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1308139">ಮೂಲ ಫೈಲ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19806_2908028_1956582"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of resource record in the Domain Name System that associates a computer's true (canonical) name with any alias names also used by the computer. Some domain registrars use CNAME records to redirect or redelegate domain names.</descrip></descripGrp><ntig><termGrp><term id="2908028">CNAME</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1956582">CNAME ದಾಖಲೆ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19806_686253_1956582"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of resource record in the Domain Name System that associates a computer's true (canonical) name with any alias names also used by the computer. Some domain registrars use CNAME records to redirect or redelegate domain names.</descrip></descripGrp><ntig><termGrp><term id="686253">canonical name record</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1956582">CNAME ದಾಖಲೆ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19806_686254_1956582"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of resource record in the Domain Name System that associates a computer's true (canonical) name with any alias names also used by the computer. Some domain registrars use CNAME records to redirect or redelegate domain names.</descrip></descripGrp><ntig><termGrp><term id="686254">CNAME record</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1956582">CNAME ದಾಖಲೆ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19810_686305_1956640"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The owner of the customer relationship with customers who buy second-level domains. There may be many registrars for a single top-level domain. Registrars maintain detailed customer information in their databases, such as the customer's contact address, telephone number, and email address. Customers usually manage their second-level domains at the registrar's Web site, and the registrar updates the registry database when necessary (for example, when a customer renews a domain name).</descrip></descripGrp><ntig><termGrp><term id="686305">domain name registrar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1956640">ಡೊಮೇನ್ ಹೆಸರು ನೋಂದಣಿ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19828_686821_1956779"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of resource record in the Domain Name System (DNS) specifying how Internet email should be routed using the Simple Mail Transfer Protocol (SMTP). Each MX record contains a preference and a host name, so that the collection of MX records for a given domain name point to the servers that should receive email for that domain, and their priority relative to each other.</descrip></descripGrp><ntig><termGrp><term id="686821">mail exchange record</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1956779">MX ದಾಖಲೆ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19828_686822_1956779"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of resource record in the Domain Name System (DNS) specifying how Internet email should be routed using the Simple Mail Transfer Protocol (SMTP). Each MX record contains a preference and a host name, so that the collection of MX records for a given domain name point to the servers that should receive email for that domain, and their priority relative to each other.</descrip></descripGrp><ntig><termGrp><term id="686822">MX record</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1956779">MX ದಾಖಲೆ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19838_687152_1903302"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The distance between the camera’s lens and the image plane.</descrip></descripGrp><ntig><termGrp><term id="687152">focal length</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1903302">ಫೋಕಲ್ ಅಳತೆ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1989_48436_473544"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An area of storage that is formatted with a file system and has an identifier to access it.</descrip></descripGrp><ntig><termGrp><term id="48436">drive</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="473544">ಡ್ರೈವ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1992_108620_473921"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A program that searches for key words in documents, databases, Internet content or other files.</descrip></descripGrp><ntig><termGrp><term id="108620">search engine</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="473921">ಶೋಧ ಎಂಜಿನ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19941_690680_2855534"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To grant a person or entity the right to use a software product, as described in the terms of the license agreement.</descrip></descripGrp><ntig><termGrp><term id="690680">license</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2855534">ಪರವಾನಗಿ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19945_690967_1950708"><langSet xml:l