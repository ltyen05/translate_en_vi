67911"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The main landing or start page on Windows Live.</descrip></descripGrp><ntig><termGrp><term id="1117155">Windows Live Home</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1367911">Windows Live Home</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24249_1117156_1358655"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A function that enables a user to make a call to a phone, as opposed to calling another computer or using a webcam.</descrip></descripGrp><ntig><termGrp><term id="1117156">phone call</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1358655">ಫೋನ್ ಕಾಲ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2425_34681_473417"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A predefined set of harmonized colors that you can apply to text and objects. Text and objects with an applied scheme color will change automatically when you switch to a new color scheme or modify the current color scheme.</descrip></descripGrp><ntig><termGrp><term id="34681">color scheme</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="473417">ಬಣ್ಣ ಯೋಜನೆ</term><