"34152_1982878_1986264"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A physical or electronic card storing currency that customers can use to buy apps and similar items.</descrip></descripGrp><ntig><termGrp><term id="1982878">gift card</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1986264">ಉಡುಗೊರೆ ಕಾರ್ಡ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34187_1986150_1989383"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">likely to produce a situation in which one of several threads is waiting for the other thread(s) to do something</descrip></descripGrp><ntig><termGrp><term id="1986150">deadlock-prone</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1989383">ಬಿಕ್ಕಟ್ಟು-ಸಂಭಾವ್ಯ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34188_1986213_1989409"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An administrative user who has been granted the permissions to add, remove, and modify administrative users and their administrative assignments.</descrip></descripGrp><ntig><termGrp><term id="1986213">security administrator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1989409">ಭದ್ರತಾ ಕಾರ್ಯನ