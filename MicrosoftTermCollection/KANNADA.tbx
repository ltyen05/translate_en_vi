್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="47982_2719338_2727895"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app that is accessible via Microsoft Teams that allows users to award each other with badges.</descrip></descripGrp><ntig><termGrp><term id="2719338">Praise</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2727895">ಮೆಚ್ಚುಗೆ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="47983_2703685_2711281"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Kudos badge that users can award someone when he/she has achieved a specific goal.</descrip></descripGrp><ntig><termGrp><term id="2703685">Achiever</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2711281">ಸಾಧಕ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="47984_2703686_2711282"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Kudos badge that users can award someone for maintaining a positive attitude.</descrip></descripGrp><ntig><termGrp><term id="2703686">Always Positive</term><termNote type="partOfSpeech">Prope