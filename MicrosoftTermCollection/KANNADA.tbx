359997_475141"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A field in a table that draws data from another table.</descrip></descripGrp><ntig><termGrp><term id="359997">Lookup field</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="475141">ನೋಡುವ ಕ್ಷೇತ್ರ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14856_370913_1793080"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In a cascading style sheet style definition (or style rule), the HTML element linked to a particular set of style properties and values.</descrip></descripGrp><ntig><termGrp><term id="370913">selector</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1793080">ಸೆಲೆಕ್ಟರ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14866_396930_1956649"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A distribution group that uses recipient filters and conditions to derive its membership at the time the message is sent.</descrip></descripGrp><ntig><termGrp><term id="396930">dynamic distribution group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1956649">ಡೈನಮಿಕ್ ವಿತರಣೆ ಗುಂಪು</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeec