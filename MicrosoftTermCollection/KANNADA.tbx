><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14713_375730_1423573"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An indent where the text is displaced into the left margin if text direction is set to left-to-right, or toward the right margin if text direction is set to right-to-left.</descrip></descripGrp><ntig><termGrp><term id="375730">outdent</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1423573">ಔಟ್ ಡೆಂಟ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14713_375730_473787"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An indent where the text is displaced into the left margin if text direction is set to left-to-right, or toward the right margin if text direction is set to right-to-left.</descrip></descripGrp><ntig><termGrp><term id="375730">outdent</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="473787">ಋಣಾತ್ಮಕ ಇಂಡೆಂಟ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14713_83924_1423573"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An indent where the text is displaced into the left margin if text dire