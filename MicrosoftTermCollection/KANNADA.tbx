79">browser</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="474053">ವೆಬ್ ಬ್ರೌಸರ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5712_131979_474054"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A software program used to display webpages and to navigate the Internet.</descrip></descripGrp><ntig><termGrp><term id="131979">browser</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="474054">ಬ್ರೌಸರ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5712_1362689_474053"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A software program used to display webpages and to navigate the Internet.</descrip></descripGrp><ntig><termGrp><term id="1362689">web browser</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="474053">ವೆಬ್ ಬ್ರೌಸರ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5712_1362689_474054"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A software program used to display webpages and to navigate the Internet.</descrip></descripGrp><ntig><termGrp><term id="1362689">web browser</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="474054">ಬ್ರೌಸರ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5719_27856_473364"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A directive to an email program to send a complete copy of a given piece of mail to another individual. The use of cc mail addressing, as opposed to directly addressing the mail to a person, generally implies that the recipient is not required to take any action; the message is for informational purposes only. In a cc directive, the fact that this recipient received the mail is printed in the mail header and is thus known to all other recipients.</descrip></descripGrp><ntig><termGrp><term id="27856">carbon copy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="473364">ಕಾರ್ಬನ್ ಪ್ರತಿ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5719_27856_473365"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A directive to an email program to send a complete copy of a given piece of mail to another individual. The use of cc mail addressing, as opposed to directly addressing the mail to a person, generally implies that the recipient is not required to take any action; the message is for informational purposes only. In a cc directive, the fact that this recipient received the mail is printed in the mail header and is thus known to all other recipients.</descrip></descripGrp><ntig><termGrp><term id="27856">carbon copy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="473365">cc</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5719_27856_473366"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A directive to an email program to send a complete copy of a given piece of mail to another individual. The use of cc mail addressing, as opposed to directly addressing the mail to a person, generally implies that the recipient is not required to take any action; the message is for informational purposes only. In a cc directive, the fact that this recipient received the mail is printed in the mail header and is thus known to all other recipients.</descrip></descripGrp><ntig><termGrp><term id="27856">carbon copy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="473366">ಸೌಜನ್ಯ ಪ್ರತಿ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5719_27857_473364"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A directive to an email program to send a complete copy of a given piece of mail to another individual. The use of cc mail addressing, as opposed to directly addressing the mail to a person, generally implies that the recipient is not required to take any action; the message is for informational purposes only. In a cc directive, the fact that this recipient received the mail is printed in the mail header and is thus known to all other recipients.</descrip></descripGrp><ntig><termGrp><term id="27857">cc</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="473364">ಕಾರ್ಬನ್ ಪ್ರತಿ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5719_27857_473365"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A directive to an email program to send a complete copy of a given piece of mail to another individual. The use of cc mail addressing, as opposed to directly addressing the mail to a person, generally implies that the recipient is not required to take any action; the message is for informational purposes only. In a cc directive, the fact that this recipient received the mail is printed in the mail header and is thus known to all other recipients.</descrip></descripGrp><ntig><termGrp><term id="27857">cc</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="473365">cc</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5719_27857_473366"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A directive to an email program to send a complete copy of a given piece of mail to another individual. The use of cc mail addressing, as opposed to directly addressing the mail to a person, generally implies that the recipient is not required to take any action; the message is for informational purposes only. In a cc directive, the fact that this recipient received the mail is printed in the mail header and is thus known to all other recipients.</descrip></descripGrp><ntig><termGrp><term id="27857">cc</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="473366">ಸೌಜನ್ಯ ಪ್ರತಿ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5719_27858_473364"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A directive to an email program to send a complete copy of a given piece of mail to another individual. The use of cc mail addressing, as opposed to directly addressing the mail to a person, generally implies that the recipient is not required to take any action; the message is for informational purposes only. In a cc directive, the fact that this recipient received the mail is printed in the mail header and is thus known to all other recipients.</descrip></descripGrp><ntig><termGrp><term id="27858">courtesy copy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="473364">ಕಾರ್ಬನ್ ಪ್ರತಿ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5719_27858_473365"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A directive to an email program to send a complete copy of a given piece of mail to another individual. The use of cc mail addressing, as opposed to directly addressing the mail to a person, generally implies that the recipient is not required to take any action; the message is for informational purposes only. In a cc directive, the fact that this recipient received the mail is printed in the mail header and is thus known to all other recipients.</descrip></descripGrp><ntig><termGrp><term id="27858">courtesy copy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="473365">cc</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5719_27858_473366"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A directive to an email program to send a complete copy of a given piece of mail to another individual. The use of cc mail addressing, as opposed to directly addressing the mail to a person, generally implies that the recipient is not required to take any action; the message is for informational purposes only. In a cc directive, the fact that this recipient received the mail is printed in the mail header and is thus known to all other recipients.</descrip></descripGrp><ntig><termGrp><term id="27858">courtesy copy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="473366">ಸೌಜನ್ಯ ಪ್ರತಿ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5725_295557_474724"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to a process that is performed by a person, rather than automated.</descrip></descripGrp><ntig><termGrp><term id="295557">manual</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="474724">ಹಸ್ತಚಾಲಿತ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5726_269749_474688"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A state in which users fill out forms when working offline.</descrip></descripGrp><ntig><termGrp><term id="269749">offline mode</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="474688">ಆಫ್‌ಲೈನ್ ಮೋಡ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5728_25995_473345"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A device that enables a broadband connection to the Internet by using cable television infrastructure. Access speeds vary greatly, with a maximum throughput of 10 megabits per second (Mbps).</descrip></descripGrp><ntig><termGrp><term id="25995">cable modem</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="473345">ಕೇಬಲ್ ಮೊಡೆಮ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="573_231958_1319304"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The set of coordinates that a cell occupies on a worksheet. For example, the reference of the cell that appears at the intersection of column B and row 3 is B3.</descrip></descripGrp><ntig><termGrp><term id="231958">cell reference</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1319304">ಸೆಲ್ ಉಲ್ಲೇಖ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5731_155920_1903657"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method of preventing a denial of service attack by limiting the number of requests that can be made to a system.</descrip></descripGrp><ntig><termGrp><term id="155920">throttling</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1903657">ವಿನಂತಿಯ ಥ್ರೋಟ್ಲಿಂಗ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5731_1645777_1903657"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method of preventing a denial of service attack by limiting the number of requests that can be made to a system.</descrip></descripGrp><ntig><termGrp><term id="164577