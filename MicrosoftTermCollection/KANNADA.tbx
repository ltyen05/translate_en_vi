mmaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="473631">ಎದ್ದುಗಾಣಿಸು</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14241_45676_473506"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In computing, a characteristic of data that is represented as binary digits (zeros and ones).</descrip></descripGrp><ntig><termGrp><term id="45676">digital</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="473506">ಡಿಜಿಟಲ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14244_115576_1977235"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To make a transmission appear to come from a user other than the user who performed the action.</descrip></descripGrp><ntig><termGrp><term id="115576">spoof</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1977235">ಸ್ಪೂಫ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14246_343618_1251042"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A diagramming capability that shows charts in three dimensions.</descrip></descripGrp><ntig><termGr