aphicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31293_1598403_1646115"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A runtime environment for Windows Store apps that's designed to minimize app impact on the computer by placing runtime restrictions on what apps can do.</descrip></descripGrp><ntig><termGrp><term id="1598403">app container</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1646115">ಅಪ್ಲಿ ಕಂಟೇನರ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31294_1627809_1646533"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A filtering feature that monitors downloaded apps for malware or unknown reputation.</descrip></descripGrp><ntig><termGrp><term id="1627809">Windows SmartScreen</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1646533">Windows SmartScreen</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31295_1598405_1646437"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature of Windows that includes a set of maintenance tasks that run automatically when the user's PC is idle.</descrip></descripGrp><ntig><termGrp><term id="1598405">Automatic Maintenance</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1646437">ಸ್ವಯಂಚಾಲಿತ ನಿರ್ವಹಣೆ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31296_1598406_1646443"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature of BitLocker that enables IT pros to encrypt a disk before a user begins to use it.</descrip></descripGrp><ntig><termGrp><term id="1598406">BitLocker encrypted installation</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1646443">BitLocker ಎನ್‌ಕ್ರಿಪ್ಟ್ ಮಾಡಿದ ಸ್ಥಾಪನೆ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31297_1598407_1646444"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A BitLocker extension that adds management capabilities to BitLocker.</descrip></descripGrp><ntig><termGrp><term id="1598407">BitLocker Enterprise</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1646444">BitLocker ಎಂಟರ್‌ಪ್ರೈಸ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31298_1598408_1646445"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature of BitLocker that allows unlocking of an OS volume using a key received over the network.</descrip></descripGrp><ntig><termGrp><term id="1598408">BitLocker network unlock</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1646445">BitLocker ನೆಟ್‌ವರ್ಕ್ ಅನ್‌ಲಾಕ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31298_1757881_1646445"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature of BitLocker that allows unlocking of an OS volume using a key received over the network.</descrip></descripGrp><ntig><termGrp><term id="1757881">BitLocker Network Unlock</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1646445">BitLocker ನೆಟ್‌ವರ್ಕ್ ಅನ್‌ಲಾಕ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31298_1757883_1646445"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature of BitLocker that allows unlocking of an OS volume using a key received over the network.</descrip></descripGrp><ntig><termGrp><term id="1757883">Network Unlock</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1646445">BitLocker ನೆಟ್‌ವರ್ಕ್ ಅನ್‌ಲಾಕ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31299_1598409_1793870"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Hyper-V technology that runs on the Windows Client operating system, rather than Windows Server.</descrip></descripGrp><ntig><termGrp><term id="1598409">Client Hyper-V</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1793870">ಕ್ಲೈಂಟ್ Hyper-V</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31304_1598622_1646487"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ability for IT pros to define how users access a system based on dynamic qualities, such as a user's location or role.</descrip></descripGrp><ntig><termGrp><term id="1598622">dynamic access control</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1646487">ಡೈನಾಮಿಕ್ ಪ್ರವೇಶ ನಿಯಂತ್ರಣ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31305_1598623_1646491"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Windows feature designed to help users avoid data loss by automatically saving versions of files and copies of deleted files so that users can recover them.</descrip></descripGrp><ntig><termGrp><term id="1598623">File History</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1646491">ಫೈಲ್ ಇತಿಹಾಸ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31306_1598625_1646521"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The single set of sign-in credentials (email address and password) that provides user access to Microsoft products and services.</descrip></descripGrp><ntig><termGrp><term id="1598625">Microsoft account</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1646521">Microsoft ಖಾತೆ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31306_1598625_3090941"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The single set of sign-in credentials (email address and password) that provides user access to Microsoft products and services.</descrip></descripGrp><ntig><termGrp><term id="1598625">Microsoft account</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="3090941">MSA</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31306_3090865_1646521"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The single set of sign-in credentials (email address and password) that provides user access to Microsoft products and services.</descrip></descripGrp><ntig><termGrp><term id="3090865">MSA</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1646521">Microsoft ಖಾತೆ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31306_3090865_3090941"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The single set of sign-in credentials (email address and password) that provides user access to Microsoft products and services.</descrip></descripGrp><ntig><termGrp><term id="3090865">MSA</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="3090941">MSA</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31307_1598626_1646598"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A technology that allows for the installation and use of multiple user-interface languages.</descrip></descripGrp><ntig><termGrp><term id="1598626">Multilingual User Interface</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1646598">ಬಹುಭಾಷೆಯ ಬಳಕೆದಾರ ಇಂಟರ್ಫೇಸ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31309_1598627_1646493"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A UI element that enables users to locate and select files.</descrip></descripGrp><ntig><termGrp><term id="1598627">file picker</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1646493">ಫೈಲ್ ಪಿಕ್ಕರ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3131_12131_473257"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The &lt;&gt; characters.</descrip></descripGrp><ntig><termGrp><term id="12131">angle brackets</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="473257">ಕೋನಾಕಾರ ಆವರಣ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31311_1598845_1646073"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The activation of systems in an enterprise environment by using an established Active Directory implementation and the same key types.</descrip></descripGrp><ntig><termGrp><term 