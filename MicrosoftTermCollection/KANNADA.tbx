ang="en-US"><descripGrp><descrip type="definition">An account that is intended to be used to run a service. A service account has privileges beyond those provided when a service is run as part of the system, such as the ability to connect over the network to another computer.</descrip></descripGrp><ntig><termGrp><term id="228771">service account</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1956866">ಸೇವೆ ಖಾತೆ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10380_156547_1687793"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A document describing a company's position on privacy, detailing what information it collects, with whom the data is shared, and how users can control the use of their personal information.</descrip></descripGrp><ntig><termGrp><term id="156547">privacy statement</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1687793">ಗೌಪ್ಯತೆ ಹೇಳಿಕೆ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10396_158410_474252"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to, being, or characteristic of something that is not dependent on timing. Each application or command runs in the specified order, but the specified item does not wait for any previously started processes to finish before an application or command runs.</descrip></descripGrp><ntig><termGrp><term id="158410">asynchronous</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="474252">ಅಸಿಂಕ್ರೋನಸ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10396_2479304_474252"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to, being, or characteristic of something that is not dependent on timing. Each application or command runs in the specified order, but the specified item does not wait for any previously started processes to finish before an application or command runs.</descrip></descripGrp><ntig><termGrp><term id="2479304">async</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="474252">ಅಸಿಂಕ್ರೋನಸ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10398_307432_1956700"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The policy tool that gives authors control over how recipients use the documents and emails they send.</descrip></descripGrp><ntig><termGrp><term id="307432">Information Rights Management</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1956700">ಮಾಹಿತಿ ಹಕ್ಕುಗಳ ನಿರ್ವಹಣೆ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10398_307432_1956709"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The policy tool that gives authors control over how recipients use the documents and emails they send.</descrip></descripGrp><ntig><termGrp><term id="307432">Information Rights Management</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1956709">IRM</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10398_307472_1956700"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The policy tool that gives authors control over how recipients use the documents and emails they send.</descrip></descripGrp><ntig><termGrp><term id="307472">IRM</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1956700">ಮಾಹಿತಿ ಹಕ್ಕುಗಳ ನಿರ್ವಹಣೆ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10398_307472_1956709"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The policy tool that gives authors control over how recipients use the documents and emails they send.</descrip></descripGrp><ntig><termGrp><term id="307472">IRM</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1956709">IRM</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="104_234833_474497"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An organizational feature of Windows that displays a panel on the side of the desktop with shortcuts to mini-applications, also known as gadgets. The examples of such gadgets are local weather, a photo slideshow, a dictionary, news headlines, and a Windows Media Player control.</descrip></descripGrp><ntig><termGrp><term id="234833">Windows Sidebar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="474497">Windows ಅಡ್ಡಪಟ್ಟಿ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1040_378778_1956897"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A parameter that does not take an argument.</descrip></descripGrp><ntig><termGrp><term id="378778">switch parameter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1956897">ಸ್ವಿಚ್ ಪ್ಯಾರಾಮೀಟರ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10402_146400_1903065"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Text or some other element used in an application as an indicator that the user should enter in his or her own text.</descrip></descripGrp><ntig><termGrp><term id="146400">placeholder text</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1903065">ಪ್ಲೇಸ್‌ಹೋಲ್ಡರ್ ಪಠ್ಯ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10410_397225_1956627"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Text that is added to email messages in transport to provide information that supports the sending organization's compliance policies, warnings about unknown or unverified email senders, or other information as determined by the sending organization. Exchange Server 2007 allows the administrator to use transport rules to target disclaimers based on specific criteria.</descrip></descripGrp><ntig><termGrp><term id="397225">disclaimer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1956627">ಹಕ್ಕು ನಿರಾಕರಣೆ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10414_270278_474692"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A line that separates the numerator and denominator of a fraction.</descrip></descripGrp><ntig><termGrp><term id="270278">fraction bar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="474692">ಭಿನ್ನಾಂಕ ಪಟ್ಟಿ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10421_210482_1903119"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A small space on the To-Do Bar where the user can input tasks directly. The default label reads "Type a new task".</descrip></descripGrp><ntig><termGrp><term id="210482">task input panel</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1903119">ಕಾರ್ಯದ ಇನ್‌ಪುಟ್ ಫಲಕ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10422_318356_473719"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The &lt; character.</descrip></descripGrp><ntig><termGrp><term id="318356">left angle bracket</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="473719">ಕಡಿಮೆ ಚಿಹ್ನೆ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10422_318356_474917"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The &lt; character.</descrip></descripGrp><ntig><termGrp><term id="318356">left angle bracket</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="474917">ಎಡಕೋನ ಆವರಣ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10422_318750_473719"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The &lt; character.</descrip></descripGrp><ntig><termGrp><term id="318750">LESS-THAN SIGN</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="473719">ಕಡಿಮೆ ಚಿಹ್ನೆ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10422_318750_474917"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The &lt; character.</descrip></descripGrp><ntig><termGrp><term id="318750">LESS-THAN SIGN</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="474917">ಎಡಕೋನ ಆವರಣ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10422_74325_473719"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The &lt; character.</descrip></descripGrp><ntig><termGrp><term id="74325">less than sign</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="473719">ಕಡಿಮೆ ಚಿಹ್ನೆ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10422_74325_474917"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The &lt; character.</descrip></descripGrp><ntig><termGrp><term id="74325">less than sign</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="474917">ಎಡಕೋನ ಆವರಣ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10423_232516_474438"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Data from a table, form, query, view, or stored procedure, displayed in a row-and-column format.</descrip></descripGrp><ntig><termGrp><term id="232516">datasheet</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="474438">ಡೇಟಾಶೀಟ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10425_77712_1956740"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A highspeed network that can carry voice, data, and images at up to 200 Mbps or faster over distances of up to 75 km. Based on the network architecture, the transmission speed can be higher for shorter distances. A MAN, which can include one or more LANs as well as telecommunications equipment such as microwave and satellite relay stations, is smaller than a wide area network but generally operates at a higher speed.</descrip></descripGrp><ntig><termGrp><term id="77712">MAN</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1956740">MAN</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10425_77712_1956757"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A highspeed network that can carry voice, data, and images at up to 200 Mbps or faster over distances of up to 75 km. Based on the network architecture, the transmission speed can be higher for shorter distances. A MAN, which can include one or more LANs as well as telecommunications equipment such as microwave and satellite relay stations, is smaller than a wide area network but generally operates at a higher speed.</descrip></descripGrp><ntig><termGrp><term id="77712">MAN</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1956757">ಮೆಟ್ರೊಪೊಲಿಟಿಯನ್ ಏರಿಯಾ ನೆಟ್‌ವರ್ಕ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10425_77713_1956740"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A highspeed network that can carry voice, data, and images at up to 200 Mbps or faster over distances of up to 75 km. Based on the network architecture, the transmission speed can be higher for shorter distances. A MAN, which can include one or more LANs as well as telecommunications equipment such as microwave and satellite relay stations, is smaller than a wide area network but generally operates at a higher speed.</descrip></descripGrp><ntig><termGrp><term id="77713">metropolitan area network</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1956740">MAN</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10425_77713_1956757"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A highspeed network that can carry voice, data, and images at up to 200 Mbps or faster over distances of up to 75 km. Based on the network architecture, the transmission speed can be higher for shorter distances. A MAN, which can include one or more LANs as well as telecommunications equipment such as microwave and satellite relay stations, is smaller than a wide area network but generally operates at a higher speed.</descrip></descripGrp><ntig><termGrp><term id="77713">metropolitan area network</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1956757">ಮೆಟ್ರೊಪೊಲಿಟಿಯನ್ ಏರಿಯಾ ನೆಟ್‌ವರ್ಕ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10431_232847_1903158"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A view that is designed for reading documents on a computer screen. The document is resized to fit the screen and most toolbars are removed, but commands are available for navigating, commenting, and looking up words.</descrip></descripGrp><ntig><termGrp><term id="232847">reading layout view</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1903158">ಓದುವ ಲೇಔಟ್ ವೀಕ್ಷಣೆ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10436_415517_2441207"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Editor feature that gives users feedback on how easy it is for a reader to understand a written text based on information such as average sentence length and average word length.</descrip></descripGrp><ntig><termGrp><term id="415517">Readability Statistics</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2441207">ಸ್ಫುಟವಾಗಿ ಓದಬಹುದಾದ ಅಂಕಿಅಂಶಗಳು</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10437_168488_1950704"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An optional Live Meeting tool that allows users to create Live Meeting slides and add a presenter photo as part of a Microsoft PowerPoint file.</descrip></descripGrp><ntig><termGrp><term id="168488">PowerPoint add-in</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1950704">PowerPoint ಆಡ್-ಇನ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10443_294444_474711"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of chart that compares the aggregate values of a number of data series.</descrip></descripGrp><ntig><termGrp><term id="294444">radar chart</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="474711">ರಾಡರ್ ಚಾರ್ಟ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10444_139402_474117"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A design template that also contains text suggestions on each slide. You replace the text suggestions with the text that you want. A content template contains a slide master and an optional title master.</descrip></descripGrp><ntig><termGrp><term id="139402">content template</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="474117">ವಿಷಯ ಟೆಂಪ್ಲೆಟ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1045_137287_1423500"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Text displayed by Web browsers during image downloads for users who have graphics turned off, and for users who rely on screen-reading software to convert graphics on the screen to spoken words.</descrip></descripGrp><ntig><termGrp><term id="137287">alternative text</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1423500">ALT ಪಠ್ಯ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1045_137287_474095"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Text displayed by Web browsers during image downloads for users who have graphics turned off, and for users who rely on screen-reading software to convert graphics on the screen to spoken words.</descrip></descripGrp><ntig><termGrp><term id="137287">alternative text</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="474095">ಪರ್ಯಾಯ ಪಠ್ಯ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1045_765697_1423500"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Text displayed by Web browsers during image downloads for users who have graphics turned off, and for users who rely on screen-reading software to convert graphics on the screen to spoken words.</descrip></descripGrp><ntig><termGrp><term id="765697">ALT text</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1423500">ALT ಪಠ್ಯ</term><termNote type="geographicalUsage">IND</termNote><termNote type=