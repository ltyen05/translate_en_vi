at collects information, such as the web sites a user visits, without adequate consent and installation may be without prominent notice or without the user’s knowledge.</descrip></descripGrp><ntig><termGrp><term id="157172">spyware</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2719036">ಸ್ಪೈವೇರ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12483_149056_1423570"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In an organization chart, a shape that is placed above and connected to any other shape, such as an employee (subordinate or coworker shape) or assistant shape.</descrip></descripGrp><ntig><termGrp><term id="149056">superior shape</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1423570">ಅತ್ಯುನ್ನತ ಆಕಾರ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12486_317885_1903179"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A specific Office icon that is used within a group to launch a related dialog box.</descrip></descripGrp><ntig><termGrp><term id="317885">Dialog Box Launcher</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1903179">ಸಂವಾದ ಪೆಟ್ಟಿಗೆ ಪ್ರಾರಂಭಿಸುವಿಕೆ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1250_1162493_1903415"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A grouping of dimension members or items from a data source that are named and treated as a single unit and can be referenced or reused multiple times.</descrip></descripGrp><ntig><termGrp><term id="1162493">set</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1903415">ಹೊಂದಾಣಿಕೆ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1250_1162493_2290092"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A grouping of dimension members or items from a data source that are named and treated as a single unit and can be referenced or reused multiple times.</descrip></descripGrp><ntig><termGrp><term id="1162493">set</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2290092">ಹೆಸರಿಸಿದ ಹೊಂದಿಕೆ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1250_530462_1903415"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A grouping of dimension members or items from a data source that are named and treated as a single unit and can be referenced or reused multiple times.</descrip></descripGrp><ntig><termGrp><term id="530462">named set</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1903415">ಹೊಂದಾಣಿಕೆ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1250_530462_2290092"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A grouping of dimension members or items from a data source that are named and treated as a single unit and can be referenced or reused multiple times.</descrip></descripGrp><ntig><termGrp><term id="530462">named set</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2290092">ಹೆಸರಿಸಿದ ಹೊಂದಿಕೆ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12505_131084_1319465"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In a graphical user interface such as Windows, a pattern or picture in the screen background that can be chosen by the user.</descrip></descripGrp><ntig><termGrp><term id="131084">wallpaper</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1319465">ವಾಲ್‌ಪೇಪರ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1251_52930_473575"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An orientation of printed paper where the printed side is against a surface. For example, paper is face down when it is placed in a copier with the printed side against the copying surface.</descrip></descripGrp><ntig><termGrp><term id="52930">face down</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="473575">ಕೆಳ ಮುಖ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12520_1296_473143"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A member of the TCP/IP suite of protocols, used to copy files between two computers on the Internet. Both computers must support their respective FTP roles: one must be an FTP client and the other an FTP server.</descrip></descripGrp><ntig><termGrp><term id="1296">File Transfer Protocol</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="473143">ಡೇಟಾ ವರ್ಗಾವಣೆ ಪ್ರೊಟೋಕಾಲ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12520_1296_473144"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A member of the TCP/IP suite of protocols, used to copy files between two computers on the Internet. Both computers must support their respective FTP roles: one must be an FTP client and the other an FTP server.</descrip></descripGrp><ntig><termGrp><term id="1296">File Transfer Protocol</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="473144">FTP</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12520_1297_473143"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A member of the TCP/IP suite of protocols, used to copy files between two computers on the Internet. Both computers must support their respective FTP roles: one must be an FTP client and the other an FTP server.</descrip></descripGrp><ntig><termGrp><term id="1297">FTP</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="473143">ಡೇಟಾ ವರ್ಗಾವಣೆ ಪ್ರೊಟೋಕಾಲ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12520_1297_473144"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A member of the TCP/IP suite of protocols, used to copy files between two computers on the Internet. Both computers must support their respective FTP roles: one must be an FTP client and the other an FTP server.</descrip></descripGrp><ntig><termGrp><term id="1297">FTP</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="473144">FTP</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12524_73352_473703"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of binaries that can be installed on top of the core product and enables users to select a preferred language so that the user interface and Help files appear in that preferred language.</descrip></descripGrp><ntig><termGrp><term id="73352">language pack</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="473703">ಭಾಷಾ ಪ್ಯಾಕ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12530_262704_474627"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A common programming interface to the lower-level system area network (SAN) implementations, developed by Microsoft. WSD sits underneath the standard WinSock application programming interface (API), but bypasses the kernel networking layers to talk directly to the SAN hardware. Because WSD sits underneath the existing WinSock API, IT departments can deploy applications in a SAN environment without modifying the applications.</descrip></descripGrp><ntig><termGrp><term id="262704">WinSock direct</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="474627">ವಿನ್ ಸೊಕ್ ಡೈರೆಕ್ಟ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12530_262704_474628"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A common programming interface to the lower-level system area network (SAN) implementations, developed by Microsoft. WSD sits underneath the standard WinSock application programming interface (API), but bypasses the kernel networking layers to talk directly to the SAN hardware. Because WSD sits underneath the existing WinSock API, IT departments can deploy applications in a SAN environment without modifying the applications.</descrip></descripGrp><ntig><termGrp><term id="262704">WinSock direct</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="474628">WSD</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12530_262705_474627"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A common programming interface to the lower-level system area network (SAN) implementations, developed by Microsoft. WSD sits underneath the standard WinSock application programming interface (API), but bypasses the kernel networking layers to talk directly to the SAN hardware. Because WSD sits underneath the existing WinSock API, IT departments can deploy applications in a SAN environment without modifying the applications.</descrip></descripGrp><ntig><termGrp><term id="262705">WSD</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="474627">ವಿನ್ ಸೊಕ್ ಡೈರೆಕ್ಟ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12530_262705_474628"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A common programming interface to the lower-level system area network (SAN) implementations, developed by Microsoft. WSD sits underneath the standard WinSock application programming interface (API), but bypasses the kernel networking layers to talk directly to the SAN hardware. Because WSD sits underneath the existing WinSock API, IT departments can deploy applications in a SAN environment without modifying the applications.</descrip></descripGrp><ntig><termGrp><term id="262705">WSD</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="474628">WSD</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12531_232862_1251022"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of files, managed by a manifest.xml file, that add functionality to a Microsoft Office Word or Microsoft Office Excel document by specifying custom display or actions.</descrip></descripGrp><ntig><termGrp><term id="232862">XML expansion pack</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1251022">XML ವಿಸ್ತರಣೆಯ ಪ್ಯಾಕ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12537_95084_473876"><