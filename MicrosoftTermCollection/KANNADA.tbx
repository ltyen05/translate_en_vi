 they enter their name, billing address, payment type, and shipping information.</descrip></descripGrp><ntig><termGrp><term id="31042">checkout</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1766047">ಚೆಕ್‌ಔಟ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4566_118879_473980"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A menu that contains commands you can use to manipulate a window or close a program. You click the program icon at the left of the title bar to open this menu. The context menu of a window replaces this menu.</descrip></descripGrp><ntig><termGrp><term id="118879">system menu</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="473980">ನಿಯಂತ್ರಣ ಮೆನು</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4566_118880_473980"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A menu that contains commands you can use to manipulate a window or close a program. You click the program icon at the left of the title bar to open this menu. The context menu of a window replaces this menu.</descrip></descripGrp><ntig><termGrp><term id="118880">control menu</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="473980">ನಿಯಂತ್ರಣ ಮೆನು</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4567_232422_1903145"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The container in a navigation pane that contains shortcuts and shortcut groups.</descrip></descripGrp><ntig><termGrp><term id="232422">Shortcuts Pane</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1903145">ಶಾರ್ಟ್‌ಕಟ್‌ಗಳ ಫಲಕ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45689_2575485_2578435"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office feature that allows users to translate words, segments or full texts and that is powered exclusively by the cloud-based Microsoft Translator service.</descrip></descripGrp><ntig><termGrp><term id="2575485">Translator</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2578435">ಅನುವಾದಕ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4569_116311_1253131"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In information processing, fixed or predetermined.</descrip></descripGrp><ntig><termGrp><term id="116311">static</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1253131">ಸ್ಥಾಯಿ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45691_2575532_2587908"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An UI element that allows users to adjust the display angle of an object on the screen.</descrip></descripGrp><ntig><termGrp><term id="2575532">angle indicator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2587908">ಕೋನ ಸೂಚಕ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45789_2579453_2584083"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The extension for Cortana that connects users to custom services and solutions. Skills can be invoked on Cortana to perform certain actions, such as checking the user’s bank balance, reading a bed time story, or booking a cab with Uber.</descrip></descripGrp><ntig><termGrp><term id="2579453">Cortana skill</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2584083">Cortana ಸ್ಕಿಲ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></lan