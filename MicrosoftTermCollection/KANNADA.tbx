_1903032"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A detail about a file that helps identify it, such as a descriptive title, the author name, the subject, or a keyword that identifies topics or other important information in the file.</descrip></descripGrp><ntig><termGrp><term id="141997">file property</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1903032">ಫೈಲ್ ಗುಣಲಕ್ಷಣ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14661_132278_1902994"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Web hosting and Internet service provider who manages the Web server hardware and software required to make a Web site available on the Internet.</descrip></descripGrp><ntig><termGrp><term id="132278">web presence provider</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1902994">ವೆಬ್ ಅಸ್ತಿತ್ವ ಪೂರೈಕೆದಾರರು</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14661_1508998_1902994"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Web hosting and Internet service provider who manages the Web server hardware and software required to make a Web site available on the Internet.</descrip></descripGrp><ntig><termGrp><term id="1508998">WPP</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</term