793751">ಕೀ ಸ್ಟೋರ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42480_2793217_2793751"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A repository where private keys, certificates and symmetric keys can be stored.</descrip></descripGrp><ntig><termGrp><term id="2793217">key store</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2793751">ಕೀ ಸ್ಟೋರ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42482_2407975_2412551"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To add a digital signature to additions and updates made to source code and applications published on the Internet. Code signing is intended to provide a level of security and trust to Internet software distribution.</descrip></descripGrp><ntig><termGrp><term id="2407975">code sign</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2412551">ಕೋಡ್ ಚಿಹ್ನೆ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42495_2408959_2414814"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Outlook ribbon button that launches a pane where users can use Outlook Custome