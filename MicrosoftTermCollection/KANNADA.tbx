 xml:lang="en-US"><descripGrp><descrip type="definition">The area of the Windows Defender app that contains information and actions related to performance and PC health.​​</descrip></descripGrp><ntig><termGrp><term id="2451802">Computer performance &amp; health</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2452505">ಕಂಪ್ಯೂಟರ್ ಕಾರ್ಯನಿರ್ವಹಣೆ ಮತ್ತು ಆರೋಗ್ಯ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43295_2451803_2452507"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The area of the Windows Defender app for ​family features, linking o the Family tab of the Microsoft account portal.​​</descrip></descripGrp><ntig><termGrp><term id="2451803">Family options</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2452507">ಕುಟುಂಬದ ಆಯ್ಕೆಗಳು</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43296_2451804_2452508"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The area of the Windows Defender app that contains​ Windows Firewall and other network settings.​​</descrip></descripGrp><ntig><termGrp><term id="2451804">Firewall &amp; network protection</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2452508">ಫೈರ್ ವಾಲ್ ಮತ್ತು ನೆಟ್ವರ್ಕ್ ಸಂರಕ್ಷಣೆ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43297_2451805_2452509"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The area of the Windows Defender app that contains all functionalities related to antivirus and threat protection.​​</descrip></descripGrp><ntig><termGrp><term id="2451805">Virus &amp; threat protection</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2452509">ವೈರಸ್ ಮತ್ತು ಅಪಾಯ ಸಂರಕ್ಷಣೆ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43299_2451996_2454507"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The OneNote feature that allows users to set a picture as a background in their notebooks, type over it,​​ and annotate it.</descrip></descripGrp><ntig><termGrp><term id="2451996">Background pictures</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2454507">ಹಿನ್ನೆಲೆ ಚಿತ್ರಗಳು</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43301_2452357_2454508"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that allows users to drag content from one location and drop it in another.​​</descrip></descripGrp><ntig><termGrp><term id="2452357">Drag and drop</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2454508">ಡ್ರ್ಯಾಗ್‌ ಮತ್ತು ಡ್ರಾಪ್‌ ಮಾಡಿ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43302_2452358_2454512"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that provides users asset of standard style options found in Office products.</descrip></descripGrp><ntig><termGrp><term id="2452358">Styles</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2454512">ಶೈಲಿಗಳು</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43304_2452360_2454506"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tool that creates extra space for adding additional notes and comments in between content blocks.​</descrip></descripGrp><ntig><termGrp><term id="2452360">Add Space</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2454506">ಸ್ಪೇಸ್ ಸೇರಿಸಿ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="gram