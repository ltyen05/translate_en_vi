ig><termGrp><term id="2842116">Fast Identity Online Alliance</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2842635">Fast Identity Online Alliance</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50252_2842116_2842636"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A nonprofit consortium of industry leaders, including Microsoft, that develops open standards for simpler, stronger authentication.</descrip></descripGrp><ntig><termGrp><term id="2842116">Fast Identity Online Alliance</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2842636">FIDO Alliance</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50252_2842117_2842635"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A nonprofit consortium of industry leaders, including Microsoft, that develops open standards for simpler, stronger authentication.</descrip></descripGrp><ntig><termGrp><term id="2842117">FIDO Alliance</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2842635">Fast Identity Online Alliance</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGen