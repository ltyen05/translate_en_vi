ical card that represents a specific value or amount of service for which the user has paid in advance.</descrip></descripGrp><ntig><termGrp><term id="169828">prepaid card</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1931371">ಪ್ರಿಪೇಯ್ಡ್ ಕಾರ್ಡ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4810_169828_2074498"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A physical card that represents a specific value or amount of service for which the user has paid in advance.</descrip></descripGrp><ntig><termGrp><term id="169828">prepaid card</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2074498">ಪ್ರೀಪೇಡ್ ಕಾರ್ಡ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48105_2715521_2716217"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An item, such as devices, apps, macros, add-ins and drivers, which Desktop Analytics tests in a deployment plan.</descrip></descripGrp><ntig><termGrp><term id="2715521">asset</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2716217">ಸ್ವತ್ತು</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><term