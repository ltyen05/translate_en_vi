SCROLL LOCK key</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="473916">SCROLL LOCK ಕೀಲಿ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6894_318712_474923"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A statement that the text or program code contained within the item on which the notice appears is the intellectual property of Microsoft (or other entity).</descrip></descripGrp><ntig><termGrp><term id="318712">copyright notice</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="474923">ಕೃತಿಸ್ವಾಮ್ಯ ಸೂಚನೆ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6904_108595_2290108"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To try to locate something (a file, a folder, a computer, a text).</descrip></descripGrp><ntig><termGrp><term id="108595">search</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2290108">ಶೋಧಿಸು</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6904_644853_2290108"><langSet xml:lang="en-US"><descripGr