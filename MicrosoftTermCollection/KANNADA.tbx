et xml:lang="kn"><ntig><termGrp><term id="1677520">Microsoft Hotmail</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24601_1136239_1173476"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The web service where users can share their thoughts, photographs, and interests with all members of a group. Members all contribute to a group profile, and can post blog entries, photos, and other items, just as they can to an individual profile.</descrip></descripGrp><ntig><termGrp><term id="1136239">Windows Live Groups</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1173476">Windows Live Groups</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24602_1136240_1173473"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The website where developers and hobbyists can upload their custom creations designed to work with Windows Live or Windows Vista. Visitors to the gallery can download the software, write reviews, and post messages to online forums.</descrip></descripGrp><ntig><termGrp><term id="1136240">Windows Live Gallery</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1173473">Windows Live Gallery</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24603_1136241_1173469"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The set of Microsoft software for email, instant messaging, photos, and personal movies available to customers in a single download and installation.</descrip></descripGrp><ntig><termGrp><term id="1136241">Windows Live Essentials</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1173469">Windows Live Essentials</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24603_1136241_1676221"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The set of Microsoft software for email, instant messaging, photos, and personal movies available to customers in a single download and installation.</descrip></descripGrp><ntig><termGrp><term id="1136241">Windows Live Essentials</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1676221">Windows Essentials</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24603_1636168_1173469"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The set of Microsoft software for email, instant messaging, photos, and personal movies available to customers in a single download and installation.</descrip></descripGrp><ntig><termGrp><term id="1636168">Windows Essentials</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1173469">Windows Live Essentials</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24603_1636168_1676221"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The set of Microsoft software for email, instant messaging, photos, and personal movies available to customers in a single download and installation.</descrip></descripGrp><ntig><termGrp><term id="1636168">Windows Essentials</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1676221">Windows Essentials</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24604_1136243_1173466"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Windows Live universal roaming contact list that allows users to share their contact information and subscribe to others’ to automatically receive updates across Windows Live Messenger and Windows Live Spaces.</descrip></descripGrp><ntig><termGrp><term id="1136243">Windows Live Contacts</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1173466">Windows Live Contacts</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24607_1136282_1173463"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Windows Live service that lets people and groups add, manage, and share event information.</descrip></descripGrp><ntig><termGrp><term id="1136282">Windows Live Calendar</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1173463">Windows Live Calendar</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24608_1136283_1177461"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Windows Live service that notifies someone of an event or information based on their subscription preferences. The alerts can be sent to Messenger, Mail, Hotmail, or a mobile device.</descrip></descripGrp><ntig><termGrp><term id="1136283">Windows Live Alerts</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1177461">Windows Live Alerts</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24612_1973489_1977207"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The category of services that includes OneDrive, Outlook.com, and Skype.</descrip></descripGrp><ntig><termGrp><term id="1973489">Microsoft services</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1977207">Microsoft ಸೇವೆಗಳು</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24616_1355343_2035178"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft service that facilitates web searches.</descrip></descripGrp><ntig><termGrp><term id="1355343">Bing</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2035178">Bing</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24625_1140385_1903414"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that displays the first three lines of a message in the user's Inbox.</descrip></descripGrp><ntig><termGrp><term id="1140385">AutoPreview</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1903414">ಸ್ವಯಂಮುನ್ನೋಟ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24652_1145538_1956905"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A form of dialing that uses multiple-tone signaling. The user hears a series of tones (beeps) when dialing.</descrip></descripGrp><ntig><termGrp><term id="1145538">touchtone dialing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1956905">ಟಚ್‌ಟೋನ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24652_1145538_1956906"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A form of dialing that uses multiple-tone signaling. The user hears a series of tones (beeps) when dialing.</descrip></descripGrp><ntig><termGrp><term id="1145538">touchtone dialing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1956906">ಟಚ್‌ಟೋನ್ ಡಯಲಿಂಗ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24652_1145539_1956905"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A form of dialing that uses multiple-tone signaling. The user hears a series of tones (beeps) when dialing.</descrip></descripGrp><ntig><termGrp><term id="1145539">touchtone</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1956905">ಟಚ್‌ಟೋನ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="g