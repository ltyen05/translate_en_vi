/descripGrp><ntig><termGrp><term id="107623">scanner</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1253074">ಚಿತ್ರಶೋಧಕ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1396_107623_473913"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An optical input device that uses light-sensing equipment to capture an image on paper or some other object. Captured image data is converted into binary files that can be stored and manipulated by computer programs.</descrip></descripGrp><ntig><termGrp><term id="107623">scanner</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="473913">ಸ್ಕ್ಯಾನರ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13968_2587_1319479"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A network of computers, printers, and other devices located within a relatively limited area (for example, a building). A LAN enables any connected device to interact with any other on the network.</descrip></descripGrp><ntig><termGrp><term id="2587">LAN</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1319479">ಸ್ಧಳೀಯ ಪ್ರದೇಶ ನೆಟ್‌ವರ್ಕ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote t