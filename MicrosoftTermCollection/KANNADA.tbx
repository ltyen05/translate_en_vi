ocator Service</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2819958">ಸರ್ವರ್ ಸೂಚಕ ಸೇವೆ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49831_2817533_2819947"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of conditions, implemented through the Data Validation function in Excel, that restricts the permissible content of a cell.</descrip></descripGrp><ntig><termGrp><term id="2817533">data validation rule</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2819947">ಡೇಟಾ ಮೌಲ್ಯೀಕರಣ ನಿಯಮ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49832_2817535_2819956"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The user's perception about the usability and effectiveness of the search function.</descrip></descripGrp><ntig><termGrp><term id="2817535">search experience</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2819956">ಶೋಧ ಅನುಭವ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49833_2817538_2819959"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A way of expressing a software design, usually in an abstract language such as UML.</descrip></descripGrp><ntig><termGrp><term id="2817538">software model</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2819959">ಸಾಫ್ಟ್‌ವೇರ್ ಮಾದರಿ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49834_2817540_2819949"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Without using your hands.</descrip></descripGrp><ntig><termGrp><term id="2817540">hands-free</term><termNote type="partOfSpeech">Adverb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2819949">ಹ್ಯಾಂಡ್ಸ್-ಫ್ರೀ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Adverb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49835_2817541_2833991"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">UI label for launching the dictation function.</descrip></descripGrp><ntig><termGrp><term id="2817541">Dictate</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2833991">ಡಿಕ್ಟೇಟ್ ಮಾಡು</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></ter