rip type="definition">A location or selection of text in a file that you name for reference purposes. Bookmarks identify a location within your file that you can later refer or link to.</descrip></descripGrp><ntig><termGrp><term id="215978">anchor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="473323">ಬುಕ್‌ಮಾರ್ಕ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4846_215978_474395"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A location or selection of text in a file that you name for reference purposes. Bookmarks identify a location within your file that you can later refer or link to.</descrip></descripGrp><ntig><termGrp><term id="215978">anchor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="474395">ಲಂಗರು</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4846_22733_473323"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A location or selection of text in a file that you name for reference purposes. Bookmarks identify a location within your file that you can later refer or link to.</descrip></descripGrp><ntig><termGrp><term id="22733">bookmark</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="473323">ಬುಕ್‌ಮಾರ್ಕ್</term><termNote 