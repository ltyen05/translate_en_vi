 type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13742_210086_474349"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A chart that uses horizontal bars to illustrate comparisons among individual data items.</descrip></descripGrp><ntig><termGrp><term id="210086">bar graph</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="474349">ಬಾರ್ ಗ್ರಾಫ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13747_21789_473321"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A picture made from a series of small dots, much like a piece of graph paper with certain squares filled in to form shapes and lines.</descrip></descripGrp><ntig><termGrp><term id="21789">bitmap</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="473321">ಬಿಟ್‌ಮ್ಯಾಪ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1377_1217967_1956687"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The main or default (start-up) screen.</descrip></descripGrp><ntig><termGrp><term id="1217967">home screen</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1956687">ಹೋಮ್ ಪರದೆ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1377_338601_1956687"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The main or default (start-up) screen.</descrip></descripGrp><ntig><termGrp><term id="338601">Home Screen</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1956687">ಹೋಮ್ ಪರದೆ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13772_52156_1319477"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to a type of access to data in a database that is shared over a network. When you open a database in exclusive mode, you prevent others from opening the database.</descrip></descripGrp><ntig><termGrp><term id="52156">exclusive</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1319477">ಏಕೈಕ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13776_5615_473206"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A supplemental program that can extend the capabilities of an application program.</descrip></descripGrp><ntig><termGrp><term id="5615">add-in</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSe