07">feed</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2556227">ಫೀಡ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35480_2035368_2556230"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A recorded section of video from a game.</descrip></descripGrp><ntig><termGrp><term id="2035368">game clip</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2556230">ಆಟದ ಕ್ಲಿಪ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35481_2035369_2556231"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Allows the recording of video content from a sequence in a game.</descrip></descripGrp><ntig><termGrp><term id="2035369">Game DVR</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2556231">ಆಟ DVR</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35482_2035370_2556245"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The brand name for the controller-free, sensor-based gaming device from Xbox One.</descrip></