/langSet><langSet xml:lang="kn"><ntig><termGrp><term id="473819">ಆಪ್ಟಿಮೈಜ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1371_141114_1423506"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Properties, such as title, subject, and author, that are stored with each data access page.</descrip></descripGrp><ntig><termGrp><term id="141114">document properties</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1423506">ದಾಖಲೆಯ ಗುಣಲಕ್ಷಣಗಳು</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13724_2346152_2799728"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A named set of deliverables (software components) produced, usually by compiling, from a discrete set of source versions.</descrip></descripGrp><ntig><termGrp><term id="2346152">BLD</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2799728">ಬಿಲ್ಡ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13724_24639_2799728"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A named set of deliverables (software components) produced, usually by compiling, from a discrete set of source versions.</descrip></descripGrp><ntig><termGrp><term id="24639">build</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2799728">ಬಿಲ್ಡ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13726_261538_474577"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A software control that incorporates ActiveX technology.</descrip></descripGrp><ntig><termGrp><term id="261538">ActiveX control</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="474577">ActiveX ನಿಯಂತ್ರಣ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1374_210475_1423507"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to a type of layout consisting of a collection of “Row-Wise Groupings”. A stacked layout most resembles a form with name/value pairs (label, textbox).</descrip></descripGrp><ntig><termGrp><term id="210475">stacked</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1423507">ಸ್ಟ್ಯಾಕ್ ಮಾಡಿದ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry i