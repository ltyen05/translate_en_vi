at comes with a mobile device or tablet PC, and is used to navigate through applications and to input information.</descrip></descripGrp><ntig><termGrp><term id="204223">stylus</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1991970">ಪೆನ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10023_234746_474474"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An option on Windows Parental Control that, if selected, creates logs of all the actions performed by a user on the computer.</descrip></descripGrp><ntig><termGrp><term id="234746">Activity Reporting</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="474474">ಕ್ರಿಯಾ ವರದಿ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10038_295550_474718"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A personal record of experiences, occurrences or proceedings, like a Baby Book or Life Book.</descrip></descripGrp><ntig><termGrp><term id="295550">journal</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="474718">ಸಂಚಿಕೆ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="g