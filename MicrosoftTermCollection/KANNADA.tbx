><descrip type="definition">The Office 365 Security &amp; Compliance Center feature that allows admins to manage mobile device access to company data, manage data loss, helps them protect the company from inbound and outbound malicious software and spam, and that helps them determine if senders are maliciously spoofing accounts from their domain.</descrip></descripGrp><ntig><termGrp><term id="2701271">Threat management</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2703278">ಅಪಾಯದ ನಿರ್ವಹಣೆ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="47930_2701275_2703276"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An email whose purpose is to scam users, steal their data, or take control of their devices.</descrip></descripGrp><ntig><termGrp><term id="2701275">malicious mail</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2703276">ದುರುದ್ದೇಶದ ಮೇಲ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="47932_2701277_2703279"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office 365 Security &amp; Compliance Center feature that allows admins to track ongoing security problems and campaigns as well as general trends and queries.</descrip></descripGrp><ntig><termGrp><term id="2701277">Threat tracker</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2703279">ಅಪಾಯದ ಟ್ರ್ಯಾಕರ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="47933_2701278_2703277"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office 365 Security &amp; Compliance Center feature that allows admins to trace the flow of email in their organization, filter the results, and export them.</descrip></descripGrp><ntig><termGrp><term id="2701278">Message trace</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2703277">ಸಂದೇಶ ಟ್ರೇಸ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4794_111703_2198213"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The procedures involved in preparing a software program or application to operate within a computer or mobile device.</descrip></descripGrp><ntig><termGrp><term id="111703">setup</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2198213">ಸೆಟಪ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="47949_2702023_27033