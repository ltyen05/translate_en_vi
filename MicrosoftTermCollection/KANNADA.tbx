501"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of ensuring that data meets specified criteria.</descrip></descripGrp><ntig><termGrp><term id="140279">data validation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1319501">ಡೇಟಾ ದೃಢೀಕರಣ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15742_85088_473792"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user-friendly name displayed in place of a network location, email address, contact name, or other, more formal names.</descrip></descripGrp><ntig><termGrp><term id="85088">nickname</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="473792">ಅಡ್ಡ ಹೆಸರು</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1575_1177075_473403"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The electronic circuit in a computer that generates a steady stream of timing pulses--the digital signals that synchronize every operation. The system clock signal is precisely set by a quartz crystal, typically at a specific frequency between 1 and 50 megahertz. The clock rate of a computer is one of the prime determinants of its overall processing speed, and it can go as high as the other components of the computer allow.</descrip></descripGrp><ntig><termGrp><term id="1177075">system timer</term><termNote type="partOfSp