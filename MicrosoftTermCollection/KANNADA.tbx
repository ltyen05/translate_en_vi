angSet></termEntry><termEntry id="10261_125604_474017"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">When referring to software, to remove program files and folders from the hard disk and remove related data from the registry so the software or solution is no longer available.</descrip></descripGrp><ntig><termGrp><term id="125604">uninstall</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="474017">ಅಸ್ಥಾಪಿಸು</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10261_736801_474017"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">When referring to software, to remove program files and folders from the hard disk and remove related data from the registry so the software or solution is no longer available.</descrip></descripGrp><ntig><termGrp><term id="736801">deinstall</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="474017">ಅಸ್ಥಾಪಿಸು</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10265_234076_1319430"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The button that brings up an international list that allows users to block emails from those domains.</descrip></descripGrp><ntig><termGrp><term id="234076">Blocked Top-Level Domain List</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1319430">ನಿರ್ಬಂಧಿಸಿರುವ ಉನ್ನತ ಮಟ್ಟದ ಡೊಮೇನ್ ಪಟ್ಟಿ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10268_169412_474278"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To do over again.</descrip></descripGrp><ntig><termGrp><term id="169412">redo</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="474278">ಮತ್ತೆಮಾಡು</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10273_297181_474739"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A peer-to-peer file sharing client used to connect to file sharing networks in order to download or share files.</descrip></descripGrp><ntig><termGrp><term id="297181">file sharing program</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="474739">ಫೈಲ್ ಹಂಚಿಕೆ ಪ್ರೋಗ್ರಾಂ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10275_6075_1251004"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of changing the values in cells to see how those changes affect the outcome of formulas on a worksheet. For example, varying the interest rate that is used in an amortization table to determine the amount of the payments.</descrip></descripGrp><ntig><termGrp><term id="6075">what-if analysis</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1251004">ಏನೆಂದು ವಿಶ್ಲೇಷಣೆ ಮಾಡಿದರೆ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10275_6076_1251004"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of changing the values in cells to see how those changes affect the outcome of formulas on a worksheet. For example, varying the interest rate that is used in an amortization table to determine the amount of the payments.</descrip></descripGrp><ntig><termGrp><term id="6076">"what-if" evaluation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1251004">ಏನೆಂದು ವಿಶ್ಲೇಷಣೆ ಮಾಡಿದರೆ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10276_232855_474448"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An option that displays the Web page in a Web browser.</descrip></descripGrp><ntig><termGrp><term id="232855">Web Page Preview</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="474448">ವೆಬ್ ಪುಟ ಮುನ್ನೋಟ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10278_142089_474150"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A technique in which you filter records in a form, datasheet, or data access page to retrieve only those records that don't contain the selected value.</descrip></descripGrp><ntig><termGrp><term id="142089">Filter Excluding Selection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="474150">ಆಯ್ಕೆರಹಿತ ಫಿಲ್ಟರ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10285_63002_3004581"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A firmware specification for input and output devices such as drawing tablets, keyboards, USB speakers, and other specialized devices designed to improve accessibility.</descrip></descripGrp><ntig><termGrp><term id="63002">Human Interface Device</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="3004581">HID</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10285_63002_3004582"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A firmware specification for input and output devices such as drawing tablets, keyboards, USB speakers, and other specialized devices designed to improve accessibility.</descrip></descripGrp><ntig><termGrp><term id="63002">Human Interface Device</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="3004582">ಹ್ಯೂಮನ್ ಇಂಟರ್ಫೇಸ್ ಸಾಧನ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10285_763786_3004581"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A firmware specification for input and output devices such as drawing tablets, keyboards, USB speakers, and other specialized devices designed to improve accessibility.</descrip></descripGrp><ntig><termGrp><term id="763786">HID</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="3004581">HID</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10285_763786_3004582"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A firmware specification for input and output devices such as drawing tablets, keyboards, USB speakers, and other specialized devices designed to improve accessibility.</descrip></descripGrp><ntig><termGrp><term id="763786">HID</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="3004582">ಹ್ಯೂಮನ್ ಇಂಟರ್ಫೇಸ್ ಸಾಧನ</term><termNote type="geographicalUsage">IND</termNote><termN