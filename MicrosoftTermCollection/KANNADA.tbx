as simply one trillion bytes.</descrip></descripGrp><ntig><termGrp><term id="120587">terabyte</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="474383">TB</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4071_211565_473991"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A measurement used for high-capacity data storage. One terabyte equals 240, or 1,099,511,627,776, bytes, although it is commonly interpreted as simply one trillion bytes.</descrip></descripGrp><ntig><termGrp><term id="211565">TB</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="473991">ಟೆರಾಬೈಟ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4071_211565_474383"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A measurement used for high-capacity data storage. One terabyte equals 240, or 1,099,511,627,776, bytes, although it is commonly interpreted as simply one trillion bytes.</descrip></descripGrp><ntig><termGrp><term id="211565">TB</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="474383">TB</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40745_2362004_2366436"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The area in a Lync meeting where content is presented.</descrip></descripGrp><ntig><termGrp><term id="2362004">content stage</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2366436">ಕಂಟೆಂಟ್ ಸ್ಟೇಜ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40746_2362005_2366414"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In a Lync desktop sharing session, the owner of the session can give everyone in the session control, which means that participants can then work together in the same file or desktop and see each other’s changes immediately. Participants can "request," "take," "release," and "give back" control. Only one person can be "in control" at a time.</descrip></descripGrp><ntig><termGrp><term id="2362005">control</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2366414">ನಿಯಂತ್ರಣ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40748_2362007_2366417"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A named collection of contacts in the Contacts list.</descrip></descripGrp><ntig><termGrp><term id="2362007">group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2366417">ಗುಂಪು</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40749_2362008_2366418"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To remove yourself from a conference call that will continue without you.</descrip></descripGrp><ntig><termGrp><term id="2362008">leave call</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2366418">ಕರೆ ತೊರೆಯಿರಿ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40751_2362010_2366420"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To rejoin a window back into an original window which it had been popped out from previously.</descrip></descripGrp><ntig><termGrp><term id="2362010">pop in</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2366420">ಪಾಪ್ ಇನ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40752_2362011_2366421"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To separate an area of a UI into a new window.</descrip></descripGrp><ntig><termGrp><term id="2362011">pop out</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2366421">ಪಾಪ್ ಔಟ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40753_2362012_2366422"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows someone to share documents or applications with others. The user may also choose to give another person control of an application or the user's computer.</descrip></descripGrp><ntig><termGrp><term id="2362012">program sharing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2366422">ಪ್ರೋಗ್ರಾಂ ಹಂಚಿಕೆ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40755_2362014_2366425"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The team responsible for administering use of a multiuser computer system, communications system, or both. A system administrator performs such duties as assigning user accounts and passwords, establishing security access levels, allocating storage space, and watching for unauthorized access.</descrip></descripGrp><ntig><termGrp><term id="2362014">support team</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2366425">ಬೆಂಬಲ ತಂಡ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40756_2362015_2366426"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to contacts who are currently Offline.</descrip></descripGrp><ntig><termGrp><term id="2362015">unavailable</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2366426">ಲಭ್ಯವಿಲ್ಲ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40757_2362016_2366427"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Viewing the presentation asynchronously from what the presenter is presenting (i.e. "Presenter View").</descrip></descripGrp><ntig><termGrp><term id="2362016">view privately</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2366427">ಖಾಸಗಿಯಾಗಿ ವೀಕ್ಷಿಸು</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="408_181420_1793075"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A database instance that makes data available for replication to other servers.</descrip></descripGrp><ntig><termGrp><term id="181420">publisher</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote>