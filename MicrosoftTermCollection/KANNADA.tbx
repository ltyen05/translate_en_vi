ech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2661294">ಇತ್ತೀಚಿನ ಬದಲಾವಣೆಗಳು</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="47241_2660318_2661296"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A visual effect applied to an SVG image or object in an SVG image.</descrip></descripGrp><ntig><termGrp><term id="2660318">SVG filter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2661296">SVG ಫಿಲ್ಟರ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="47243_2660321_2661291"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The SVG filter that displaces the geometry of an image.</descrip></descripGrp><ntig><termGrp><term id="2660321">Displacement Map</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2661291">ಸ್ಥಳಾಂತರದ ನಕ್ಷೆ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="47244_2660322_2661293"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The SVG filter that layers an offset copy of an image on top of another so that the images can be layered.</descrip></descripGrp><ntig><termGrp><term id="2660322">Offset</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2661293">ಆಫ್‌ಸೆಟ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="47245_2660323_2661295"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The SVG filter that creates a bright spot of lighting in the image, creating a stark contrast between the lit and unlit parts.</descrip></descripGrp><ntig><termGrp><term id="2660323">Specular Light</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2661295">ನಿರ್ದಿಷ್ಟ ಬೆಳಕು</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="47246_2660324_2661290"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The SGV filter that adds light that is reflected in many directions, which produces a more uniform lighting effect with a smooth transition from lit to unlit parts.</descrip></descripGrp><ntig><termGrp><term id="2660324">Diffuse Lighting</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2661290">ಡಿಫ್ಯೂಸ್ ಲೈಟಿಂಗ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">P