oun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1903250">ಪ್ರಮಾಣಪತ್ರ ಹಿಂತೆಗೆದುಕೊಳ್ಳುವ ಪರಿಶೀಲನೆ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17811_650171_1903251"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Visual Basic for Applications, the window that is used to display, edit, and write module-level and procedure code.</descrip></descripGrp><ntig><termGrp><term id="650171">code pane</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1903251">ಕೋಡ್ ಫಲಕ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17814_650174_1903252"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A keyword or phrase with an associated color that helps you keep track of items, such as messages, contacts, and appointments. You can use color categories to easily find, sort, filter, or group items.</descrip></descripGrp><ntig><termGrp><term id="650174">color category</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1903252">ಬಣ್ಣದ ವರ್ಗ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></term