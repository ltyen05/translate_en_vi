termGrp></ntig></langSet></termEntry><termEntry id="15456_231959_1903124"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A field that's assigned a column orientation in a PivotTable report. Items associated with a column field are displayed as column labels.</descrip></descripGrp><ntig><termGrp><term id="231959">column field</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1903124">ಲಂಬಸಾಲು ಕ್ಷೇತ್ರ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15457_461710_2599880"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Excel feature that identifies invalid worksheet data, formulas, or formatting and proposes corrections.</descrip></descripGrp><ntig><termGrp><term id="461710">error checking</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2599880">ದೋಷ ಪರಿಶೀಲನೆ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15459_303758_1319496"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An upgrade option that allows users to upgrade from one edition of Windows to another by purchasing the upgrade online. It is enabled by Software Licensing Services (SLS) technology which allows a digital lincense to determine what features are enabled or disabled allowing Microsoft to sell either additional licenses or product upgrades through digital licenses (PUP-DL). Customers may either buy full packaged product (FPP) or upgrade quickly and conveniently electronically.</descrip></descripGrp><ntig><termGrp><term id="303758">Windows Anytime Upgrade</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1319496">Windows Anytime Upgrade</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15459_303758_474763"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An upgrade option that allows users to upgrade from one edition of Windows to another by purchasing the upgrade online. It is enabled by Software Licensing Services (SLS) technology which allows a digital lincense to determine what features are enabled or disabled allowing Microsoft to sell either additional licenses or product upgrades through digital licenses (PUP-DL). Customers may either buy full packaged product (FPP) or upgrade quickly and conveniently electronically.</descrip></descripGrp><ntig><termGrp><term id="303758">Windows Anytime Upgrade</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="474763">WAU</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15459_303760_1319496"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An upgrade option that allows users to upgrade from one edition of Windows to another by purchasing the upgrade online. It is enabled by Software Licensing Services (SLS) technology which allows a digital lincense to determine what features are enabled or disabled allowing Microsoft to sell either additional licenses or product upgrades through digital licenses (PUP-DL). Customers may either buy full packaged product (FPP) or upgrade quickly and conveniently electronically.</descrip></descripGrp><ntig><termGrp><term id="303760">WAU</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1319496">Windows Anytime Upgrade</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15459_303760_474763"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An upgrade option that allows users to upgrade from one edition of Windows to another by purchasing the upgrade online. It is enabled by Software Licensing Services (SLS) technology which allows a digital lincense to determine what features are enabled or disabled allowing Microsoft to sell either additional licenses or product upgrades through digital licenses (PUP-DL). Customers may either buy full packaged product (FPP) or upgrade quickly and conveniently electronically.</descrip></descripGrp><ntig><termGrp><term id="303760">WAU</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="474763">WAU</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15476_72470_473691"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In database management, an identifier for a record or group of records in a datafile.</descrip></descripGrp><ntig><termGrp><term id="72470">key</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="473691">ಕೀಲಿ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15479_72110_473689"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A data unit equal to 1024 bits.</descrip></descripGrp><ntig><termGrp><term id="72110">kilobit</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="473689">ಕಿಲೋಬಿಟ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15482_174671_474282"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A number used to indicate the cost of a route in the Internet Protocol (IP) routing table that enables the selection of the best route among possible multiple routes to the same destination.</descrip></descripGrp><ntig><termGrp><term id="174671">metric</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="474282">ಮೆಟ್ರಿಕ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber