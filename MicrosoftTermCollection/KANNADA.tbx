Grp><descrip type="definition">The argument in an Excel function that specifies the last period in the calculation.</descrip></descripGrp><ntig><termGrp><term id="3080958">end_period</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="3082605">end_period</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54048_3080959_3082834"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The argument in an Excel function that specifies the first, or starting date of a given period.</descrip></descripGrp><ntig><termGrp><term id="3080959">start_date</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="3082834">start_date</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54049_3080960_3082602"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The argument in an Excel function that specifies the last, or ending, date of the period.</descrip></descripGrp><ntig><termGrp><term id="3080960">end_date</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="3082602">end_date</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelect