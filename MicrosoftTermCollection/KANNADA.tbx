ech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37325_2116471_2140530"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A handle that appears on objects or text insertion points when a user taps on them making selection easier.</descrip></descripGrp><ntig><termGrp><term id="2116471">selection handle</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2140530">ಆಯ್ಕೆ ಹ್ಯಾಂಡಲ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37331_2119280_2776148"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The use of software to dynamically extend a physical computer network to include pooled and automated virtual resources.</descrip></descripGrp><ntig><termGrp><term id="2119280">Software-Defined Networking</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2776148">ಸಾಫ್ಟ್‌ವೇರ್-ವಿವರಿಸಿದ ನೆಟ್‌ವರ್ಕಿಂಗ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37332_2119511_2140523"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The command that appears in both email and UX that allows users to put folders in their OneDrive list and allows them to sync those folders offline.</descrip></descripGrp><ntig><termGrp>