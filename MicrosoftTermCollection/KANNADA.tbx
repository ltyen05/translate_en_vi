ay Anywhere</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42427_2400525_2739725"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The StaffHub button that takes users to the screen where they can either create a shift swap request or a shift offer request.</descrip></descripGrp><ntig><termGrp><term id="2400525">Swap or offer shift</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2739725">ಶಿಫ್ಟ್ ವಿನಿಮಯ ಅಥವಾ ನೀಡುವಿಕೆ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42428_2400532_2739718"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A request from one employee to have another employee take a shift from him/her.</descrip></descripGrp><ntig><termGrp><term id="2400532">shift offer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2739718">ಶಿಫ್ಟ್ ಕೊಡುಗೆ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42429_2400543_2739721"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A request from one employee to another to trade shifts with each other.</descrip></descripGrp><ntig><termGrp><term id="240054