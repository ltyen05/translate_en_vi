</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2198294">ಕಾರ್ಯಸ್ಥಳ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35720_2067025_2198295"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An account provided by a company that allows users to install apps or hubs provided by that company, and that governs the company policies applied to the phone.</descrip></descripGrp><ntig><termGrp><term id="2067025">workplace account</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2198295">ಕಾರ್ಯಸ್ಥಳದ ಖಾತೆ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35721_2067026_2198257"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Local public transportation; the vehicles used for such transport.</descrip></descripGrp><ntig><termGrp><term id="2067026">transit</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2198257">ರವಾನೆ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35722_2067027_2198188"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that allows the user to connect the phone to an external display (a PC monitor, for instance) and then display the phone screen on the external display.</descrip></descripGrp><ntig><termGrp><term id="2067027">project my screen</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2198188">ನನ್ನ ಪರದೆ ಪ್ರೊಜೆಕ್ಟ್ ಮಾಡಿ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35723_2067028_2198238"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The option that provides driving or walking directions to the user where the app provides both spoken and visual instructions at the right time for the user to act on those instructions.</descrip></descripGrp><ntig><termGrp><term id="2067028">start voice nav</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2198238">ಧ್ವನಿ ವಿಹಾರ ಪ್ರಾರಂಭಿಸು</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35723_2067028_2198323"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The option that provides driving or walking directions to the user where the app provides both spoken and visual instructions at the right time for the user to act on those instructions.</descrip></descripGrp><ntig><termGrp><term id="2067028">start voice nav</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2198323">ಪ್ರತಿ ತಿರುವಿನ ಪ್ರಕಾರ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35723_2067029_2198238"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The option that provides driving or walking directions to the user where the app provides both spoken and visual instructions at the right time for the user to act on those instructions.</descrip></descripGrp><ntig><termGrp><term id="2067029">turn-by-turn</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2198238">ಧ್ವನಿ ವಿಹಾರ ಪ್ರಾರಂಭಿಸು</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35723_2067029_2198323"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The option that provides driving or walking directions to the user where the app provides both spoken and visual instructions at the right time for the user to act on those instructions.</descrip></descripGrp><ntig><termGrp><term id="2067029">turn-by-turn</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2198323">ಪ್ರತಿ ತಿರುವಿನ ಪ್ರಕಾರ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35724_2067030_2198043"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A camera option that enables users to capture moving subjects by snapping multiple photos on shutter press and allowing the user to pick the best one or just accept the photo recommended by the software.</descrip></descripGrp><ntig><termGrp><term id="2067030">burst mode</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2198043">ಬರ್ಸ್ಟ್ ಮೋಡ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35725_2067031_2198273"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The phone's LED light used during video capture to help exposure in dark conditions.</descrip></descripGrp><ntig><termGrp><term id="2067031">video light</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2198273">ವೀಡಿಯೋ ಬೆಳಕು</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35726_2067032_2198243"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that allows you to sync some of the settings on your phone across all of your Windows 8 devices.</descrip></descripGrp><ntig><termGrp><term id="2067032">sync my settings</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote t