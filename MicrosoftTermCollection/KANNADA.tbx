15_2877863_2878115"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To provide notification of a problem, bug, crash, violation, etc. via a form submission.</descrip></descripGrp><ntig><termGrp><term id="2877863">report</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2878115">ವರದಿ ಮಾಡಿ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50926_2878203_2878274"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft Business solution designed for small businesses and powered by Microsoft 365 and Windows 10, with device management and security features.</descrip></descripGrp><ntig><termGrp><term id="2878203">Microsoft 365 Small Business Premium</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2878274">Microsoft 365 Small Business Premium</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50963_2879286_2880241"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An inspection of devices, mailboxes, and other types of entities performed automatically in response to various detections, after which remediation actions might be taken on malicious and suspicious items found during the investigation.</descrip></descripGrp><ntig><termGrp><term id="2879286">automated investigation</term><termNote type="partOfSpeech">Noun</termNo