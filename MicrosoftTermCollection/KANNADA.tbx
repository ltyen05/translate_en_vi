 type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9104_361202_475152"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A combination of identifiers, which together define Internet Protocol security (IPsec), that protects communication between sender and receiver.</descrip></descripGrp><ntig><termGrp><term id="361202">security association</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="475152">SA</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9104_361202_475156"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A combination of identifiers, which together define Internet Protocol security (IPsec), that protects communication between sender and receiver.</descrip></descripGrp><ntig><termGrp><term id="361202">security association</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="475156">ಭದ್ರತೆ ಸಭೆ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9110_316263_1253203"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A label that is printed with a recipient's address and is used to mail or ship an item.</descrip></descripGrp><ntig><termGrp><term id="316263">shipping label</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammati