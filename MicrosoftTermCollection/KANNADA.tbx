75_3012699"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature of the Calculator app that allows the user to store a figure for use in future calculations.</descrip></descripGrp><ntig><termGrp><term id="3012675">Memory</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="3012699">ಮೆಮೊರಿ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52990_3012676_3013552"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Teams feature that allows a user to draw on and annotate an object on the screen.</descrip></descripGrp><ntig><termGrp><term id="3012676">Annotate</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="3013552">ಚಿತ್ರಿಸಿ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52991_3012677_3013555"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The link in Teams that allows a user to access information about a meeting.</descrip></descripGrp><ntig><termGrp><term id="3012677">Info</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="3013555">ಮಾಹಿತಿ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52992_3012678_3013553"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The link in Teams that allows a user to access and add applications like Forms or PowerApps.</descrip></descripGrp><ntig><termGrp><term id="3012678">Apps</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="3013553">ಆಪ್ಗಳು</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52993_3012679_3013558"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The high-fidelity music mode in Teams that offers a richer sound experience when the user transmits music to listeners.</descrip></descripGrp><ntig><termGrp><term id="3012679">Music</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="3013558">ಸಂಗೀತ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52994_3012680_3013562"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The link in Teams that allows users to access a participant roster which shows a list of people present in a meeting.</descrip></descripGrp><ntig><termGrp><term id="3012680">People</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><nt