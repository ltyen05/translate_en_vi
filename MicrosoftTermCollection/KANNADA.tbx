4144"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The tool that allows users to import Evernote notes into OneNote.</descrip></descripGrp><ntig><termGrp><term id="2359171">OneNote Importer</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2364144">OneNote ಆಮದುಕಾರ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40678_2359180_2364145"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The mobile app that allows users to create a group so that members can collaborate, share messages, calendar events, files, tasks, and so on.</descrip></descripGrp><ntig><termGrp><term id="2359180">Outlook Groups</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2364145">Outlook Groups</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4068_186296_474333"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The integral Windows component that supports building, deploying, and running the next generation of applications and XML Web services. It provides a highly productive, standards-based, multilanguage environment for integrating existing investments with next generation applications and services, as well as the agility to solve the challenges of deployment and operation of Internet-scale applications.</descrip></descripGrp><ntig><termGrp><term id="186296">.NET Framework</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="474333">.NET Framework</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4068_536518_474333"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The integral Windows component that supports building, deploying, and running the next generation of applications and XML Web services. It provides a highly productive, standards-based, multilanguage environment for integrating existing investments with next generation applications and services, as well as the agility to solve the challenges of deployment and operation of Internet-scale applications.</descrip></descripGrp><ntig><termGrp><term id="536518">Framework</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="474333">.NET Framework</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40683_2360130_2362049"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The collection title for TV shows that are in the top N% of sales.</descrip></descripGrp><ntig><termGrp><term id="2360130">Top-selling TV shows</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2362049">ಪ್ರಮುಖ-ಮಾರಾಟವಾಗುವ TV ಪ್ರದರ್ಶನಗಳು</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40684_2360133_2361993"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Not containing any ads being played beforehand.</descrip></descripGrp><ntig><termGrp><term id="2360133">ad-free</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2361993">ಜಾಹೀರಾತು-ಮುಕ್ತ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40685_2360134_2361996"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The metadata about the song in a music album, such as genre, artist, year.</descrip></descripGrp><ntig><termGrp><term id="2360134">album info</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2361996">ಆಲ್ಬಂ ಮಾಹಿತಿ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40686_2360135_2361999"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The credits for a movie or TV show including the main actors, actresses, directors, and more.</descrip></descripGrp><ntig><termGrp><term id="2360135">cast and crew</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</t