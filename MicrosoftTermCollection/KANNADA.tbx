46462"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A demonstration of a product or service that a customer interacts with to see how features work.</descrip></descripGrp><ntig><termGrp><term id="1509011">demo</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1646462">ಪ್ರಾತ್ಯಕ್ಷಿಕೆ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29491_1509011_1646500"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A demonstration of a product or service that a customer interacts with to see how features work.</descrip></descripGrp><ntig><termGrp><term id="1509011">demo</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1646500">ಸಂವಹನ ಪ್ರಾತ್ಯಕ್ಷಿಕೆ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29491_1509012_1646462"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A demonstration of a product or service that a customer interacts with to see how features work.</descrip></descripGrp><ntig><termGrp><term id="1509012">interactive demo</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1646462">ಪ್ರಾತ್ಯಕ್ಷಿಕೆ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammatic