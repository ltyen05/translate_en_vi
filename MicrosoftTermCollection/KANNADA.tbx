<termEntry id="16348_318717_474927"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To advance audio or video playback at a speed that is faster than normal.</descrip></descripGrp><ntig><termGrp><term id="318717">fast forward</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="474927">ಫಾಸ್ಟ್ ಫಾರ್ವರ್ಡ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16358_210492_474356"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of attack that tries to trick users into revealing personal information, such as credit card numbers, bank accounts, or passwords, often using links to fake websites included in emails and chat messages.</descrip></descripGrp><ntig><termGrp><term id="210492">phishing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="474356">ಫಿಶಿಂಗ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16364_1636235_2198180"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An 8-digit code used to unlock the SIM card. A Personal Unlocking Key is a type of personal identification number (PIN).</descrip></descripGrp><ntig><termGrp><term id="1636235">PIN unlock key</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2198180">PIN 