">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26686_1346464_1358654"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The label for the Windows Live Devices task webpage where someone specifies a name and an icon for the computer that they plan to sync.</descrip></descripGrp><ntig><termGrp><term id="1346464">Personalize</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1358654">ವೈಯಕ್ತೀಕರಣಗೊಳಿಸು</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26687_1346465_1358659"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The group label for the links that provide one-click access to a subset of email messages based on specific criteria, such as flagged, containing photos, and from social networking services.</descrip></descripGrp><ntig><termGrp><term id="1346465">Quick views</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1358659">ತ್ವರಿತ ವೀಕ್ಷಣೆಗಳು</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2669_153111_474224"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The number of bits transmitted every second, used as a measure of the speed at which a device, such as a modem, can transfer data.</descrip></descripGrp><ntig><termGrp><term id="153111">bits per second</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="474224">ಬಿಟ್ಸ್ ಪರ್ ಸೆಕೆಂಡ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2669_153111_474225"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The number of bits transmitted every second, used as a measure of the speed at which a device, such as a modem, can transfer data.</descrip></descripGrp><ntig><termGrp><term id="153111">bits per second</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="474225">bps</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2669_153112_474224"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The number of bits transmitted every second, used as a measure of the speed at which a device, such as a modem, can transfer data.</descrip></descripGrp><ntig><termGrp><term id="153112">bps</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="474224">ಬಿಟ್ಸ್ ಪರ್ ಸೆಕೆಂಡ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2669_153112_474225"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The number of bits transmitted every second, used as a measure of the speed at which a device, such as a modem, can transfer data.</descrip></descripGrp><ntig><termGrp><term id="153112">bps</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="474225">bps</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26690_1347061_1358691"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The UI label for the Hotmail quick view that displays only the email messages that originate from a social networking service such as Facebook.</descrip></descripGrp><ntig><termGrp><term id="1347061">Social updates</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1358691">ಸಾಮಾಜಿಕ ಪರಿಷ್ಕರಣೆಗಳು</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26691_1347063_1358696"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The spam-fighting program that Hotmail runs where actual customers classify email messages as "junk" or "not junk." Because the program is by invitation only, customers who participate are highly engaged. The Hotmail team reported in 2010 that more than half of the spam fighters participate daily. Invitations to the program are extended to a cross-section of customers who reflect the broad population of Hotmail customers in several dimensions, including age of account and country or region. Under the program, Hotmail resends an actual message that was addressed to the spam fighter. One message per day at the most is sent.</descrip></descripGrp><ntig><termGrp><term id="1347063">Spam Fighters program</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1358696">ಸ್ಪ್ಯಾಮ್ ಫೈಟರ್ಸ್ ಪ್ರೋಗ್ರಾಂ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26691_1354361_1358696"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The spam-fighting program that Hotmail runs where actual customers classify email messages as "junk" or "not junk." Because the program is by invitation only, customers who participate are highly engaged. The Hotmail team reported in 2010 that more than half of the spam fighters participate daily. Invitations to the program are extended to a cross-section of customers who reflect the broad population of Hotmail customers in several dimensions, including age of account and country or region. Under the program, Hotmail resends an actual message that was addressed to the spam fighter. One message per day at the most is sent.</descrip></descripGrp><ntig><termGrp><term id="1354361">Feedback Loop program</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1358696">ಸ್ಪ್ಯಾಮ್ ಫೈಟರ್ಸ್ ಪ್ರೋಗ್ರಾಂ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26692_1347064_1358232"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A rating system for online games.</descrip></descripGrp><ntig><termGrp><term id="1347064">game rating system</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1358232">ಆಟದ ರೇಟಿಂಗ್ ಸಿಸ್ಟಂ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26696_1347068_1358738"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A conversation that is displayed with other conversations in one window. The conversations are loaded into sections or tabs of the window, rather than in multiple windows.</descrip></descripGrp><ntig><termGrp><term id="1347068">tabbed conversation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1358738">ಟ್ಯಾಬ್ ಮಾಡಿದ ಸಂಭಾಷಣೆ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26697_1347069_1358687"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The webpage subheading for the view in Messenger that displays the social activity of friends.</descrip></descripGrp><ntig><termGrp><term id="1347069">social</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1358687">ಸಾಮಾಜಿಕ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26698_1347070_1358243"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The UI label in Messenger for the aspect of the social view that displays prioritized recent social activity of friends.</descrip></descripGrp><ntig><termGrp><term id="1347070">highlights</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1358243">ಮುಖ್ಯಾಂಶಗಳು</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26699_1347071_1358656"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An email message that has image attachements, inline images, inline video, or an inline album.</descrip></descripGrp><ntig><termGrp><term id="1347071">photo e-mail</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1358656">ಫೋಟೋ ಇ-ಮೇಲ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26700_1347072_1358053"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A custom-created layout of photos in an album.</descrip></descripGrp><ntig><termGrp><term id="1347072">arrangement</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1358053">ಆಯೋಜನೆ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26702_1347074_1358663"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that lets you work on your computer from a different computer.</descrip></descripGrp><ntig><termGrp><term id="1347074">remote connection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1358663">ರಿಮೋಟ್ ಜೋಡಣೆ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26703_1347075_1358653"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The tooltip that is displayed when hovering over a personal folder on the Manage Folders webpage.</descrip></descripGrp><ntig><termGrp><term id="1347075">Personal Folder</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1358653">ವೈಯಕ್ತಿಕ ಫೋಲ್ಡರ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26704_1347076_1358733"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The webpage subheading for the list of synced folders.</descrip></descripGrp><ntig><termGrp><term id="1347076">Synced folders</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1358733">ಸಿಂಕ್ ಮಾಡಿದ ಫೋಲ್ಡರ್‌ಗಳು</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26705_1347077_1358643"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The UI element that allows users to set permissions for an item or content so that is not made available to anyone else, thus making it private.</descrip></descripGrp><ntig><termGrp><term id="1347077">Just me</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1358643">ನಾನಷ್ಟೇ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26706_1347078_1368166"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The UI label for the social activity stream that Windows Live programmatically displays in a collection. Items listed may originate within a Windows Live program, service, or landing page (Messenger, OneDrive, Windows Live Photos), or in third-party activities people connect to their profiles, such as Facebook.</descrip></descripGrp><ntig><termGrp><term id="1347078">Messenger social</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1368166">Messenger ಸಾಮಾಜಿಕ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26707_1347079_1358218"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To manually edit and make adjustments to your photos.</descrip></descripGrp><ntig><termGrp><term id="1347079">fine tune</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1358218">ಫೈನ್ ಟ್ಯೂನ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26708_1347080_1358236"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A metadata tag that includes GPS latitude and longitude coordinates to specify a location. Geotags are typically used to find and organise photos and videos.</descrip></descripGrp><ntig><termGrp><term id="1347080">geotag</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1358236">ಜಿಯೊಟ್ಯಾಗ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26709_1347081_1368613"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To present items within a set in no established order, as opposed to ordering items by name, by date taken, by size, etc., and typically used with audio and visual media, such as album song order or photo slide shows.</descrip></descripGrp><ntig><termGrp><term id="1347081">shuffle</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1368613">ಶಫಲ್ ಮಾಡಿ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26710_1347082_1369219"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables users to share stories with others using their digital photos and photo management software.</descrip></descripGrp><ntig><termGrp><term id="1347082">storytelling</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1369219">ಕಥೆ ಹೇಳುವುದು</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26714_1347086_1358765"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To add a personal touch to something.</descrip></descripGrp><ntig><termGrp><term id="1347086">personalize</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1358765">ವೈಯಕ್ತೀಕರಣಗೊಳಿಸು</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26719_1347108_1358658"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A view that provides one-click access to a subset of email messages based on specific criteria, which include: flagged (messages that the customer has designated as requiring follow-up), photos (messages that contain photos), and social updates (messages that originate from a social networking service such as Facebook).</descrip></descripGrp><ntig><termGrp><term id="1347108">quick view</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1358658">ತ್ವರಿತ ವೀಕ್ಷಣೆ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26720_1347110_1358227"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The webpage subheading for the view in Messenger that displays someone's friends and contacts that aren't friends but that can be interacted with in Messenger (those are often legacy entries).</descrip></descripGrp><ntig><termGrp><term id="1347110">friends</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1358227">ಸ್ನೇಹಿತರು</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26728_1354362_1461624"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in Hotmail that's designed to help people get more done on the web without having to leave their inbox. Active View displays directly in the body of the email message, showing either previews to other web content or interactive elements created by the sender that let the recipient complete core tasks. A preview message example might include a reference to a file on a photo-sharing or video-sharing website that the recipient can view in the message, or package-tracking information that's extracted from a shipping website. Interactive scenarios might include rating movies and updating wish lists on movie-rental websites or responding to invitations or comments on social networking websites.</descrip></descripGrp><ntig><termGrp><term id="1354362">Active View</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1461624">ಸಕ್ರಿಯ ವೀಕ್ಷಣೆ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26731_1354365_1903479"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An equation written using a stylus on a Tablet PC.</descrip></descripGrp><ntig><termGrp><term id="1354365">ink equation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1903479">ಇಂಕ್ ಸಮೀಕರಣ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26735_1354369_1989384"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application that is meant to run on a desktop or laptop computer.</descrip></descripGrp><ntig><termGrp><term id="1354369">desktop application</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1989384">ಡೆಸ್ಕ್‌ಟಾಪ್ ಪ್ರೋಗ್ರಾಮ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26735_1505030_1989384"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application that is meant to run on a desktop or laptop computer.</descrip></descripGrp><ntig><termGrp><term id="1505030">desktop app</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1989384">ಡೆಸ್ಕ್‌ಟಾಪ್ ಪ್ರೋಗ್ರಾಮ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26735_1986256_1989384"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application that is meant to run on a desktop or laptop computer.</descrip></descripGrp><ntig><termGrp><term id="1986256">desktop program</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1989384">ಡೆಸ್ಕ್‌ಟಾಪ್ ಪ್ರೋಗ್ರಾಮ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26737_1354381_1358754"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that gives users a rich way to send video messages asynchronously to another user.</descrip></descripGrp><ntig><termGrp><term id="1354381">Video Messages</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1358754">ವೀಡಿಯೊ ಸಂದೇಶಗಳು</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26737_1815478_1358754"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that gives users a rich way to send video messages asynchronously to another user.</descrip></descripGrp><ntig><termGrp><term id="1815478">video messages</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1358754">ವೀಡಿಯೊ ಸಂದೇಶಗಳು</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26738_1354382_1368236"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables users to access their other POP3 enabled email accounts from within their central email account.</descrip></descripGrp><ntig><termGrp><term id="1354382">POP aggregation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1368236">POP ಒಟ್ಟುಗೂಡಿಸುವಿಕೆ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26740_1354385_1461612"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A small image that provides a visual indication of roles, contribution levels, achievements, affiliations, etc.</descrip></descripGrp><ntig><termGrp><term id="1354385">badge</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1461612">ಬ್ಯಾಡ್ಜ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26742_1354388_1368150"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A contact list designed for use within a form for selecting contacts. Users can click a contact to select it and may make multiple selections by using CTRL+click.</descrip></descripGrp><ntig><termGrp><term id="1354388">contact picker</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1368150">ಸಂಪರ್ಕದ ಪಿಕರ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26769_1354855_1903480"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A recording that can be added to a presentation.</descrip></descripGrp><ntig><termGrp><term id="1354855">narration</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1903480">ನಿರೂಪಣೆ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26773_1355136_3134350"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A trusted industry standard in online pharmacy verification. Established in 2003, the PharmacyChecker Verification Program helps protect consumers by ensuring that the prescription drugs they order come from qualified online pharmacies.</descrip></descripGrp><ntig><termGrp><term id="1355136">PharmacyChecker</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="3134350">PharmacyChecker</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26782_1355242_2781349"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A primary SharePoint Server management plan that identifies what is considered a record, what category the record belong to, where the records are stored, record retention period, and who manages the record.</descrip></descripGrp><ntig><termGrp><term id="1355242">file plan</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2781349">ಫೈಲ್ ಯೋಜನೆ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26784_1355244_1903481"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of formatting options (Quick Styles) that are designed to be used together.</descrip></descripGrp><ntig><termGrp><term id="1355244">Quick Style set</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1903481">ತ್ವರಿತ ಶೈಲಿಯ ಸೆಟ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26786_1355342_2074192"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To remove the ability of a network object to access server resources.</descrip></descripGrp><ntig><termGrp><term id="1355342">deactivate</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2074192">ನಿಷ್ಕ್ರಿಯಗೊಳಿಸಿ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26786_2283119_2074192"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To remove the ability of a network object to access server resources.</descrip></descripGrp><ntig><termGrp><term id="2283119">unelevate</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2074192">ನಿಷ್ಕ್ರಿಯಗೊಳಿಸಿ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26842_1357076_1956662"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A service that allows users to meet in virtual rooms on a server running Exchange.</descrip></descripGrp><ntig><termGrp><term id="1357076">Exchange Conferencing Services</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1956662">Exchange ಕಾನ್ಫರೆನ್ಸಿಂಗ್ ಸೇವೆಗಳು</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26894_1358510_2793757"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A technology used by Exchange to store user mailboxes and folders. A store consists of a rich-text database (.edb), plus a streaming native Internet content database (.stm).</descrip></descripGrp><ntig><termGrp><term id="1358510">store</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2793757">ಸ್ಟೋರ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2690_19121_473297"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A keyboard key that moves the cursor to the left, one character at a time, usually erasing each character as it moves.</descrip></descripGrp><ntig><termGrp><term id="19121">BACKSPACE key</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="473297">BACKSPACE ಕೀಲಿ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26949_1359312_1461635"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A person someone has established a mutual connection with, particularly via social networks or digital communication channels.</descrip></descripGrp><ntig><termGrp><term id="1359312">friend</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1461635">ಸ್ನೇಹಿತ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26950_1359313_1461643"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Windows Live ID that is connected to at least one other Windows Live ID. When customers link IDs, they can sign in with one ID and switch to others without having to sign out from the first. Customers set up linked IDs in Windows Live Account.</descrip></descripGrp><ntig><termGrp><term id="1359313">linked ID</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1461643">ಲಿಂಕ್ ಮಾಡಿದ ID</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><te