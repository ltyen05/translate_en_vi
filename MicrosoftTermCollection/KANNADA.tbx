cted</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1251204">ಸ್ಲೈಡ್ ಶೋ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21290_768424_1251205"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A recordable media (such as CD-RW) to which you can only write once without reformatting.</descrip></descripGrp><ntig><termGrp><term id="768424">single session-only disc</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1251205">ಏಕ ಸಭೆಯ-ಮಾತ್ರ ಡಿಸ್ಕ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21291_768440_1251206"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A recordable media to which you can write several times without reformatting.</descrip></descripGrp><ntig><termGrp><term id="768440">multi session-capable disc</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1251206">ಬಹು ಸಭೆಯ ಸಶಕ್ತ ಡಿಸ್ಕ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21291_768440_1308178"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A recordable media to which you can write several times without reformatting.</descrip></descripGrp><ntig><termGrp><term id="768440">multi session-capable disc</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1308178">ಮಲ್ಟಿಪಲ್ ಸೆಷನ್-ಕೇಪಬಲ್ ಡಿಸ್ಕ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21299_768624_1251207"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that is added to the Microsoft Office Compatibility Pack to open Word, Excel, and PowerPoint binary format files and securely convert them to the Office 2007 file formats.</descrip></descripGrp><ntig><termGrp><term id="768624">Microsoft Office Isolated Conversion Environment</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1251207">MOICE</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21299_768625_1251207"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that is added to the Microsoft Office Compatibility Pack to open Word, Excel, and PowerPoint binary format files and securely convert them to the Office 2007 file formats.</descrip></descripGrp><ntig><termGrp><term id="768625">MOICE</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1251207">MOICE</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21300_1054681_1251208"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that makes Outlook auto-complete lists available through the default Exchange mailbox.</descrip></descripGrp><ntig><termGrp><term id="1054681">Suggested Contacts</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1251208">ಸೂಚಿಸಿದ ಸಂಪರ್ಕಗಳು</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21301_769458_1251209"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A common credential store and interface that is used to save and manage user credentials, such as user names and passwords, so you can easily log on to Web sites and connect to other resources, such as computers.</descrip></descripGrp><ntig><termGrp><term id="769458">Credential Manager</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1251209">ಕ್ರೆಡೆನ್ಶಿಯಲ್ ವ್ಯವಸ್ಥಾಪಕ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21302_769460_1598522"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of credentials that users can create, store and manage in Credential Manager.</descrip></descripGrp><ntig><termGrp><term id="769460">vault</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1598522">ವಾಲ್ಟ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21303_769462_1251211"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of vault that contains Web passwords and secure notes that you can place on a USB flash drive and use on another computer.</descrip></descripGrp><ntig><termGrp><term id="769462">personal vault</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1251211">ವಯಕ್ತಿಕ ಕಮಾನು</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21303_769462_1308180"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of vault that contains Web passwords and secure notes that you can place on a USB flash drive and use on another computer.</descrip></descripGrp><ntig><termGrp><term id="769462">personal vault</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1308180">ವೈಯಕ್ತಿಕ ವ್ಯಾಲೆಟ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21309_769803_2198307"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To remove data permanently from a storage medium. This is usually done by replacing existing data with zeros or meaningless text or, in magnetic media, by disturbing the magnetic particles' physical arrangement, either with the erase head or with a large magnet.</descrip></descripGrp><ntig><termGrp><term id="769803">erase</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2198307">ಅಳಿಸು</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2131_397166_1956682"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process of permanently deleting something by removing it from the store or moving it to the dumpster when dumpster functionality is enabled.</descrip></descripGrp><ntig><termGrp><term id="397166">hard delete</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1956682">ಶಾಶ್ವತ ಅಳಿಸುವಿಕೆ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2132_125577_474016"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">When referring to a device, to remove the corresponding device drivers from the hard disk and physically remove the device from the computer.</descrip></descripGrp><ntig><termGrp><term id="125577">uninstall</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="474016">ಅಸ್ಥಾಪಿಸು</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21322_769845_1423629"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A control in a form that consists of an actionable image. At run time the user can click the image to run rules or actions similar to a button.</descrip></descripGrp><ntig><termGrp><term id="769845">picture button</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1423629">ಚಿತ್ರದ ಒತ್ತುಗುಂಡಿ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21329_769992_2855542"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To forward a piece of data from one part of a program to another.</descrip></descripGrp><ntig><termGrp><term id="769992">pass</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2855542">ರವಾನಿಸು</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21333_770402_2198279"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A note that contains recorded information.</descrip></descripGrp><ntig><termGrp><term id="770402">voice note</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2198279">ಧ್ವನಿ ಟಿಪ್ಪಣಿ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21334_2675561_2400107"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft app that creates sticky notes that can be shared between devices, that cloud sync, that are stored on Exchange, and that provide contextual reminders and actions that can be performed based on the content.</descrip></descripGrp><ntig><termGrp><term id="2675561">Microsoft Sticky Notes</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2400107">ಸ್ಟಿಕಿ ಟಿಪ್ಪಣಿಗಳು</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21334_2675561_2676794"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft app that creates sticky notes that can be shared between devices, that cloud sync, that are stored on Exchange, and that provide contextual reminders and actions that can be performed based on the content.</descrip></descripGrp><ntig><termGrp><term id="2675561">Microsoft Sticky Notes</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2676794">Microsoft ಸ್ಟಿಕಿ ಟಿಪ್ಪಣಿಗಳು</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21334_770408_2400107"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft app that creates sticky notes that can be shared between devices, that cloud sync, that are stored on Exchange, and that provide contextual reminders and actions that can be performed based on the content.</descrip></descripGrp><ntig><termGrp><term id="770408">Sticky Notes</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2400107">ಸ್ಟಿಕಿ ಟಿಪ್ಪಣಿಗಳು</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21334_770408_2676794"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft app that creates sticky notes that can be shared between devices, that cloud sync, that are stored on Exchange, and that provide contextual reminders and actions that can be performed based on the content.</descrip></descripGrp><ntig><termGrp><term id="770408">Sticky Notes</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2676794">Microsoft ಸ್ಟಿಕಿ ಟಿಪ್ಪಣಿಗಳು</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21335_770428_2412554"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An individual piece of content that resembles a physical sticky note, is displayed across multiple apps and platforms, and that is created using Sticky Notes.</descrip></descripGrp><ntig><termGrp><term id="770428">sticky note</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2412554">ಸ್ಟಿಕಿ ಟಿಪ್ಪಣಿ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21348_771258_3045283"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To continue movement, as with the cursor or a search operation, to the beginning or to a new starting point rather than stopping when the end of a series is reached. For example, the screen cursor might wrap around to the first column of the next line rather than stopping when it reaches the last column of the current line. Likewise, a program starting a search or replace operation in the middle of a document might be instructed to wrap around to the beginning rather than stop when it reaches the end of the document.</descrip></descripGrp><ntig><termGrp><term id="771258">wrap around</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="3045283">ಸುತ್ತಲೂ ವ್ರ್ಯಾಪ್ ಮಾಡಿ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21353_1177078_1251212"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables presenters in the rich client to broadcast a slide show to remote viewers watching in a Web browser. Throughout the presentation, the remote attendees will see the current slide being shown by the presenter.</descrip></descripGrp><ntig><termGrp><term id="1177078">PowerPoint Broadcast Slide Show</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1251212">ಪ್ರಸಾರಣ ಸ್ಲೈಡ್ ಶೊ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21353_772635_1251212"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables presenters in the rich client to broadcast a slide show to remote viewers watching in a Web browser. Throughout the presentation, the remote attendees will see the current slide being shown by the presenter.</descrip></descripGrp><ntig><termGrp><term id="772635">Broadcast Slide Show</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1251212">ಪ್ರಸಾರಣ ಸ್ಲೈಡ್ ಶೊ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21354_1075942_1251213"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A labeled group of consecutive slides that helps the user navigate and organize presentations.</descrip></descripGrp><ntig