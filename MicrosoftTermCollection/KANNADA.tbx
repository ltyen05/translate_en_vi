87819">SMS ಆಯೋಜಕ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44238_2485689_2487815"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of design components with a consistent aesthetic theme and with consistent patterns that convey meaning to users.</descrip></descripGrp><ntig><termGrp><term id="2485689">design language</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2487815">ವಿನ್ಯಾಸ ಭಾಷೆ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44239_2485690_2487818"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The design language used for all products in Office 365 and SharePoint.</descrip></descripGrp><ntig><termGrp><term id="2485690">Office Design Language</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2487818">Office ವಿನ್ಯಾಸ ಭಾಷೆ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44240_2485691_2486642"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The open-source, front-end framework, written in Fluent Design, for designing and building experiences that fit seamlessly into a broad range of Microsoft 365 products.</descrip></descripGrp><ntig><termGrp><term id="2485691">Office UI Fabric</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2486642">Office UI Fabric</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44241_2485693_2486643"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The front-end package that is part of Office UI Fabric and that contains the core building blocks of the Office Design Language.</descrip></descripGrp><ntig><termGrp><term id="2485693">Office UI Fabric Core</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2486643">Office UI Fabric Core</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44242_2485694_2486644"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The front-end package that is part of Office UI Fabric and that contains a set of React components.</descrip></descripGrp><ntig><termGrp><term id="2485694">Office UI Fabric React</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2486644">Office UI Fabric React</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44243_2485701_2487813"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The warning that Excel displays when a function cannot be executed because configuration or user settings block certain functionality, such as accessing data over the internet.</descrip></descripGrp><ntig><termGrp><term id="2485701">#BLOCKED!</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2487813">#BLOCKED!</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44245_2485904_2487806"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A website that customers can go to for help with Microsoft products.</descrip></descripGrp><ntig><termGrp><term id="2485904">Microsoft Support</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2487806">Microsoft ಬೆಂಬಲ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4425_232401_1903139"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Calendar, time status and user defined labels are indicated by colors and patterns.</descrip></descripGrp><ntig><termGrp><term id="232401">free/busy time</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1903139">ಉಚಿತ/ನಿರತ ಸಮಯ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44250_2486129_2497089"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In mixed reality, an app view in which the app takes over the full display and becomes the only app you see.</descrip></descripGrp><ntig><termGrp><term id="2486129">immersive view</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2497089">ಇಮ್ಮರ್ಸಿವ್ ವೀಕ್ಷಣೆ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44253_2486136_2497090"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Windows Mixed Reality​, the desktop app that allows the user to manage their mixed reality headset, get status on their mixed reality hardware, see a live stream of what's visible in the headset, and complete system setup.​</descrip></descripGrp><ntig><termGrp><term id="2486136">Mixed Reality Portal</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2497090">ಮಿಶ್ರ ವಾಸ್ತವ ಪೋರ್ಟಲ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44259_2486144_2497181"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The mixed reality experience built into Windows that powers a compatible virtual reality headset or head-mounted display.</descrip></descripGrp><ntig><termGrp><term id="2486144">Windows Mixed Reality</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2497181">Windows Mixed Reality</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44260_2486898_2488858"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A conclusion of a business interaction.</descrip></descripGrp><ntig><termGrp><term id="2486898">close</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2488858">ಕೊನೆಯ ದಿನಾಂಕ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44261_2486899_2488864"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A record of a meeting.</descrip></descripGrp><ntig><termGrp><term id="2486899">meeting log</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2488864">ಸಭೆಯ ಲಾಗ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44262_2486900_2488863"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A record of a call</descrip></descripGrp><ntig><termGrp><term id="2486900">call log</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2488863">ಕರೆ ಲಾಗ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4427_297178_1253126"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Software that changes browser settings, such as the home page, without adequate consent.</descrip></descripGrp><ntig><termGrp><term id="297178">browser modifier</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1253126">ಬ್ರೌಸರ್ ಮಾಡಿಫಾಯರ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4427_297178_1319360"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Software that changes browser settings, such as the home page, without adequate consent.</descrip></descripGrp><ntig><termGrp><term id="297178">browser modifier</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1319360">ಬ್ರೌಸರ್ ಮಾಡಿಫಯರ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44282_2488643_2493914"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft app that intercepts HTTP links to Office documents when users click on them and gives the link to the Word, Excel or PowerPoint app to open.</descrip></descripGrp><ntig><termGrp><term id="2488643">Microsoft Office Helper</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2493914">Microsoft Office ಸಹಾಯಕ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44283_2488671_2493910"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The area in Outlook Customer Manager where the most important deals and information on those deals are displayed.</descrip></descripGrp><ntig><termGrp><term id="2488671">Focused</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2493910">ಕೇಂದ್ರೀಕೃತ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44290_2488792_2493906"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The field in Outlook Customer Manager that holds the negotiable amount the provider will receive for a deal and which is finalized once the deal is closed.</descrip></descripGrp><ntig><termGrp><term id="2488792">Deal amount</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2493906">ಡೀಲ್ ಪ್ರಮಾಣ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44291_2488793_2493908"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The field in Outlook Customer Manager that records the number of deals that did not go through as well as their sum.</descrip></descripGrp><ntig><termGrp><term id="2488793">Deals lost</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2493908">ಕಳೆದುಕೊಂಡ ಡೀಲ್‌ಗಳು</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44292_2488794_2493909"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The field in Outlook Customer Manager that records the number of deals that were accepted and completed as well as their sum.</descrip></descripGrp><ntig><termGrp><term id="2488794">Deals won</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2493909">ಗೆದ್ದ ಡೀಲ್‌ಗಳು</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44293_2488795_2493913"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The field in Outlook Customer Manager that records the number of deals have not been finalized (won or lost), as well as their sum.</descrip></descripGrp><ntig><termGrp><term id="2488795">Deals active</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2493913">ಸಕ್ರಿಯ ಡೀಲ್‌ಗಳು</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44315_2489135_2493911"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The offer for students and educators that includes the Universal Windows Platform versions of Excel, PowerPoint, and Word, and that allows shared computer activation.</descrip></descripGrp><ntig><termGrp><term id="2489135">Office 365 Education Cart</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2493911">Office 365 ಶಿಕ್ಷಣ ಕಾರ್ಟ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44329_2489211_2590045"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The application available on devices you manage with Intune which is used to access company data to perform common tasks like enrolling devices, installing apps, and locating information for assistance from your IT department.</descrip></descripGrp><ntig><termGrp><term id="2489211">Intune Company Portal</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2590045">Intune Company Portal</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44329_2489211_2590109"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The application available on devices you manage with Intune which is used to access company data to perform common tasks like enrolling devices, installing apps, and locating information for assistance from your IT department.</descrip></descripGrp><ntig><termGrp><term id="2489211">Intune Company Portal</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2590109">Company Portal</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44329_2490036_2590045"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The application available on devices you manage with Intune which is used to access company data to perform common tasks like enrolling devices, installing apps, and locating information for assistance from your IT department.</descrip></descripGrp><ntig><termGrp><term id="2490036">Company Portal</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2590045">Intune Company Portal</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44329_2490036_2590109"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The application available on devices you manage with Intune which is used to access company data to perform common tasks like enrolling devices, installing apps, and locating information for assistance from your IT department.</descrip></descripGrp><ntig><termGrp><term id="2490036">Company Portal</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2590109">Company Portal</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44349_2490693_2500313"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Outlook feature that allows users to select a later time to automatically deliver emails and where said emails are stored in the Drafts folder until the time selected for sending.​</descrip></descripGrp><ntig><termGrp><term id="2490693">Send Later</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2500313">ನಂತರ ಕಳುಹಿಸಿ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44350_2490694_2503341"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The value that Excel returns when a formula returns an array of values and one or more of the cells it would spill to already has content.</descrip></descripGrp><ntig><termGrp><term id="2490694">#NOSPILL!</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2503341">#NOSPILL!</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44351_2490695_2500311"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The value that Excel returns when a function tried to connect to a network resource or a remote service but failed.​​</descrip></descripGrp><ntig><termGrp><term id="2490695">#CONNECT!</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2500311">#CONNECT</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44351_2490695_2503339"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The value that Excel returns when a function tried to connect to a network resource or a remote service but failed.​​</descrip></descripGrp><ntig><termGrp><term id="2490695">#CONNECT!</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2503339">#CONNECT!</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44352_2490696_2503340"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Excel cell capability that allows a cell to place array values in neighboring blank cells.</descrip></descripGrp><ntig><termGrp><term id="2490696">Spill</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2503340">ಸ್ಪಿಲ್‌</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44355_2493977_2513489"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A container for a collection of configuration settings file with extension .ppkg. Provisioning packages are simple enough that with a short set of written instructions, a student or non-technical employee can use them to configure their device.</descrip></descripGrp><ntig><termGrp><term id="2493977">provisioning package</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2513489">ಒದಗಿಸುವ ಪ್ಯಾಕೇಜ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44356_2493981_2513492"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The academic disciplines of science, technology, engineering and mathematics, used when addressing education policy and curriculum choices in schools.</descrip></descripGrp><ntig><termGrp><term id="2493981">STEM</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2513492">STEM</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44357_2493985_2513487"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collaborative work space, tool, app, or program for making, learning, exploring and sharing. It can refer to a literal space or place, or to digital environments where people are encouraged to create and share with a community.</descrip></descripGrp><ntig><termGrp><term id="2493985">makerspace</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2513487">ಮೇಕರ್‌ಸ್ಪೇಸ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44358_2493987_2513484"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A test with important consequences for the test taker or which is the basis of a major decision.</descrip></descripGrp><ntig><termGrp><term id="2493987">high-stakes testing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2513484">ಹೆಚ್ಚಿನ ಹೊಣೆಯ ಪರೀಕ್ಷೆ</term><termNote type="geograp