et></termEntry><termEntry id="32240_1641050_1903642"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A property grid that only displays the properties that appear in the sentence-level view of an action.</descrip></descripGrp><ntig><termGrp><term id="1641050">top-level property grid</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1903642">ಉನ್ನತ ಮಟ್ಟದ ಗುಣಲಕ್ಷಣ ಗ್ರಿಡ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32261_1644639_1903643"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A contextual summary of appointment or meeting information, which is displayed in a callout without opening the item.</descrip></descripGrp><ntig><termGrp><term id="1644639">calendar item peek</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1903643">ಕ್ಯಾಲೆಂಡರ್ ಐಟಂ ಪೀಕ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32262_1644650_1903644"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A contextual summary of the user's daily schedule, which is displayed in a callout without switching to the Calendar module.</descrip></descripGrp><ntig><termGrp><term id="1644650">Calendar peek</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id=