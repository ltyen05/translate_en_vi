38657">edge</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1646488">ತುದಿ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32213_1638658_1646914"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To transfer data such as files to a device or an app.</descrip></descripGrp><ntig><termGrp><term id="1638658">send</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1646914">ಕಳುಹಿಸಿ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32219_1641030_1903632"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tool that is used to apply formatting to borders in a table.</descrip></descripGrp><ntig><termGrp><term id="1641030">Border Painter</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1903632">ಅಂಚಿನ ಪೇಯಿಂಟರ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32220_1641031_1903633"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tool used to collect the formatting of an existing table border so that 