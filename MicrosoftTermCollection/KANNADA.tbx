76_2968523"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Financial Excel function that returns the depreciation of an asset for a specified period by using the fixed-declining balance method.</descrip></descripGrp><ntig><termGrp><term id="2955576">DB</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2968523">DB</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52365_2955577_2968524"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Text Excel function that changes half-width (single-byte) English letters or katakana within a character string to full-width (double-byte) characters.</descrip></descripGrp><ntig><termGrp><term id="2955577">DBCS</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2968524">DBCS</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52366_2955578_2968525"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Database Excel function that counts the cells that contain numbers in a database.</descrip></descripGrp><ntig><termGrp><term id="2955578">DCOUNT</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2968525">DCOUNT</term><termNote type="geog