><descripGrp><descrip type="definition">The collection of background images for the Windows lock screen and/or the Windows desktop, with hotspots overlaying linking to information about the image, in-product marketing, experiences, or tips and tricks.</descrip></descripGrp><ntig><termGrp><term id="2884921">spotlight collection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2885564">ಸ್ಪಾಟ್‌ಲೈಟ್ ಸಂಗ್ರಹ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51108_2885547_2886553"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To stream the content of a user's device screen or a separate window to the screens of other users' devices, so these users could remotely see the screen of the user who shares it.</descrip></descripGrp><ntig><termGrp><term id="2885547">share</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2886553">ಹಂಚಿಕೊಳ್ಳಿ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51109_2885548_2886552"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An app that helps users be more productive at work, such as Office apps.</descrip></descripGrp><ntig><termGrp><term id="2885548">productivity app</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><ter