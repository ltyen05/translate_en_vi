escripGrp><descrip type="definition">The overall telephony workload for Microsoft Teams, including the core cloud-based call control system that is used to replace traditional PBXs, and enables key calling capabilities.</descrip></descripGrp><ntig><termGrp><term id="2947840">Teams Phone</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2949352">Teams ಫೋನ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52043_2930012_2930418"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that appears in the Excel home tab, powered by AI, that helps people analyze their data by providing summaries, visual and significant trends and insights, and allows Natural Language Queries about the data.</descrip></descripGrp><ntig><termGrp><term id="2930012">Analyze Data</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2930418">ಡೇಟಾ ವಿಶ್ಲೇಷಿಸಿ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52044_2930013_2930419"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The service of expert assistance that helps very small businesses get the most out of their Microsoft 365 subscription, including migration help, end-user support, and personalized advice from small business specialists.</descrip></descripGrp><ntig><termGrp><term id="2930013">Business Assist for Microsoft 365</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2930419">Microsoft 365 ಗೆ ಬ್ಯುಸಿನೆಸ್ ಅಸಿಸ್ಟ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52046_2930015_2930427"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The category name for a group of features that enable collaboration with external users in Microsoft Teams.</descrip></descripGrp><ntig><termGrp><term id="2930015">Microsoft Teams Connect</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2930427">Microsoft Teams ಸಂಪರ್ಕ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52046_2930015_3060472"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The category name for a group of features that enable collaboration with external users in Microsoft Teams.</descrip></descripGrp><ntig><termGrp><term id="2930015">Microsoft Teams Connect</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="3060472">Teams ಸಂಪರ್ಕ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52046_3059193_2930427"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The category name for a group of features that enable collaboration with external users in Microsoft Teams.</descrip></descripGrp><ntig><termGrp><term id="3059193">Teams Connect</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2930427">Microsoft Teams ಸಂಪರ್ಕ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52046_3059193_3060472"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The category name for a group of features that enable collaboration with external users in Microsoft Teams.</descrip></descripGrp><ntig><termGrp><term id="3059193">Teams Connect</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="3060472">Teams ಸಂಪರ್ಕ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52048_2930017_2930430"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The version of Office perpetual for Consumer and SMB that includes the traditional suite of classic apps such as Word, Excel, PowerPoint, and other apps, sold as a one-time purchase without any major feature updates.</descrip></descripGrp><ntig><termGrp><term id="2930017">Office 2021</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2930430">Office 2021</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52049_2930018_2930432"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The service that allows customers to configure operator dial-in phone numbers on a Microsoft Audio Conferencing bridge and provides customers the ability to maintain their existing operator contracts and relationships as they migrate to the cloud, diversify their PSTN infrastructure to include multiple operators, expand dial-in coverage and enterprise-grade reliability and support.</descrip></descripGrp><ntig><termGrp><term id="2930018">Operator Connect Conferencing</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2930432">Operator Connect ಕಾನ್ಫರೆನ್ಸಿಂಗ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52050_2930019_2930423"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The version of the Exchange Server software that a customer can run on-premises, for which Microsoft provides ongoing support and updates for as long as the subscription is current/valid.</descrip></descripGrp><ntig><termGrp><term id="2930019">Microsoft Exchange Server Subscription Edition</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2930423">Microsoft Exchange Server ಚಂದಾದಾರಿಕೆ ಎಡಿಶನ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52051_2930020_2930422"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Teams, the feature that moves all video feeds to the top of the meeting window, allowing more natural eye contact with meeting attendees.</descrip></descripGrp><ntig><termGrp><term id="2930020">Gallery at top</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2930422">ಮೇಲ್ಭಾಗದಲ್ಲಿ ಗ್ಯಾಲರಿ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52052_2930022_2930439"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The option in Presenter Mode in which the content is shown as a visual aid above the presenter's shoulder, like a television reporter.</descrip></descripGrp><ntig><termGrp><term id="2930022">Reporter</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2930439">ರಿಪೋರ್ಟರ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52054_2930025_2930424"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The service that enables IT managed secure control and customization by allowing customers to bring consistent organizational experiences and have enhanced control and management across the organization.</descrip></descripGrp><ntig><termGrp><term id="2930025">Microsoft Teams Advanced Management</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2930424">Microsoft Teams ಸುಧಾರಿತ ನಿರ್ವಹಣೆ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52055_2930026_2930433"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The PowerPoint experience with features exclusive to Microsoft Teams, in which users can see their notes, upcoming slides, audience member videos and chat, and more.</descrip></descripGrp><ntig><termGrp><term id="2930026">PowerPoint Live</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2930433">PowerPoint ಲೈವ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52057_2930028_2930421"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The capability that makes it easy to plan and schedule quality, feature, and driver updates through powerful, cloud-based controls and leverages cloud capabilities to protect commercial customers from update-related issues through automatic pilot rings, ML-based issue detection, and tenant monitoring.</descrip></descripGrp><ntig><termGrp><term id="2930028">deployment service</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2930421">ನಿಯೋಜನೆ ಸೇವೆ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5206_421002_1956748"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To associate data with a specified location in memory.</descrip></descripGrp><ntig><termGrp><term id="421002">map</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1956748">ಮ್ಯಾಪ್ ಮಾಡಿ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52067_2931691_2931751"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The capability of Windows to adapt the way your colors render based on the type of content you consume and/or the environment you are in (dark vs bright, or an environment of a specific color - e.g. a coffee shop with green walls or a theatre with a predominance of red).</descrip></descripGrp><ntig><termGrp><term id="2931691">adaptive color</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2931751">ಅಳವಡಿಸಬಹುದಾದ ಬಣ್ಣ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52069_2932124_2934718"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The 2021 version of Microsoft Office Project Standard that utilizes the LTSC servicing model.</descrip></descripGrp><ntig><termGrp><term id="2932124">Microsoft Office LTSC Project Standard</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2934718">Microsoft Office LTSC Project ಸ್ಟ್ಯಾಂಡರ್ಡ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52069_2932124_2934722"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The 2021 version of Microsoft Office Project Standard that utilizes the LTSC servicing model.</descrip></descripGrp><ntig><termGrp><term id="2932124">Microsoft Office LTSC Project Standard</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2934722">Microsoft Office LTSC Project ಸ್ಟ್ಯಾಂಡರ್ಡ್ 2021</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52069_2932124_2934756"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The 2021 version of Microsoft Office Project Standard that utilizes the LTSC servicing model.</descrip></descripGrp><ntig><termGrp><term id="2932124">Microsoft Office LTSC Project Standard</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="gramma