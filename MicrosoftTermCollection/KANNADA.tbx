"892_2455_473172"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A binary number that uniquely identifies a host (computer) connected to the Internet to other Internet hosts, for the purposes of communication through the transfer of packets.</descrip></descripGrp><ntig><termGrp><term id="2455">IP address</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="473172">IP ವಿಳಾಸ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="892_725809_473172"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A binary number that uniquely identifies a host (computer) connected to the Internet to other Internet hosts, for the purposes of communication through the transfer of packets.</descrip></descripGrp><ntig><termGrp><term id="725809">Internet Protocol address</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="473172">IP ವಿಳಾಸ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8922_34048_473409"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A startup process that begins with turning on the computer's power. Typically, a cold boot involves some basic hardware checking by the system, after which the operating system is loaded from disk into memory.</descrip></descripGrp><ntig><termGrp><term id="34048">cold boot</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="473409">ಕೋಲ್ಡ್ ಬೂಟ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8922_34048_473410"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A startup process that begins with turning on the computer's power. Typically, a cold boot involves some basic hardware checking by the system, after which the operating system is loaded from disk into memory.</descrip></descripGrp><ntig><termGrp><term id="34048">cold boot</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="473410">ಕೋಲ್ಡ್ ಪ್ರಾರಂಭಿಕ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8922_34049_473409"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A startup process that begins with turning on the computer's power. Typically, a cold boot involves some basic hardware checking by the system, after which the operating system is loaded from disk into memory.</descrip></descripGrp><ntig><termGrp><term id="34049">cold start</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="473409">ಕೋಲ್ಡ್ ಬೂಟ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8922_34049_473410"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A startup process that begins with turning on the computer's power. Typically, a cold boot involves some basic hardware checking by the system, after which the operating system is loaded from disk into memory.</descrip></descripGrp><ntig><termGrp><term id="34049">cold start</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="473410">ಕೋಲ್ಡ್ ಪ್ರಾರಂಭಿಕ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8924_112244_473934"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The command interpreter that is used to pass commands to the operating system.</descrip></descripGrp><ntig><termGrp><term id="112244">shell</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="473934">ಶೆಲ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8929_81571_473770"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A device on which images generated by the computer's video adapter are displayed.</descrip></descripGrp><ntig><termGrp><term id="81571">monitor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="473770">ಮಾನಿಟರ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8931_84940_1989382"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of one or more COM objects in a process. A COM object lives in exactly one apartment, in the sense that its methods can legally be directly called only by a thread that belongs to that apartment. Any other thread that wants to call the object must go through a proxy.</descrip></descripGrp><ntig><termGrp><term id="84940">apartment</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1989382">ಅಪಾರ್ಟ್‌ಮೆಂಟ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8937_61873_2198352"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A list of the user's actions within a program, such as commands entered in an operating system shell, menus passed through using Gopher, or links followed using a Web browser.</descrip></descripGrp><ntig><termGrp><term id="61873">history</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2198352">ಇತಿಹಾಸ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8945_117177_473971"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An index entry that falls under a more general heading. For example, the index entry "planets" could have the subentries "Mars" and "Venus."</descrip></descripGrp><ntig><termGrp><term id="117177">subentry</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="473971">ಉಪನಮೂದು</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8949_140209_474126"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Related data points that are plotted in a chart. Each data series in a chart has a unique color or pattern and is represented in the chart legend. You can plot one or more data series in a chart. Pie charts have only one data series.</descrip></descripGrp><ntig><termGrp><term id="140209">data series</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="474126">ಡೇಟಾ ಸರಣಿ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8949_1508235_474126"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Related data points that are plotted in a chart. Each data series in a chart has a unique color or pattern and is represented in the chart legend. You can plot one or more data series in a chart. Pie charts have only one data series.</descrip></descripGrp><ntig><termGrp><term id="1508235">series</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="474126">ಡೇಟಾ ಸರಣಿ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8960_545680_1903207"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A view of a document as it will appear on the printed page.</descrip></descripGrp><ntig><termGrp><term id="545680">page layout view</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1903207">ಪುಟ ಲೇಔಟ್ ವೀಕ್ಷಣೆ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8960_545691_1903207"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A view of a document as it will appear on the printed page.</descrip></descripGrp><ntig><termGrp><term id="545691">print layout view</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1903207">ಪುಟ ಲೇಔಟ್ ವೀಕ್ಷಣೆ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8961_318125_474887"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Colors that are directly next to each other on the color wheel. Each color has two analogous colors (one on each side of it).</descrip></descripGrp><ntig><termGrp><term id="318125">analogous colors</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="474887">ಸಾದೃಶ ಬಣ್ಣ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8983_61675_1902955"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A fixed-disk file system that organizes the disk into volumes, rather than partitions and logical drives. HPFS supports long, mixed-case filenames and extended attributes, and implements several levels of caching, for improved operating-system performance. The IBM OS/2 operating system supports HPFS.</descrip></descripGrp><ntig><termGrp><term id="61675">high performance file system</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1902955">HPFS</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8983_61676_1902955"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A fixed-disk file system that organizes the disk into volumes, rather than partitions and logical drives. HPFS supports long, mixed-case filenames and extended attributes, and implements several levels of caching, for improved operating-system performance. The IBM OS/2 operating system supports HPFS.</descrip></descripGrp><ntig><termGrp><term id="61676">high-performance file system</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1902955">HPFS</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8983_61677_1902955"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A fixed-disk file system that organizes the disk into volumes, rather than partitions and logical drives. HPFS supports long, mixed-case filenames and extended attributes, and implements several levels of caching, for improved operating-system performance. The IBM OS/2 operating system supports HPFS.</descrip></descripGrp><ntig><termGrp><term id="61677">HPFS</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1902955">HPFS</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9001_1058104_1956643"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A disk directory in which an SMTP service can deposit incoming mail messages.</descrip></descripGrp><ntig><termGrp><term id="1058104">e-mail drop folder</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1956643">ಡ್ರಾಪ್ ಡೈರೆಕ್ಟರಿ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9001_1058111_1956643"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A disk directory in which an SMTP service can deposit incoming mail messages.</descrip></descripGrp><ntig><termGrp><term id="1058111">drop folder</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1956643">ಡ್ರಾಪ್ ಡೈರೆಕ್ಟರಿ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9001_396929_1956643"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A disk directory in which an SMTP service can deposit incoming mail messages.</descrip></descripGrp><ntig><termGrp><term id="396929">drop directory</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1956643">ಡ್ರಾಪ್ ಡೈರೆಕ್ಟರಿ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9010_347945_475103"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group in the data source that can occur more than once. Controls such as repeating sections and repeating tables are bound to repeating groups.</descrip></descripGrp><ntig><termGrp><term id="347945">repeating group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="475103">ಪುನರಾವರ್ತನ ಸಮೂಹ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9025_253693_1793036"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A data type that stores a signed, exact numeric value described as the number of digits appearing before and after the decimal point, with a maximum of 29 total digits. All possible digits cannot be represented if you are using the maximum number of digits.</descrip></descripGrp><ntig><termGrp><term id="253693">Decimal</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1793036">ದಶಮಾಂಶ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9026_44196_473490"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of rewriting parts of a file to contiguous sectors on a hard disk to increase the speed of access and retrieval.</descrip></descripGrp><ntig><termGrp><term id="44196">defragmentation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="473490">ಒಟ್ಟುಗೂಡಿಸುವಿಕೆ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9028_143088_1253202"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The blank area between two or more columns of text or between two facing pages in a publication.</descrip></descripGrp><ntig><termGrp><term id="143088">gutter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1253202">ಗಟರ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9030_146463_1903066"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In a 2-D chart, the area bounded by the axes, including all data series. In a 3-D chart, the area bounded by the axes, including the data series, category names, tick-mark labels, and axis titles.</descrip></descripGrp><ntig><termGrp><term id="146463">plot area</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1903066">ಪ್ಲಾಟ್ ಪ್ರದೇಶ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9035_13104_473263"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A small piece of code that can be transported over the Internet and executed on the recipient's machine. The term is especially used to refer to such programs as they are embedded in line as objects in HTML documents on the World Wide Web.</descrip></descripGrp><ntig><termGrp><term id="13104">applet</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="473263">ಆಪ್ಲೆಟ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9040_2624999_2632685"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app that allows users to visualize, navigate, and customize the view of files with an XPS document format.</descrip></descripGrp><ntig><termGrp><term id="2624999">Windows XPS Viewer</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2632685">Windows XPS ವೀಕ್ಷಕ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9040_386690_2632685"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app that allows users to visualize, navigate, and customize the view of files with an XPS document format.</descrip></descripGrp><ntig><termGrp><term id="386690">XML Paper Specification Viewer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2632685">Windows XPS ವೀಕ್ಷಕ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9040_386691_2632685"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app that allows users to visualize, navigate, and customize the view of files with an XPS document format.</descrip></descripGrp><ntig><termGrp><term id="386691">XPS Viewer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2632685">Windows XPS ವೀಕ್ಷಕ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9055_9529_1956519"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of recipient and other Active Directory objects. Each address list can contain one or more types of objects (for example, users, contacts, groups, public folders, conferencing, and other resources).</descrip></descripGrp><ntig><termGrp><term id="9529">address list</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1956519">ವಿಳಾಸ ಪಟ್ಟಿ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9064_232419_1903143"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The alternate calendar that is selected from within Outlook. The secondary calendar appears when dual calendar support is enabled.</descrip></descripGrp><ntig><termGrp><term id="232419">secondary calendar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1903143">ಸೆಕೆಂಡರಿ ಕ್ಯಾಲೆಂಡರ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9067_3665_473195"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A software package that replaces an existing version of a product or a feature with a newer and/or more powerful or sophisticated version of the same product or feature. The upgrade process typically leaves existing customer data and preferences intact while replacing the existing software with the newer version.</descrip></descripGrp><ntig><termGrp><term id="3665">upgrade</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="473195">ನವೀಕರಿಸು</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9067_3665_473196"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A software package that replaces an existing version of a product or a feature with a newer and/or more powerful or sophisticated version of the same product or feature. The upgrade process typically leaves existing customer data and preferences intact while replacing the existing software with the newer version.</descrip></descripGrp><ntig><termGrp><term id="3665">upgrade</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="473196">ಸಾಫ್ಟ್‌ವೇರ್ ನವೀಕರಿಸು</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9067_3666_473195"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A software package that replaces an existing version of a product or a feature with a newer and/or more powerful or sophisticated version of the same product or feature. The upgrade process typically leaves existing customer data and preferences intact while replacing the existing software with the newer version.</descrip></descripGrp><ntig><termGrp><term id="3666">software upgrade</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="473195">ನವೀಕರಿಸು</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9067_3666_473196"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A software package that replaces an existing version of a product or a feature with a newer and/or more powerful or sophisticated version of the same product or feature. The upgrade process typically leaves existing customer data and preferences intact while replacing the existing software with the newer version.</descrip></descripGrp><ntig><termGrp><term id="3666">software upgrade</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="473196">ಸಾಫ್ಟ್‌ವೇರ್ ನವೀಕರಿಸು</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9073_144243_1319412"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The condition of a field, record, recordset, or database that makes it read-only to all users except the user currently modifying it.</descrip></descripGrp><ntig><termGrp><term id="144243">locked</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1319412">ಲಾಕ್ ಮಾಡಲಾಗಿದೆ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9074_118405_1319413"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The rules governing the formation of a command-line statement, including the order in which a command must be typed, and the elements that follow the command.</descrip></descripGrp><ntig><termGrp><term id="118405">syntax</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1319413">ವಾಕ್ಯರಚನೆ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9078_144450_474162"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A query (SQL statement) that creates a new table and then creates records (rows) in it by copying records from an existing table.</descrip></descripGrp><ntig><termGrp><term id="144450">make-table query</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="474162">ಕೋಷ್ಟಕ-ರಚನೆ ಪ್ರಶ್ನಾವಳಿ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9078_360105_474162"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A query (SQL statement) that creates a new table and then creates records (rows) in it by copying records from an existing table.</descrip></descripGrp><ntig><termGrp><term id="360105">Make Table query</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="474162">ಕೋಷ್ಟಕ-ರಚನೆ ಪ್ರಶ್ನಾವಳಿ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9084_152809_474223"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Information such as audio, video, images, or text that is contained in a digital media file or stream.</descrip></descripGrp><ntig><termGrp><term id="152809">content</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="474223">ವಿಷಯ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9091_358353_1956572"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of components and services that enable users to access their Exchange mailboxes through the application Outlook Web Access and the protocols Exchange ActiveSync, Post Office Protocol version 3 (POP3), and Internet Message Access Protocol 4rev1 (IMAP4). The Client Access server role also includes Web services that are used by other Exchange 2007 server roles.</descrip></descripGrp><ntig><termGrp><term id="358353">Client Access server role</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1956572">ಕ್ಲೈಂಟ್ ಪ್ರವೇಶ ಸರ್ವರ್ ಪಾತ್ರ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="910_748601_1250886"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of email addresses that is treated as a single recipient for email distribution purposes, and that is created by and available to an individual Outlook user.</descrip></descripGrp><ntig><termGrp><term id="748601">contact group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1250886">ಸಂಪರ್ಕಸಮೂಹ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="910_748601_1308039"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of email addresses that is treated as a single recipient for email distribution purposes, and that is created by and available to an individual Outlook user.</descrip></descripGrp><ntig><termGrp><term id="748601">contact group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1308039">ಸಂಪರ್ಕ ಸಮೂಹ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9101_140120_474125"><langSet xml:lan