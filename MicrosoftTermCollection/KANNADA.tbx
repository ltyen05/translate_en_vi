FORE</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41829_2368196_2375217"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Excel function that returns text that occurs between two given substrings in a given string.</descrip></descripGrp><ntig><termGrp><term id="2368196">TEXTBETWEEN</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2375217">TEXTBETWEEN</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41830_2368197_2375214"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Excel function that looks for a value in one range and returns a reference to the cell in the corresponding position of another range.</descrip></descripGrp><ntig><termGrp><term id="2368197">CLOOKUP</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2375214">CLOOKUP</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41836_2368390_2612895"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The tool that aids in reading comprehension by displaying a reading-focused view with optimized font spacing, and by reading 