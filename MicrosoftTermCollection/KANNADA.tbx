anufactures, licenses, and supports a wide range of products and services predominantly related to computing.</descrip></descripGrp><ntig><termGrp><term id="2239897">MSFT</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1646529">Microsoft Corporation</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28354_1484614_1517366"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A disk directory entry that takes the place of a directory entry for a file but is actually a reference to a file in a different directory.</descrip></descripGrp><ntig><termGrp><term id="1484614">symbolic link</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1517366">ಸಾಂಕೇತಿಕ ಲಿಂಕ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28354_1484628_1517366"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A disk directory entry that takes the place of a directory entry for a file but is actually a reference to a file in a different directory.</descrip></descripGrp><ntig><termGrp><term id="1484628">symlink</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1517366">ಸಾಂಕೇತಿಕ ಲಿಂಕ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeec