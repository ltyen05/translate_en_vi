elected</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50572_2864259_2864306"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A daily personalized email sent by Cortana to Office 365 users containing tasks and commitments made by the user, a summary of the user's meetings, and relevant documents for the user's day, all using information extracted from the user's Office 365 messages.</descrip></descripGrp><ntig><termGrp><term id="2864259">Cortana Briefing email</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2864306">Cortana ವಿವರಣೆ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50572_2864259_2864307"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A daily personalized email sent by Cortana to Office 365 users containing tasks and commitments made by the user, a summary of the user's meetings, and relevant documents for the user's day, all using information extracted from the user's Office 365 messages.</descrip></descripGrp><ntig><termGrp><term id="2864259">Cortana Briefing email</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2864307">Cortana ವಿವರಣೆ ಇಮೇಲ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50578_2864897_2864961"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that protects sensitive information on disk and makes it inaccessible to attackers when the device is locked using encryption keys that are temporarily wiped from the device and only made available when the device is unlocked.</descrip></descripGrp><ntig><termGrp><term id="2864897">personal information encryption</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2864961">ವೈಯಕ್ತಿಕ ಮಾಹಿತಿ ಎನ್ಕ್ರಿಪ್ಷನ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50578_2864898_2864961"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that protects sensitive information on disk and makes it inaccessible to attackers when the device is locked using encryption keys that are temporarily wiped from the device and only made available when the device is unlocked.</descrip></descripGrp><ntig><termGrp><term id="2864898">Data Protection under Lock</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2864961">ವೈಯಕ್ತಿಕ ಮಾಹಿತಿ ಎನ್ಕ್ರಿಪ್ಷನ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50578_2864899_2864961"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that protects sensitive information on disk and makes it inaccessible to attackers when the device is locked using encryption keys that are temporarily wiped from the device and only made available when the device is unlocked.</descrip></descripGrp><ntig><termGrp><term id="2864899">DPL</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2864961">ವೈಯಕ್ತಿಕ ಮಾಹಿತಿ ಎನ್ಕ್ರಿಪ್ಷನ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50579_2864948_2864960"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The option in Microsoft Photos that allows the user to adjust the brightest part of a photo to be either darker or brighter.</descrip></descripGrp><ntig><termGrp><term id="2864948">Highlights</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2864960">ಮುಖ್ಯಾಂಶಗಳು</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50591_2865796_2865833"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A headless app in the Microsoft Store that contains OpenGL and OpenCL API mapping layers on top of DirectX 12 that enable OpenCL and OpenGL apps to run with GPU acceleration in environments where there is no IHV OpenCL or OpenGL driver (for example, on Windows 10 ARM-based PCs).</descrip></descripGrp><ntig><termGrp><term id="2865796">OpenCL™ and OpenGL® Compatibility Pack</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2865833">OpenCL™ ಮತ್ತು OpenGL® ಹೊಂದಾಣಿಕೆ ಪ್ಯಾಕ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5060_129154_474033"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In relational database management systems, a logical table created through the specification of one or more relational operations on one or more tables. A view is equivalent to a divided relation in the relational model.</descrip></descripGrp><ntig><termGrp><term id="129154">view</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="474033">ವೀಕ್ಷಣೆ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50607_2866400_2866430"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The search function in Microsoft Edge that lets users select text or images on web pages, then open the right-click context menu to search and view results in a sidebar to the right of the browser tab while keeping the current website visible.</descrip></descripGrp><ntig><termGrp><term id="2866400">sidebar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2866430">ಸೈಡ್ಬಾರ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5061_180517_2688558"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The adherence to stated standards.</descrip></descripGrp><ntig><termGrp><term id="180517">compliance</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2688558">ಅನುಸರಣೆ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50666_2867744_2867836"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The option in Microsoft Edge in which a customer can copy a URL and paste as a visual link, which provides a card with a key image and title, as well as additional information from the page where available.</descrip></descripGrp><ntig><termGrp><term id="2867744">web preview</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2867836">ವೆಬ್ ಮುನ್ನೋಟ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50672_2868545_2869697"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Two apps that are grouped together by the customer, so both apps open at the same time.​</descrip></descripGrp><ntig><termGrp><term id="2868545">app group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2869697">ಆಪ್ ಗ್ರೂಪ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50673_2868546_2869699"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To enlarge an app on a dual-screen device so that it goes across both screens.</descrip></descripGrp><ntig><termGrp><term id="2868546">maximize</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2869699">ಗರಿಷ್ಠಗೊಳಿಸಿ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50674_2868547_2869737"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To reorient a dual-screen device that is folded in order to see the other screen.</descrip></descripGrp><ntig><termGrp><term id="2868547">flip</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2869737">ತಿರುಗಿಸಿ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50675_2868548_2869738"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To move one screen of a dual-screen device backward.</descrip></descripGrp><ntig><termGrp><term id="2868548">fold</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2869738">ಮಡಚಿ</term><termNote type="geographicalUsage">IND</te