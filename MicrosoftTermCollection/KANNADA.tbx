nition">The movie or TV show label assigned to a movie or TV show that has not been rated by the Motion Picture Association of America (MPAA).</descrip></descripGrp><ntig><termGrp><term id="2360422">Unrated</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2362055">ರೇಟ್ ಮಾಡಿಲ್ಲದ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40700_2360425_2362044"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The view that shows the recent items you have played.</descrip></descripGrp><ntig><termGrp><term id="2360425">Recent plays</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2362044">ಇತ್ತೀಚಿನ ಪ್ಲೇಗಳು</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40701_2360426_2362046"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A pass that provides access to all current and future episodes of a TV show season, usually sold at a discount price.</descrip></descripGrp><ntig><termGrp><term id="2360426">season pass</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2362046">ಸೀಸನ್ ಪಾಸ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40703_2360428_2362057"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A library that contains your video files.</descrip></descripGrp><ntig><termGrp><term id="2360428">video library</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2362057">ವೀಡಿಯೋ ಲೈಬ್ರರಿ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40705_2360433_2362048"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The collection title for songs that are in the top N% of sales.</descrip></descripGrp><ntig><termGrp><term id="2360433">Top-selling songs</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2362048">ಪ್ರಮುಖ-ಮಾರಾಟವಾಗುವ ಹಾಡುಗಳು</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40706_2360434_2362039"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The category in Windows Store Movies &amp; TV section that shows the movies and TV shows purchased and rented by you as well as your videos in Movies &amp; TV app.</descrip></descripGrp><ntig><termGrp><term id="2360434">My movies &amp; TV</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termG