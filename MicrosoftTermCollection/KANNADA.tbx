ripGrp><ntig><termGrp><term id="1262328">consolidate</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2803236">ಒಟ್ಟುಗೂಡಿಸಿ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26073_1262378_1903449"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of features that incorporates elements of social networking into the Outlook experience. It provides relevant contextual information about the people whom users interact with in Outlook, based on local data (email and calendar items) and social activity (news feeds and status updates).</descrip></descripGrp><ntig><termGrp><term id="1262378">Outlook Social Connector</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1903449">Outlook Social Connector</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26073_1262378_1903453"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of features that incorporates elements of social networking into the Outlook experience. It provides relevant contextual information about the people whom users interact with in Outlook, based on local data (email and calendar items) and social activity (news feeds and status updates).</descrip></descripGrp><ntig><termGrp><term id="1262378">Outlook Social Connector</term><termNote type="partOfSpeech">ProperNoun</termNote>