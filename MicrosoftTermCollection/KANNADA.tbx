n often determines which of two or more actions is taken next.</descrip></descripGrp><ntig><termGrp><term id="36264">compare</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="473431">ಹೋಲಿಸು</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6302_1244829_1423536"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Web browser–based interface of Microsoft Office Project that project team members and stakeholders can use to access and update information stored in Microsoft Project Server, without having to install Microsoft Project on their computers.</descrip></descripGrp><ntig><termGrp><term id="1244829">Project Web App</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="1423536">Project Web App</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6302_2667271_1423536"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Web browser–based interface of Microsoft Office Project that project team members and stakeholders can use to access and update information stored in Microsoft Project Server, without having to install Microsoft Project on their computers.</descrip></descripGrp><ntig><termGrp><term id="2667271">PWA</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig