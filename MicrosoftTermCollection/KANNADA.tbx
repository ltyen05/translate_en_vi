 id="2114005">Security tab</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2177781">ಭದ್ರತೆ ಟ್ಯಾಬ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37267_2114067_2177436"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The section of the Store that contains a selection of products presented to the customer in a group. The products may be purchased individually.</descrip></descripGrp><ntig><termGrp><term id="2114067">Collections</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2177436">ಸಂಗ್ರಹಗಳು</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37268_2114068_2159319"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The section of the Store that includes the top apps, games, movies, and TV charts (Free, Paid, New and rising, Grossing, and Best rated).</descrip></descripGrp><ntig><termGrp><term id="2114068">Top charts</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2159319">ಪ್ರಮುಖ ಚಾರ್ಟ್‌ಗಳು</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37269_2114069_2177428"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The section of the Store that shows subgroups of apps and games, grouped by intended use or function.</descrip></descripGrp><ntig><termGrp><term id="2114069">Categories</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2177428">ವರ್ಗಗಳು</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37270_2114070_2177351"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The section of the Store where account holders can manage their account.</descrip></descripGrp><ntig><termGrp><term id="2114070">Account</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2177351">ಖಾತೆ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37271_2114071_2177735"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The section of the Store showing the group of apps that the user owns.</descrip></descripGrp><ntig><termGrp><term id="2114071">My apps</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2177735">ನನ್ನ ಅಪ್ಲಿಗಳು</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37272_2114072_2177732"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The section of the Store where the user can set and update the Store account settings.</descrip></descripGrp><ntig><termGrp><term id="2114072">My account</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2177732">ನನ್ನ ಖಾತೆ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37274_2114074_2177763"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An assessment of a Store item on a scale that corresponds to the user's opinion of the content.</descrip></descripGrp><ntig><termGrp><term id="2114074">rating</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="2177763">ರೇಟಿಂಗ್</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37275_2114075_2177779"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A critical evaluation of an item by the customers.</descrip></descripGrp><ntig><termGrp><term id="2114075">review</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="kn"><ntig><termGrp><term id="21