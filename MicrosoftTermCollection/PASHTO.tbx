="ps-AF"><ntig><termGrp><term id="456640">نالګول</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10265_234076_457082"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The button that brings up an international list that allows users to block emails from those domains.</descrip></descripGrp><ntig><termGrp><term id="234076">Blocked Top-Level Domain List</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="457082">د بند لوړ پوړي شپول لړ</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10268_169412_456901"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To do over again.</descrip></descripGrp><ntig><termGrp><term id="169412">redo</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="456901">بياکړ</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10273_297181_457362"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A peer-to-peer file sharing client used to connect to file sharing networks in order to download or share files.</descrip></descripGrp><ntig><termGrp><term id="297181">file sharing program</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="457362">دوتنه ونډونې پروګرام</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10276_232855_457071"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An option that displays the Web page in a Web browser.</descrip></descripGrp><ntig><termGrp><term id="232855">Web Page Preview</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="457071">ګورتپاڼې مخلید</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10278_142089_456773"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A technique in which you filter records in a form, datasheet, or data access page to retrieve only those records that don't contain the selected value.</descrip></descripGrp><ntig><termGrp><term id="142089">Filter Excluding Selection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="456773">له ټاکنې پرته چاڼ</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10286_160186_456880"><langSet xml:la