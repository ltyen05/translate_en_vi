/termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="455978">ړنګونه</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3638_53737_456204"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An area in a window or record that stores a single data value.</descrip></descripGrp><ntig><termGrp><term id="53737">field</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="456204">ډګر</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3643_323598_457635"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tool in Windows Vista that backs up the entire computer (OS, settings, and files).</descrip></descripGrp><ntig><termGrp><term id="323598">Complete PC Backup</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="457635">د کمپیوټر بشپړ شاتړ</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3644_116003_456582"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A statistical measure of the amount by which a set of values differs from the arithmetical mean, equal to the square root of the mean of the differences' squares.</descrip></descripGrp><ntig><termGrp><term id="116003">standard deviation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="456582">کره انحراف</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3655_85228_456418"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A hyphen that is used to prevent a hyphenated word, number, or phrase from breaking if it falls at the end of a line.</descrip></descripGrp><ntig><termGrp><term id="85228">nonbreaking hyphen</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="456418">نه ماتېدونی نښلوونی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3659_319140_457575"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ( character.</descrip></descripGrp><ntig><termGrp><term id="319140">opening parenthesis</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="457575">پرانیستل کېدونې لیندۍ</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3662_77222_456361"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that makes the screen more readable by people who have low vision by creating a separate window that displays a magnified portion of the screen.</descrip></descripGrp><ntig><termGrp><term id="77222">Magnifier</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="456361">زيږاند</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3690_18204_455911"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Excel feature that automatically creates a sum formula based on user selection.</descrip></descripGrp><ntig><termGrp><term id="18204">AutoSum</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="455911">خپلټول</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3692_318113_457503"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The key on the keyboard that is labeled with a right arrow.</descrip></descripGrp><ntig><termGrp><term id="318113">right arrow</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="457503">ښی غشی</term><termNote type="geographicalUsage">AFG</termNote><termN