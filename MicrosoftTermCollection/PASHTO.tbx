37675_456722"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature which automatically and periodically removes items to another folder, or deletes them, based on the amount of time they have been in the folder.</descrip></descripGrp><ntig><termGrp><term id="137675">AutoArchive</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="456722">خپلساتنځى</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6689_232848_457067"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A portion of a document in which you set certain page formatting options. You create a new section when you want to change such properties as line numbering, number of columns, or headers and footers.</descrip></descripGrp><ntig><termGrp><term id="232848">section</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="457067">برخه</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6708_29444_456003"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To align objects or text around a point located in the middle of a line, page, or other defined area; in effect, to position items an equal distance from each margin or border.</descrip></descripGrp><ntig><termGrp><term id="29444">center</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="456003">منځول</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6718_78054_456370"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A nonprinting mark you insert to end the current line and continue the text on the next line.</descrip></descripGrp><ntig><termGrp><term id="78054">manual line break</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="456370">لاسي ليکه ماتى</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6719_155847_456859"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Microsoft Web site maintained by the Windows product group for the purpose of providing updates for core Windows components.</descrip></descripGrp><ntig><termGrp><term id="155847">Windows Update</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="456859">Windows اوسمهالیز</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6719_155847_456860"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Microsoft Web site maintained by the Windows p