rmNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="456362">ليک ترلاسونى</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10041_321905_456181"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method of exchanging messages and computer files over a network that does not require the sender and recipient to be online at the same time.</descrip></descripGrp><ntig><termGrp><term id="321905">mail</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="456181">برېښليک</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10041_321905_457621"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method of exchanging messages and computer files over a network that does not require the sender and recipient to be online at the same time.</descrip></descripGrp><ntig><termGrp><term id="321905">mail</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="457621">ليک</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10041_50197_456181"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method of exchanging messages and computer files over a network that does not require the sender and recipient to be online at the same time.</descrip></descripGrp><ntig><termGrp><term id="50197">electronic mail</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="456181">برېښليک</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10041_50197_457621"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method of exchanging messages and computer files over a network that does not require the sender and recipient to be online at the same time.</descrip></descripGrp><ntig><termGrp><term id="50197">electronic mail</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="457621">ليک</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10041_725782_456181"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method of exchanging messages and computer files over a network that does not require the sender and recipient to be online at the same time.</descrip></descripGrp><ntig><termGrp><term id="725782">email</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="456181">برېښليک</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10041_725782_457621"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method of exchanging messages and computer files over a network that does not require the sender and recipient to be online at the same time.</descrip></descripGrp><ntig><termGrp><term id="725782">email</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="457621">ليک</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10052_58226_456231"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A quick movement of a finger or pen on a screen that the computer interprets as a command, rather than as a mouse movement, writing, or drawing.</descrip></descripGrp><ntig><termGrp><term id="58226">gesture</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="456231">اشاره</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1006_318140_457515"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">One of four fields of an SCODE. It is a unique number that is assigned to represent the error or warning.</descrip></descripGrp><ntig><termGrp><term id="318140">error code</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="457515">تېروت کوډ</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10069_338533_457669"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In printing, the process of eliminating white lines between colors by printing small areas of overlapping color where colors touch.</descrip></descripGrp><ntig><termGrp><term id="338533">trapping</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="457669">لومه اېښودل</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10077_33192_456029"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ) character.</descrip></descripGrp><ntig><termGrp><term id="33192">closing parenthesis</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="456029">بندېدونې غبرګلیندۍ</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10094_157455_456869"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An interactive tool that makes it easier to set up commonly used accessibility features by specifying options by type of disability, rather than by numeric value changes.</descrip></descripGrp><ntig><termGrp><term id="157455">Accessibility Wizard</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="456869">رسوړتیا اسانګر</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10113_308303_457415"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To publish or write entries for a blog.</descrip></descripGrp><ntig><termGrp><term id="308303">blog</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="457415">ویب لاګ</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10114_115262_456575"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ability to interpret vocal commands or convert spoken words into computer-readable text. Speech recognition programs enable you to control an application or enter text by speaking into a microphone, rather than by using a keyboard.</descrip></descripGrp><ntig><termGrp><term id="115262">speech recognition</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="456575">وينا پېژندول</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10114_115262_456576"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ability to interpret vocal commands or convert spoken words into computer-readable text. Speech recognition programs enable you to control an application or enter text by speaking into a microphone, rather than by using a keyboard.</descrip></descripGrp><ntig><termGrp><term id="115262">speech recognition</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="456576">وینا پېژندونه</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10114_115263_456575"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ability to interpret vocal commands or convert spoken words into computer-readable text. Speech recognition programs enable you to control an application or enter text by speaking into a microphone, rather than by using a keyboard.</descrip></descripGrp><ntig><termGrp><term id="115263">voice recognition</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="456575">وينا پېژندول</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10114_115263_456576"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ability to interpret vocal commands or convert spoken words into computer-readable text. Speech recognition programs enable you to control an application or enter text by speaking into a microphone, rather than by using a keyboard.</descrip></descripGrp><ntig><termGrp><term id="115263">voice recognition</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="456576">وینا پېژندونه</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10128_100700_456520"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To update displayed information with current data.</descrip></descripGrp><ntig><termGrp><term id="100700">refresh</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="456520">تاندول</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1014_522495_456438"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A software system that enables applications to interact with hardware and that manages software resources on a computer.</descrip></descripGrp><ntig><termGrp><term id="522495">OS</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="456438">چليز غونډال</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote