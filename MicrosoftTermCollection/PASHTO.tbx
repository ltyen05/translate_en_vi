ion">A folder that stores messages that have been created but not yet sent.</descrip></descripGrp><ntig><termGrp><term id="88948">outbox</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="456449">وتون بکس</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1307_319132_457571"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to text that is aligned along the right margin.</descrip></descripGrp><ntig><termGrp><term id="319132">right-aligned</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="457571">ښی پرلیکون</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13076_1486351_457296"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A sequence of words or other text used to gain access to a network, program, or data. A passphrase is generally longer for added security.</descrip></descripGrp><ntig><termGrp><term id="1486351">pass phrase</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="457296">تېرنڅرګندۍ</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13076_269325_457296"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A sequence of words or other text used to gain access to a network, program, or data. A passphrase is generally longer for added security.</descrip></descripGrp><ntig><termGrp><term id="269325">passphrase</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="457296">تېرنڅرګندۍ</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1308_232849_457068"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A nonprinting mark you insert to show the end of a section.</descrip></descripGrp><ntig><termGrp><term id="232849">section break</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="457068">برخه ماتى</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13089_102926_456525"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process of copying content and/or configuration settings from one location, generally a server node, to another to ensure synchronization or fault tolerance.</descrip></descripGrp><ntig><termGrp><term id="102926">replication</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="456525">انګروزه</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13142_111591_456553"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A configuration parameter that controls the behavior of a service, application, feature, function, or a run-time environment.</descrip></descripGrp><ntig><termGrp><term id="111591">setting</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="456553">امستن</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13147_91099_456461"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A route through a structured collection of information, as in a database, a program, or files stored on disk.</descrip></descripGrp><ntig><termGrp><term id="91099">path</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="456461">يونلور</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13151_318116_457506"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To align text along the right margin.</descrip></descripGrp><ntig><termGrp><term id="318116">right align</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="457506">ښی پرلیکون</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13166_262640_457234"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A title animation in Windows Movie Maker.</descrip></descripGrp><ntig><termGrp><term id="262640">Stretch</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="457234">غځون</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13173_89953_456451"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The point at which one page ends and another begins.</descrip></descripGrp><ntig><termGrp><term id="89953">page break</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="456451">مخ ماتى</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13177_6456_455837"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The full Internet address of a page or other World Wide Web resource. The absolute URL includes a protocol, such as "http," network location, and optional path and file name — for example, http://example.microsoft.com/.</descrip></descripGrp><ntig><termGrp><term id="6456">absolute URL</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="455837">نږه URL</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13180_268854_457292"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method computers use to send and receive email messages. It allows you to access email without downloading it to your computer or device.</descrip></descripGrp><ntig><termGrp><term id="268854">Internet Message Access Protocol</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="457292">انټرنېټ استوزې رسي باندره</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13180_268854_457293"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method computers use to send and receive email messages. It allows you to access email without downloading it to your computer or device.</descrip></descripGrp><ntig><termGrp><term id="268854">Internet Message Access Protocol</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="457293">IMAP</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13180_268863_457292"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method computers use to send and receive email messages. It allows you to access email without downloading it to your computer or device.</descrip></descripGrp><ntig><termGrp><term id="268863">IMAP</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="457292">انټرنېټ استوزې رسي باندره</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13180_268863_457293"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method computers use to send and receive email messages. It allows you to access email without downloading it to your computer or device.</descrip></descripGrp><ntig><termGrp><term id="268863">IMAP</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="457293">IMAP</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13196_318732_457553"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A menu choice or remote button that offers access to the user's video library.</descrip></descripGrp><ntig><termGrp><term id="318732">My Videos</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="457553">زما فلمونه</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13210_262699_457247"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A small, Internet Protocol (IP)-based network. It is usually used for short-range, ad-hoc communication between devices and computers. A PAN may also be used to enable connectivity to a larger Local Area Network (LAN), Wide-Area Network (WAN), or the Internet. Windows XP supports the Bluetooth PAN service so you can create Personal Area Networks using Bluetooth.</descrip></descripGrp><ntig><termGrp><term id="262699">Personal Area Network</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="457247">ځاني سېمې جال</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13210_262699_457248"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A small, Internet Protocol (IP)-based network. It is usually used for short-range, ad-hoc communication between devices and computers. A PAN may also be used to enable connectivity to a larger Local Area Network (LAN), Wide-Area Network (WAN), or the Internet. Windows XP supports the Bluetooth PAN service so you can create Personal Area Networks using Bluetooth.</descrip></descripGrp><ntig><termGrp><term id="262699">Personal Area Network</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammatica