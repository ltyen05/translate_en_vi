gSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="456657">ليد</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10396_158410_456875"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to, being, or characteristic of something that is not dependent on timing. Each application or command runs in the specified order, but the specified item does not wait for any previously started processes to finish before an application or command runs.</descrip></descripGrp><ntig><termGrp><term id="158410">asynchronous</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="456875">نا هممهالی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10396_2479304_456875"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to, being, or characteristic of something that is not dependent on timing. Each application or command runs in the specified order, but the specified item does not wait for any previously started processes to finish before an application or command runs.</descrip></descripGrp><ntig><termGrp><term id="2479304">async</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="456875">نا هممهالی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGend