ly at the top of the Z order and is distinguished by the color of its title bar.</descrip></descripGrp><ntig><termGrp><term id="8743">active window</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="455858">چارنده کړکۍ</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1469_307402_457408"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The tool which enables users to automatically perform routine tasks on a chosen computer by monitoring whatever criteria the users choose to initiate the tasks (referred to as triggers) and then executing the tasks when the criteria is met.</descrip></descripGrp><ntig><termGrp><term id="307402">Task Scheduler</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="457408">دنده مهالوېشونکی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14700_1176605_456481"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A unit of measure referring to the height of a printed character. A point equals 1/72 of an inch, or approximately 1/28 of a centimeter.</descrip></descripGrp><ntig><termGrp><term id="1176605">pt</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="456481">ټکى</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14700_93093_456481"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A unit of measure referring to the height of a printed character. A point equals 1/72 of an inch, or approximately 1/28 of a centimeter.</descrip></descripGrp><ntig><termGrp><term id="93093">point</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="456481">ټکى</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14713_375730_456410"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An indent where the text is displaced into the left margin if text direction is set to left-to-right, or toward the right margin if text direction is set to right-to-left.</descrip></descripGrp><ntig><termGrp><term id="375730">outdent</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="456410">چلونې سرتشه</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14713_83924_456410"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An indent where the text is displaced into the left margin if text direction is set to left-to-right, or toward the right margin if text direction is set to right-to-left.</descrip></descripGrp><ntig><termGrp><term id="83924">negative indent</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="456410">چلونې سرتشه</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14719_232413_457052"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A window in an email program where you can preview an item without opening it.</descrip></descripGrp><ntig><termGrp><term id="232413">reading pane</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="457052">لوست چوکاټ</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14719_415470_457052"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A window in an email program where you can preview an item without opening it.</descrip></descripGrp><ntig><termGrp><term id="415470">Preview Pane</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="457052">لوست چوکاټ</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14721_427008_456325"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An orientation where the long dimension of a rectangular area (for example, screen, photo, or paper) is horizontal.</descrip></descripGrp><ntig><termGrp><term id="427008">landscape orientation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="456325">پسوريز</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14721_73296_456325"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An orientation where the long dimension of a rectangular area (for example, screen, photo, or paper) is horizontal.</descrip></descripGrp><ntig><termGrp><term id="73296">landscape</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="456325">پسوريز</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14726_110688_456551"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A number assigned to a specific inventory item to identify it and differentiate it from similar items with the same item number.</descrip></descripGrp><ntig><termGrp><term id="110688">serial number</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="456551">لړيزه شمېره</term><termNote type="geographicalUsage">AFG</termNot