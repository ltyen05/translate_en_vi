Set xml:lang="en-US"><descripGrp><descrip type="definition">A set of data that is organized and summarized into a multidimensional structure that is defined by a set of dimensions and measures.</descrip></descripGrp><ntig><termGrp><term id="219611">OLAP cube</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="457025">پرلیکه شنونکی بهیرونګ</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15452_41272_456093"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of data that is organized and summarized into a multidimensional structure that is defined by a set of dimensions and measures.</descrip></descripGrp><ntig><termGrp><term id="41272">cube</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="456093">شپږګوټ</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15452_41272_457025"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of data that is organized and summarized into a multidimensional structure that is defined by a set of dimensions and measures.</descrip></descripGrp><ntig><termGrp><term id="41272">cube</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="457025">پرلیکه شنونکی بهیرونګ</term><termNote type="geo