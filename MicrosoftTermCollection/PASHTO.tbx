inition">A statement that the text or program code contained within the item on which the notice appears is the intellectual property of Microsoft (or other entity).</descrip></descripGrp><ntig><termGrp><term id="318712">copyright notice</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="457546">چاپرښتو يادښت</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6917_145325_456791"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file that contains definitions of objects and their methods and properties.</descrip></descripGrp><ntig><termGrp><term id="145325">object library</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="456791">څيز کتابتون</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6925_319143_456480"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ± character.</descrip></descripGrp><ntig><termGrp><term id="319143">PLUS-MINUS SIGN</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="456480">جمعې یا منفي نښه</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected<