 to reveal all choices for a given field.</descrip></descripGrp><ntig><termGrp><term id="475180">picklist</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="457026">لر-غورځى لړ</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10894_721653_457026"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A list that can be opened to reveal all choices for a given field.</descrip></descripGrp><ntig><termGrp><term id="721653">dropdown list</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="457026">لر-غورځى لړ</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10899_234822_457115"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To make resources, such as folders, printers, records, etc., unavailable to others.</descrip></descripGrp><ntig><termGrp><term id="234822">unshare</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="457115">نا ونډول</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10903_334532_456425"><lang