ese routines usually carry out maintenance tasks such as managing files and displaying information.</descrip></descripGrp><ntig><termGrp><term id="49645">application programming interface</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="456176">کاریال پروګرامونې برسیر</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11241_1998713_456419"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A character used to control the format of displayed or printed information, rather than to represent a particular letter, digit, or other special character. The space ( ) is one of the more important nonprinting characters.</descrip></descripGrp><ntig><termGrp><term id="1998713">non-printable character</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="456419">ناچاپيزه لوښه</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11241_85464_456419"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A character used to control the format of displayed or printed information, rather than to represent a particular letter, digit, or other special character. The space ( ) is one of the more important nonprinting characters.</descrip></descripGrp><ntig><termGrp><term id="85464">nonprinting character</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNu