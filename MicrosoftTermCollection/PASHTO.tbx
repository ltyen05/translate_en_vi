ech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="456474">ساده متن</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3366_1177_455763"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process of converting readable data (plaintext) into a coded form (ciphertext) to prevent it from being read by an unauthorized party.</descrip></descripGrp><ntig><termGrp><term id="1177">encryption</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="455763">کوډه کښنه</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3366_1413164_455763"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process of converting readable data (plaintext) into a coded form (ciphertext) to prevent it from being read by an unauthorized party.</descrip></descripGrp><ntig><termGrp><term id="1413164">encipherment</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="455763">کوډه کښنه</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3366_694688_455763"><langSet xml:lang="en-US"><descripGrp><de