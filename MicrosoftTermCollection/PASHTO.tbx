ig></langSet></termEntry><termEntry id="15098_361653_457625"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Web site based on the Document Workspace template that workspace members use for discussing, editing, and working together on a document.</descrip></descripGrp><ntig><termGrp><term id="361653">Document Workspace site</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="457625">لاسوند کارتشه</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15098_361653_457780"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Web site based on the Document Workspace template that workspace members use for discussing, editing, and working together on a document.</descrip></descripGrp><ntig><termGrp><term id="361653">Document Workspace site</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="457780">لاسوند کارتشې ځای</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1510_264861_457272"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of individual strokes in the Unicode Standard used to compose Chinese/Japanese/Korean (CJK) ideographs.</descrip></descripGrp><ntig><termGrp><term id="264861">CJK Strokes</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet