oses. Bookmarks identify a location within your file that you can later refer or link to.</descrip></descripGrp><ntig><termGrp><term id="22733">bookmark</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="455946">ليکى-نښول</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4846_22733_457018"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A location or selection of text in a file that you name for reference purposes. Bookmarks identify a location within your file that you can later refer or link to.</descrip></descripGrp><ntig><termGrp><term id="22733">bookmark</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="457018">استل</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4859_295625_457348"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A letter that serves to introduce accompanying documents to the recipient. Often refers to a letter sent with a resume when applying for a job.</descrip></descripGrp><ntig><termGrp><term id="295625">cover letter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="457348">پوښ لیک</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNo