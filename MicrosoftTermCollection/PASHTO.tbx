les are placed on disk in plain-text form (without extraneous or program-specific characters) so that they can be read easily be a variety of word processing programs.</descrip></descripGrp><ntig><termGrp><term id="251778">README</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="457180">ماولوله</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11926_317517_456096"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of installation that allows the user to specify certain installation settings and options, such as which components will be installed.</descrip></descripGrp><ntig><termGrp><term id="317517">custom installation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="456096">دود لګاو</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11926_41721_456096"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of installation that allows the user to specify certain installation settings and options, such as which components will be installed.</descrip></descripGrp><ntig><termGrp><term id="41721">custom install</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="456096">دود لګاو</term><termNote type="geographicalUs