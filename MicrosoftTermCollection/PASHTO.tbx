 xml:lang="ps-AF"><ntig><termGrp><term id="456169">لر-غورځى تړنګ بکس</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4459_148656_456816"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The slide that stores information about the design template applied, including font styles, placeholder sizes and positions, background design, and color schemes.</descrip></descripGrp><ntig><termGrp><term id="148656">slide master</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="456816">سلالۍ آر</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4462_72367_456313"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The core of layered architecture that manages the most basic operations of the operating system and the computer's processor. The kernel schedules different blocks of executing code, called threads, for the processor to keep it as busy as possible and coordinates multiple processors to optimize performance. The kernel also synchronizes activities among Executive-level subcomponents, such as I/O Manager and Process Manager, and handles hardware exceptions and other hardware-dependent functions. The kernel works closely with the hardware abstraction layer.</descrip></descripGrp><ntig><termGrp><term id="72367">kernel</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp>