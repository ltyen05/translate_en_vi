Note type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="456363">ليکبکس</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3098_228472_457028"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A written order on a bank to pay a sum of money from funds in an account. Checks show the name of the company or individual receiving payment, the signature and account number of the person issuing the check, the payment amount and the current date. Checks usually are numbered in sequence.</descrip></descripGrp><ntig><termGrp><term id="228472">check</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="457028">کتل</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3099_72029_456310"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of aligning text along both the left and right margins.</descrip></descripGrp><ntig><termGrp><term id="72029">justification</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="456310">همجوليزتيا</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3109_148936_456820"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A datasheet that is nested within another datasheet and that contains data related or joined to the first datasheet.</descrip></descripGrp><ntig><termGrp><term id="148936">subdatasheet</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="456820">څېرمه اومتوک پاڼه</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3117_109079_456545"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Protection of a computer system and its data from harm or loss.</descrip></descripGrp><ntig><termGrp><term id="109079">security</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="456545">خونديتوب</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3117_747373_456545"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Protection of a computer system and its data from harm or loss.</descrip></descripGrp><ntig><termGrp><term id="747373">network security</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="456545">خونديتوب</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3131_12131_455880"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The &lt;&gt; characters.</descrip></descripGrp><ntig><termGrp><term id="12131">angle brackets</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="455880">ګوټليندۍ</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3151_2144328_456152"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A physical hardware unit that can connect portable computers to a power source and to peripherals, such as a monitor, printer, full-sized keyboard, or mouse. The connection can be wireless or physical.</descrip></descripGrp><ntig><termGrp><term id="2144328">dock</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="456152">لنګر اډه</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3151_47399_456152"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A physical hardware unit that can connect portable computers to a power source and to peripherals, such as a monitor, printer, full-sized keyboard, or mouse. The connection can be wireless or physical.</descrip></descripGrp><ntig><termGrp><term id="47399">docking station</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="456152">لنګر اډه</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3165_19460_455923"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The capability of source code or programs developed on a more advanced system or compiler version to be executed or compiled by a less advanced (older) version.</descrip></descripGrp><ntig><termGrp><term id="19460">backward compatibility</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="455923">شاته جوړایینه</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="317_141659_456768"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An XML vocabulary that is used to transform XML data to another form, such as HTML, by means of a style sheet that defines presentation rules.</descrip></descripGrp><ntig><termGrp><term id="141659">Extensible Stylesheet Language</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="456768">غځېدونکې ډول پاڼې ژبه</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="317_141659_456769"