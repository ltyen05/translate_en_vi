 feature or option.</descrip></descripGrp><ntig><termGrp><term id="334528">select</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="457658">ټاکل</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8250_211554_455830"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A device that is added to the base computer system to increase functionality, such as audio, networking, graphics, or SCSI controller.</descrip></descripGrp><ntig><termGrp><term id="211554">add-on device</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="455830">زياتي</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8250_211554_457004"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A device that is added to the base computer system to increase functionality, such as audio, networking, graphics, or SCSI controller.</descrip></descripGrp><ntig><termGrp><term id="211554">add-on device</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="457004">زياتي وزلې</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</t