">FAT</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="456202">دوتنې ځانګړونې لښتیال</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11314_53259_456201"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file system used by MS-DOS and Microsoft Windows operating systems to organize and manage files.</descrip></descripGrp><ntig><termGrp><term id="53259">file allocation table</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="456201">د دوتنه ځانګړنې لښتیال</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11314_53259_456202"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file system used by MS-DOS and Microsoft Windows operating systems to organize and manage files.</descrip></descripGrp><ntig><termGrp><term id="53259">file allocation table</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="456202">دوتنې ځانګړونې لښتیال</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11318_232416_457055"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A list that includes the email addresses of mailing lists for which you want to be a recipient. Messages sent to such a mailing list and received by you will not be treated as junk email.</descrip></descripGrp><ntig><termGrp><term id="232416">Safe Recipients List</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="457055">خوندي نیوونیو لړ</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11322_19990_455928"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A character that has meaning independent of other characters, or any graphical character that is not a diacritical mark.</descrip></descripGrp><ntig><termGrp><term id="19990">base character</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="455928">بنسټ لوښه</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11330_360145_457770"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A program you use to view, print, and electronically mail a snapshot, such as a report snapshot.</descrip></descripGrp><ntig><termGrp><term id="360145">Snapshot Viewer</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="457770">سملاسي ان