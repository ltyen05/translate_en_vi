ermGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="456836">د ډګر ژورتیا</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9734_42848_456105"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The manipulation of data to transform it into some desired result.</descrip></descripGrp><ntig><termGrp><term id="42848">data processing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="456105">اومتوک بهيرونه</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9767_319131_457570"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to text that is aligned along the left margin.</descrip></descripGrp><ntig><termGrp><term id="319131">left-aligned</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="457570">کیڼ پرلیکون</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9789_158215_456874"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The company placing, and often paying for, a promotional message, or advertisement.</descrip></descripGrp><ntig><termGrp><term id="158215">advertiser</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="456874">اعلانوونکی</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9800_30472_456010"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In text-based computer graphics, a block of memory addresses that correspond to character spaces on a display screen. The memory allocated to each character space is used to hold the description of the character to be displayed in that space.</descrip></descripGrp><ntig><termGrp><term id="30472">character map</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="456010">لوښه کيله</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9805_262641_457235"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A title animation in Windows Movie Maker.</descrip></descripGrp><ntig><termGrp><term id="262641">Subtitle</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="457235">څېرمه سرلیک</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9820_2727454_457370"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A directory or folder made available to users over the network.</descrip></descripGrp><ntig><termGrp><term id="2727454">file share</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="457370">ونډول</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9820_298002_457370"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A directory or folder made available to users over the network.</descrip></descripGrp><ntig><termGrp><term id="298002">share</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="457370">ونډول</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9831_235026_457125"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of confirming that data passing into the system is correct and complies with predefined rules, definitions, or parameters.</descrip></descripGrp><ntig><termGrp><term id="235026">validation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="457125">باورکړن</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9836_79134_456378"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Any fixed or removable objects that store computer data. Examples include hard disks, floppy disks, tapes, and compact discs.</descrip></descripGrp><ntig><termGrp><term id="79134">media</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="456378">رسنۍ</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9837_23010_455950"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The partition that contains the Windows operating system and its support files. The boot partition can be, but does not have to be, the same as the system partition.</descrip></descripGrp><ntig><termGrp><term id="23010">boot partition</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="455950">پیلون وېشنه</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9849_20127_455929"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In the printing and display of characters on the screen, an imaginary horizontal line with which the base of each character, excluding descenders, is aligned.</descrip></descripGrp><ntig><termGrp><term id="20127">base line</term><termNote type="partOfSpeech">Noun</termNote><termNote type="gramm