><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4801_235057_457129"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A wizard that guides the user through installing a printer on their network.</descrip></descripGrp><ntig><termGrp><term id="235057">Network Printer Installation Wizard</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="457129">جال چاپګر لګاو اسانګر</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4804_359991_457760"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The only member of the replica set in which you can make changes to the database structure that can be propagated to other replicas.</descrip></descripGrp><ntig><termGrp><term id="359991">Design Master</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ps-AF"><ntig><termGrp><term id="457760">سکښت استاد</term><termNote type="geographicalUsage">AFG</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4820_111957_456556"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A folder on another computer that has been made available for other people to use on the network.</descrip></descripGrp><ntig><termGrp><term id="1119