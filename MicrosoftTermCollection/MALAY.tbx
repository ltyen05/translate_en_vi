ah</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9678_178393_2214188"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SQL Server system data type that stores a time value from 0:00 through 23:59:59.999999.</descrip></descripGrp><ntig><termGrp><term id="178393">time</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2214188">masa</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9679_334563_445038"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To close software, such as a program or application.</descrip></descripGrp><ntig><termGrp><term id="334563">exit</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="445038">keluar</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9684_181916_2213223"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A system preparation tool that helps to avoid setup failures by validating the target machine before a software application is installed.</descrip></descripGrp><ntig><termGrp><term id="181916">System Configuration Checker</term><termNote type="partOfSpeech">Noun</termNo