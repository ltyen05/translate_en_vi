er">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15139_362562_1299070"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A data type consisting of a 32-bit unsigned integer.</descrip></descripGrp><ntig><termGrp><term id="362562">DWORD</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1299070">DWORD</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15139_48746_1299070"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A data type consisting of a 32-bit unsigned integer.</descrip></descripGrp><ntig><termGrp><term id="48746">dword</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1299070">DWORD</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1514_537134_1294502"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of submitting an entire Web site to a compiler. The resulting Web site output runs without needing to be compiled on first request and does not require source code to be deployed to a production server.</descrip></descripGrp><ntig><termGrp><term id="537134">precompilation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig