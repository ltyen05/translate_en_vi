ech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2177215">Penyelaras Transaksi Teragih</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="624_2037785_2177215"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A system service that enables client applications to include several different sources of data in one transaction. MSDTC coordinates the committing of the distributed transaction across all the servers enlisted in the transaction.</descrip></descripGrp><ntig><termGrp><term id="2037785">Distributed Transaction Coordinator</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2177215">Penyelaras Transaksi Teragih</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="624_213530_2177215"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A system service that enables client applications to include several different sources of data in one transaction. MSDTC coordinates the committing of the distributed transaction across all the servers enlisted in the transaction.</descrip></descripGrp><ntig><termGrp><term id="213530">MSDTC</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2177215">Penyelaras Transaksi Teragih</term><termNote type="geogr