65">KD</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1298155">penyahpepijat kernel</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13241_72266_1298155"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A debugging application that refines and debugs an operating system image. The kernel debugger works like an application debugger except that it is capable of debugging operating systems in addition to applications.</descrip></descripGrp><ntig><termGrp><term id="72266">kernel debugger</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1298155">penyahpepijat kernel</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13242_61847_2182768"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A chart consisting of horizontal or vertical bars, the widths or heights of which represent the values of numerical data.</descrip></descripGrp><ntig><termGrp><term id="61847">histogram</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2182768">histogram</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="gramma