rged, and which contains the data of both partitions after the merger.</descrip></descripGrp><ntig><termGrp><term id="535394">target partition</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2214167">petak sasaran</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6760_134076_2216696"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of determining other forms of the word(s) specified in a search.</descrip></descripGrp><ntig><termGrp><term id="134076">word generation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2216696">penjanaan kata</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6764_4961_1295433"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The practice of administering changes with the help of tested methods and techniques in order to avoid new errors and minimize the impact of changes.</descrip></descripGrp><ntig><termGrp><term id="4961">change management</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1295433">pengurusan perubahan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6765_145989_444183"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The nonprinting ¶ character that Microsoft Office Word inserts when you press ENTER to end a paragraph. The paragraph mark stores the formatting you apply to the paragraph.</descrip></descripGrp><ntig><termGrp><term id="145989">paragraph mark</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="444183">tanda perenggan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="677_181094_2188469"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A relationship between a dimension and a measure group in which a single fact may be associated with many dimension members and a single dimension member may be associated with a many facts. To define this relationship between the dimension and the fact table, the dimension is joined to an intermediate fact table and the intermediate fact table is joined, in turn, to an intermediate dimension table that is joined to the fact table.</descrip></descripGrp><ntig><termGrp><term id="181094">many-to-many dimension</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2188469">banyak kepada banyak</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6772_27512_444992"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In some languages, a distinct, and usually larger, form of a letter. May be used in word-initial position in certain cases, or for emphasis.</descrip></descripGrp><ntig><termGrp><term id="27512">capitalized letter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="444992">huruf besar</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6772_321897_444992"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In some languages, a distinct, and usually larger, form of a letter. May be used in word-initial position in certain cases, or for emphasis.</descrip></descripGrp><ntig><termGrp><term id="321897">capital letter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="444992">huruf besar</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6772_321898_444992"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In some languages, a distinct, and usually larger, form of a letter. May be used in word-initial position in certain cases, or for emphasis.</descrip></descripGrp><ntig><termGrp><term id="321898">uppercase letter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="444992">huruf besar</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6775_156879_2920418"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Customer support for business and development software that is beyond the Mainstream support period. Extended support includes all paid support options, as well as security-related hotfix support which is provided at no charge.</descrip></descripGrp><ntig><termGrp><term id="156879">extended support</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2920418">sokongan lanjutan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6777_475226_2121528"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An activity created using the Follow Up form in the Form Assistant.</descrip></descripGrp><ntig><termGrp><term id="475226">follow-up activity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2121528">aktiviti susulan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6783_143775_2780403"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An online directory that contains information such as websites and email addresses.</descrip></descripGrp><ntig><termGrp><term id="143775">Internet directory</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2780403">direktori Internet</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6792_557973_2186551"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The length of time for which a DHCP client can use a dynamically assigned IP address configuration. Before the lease time expires, the client must either renew or obtain a new lease with DHCP.</descrip></descripGrp><ntig><termGrp><term id="557973">lease</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2186551">pajakan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6792_557974_2186551"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The length of time for which a DHCP client can use a dynamically assigned IP address configuration. Before the lease time expires, the client must either renew or obtain a new lease with DHCP.</descrip></descripGrp><ntig><termGrp><term id="557974">lease time</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2186551">pajakan</term><termNote type="geographicalUsag