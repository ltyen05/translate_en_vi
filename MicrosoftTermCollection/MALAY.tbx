g><termGrp><term id="1677953">Tidak aktif</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13598_26923_443375"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A service that notifies a user that a call is coming in while the user is in a call.</descrip></descripGrp><ntig><termGrp><term id="26923">call waiting</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="443375">panggilan tunggu</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13599_181257_2194840"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A published report that accepts input values through parameters.</descrip></descripGrp><ntig><termGrp><term id="181257">parameterized report</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2194840">laporan berparameter</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="136_557698_2121404"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A system job that detects duplicate records for one entity.</descrip></descripGrp><ntig><termGrp><term id="557698">Bulk Duplicate Detection</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2121404">Pengesahan Duplikasi Pukal</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1360_358369_362172"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An encoding mechanism that converts binary data into printable ASCII characters so that the data can be included in the message body without violating SMTP conventions.</descrip></descripGrp><ntig><termGrp><term id="358369">UUENCODE</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="362172">UUENCODE</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13600_237376_1096384"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The act of exporting objects such as resources, templates, and galleries from a source system and importing them to a destination system. A common application is moving data from a development server to a production server.</descrip></descripGrp><ntig><termGrp><term id="237376">content deployment</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1096384">atur letak kandungan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13604_34469_443435"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The particular range of colors that a device or color model is able to produce.</descrip></descripGrp><ntig><termGrp><term id="34469">color gamut</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="443435">gamut warna</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13604_660552_443435"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The particular range of colors that a device or color model is able to produce.</descrip></descripGrp><ntig><termGrp><term id="660552">gamut</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="443435">gamut warna</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13605_347939_445101"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file or set of files that defines the data structure, appearance, and behavior of a form.</descrip></descripGrp><ntig><termGrp><term id="347939">form template</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="445101">templat borang</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1361_104351_2205285"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A multi-phase process that copies all the data and log pages from a specified backup to a specified database (the data-copy phase) and rolls forward all the transactions that are logged in the backup (the redo phase). At this point, by default, a restore rolls back any incomplete transactions (the undo phase), which completes the recovery of the database and makes it available to users.</descrip></descripGrp><ntig><termGrp><term id="104351">restore</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2205285">pemulihan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13611_187814_1298174"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To restructure code to make it easier to understand and to maintain, while preserving its functionality.</descrip></descripGrp><ntig><termGrp><term id="187814">refactor</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1298174">faktor semula</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13614_97245_1708881"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Electromagnetic waves longer than about 0.3 mm (frequencies lower than about 1 THz). Radio is used to transmit a wide variety of signals, using various frequency ranges and types of modulation, such as AM and FM broadcasts, microwave relays, and television broadcasts.</descrip></descripGrp><ntig><termGrp><term id="97245">radio</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1708881">radio</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13617_182098_2177172"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A data flow component that loads data into a data store.</descrip></descripGrp><ntig><termGrp><term id="182098">destination adapter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2177172">penyesuai destinasi</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1362_360135_1940947"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A view that summarizes and analyzes data in a datasheet or form. You can use different levels of detail or organize data by dragging the fields and items, or by showing and hiding items in the drop-down lists for the fields.</descrip></descripGrp><ntig><termGrp><term id="360135">PivotTable view</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1940947">pandangan Jadual Pangsi</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13625_121568_1298175"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The conversion of 16-bit addresses to 32-bit addresses, or vice versa, when 16-bit applications are used with 32-bit ODBC drivers.</descrip></descripGrp><ntig><termGrp><term id="121568">thunking</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1298175">thunking</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13629_98864_2199674"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature of certain data storage devices, such as tape drives, in which the device reads data immediately after it is written as a means of verifying data integrity.</descrip></descripGrp><ntig><termGrp><term id="98864">read-after-write</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2199674">baca lepas tulis</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry