Speech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52785_2997871_2999444"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The version 11 of the Windows operating system.</descrip></descripGrp><ntig><termGrp><term id="2997871">Windows 11</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2999444">Windows 11</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52786_2998899_2999855"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Costa Rican national holiday celebrated on December 1 to commemorate the day in 1948 on which then-President José Figueres Ferrer abolished the armed forces following the end of the Costa Rican Civil War.</descrip></descripGrp><ntig><termGrp><term id="2998899">Abolition of the Army</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2999855">Pemansuhan Angkatan Tentera</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52787_2998900_2999857"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The audio-centric user experience that enables Teams customers to catch up on communications, events, and activities when getting back online and to stay connected with work while being distracted from everyday chores.</descrip></descripGrp><ntig><termGrp><term id="2998900">Catch Me Up</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2999857">Perkembangan Terkini</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52788_2999688_2999989"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Expressed in terms of a power of e; or, characterized by a rate of change that is proportional to the value of the varying quantity.</descrip></descripGrp><ntig><termGrp><term id="2999688">exponential</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2999989">eksponen</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52789_2999689_2999988"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Of a complex number, the number with a real part and an imaginary part equal in magnitude but opposite in sign; for example, if a and b are real, then the complex conjugate of a+bi is equal to a-bi.</descrip></descripGrp><ntig><termGrp><term id="2999689">complex conjugate</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2999988">konjugat kompleks</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5279_95225_443890"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A sequence of 25 letters and numbers. To activate some software, you must enter a product key during the activation process.</descrip></descripGrp><ntig><termGrp><term id="95225">product key</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="443890">kunci produk</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52790_2999690_2999990"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mathematical object that can be interpreted as an area or a generalization of an area.</descrip></descripGrp><ntig><termGrp><term id="2999690">integral</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2999990">kamiran</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52793_3000145_3000158"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A person's default space in the Mesh app for HoloLens, private and only accessible by its owner.</descrip></descripGrp><ntig><termGrp><term id="3000145">home space</term><termNote type="partOfSpeech">Noun</ter