finition">The context menu that pops up when text is selected in the Researcher panel giving the option of adding the selected text only or adding the selected text and a citation for the text.</descrip></descripGrp><ntig><termGrp><term id="2415869">Add Cite</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2417858">Tambah Petikan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42648_2416199_2417980"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A 2D background image behind an object.</descrip></descripGrp><ntig><termGrp><term id="2416199">backdrop</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2417980">tirai latar</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4265_101189_443910"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A database repository for information about a computer's configuration. The registry contains information that Windows continually references during operation, such as: profiles for each user; the programs installed on the computer and the types of documents that each can create; property settings for folders and program icons; what hardware exists on the system; which ports are being used. The registry is organized hierarchically as a tree, and it is made up of keys and their subkeys, hives, and entries.</descrip></descripGrp><ntig><termGrp><term id="101189">registry</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="443910">daftaran</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4265_1167347_443910"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A database repository for information about a computer's configuration. The registry contains information that Windows continually references during operation, such as: profiles for each user; the programs installed on the computer and the types of documents that each can create; property settings for folders and program icons; what hardware exists on the system; which ports are being used. The registry is organized hierarchically as a tree, and it is made up of keys and their subkeys, hives, and entries.</descrip></descripGrp><ntig><termGrp><term id="1167347">system registry</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="443910">daftaran</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42654_2417345_2418023"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tool for erasing markings on a 2D surface.</descrip></descripGrp><ntig><termGrp><term id="2417345">eraser</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2418023">pemadam</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42658_2417802_2429487"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A commitment between a customer and field service organization about how and when a service is performed for the customer and what the cost will be for that service.</descrip></descripGrp><ntig><termGrp><term id="2417802">customer agreement</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2429487">perjanjian pelanggan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42659_2417839_2429488"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file that's displayed to a user when the record it is in is similar to the record the user is currently viewing. The user can quickly insert applicable suggested documents into their proposal.</descrip></descripGrp><ntig><termGrp><term id="2417839">document suggestion</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2429488">cadangan dokumen</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4