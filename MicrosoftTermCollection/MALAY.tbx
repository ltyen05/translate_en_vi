et xml:lang="en-US"><descripGrp><descrip type="definition">A node with no child objects represented in the tree.</descrip></descripGrp><ntig><termGrp><term id="415596">leaf</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2186550">nod daun</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15038_73880_2186546"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A node with no child objects represented in the tree.</descrip></descripGrp><ntig><termGrp><term id="73880">leaf node</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2186546">daun</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15038_73880_2186550"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A node with no child objects represented in the tree.</descrip></descripGrp><ntig><termGrp><term id="73880">leaf node</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2186550">nod daun</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15040_187454_1299064"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ability to control whether warnings are reported for a particular region of code by specifying a compiler directive.</descrip></descripGrp><ntig><termGrp><term id="187454">inline warning control</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1299064">kawalan amaran dalam baris</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15046_537623_1299065"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The event in which a permission is not granted. By denying a permission, a method can prevent its callers from exercising the privilege represented by that permission. If a method on the call stack denies permission A, a stack walk checking for permission A will fail unless a valid assertion is found on the stack between the method doing the denial and the method that initiated the check for permission A.</descrip></descripGrp><ntig><termGrp><term id="537623">denial</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1299065">penafian</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15047_318786_444946"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ≤ character.</descrip></descripGrp><ntig><termGrp><term id="318786">LESS-THAN OR EQUAL TO</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="444946">tanda kurang daripada atau sama dengan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15047_318787_444946"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ≤ character.</descrip></descripGrp><ntig><termGrp><term id="318787">less than or equal to sign</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="444946">tanda kurang daripada atau sama dengan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15048_536517_1299066"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A server-side component that encapsulates user-interface and related functionality. An ASP.NET server control derives directly or indirectly from the System.Web.UI.Control class. The superset of ASP.NET server controls includes Web server controls, HTML server controls, and ASP.NET mobile controls. The page syntax for an ASP.NET server control includes a runat="server" attribute on the control's tag.</descrip></descripGrp><ntig><termGrp><term id="536517">ASP.NET server control</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1299066">kawalan pelayan ASP.NET</term><termNote type="geographicalUsage">BRN, MYS</termNote