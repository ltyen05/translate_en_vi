/termEntry><termEntry id="37240_2113073_2132236"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The transient, contextual UI element that appears near to the user’s focus and appears as an ellipsis within a square.</descrip></descripGrp><ntig><termGrp><term id="2113073">Mini Toolbar Indicator</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2132236">Penunjuk Bar Alat Mini</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37242_2113075_2137494"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A callout in a UI that contains help information for a new feature, is context-sensitive, and contains information in the form of text, graphics, or animations.</descrip></descripGrp><ntig><termGrp><term id="2113075">Teaching callout</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2137494">Petak bual pengajaran</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37244_2113077_2132231"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The filter in the context of a particular channel that shows only the videos uploaded or owned by the user who is currently logged in.</descrip></descripGrp><ntig><termGrp><term id="2113077">My videos</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2132231">Video saya</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37249_2113090_2137479"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user account and associated credentials that is used to access Microsoft’s and 3rd parties’ business services, such as Office 365. Work or school accounts are usually assigned to end users by their organization (work, school, non-profit) and managed by the admin. However, some business services like Yammer support work or school accounts that were created by end users, without IT involvement. We sometimes refer to these accounts as “viral” AAD accounts but we don’t use this term externally. Work or school accounts are stored in Azure Active Directory (AAD) and managed by Microsoft on behalf of the organization. One of the key difference with a Microsoft account is that users don’t own the account and will typically loose access to it if they leave the organization. Other aspects like password policies are imposed by admins.</descrip></descripGrp><ntig><termGrp><term id="2113090">work or school account</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2137479">akaun kerja atau sekolah</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3725_129780_2121811"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A software implementation of a computer that emulates a complete hardware system, from processor to network card, in a self-contained, isolated software environment, enabling the simultaneous operation of otherwise incompatible operating systems.</descrip></descripGrp><ntig><termGrp><term id="129780">virtual machine</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2121811">mesin maya</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3725_129781_2121811"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A software implementation of a computer that emulates a complete hardware system, from processor to network card, in a self-contained, isolated software environment, enabling the simultaneous operation of otherwise incompatible operating systems.</descrip></descripGrp><ntig><termGrp><term id="129781">VM</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2121811">mesin maya</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37250_2113091_2137481"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user account and associated credentials that is used to access Microsoft’s and 3rd parties’ business services, such as Office 365. Work or school accounts are usually assigned to end users by their organization (work, school, non-profit) and managed by the admin. However, some business services like Yammer support work or school accounts that were created by end users, without IT involvement. We sometimes refer to these accounts as “viral” AAD accounts but we don’t use this term externally. Work or school accounts are stored in Azure Active Directory (AAD) and managed by Microsoft on behalf of the organization. One of the key difference with a Microsoft account is that users don’t own the account and will typically loose access to it if they leave the organization. Other aspects like password policies are imposed by admins.</descrip></descripGrp><ntig><termGrp><term id="2113091">work account</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2137481">akaun kerja</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37255_2113318_2218680"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Terminal Services session.</descrip></descripGrp><ntig><termGrp><term id="2113318">TS session</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2218680">sesi TS</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37255_2113319_2218680"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Terminal Services session.</descrip></descripGrp><ntig><termGrp><term id="2113319">Terminal Services session</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2218680">sesi TS</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37261_2113977_2193625"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The button that takes the user to the previous item or page.</descrip></descripGrp><ntig><termGrp><term id="2113977">Back button</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2193625">Butang ke belakang</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37262_2113979_2193644"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The button pressed to update displayed information with current data.</descrip></descripGrp><ntig><termGrp><term id="2113979">Refresh button</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2193644">Butang segar semula</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37264_2113981_2191618"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature in the Clock app that allows the user to input any time and see it converted to the equivalent time in another time zone.</descrip></descripGrp><ntig><termGrp><term id="2113981">Compare times</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2191618">Banding</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37264_2113981_2191619"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature in the Clock app that allows the user to input any time and see it converted to the equivalent time in another time zone.</descrip></descripGrp><ntig><termGrp><term id="2113981">Compare times</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2191619">Banding masa</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37264_2113982_2191618"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature in the Clock app that allows the user to input any time and see it converted to the equivalent time in another time zone.</descrip></descripGrp><ntig><termGrp><term id="2113982">Compare</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2191618">Banding</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeec