Note><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23601_2328434_1641312"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that allows users to stream music, images or videos to a specific device on their home network.</descrip></descripGrp><ntig><termGrp><term id="2328434">Cast to Device</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1641312">Mainkan Di</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23601_2328434_2333649"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that allows users to stream music, images or videos to a specific device on their home network.</descrip></descripGrp><ntig><termGrp><term id="2328434">Cast to Device</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2333649">Siarkan ke Peranti</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23606_1088710_2174230"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In American usage (as is usual with microcomputers), a thousand million, or 109. Computer terminology uses the prefixes giga-for 1 billion and nano-for 1 billionth.</descrip></descripGrp><ntig><termGrp><term id="1088710">billion</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2174230">bilion</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23608_1088712_2174249"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A combination of bits, often used to indicate the possible unique combinations of a specific number of bits. For example, a 3-bit pattern allows 8 possible combinations and an 8-bit pattern allows 256 combinations.</descrip></descripGrp><ntig><termGrp><term id="1088712">bit pattern</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2174249">corak bit</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2361_310912_444821"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A notification sent from one blog to another. It is a way for bloggers to let each other know when one of them has made a reference to another's blog entry.</descrip></descripGrp><ntig><termGrp><term id="310912">trackback</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="444821">jejak semula</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23615_1088719_2519491"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The electron-emitting electrode in a vacuum tube.</descrip></descripGrp><ntig><termGrp><term id="1088719">cathode</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2519491">katod</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23618_1088724_1183321"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To enter information by means of the keyboard or other input method.</descrip></descripGrp><ntig><termGrp><term id="1088724">enter</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1183321">masuk</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23621_1088739_1677962"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process that performs reverse number lookup on one-number calls and then routes the call over an IP connection to the public switched telephone network (PSTN) gateway that is nearest to the location of the destination phone number.</descrip></descripGrp><ntig><termGrp><term id="1088739">least-cost routing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1677962">LCR</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23621_1088740_1677962"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process that performs reverse number lookup on one-number calls and then routes the call over an IP connection to the public switched telephone network (PSTN) gateway that is nearest to the location of the destination phone number.</descrip></descripGrp><ntig><termGrp><term id="1088740">LCR</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1677962">LCR</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2363_95503_443893"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An attribute of an object that is used to define its state, appearance, or value.</descrip></descripGrp><ntig><termGrp><term id="95503">property</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="443893">sifat</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2364_181054_2187992"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A provider that logs package information at run time. Integration Services includes a variety of log providers that make it possible to capture events during package execution. Logs are created and stored in formats such as XML, text, database, or in the Windows event log.</descrip></descripGrp><ntig><termGrp><term id="181054">log provider</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2187992">pembekal log</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23657_1088805_1944821"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In computer systems, a reduction in level of performance or service. Degradation in microcomputer performance is indicated by slow response times or frequent pauses for disk access because memory is insufficient to hold an entire program plus the data the program is using.</descrip></descripGrp><ntig><termGrp><term id="1088805">degradation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1944821">penurunan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2366_52839_2433162"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of adding depth to a two-dimensional shape to create a three-dimensional object.</descrip></descripGrp><ntig><termGrp><term id="52839">extrusion</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2433162">penyemperitan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23660_1088811_2216513"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An individual who designs and develops software.</descrip></descripGrp><ntig><termGrp><term id="1088811">developer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2216513">pembangun</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2367_535439_1294541"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Any class that is marked with the TestClass attribute.</descrip></descripGrp><ntig><termGrp><term id="535439">test class</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1294541">kelas ujian</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2368_530232_2175485"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The language used for accessing, querying, updating, and managing data in relational database systems.</descrip></descripGrp><ntig><termGrp><term id="530232">database language</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2175485">bahasa pangkalan data</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23681_1088831_1301354"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file in which the user's input and actions in one or many applications for each step in a test are recorded. You can then play back this action recording to automatically run specific test steps.</descrip></descripGrp><ntig><termGrp><term id="1088831">action recording</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1301354">rakaman tindakan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23682_1088832_1301355"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A part of an action recording that is based on the steps that you mark as passed or failed in a test. Each time you mark the outcome of a test step, a new section of the action recording is created.</descrip></descripGrp><ntig><termGrp><term id="1088832">action recording section</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1301355">seksyen rakaman tindakan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23683_1088833_1301356"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A variable that specifies a testing requirement, such as a hardware or software requirement. Each configuration variable has a set of allowable values associated with it.</descrip></descripGrp><ntig><termGrp><term id="1088833">configuration variable</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1301356">pemboleh ubah konfigurasi</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23684_1088834_1301357"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An assembly that has functionality to enable a user to either collect diagnostic data to understand what is happening on a system when a test is running, or perform actions on the system while a test is running.</descrip></descripGrp><ntig><termGrp><term id="1088834">diagnostic data adapter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1301357">penyesuai data diagnostik</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23685_1088835_1301358"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An executable line of text that excludes white space, comments, type declarations, and namespace declarations.</descrip></descripGrp><ntig><termGrp><term id="1088835">line of code</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1301358">barisan kod</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23686_1088836_1301359"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The set of test cases that are returned when a specific query is run. If new test cases that meet the criteria in this query are added to the test suite, the new test cases will automatically appear in the query-based test suite.</descrip></descripGrp><ntig><termGrp><term id="1088836">query-based test suite</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1301359">suit ujian berasaskan pertanyaan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23687_1088837_1301360"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A specific part or function in an application or architecture. For example, a Web server, a database server, or a client.</descrip></descripGrp><ntig><termGrp><term id="1088837">role</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1301360">peranan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23688_1088838_1301361"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of test steps that can be reused between test cases.</descrip></descripGrp><ntig><termGrp><term id="1088838">shared steps</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1301361">langkah kongsi</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23689_1088839_1301362"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of configuration variables that specify the correct setup required for testing an application.</descrip></descripGrp><ntig><termGrp><term id="1088839">test configuration</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1301362">konfigurasi ujian</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23691_1088841_1301363"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A background process that manages a set of machines with the test agent software installed.</descrip></descripGrp><ntig><termGrp><term id="1088841">test agent controller</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1301363">pengawal agen ujian</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23692_1088842_1301364"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of test cases and their associated test configuration information and the iteration when it is planned to run these tests.</descrip></descripGrp><ntig><termGrp><term id="1088842">test plan</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1301364">pelan ujian</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23692_1088842_2751966"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of test cases and their associated test configuration information and the iteration when it is planned to run these tests.</descrip></descripGrp><ntig><termGrp><term id="1088842">test plan</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2751966">pelan pengesahan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23692_2749693_1301364"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of test cases and their associated test configuration information and the iteration when it is planned to run these tests.</descrip></descripGrp><ntig><termGrp><term id="2749693">validation plan</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1301364">pelan ujian</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23692_2749693_2751966"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of test cases and their associated test configuration information and the iteration when it is planned to run these tests.</descrip></descripGrp><ntig><termGrp><term id="2749693">validation plan</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2751966">pelan pengesahan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23693_1088843_1301365"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of selected test cases. A test suite can contain other test suites, but each test suite can be contained in only one other test suite.</descrip></descripGrp><ntig><termGrp><term id="1088843">test suite</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:l