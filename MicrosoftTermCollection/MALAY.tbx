e="definition">The field in Outlook Customer Manager that records the number of deals that did not go through as well as their sum.</descrip></descripGrp><ntig><termGrp><term id="2488793">Deals lost</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2493768">Urusan terlepas</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44292_2488794_2493766"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The field in Outlook Customer Manager that records the number of deals that were accepted and completed as well as their sum.</descrip></descripGrp><ntig><termGrp><term id="2488794">Deals won</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2493766">Urusan dimenangi</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44293_2488795_2493777"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The field in Outlook Customer Manager that records the number of deals have not been finalized (won or lost), as well as their sum.</descrip></descripGrp><ntig><termGrp><term id="2488795">Deals active</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2493777">Urusan aktif</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="443_17176_1294450"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A security feature of Microsoft Internet Explorer. Authenticode allows vendors of downloadable executable code (plug-ins or ActiveX controls, for example) to attach digital certificates to their products to assure end users that the code is from the original developer and has not been altered. Authenticode lets end users decide for themselves whether to accept or reject software components posted on the Internet before downloading begins.</descrip></descripGrp><ntig><termGrp><term id="17176">Authenticode</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1294450">Kod Pengesahan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44309_2489123_2515999"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of selecting players for positions in a fantasy sports team.</descrip></descripGrp><ntig><termGrp><term id="2489123">draft</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2515999">draf</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44310_2489125_2515998"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An upper limit or maximum value.</descrip></descripGrp><ntig><termGrp><term id="2489125">cap</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2515998">atas</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44315_2489135_2493779"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The offer for students and educators that includes the Universal Windows Platform versions of Excel, PowerPoint, and Word, and that allows shared computer activation.</descrip></descripGrp><ntig><termGrp><term id="2489135">Office 365 Education Cart</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2493779">Office 365 Education Cart</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44317_2489142_2490736"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that lets you quickly create new measures based on measures and numerical columns in your table.</descrip></descripGrp><ntig><termGrp><term id="2489142">quick measure</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2490736">kiraan pantas</term><termNote type="geog