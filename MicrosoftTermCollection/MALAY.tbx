mNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28185_1468809_2211305"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The angle of rotation, between 0 and 360, at which the scale will begin. The zero (0) position is located at the bottom of the gauge, and the start angle rotates clockwise. For example, a start angle of 90 degrees starts the scale at the 9 o'clock position.</descrip></descripGrp><ntig><termGrp><term id="1468809">start angle</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2211305">sudut permulaan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28188_1468812_2216691"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A formula that calculates the average of the high, low, and close prices, while giving extra weight to the close price.</descrip></descripGrp><ntig><termGrp><term id="1468812">weighted close formula</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2216691">formula tertutup berpemberat</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28190_1468835_1678019"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables you to manage Lync 2010 conversations and meetings that you have recorded. From within Lync Recording Manager, you can play or rename recordings, or create a video format to share with others.</descrip></descripGrp><ntig><termGrp><term id="1468835">Recording Manager</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1678019">Recording Manager</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="282_180546_2174146"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A .NET managed data provider that provides access to multidimensional data sources, such as Microsoft SQL Server Analysis Services.</descrip></descripGrp><ntig><termGrp><term id="180546">ADOMD.NET</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2174146">Objek Data ActiveX Berbilang Dimensi.NET</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="282_180546_2174152"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A .NET managed data provider that provides access to multidimensional data sources, such as Microsoft SQL Server Analysis Services.</descrip></descripGrp><ntig><termGrp><term id="180546">ADOMD.NET</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2174152">Business Scorecard Manager - 2005, Office System - 2010, PerformancePoint Server - 2007, PerformancePoint Services - in Microsoft SharePoint Server 2010, SQL Server - 2008</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="282_211811_2174146"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A .NET managed data provider that provides access to multidimensional data sources, such as Microsoft SQL Server Analysis Services.</descrip></descripGrp><ntig><termGrp><term id="211811">ActiveX Data Objects MultiDimensional.NET</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2174146">Objek Data ActiveX Berbilang Dimensi.NET</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="282_211811_2174152"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A .NET managed data provider that provides access to multidimensional data sources, such as Microsoft SQL Server Analysis Services.</descrip></descripGrp><ntig><termGrp><term id="211811">ActiveX Data Objects MultiDimensional.NET</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2174152">Business Scorecard Manager - 2005, Office System - 2010, PerformancePoint Server - 2007, PerformancePoint Services - in Microsoft SharePoint Server 2010, SQL Server - 2008</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2820_206426_444344"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Windows Presentation Foundation, an event routing strategy where the event instance moves down the element tree (starting at the root of the visual tree and ending with the source). The names of events that use this routing strategy are prefixed with the word "Preview". These events have the same signature as their counterparts that use the bubbling event routing strategy.</descrip></descripGrp><ntig><termGrp><term id="206426">tunneling</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="444344">penerowongan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2824_2685641_2685780"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A listing of keywords and associated data that point to the location of more comprehensive information, such as files and records on a disk or record keys in a database.</descrip></descripGrp><ntig><termGrp><term id="2685641">search index</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2685780">indeks carian</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntr