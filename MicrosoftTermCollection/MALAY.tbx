/descrip></descripGrp><ntig><termGrp><term id="308318">expiration date</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="444796">tarikh tamat tempoh</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24204_1115322_2188470"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In reference to asymetric key encryption, the idea that many individuals in possession of the public key can decrypt the digital signature of one individual in possession of the private key.</descrip></descripGrp><ntig><termGrp><term id="1115322">many-to-one relationship</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2188470">perhubungan banyak kepada satu</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24206_1115324_1521433"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The object that is used to initiate any actions with the client-side object model. It is the primary entry point for the client object model, and the primary object for coordinating requests against corresponding objects in a site collection.</descrip></descripGrp><ntig><termGrp><term id="1115324">client context</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1521433">konteks klien</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24212_1119987_1521522"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A custom solution that can be deployed to a site by a site collection administrator, without approval from the farm administrator. Without that approval, the solution has full access to the immediate site and restricted access to system resources and other sites.</descrip></descripGrp><ntig><termGrp><term id="1119987">sandboxed solution</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1521522">penyelesaian kotak pasir</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24213_1115331_1521476"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A persistent container that defines and stores instructions for a job to be run on a server, server farm, or server cluster. To run, a job must have an associated job definition, and a definition must be associated with a service or a Web application.</descrip></descripGrp><ntig><termGrp><term id="1115331">job definition</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1521476">takrif kerja</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24215_1115333_1521541"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A compressed file that can be deployed to a server farm or a site. It can contain assemblies, resource files, site and feature definitions, templates, code access security policies, and Web Parts.</descrip></descripGrp><ntig><termGrp><term id="1115333">solution package</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1521541">pakej penyelesaian</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24216_1115334_1521540"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A custom keyword or description and shortcut to a Web page or item on a SharePoint site or the Internet. All of these tags can be viewed, managed, and shared by using My Site.</descrip></descripGrp><ntig><termGrp><term id="1115334">social tag</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1521540">teg sosial</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24221_1115339_1521478"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A solution package that contains only a DLL that stores localized versions of strings in another solution package. After a language pack is deployed to a site, users can display the corresponding user interface in that language.</descrip></descripGrp><ntig><termGrp><term id="1115339">language pack</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1521478">pek bahasa</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24222_1115340_1521498"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An area for storing comments about a Web page. A note board can appear on a Web page or in a separate dialog box. The notes can be viewed, managed, and shared by using My Site.</descrip></descripGrp><ntig><termGrp><term id="1115340">note board</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1521498">papan catatan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24223_1115341_1521487"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft SQL Server, MSDE, or WMSDE database that stores health monitoring and usage data temporarily, and can be used for reporting and diagnostics.</descrip></descripGrp><ntig><termGrp><term id="1115341">logging database</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1521487">pangkalan data pengelogan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24225_1115347_2360438"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A block of cells selected for similar treatment in a spreadsheet. A range of cells can extend across a row, down a column, or over a combination of the two, but all cells in the range must be contiguous, sharing at least one common border.</descrip></descripGrp><ntig><termGrp><term id="1115347">range</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2360438">julat</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24246_1117154_1358624"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The software that installs the Windows Live software someone selects on the installation webpage.</descrip></descripGrp><ntig><termGrp><term id="1117154">Windows Live installer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1358624">Pemasang Windows Live</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24247_1117155_1358623"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The main landing or start page on Windows Live.</descrip></descripGrp><ntig><termGrp><term id="1117155">Windows Live Home</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1358623">Laman Utama Windows Live</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24249_1117156_1358234"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A function that enables a user to make a call to a phone, as opposed to calling another computer or using a webcam.</descrip></descripGrp><ntig><termGrp><term id="1117156">phone call</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1358234">panggilan telefon</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2425_34681_443439"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A predefined set of harmonized colors that you can apply to text and objects. Text and objects with an applied scheme color will change automatically when you switch to a new color scheme or modify the current color scheme.</descrip></descripGrp><ntig><termGrp><term id="34681">color scheme</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="443439">skema warna</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNot