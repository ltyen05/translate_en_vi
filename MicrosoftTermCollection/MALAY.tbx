88"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A software system that determines the likelihood of incoming emails being a phishing attempt due to analysis of previous emailing history.</descrip></descripGrp><ntig><termGrp><term id="2652498">mailbox intelligence</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2653288">kecerdasan peti mel</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="47092_2652805_3014925"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that tells users when their contacts were last logged in to the application.</descrip></descripGrp><ntig><termGrp><term id="2652805">Last seen</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="3014925">Terakhir dilihat</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="471_536631_1294452"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In ASP.NET, a variable store created on the server for the current user; each user maintains a separate Session state on the server. Session state is typically used to store user-specific information between postbacks.</descrip></descripGrp><ntig><termGrp><term id="536631">session state</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></nti