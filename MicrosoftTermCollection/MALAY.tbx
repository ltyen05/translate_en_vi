diate language (MSIL) instruction set's box instruction converts a value type to an object by making a copy of the value type and embedding it in a newly allocated object.</descrip></descripGrp><ntig><termGrp><term id="138014">boxing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1295380">pembungkusan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5983_346955_445082"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A place where one lives.</descrip></descripGrp><ntig><termGrp><term id="346955">home</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="445082">rumah</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="599_169342_2194752"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A restore during which the database is offline.</descrip></descripGrp><ntig><termGrp><term id="169342">offline restore</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2194752">pemulihan luar talian</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5998_363607_1710669"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An administrative boundary that uses one set of authentication servers to manage and deploy a single set of unique identifiers. A realm is a unique logon space.</descrip></descripGrp><ntig><termGrp><term id="363607">realm</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1710669">kelompok halaman</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5999_7470_2174140"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A data structure or group of structures created by the consumer that describes how row or parameter data from the data store is to be laid out in the consumer's data buffer, enabling providers to optimize access. An accessor is a collection of bindings.</descrip></descripGrp><ntig><termGrp><term id="7470">accessor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2174140">pencapai</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6000_536317_1295381"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Any code placed on a central server that is meant to be downloaded and run by multiple clients. Mobile code can be distributed using Web servers, FTP servers, file shares, and so on. Typically, users run mobile code from the intranet and Internet zones.</descrip></descripGrp><ntig><termGrp><term id="536317">mobile code</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1295381">kod mudah alih</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6004_358356_362152"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of Microsoft Exchange features that offers increased access to documents even when the documents are located on an internal network or the software required to view the documents is not installed on the client computer.</descrip></descripGrp><ntig><termGrp><term id="358356">Enhanced Document Availability</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="362152">Ketersediaan Dokumen Dipertingkat</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6013_139351_2174471"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The cryptographic key used to both encrypt and decrypt protected content during publishing and consumption.</descrip></descripGrp><ntig><termGrp><term id="139351">content key</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2174471">kunci kandungan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6013_139351_2211377"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The cryptographic key used to both encrypt and decrypt protected content during publishing and consumption.</descrip></descripGrp><ntig><termGrp><term id="139351">content key</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2211377">kunci simetri</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6013_139352_2174471"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The cryptographic key used to both encrypt and decrypt protected content during publishing and consumption.</descrip></descripGrp><ntig><termGrp><term id="139352">symmetric key</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2174471">kunci kandungan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6013_139352_2211377"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The cryptographic key used to both encrypt and decrypt protected content during publishing and consumption.</descrip></descripGrp><ntig><termGrp><term id="139352">symmetric key</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2211377">kunci simetri</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6014_181027_2186564"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A reference in a cube to a dimension in a different cube (that is, a cube with a different data source view that exists in the same or a different Analysis Services database). A linked dimension can only be related to measure groups in the source cube, and can only be edited in the source database.</descrip></descripGrp><ntig><termGrp><term id="181027">linked dimension</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2186564">dimensi terpaut</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6015_397176_408785"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of temporary queues that hold messages that are being delivered to a Mailbox server by using encrypted Exchange RPC. Mailbox delivery queues exist on Hub Transport servers only. A different mailbox delivery queue exists for each Mailbox server destination. The destination Mailbox server must exist in the same Active Directory directory service site as the Hub Transport server. Mailbox delivery queues are dynamically created as needed and are automatically removed.</descrip></descripGrp><ntig><termGrp><term id="397176">mailbox delivery queue</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="408785">baris gilir penghantaran peti mel</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6017_186210_1096455"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of pages with the .master extension that define shared page elements and content place holders.</descrip></descripGrp><ntig><termGrp><term id="186210">Master Page Gallery</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1096455">Galeri Halaman Induk</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6018_537294_1295382"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A style in an external style sheet.</descrip></descripGrp><ntig><termGrp><term id="537294">external style</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1295382">gaya luaran</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="602_534923_1294458"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A query syntax that defines a set of query operators that allow traversal, filter, and projection operations to be expressed in a direct, declarative way in any .NET-based programming language.</descrip></descripGrp><ntig><termGrp><term id="534923">LINQ</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1294458">LINQ</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="602_534924_1294458"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A query syntax that defines a set of query operators that allow traversal, filter, and projection operations to be expressed in a direct, declarative way in any .NET-based programming language.</descrip></descripGrp><ntig><termGrp><term id="534924">language-integrated query</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1294458">LINQ</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6023_530276_2177362"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A table that stores event state information.</descrip></descripGrp><ntig><termGrp><term id="530276">event chronicle</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2177362">jadual babad peristiwa</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6025_169146_2196481"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A partial backup that is differential relative to a single, previous partial backup (the base backup). For a read-only database, a partial differential backup contains only the primary filegroup.</descrip></descripGrp><ntig><termGrp><term id="169146">partial differential backup</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2196481">sandaran pembezaan separa</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6031_475227_2121536"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A privilege level that specifies the user has access to objects anywhere within the organization. The application refers to this level as Organization.</descrip></descripGrp><ntig><termGrp><term id="475227">Global</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2121536">Global</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6032_178599_2121435"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An entity that sells similar products or services and competes for the same customer segment.</descrip></descripGrp><ntig><termGrp><term id="178599">competitor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2121435">pesaing</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6033_319444_444970"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An area within the Control Panel that provides accessibility options and settings to help users interact more easily with the computer.</descrip></descripGrp><ntig><termGrp><term id="319444">Ease of Access Center</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="444970">Pusat Kemudahan Capaian</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6034_530240_2175518"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The database the user is connected to immediately after logging in to SQL Server.</descrip></descripGrp><ntig><termGrp><term id="530240">default database</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2175518">pangkalan data lalai</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="gr