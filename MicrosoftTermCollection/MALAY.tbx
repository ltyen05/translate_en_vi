ned in the master boot record that scans the partition table for the active partition, finds the starting sector of the active partition, loads a copy of the boot sector from the active partition into memory, and transfers control to the executable code in the boot sector.</descrip></descripGrp><ntig><termGrp><term id="1597055">master boot code</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1747985">kod but induk</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3117_109079_1182871"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Protection of a computer system and its data from harm or loss.</descrip></descripGrp><ntig><termGrp><term id="109079">security</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1182871">keselamatan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3117_747373_1182871"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Protection of a computer system and its data from harm or loss.</descrip></descripGrp><ntig><termGrp><term id="747373">network security</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1182871">keselamatan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="312_537073_1294436"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A class-based API for C/C++ programmers that enables applications to use graphics and formatted text on both the video display and the printer. Applications based on the Microsoft Win32 API do not access graphics hardware directly. Instead, GDI+ interacts with device drivers on behalf of applications. GDI+ is also supported by Microsoft Win64.</descrip></descripGrp><ntig><termGrp><term id="537073">GDI+</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1294436">GDI+</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3120_237195_1294573"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A test run by a developer to determine whether his code has affected the general stability of the product.</descrip></descripGrp><ntig><termGrp><term id="237195">check-in test</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1294573">ujian daftar masuk</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3127_140864_2735799"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A phone number format for dialing internal, operator, or emergency numbers by a computer.</descrip></descripGrp><ntig><termGrp><term id="140864">dialable format</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2735799">format boleh dail</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3128_216346_2121666"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A communication method that creates a single activity for distribution to a group of marketing lists, accounts, contacts, or leads. Contrast with a campaign, which supports an end-to-end marketing program that has multiple activities.</descrip></descripGrp><ntig><termGrp><term id="216346">quick campaign</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2121666">kempen cepat</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31293_1598403_1641106"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A runtime environment for Windows Store apps that's designed to minimize app impact on the computer by placing runtime restrictions on what apps can do.</descrip></descripGrp><ntig><termGrp><term id="1598403">app container</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1641106">bekas apl</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31294_1627809_1641639"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A filtering feature that monitors downloaded apps for malware or unknown reputation.</descrip></descripGrp><ntig><termGrp><term id="1627809">Windows SmartScreen</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1641639">Penapis Windows SmartScreen</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31295_1598405_1641116"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature of Windows that includes a set of maintenance tasks that run automatically when the user's PC is idle.</descrip></descripGrp><ntig><termGrp><term id="1598405">Automatic Maintenance</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1641116">Penyelenggaraan Automatik</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31296_1598406_1641122"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature of BitLocker that enables IT pros to encrypt a disk before a user begins to use it.</descrip></descripGrp><ntig><termGrp><term id="1598406">BitLocker encrypted installation</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1641122">pemasangan tersulit BitLocker</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31297_1598407_1641123"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A BitLocker extension that adds management capabilities to BitLocker.</descrip></descripGrp><ntig><termGrp><term id="1598407">BitLocker Enterprise</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1641123">BitLocker Perusahaan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31298_1598408_1641129"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature of BitLocker that allows unlocking of an OS volume using a key received over the network.</descrip></descripGrp><ntig><termGrp><term id="1598408">BitLocker network unlock</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1641129">pembuka kunci rangkaian BitLocker</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="