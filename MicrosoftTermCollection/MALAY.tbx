e="definition">A person responsible for creating and maintaining a World Wide Web site. A webmaster is often responsible for responding to email, ensuring the site is operating properly, creating and updating Web pages, and maintaining the overall structure and design of the site.</descrip></descripGrp><ntig><termGrp><term id="132219">webmistress</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1096566">juruweb</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43810_2471606_2498445"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A customizable area of an app, site map, or view designer where users can add or edit different components of a business app.</descrip></descripGrp><ntig><termGrp><term id="2471606">canvas</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2498445">kanvas</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43811_2471609_2498441"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A stage in a business process flow that uses an automated process for gathering data.</descrip></descripGrp><ntig><termGrp><term id="2471609">action step</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2498441">langkah