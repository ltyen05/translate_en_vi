74331"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An event in which the Database Engine writes dirty buffer pages to disk. Each checkpoint writes to disk all the pages that were dirty at the last checkpoint and still have not been written to disk.</descrip></descripGrp><ntig><termGrp><term id="534959">checkpoint</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2174331">titik semak</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16233_141973_2180015"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">file Data Source Names. File-based data sources shared among all users with the same drivers installed. These data sources are not dedicated to a user or local to a computer.</descrip></descripGrp><ntig><termGrp><term id="141973">file DSN</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2180015">DSN fail</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16235_530452_2186292"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A short-term synchronization object protecting actions that need not be locked for the life of a transaction. A latch is primarily used to protect a row that the storage engine is actively transferring from a base table or index to the relational engine.</descrip></descripGrp><ntig><termGrp><term id="530452">latch</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2186292">selak</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16236_1177080_2121596"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The version of Microsoft Dynamics CRM available over the Internet hosted by Microsoft or a partner.</descrip></descripGrp><ntig><termGrp><term id="1177080">Microsoft Dynamics CRM Online</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2121596">Microsoft Dynamics CRM Online</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16236_475185_2121596"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The version of Microsoft Dynamics CRM available over the Internet hosted by Microsoft or a partner.</descrip></descripGrp><ntig><termGrp><term id="475185">Microsoft Dynamics CRM Live</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2121596">Microsoft Dynamics CRM Online</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1624_171833_2196574"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of policy settings that define the password requirements for a Group Policy object (GPO).</descrip></descripGrp><ntig><termGrp><term id="171833">password policy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2196574">dasar kata laluan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16241_534966_1299145"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A situation when two users, each having a lock on one piece of data, attempt to acquire a lock on the other's piece.</descrip></descripGrp><ntig><termGrp><term id="534966">deadlock</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1299145">kebuntuan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16246_123620_1299146"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To activate a function or program, such as the release of a virus payload, in response to a specific event, date, or time.</descrip></descripGrp><ntig><termGrp><term id="123620">trigger</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1299146">memicu</term><termN