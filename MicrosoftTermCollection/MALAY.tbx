/termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4196_213534_444394"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The number of colors or levels of gray that can be displayed at one time. The amount or memory in the computer's graphics controller card controls the display. An 8-bit controller can display 256 colors or levels of gray; a 16-bit controller, 64,000 colors; and a 24-bit controller, 16.8 million colors.</descrip></descripGrp><ntig><termGrp><term id="213534">bit specification</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="444394">spesifikasi bit</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41961_2375458_3113449"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The basic amount of the guaranteed ingress/egress of events sent to an Event Hub that can be dynamically scaled according to stream processing, to pay only for compute needs and handle jobs with gigabytes/sec of streamed data.</descrip></descripGrp><ntig><termGrp><term id="2375458">capacity unit</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="3113449">unit kapasiti</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41961_2766779_3113449"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The basic amount of the guaranteed ingress/egress of events sent to an Event Hub that can be dynamically scaled according to stream processing, to pay only for compute needs and handle jobs with gigabytes/sec of streamed data.</descrip></descripGrp><ntig><termGrp><term id="2766779">CU</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="3113449">unit kapasiti</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4197_113668_443954"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A power-saving state that allows the computer or device to quickly resume full-power operation (typically within several seconds) when you want to start working again. All open documents and programs are saved to memory before the computer or device enters the low-power state.</descrip></descripGrp><ntig><termGrp><term id="113668">sleep</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="443954">tidur</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4197_113668_444835"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A power-saving state that allows the computer or device to quickly resume full-power operation (typically within several seconds) when you want to start working again. All open documents and programs are saved to memory before the computer or device enters the low-power state.</descrip></descripGrp><ntig><termGrp><term id="113668">sleep</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="444835">mod tidur</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4197_312080_443954"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A power-saving state that allows the computer or device to quickly resume full-power operation (typically within several seconds) when you want to start working again. All open documents and programs are saved to memory before the computer or device enters the low-power state.</descrip></descripGrp><ntig><termGrp><term id="312080">sleep mode</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="443954">tidur</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4197_312080_444835"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A power-saving state that allows the computer or device to quickly resume full-power operation (typically within several seconds) when you want to start working again. All open documents and programs are saved to memory before the computer or device enters the low-power state.</descrip></descripGrp><ntig><termGrp><term id="312080">sleep mode</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="444835">mod tidur</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41978_2375534_2377756"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The nickname for Windows 10, version 1607​, used by marketing and executives in announcements about this update, but not in the product.​</descrip></descripGrp><ntig><termGrp><term id="2375534">Windows 10 Anniversary Update</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2377756">Kemas Kini Ulang Tahun Windows 10</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41979_2375536_2405300"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The StaffHub tab where users are able to view all of the shifts their manager has them scheduled for.</descrip></descripGrp><ntig><termGrp><term id="2375536">My Shifts</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2405300">Syif Saya</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41980_2375537_2405302"><langSet xml:lang=