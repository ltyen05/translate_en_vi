 xml:lang="en-US"><descripGrp><descrip type="definition">A file containing information that the user either requires or will find informative and that might not have been included in the documentation. Readme files are placed on disk in plain-text form (without extraneous or program-specific characters) so that they can be read easily be a variety of word processing programs.</descrip></descripGrp><ntig><termGrp><term id="251778">README</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1182893">fail readme</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11919_251778_444557"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file containing information that the user either requires or will find informative and that might not have been included in the documentation. Readme files are placed on disk in plain-text form (without extraneous or program-specific characters) so that they can be read easily be a variety of word processing programs.</descrip></descripGrp><ntig><termGrp><term id="251778">README</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="444557">README</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11926_317517_443495"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of installation that allows the user to specify certain installation settings and options, such as which components will be installed.</descrip></descripGrp><ntig><termGrp><term id="317517">custom installation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="443495">pemasangan tersuai</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11926_41721_443495"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of installation that allows the user to specify certain installation settings and options, such as which components will be installed.</descrip></descripGrp><ntig><termGrp><term id="41721">custom install</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="443495">pemasangan tersuai</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11928_187269_1297301"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Code that is not called during profiling.</descrip></descripGrp><ntig><termGrp><term id="187269">dead code</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1297301">kod mati</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11929_168890_2174476"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tape that is used after the initial tape in a media family fills, allowing continuation of a media family.</descrip></descripGrp><ntig><termGrp><term id="168890">continuation tape</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2174476">pita sambungan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1193_168950_2180011"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A backup of all the data in one or more files or filegroups.</descrip></descripGrp><ntig><termGrp><term id="168950">file backup</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2180011">sandaran fail</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11930_8599_1297302"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of compact, template-based C++ classes that simplify the programming of Component Object Model objects. ATL provides the mechanism to use and create COM objects.</descrip></descripGrp><ntig><termGrp><term id="8599">Active Template Library</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1297302">Pustaka Templat Aktif</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11930_8600_1297302"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of compact, template-based C++ classes that simplify the programming of Component Object Model objects. ATL provides the mechanism to use and create COM objects.</descrip></descripGrp><ntig><termGrp><term id="8600">ATL</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1297302">Pustaka Templat Aktif</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11931_536075_1297303"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A static method that can be invoked by using instance method syntax. In effect, extension methods make it possible to extend existing types and constructed types with additional methods.</descrip></descripGrp><ntig><termGrp><term id="536075">extension method</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1297303">kaedah penyambungan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11932_537633_1297304"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An indication of the relative performance of an algorithm. An algorithm or the method that implements it is said to be O(1) if its execution is a constant, O(log n) if its execution is proportional to the natural log of n, or O(n) if its execution is proportional to n. O notation is frequently used as a way to compare the relative performance of operations on collections, in which case n is usually the number of elements in the collection.</descrip></descripGrp><ntig><termGrp><term id="537633">O notation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1297304">notasi O</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11936_23875_443353"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The amount of light that is emitted by a computer monitor or picture displayed on the monitor.</descrip></descripGrp><ntig><termGrp><term id="23875">brightness</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="443353">kecerahan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11943_26893_1297305"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The series of method calls leading from the beginning of the program to the statement currently being executed at run time.</descrip></descripGrp><ntig><termGrp><term id="26893">call stack</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1297305">tindanan panggilan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11946_530764_2207444"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A lock on a single row in a table.</descrip></descripGrp><ntig><termGrp><term id="530764">row lock</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2207444">kunci baris</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11947_65138_443671"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In an environment capable of displaying multiple on-screen windows, any window other than the one currently being used for work. An inactive window can be partially or entirely hidden behind another window, and it remains inactive until the user selects it.</descrip></descripGrp><ntig><termGrp><term id="65138">inactive window</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="443671">tetingkap tak aktif</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11952_251784_1297306"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of generally sequential project phases whose name and number are determined by the needs of the organization or organizations involved in the project.</descrip></descripGrp><ntig><termGrp><term id="251784">project life cycle</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1297306">kitar hayat projek</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11960_237207_1297307"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of system performance counters that are useful to monitor during a load test. Counter sets are organized by technology, for example, ASP.NET or SQL counter sets.</descrip></descripGrp><ntig><termGrp><term id="237207">counter set</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1297307">set pembilang</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11961_180264_1677929"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A trust relationship between two or more SIP domains that permits users in separate organizations to communicate in real time across network boundaries.</descrip></descripGrp><ntig><termGrp><term id="180264">federation</term><termNote type="partOfSpeech">Noun</termNote><t