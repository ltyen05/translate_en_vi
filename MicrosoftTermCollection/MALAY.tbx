l:lang="en-US"><descripGrp><descrip type="definition">The secret half of a cryptographic key pair that is used with a public key algorithm. Private keys are typically used to decrypt a symmetric session key, digitally sign data, or decrypt data that has been encrypted with the corresponding public key.</descrip></descripGrp><ntig><termGrp><term id="94981">private key</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2716560">kekunci persendirian</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13734_187111_1298181"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A window in Visual Studio Class Designer that you can use to configure the members of a type. By default, the Class Details Window appears automatically when you open a new class diagram.</descrip></descripGrp><ntig><termGrp><term id="187111">Class Details Window</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1298181">Tetingkap Butiran Kelas</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13737_530771_2209504"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A dimension created within a database that can be used by any cube in the database.</descrip></descripGrp><ntig><termGrp><term id="530771">shared dimension</term><termNote type="partOfSpeech">Noun</termNote><