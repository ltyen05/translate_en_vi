Number">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24569_1135487_1173518"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The desktop email program that lets users manage multiple email accounts, newsgroups, and feeds in one place.</descrip></descripGrp><ntig><termGrp><term id="1135487">Windows Live Mail</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1173518">Windows Live Mail</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2457_180884_2180053"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In a database mirroring session, a failover initiated by the database owner upon the failure of the principal server that transfers service to the mirror database while it is in an unknown state. Data may be lost.</descrip></descripGrp><ntig><termGrp><term id="180884">forced service</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2180053">perkhidmatan paksa</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24575_1136131_1710523"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A quick, straight stroke of a finger or pen on a screen. A flick is recognized as a gesture, and interpreted as a navigation or an editing command.</descrip></descripGrp><ntig><termGrp><term id="1136131">flick</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1710523">kuis</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24578_1136137_1679515"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An XML file that contains sets of descriptions of one or more external content types, their related external data sources, and information that is specific to the environment, such as authentication properties.</descrip></descripGrp><ntig><termGrp><term id="1136137">application model</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1679515">Model BDC</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24578_1167122_1679515"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An XML file that contains sets of descriptions of one or more external content types, their related external data sources, and information that is specific to the environment, such as authentication properties.</descrip></descripGrp><ntig><termGrp><term id="1167122">BDC model</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1679515">Model BDC</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="gramma