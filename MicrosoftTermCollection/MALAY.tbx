Note><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2601_1177403_2121500"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The representation of all the instances of a particular record. When changes are made to a record type, those changes will affect all individual records of that type.</descrip></descripGrp><ntig><termGrp><term id="1177403">entity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2121500">entiti</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2601_1177403_2121679"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The representation of all the instances of a particular record. When changes are made to a record type, those changes will affect all individual records of that type.</descrip></descripGrp><ntig><termGrp><term id="1177403">entity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2121679">jenis rekod</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2601_182730_2121500"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The representation of all the instances of a particular record. When changes are made to a record type, those changes will affect all individual records of that type.</descrip></descripGrp><ntig><termGrp><term id="182730"