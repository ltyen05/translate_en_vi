l:lang="en-US"><descripGrp><descrip type="definition">The MyAnalytics tab that gives users options for planning time for specific tasks, shows information on quiet days, and that suggests ways to reduce stress.</descrip></descripGrp><ntig><termGrp><term id="2747242">Focus and Wellbeing</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2749370">Fokus dan Kesejahteraan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48569_2747247_2749369"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A queue of callers who will be automatically distributed according to the organization’s customized rules.</descrip></descripGrp><ntig><termGrp><term id="2747247">call queue</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2749369">baris gilir panggilan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4857_64223_1987835"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file system that is accessed through a file system driver (FSD) that is loaded onto a device by the user, rather than accessed by the built-in file system. An installable file system may be implemented differently from the built-in file system. For example, an installable file system may prevent a user from deleting files, provide automatic compression of files, or use a structure for internal information different from that used by the built-in file system.</descrip></descripGrp><ntig><termGrp><term id="64223">IFS</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1987835">IFS</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4857_64224_1987835"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file system that is accessed through a file system driver (FSD) that is loaded onto a device by the user, rather than accessed by the built-in file system. An installable file system may be implemented differently from the built-in file system. For example, an installable file system may prevent a user from deleting files, provide automatic compression of files, or use a structure for internal information different from that used by the built-in file system.</descrip></descripGrp><ntig><termGrp><term id="64224">installable file system</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1987835">IFS</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48570_2747249_2749367"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A policy that prevents access of information by certain individuals.</descrip></descripGrp><ntig><termGrp><term id="2747249">access restriction</term><termNote type="partOfSpeech">Noun</termNote><termNote ty