langSet xml:lang="en-US"><descripGrp><descrip type="definition">A form of assistance in which a program that provides on-screen help shows information to the user concerning the current command or operation being attempted.</descrip></descripGrp><ntig><termGrp><term id="38946">context-sensitive Help</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="443475">Bantuan peka konteks</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12895_395654_1677887"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows a user to display his or her desktop to a meeting or to conversation participants.</descrip></descripGrp><ntig><termGrp><term id="395654">desktop sharing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1677887">perkongsian desktop</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12897_121594_2674409"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of identification data for a security principle, issued by a domain controller for purposes of user authentication.</descrip></descripGrp><ntig><termGrp><term id="121594">ticket</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2674409">tiket</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12898_416290_1298140"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A defined requirement that is checked against a product and yields either a pass or a fail result. Pass indicates meeting the requirement and fail indicates not meeting the requirement.</descrip></descripGrp><ntig><termGrp><term id="416290">test script</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1298140">skrip ujian</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="129_210230_2121369"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A field in the contract line dialog where the user enters the number of allotments remaining.</descrip></descripGrp><ntig><termGrp><term id="210230">Allotments Remaining</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2121369">Baki Peruntukan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1290_45650_2739973"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A character that represents number in a numbering system.</descrip></descripGrp><ntig><termGrp><term id="45650">digit</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2739973">digit</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12900_537108_1298141"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The state of a Web Parts page that determines the range of users to which personalization changes apply. The WebPartManager control determines the personalization scope for a Web Parts page. The PersonalizationScope enumeration provides two possible scopes (Shared and User) that a page can be in at any given time. In shared scope, personalization changes made to shared controls apply to all users. In user scope, personalization changes made to shared and per-user controls apply only to the specific user.</descrip></descripGrp><ntig><termGrp><term id="537108">personalization scope</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1298141">skop pemeribadian</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12902_257534_2214196"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file containing records of activities of a specified object, such as an application, operating system, or network. A trace file can include calls made to APIs, the activities of APIs, the activities of communication links and internal flows, and other information.</descrip></descripGrp><ntig><termGrp><term id="257534">trace file</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2214196">fail jejak</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12905_232396_444429"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A list of domain names and email addresses that are treated as junk email and are blocked unless the sender is on the Safe Senders List or the recipient is on the Safe Recipients List.</descrip></descripGrp><ntig><termGrp><term id="232396">Blocked Senders List</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="444429">Senarai Penghantar yang Disekat</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1291_187291_1294486"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The designer used to create and manage Deployment Diagrams.</descrip></descripGrp><ntig><termGrp><term id="187291">Deployment Designer</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1294486">Pereka Pengerahan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12919_113429_408782"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A device or part of a device that receives something from another device.</descrip></descripGrp><ntig><termGrp><term id="113429">sink</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="408782">lubuk</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12923_397158_408783"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of Microsoft Management Console (MMC) snap-ins that Microsoft Exchange provides.</descrip></descripGrp><ntig><termGrp><term id="397158">Exchange System Manager</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="408783">Pengurus Sistem Exchange</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12931_102439_2199746"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The action of logging in to a computer at a distant location by means of a data communications connection with the computer that one is presently using. After remote login, the user's own computer behaves like a terminal connected to the remote system. On the Internet, remote login is done primarily by rlogin and telnet.</descrip></descripGrp><ntig><termGrp><term id=