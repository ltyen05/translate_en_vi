_34277_408845"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An object that contains a set of related objects.</descrip></descripGrp><ntig><termGrp><term id="34277">collection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="408845">koleksi</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6679_147537_2456766"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Rules that you follow to preserve the defined relationships between tables when you enter or delete records.</descrip></descripGrp><ntig><termGrp><term id="147537">referential integrity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2456766">integriti rujukan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="668_237182_1294460"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A part of the internal release cycle. It is the process of adding features, creating test cases for each, stabilizing each feature before building new features, and then releasing for evaluation.</descrip></descripGrp><ntig><termGrp><term id="237182">build cycle</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1294460">kitaran pembinaan</term><termNote type="geographica