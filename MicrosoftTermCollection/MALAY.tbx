rm id="187159">column ordinal</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1295471">ordinal lajur</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7626_130406_1678138"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A telephone call where the human voice, rather than data or video, is transmitted (that is, an ordinary telephone call).</descrip></descripGrp><ntig><termGrp><term id="130406">voice call</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1678138">panggilan suara</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7627_277360_2121699"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A segment of an organization's market. Sales territories are often defined by geographical location, such as Northwest territory and Southeast territory.</descrip></descripGrp><ntig><termGrp><term id="277360">sales territory</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2121699">wilayah jualan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7630_187506_1295472"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The phases a solution goes through from the time it is conceived until the time it is retired from service.</descrip></descripGrp><ntig><termGrp><term id="187506">life cycle</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1295472">kitar hayat</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7631_134267_444080"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In a spreadsheet program, a file containing a number of related worksheets.</descrip></descripGrp><ntig><termGrp><term id="134267">workbook</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="444080">buku kerja</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7638_398504_2817860"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A stored record of the audio and video components of a meeting or session.</descrip></descripGrp><ntig><termGrp><term id="398504">recording</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2817860">rakaman</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</te