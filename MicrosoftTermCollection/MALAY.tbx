ch">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51296_2890797_2891265"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A measure ranging from 0 to 1 that indicates how similar two values are.</descrip></descripGrp><ntig><termGrp><term id="2890797">similarity score</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2891265">markah keserupaan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51297_2890887_2935875"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The browser created for WinAutomation process to deliver the most accurate automation scheme based on user's web interaction history.</descrip></descripGrp><ntig><termGrp><term id="2890887">Automation Browser</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2935875">Pelayar Automasi</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51298_2890888_2935880"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A capability for inspecting a text aiming at identifying the prevalent emotional opinion within the text, especially to determine if the writer's attitude is positive, negative, or neutral.</descrip></descripGrp><ntig><termGrp