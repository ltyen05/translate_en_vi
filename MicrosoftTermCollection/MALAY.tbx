2739">Project Plan 3</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2828204">Project Pelan 3</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49908_2822742_2828205"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The subscription-based offering of Microsoft Project that includes the features in Project Plan 1 and Project Plan 3 plus some features for managing enterprise-wide resources.</descrip></descripGrp><ntig><termGrp><term id="2822742">Project Plan 5</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2828205">Project Pelan 5</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49909_2822865_2828206"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Visio online subscription-based offering for creating and sharing simple diagrams in a browser. Includes Visio web app and 2 GB OneDrive storage.</descrip></descripGrp><ntig><termGrp><term id="2822865">Visio Plan 1</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2828206">Visio Pelan 1</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotS