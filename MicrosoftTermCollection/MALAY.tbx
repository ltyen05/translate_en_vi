="definition">A protocol that enables an Internet user to log on to and enter commands on a remote computer linked to the Internet, as if the user were using a text-based terminal directly attached to that computer. Telnet is part of the TCP/IP suite of protocols.</descrip></descripGrp><ntig><termGrp><term id="120447">Telnet</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1096539">Telnet</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28286_1479033_1641282"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The public multinational corporation that develops, manufactures, licenses, and supports a wide range of products and services predominantly related to computing.</descrip></descripGrp><ntig><termGrp><term id="1479033">Microsoft</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1641282">Microsoft</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28286_1479033_1641286"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The public multinational corporation that develops, manufactures, licenses, and supports a wide range of products and services predominantly related to computing.</descrip></descripGrp><ntig><termGrp><term id="1479033">Microsoft</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">