p></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2814521">ambang padanan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45800_2579491_2814522"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A unique identifier of the user who owns the Azure instance.</descrip></descripGrp><ntig><termGrp><term id="2579491">owning user</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2814522">pengguna pemilikan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45801_2579492_2814523"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A forecast of a value from a machine learning model.</descrip></descripGrp><ntig><termGrp><term id="2579492">prediction</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2814523">ramalan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45802_2579493_2814524"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An attribute of a profile taken into account when generating predictions.</descrip></descripGrp><ntig><termGrp><term id="2579493">predictive grade</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2814524">gred ramalan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45803_2579494_2814525"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A match made from a combination of data from multiple sources. Data coming from various sources often uses different fields to uniquely identify records and contains different values.</descrip></descripGrp><ntig><termGrp><term id="2579494">predictive match</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2814525">padanan ramalan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45804_2579495_2814526"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of rules defined by the user to obtain a list of potentially matching entities, of either profiles or interactions.</descrip></descripGrp><ntig><termGrp><term id="2579495">predictive match policy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2814526">dasar padanan ramalan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45805_2579496_2814527"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A scoring model based on machine learning analysis to enable business users of all skill levels to apply artificial intelligence to predict a range of business outcomes with regards to lead qualification.</descrip></descripGrp><ntig><termGrp><term id="2579496">predictive scoring model</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2814527">model pemarkahan ramalan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45806_2579498_2814528"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A characteristic of a profile that has a name and a value associated with it and describes it in a particular context.</descrip></descripGrp><ntig><termGrp><term id="2579498">property</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2814528">sifat</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45807_2579499_2814529"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A property that represents the status of the provisioning operation on the resource.</descrip></descripGrp><ntig><termGrp><term id="2579499">provisioning state</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2814529">keadaan per