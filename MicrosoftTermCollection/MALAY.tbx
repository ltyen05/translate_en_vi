calNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26033_1260272_1365538"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Silverlight, a technology that enables users to interactively view high-resolution images. With Deep Zoom, users can zoom in, zoom out, and pan images rapidly.</descrip></descripGrp><ntig><termGrp><term id="1260272">Deep Zoom</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1365538">Zum Mendalam</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26034_1260273_1365548"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Silverlight, an out-of-browser application to which a user grants elevated trust upon installation, providing greater access to the local system.</descrip></descripGrp><ntig><termGrp><term id="1260273">trusted application</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1365548">aplikasi yang dipercayai</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26035_1260274_1365547"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Silverlight, an in-browser application or an out-of-browser application that has not been granted elevated trust.</descrip></descripGrp><ntig><termGrp><term id="1260274">sandboxed application</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1365547">aplikasi dalam sandbox</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26036_1260275_1365540"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Silverlight, a security level that gives out-of-browser applications greater access to the local system.</descrip></descripGrp><ntig><termGrp><term id="1260275">elevated trust</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1365540">kepercayaan ditinggikan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2604_530737_2199692"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A hierarchy of data in which all parent-child relationships are represented in the data.</descrip></descripGrp><ntig><termGrp><term id="530737">recursive hierarchy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2199692">hierarki rekursif</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26040_1261181_2743923"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The running operation or execution of logic for the computing resources that your application runs on.</descrip></descripGrp><ntig><termGrp><term id="1261181">compute</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2743923">pengiraan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2605_97407_2732212"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The proposed Internet protocol in which an authentication server provides authorization and authentication information to a network server to which a user is attempting to link.</descrip></descripGrp><ntig><termGrp><term id="97407">RADIUS</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2732212">RADIUS</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2605_97408_2732212"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The proposed Internet protocol in which an authentication server provides authorization and authentication information to a network server to which a user is attempting to link.</descrip></descripGrp><ntig><termGrp><term id="97408">Remote Authentication Dial-In User Service</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml: