ammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34436_1991546_2920429"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of device worn during exercise that estimates your exercise stats based on your level of physical activity.</descrip></descripGrp><ntig><termGrp><term id="1991546">fitness tracking device</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2920429">peranti penjejakan kecergasan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34437_1991547_2920916"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A legal notice that describes the properties of the system.</descrip></descripGrp><ntig><termGrp><term id="1991547">system information</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2920916">maklumat sistem</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34438_1991548_2216566"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A legal notice that establishes the terms under which service is provided.</descrip></descripGrp><ntig><termGrp><term id="1991548">terms of use</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2216566">terma penggunaan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34439_1991549_2920906"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A message that applications must display when unable to establish a connection to a required non-Xbox Live server or web service.</descrip></descripGrp><ntig><termGrp><term id="1991549">Sorry, [video service name/web service name] isn't available right now. Please try again later. For more information, go to www.xbox.com/status.</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2920906">Maaf, [nama perkhidmatan video/nama perkhidmatan web] tidak tersedia sekarang. Sila cuba lagi kemudian. Untuk mendapatkan maklumat lanjut, lawati www.xbox.com/status.</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3444_14266_443287"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To move selected items to another location for long term storage.</descrip></descripGrp><ntig><termGrp><term id="14266">archive</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="443287">arkib</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34440_1991550_2920922"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A message that applications must display when Xbox privacy and online settings prevent the sharing of video status.</descrip></descripGrp><ntig><termGrp><term id="1991550">The Video and Music Status setting for [gamertag1, gamertag2, gamertag3, gamertags4] is set to allow apps to show titles of videos you watch in your Xbox Live online status.</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2920922">Seting Status Video dan Muzik untuk [tagpemain1, tagpemain2, tagpemain3, tagpemain40 disetkan kepada membenarkan aplikasi menunjukkan tajuk video yang anda tonton dalam status dalam talian Xbox Live anda.</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34441_1991551_2917237"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A message that applications must display if they will serve third-party advertising and cannot contractually guarantee that they will meet the Xbox Creative Acceptance Policy (CAP) for advertising content. The need for this disclaimer will be determined contractually prior to certification, and the inability to comply should be indicated during application submission. Talk to your Developer Account Manager for additional details.</descrip></descripGrp><ntig><termGrp><term id="1991551">All content in this Application, including advertising content, is provided by [video service name].</term><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2917237">Semua kandungan dalam Aplikasi ini, termasuk kandungan pengiklanan, disediakan oleh [nama perkhidmatan video].</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34442_1991552_2920919"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A message that game titles must display when unable to establish a connection to a required non-Xbox Live server or web service. This message also applies to Xbox games on Windows Phone.</descrip></descripGrp><ntig><termGrp><term id="1991552">The [game name] service is not available. Please try again later.</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2920919">Perkhidmatan [nama permainan] tidak tersedia sekarang. Sila cuba lagi kemudian.</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34443_1991553_2921805"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Xbox Live Arcade menu item.</descrip></descripGrp><ntig><termGrp><term id="1991553">leaderboards</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2921805">papan pendahulu</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34444_1991554_2921801"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Xbox Live Arcade menu item.</descrip></descripGrp><ntig><termGrp><term id="1991554">achievements</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2921801">pencapaian</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34445_1991555_2920555"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Xbox Live Arcade menu item.</descrip></descripGrp><ntig><termGrp><term id="1991555">help &amp; options</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2920555">bantuan &amp; pilihan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34446_1991556_2920933"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Xbox Live Arcade menu item.</descrip></descripGrp><ntig><termGrp><term id="1991556">unlock full game</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2920933">buka kunci versi penuh permainan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><term