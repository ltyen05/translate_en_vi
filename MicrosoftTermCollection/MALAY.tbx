30"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A numeric calculation used in data analysis. Examples that are commonly found in business reports include sums, averages, minimum or maximum values, counts, or more advanced calculations that you create using a DAX formula.</descrip></descripGrp><ntig><termGrp><term id="535216">measure</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2189630">ukuran</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7124_534979_2177255"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process used by SQL Server to determine the most cost-effective locks to use at any one time.</descrip></descripGrp><ntig><termGrp><term id="534979">dynamic locking</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2177255">penguncian dinamik</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7128_187299_1295449"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file that describes the deployment settings of a solution and identifies the current application version.</descrip></descripGrp><ntig><termGrp><term id="187299">deployment manifest</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><ter