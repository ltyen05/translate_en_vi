ig><termGrp><term id="1707461">stylistic set</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1915637">set stilistik</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32865_1707533_2002276"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The customer-facing term for an update of Office 365. Internally, we recognize this as an update from one version to another (e.g. from wave 14 to wave 15). Externally, we do not use the term "version" for a service update.</descrip></descripGrp><ntig><termGrp><term id="1707533">Office 365 service update</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2002276">kemas kini perkhidmatan Office 365</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32867_1707634_1722244"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The operating system designed for enthusiasts and business/technical pros that includes all of the features in Windows 8, plus features for encryption, virtualization, PC management, and domain connectivity.</descrip></descripGrp><ntig><termGrp><term id="1707634">Windows 8 Pro</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1722244">Windows 8 Pro</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32868_1707637_1722240"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The operating system for PCs and tablets powered by x86 (32-bit) and AMD (64-bit) processors that includes an updated Windows Explorer, Task Manager, better multi-monitor support, and fast language switching.</descrip></descripGrp><ntig><termGrp><term id="1707637">Windows 8</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1722240">Windows 8</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32869_1707640_1722249"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The operating system only available pre-installed on PCs and tablets powered by ARM processors that helps enable new thin and lightweight form factors with impressive battery life. Windows RT includes touch-optimized versions of Microsoft Word, Excel, PowerPoint, and OneNote.</descrip></descripGrp><ntig><termGrp><term id="1707640">Windows RT</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1722249">Windows RT</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></nti