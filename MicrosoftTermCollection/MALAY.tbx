rp><descrip type="definition">A style sheet defined in a user control in an .ascx file.</descrip></descripGrp><ntig><termGrp><term id="537293">external style sheet</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1294598">helaian gaya luaran</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36868_2093283_2105593"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A component in Exchange 2013 that performs background tasks, such as mailbox database maintenance, mailbox processing, inference training, calendar repair, offline address book generation, and more.</descrip></descripGrp><ntig><termGrp><term id="2093283">Time-Based Assistant</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2105593">Pembantu Berasaskan Masa</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36869_2093284_2105597"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A component in Exchange 2013 that performs background tasks, such as mailbox database maintenance, mailbox processing, inference training, calendar repair, offline address book generation, and more.</descrip></descripGrp><ntig><termGrp><term id="2093284">Time-Based Assistant</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2105597">Pembantu Berasaskan Masa</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3687_187920_1294599"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A component of SQL Server that is responsible for managing the raw physical data in your database. For example, reading and writing the data to disk is a task handled by the storage engine.</descrip></descripGrp><ntig><termGrp><term id="187920">storage engine</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1294599">enjin storan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36870_2093285_2105587"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A time-based assistant (TBA) that parses emails and makes internal inferences based on them. Inferences are used to allow the system to gain insight into a user’s mailbox based on user patterns. Those inferences are then used to populate features for users, such as People View in Outlook Web App.</descrip></descripGrp><ntig><termGrp><term id="2093285">inference training</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2105587">latihan inferens</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36871_2093286_2105590"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A component that feeds data (such as mailbox messages) to the inference training assistant in batches. It controls performance by giving the inference training assistant a fixed amount of work to process at each interval.</descrip></descripGrp><ntig><termGrp><term id="2093286">inference training feeder</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2105590">penyuap latihan inferens</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36872_2093287_2105594"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature of OneNote for Android that allows you to create notes, audio notes, and picture notes right from your phone’s home screen.</descrip></descripGrp><ntig><termGrp><term id="2093287">widget</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2105594">widget</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36873_2093298_2105595"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A contextual tab on the Ribbon that enables the user to modify the appearance, size, and other aspects of the container controls in a form.</descrip></descripGrp><ntig><termGrp><term id="2093298">Control Tools</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2105595">Alat Kawalan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36876_2095267_2171217"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A software component designed to enable application developers to extend the directory and develop richer applications without worrying about the limitations imposed by an external store.</descrip></descripGrp><ntig><termGrp><term id="2095267">Directory Extension</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2171217">Sambungan direktori</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36877_2095268_2171199"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature to prevent the directory from unwanted deletions.</descrip></descripGrp><ntig><termGrp><term id="2095268">Accidental Deletion Protection</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2171199">Perlindungan Pemadaman Tidak Sengaja</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalG