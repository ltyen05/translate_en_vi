rmNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2927807">carian nombor balikan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25064_1167283_1944633"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A voice message that's played to callers to let them know that the person they called is away for an extended period of time and unavailable to answer the phone. It can be customized by the user. It's different from the voice mail greeting that's played when the recipient is away for a short period of time.</descrip></descripGrp><ntig><termGrp><term id="1167283">away greeting</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1944633">sapaan berpergian</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25075_1167334_2174224"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A map that displays a marker at each location (for example, cities) and varies marker color, size, and type.</descrip></descripGrp><ntig><termGrp><term id="1167334">marker map</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2174224">peta penanda asas</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote