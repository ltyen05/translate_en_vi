987817">rekod alamat</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19804_686248_1987817"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of resource record in the Domain Name System that associates a specific IP address with a domain name. This is the record that contains the information that connects your domain name to your actual Web site content when people type your domain name into a browser.</descrip></descripGrp><ntig><termGrp><term id="686248">address record</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1987817">rekod alamat</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19806_2908028_1944679"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of resource record in the Domain Name System that associates a computer's true (canonical) name with any alias names also used by the computer. Some domain registrars use CNAME records to redirect or redelegate domain names.</descrip></descripGrp><ntig><termGrp><term id="2908028">CNAME</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1944679">rekod CNAME</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19806_686253_1944679"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of resource record in the Domain Name System that associates a computer's true (canonical) name with any alias names also used by the computer. Some domain registrars use CNAME records to redirect or redelegate domain names.</descrip></descripGrp><ntig><termGrp><term id="686253">canonical name record</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1944679">rekod CNAME</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19806_686254_1944679"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of resource record in the Domain Name System that associates a computer's true (canonical) name with any alias names also used by the computer. Some domain registrars use CNAME records to redirect or redelegate domain names.</descrip></descripGrp><ntig><termGrp><term id="686254">CNAME record</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1944679">rekod CNAME</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19810_686305_1944835"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The owner of the customer relationship with customers who buy second-level domains. There may be many registrars for a single top-level domain. Registrars maintain detailed customer information in their databases, such as the customer's contact address, telephone number, and email address. Customers usually manage their second-level domains at the registrar's Web site, and the registrar updates the registry database when necessary (for example, when a customer renews a domain name).</descrip></descripGrp><ntig><termGrp><term id="686305">domain name registrar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1944835">pendaftar nama domain</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1982_64018_2183060"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">One of two international standards bodies responsible for developing international data communications standards. The International Electrotechnical Commission (IEC) works closely with the International Organization for Standardization (ISO) to define standards of computing. They jointly published the ISO/IEC SQL-92 standard for SQL.</descrip></descripGrp><ntig><termGrp><term id="64018">IEC</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2183060">IEC</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1982_64018_2185990"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">One of two international standards bodies responsible for developing international data communications standards. The International Electrotechnical Commission (IEC) works closely with the International Organization for Standardization (ISO) to define standards of computing. They jointly published the ISO/IEC SQL-92 standard for SQL.</descrip></descripGrp><ntig><termGrp><term id="64018">IEC</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2185990">Suruhanjaya Elektroteknik Antarabangsa</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1982_64019_2183060"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">One of two international standards bodies responsible for developing international data communications standards. The International Electrotechnical Commission (IEC) works closely with the International Organization for Standardization (ISO) to define standards of computing. They jointly published the ISO/IEC SQL-92 standard for SQL.</descrip></descripGrp><ntig><termGrp><term id="64019">International Electrotechnical Commission</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2183060">IEC</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1982_64019_2185990"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">One of two international standards bodies responsible for developing international data communications standards. The International Electrotechnical Commission (IEC) works closely with the International Organization for Standardization (ISO) to define standards of computing. They jointly published the ISO/IEC SQL-92 standard for SQL.</descrip></descripGrp><ntig><termGrp><term id="64019">International Electrotechnical Commission</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2185990">Suruhanjaya Elektroteknik Antarabangsa</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19828_686821_1944930"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of resource record in the Domain Name System (DNS) specifying how Internet email should be routed using the Simple Mail Transfer Protocol (SMTP). Each MX record contains a preference and a host name, so that the collection of MX records for a given domain name point to the servers that should receive email for that domain, and their priority relative to each other.</descrip></descripGrp><ntig><termGrp><term id="686821">mail exchange record</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1944930">rekod MX</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19828_686822_1944930"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of resource record in the Domain Name System (DNS) specifying how Internet email should be routed using the Simple Mail Transfer Protocol (SMTP). Each MX record contains a preference and a host name, so that the collection of MX records for a given domain name point to the servers that should receive email for that domain, and their priority relative to each other.</descrip></descripGrp><ntig><termGrp><term id="686822">MX record</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1944930">rekod MX</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19842_687165_1301295"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A computer program that enables users to adjust a photo to improve its appearance.</descrip></descripGrp><ntig><termGrp><term id="687165">image editor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1301295">editor imej</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19849_688741_1319592"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The sensing component in the camera that was used to capture the image.</descrip></descripGrp><ntig><termGrp><term id="688741">Sensing</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="13