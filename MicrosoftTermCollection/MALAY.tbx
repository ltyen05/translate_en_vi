ermEntry id="55154_3126502_3127406"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The security solution designed to safeguard end-to-end communication and collaboration for organizations using Microsoft tools like Teams and Outlook.</descrip></descripGrp><ntig><termGrp><term id="3126502">Defender for Collaboration</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="3127406">Defender for Collaboration</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55154_3126502_3127407"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The security solution designed to safeguard end-to-end communication and collaboration for organizations using Microsoft tools like Teams and Outlook.</descrip></descripGrp><ntig><termGrp><term id="3126502">Defender for Collaboration</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="3127407">Microsoft Defender for Collaboration</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55155_3126610_3126970"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An AI-powered model used in Dynamics 365 Marketing that provides users with a feedback loop to gain a comprehensive view of the effectiveness of their real-time marketing tactics in driving key business outcomes, empowering them to optimize their marketing mix by learning from tactics that worked well and improving or dropping tactics that didn’t.</descrip></descripGrp><ntig><termGrp><term id="3126610">attribution model</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="3126970">model atribusi</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55156_3126611_3126972"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A hub to manage consent and compliance in Dynamics 365 Marketing. Compliance profiles govern how consent is captured and enforced, as well as store information such as company address, the preference management experience, and related configuration.</descrip></descripGrp><ntig><termGrp><term id="3126611">compliance profile</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="3126972">profil pematuhan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55157_3126612_3126973"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in Dynamics 365 Marketing that helps users analyze event data through a broad overview of the event planning activities and results from all their events, and event records for one event to see results and analytics that relate to that event only.</descrip></descripGrp><ntig><termGrp><term id="3126612">event analytics</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="3126973">analitis peristiwa</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55158_3126613_3126974"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that lets users set a limit on the number of messages their customers receive in a given amount of time through a particular channel in real-time marketing journeys.</descrip></descripGrp><ntig><termGrp><term id="3126613">frequency cap</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="3126974">had kekerapan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55159_3126614_3126975"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A template available in Dynamics 365 Marketing to quickly create a new customer journey or reuse an existing customer journey structure as a starting point for future campaigns.</descrip></descripGrp><ntig><termGrp><term id="3126614">journey template</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="3126975">templat perjalanan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5516_103458_1096491"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A keyboard character that has a special meaning to a program and, as a result, normally cannot be used in assigning names to files, documents, and other user-generated tools, such as macros. Characters commonly reserved for special uses include the asterisk (*), forward slash (/), backslash (\), question mark (?), and vertical bar (|).</descrip></descripGrp><ntig><termGrp><term id="103458">reserved character</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1096491">aksara simpanan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55160_3126615_3126976"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The dashboard in Dynamics 365 Marketing that allows users to define key customer milestones, measure them over time, and assess the contribution and effectiveness of their journeys, channels, and marketing assets in driving customers to the milestones.</descrip></descripGrp><ntig><termGrp><term id="3126615">marketing effectiveness</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="3126976">keberkesanan pemasaran</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55161_3126616_3126977"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An inbound communication channel that allows your customers to register for newsletters, ask for quotations, etc. The form is defined by a set of input fields arranged into a form layout.</descrip></descripGrp><ntig><termGrp><term id="3126616">marketing form</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="3126977">borang pemasaran</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55162_3126617_3126978"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A center in real-time marketing that allows users to provide customers with branded experiences to sign up for communications and fine-tune their preferences to ensure they receive the right communications.</descrip></descripGrp><ntig><termGrp><term id="3126617">preference center</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="3126978">pusat keutamaan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55163_3126618_3126979"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An item that is visibly present at the event, and features a sponsor's logo or message. These typically include small freebies given away to event attendees, but could also be some type of infrastructure or facility provided to event-goers.</descrip></descripGrp><ntig><termGrp><term id="3126618">sponsorable article</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="3126979">item tajaan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55164_3126700_3127434"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The dedicated Microsoft Edge experience built for work that enables admins in organizations to give their users a productive and secure work browser across managed and unmanaged devices.</descrip></descripGrp><ntig><termGrp><term id="3126700">Microsoft Edge for Business</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="3127434">Microsoft Edge for Business</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55165_3126701_3127440"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The directory service that provides authentication, authorization, and password management for Microsoft Windows networks.</descrip></descripGrp><ntig><termGrp><term id="3126701">Microsoft Entra Domain Services</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="3127440">Khidmat Domain</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNo