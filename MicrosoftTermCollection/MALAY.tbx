m id="3090777">water data model</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="3090841">model data air</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54102_3090778_3090802"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Emission of gases, mainly carbon dioxide from the combustion of fossil fuels: coal, oil and natural gas, that contribute to the greenhouse effect and, consequently, to the climate change of our planet.</descrip></descripGrp><ntig><termGrp><term id="3090778">GHG emission</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="3090802">Pengeluaran GHG</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54104_3085781_3086460"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Dynamics 365 Sales feature powered by an AI model that scans your emails and meetings in Outlook and finds items that might be related to your work in Dynamics 365. Activity suggestions can be synced and connected to contacts, accounts, leads, or opportunities.</descrip></descripGrp><ntig><termGrp><term id="3085781">activity suggestion</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="3086460">cadangan aktiviti</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54105_3085782_3086461"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An AI-generated summary of a customer conversation.</descrip></descripGrp><ntig><termGrp><term id="3085782">AI summary</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="3086461">ringkasan AI</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54106_3085783_3086462"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A rule created and activated for leads and opportunities by defining conditions to automatically assign records to sellers when the defined conditions are met in Dynamics 365 Sales.</descrip></descripGrp><ntig><termGrp><term id="3085783">assignment rule</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="3086462">peraturan penugasan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54107_3085784_3086463"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Conversation Intelligence insight that shows the keywords that the top sellers use more frequently in conversations with customers. By analyzing this insight, you can understand what words the top sellers use that help them to close deals and generate revenue.</descrip></descripGrp><ntig><termGrp><term id="3085784">Best practice keywords</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="3086463">Kata kunci amalan terbaik</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54108_3085785_3086464"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Dynamics 365 Sales page that provides a high-level view of how the conversation with a customer went, and includes action items and relevant keywords, a timeline, a transcript of the call, and more.</descrip></descripGrp><ntig><termGrp><term id="3085785">call summary</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="3086464">ringkasan panggilan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54109_3085786_3086465"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Dynamics 365 Sales capability that enables the suggested contacts to be displayed in Teams when a seller starts a new connected chat. It helps the sellers to quickly find the right coworkers to collaborate with.</descrip></descripGrp><ntig><termGrp><term id="3085786">contact suggestion</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="3086465">cadangan hubungan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54110_3085787_3086466"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The capability of Sales Accelerator that uses the AI-based model that flags duplicate leads based on standard rules. Sellers can choose to merge duplicate leads to the primary record or delete the duplicate leads ensuring the sellers always have the right leads with the right information.</descrip></descripGrp><ntig><termGrp><term id="3085787">Data Hygiene</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="3086466">Peningkatan Data</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54111_3085788_3086467"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The dedicated workspace in Dynamics 365 Sales for sellers to efficiently manage their sales pipeline. As a seller, you can personalize the workspace for your needs.</descrip></descripGrp><ntig><termGrp><term id="3085788">deal manager</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="3086467">pengurus tawaran</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54112_3085789_3086468"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A ratio of the number of emails sent and received in a given opportunity, to the average sent and received ratio in all similar won deals.</descrip></descripGrp><ntig><termGrp><term id="3085789">email send/receive ratio</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="3086468">nisbah terima/hantar e-mel</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54113_3085790_3086469"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A model that analyzes patterns in historical data that users provide and learns to associate those patterns with outcomes. Then, it uses the power of AI to detect learned patterns in new data, and use them to predict future outcomes.</descrip></descripGrp><ntig><termGrp><term id="3085790">prediction model</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="3086469">model ramalan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54114_3085791_3086470"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows sellers to record calls by using the Teams dialer and get the most out of every call with advanced conversation intelligence capabilities such as AI-powered insights, rich call summaries, and more.</descrip></descripGrp><ntig><termGrp><term id="3085791">real-time transcription and insights</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="3086470">transkripsi dan cerapan masa nyata</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54115_3085792_3086471"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A data point that is associated with a lower than average probability of converting the lead into an opportunity.</descrip></descripGrp><ntig><termGrp><term id="3085792">score harmer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="3086471">perosak skor</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54116_3085793_3086472"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A data point that is associated with a higher than average probability of converting the lead into an opportunity.</descrip></descripGrp><ntig><termGrp><term id="3085793">score improver</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="3086472">penambah baik skor</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type