angSet><langSet xml:lang="ms"><ntig><termGrp><term id="1944598">ADMA</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25957_1245017_1984395"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Identity Lifecycle Manager management agent provided by Microsoft to connect to Active Directory Domain Services (AD DS) or Active Directory directory service.</descrip></descripGrp><ntig><termGrp><term id="1245017">ADMA</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1984395">Ejen Pengurusan Active Directory</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25958_1245019_2207523"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A deployment model in which an installation configuration has multiple report server instances sharing a single report server database.</descrip></descripGrp><ntig><termGrp><term id="1245019">scale-out deployment</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2207523">pelaksanaan berskala</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25959_1247422_1945294"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mailbox folder structure on some IMAP servers in which mail folders are accessed with the administrator username and password, and shell login access to the mail server is not allowed. Access to specific mailboxes is managed by access control lists. This means that users are assigned the permissions to only access their mailbox folder, while an administrator has access to all mailboxes. This allows organizations to use administrative credentials to migrate email from an IMAP server to Outlook Live.</descrip></descripGrp><ntig><termGrp><term id="1247422">virtual shared folder</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1945294">folder kongsi maya</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2596_335540_2767362"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To provide your name and contact information to an organization so that you can receive product information, updates, and special offers.</descrip></descripGrp><ntig><termGrp><term id="335540">register</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2767362">daftar</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25961_1248981_1275390"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Photo Gallery feature that replaces a section of one photo with a similar section of another, providing there are areas of overlap in both. For example, if someone has two photos of a group of people, and in Photo 1 everyone is smiling but one person has their eyes closed, they can include the section of Photo 2 where that person has their eyes open.</descrip></descripGrp><ntig><termGrp><term id="1248981">Photo Fuse</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1275390">Gabungan foto</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25963_1250378_2121593"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The desktop client version of the Microsoft Dynamics CRM product suite for Microsoft Office Outlook.</descrip></descripGrp><ntig><termGrp><term id="1250378">Microsoft Dynamics CRM for Microsoft Office Outlook</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2121593">Microsoft Dynamics CRM untuk Microsoft Office Outlook</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25965_1250380_2121594"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The laptop client version of the Microsoft Dynamics CRM product suite for Microsoft Office Outlook.</descrip></descripGrp><ntig><termGrp><term id="1250380">Microsoft Dynamics CRM for Microsoft Office Outlook with Offline Access</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2121594">Microsoft Dynamics CRM untuk Microsoft Office Outlook dengan Akses Luar Talian</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2597_143708_1294556"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A fundamental data type that holds integers. An Integer variable is stored as a 16-bit (2-byte) number ranging in value from -32,768 to 32,767.</descrip></descripGrp><ntig><termGrp><term id="143708">Integer data type</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1294556">jenis data Integer</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25978_1251313_1944847"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To place a windows Live ID in a forced rename state, while the Windows Live ID and all of its existing settings, including the password, Xbox Live points, or Zune points are preserved. The user can sign in using the Windows Live ID and its password, but they're immediately asked to rename the Windows Live ID. They must specify an email address that's outside the Outlook Live domain.</descrip></descripGrp><ntig><termGrp><term id="1251313">evict</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1944847">usir</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25979_1253307_1521521"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The service in Microsoft Sharepoint Foundation that needs to be started to allow for a sandboxed solution to be deployed.</descrip></descripGrp><ntig><termGrp><term id="1253307">Sandboxed Code Service</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1521521">Khidmat Kod Kotak Pasir</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25979_1496238_1521521"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The service in Microsoft Sharepoint Foundation that needs to be started to allow for a sandboxed solution to be deployed.</descrip></descripGrp><ntig><termGrp><term id="1496238">Microsoft SharePoint Foundation Sandboxed Code Service</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1521521">Khidmat Kod Kotak Pasir</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2598_1089489_1294557"><langSet xml:lan