n a computer screen that contains different groups of apps or content open and available for different tasks or aspects of your life.</descrip></descripGrp><ntig><termGrp><term id="2247563">desktop</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2249172">desktop maya</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38635_2247565_2249173"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An action to express that you agree with similar feedback sent by someone else. Rather than resubmit the same feedback, you can tap "Upvote," which means that you agree with the feedback that has been previously submitted.</descrip></descripGrp><ntig><termGrp><term id="2247565">upvote</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2249173">setuju</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38636_2247566_2249174"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To agree with similar feedback sent by someone else. Rather than resubmit the same feedback, you can tap "Upvote," which means that you agree with the feedback that has been previously submitted.</descrip></descripGrp><ntig><termGrp><term id="2247566">upvote</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><l