Selected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2205185">kiraan detik replika</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19641_662183_2214186"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A monotonically increasing number that is used to uniquely identify a change to an item in a replica.</descrip></descripGrp><ntig><termGrp><term id="662183">replica tick count</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2214186">kiraan detik</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19642_662168_2216484"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Metadata that identifies a change made to an item in a replica. It consists of the replica key and the replica tick count for the item.</descrip></descripGrp><ntig><termGrp><term id="662168">version</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2216484">versi</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19643_662169_2211389"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A unidirectional synchronization in which the source provider enumerates its changes and sends them to the destination provider, which applies them to its store.</descrip></descripGrp><ntig><termGrp><term id="662169">synchronization session</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2211389">sesi penyegerakan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19644_1370427_2211388"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A software component that allows a replica to synchronize its data with other replicas.</descrip></descripGrp><ntig><termGrp><term id="1370427">sync provider</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2211388">pembekal penyegerakan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19644_662170_2211388"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A software component that allows a replica to synchronize its data with other replicas.</descrip></descripGrp><ntig><termGrp><term id="662170">synchronization provider</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2211388">pembekal penyegerakan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun<