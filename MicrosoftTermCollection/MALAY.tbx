><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1294613">takrif aplikasi abstrak</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39074_2269904_2602800"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Data that resides in persistent storage on physical media, in any digital format. This includes files on magnetic or optical media, archived data, and data backups.</descrip></descripGrp><ntig><termGrp><term id="2269904">data at rest</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2602800">data tidak bergerak</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39077_2270185_2270994"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The preview of Power BI Desktop, the dedicated report authoring tool for the Power BI service.</descrip></descripGrp><ntig><termGrp><term id="2270185">Power BI Designer</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2270994">Pereka Power BI</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39078_2270188_2351120"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A client agent that enables Power BI to connect to on-premises SQL Server Analysis Services instances.</descrip></descripGrp><ntig><termGrp><term id="2270188">Analysis Services Connector</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2351120">Analysis Services Connector</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39079_2270271_2280507"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Outlook folder where low priority messages are moved either via the Clutter filter or by the user, based on individual user preferences.</descrip></descripGrp><ntig><termGrp><term id="2270271">Clutter</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2280507">Kluter</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3909_7248_408840"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Windows-based computers, a 32-bit value (a bitmask) that specifies the permissions that are assigned in an access control entry (ACE). An access mask is also part of the access request when an object is opened. The access mask in the request is compared to the access mask in each ACE to determine whether or not to grant the request.</descrip></descripGrp><ntig><termGrp><term id="7248">access mask</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="408840">topeng capaian</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39094_2270444_2335181"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A range of statistical and analytical techniques from modeling, machine learning, and data mining that analyze current and historical data to forecast future trends or events.</descrip></descripGrp><ntig><termGrp><term id="2270444">predictive analytics</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2335181">analitis ramalan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39097_2270759_2277197"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The year 2016 edition of the Microsoft relational database management system.</descrip></descripGrp><ntig><termGrp><term id="2270759">Access 2016</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2277197">Access 2016</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp