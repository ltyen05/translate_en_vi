elected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31622_1608188_1682808"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">​A Web Part that combines a search list of projects in a site collection along with a timeline that shows how those projects relate to one another.</descrip></descripGrp><ntig><termGrp><term id="1608188">Team Work Center</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1682808">Pusat Kerja Berkumpulan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31623_1608189_1682812"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of variants on a single theme.</descrip></descripGrp><ntig><termGrp><term id="1608189">theme family</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1682812">keluarga tema</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31624_1608190_2209655"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SQL Server feature that enables storage of data from an Office application on a SQL server.</descrip></descripGrp><ntig><termGrp><term id="1608190">SQL Server Store for Office Applications</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig