crip type="definition">The Microsoft incentive program designed to reward and support CSP direct bill partners for driving the activation and enablement of customers with Microsoft-based Online Services.</descrip></descripGrp><ntig><termGrp><term id="2868557">CSP Direct Bill Partner</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2868995">CSP Direct Bill Partner</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50687_2868558_2869084"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft incentive program for Cloud Solution Provider (CSP) partners that engage with a two-tier provider, commonly a distributor or hoster, who maintains the relationship with Microsoft and provides additional functions and services that the partner does not.</descrip></descripGrp><ntig><termGrp><term id="2868558">CSP Indirect Provider</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2869084">CSP Indirect Provider</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50688_2868559_2869170"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft incentive program for Cloud Solution Provider (CSP) resellers that are engaged by indirect CSP partners, who maintain the relationship with Microsoft, and who provide additional functions and s