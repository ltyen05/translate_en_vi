_1506440_2173241"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An XML-based collection of predefined or user-defined settings that are stored as a site definition configuration or a site template, and can be used when creating a site.</descrip></descripGrp><ntig><termGrp><term id="1506440">available site template</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2173241">templat laman yang tersedia</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29098_1506441_1521425"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The text or number that identifies the categories or the scaling of an axis. The axis label usually appears below or to the left of the axis.</descrip></descripGrp><ntig><termGrp><term id="1506441">axis label</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1521425">label paksi</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29100_1506443_1521426"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Web Parts page that contains only one Web Part zone and, by default, a Content Editor Web Part.</descrip></descripGrp><ntig><termGrp><term id="1506443">basic page</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="