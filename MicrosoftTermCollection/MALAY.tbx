ig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1684350">sifat diurus boleh perhalus</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32344_1653529_1684351"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A managed property that can be displayed in search results.</descrip></descripGrp><ntig><termGrp><term id="1653529">retrievable managed property</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1684351">sifat diurus boleh ambil</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32345_1653531_1684353"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A managed property whose value can be returned by a query.</descrip></descripGrp><ntig><termGrp><term id="1653531">searchable managed property</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1684353">sifat terurus boleh cari</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32346_1653533_1684355"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A managed property whose result set can be sorted based on the property before the result set is returned.</descrip></descripGrp><ntig><termGrp><term id="1653533">sortable managed property</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1684355">sifat terurus boleh isih</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3235_2524825_2205337"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An outer join in which all the records from the right side of the RIGHT JOIN operation in the query's SQL statement are added to the query's results, even if there are no matching values in the joined field from the table on the left.</descrip></descripGrp><ntig><termGrp><term id="2524825">right outer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2205337">cantuman luaran kanan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3235_2524825_2524924"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An outer join in which all the records from the right side of the RIGHT JOIN operation in the query's SQL statement are added to the query's results, even if there are no matching values in the joined field from the table on the left.</descrip></descripGrp><ntig><termGrp><term id="2524825">right outer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2524924">luaran kanan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3235_360148_2205337"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An outer join in which all the records from the right side of the RIGHT JOIN operation in the query's SQL statement are added to the query's results, even if there are no matching values in the joined field from the table on the left.</descrip></descripGrp><ntig><termGrp><term id="360148">right outer join</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2205337">cantuman luaran kanan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3235_360148_2524924"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An outer join in which all the records from the right side of the RIGHT JOIN operation in the query's SQL statement are added to the query's results, even if there are no matching values in the joined field from the table on the left.</descrip></descripGrp><ntig><termGrp><term id="360148">right outer join</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2524924">luaran kanan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32350_1656127_1684328"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user defined dictionary that lists single words or phrases that the system matches to words in the content in either a case-sensitive way or a case-insensitive way, depending on the type of dictionary that is used.</descrip></descripGrp><ntig><termGrp><term id="1656127">custom extraction dictionary</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1684328">kamus pengekstrakan tersuai</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32351_1656134_1684334"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A custom extraction dictionary that lists words or phrases that are matched to exact words in the content in a case-sensitive way. For example, the system matches "anchor" to "anchor," but not to "Anchor" or "Anchorage."</descrip></descripGrp><ntig><termGrp><term id="1656134">exact word extraction dictionary</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1684334">kamus pengekstrakan kata tepat</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32352_1656137_1684335"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A custom extraction dictionary that lists words or phrases that are matched anywhere in the content in a case-sensitive way. For example, the system matches "anchor" and "anchorage," but not "Anchor."</descrip></descripGrp><ntig><termGrp><term id="1656137">exact word part extraction dictionary</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1684335">kamus pengekstrakan bahagian kata tepat</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32353_1656140_1684362"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A custom extraction dictionary that lists words or phrases that are matched to exact words in the content in a case-insensitive way. For example, the entry "anchor" will match "anchor" and "Anchor," but not "anchorage."</descrip></descripGrp><ntig><termGrp><term id="1656140">word extraction dictionary</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1684362">kamus pengekstrakan kata</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32354_1656141_1684363"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A custom extraction dictionary that lists words or phrases that are matched anywhere in the content in a case-insensitive way. For example, the entry "anchor" will match "anchor," "Anchor," and "anchorage."</descrip></descripGrp><ntig><termGrp><term id="1656141">word part extraction dictionary</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1684363">kamus pengekstrakan bahagian kata</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32355_1656142_1684352"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A data structure that describes crawled properties, managed properties, and the mapping between them.</descrip></descripGrp><ntig><termGrp><term id="1656142">search schema</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1684352">skema carian</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32356_1656144_1684340"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A logical portion of the search index.</descrip></descripGrp><ntig><termGrp><term id="1656144">index partition</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1684340">petak indeks</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32359_1657886_1662479"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of apps that includes Messenger, Photo Gallery, Movie Maker, OneDrive, Mail, Writer, and Family Safety. (Family Safety is only included in Windows 7 downloads; it's built in to Windows 8.)</descrip></descripGrp><ntig><termGrp><term id="1657886">Windows Essentials 2012</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1662479">Windows Essentials 2012</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3236_80090_1294578"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The use of computers and data communication equipment to convey messages from one person to another, as by email, voice mail, or fax.</descrip></descripGrp><ntig><termGrp><term id="80090">messaging</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1294578">pemesejan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32361_1658247_1684343"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tool in Office 365 that enables IT professionals to manage how Office is installed for their users. Users receive the correct language and configurations individually tailored to them automatically, without the need to install anything themselves.</descrip></descripGrp><ntig><termGrp><term id="1658247">Office Deployment Tool</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1684343">Alat Pengerahan Office</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32362_1658249_1684361"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mode in which SharePoint Server is the primary source for all the project details. Project Server scheduling, time and status, and advanced functionality are disabled.</descrip></descripGrp><ntig><termGrp><term id="1658249">visibility mode</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1684361">mod kebolehlihatan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32367_1666384_1684946"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Windows feature that enables users to connect computers with a simple tap gesture or by browsing for computers within wireless range. If two computers come within 3-4 centimeters of each other, or are tapped together, the operating system of each computer becomes aware of the other computer. Also, a user can browse for computers within wireless range that are advertising for a peer connection. The user can then connect the two computers to share content such as photos or links, or create a multi-player experience. If the connection is made using a tap gesture, the user can also publish and subscribe to messages transmitted during the tap.</descrip></descripGrp><ntig><termGrp><term id="1666384">proximity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1684946">kehampiran</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32373_1667286_2174179"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The option that specifies events triggered by the service application when locating a server for loading a PowerPivot data source and communicating with other servers in the farm.</descrip></descripGrp><ntig><termGrp><term id="1667286">Application Page Request</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2174179">Permintaan Halaman Aplikasi</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3239_1513455_1641237"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A certification authority that has the ability to issue the intermediate certificates needed to certify the subject identified by the end certificate.</descrip></descripGrp><ntig><termGrp><term id="1513455">intermediate CA</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1641237">CA perantaraan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammatica