ugh contactless communication.</descrip></descripGrp><ntig><termGrp><term id="1803761">NFC reader</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1846576">pembaca NFC</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33607_1803831_1846577"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An exchange of information between two devices using NFC, or near field communication. Using NFC transactions, a person can use their phone to make payments in a store or as a bus pass.</descrip></descripGrp><ntig><termGrp><term id="1803831">NFC transaction</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1846577">transaksi NFC</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33608_1803832_1846579"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The data limit plan where users purchase upfront a quota of data for a given time. For instance, pre-paid 500MB which expire in 6 months.</descrip></descripGrp><ntig><termGrp><term id="1803832">One time</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1846579">Prabayar</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</