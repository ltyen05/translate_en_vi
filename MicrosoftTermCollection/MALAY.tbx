537109_1295356"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A dynamic Web Parts control that can be personalized and permanently deleted from a page for an individual user only. A per-user control appears on the page only when the page is in user scope. Note that a per-user control can have properties that are both user-scope and shared-scope for personalization purposes.</descrip></descripGrp><ntig><termGrp><term id="537109">per-user control</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1295356">kawalan setiap pengguna</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55082_3122695_3123092"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Python code used to perform logical calculations.</descrip></descripGrp><ntig><termGrp><term id="3122695">Python formula</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="3123092">formula Python</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55084_3122863_3123093"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The group of icons that appear in the bottom right corner of Windows 11. It only contains shortcuts to important system information, like battery, Bluetooth, and Wi-Fi.</descrip></descripGrp><ntig><termGrp><term id="3122863">system tray</term><termNote type="partOfSp