</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34223_1987604_2121823"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that helps users compress (or expand) the duration of a job without having to update the start and due dates of every task in the workflow.</descrip></descripGrp><ntig><termGrp><term id="1987604">workflow compression</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2121823">pemampatan aliran kerja</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34224_1987605_2121807"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The number of hours that a contact worked during a time period, that is, the sum of all hours on all time slips during the period.</descrip></descripGrp><ntig><termGrp><term id="1987605">utilization</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2121807">penggunaan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34225_1987606_2121675"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The number of hours that the contact worked during a time period that a