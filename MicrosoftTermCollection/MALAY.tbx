type="definition">A function or object that invokes an event handler when a specific condition occurs in an application.</descrip></descripGrp><ntig><termGrp><term id="1513675">event listener</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1682653">pendengar peristiwa</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3019_28356_1309654"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Hypertext Markup Language (HTML) specification developed by The World Wide Web Consortium (W3C) that allows authors of HTML documents and users to attach style sheets to HTML documents. The style sheets include typographical information on how the page should appear, such as the font of the text in the page. This specification also directs the way in which the style sheets of the HTML document and the user's style will blend.</descrip></descripGrp><ntig><termGrp><term id="28356">Cascading Style Sheets</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1309654">Helaian Gaya Lata</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3019_28357_1309654"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Hypertext Markup Language (HTML) specification developed by The World Wide Web Consortium (W3C) that allows authors of HTML documents and users to attach style sheets to HTML documents. The style sheets include typographical information on how the page should appear, such as the font of the text in the page. This specification also directs the way in which the style sheets of the HTML document and the user's style will blend.</descrip></descripGrp><ntig><termGrp><term id="28357">CSS</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1309654">Helaian Gaya Lata</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3029_187862_1294570"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The inspector window used with all diagrams through which settings, constraints and resource definitions can be viewed and edited.</descrip></descripGrp><ntig><termGrp><term id="187862">Settings and Constraints Editor</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1294570">Editor Penyediaan dan Kekangan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="303_536058_1294434"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Metadata that is part of the assembly manifest.</descrip></descripGrp><ntig><termGrp><term id="536058">assembly metadata</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"