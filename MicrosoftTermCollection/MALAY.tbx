langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1684269">kenari</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32288_1647733_1684326"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A predetermined value that must be present in a client-server request for the request to be considered valid.</descrip></descripGrp><ntig><termGrp><term id="1647733">canary</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1684326">nilai kenari</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32288_1647734_1684269"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A predetermined value that must be present in a client-server request for the request to be considered valid.</descrip></descripGrp><ntig><termGrp><term id="1647734">canary value</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1684269">kenari</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32288_1647734_1684326"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A predetermined value that must be present in a client-server request for the request to be considered valid.</descrip></descripGrp><ntig><termGrp><term id="1647734">canary value</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1684326">nilai kenari</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32290_1707154_1915588"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tool that enables IT pros to monitor usage, error, and compatibility issue information from Office related solutions on client machines across an organization.</descrip></descripGrp><ntig><termGrp><term id="1707154">Office Telemetry Dashboard</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1915588">Papan Pemuka Telemetri Office</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32291_1648739_2174166"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The high-availability and disaster-recovery solution that provides protection for a set of user databases across multiple machines and data centers using SQL Server to replicate the data.</descrip></descripGrp><ntig><termGrp><term id="1648739">AlwaysOn Availability Groups</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2174166">Kumpulan Ketersediaan AlwaysOn</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32291_2577278_2174166"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The high-availability and disaster-recovery solution that provides protection for a set of user databases across multiple machines and data centers using SQL Server to replicate the data.</descrip></descripGrp><ntig><termGrp><term id="2577278">AlwaysOn</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2174166">Kumpulan Ketersediaan AlwaysOn</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32291_2599529_2174166"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The high-availability and disaster-recovery solution that provides protection for a set of user databases across multiple machines and data centers using SQL Server to replicate the data.</descrip></descripGrp><ntig><termGrp><term id="2599529">Always On</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2174166">Kumpulan Ketersediaan AlwaysOn</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32291_2599530_2174166"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The high-availability and disaster-recovery solution that provides protection for a set of user databases across multiple machines and data centers using SQL Server to replicate the data.</descrip></descripGrp><ntig><termGrp><term id="2599530">Always On availability groups</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2174166">Kumpulan Ketersediaan AlwaysOn</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32292_1648740_2174202"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Within a given availability group, a pair of availability replicas (including the current primary replica) that are configured for synchronous-commit mode with automatic failover, if any.</descrip></descripGrp><ntig><termGrp><term id="1648740">automatic failover set</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2174202">set gagal seluruh automatik</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32293_1648741_2174207"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A database that belongs to an availability group.</descrip></descripGrp><ntig><termGrp><term id="1648741">availability database</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2174207">pangkalan data ketersediaan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32294_1648742_2174208"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that supports a failover environment for a discrete set of user databases, known as availability databased.</descrip></descripGrp><ntig><termGrp><term id="1648742">availability group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2174208">kumpulan ketersediaan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32295_1648743_2174209"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A server to which clients can connect in order to access a database in a primary or secondary replica of an availability group.</descrip></descripGrp><ntig><termGrp><term id="1648743">availability group listener</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2174209">pendengar kumpulan ketersediaan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32296_1648744_2174210"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An instantiation of an availability group that is hosted by a specific instance of SQL Server and that maintains a local copy of the set of availability databases that belong to the availability group.</descrip></descripGrp><ntig><termGrp><term id="1648744">availability replica</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2174210">replika ketersediaan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32297_1648745_2174365"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A internal entity that can be owned by a Windows Server Failover Clustering (WSFC) node, brought online and taken offline, moved between nodes, and managed as a cluster object. A cluster resource can be owned by only a single node at any point in time.</descrip></descripGrp><ntig><termGrp><term id="1648745">cluster resource</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2174365">sumber gugusan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32298_1648746_2177273"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Within a given availability group, the set of all availability replicas whose operational state is currently ONLINE, regardless of availability mode and of failover mode.</descrip></descripGrp><ntig><termGrp><term id="1648746">entire failover set</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2177273">semua set gagal seluruh</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32299_1648747_2180050"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">For an availability group, a form of failover (with possible data loss) that can be initiated by a database administrator in response to the loss of the primary replica when automatic failover did not occur.</descrip></descripGrp><ntig><termGrp><term id="1648747">forced manual failover</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2180050">gagal seluruh paksa</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32299_1648747_2180051"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">For an availability group, a form of failover (with possible data loss) that can be initiated by a database administrator in response to the loss of the primary replica when automatic failover did not occur.</descrip></descripGrp><ntig><termGrp><term id="1648747">forced manual failover</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2180051">gagal seluruh manual paksa</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32299_2022572_2180050"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">For an availability group, a form of failover (with possible data loss) that can be initiated by a database administrator in response to the loss of the primary replica when automatic failover did not occur.</descrip></descripGrp><ntig><termGrp><term id="2022572">forced failover</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2180050">gagal seluruh paksa</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32299_2022572_2180051"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">For an availability group, a form of failover (with possible data loss) that can be initiated by a database administrator in response to the loss of the primary replica when automatic failover did not occur.</descrip></descripGrp><ntig><termGrp><term id="2022572">forced failover</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2180051">gagal seluruh manual paksa</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32300_1648748_2180052"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process to start a WSFC cluster even though only a minority of the elements that are required for quorum are in communication.</descrip></descripGrp><ntig><termGrp><term id="1648748">forced quorum</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2180052">korum paksa</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32302_1648750_2197357"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">For an availability group, a failover without data loss that is initiated by a database administrator, typically, for administrative purposes.</descrip></descripGrp><ntig><termGrp><term id="1648750">planned manual failover</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2197357">gagal seluruh manual terancang</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32303_1648751_2197420"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An availability replica that makes the primary databases of an availability group available for read-write connections from clients and sends transaction log records for each primary database to every secondary replica.</descrip></descripGrp><ntig><termGrp><term id="1648751">primary replica</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2197420">replika utama</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32304_1648752_2199628"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The WSFC quorum configuration in a failover cluster that determines the number of node failures that the cluster can sustain.</descrip></descripGrp><ntig><termGrp><term id="1648752">quorum mode</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2199628">mod korum</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32305_1648753_2174366"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An internal collection of cluster resources managed as a single cluster object in the WSFC cluster.</descrip></descripGrp><ntig><termGrp><term id="1648753">cluster resource group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2174366">kumpulan sumber gugusan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32306_1648755_2207986"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An availability replica that maintains a secondary copy 