OfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1944880">senarai selamat IP</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25783_1216620_1944990"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The collection of IP addresses that are in a gateway servers list or internal mail servers list of IP addresses that should not be treated as spam.</descrip></descripGrp><ntig><termGrp><term id="1216620">IP safelist</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1944990">senarai selamat</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25783_1216842_1944880"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The collection of IP addresses that are in a gateway servers list or internal mail servers list of IP addresses that should not be treated as spam.</descrip></descripGrp><ntig><termGrp><term id="1216842">safelist</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1944880">senarai selamat IP</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25783_1216842_1944990"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The collection of IP addresses that are in a gateway servers list or internal mail servers list of IP addresses that should not be treated as spam.</descrip></descripGrp><ntig><termGrp><term id="1216842">safelist</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1944990">senarai selamat</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25784_1216621_1944978"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The individual entry on a management role. Role entries provide access to cmdlets, scripts, and other special permissions that let users perform a specific task. A role entry is often a single cmdlet and the parameters that members of a role group can run when the role is assigned to the role group.</descrip></descripGrp><ntig><termGrp><term id="1216621">role entry</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1944978">entri peranan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25785_1216622_1944982"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The scope of influence or impact of a role assignment. The scope defines what objects a role group member can manage. In Outlook Live, there is the recipient scope and the configuration scope.</descrip></descripGrp><ntig><termGrp><term id="1216622">role scope</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1944982">skop peranan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25786_1216623_1944980"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A member of an administrator role group, which is a universal security group with administrative rights assigned to it. The roles assigned to the role group are applied to each member who is added to the role group. This grants each user all the permissions allowed by the roles assigned to the role group.</descrip></descripGrp><ntig><termGrp><term id="1216623">role group member</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1944980">ahli kumpulan peranan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25787_1216679_1265153"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The link to the Microsoft service agreement.</descrip></descripGrp><ntig><termGrp><term id="1216679">Terms of use</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1265153">Terma penggunaan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote t