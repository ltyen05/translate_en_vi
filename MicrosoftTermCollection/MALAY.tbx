"grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5151_228751_444413"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A real-time communication session between two or more users, which can involve IM, video, or audio.</descrip></descripGrp><ntig><termGrp><term id="228751">conversation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="444413">perbualan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51510_2899588_2900158"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A category of all-in-one dedicated Teams devices featuring an ambient touchscreen and a hands-free experience powered by Cortana that brings together the user's favorite Teams features: chat, meetings, calls, calendar, and files into a single device, promoting human connection in the remote workplace.</descrip></descripGrp><ntig><termGrp><term id="2899588">Teams display</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2900158">paparan Teams</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51543_2900640_2900793"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The dashboard in Microsoft Teams that provides the user with analytics about teams that they are a member or owner of, including data about user and guest volume as well as messaging activity.</descrip></descripGrp><ntig><termGrp><term id="2900640">Insights</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2900793">Insights</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5155_237798_1294701"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A deliverable of the planning phase for a development project. It consolidates feature team and role plans. The master project plan includes a budget plan, capacity plan, communications plan, deployment plan, development plan, pilot plan, purchasing and facilities plan, security plan, test plan, and training plan.</descrip></descripGrp><ntig><termGrp><term id="237798">master project plan</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1294701">pelan projek induk</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51557_2901206_2901357"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The licensing model in which Power BI Premium features are licensed on a per user basis.</descrip></descripGrp><ntig><termGrp><term id="2901206">Premium per user</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></lang