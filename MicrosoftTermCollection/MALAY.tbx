ry><termEntry id="28520_1488808_1678140"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A location map that determines a caller's location, and is configured by a VoIP administrator.</descrip></descripGrp><ntig><termGrp><term id="1488808">wiremap</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1678140">peta wayar</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28541_1489075_1745178"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A service under which customers can acquire and redeem points for certain online services and digital products.</descrip></descripGrp><ntig><termGrp><term id="1489075">Microsoft Points</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1745178">Microsoft Points</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28583_1489587_2180003"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Windows NT lightweight thread scheduled within a single OS thread.</descrip></descripGrp><ntig><termGrp><term id="1489587">fiber</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2180003">gentian</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><te