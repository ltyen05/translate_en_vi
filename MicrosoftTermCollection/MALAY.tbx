ge">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16104_530280_1299133"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A unique name for a subscription computer that is specified by the solution provider. This is the name that the solution provider submits to the Provisioning Server when configuring a subscription computer or querying information about that computer. The computer name is an alphanumeric string of up to fifty characters.</descrip></descripGrp><ntig><termGrp><term id="530280">computer name</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1299133">nama komputer</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16108_235052_1299134"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An extensible programming model and runtime components for building solutions on the Windows platform.</descrip></descripGrp><ntig><termGrp><term id="235052">Windows Workflow Foundation</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1299134">Asas Aliran Kerja Windows</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16112_251800_1299135"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A preliminary type, form, or instance of a product or product component that serves as a model for later stages or for the final, complete version of the product.</descrip></descripGrp><ntig><termGrp><term id="251800">prototype</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1299135">prototaip</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16113_2794716_443555"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A uniquely-named collection of computers in a networked environment that share a common database, directory database, or tree and that is administered as a unit with common rules and procedures, which can include security policies.</descrip></descripGrp><ntig><termGrp><term id="2794716">network domain</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="443555">domain</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16113_47604_443555"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A uniquely-named collection of computers in a networked environment that share a common database, directory database, or tree and that is administered as a unit with common rules and procedures, which can include security policies.</descrip></descripGrp><ntig><termGrp><term id="47604">domain</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="443555">domain</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16114_530294_2519502"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A flat board made of nonconducting material, such as plastic or fiberglass where chips and other electronic components are mounted, usually in predrilled holes. The component holes are connected electrically by predefined conductive metal pathways that are printed on the surface of the board. The metal leads protruding from the electronic components are soldered to the conductive metal pathways to form a connection.</descrip></descripGrp><ntig><termGrp><term id="530294">printed circuit board</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2519502">papan litar bercetak</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16114_530295_2519502"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A flat board made of nonconducting material, such as plastic or fiberglass where chips and other electronic components are mounted, usually in predrilled holes. The component holes are connected electrically by predefined conductive metal pathways that are printed on the surface of the board. The metal leads protruding from the electronic components are soldered to the conductive metal pathways to form a connection.</descrip></descripGrp><ntig><termGrp><term id="530295">PCB</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2519502">papan litar bercetak</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16115_535443_1299136"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A report that communicates the amount of code covered or exercised for a particular test run.</descrip></descripGrp><ntig><termGrp><term id="535443">Test Effectiveness</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1299136">Keberkesanan Ujian</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16117_347943_1096487"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group that is associated with another group so that their properties and the properties of the groups and fields they contain always match. If the properties of one group are changed, the other group is updated automatically.</descrip></descripGrp><ntig><termGrp><term id="347943">reference group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1096487">kumpulan rujukan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">