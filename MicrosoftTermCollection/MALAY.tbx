ntig></langSet></termEntry><termEntry id="1626_535380_2207437"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file created when the file rollover option causes SQL Server to close the current file and create a new file when the maximum file size is reached.</descrip></descripGrp><ntig><termGrp><term id="535380">rollover file</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2207437">fail pusing ganti</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16263_10901_443274"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To position objects or text relative to some point, such as the page margin.</descrip></descripGrp><ntig><termGrp><term id="10901">align</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="443274">jajar</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16264_23989_1299147"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Being sent to more than one recipient.</descrip></descripGrp><ntig><termGrp><term id="23989">broadcast</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1299147">siaran</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16265_237172_2388638"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The abstract or concrete resources that a system must protect from misuse by an adversary.</descrip></descripGrp><ntig><termGrp><term id="237172">asset</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2388638">aset</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16268_148817_1319583"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A fundamental data type that holds characters, one character per 2 bytes. A fixed-length string can contain 1 to 64K characters; a variable-length string can contain 1 to 2 billion.</descrip></descripGrp><ntig><termGrp><term id="148817">String data type</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1319583">Jenis data rentetan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16270_535227_2194765"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An object in a repository that is the origin in a directional relationship.</descrip></descripGrp><ntig><termGrp><term id="535227">origin object</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2194765">objek asal</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16274_535771_1299148"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A scenario used to model how a group of users interacts with a server application. A scenario consists of a test mix, a load profile, a network mix, and a browser mix. A load test can have more than one scenario.</descrip></descripGrp><ntig><termGrp><term id="535771">load test scenario</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1299148">senario ujian beban</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16275_530211_2174422"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A filter that restricts columns that are to be included as part of a snapshot, transactional, or merge publication.</descrip></descripGrp><ntig><termGrp><term id="530211">column filter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2174422">penapis lajur</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16276_263115_1183090"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to a file format that allows for VBA code. Examples of file extensions for macro-enabled formats are .docm, .pptm, .xlsm.</descrip></descripGrp><ntig><termGrp><term id="263115">macro-enabled</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1183090">makro-didayakan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16281_535789_1299149"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The logical representation of a location, typically expressed in URL form, providing a physical address for data received or sent.</descrip></descripGrp><ntig><termGrp><term id="535789">endpoint</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1299149">titik akhir</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16283_182107_2177188"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method of sending notifications that combines multiple notifications within a batch and sends the resulting message to a subscriber.</descrip></descripGrp><ntig><termGrp><term id="182107">digest delivery</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2177188">penghantaran ikhtisar</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16288_536066_1299150"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A library of C++ classes that forms an object-oriented wrapper around large portions of the Windows API and provides a framework on which to build applications.</descrip></descripGrp><ntig><termGrp><term id="536066">Microsoft Foundation Class Library</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1299150">Pustaka Kelas Asas Microsoft</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16290_237379_444546"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in Office Server that provides a workflow for document review.</descrip></descripGrp><ntig><termGrp><term id="237379">Document Review</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="444546">Penyemakan Semula Dokumen</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16296_187144_1299151"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A logical grouping of code that has a specified condition for membership.</descrip></descripGrp><ntig><termGrp><term id="187144">code group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1299151">kumpulan kod</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16297_536288_1299152"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A field in an ASP.NET Web page that stores the current property settings for server controls on the page. Control state is used to recreate the page and reestablish previous settings on each postback.</descrip></descripGrp><ntig><termGrp><term id="536288">control state</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1299152">keadaan kawalan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="163_311257_444832"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The user preferences for the formatting of dates, currencies, numbers, and so on. The user locale is a per-user setting, and does not require the user to restart or to log on or log off the computer.</descrip></descripGrp><ntig><termGrp><term id="311257">user locale</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="444832">penempatan pengguna</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16300_530454_2186568"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An OLE DB rowset exposed by an OLE DB data source that has been defined as a linked server for use in SQL Server distributed queries.</descrip></descripGrp><ntig><termGrp><term id="530454">linked table</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2186568">jadual yang dipautkan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16305_77810_1299153"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application or Windows 2000/Windows NT service that uses information originating from one or more managed objects in a managed environment. Management applications retrieve this information through calls to the CIM Object Manager API from the CIM Object Manager and from providers.</descrip></descripGrp><ntig><termGrp><term id="77810">management application</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1299153">aplikasi pengurusan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16308_307420_408806"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of calendar enhancements that enable users to schedule people and resources quickly, efficiently, and reliably. The enhancements include the Calendar Attendant, the Resource Booking Attendant, and the Scheduling Assistant.</descrip></descripGrp><ntig><termGrp><term id="307420">Calendar Concierge</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="408806">Rencam Kalendar</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16310_536341_1299154"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A hardware-independent environment for running programs on resource-constrained computing devices. It inherits the full .NET Framework architecture of the common language runtime, supports a subset of the .NET Framework class library, and contains classes designed exclusively for the .NET Compact Framework. Supported devices include personal data assistants (PDAs) (such as the Pocket PC), mobile phones, set-top boxes, automotive computing devices, and custom-designed embedded devices built with the Microsoft Windows CE.NET operating system.</descrip></descripGrp><ntig><termGrp><term id="536341">.NET Compact Framework</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1299154">.NET Compact Framework</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16311_26305_2174281"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A copy of data stored in a cache in order to shorten the time required to retrieve the data if it is large or accessed frequently.</descrip></descripGrp><ntig><termGrp><term id="26305">cached copy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2174281">salinan bercache</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16315_140027_444131"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A dialog box that displays one complete record at a time. You can use data forms to add, change, locate, and delete records.</descrip></descripGrp><ntig><termGrp><term id="140027">data form</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="444131">borang data</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16316_536365_1299155"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A subset of language features supported by the common language runtime, including features common to several object-oriented programming languages. CLS-compliant components and tools are guaranteed to interoperate with other CLS-compliant components and tools.</descrip></descripGrp><ntig><termGrp><term id="536365">Common Language Specification</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1299155">Spesifikasi Bahasa Biasa</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16316_536366_1299155"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A subset of language features supported by the common language runtime, including features common to several object-oriented programming languages. CLS-compliant components and tools are guaranteed to interoperate with other CLS-compliant components and tools.</descrip></descripGrp><ntig><termGrp><term id="536366">CLS</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1299155">Spesifikasi Bahasa Biasa</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16317_209984_444351"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Windows Media Player, a database that contains information about digital media files on a computer, a network drive, or the Internet.</descrip></descripGrp><ntig><termGrp><term id="209984">library</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="444351">pustaka</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1632_213814_2372469"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An account that describes the changes in value reported on a balance sheet.</descrip></descripGrp><ntig><termGrp><term id="213814">balance sheet account</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2372469">akaun kunci kira-kira</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16321_182039_2214766"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user-written extension to the scalar type system.</descrip></descripGrp><ntig><termGrp><term id="182039">user-defined type</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2214766">UDT</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16321_182039_2216478"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user-written extension to the scalar type system.</descrip></descripGrp><ntig><termGrp><term id="182039">user-defined type</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2216478">jenis takrifan pengguna</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16321_182040_2214766"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user-written extension to the scalar type system.</descrip></descripGrp><ntig><termGrp><term id="182040">UDT</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2214766">UDT</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16321_182040_2216478"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user-written extension to the scalar type system.</descrip></descripGrp><ntig><termGrp><term id="182040">UDT</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2216478">jenis takrifan pengguna</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16322_143641_1183091"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The cell in which each input value from a data table is substituted. Any cell on a worksheet can be the input cell. Although the input cell does not need to be part of the data table, the formulas in data tables must refer to the input cell.</descrip></descripGrp><ntig><termGrp><term id="143641">input cell</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1183091">sel input</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16323_52130_1299156"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A block of code that reacts to a specific type of exception.</descrip></descripGrp><ntig><termGrp><term id="52130">exception handler</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1299156">pengendali pengecualian</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16325_536508_1299157"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A menu in the title bar of a part control that contains various verbs (UI actions that apply to an individual control) such as Close, Minimize, Restore, Delete, Export, Edit, Help, and others, as well as custom verbs implemented by developers.</descrip></descripGrp><ntig><termGrp><term id="536508">verbs menu</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1299157">menu kata kerja</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16327_163539_444271"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The adjustment of the spacing between two characters to create the appearance of even spacing, fit text to a given space, and adjust line breaks.</descrip></descripGrp><ntig><termGrp><term id="163539">kerning</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="444271">pengkernaan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16328_237211_1299158"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The series of activities that determines the duration of the project. In a deterministic model, the critical path is usually defined as those activities with float less than or equal to a specified value, often zero. It is the longest path through the project.</descrip></descripGrp><ntig><termGrp><term id="237211">critical path</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1299158">laluan genting</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1633_262439_444589"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A proposed standard digital rights management (DRM) markup language which enables users to specify rights and conditions associated with resources, such as digital content or Web services.</descrip></descripGrp><ntig><termGrp><term