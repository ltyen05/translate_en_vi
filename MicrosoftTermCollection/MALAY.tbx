e.com.</descrip></descripGrp><ntig><termGrp><term id="1635723">Microsoft Hotmail</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1173517">Windows Live Hotmail</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24600_1635723_1677896"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The web email service for domains supported by Microsoft account, including @hotmail.com and @live.com.</descrip></descripGrp><ntig><termGrp><term id="1635723">Microsoft Hotmail</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1677896">Hotmail</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24600_1635723_1677903"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The web email service for domains supported by Microsoft account, including @hotmail.com and @live.com.</descrip></descripGrp><ntig><termGrp><term id="1635723">Microsoft Hotmail</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1677903">Microsoft Hotmail</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNu