3368">web conferencing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1915662">persidangan web</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3279_59527_2418086"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In a drawing program, to transform a number of objects into a group.</descrip></descripGrp><ntig><termGrp><term id="59527">group</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2418086">kelompok</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32794_1703373_1915638"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A server running Windows Server that meets specified hardware requirements, and that has Lync Server Registrar and Mediation Server software installed on it. Like Survivable Branch Appliances, this device can provide voice mail survivability for branch users during a WAN outage.</descrip></descripGrp><ntig><termGrp><term id="1703373">Survivable Branch Server</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1915638">Pelayan Cawangan Boleh Hidup</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="gramm