ig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1298180">skop</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13718_96428_2199620"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A database engine component responsible for generating efficient execution plans for statements.</descrip></descripGrp><ntig><termGrp><term id="96428">query optimizer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2199620">pengoptimum pertanyaan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13719_54551_2180032"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A predefined role that exists in each database. The scope of the role is limited to the database in which it is defined.</descrip></descripGrp><ntig><termGrp><term id="54551">fixed database role</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2180032">peranan pangkalan data tetap</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13724_2346152_2798340"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A named set of deliverables (software components) produced, usually by compiling, from a discrete set of source versions.</descrip></descripGrp><ntig><termGrp><term id="2346152">BLD</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2798340">binaan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13724_24639_2798340"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A named set of deliverables (software components) produced, usually by compiling, from a discrete set of source versions.</descrip></descripGrp><ntig><termGrp><term id="24639">build</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2798340">binaan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13726_261538_444577"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A software control that incorporates ActiveX technology.</descrip></descripGrp><ntig><termGrp><term id="261538">ActiveX control</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="444577">kawalan ActiveX</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></