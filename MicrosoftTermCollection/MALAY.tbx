n a computer that is located outside the firewall and primary NAT.</descrip></descripGrp><ntig><termGrp><term id="1264987">Session Border Controller</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2927810">SBC</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26148_1264988_2927808"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A service that manages VoIP traffic in much the same way that a NAT or firewall manages generic IP traffic. The service usually runs on a computer that is located outside the firewall and primary NAT.</descrip></descripGrp><ntig><termGrp><term id="1264988">SBC</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2927808">Pengawal Sempadan Sesi</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26148_1264988_2927810"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A service that manages VoIP traffic in much the same way that a NAT or firewall manages generic IP traffic. The service usually runs on a computer that is located outside the firewall and primary NAT.</descrip></descripGrp><ntig><termGrp><term id="1264988">SBC</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2927810">SBC</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26150_1265018_1677974"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ability of a single user to sign in to a Lync Server or Office Communications Server server with multiple clients.</descrip></descripGrp><ntig><termGrp><term id="1265018">multiple points of presence</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1677974">MPOP</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26150_1265019_1677974"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ability of a single user to sign in to a Lync Server or Office Communications Server server with multiple clients.</descrip></descripGrp><ntig><termGrp><term id="1265019">MPOP</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1677974">MPOP</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26155_1265256_2192465"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">One of the two appearance properties that can be applied to a radial gauge.</descrip></descripGrp><ntig><termGrp><term id="1265256">needle cap</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2192465">tukup jejarum</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26159_1266975_2177259"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Routing that adjusts automatically to the current conditions of a network. Dynamic routing typically uses one of several dynamic-routing protocols such as Routing Information Protocol (RIP) and Border Gateway Protocol (BGP). Compare static routing.</descrip></descripGrp><ntig><termGrp><term id="1266975">dynamic routing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2177259">penghalaan dinamik</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26159_1266976_2177259"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Routing that adjusts automatically to the current conditions of a network. Dynamic routing typically uses one of several dynamic-routing protocols such as Routing Information Protocol (RIP) and Border Gateway Protocol (BGP). Compare static routing.</descrip></descripGrp><ntig><termGrp><term id="1266976">adaptive routing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2177259">penghalaan dinamik</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26164_1268970_2214801"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file that saves the content of the pages in a database after they've been modified by uncommitted, rolled back transactions and before recovery restores them to their previous state. The undo file prevents the changes performed by uncommitted transactions from being lost.</descrip></descripGrp><ntig><termGrp><term id="1268970">undo file</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2214801">fail buat asal</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26170_1269206_1365542"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Windows Presentation Foundation and Silverlight, the movement of an event in a tree of elements. There are three types of event routing: direct, bubbling, and tunneling. With direct routing, the event does not move in the tree. With bubbling, the event moves up to the top of the tree. With tunneling, the event starts at the top of the tree and moves down to the source of the event. In Silverlight,  event routing and routed events are used, but tunneling is not implemented.</descrip></descripGrp><ntig><termGrp><term id="1269206">event routing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1365542">penghalaan peristiwa</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26171_1269381_2177263"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An event whose event payload is valid for a given interval; however, only the start time is known upon arrival to the CEP server. The valid end time of the event is provided later in a separate edge event.</descrip></descripGrp><ntig><termGrp><term id="1269381">edge event</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2177263">peristiwa pinggir</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26172_1269385_2197367"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An event occurrence as of a single point in time. Only the start time is required for the event. The CEP server infers the valid end time by adding a tick (the smallest unit of time in the underlying time data type) to the start time to set the valid time interval for the event. Point events are valid only for this single instant of time.</descrip></descripGrp><ntig><termGrp><term id="1269385">point event</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2197367">peristiwa titik tunggal</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26173_1269391_2182992"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of window in which consecutive windows "hop" forward in time by a fixed period. The window is defined by two time spans: the period P and the window length L. For every P time unit a new window of size L is created.</descrip></descripGrp><ntig><termGrp><term id="1269391">hopping window</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2182992">tetingkap lompat</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26174_1269396_2214694"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A hopping window whose hop size is equal to the window size.</descrip></descripGrp><ntig><termGrp><term id="1269396">tumbling window</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2214694">tetingkap guling</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26175_1269405_2209542"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A software module or routine that modifies the events (data) into a format expected by the output device, and emits the data to that device.</descrip></descripGrp><ntig><termGrp><term id="1269405">software transformer</term><termNote type="partOfSpeech">Noun</termNot