Selected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21089_766591_1183189"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A recognition feature that helps increase input speed and reduce effort by providing users with word completion and next word prediction alternates as the user is writing/typing.</descrip></descripGrp><ntig><termGrp><term id="766591">text prediction</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1183189">ramalan teks</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21091_766598_1183190"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An extension of the conventional touch input feature to allow multiple fingers touching the computer or device screen at the same time.</descrip></descripGrp><ntig><termGrp><term id="766598">multi-touch input</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1183190">input berbilang sentuhan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21091_766861_1183190"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An extension of the conventional touch input feature to allow multiple fingers touching the computer or device screen at the same time.</descrip></descripGrp><ntig><termGrp><term id="766861">multi-touch gesture</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1183190">input berbilang sentuhan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21092_1042217_1183191"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A multi-touch gesture that consists of one or two fingers moving in the same direction, parallel to each other.</descrip></descripGrp><ntig><termGrp><term id="1042217">pan</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1183191">pendar</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21092_766600_1183191"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A multi-touch gesture that consists of one or two fingers moving in the same direction, parallel to each other.</descrip></descripGrp><ntig><termGrp><term id="766600">panning</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1183191">pendar</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21093_766602_1183192"><langSet xml:lang="en-US"><descripGrp><descrip typ