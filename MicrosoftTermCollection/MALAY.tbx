<termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15161_234965_2121522"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A span of time during which the financial activities of an organization are calculated. A fiscal year is divided into fiscal periods, typically defined as semesters, quarters, or months. The organization determines the dates that begin and end its fiscal year, which may not correspond to a traditional calendar year.</descrip></descripGrp><ntig><termGrp><term id="234965">fiscal year</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2121522">tahun fiskal</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15171_460668_2121436"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A report in the Microsoft Dynamics CRM user interface that provides a table showing each competitor, the number of open opportunities and closed opportunities against each competitor, and the percentage and ratio of won and lost opportunities.</descrip></descripGrp><ntig><termGrp><term id="460668">Competitor Win Loss</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2121436">Menang Kalah Pesaing</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15174_169024_2184783"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In a media set using tape backup devices, the first tape in a media family.</descrip></descripGrp><ntig><termGrp><term id="169024">initial tape</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2184783">pita awal</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15180_536905_1299072"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A specification that describes the complex types used in a Web method and thereby enables interoperability between clients and Web services built on different platforms by adhering to a common type system, as defined by the W3C.</descrip></descripGrp><ntig><termGrp><term id="536905">XML Schema Document</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1299072">Dokumen Skema XML</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15181_84318_1299073"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A link between a user's computer and a group of computers and other devices that enables the user to access printers, servers etc. The link can be through a wire, cable, phone line or wireless transmissions.</descrip></descripGrp><ntig><termGrp><term id="84318">network connection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1299073">sambungan rangkaian</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15184_181564_2205193"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The blueprint for a report before the report is processed or rendered. A report definition contains information about the query and layout for the report.</descrip></descripGrp><ntig><termGrp><term id="181564">report definition</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2205193">definisi laporan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1519_537281_1294503"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An ordered sequence of properties that define an environment for the objects resident inside it. Contexts are created during the activation process for objects that are configured to require certain automatic services such as synchronization, transactions, just-in-time activation, security, and so on. Multiple objects can live inside a context.</descrip></descripGrp><ntig><termGrp><term id="537281">context</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1294503">konteks</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15190_235033_444503"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A device that creates or initiates requests or events.</descrip></descripGrp><ntig><termGrp><term id="235033">initiator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="444503">pemula</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15201_36468_443456"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to a product that can work with or is equivalent to another product.</descrip></descripGrp><ntig><termGrp><term id="36468">compatible</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="443456">serasi</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15203_252114_1299074"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A high-level description of how the solution will meet goals and requirements.</descrip></descripGrp><ntig><termGrp><term id="252114">solution concept</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><lan