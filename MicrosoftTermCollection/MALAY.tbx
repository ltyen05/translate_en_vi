"definition">A soft keyboard that is displayed with a different set of settings by default (larger buttons, bigger size, etc.) when you launch the Tablet PC Input Panel with touch. This is to facilitate touch input.</descrip></descripGrp><ntig><termGrp><term id="1056351">touch keyboard</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1183301">papan kekunci sentuh</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22945_1056352_2776753"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft hosted version of Windows SharePoint Services, the Microsoft-hosted solution that helps employees create and manage custom team and project-focused intranet sites for collaboration and document sharing.</descrip></descripGrp><ntig><termGrp><term id="1056352">Microsoft SharePoint Online</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2776753">SharePoint</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22945_2773098_2776753"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft hosted version of Windows SharePoint Services, the Microsoft-hosted solution that helps employees create and manage custom team and project-focused intranet sites for collaboration and document sharing.</descrip></descripGrp><ntig><termGrp><term id="2773098">SharePoint</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2776753">SharePoint</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22951_1056450_1183302"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A two-way device provided by a cable provider that enables some one-way digital CableCARD-based consumer electronic devices such as high-definition DVRs and Media Center PCs to access digital cable channels delivered using switched digital video.</descrip></descripGrp><ntig><termGrp><term id="1056450">tuning adapter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1183302">TA</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22951_1056452_1183302"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A two-way device provided by a cable provider that enables some one-way digital CableCARD-based consumer electronic devices such as high-definition DVRs and Media Center PCs to access digital cable channels delivered using switched digital video.</descrip></descripGrp><ntig><termGrp><term id="1056452">TA</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1183302">TA</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22963_1056673_2519507"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A verbose, English-like compiled programming language developed between 1959 and 1961 and still in widespread use today, especially in business applications typically run on mainframes. A COBOL program consists of an Identification Division, which specifies the name of the program and contains any other documentation the programmer wants to add; an Environment Division, which specifies the computers being used and the files used in the program for input and output; a Data Division, which describes the format of the data structures used in the program; and a Procedure Division, which contains the procedures that dictate the actions of the program.</descrip></descripGrp><ntig><termGrp><term id="1056673">COBOL</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2519507">COBOL</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22963_1056674_2519507"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A verbose, English-like compiled programming language developed between 1959 and 1961 and still in widespread use today, especially in business applications typically run on mainframes. A COBOL program consists of an Identification Division, which specifies the name of the program and contains any other documentation the programmer wants to add; an Environment Division, which specifies the computers being used and the files used in the program for input and output; a Data Division, which describes the format of the data structures used in the program; and a Procedure Division, which contains the procedures that dictate the actions of the program.</descrip></descripGrp><ntig><termGrp><term id="1056674">Common Business-Oriented Language</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2519507">COBOL</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22964_1056675_1301348"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A specification developed by the Object Management Group in 1992 in which pieces of programs (objects) communicate with other objects in other programs, even if the two programs are written in different programming languages and are running on different platforms. A program makes its request for objects through an object request broker, or ORB, and thus does not need to know the structure of the program from which the object comes. CORBA is designed to work in object-oriented environments.</descrip></descripGrp><ntig><termGrp><term id="1056675">CORBA</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1301348">CORBA</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22964_1056676_1301348"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A specification developed by the Object Management Group in 1992 in which pieces of programs (objects) communicate with other objects in other programs, even if the two programs are written in different programming languages and are running on different platforms. A program makes its request for objects through an object request broker, or ORB, and thus does not need to know the structure of the program from which the object comes. CORBA is designed to work in object-oriented environments.</descrip></descripGrp><ntig><termGrp><term id="1056676">Common Object Request Broker Architecture</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1301348">CORBA</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22975_1056711_1994690"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A small, affordable laptop that is designed to perform a limited number of tasks such as web browsing and email.</descrip></descripGrp><ntig><termGrp><term id="1056711">netbook</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1994690">komputer buku</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22975_1099729_1994690"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A small, affordable laptop that is designed to perform a limited number of tasks such as web browsing and email.</descrip></descripGrp><ntig><termGrp><term id="1099729">small notebook PC</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1994690">komputer buku</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2298_69826_1294537"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A snap-in for MMC used to manage many IIS 5.0 Web sites from a single location anywhere on the Internet. With this snap-in, you can create Web sites and virtual directories. You can also set levels of permission, fine-tune logging, and enable throttling.</descrip></descripGrp><ntig><termGrp><term id="69826">Internet Services Manager</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1294537">Pengurus Perkhidmatan Internet</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22986_1056874_2356984"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A distributed system of servers deployed in multiple data centers that cache content from origin servers and then serve it to customers. This action reduces the load on the origin servers and provides high- availability and performance to customers.</descrip></descripGrp><ntig><termGrp><term id="1056874">CDN</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2356984">CDN</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22986_1056874_2356985"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A distributed system of servers deployed in multiple data centers that cache content from origin servers and then serve it to customers. This action reduces the load on the origin servers and provides high- availability and performance to customers.</descrip></descripGrp><ntig><termGrp><term id="1056874">CDN</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2356985">penghantaran kandungan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22986_1056875_2356984"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A distributed system of servers deployed in multiple data centers that cache content from origin servers and then serve it to customers. This action reduces the load on the origin servers and provides high- availability and performance to customers.</descrip></descripGrp><ntig><termGrp><term id="1056875">content delivery network</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2356984">CDN</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22986_1056875_2356985"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A distributed system of servers deployed in multiple data centers that cache content from origin servers and then serve it to customers. This action reduces the load on the origin servers and provides high- availability and performance to customers.</descrip></descripGrp><ntig><termGrp><term id="1056875">content delivery network</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2356985">penghantaran kandungan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2299_232415_444435"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A message that appears at a specified interval before an appointment, meeting, or task that announces when the activity is set to occur.</descrip></descripGrp><ntig><termGrp><term id="232415">reminder</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="444435">peringatan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22992_1056886_1183303"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A real-time, physical action applied to an object, in which multiple contact points are used simultaneously.</descrip></descripGrp><ntig><termGrp><term id="1056886">multitouch</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1183303">berbilang sentuh</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22992_1056887_1183303"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A real-time, physical action applied to an object, in which multiple contact points are used simultaneously.</descrip></descripGrp><ntig><termGrp><term id="1056887">multi-touch</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1183303">berbilang sentuh</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22999_1056909_2207892"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to the automation of user actions or the configuration of a standard state on a computer by means of scripts.</descrip></descripGrp><ntig><termGrp><term id="1056909">scripting</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2207892">penskripan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2301_314116_2213558"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An amount that is the difference between the sum of debit entries and the sum of credit entries entered into an account during a financial period.</descrip></descripGrp><ntig><termGrp><term id="314116">account balance</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2213558">baki</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2301_314116_444844"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An amount that is the difference between the sum of debit entries and the sum of credit entries entered into an account during a financial period.</descrip></descripGrp><ntig><termGrp><term id="314116">account balance</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="444844">baki akaun</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2301_616949_2213558"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An amount that is the difference between the sum of debit entries and the sum of credit entries entered into an account during a financial period.</descrip></descripGrp><ntig><termGrp><term id="616949">balance</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2213558">baki</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2301_616949_444844"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An amount that is the difference between the sum of debit entries and the sum of credit entries entered into an account during a financial period.</descrip></descripGrp><ntig><termGrp><term id="616949">balance</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="444844">baki akaun</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2302_252671_1294538"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A point in the product cycle when the code does not generate errors that break a build.</descrip></descripGrp><ntig><termGrp><term id="252671">zero defect state</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1294538">keadaan kesilapan sifar</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23043_1057319_1183304"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A device used to write CD-ROMs. Because a disc can be written only once on these machines, they are used most commonly to create CD-ROMs for data archives or to produce CD-ROM masters that can be duplicated for mass distribution.</descrip></descripGrp><ntig><termGrp><term id="1057319">CD recorder</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1183304">pembakar CD</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23043_1057320_1183304"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A device used to write CD-ROMs. Because a disc can be written only once on these machines, they are used most commonly to create CD-ROMs for data archives or to produce CD-ROM masters that can be duplicated for mass distribution.</descrip></descripGrp><ntig><termGrp><term id="1057320">CD burner</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1183304">pembakar CD</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23047_1057412_2174954"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of grouping data into specific bins or groups according to defined criteria.</descrip></descripGrp><ntig><termGrp><term id="1057412">data binning</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2174954">pengasingan data</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23055_1057442_2519503"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of transistor in which the flow of current between the source and the drain is modulated by the electric field around the gate electrode. FETs are used as amplifiers, oscillators, and switches and are characterized by an extremely high input impedance (resistance) that makes them particularly suitable for amplification of very small signals. Types of FETs include the junction FET and the metal-oxide semiconductor FET (MOSFET).</descrip></descripGrp><ntig><termGrp><term id="1057442">FET</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2519503">FET</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23055_1057443_2519503"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of transistor in which the flow of current between the source and the drain is modulated by the electric field around the gate electrode. FETs are used as amplifiers, oscillators, and switches and are characterized by an extremely high input impedance (resistance) that makes them particularly suitable for amplification of very small signals. Types of FETs include the junction FET and the metal-oxide semiconductor FET (MOSFET).</descrip></descripGrp><ntig><termGrp><term id="1057443">field-effect transistor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2519503">FET</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23058_1057563_1301349"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A measure of the speed at which a computer can perform floating-point operations.</descrip></descripGrp><ntig><termGrp><term id="1057563">FLOPS</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1301349">FLOPS</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23058_1057565_1301349"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A measure of the speed at which a computer can perform floating-point operations.</descrip></descripGrp><ntig><termGrp><term id="1057565">floating-point operations per second</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1301349">FLOPS</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23059_1057571_1301350"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A circuit that performs floating-point calculations.</descrip></descripGrp><ntig><termGrp><term id="1057571">FPU</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1301350">FPU</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23059_1057573_1301350"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A circuit that performs floating-point calculations.</descrip></descripGrp><ntig><termGrp><term id="1057573">floating-point unit</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1301350">FPU</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23068_1057655_1679518"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Web analytics report that identifies terms that should become Best Bets.</descrip></descripGrp><ntig><termGrp><term id="1057655">Best Bet Suggestions report</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1679518">Laporan Cadangan Pilihan Terbaik</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23092_1058116_1183305"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that ensures that all components of a file are preserved, even if they are supported only by the rich client and not viewable in Web Companions.</descrip></descripGrp><ntig><termGrp><term id="1058116">Document Integrity</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1183305">Integriti Dokumen</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23093_1058130_1521557"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that simplifies the task of creating new SharePoint data. It makes it easier for users to enter free-form information or add photos, Web Parts or files to a SharePoint page.</descrip></descripGrp><ntig><termGrp><term id="1058130">Web Edit</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1521557">Edit Web</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23106_1058324_1301351"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application server framework from Sun Microsystems, Inc., for the development of distributed applications. It includes all the previous Java APIs targeted for multitiered distributed enterprise information systems. The J2EE platform consists of a set of services, application programming interfaces (APIs), and protocols that provide the functionality for developing multitiered, Web-based applications.</descrip></descripGrp><ntig><termGrp><term id="1058324">J2EE</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1301351">J2EE</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23106_1058325_1301351"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application server framework from Sun Microsystems, Inc., for the development of distributed applications. It includes all the previous Java APIs targeted for multitiered distributed enterprise information systems. The J2EE platform consists of a set of services, application programming interfaces (APIs), and protocols that provide the functionality for developing multitiered, Web-based applications.</descrip></descripGrp><ntig><termGrp><term id="1058325">Java 2 Platform Enterprise Edition</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1301351">J2EE</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2314_117926_1182943"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To change between states or modes.</descrip></descripGrp><ntig><termGrp><term id="117926">switch</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1182943">tukar</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23154_1060415_2519488"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A common type of field-effect transistor in which a layer of silicon dioxide insulates the metal gate from the semiconductor current channel. MOSFETs have extremely high input impedance and therefore require almost no driving power. They are used in many audio applications, including high-gain amplifier circuits. Like all metal-oxide semiconductor (MOS) devices, MOSFETs are easily damaged by static electricity.</descrip></descripGrp><ntig><termGrp><term id="1060415">MOSFET</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2519488">MOSFET</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23154_1060416_2519488"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A common type of field-effect transistor in which a layer of silicon dioxide insulates the metal gate from the semiconductor current channel. MOSFETs have extremely high input impedance and therefore require almost no driving power. They are used in many audio applications, including high-gain amplifier circuits. Like all metal-oxide semiconductor (MOS) devices, MOSFETs are easily damaged by static electricity.</descrip></descripGrp><ntig><termGrp><term id="1060416">metal-oxide semiconductor field-effect transistor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2519488">MOSFET</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23155_1060417_1521469"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A team site template that provides group collaboration capabilities based on standard business practices. Integrated functions include a group calendar, Whereabouts, Announcements, Phone Call Memo, and Schedule and Reservations.</descrip></descripGrp><ntig><termGrp><term id="1060417">Group Work Site</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1521469">Laman Kerja Kumpulan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23155_1060942_1521469"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A team site template that provides group collaboration capabilities based on standard business practices. Integrated functions include a group calendar, Whereabouts, Announcements, Phone Call Memo, and Schedule and Reservations.</descrip></descripGrp><ntig><termGrp><term id="1060942">GroupBoard Workspace</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1521469">Laman Kerja Kumpulan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote typ