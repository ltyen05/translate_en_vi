cal variable that has been declared without an explicit data type declaration. The type is inferred from the initial value provided for the variable.</descrip></descripGrp><ntig><termGrp><term id="534930">type inference</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1295346">inferens jenis</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53441_3045240_3045999"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The root folder in Windows Explorer that shows recently used items.</descrip></descripGrp><ntig><termGrp><term id="3045240">Home</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="3045999">Utama</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53442_3045241_3046000"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature of Windows Enterprise E3 that automatically keeps Windows and Office software up to date on enrolled endpoints.</descrip></descripGrp><ntig><termGrp><term id="3045241">Windows Autopatch</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="3046000">Autotampal Windows</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53444_3045433_3045531"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The RPA mode where the automation is executed when users are in front of their computers. This is suitable when they want to automate tasks and processes at an individual level. The automation is often triggered manually whenever the user wants to run it. The process might require human interaction or decisions between steps.</descrip></descripGrp><ntig><termGrp><term id="3045433">attended</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="3045531">diawasi</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53445_3045434_3045532"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A sequence of actions in a flow.</descrip></descripGrp><ntig><termGrp><term id="3045434">block of actions</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="3045532">blok tindakan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53446_3045435_3045533"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process of enabling users to interact with web applications and components through UI elements. UI elements describe uniquely the web components that the action is going to handle.</descrip></descripGrp><ntig><termGrp><term id="3045435">browser automation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="3045533">automasi pelayar</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53447_3045436_3045534"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The AI Builder component that allows users to detect business cards and extract their information.</descrip></descripGrp><ntig><termGrp><term id="3045436">Business card reader</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="3045534">Pembaca kad perniagaan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53448_3045437_3045535"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A flow that is being called by the parent flow.</descrip></descripGrp><ntig><termGrp><term id="3045437">child flow</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="3045535">aliran anak</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53449_3045438_3045536"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A qualified lead that can become an account, a contact or an opportunity.</descrip></descripGrp><ntig><termGrp><term id="3045438">converted lead</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="3045536">bakal pelanggan yang ditukarkan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53450_3045439_3045537"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that improves models by raising confidence scores in AI Builder. Documents can be flagged by users and sent back to the training wizard queue for retraining if they didn't yield sufficient confidence scores when analyzed by AI Builder.</descrip></descripGrp><ntig><termGrp><term id="3045439">feedback loop</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="3045537">gelung maklum balas</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53451_3045440_3045538"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The prebuilt AI model in AI Builder that extracts key invoice data to help automate the processing of invoices.</descrip></descripGrp><ntig><termGrp><term id="3045440">Invoice processing</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="3045538">Pemprosesan invois</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53452_3045441_3045539"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Desktop flow execution where automation is happening locally through the console on the user's machine, in an attended mode.</descrip></descripGrp><ntig><termGrp><term id="3045441">local attended</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="3045539">diawasi secara setempat</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53453_3045442_3045540"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group that allows you to organize multiple machines together to help distribute your automation workload and optimize productivity.</descrip></descripGrp><ntig><termGrp><term id="3045442">machine group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="3045540">kumpulan mesin</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53454_3045443_3045541"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Power Automate app that allows you to connect your machine to the Power Automate cloud. It allows you to harness the full power of your robotic process automation (RPA).</descrip></descripGrp><ntig><termGrp><term id="3045443">machine-runtime app</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="3045541">aplikasi machine-runtime</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53455_3045444_3045542"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The custom AI model in AI Builder that can help expedite or automate business processes.</descrip></descripGrp><ntig><termGrp><term id="3045444">Object detection</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="3045542">Pengesanan objek</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53456_3045445_3045543"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A flow that calls another flow.</descrip></descripGrp><ntig><termGrp><term id="3045445">parent flow</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="3045543">aliran induk</term><termNote type="geographicalUsage">