279"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A service used to implement an authentication mechanism for your devices.</descrip></descripGrp><ntig><termGrp><term id="2614076">token service</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2618279">perkhidmatan token</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46478_2615085_2617010"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The security feature that protects your device by providing startup and runtime protections that the operating system can validate and report on.</descrip></descripGrp><ntig><termGrp><term id="2615085">System Guard</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2617010">Pelindung Sistem</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46479_2615093_2617018"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The remote attestation service that checks the health of Windows 10-based devices to allow or deny access to networks, apps, or services, based on whether devices prove to be healthy.</descrip></descripGrp><ntig><termGrp><term id="2615093">Windows Health Attestation Service</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2617018">Perkhidmatan Pengakuan Kesihatan Windows</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46481_2615123_2617007"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The area in Windows Defender Security Center that helps customers keep their devices refreshed and up to date with the latest version of Windows 10. Device health advisor monitors the device and provides information and recommendations in a Health report to address common issues with storage capacity, device drivers, battery life, or Windows Update.</descrip></descripGrp><ntig><termGrp><term id="2615123">Device performance &amp; health</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2617007">Prestasi &amp; kesihatan peranti</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="465_380990_1096515"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of users that can be created on a SharePoint site to manage permissions to the site and to provide an email distribution list for site users. A group can be used by many sites in one site collection.</descrip></descripGrp><ntig><termGrp><term id="380990">SharePoint group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1096515">kumpulan SharePoint</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4650_271523_1294663"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Windows SharePoint Services (WSS) site for each team project. A team project portal allows team members to store and share documents, reports, and information related to a specific team project.</descrip></descripGrp><ntig><termGrp><term id="271523">team project portal</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1294663">portal projek pasukan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46505_2618212_2618669"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tenant that consists of a central location and one or more satellite geo locations.</descrip></descripGrp><ntig><termGrp><term id="2618212">Multi-Geo tenant</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2618669">penyewa Berbilang Geo</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46509_2618259_2629594"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of standard procedures and strategies that are considered to be suitable for a par