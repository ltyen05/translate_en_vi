al environments.</descrip></descripGrp><ntig><termGrp><term id="1089508">environment template</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1301375">templat persekitaran</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23758_1089509_1301376"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application that enables a user to start, pause, stop, or create a snapshot of the virtual machines in an environment.</descrip></descripGrp><ntig><termGrp><term id="1089509">environment viewer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1301376">alat lihat persekitaran</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2376_57861_1294542"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process for automatic recovery of heap memory. Blocks of memory that had been allocated but are no longer in use are freed, and blocks of memory still in use may be moved to consolidate the free memory into larger blocks.</descrip></descripGrp><ntig><termGrp><term id="57861">garbage collection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1294542">koleksi sampah</term><termNote type="geographicalUsage">BRN, MYS</termNote><ter