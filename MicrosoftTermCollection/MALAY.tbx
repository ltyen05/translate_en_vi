_443210"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A communications device that converts between digital data from a computer or terminal and analog audio signals that can pass through a standard telephone line.</descrip></descripGrp><ntig><termGrp><term id="2912">modulator/demodulator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="443210">modem</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6886_2912_443211"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A communications device that converts between digital data from a computer or terminal and analog audio signals that can pass through a standard telephone line.</descrip></descripGrp><ntig><termGrp><term id="2912">modulator/demodulator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="443211">pemodulat/penyahmodulat</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="689_108242_443928"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">On the IBM PC/XT and AT and compatible keyboards, a key on the top row of the numeric keypad that controls the effect of the cursor control keys and sometimes prevents the screen from scrolling. On the enhanced and Macintosh keyboards, this key is to the right of the function keys on the top row. Many modern applications ignore the S