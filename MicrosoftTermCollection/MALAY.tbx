an Masalah Windows Live</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27536_1380058_1461864"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">End-user operating system updates that support the use of selected current release technologies on previous versions of the Windows operating system.</descrip></descripGrp><ntig><termGrp><term id="1380058">Windows Platform Update</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1461864">Kemas Kini Platform Windows</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27536_1381790_1461864"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">End-user operating system updates that support the use of selected current release technologies on previous versions of the Windows operating system.</descrip></descripGrp><ntig><termGrp><term id="1381790">Platform Update for Windows Vista</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1461864">Kemas Kini Platform Windows</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27540_1380152_2174161"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A definitive and binding agreement between two trading partners for transacting messages over a specific business-to-business protocol. A trading partner agreement brings together common bi-directional message processing properties from specific business profiles of both partners. It is a comprehensive collection of all aspects governing the business transaction between the two trading partners. The trading partner agreement is typically derived from the profiles of each partner, with the ability to customize and override the required settings.</descrip></descripGrp><ntig><termGrp><term id="1380152">trading partner agreement</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2174161">perjanjian</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27540_2035526_2174161"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A definitive and binding agreement between two trading partners for transacting messages over a specific business-to-business protocol. A trading partner agreement brings together common bi-directional message processing properties from specific business profiles of both partners. It is a comprehensive collection of all aspects governing the business transaction between the two trading partners. The trading partner agreement is typically derived from the profiles of each partner, with the ability to customize and override the required settings.</descrip></descripGrp><ntig><termGrp><term id="2035526">agreement</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet x