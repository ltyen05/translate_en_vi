"definition">The secure, enterprise-grade solution that unlocks supply chain resiliency. It seamlessly unifies data from existing supply chain systems and ERPs into Microsoft Dataverse, where it is transformed to provide end to end visibility of the supply chain, generate actionable insights, and predict and mitigate potential disruptions.</descrip></descripGrp><ntig><termGrp><term id="3100135">Supply Chain Center</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="3100203">Supply Chain Center</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54564_3100233_3100546"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows organizations using Teams Phone to assign one calling plan across multiple users.</descrip></descripGrp><ntig><termGrp><term id="3100233">shared calling</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="3100546">panggilan kongsi</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54565_3100234_3100548"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in Microsoft Teams meetings that allows participants to augment their video stream with visual effects, such as make up, styles and frames.</descrip></descripGrp><ntig><termGrp><term id="3100234">video filters</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="3100548">penapis video</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54566_3100235_3100547"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that provides a personal meeting stage configuration that keeps sign language interpreters and other signers in a consistent, central location with the highest available video quality throughout the meeting.</descrip></descripGrp><ntig><termGrp><term id="3100235">sign language view</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="3100547">pandangan bahasa isyarat</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54567_3100236_3100545"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows IT admins to create policies for specific priority users (C-Suite) that filter out unwanted communication.</descrip></descripGrp><ntig><termGrp><term id="3100236">priority account chat control</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="3100545">kawalan sembang akaun keutamaan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54568_3100237_3100543"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows IT admins to customize backgrounds for licensed users in an organization.</descrip></descripGrp><ntig><termGrp><term id="3100237">organization meeting background</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="3100543">latar belakang mesyuarat organisasi</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54569_3100238_3100544"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows IT admins to customize Together Mode scenes for licensed users in an organization.</descrip></descripGrp><ntig><termGrp><term id="3100238">organization together mode scene</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="3100544">adegan mod bersama organisasi</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54580_3100695_3101151"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The retail media advertising platform that connects brands with the world's largest retailers and their active shoppers.</descrip></descripGrp><ntig><termGrp><term id="3100695">PromoteIQ</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="3101151">PromoteIQ</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54581_3100752_3101147"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app that integrates the most common PC/desktop management functions: virus inspection, trash cleaning, system repair/upgrade, system optimization, application management, pop-up blocking.</descrip></descripGrp><ntig><termGrp><term id="3100752">PC Manager</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="3101147">Pengurus PC</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54582_3100753_3101149"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature within the PC Manager app that boosts PC performance by freeing memory.</descrip></descripGrp><ntig><termGrp><term id="3100753">PC Boost</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="3101149">Penggalak PC</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54583_3100754_3101148"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature within the PC Manager app that protects the operational system default browser settings from unexpected changes.</descrip></descripGrp><ntig><termGrp><term id="3100754">Browser Protection</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="3101148">Perlindungan Pelayar</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54587_3113361_3114062"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft Entra product that enables securing and managing workloads, such as applications, service principals, managed identities and other software components that need to access cloud resources.</descrip></descripGrp><ntig><termGrp><term id="3113361">Microsoft Entra Workload ID</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="3114062">Microsoft Entra Workload ID</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54587_3113361_3114063"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft Entra product that enables securing and managing workloads, such as applications, service principals, managed identities and other software components that need to access cloud resources.</descrip></descripGrp><ntig><termGrp><term id="3113361">Microsoft Entra Workload ID</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="3114063">Workload ID</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54587_3113362_3114062"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft Entra product that enables securing and managing workloads, such as applications, service principals, managed identities and other software components that need to access cloud resources.</descrip></descripGrp><ntig><termGrp><term id="3113362">Workload ID</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="3114062">Microsoft Entra Workload ID</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54587_3113362_3114063"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft Entra product that enables securing and managing workloads, such as applications, service principals, managed identities and other software components that need to access cloud resources.</descrip></descripGrp><ntig><termGrp><term id="3113362">Workload ID</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="3114063">Workload ID</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54588_3101395_3102015"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The unity add-in that enables Microsoft Mesh users to upload custom environment templates to suit corporate events and meetings or create digital twins to match real-world environments in Mesh Spaces and Events.</descrip></descripGrp><ntig><termGrp><term id="3101395">Mesh Toolkit</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="3102015">Kit Alat Mesh</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5459_137154_1987815"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of rights that allows a user to modify all web site content and manage site settings and accounts.</descrip></descripGrp><ntig><termGrp><term id="137154">administrator role</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1987815">peranan pentadbir</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54591_3101398_3102012"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A strategy for fact checking an unfamiliar online source by leaving the webpage and opening a new browser tab to see what additional websites say about the unknown source.</descrip></descripGrp><ntig><termGrp><term id="3101398">lateral reading</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="3102012">pembacaan sisian</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54592_3101451_3101752"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A layout control which helps to lay out an array of objects in a predefined three-dimensional shape. It supports various surface styles, such as plane, cylinder, sphere, and radial. The radius and size of the objects and the space between them can be adjusted.</descrip></descripGrp><ntig><termGrp><term id="3101451">3D object collection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="3101752">koleksi objek 3D</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54593_3101452_3101753"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in Dynamics 365 Guides on HoloLens that allows user and remote collaborator annotate in the environment while on the call. Annotations are useful for pointing out different parts of the space, including parts that may be difficult or dangerous to reach. All call participants can see each others’ additions, and can make their own annotations.</descrip></descripGrp><ntig><termGrp><term id="3101452">annotation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="3101753">anotasi</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54594_3101453_3101754"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An anchor in Dynamics 365 Guides used to align guide by gazing at a printed circular code anchor that's attached to a physical object in the real world.</descrip></descripGrp><ntig><termGrp><term id="3101453">circular code anchor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="3101754">sauh kod membulat</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54595_3101454_3101755"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An anchor in Dynamics 365 Guides used to align guide to a digital 3D hologram that's overlaid on a physical object in the real world.</descrip></descripGrp><ntig><termGrp><term id="3101454">holographic anchor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="3101755">sauh holografik</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54596_3101455_3101756"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of anchor in Dynamics 365 Guides that represents a position and orientation relative to a real-world object in an environment. It provides a common frame of reference that allows to place digital content in the same physical location of a real-world object.</descrip></descripGrp><ntig><termGrp><term id="3101455">object anchor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="3101756">sauh objek</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54597_3101456_3101757"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An anchor in Dynamics 365 Guides used to align guide by gazing at a printed QR code anchor that's attached to a physical object in the real world. QR code anchoring is recommended for small to medium-size objects and spaces because it's the most accurate method, and the anchor can be printed at different sizes.</descrip></descripGrp><ntig><termGrp><term id="3101456">QR code anchor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="3101757">sauh kod QR</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54598_3101457_3101758"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in Microsoft Dynamics 365 Remote Assist that enables to capture and annotate a part of the environment during a call. Users can save the snapshot to their mobile device gallery, the in-call text chat, or both.</descrip></descripGrp><ntig><termGrp><term id="3101457">snapshot</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="3101758">petikan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54599_3101458_3101759"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A central building block for creating a guide in Microsoft Dynamics 365 Guides. After creating the structure for guide in the Outline page, Step Editor will need to be used to add instructional text and 3D models or media to support the step.</descrip></descripGrp><ntig><termGrp><term id="3101458">step</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="3101759">langkah</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54600_3102395_3102710"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft Purview feature that combines the risk scoring and user-activity approach of Insider Risk Management, with the data protection capabilities from Microsoft DLP.</descrip></descripGrp><ntig><termGrp><term id="3102395">Adaptive Protection</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="3102710">Perlindungan Penyesuaian</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54601_3102396_3102712"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The marketing handle for Threat Intelligence research, content, and resources that serves as a center for teams that collaborate across product engineering, data science, policy, legal, and security services to apply research methods and analysis to protect customers through Microsoft products and services.</descrip></descripGrp><ntig><termGrp><term id="3102396">Microsoft Threat Intelligence</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="3102712">Kecerdasan Ancaman Microsoft</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54601_3102396_3102714"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The marketing handle for Threat Intelligence research, content, and resources that serves as a center for teams that collaborate across product engineering, data science, policy, legal, and security services to apply research methods and analysis to protect customers through Microsoft products and services.</descrip></descripGrp><ntig><termGrp><term id="3102396">Microsoft Threat Intelligence</term><termNote type="partOfSpeech"