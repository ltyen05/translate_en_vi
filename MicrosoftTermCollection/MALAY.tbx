<descripGrp><descrip type="definition">A set of design tools in Visual Studio 2005 Team Architect Edition that help reduce the complexity of developing and deploying service-oriented applications.</descrip></descripGrp><ntig><termGrp><term id="187317">Distributed System Designer</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1299120">Pereka Sistem Teragih</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15895_134729_2216703"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To change a cube or dimension so that users in cube roles with read/write access to the cube or dimension can change its data.</descrip></descripGrp><ntig><termGrp><term id="134729">write enable</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2216703">dayakan penulisan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15898_494902_1299121"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A transaction where items go out of inventory.</descrip></descripGrp><ntig><termGrp><term id="494902">inventory decrease</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1299121">susutan</term><termNote type="geographicalUsage">BRN, MYS</ter