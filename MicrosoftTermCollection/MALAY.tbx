and designed to deliver intelligent, automated, and integrated security across domains to help defenders connect seemingly disparate alerts and get ahead of attackers.</descrip></descripGrp><ntig><termGrp><term id="3013005">XDR</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="3013933">XDR</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53007_3013006_3013914"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A common user identity for authentication and authorization to all resources, regardless of location.</descrip></descripGrp><ntig><termGrp><term id="3013006">hybrid identity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="3013914">identiti hibrid</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53008_3013008_3013921"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A diagram used to visually organize information, showing relationships among pieces of the whole.</descrip></descripGrp><ntig><termGrp><term id="3013008">mind map</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="3013921">peta minda</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53009_3013009_3013903"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To prevent a person's identity from being connected with information pertaining to him/her.</descrip></descripGrp><ntig><termGrp><term id="3013009">de-identify</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="3013903">nyahidentiti</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5301_185063_1677984"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A UI element that opens the Options dialog box, where the user can change Lync or Communicator settings and preferences.</descrip></descripGrp><ntig><termGrp><term id="185063">Options</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1677984">Opsyen</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53010_3013010_3013908"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A constraint on the algorithms used to publish aggregate information about a statistical database which limits the privacy impact on individuals whose information is in the database.</descrip></descripGrp><ntig><termGrp><term id="3013010">differential privacy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="3013908">dasar pembezaan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53011_3013183_3020117"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A profile that a user can create in Microsoft Cloud for Sustainability to check the volume of greenhouse gases that result from an operational activity. The profile contains the settings needed to run the calculation, and includes the calculation model.</descrip></descripGrp><ntig><termGrp><term id="3013183">calculation profile</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="3020117">profil pengiraan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53012_3013184_3020118"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A legal document evidencing the agreement between the parties.</descrip></descripGrp><ntig><termGrp><term id="3013184">contractual instrument</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="3020118">instrumen kontraktual</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53013_3013185_3020119"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A value that relates the amount of pollution generated and the activity associated with the generation of that pollution.</descrip></descripGrp><ntig><termGrp><term id="3013185">emission factor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="3020119">faktor pengeluaran</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53014_3013186_3020120"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Power BI app published through AppSource and used to demonstrate the energy and carbon efficiency of Microsoft cloud services through a Power BI dashboard. The app provides individual customers with Carbon footprint and GHG emissions associated with their current Azure and Dynamics 365 subscription(s) in comparison with the estimated footprint of on-premises alternatives.</descrip></descripGrp><ntig><termGrp><term id="3013186">Emissions Impact Dashboard</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="3020120">Papan Pemuka Kesan Pengeluaran</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53015_3013187_3020121"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A direct release to the atmosphere of greenhouse gas compounds from various types of equipment and processes.</descrip></descripGrp><ntig><termGrp><term id="3013187">fugitive emission</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="3020121">pengeluaran fugitif</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53016_3013188_3020122"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The cloud offering that helps companies measure, understand and take charge of their carbon emissions, set sustainability goals and take measurable action.</descrip></descripGrp><ntig><termGrp><term id="3013188">Microsoft Cloud for Sustainability</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="3020122">Microsoft Cloud for Sustainability</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53017_3013189_3020123"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An emission from the combustion of fossil fuels used in the operation of vehicles or other forms of mobile transportation.</descrip></descripGrp><ntig><termGrp><term id="3013189">mobile combustion</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="3020123">pembakaran bergerak</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53018_3013190_3020124"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An emission from the combustion of fuels used in the operation of power plants, industrial combustion plants, etc.</descrip></descripGrp><ntig><termGrp><term id="3013190">stationary combustion</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="3020124">pembakaran tidak bergerak</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53019_3013191_3020125"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A report that shows the effects that an organization's business operations have on the environment.</descrip></descripGrp><ntig><termGrp><term id="3013191">sustainability report</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="3020125">laporan kelestarian</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5303_76437_2998483"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In mathematics, the power to which a base must be raised to equal a given number. For example, for the base 10, the logarithm of 16 is (approximately) 1.2041 because 101.2041 equals (approximately) 16. Both natural logarithms (to the base e, which is approximately 2.71828) and common logarithms (to the base 10) are used in programming. Languages such as C and Basic include functions for calculating natural logarithms.</descrip></descripGrp><ntig><termGrp><term id="76437">logarithm</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2998483">logaritma</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53031_3014789_3059635"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Azure offering that supports Azure Virtual Desktop on Azure Stack HCI.</descrip></descripGrp><ntig><termGrp><term id="3014789">Azure Virtual Desktop on Azure Stack HCI</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="3059635">Azure Virtual Desktop pada Azure Stack HCI</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53031_3014789_3059639"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Azure offering that supports Azure Virtual Desktop on Azure Stack HCI.</descrip></descripGrp><ntig><termGrp><term id="3014789">Azure Virtual Desktop on Azure Stack HCI</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig>