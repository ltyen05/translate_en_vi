"286_616490_1294431"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">On Windows-based computers, a user account that is a member of the computer’s local Administrators group or a member of a group that is a member of the local Administrators group, such as the Domain Admins group in a Windows domain. This is the first account that is created when you install an operating system on a new workstation, stand-alone server, or member server. By default, this account has the highest level of administrative access to the local computer.</descrip></descripGrp><ntig><termGrp><term id="616490">administrator</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1294431">akaun pentadbir terbina dalam</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="286_624589_1294431"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">On Windows-based computers, a user account that is a member of the computer’s local Administrators group or a member of a group that is a member of the local Administrators group, such as the Domain Admins group in a Windows domain. This is the first account that is created when you install an operating system on a new workstation, stand-alone server, or member server. By default, this account has the highest level of administrative access to the local computer.</descrip></descripGrp><ntig><termGrp><term id="624589">built-in administrator account</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1294431">akaun pentadbir terbina dalam</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="286_624618_1294431"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">On Windows-based computers, a user account that is a member of the computer’s local Administrators group or a member of a group that is a member of the local Administrators group, such as the Domain Admins group in a Windows domain. This is the first account that is created when you install an operating system on a new workstation, stand-alone server, or member server. By default, this account has the highest level of administrative access to the local computer.</descrip></descripGrp><ntig><termGrp><term id="624618">built-in administrator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1294431">akaun pentadbir terbina dalam</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28619_1489914_1846532"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to a request for payment.</descrip></descripGrp><ntig><termGrp><term id="1489914">billing</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1846532">pengebilan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2865_19878_443326"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The special identification code printed as a set of vertical bars of differing widths on books, grocery products, and other merchandise. Used for rapid, error-free input in such facilities as libraries, hospitals, and grocery stores, bar codes represent binary information that can be read by an optical scanner. The coding can include numbers, letters, or a combination of the two; some codes include built-in error checking and can be read in either direction.</descrip></descripGrp><ntig><termGrp><term id="19878">bar code</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="443326">kod bar</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2865_237346_443326"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The special identification code printed as a set of vertical bars of differing widths on books, grocery products, and other merchandise. Used for rapid, error-free input in such facilities as libraries, hospitals, and grocery stores, bar codes represent binary information that can be read by an optical scanner. The coding can include numbers, letters, or a combination of the two; some codes include built-in error checking and can be read in either direction.</descrip></descripGrp><ntig><termGrp><term id="237346">barcode</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="443326">kod bar</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28691_1490094_2785919"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The offer from Microsoft Office 365 that provides a unified communications plan with advanced capabilities, including enterprise instant messaging, presence, and online meetings with audio and video conferencing and multiparty data sharing.</descrip></descripGrp><ntig><termGrp><term id="1490094">Lync Online (Plan 2)</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2785919">Lync Online (Pelan 2)</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28699_1490115_2920917"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A label for sealing packaging that makes it possible to tell if the package has been opened.</descrip></descripGrp><ntig><termGrp><term id="1490115">tamper label</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2920917">label perubahan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28707_1490215_2179989"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of servers that are in one location and that are networked together for the purpose of providing live backup in case one of the servers fails.</descrip></descripGrp><ntig><termGrp><term id="1490215">failover cluster</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2179989">gugusan gagal seluruh</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28719_1491626_2767043"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An act that has an effect in a system.</descrip></descripGrp><ntig><termGrp><term id="1491626">action</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2767043">tindakan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28720_1491627_2488732"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A definite magnitude of currency, a quantity of currency, or an indefinite magnitude of an uncountable substance or quality.</descrip></descripGrp><ntig><termGrp><term id="1491627">amount</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2488732">amaun</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28728_1491635_2372477"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The price of a quantity of product expressed in purchase units calculated from the sales unit price, multiplied by the product quantity in purchase units, divided by the sales unit quantity.</descrip></descripGrp><ntig><termGrp><term id="1491635">extended price</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2372477">harga lanjutan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28737_1491661_1915609"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A cloud infrastructure typically owned and managed by an organization that sells cloud services. The resources are shared by the general public or a group of customers in order to optimize utilization rates.</descrip></descripGrp><ntig><termGrp><term id="1491661">public cloud</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1915609">awan awam</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2874_12683_443282"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A software technique for smoothing the jagged appearance of curved or diagonal lines caused by poor resolution on a display screen by adjusting the brightness or color of surrounding pixels.</descrip></des