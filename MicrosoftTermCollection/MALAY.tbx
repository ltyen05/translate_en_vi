gular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="444817">Perlindungan Sistem</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1422_530443_2183053"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A field or group of fields that identify an entity as a unique object.</descrip></descripGrp><ntig><termGrp><term id="530443">identifying field</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2183053">medan pengecaman</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14223_536081_1298216"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The folder that contains the file or files to be copied or moved.</descrip></descripGrp><ntig><termGrp><term id="536081">source directory</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1298216">direktori sumber</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14232_231970_444424"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A chart that provides interactive analysis of data, like a PivotTable report. You can change views of data, see different levels of detail, or reorganize the chart layout by dragging fields and by showing or hiding items in fields.</descrip></descripGrp><ntig><termGrp><term id="231970">PivotChart report</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="444424">laporan Carta Pangsi</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14237_169312_2191679"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A database that functions as a backup of a primary database, receiving copies of every change to the primary database, and that can take over traffic if the primary database becomes unavailable.</descrip></descripGrp><ntig><termGrp><term id="169312">mirror database</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2191679">pangkalan data cermin</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14238_2822_443208"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A memory measurement unit that is equal to 1 million bytes.</descrip></descripGrp><ntig><termGrp><term id="2822">MB</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="443208">MB</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</te