as</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34376_1991486_2920525"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The cover that protects the hard drive bay in the absence of an attached hard drive.</descrip></descripGrp><ntig><termGrp><term id="1991486">hard drive bay cover</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2920525">penutup ruang pemacu keras</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34377_1991487_2920529"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The plug that connects the hard drive to the console.</descrip></descripGrp><ntig><termGrp><term id="1991487">hard drive connector</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2920529">penyambung pemacu keras</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34378_1991488_2920531"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The HDMI port on the back of the Xbox 360 console.</descrip></descripGrp><ntig><termGrp><term id="1991488">HDMI AV port</term><termNote type="partOfSpeech">Noun</termNote><termNote type=