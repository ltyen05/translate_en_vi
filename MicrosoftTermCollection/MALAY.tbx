9955">virtual reality</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2638762">VR</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14992_685431_2638762"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A simulated 3-D environment that a user can experience and manipulate as if it were physical. The user sees the environment on display screens, possibly mounted in a special pair of goggles. Special input devices, such as gloves or suits fitted with motion sensors, detect the user's actions.</descrip></descripGrp><ntig><termGrp><term id="685431">VR</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2638762">VR</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14994_397171_1987839"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A replication that uses a single server and built-in technology to create and maintain a copy of a storage group on a second set of disks that are connected to the same server as the primary storage group. LCR provides asynchronous log shipping, log replay, and a quick manual switch to a copy of the data.</descrip></descripGrp><ntig><termGrp><term id="397171">local continuous replication</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langS