pGrp><descrip type="definition">A folder or directory on a computer that is set up to be readable or writeable for certain users on other computers.</descrip></descripGrp><ntig><termGrp><term id="187650">network share</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1299100">kongsi rangkaian</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15549_316259_444859"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The output created in desktop publishing applications.</descrip></descripGrp><ntig><termGrp><term id="316259">publication</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="444859">terbitan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1555_187689_1294505"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The assignment of more than one function to a particular operator, with the implication that the operation performed will vary depending on the data type (operands) involved. Some languages, such as Ada and C++, specifically allow for operator overloading.</descrip></descripGrp><ntig><termGrp><term id="187689">operator overloading</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1294505">operator muatan berlebih</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15551_96356_443897"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of instructions for retrieving specific data from a large set, usually with multiple conditions. No list is displayed until you run the query.</descrip></descripGrp><ntig><termGrp><term id="96356">query</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="443897">pertanyaan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15554_464503_1299101"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A share that has been added to the Virtual Machine Manager library. To be available for use in creating virtual machines, a resource must be stored on a library share and must be added to the Virtual Machine Manager library. When a library server is added to Virtual Machine Manager, shares on the library server are automatically discovered.</descrip></descripGrp><ntig><termGrp><term id="464503">library share</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1299101">perkongsian pustaka</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1556_187963_1294506"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The tool that creates instances of a project's objects, calls their methods, and evaluates the results.</descrip></descripGrp><ntig><termGrp><term id="187963">Object Test Bench</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1294506">OTB</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1556_782319_1294506"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The tool that creates instances of a project's objects, calls their methods, and evaluates the results.</descrip></descripGrp><ntig><termGrp><term id="782319">OTB</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1294506">OTB</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15563_181853_2209507"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Schedule information that can be referenced by multiple items.</descrip></descripGrp><ntig><termGrp><term id="181853">shared schedule</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2209507">jadual dikongsi</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="pa