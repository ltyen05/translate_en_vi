Note><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24981_1248979_2121512"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A proprietary XML-based query language that is used in Microsoft Dynamics CRM to retrieve information.</descrip></descripGrp><ntig><termGrp><term id="1248979">FetchXML</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2121512">Ambil</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24981_1248979_2121513"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A proprietary XML-based query language that is used in Microsoft Dynamics CRM to retrieve information.</descrip></descripGrp><ntig><termGrp><term id="1248979">FetchXML</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2121513">FetchXML</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24987_1166123_1682827"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A defined point in a workflow that is entered when specified conditions are met.</descrip></descripGrp><ntig><termGrp><term id="1166123">workflow stage</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1682827">peringkat aliran kerja</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25_42999_443505"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In communications, the portion of a Data Terminal Equipment (DTE) device that sends data.</descrip></descripGrp><ntig><termGrp><term id="42999">data source</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="443505">sumber data</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2500_81423_1944927"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An individual who reviews content in certain online newsgroups, mailing lists, and forums in order to decide if they are appropriate or not, editing or deleting the ones that aren’t prior to them being they are made public.</descrip></descripGrp><ntig><termGrp><term id="81423">moderator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1944927">moderator</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25001_1166161_2188492"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The critical data of a business, such as customer, product, location, employee, and asset. Master data fall generally into four groupings: people, things, places, and concepts and can be further categorized. For example, within people, there are customer, employee, and salesperson. Within things, there are product, part, store, and asset. Within concepts, there are things like contract, warrantee, and licenses. Finally, within places, there are office locations and geographic divisions.</descrip></descripGrp><ntig><termGrp><term id="1166161">master data</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2188492">data induk</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25002_1166162_2214210"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Data related to sales, deliveries, invoices, trouble tickets, claims, and other monetary and non-monetary interactions.</descrip></descripGrp><ntig><termGrp><term id="1166162">transactional data</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2214210">data transaksi</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25004_1167216_2261975"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that uses speech recognition to enable you to interact with your computer or 