/termEntry><termEntry id="8445_418610_1677843"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The identity of the originator of an incoming call.</descrip></descripGrp><ntig><termGrp><term id="418610">caller ID</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1677843">ID Pemanggil</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8449_535389_2211309"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A filter available for all types of replication that allows you to restrict the data replicated to a Subscriber based on a WHERE clause.</descrip></descripGrp><ntig><termGrp><term id="535389">static row filter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2211309">penapis baris statik</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8450_181140_2189761"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The algorithm that uses a linear regression decision tree approach to analyze time-related data, such as monthly sales data or yearly profits. The patterns it discovers can be used to predict values for future time steps.</descrip></descripGrp><ntig><termGrp><term id="181140">Microsoft Time Series algorithm</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2189761">algoritma Siri Masa Microsoft</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8457_56244_2180998"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A cursor that cannot be scrolled; rows can be read only in sequence from the first row to the last row.</descrip></descripGrp><ntig><termGrp><term id="56244">forward-only cursor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2180998">kursor ke hadapan sahaja</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8461_530247_2175544"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The protocol for a delivery channel, such as Simple Mail Transfer Protocol (SMTP) or File.</descrip></descripGrp><ntig><termGrp><term id="530247">delivery channel type</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2175544">jenis saluran penghantaran</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8463_234077_1296212"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The plug-in that installs with Visual Studio or Eclipse and is used to manage work that is assigned to a user, a team, or the user's team projects, and to coordinate the efforts among team members to develop a project.</descrip></descripGrp><ntig><termGrp><term id="234077">Team Explorer</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1296212">Penjelajah Pasukan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8464_307372_444780"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A parameter in the Perlin Noise function which is used to scale the amount of force from the vector field that is applied to the images.</descrip></descripGrp><ntig><termGrp><term id="307372">turbulence force</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="444780">daya pergolakan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8472_105648_2206159"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In a cluster, the process of systematically upgrading cluster nodes one node at a time while the other nodes continue to provide service.</descrip></descripGrp><ntig><termGrp><term id="105648">rolling upgrade</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2206159">naik taraf berperingkat</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8474_138253_1183015"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The distance between the cells of a table or workbook.</descrip></descripGrp><ntig><termGrp><term id="138253">cell spacing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1183015">jarak sel</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8477_536608_1296213"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process in which the control submits the page when the user interacts with the control. (By default, only button controls cause a postback.) For example, if a DropDownList control is set to perform autopostback, the page is submitted as soon as a user selects an item from the list.</descrip></descripGrp><ntig><termGrp><term id="536608">autopostback</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1296213">autohantarkembali</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8478_85941_1448224"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A table, chart, graphi