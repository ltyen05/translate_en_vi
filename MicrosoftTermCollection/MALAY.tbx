ntry id="15118_536638_1299069"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An association between two server controls residing in a WebPartZoneBase zone that enables them to share data, with one control acting as the provider of data and the other control acting as the consumer. A connection is encapsulated within a System.Web.UI.WebControls.WebParts.WebPartConnection object.</descrip></descripGrp><ntig><termGrp><term id="536638">Web Parts connection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1299069">sambungan Bahagian Web</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15125_415472_1183081"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A special visual or sound effect added to text or an object. For instance, a user can have the text bullet points fly in from the left, one word at a time, or hear the sounds of applause when a picture is uncovered.</descrip></descripGrp><ntig><termGrp><term id="415472">animation effect</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1183081">kesan animasi</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15128_475201_2121457"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The account or contact with which a business unit conducts a business transaction.</descrip></descrip