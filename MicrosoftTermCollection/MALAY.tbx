efinition">In the Microsoft 365 admin center, a square area on the screen that opens an activity report, as an alternative to selecting the report from a drop-down menu.</descrip></descripGrp><ntig><termGrp><term id="2844104">activity widget</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2846576">widget aktiviti</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50289_2844105_2847211"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A globally unique identifier (GUID) for the Azure Active Directory for a particular tenant.</descrip></descripGrp><ntig><termGrp><term id="2844105">directory ID</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2847211">ID direktori</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50290_2844110_2846824"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office 365 connected experience that connects apps — Wunderlist, Facebook and Evernote, and Meetup — to the Outlook calendar so that the user can see all tasks, events, notes, etc., from these apps in the calendar.</descrip></descripGrp><ntig><termGrp><term id="2844110">Calendar apps</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><te