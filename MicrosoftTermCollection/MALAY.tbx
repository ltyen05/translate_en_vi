ech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35632_2045864_2048039"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A HIP challenge that requires a user to view an image and then type a set of characters contained in that image.</descrip></descripGrp><ntig><termGrp><term id="2045864">visual challenge</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2048039">cabaran visual</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35633_2045865_2048034"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A security task that a user must complete to verify they are a human and not a machine.</descrip></descripGrp><ntig><termGrp><term id="2045865">challenge</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2048034">cabaran</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35636_2277612_2280513"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Office 365 subscription service for nonprofit organizations (up to 5 PCs, Macs, or mobile devices) that includes Word, PowerPoint, Excel, Outlook, OneNote, Publisher, Access, and Lync.</descrip></descripGrp><ntig><termGrp><term id="2277612">Office 365 ProPlu