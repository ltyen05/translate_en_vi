try><termEntry id="17388_641215_1096541"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A task pane on a Web Part Page used to browse, search for, and import Web Parts from Web Part galleries, and to modify custom and common Web Part properties.</descrip></descripGrp><ntig><termGrp><term id="641215">tool pane</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1096541">anak tetingkap alat</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17389_641216_1096542"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A control in the tool pane that allows users to set properties, execute commands, invoke wizards, and manipulate Web Parts on a Web Part Page.</descrip></descripGrp><ntig><termGrp><term id="641216">tool part</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1096542">bahagian alat</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1739_149687_1182934"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A formula that checks whether a given value is valid for a particular field.</descrip></descripGrp><ntig><termGrp><term id="149687">validation formula</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1182934">formula pengesahsahihan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1739_149687_1186463"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A formula that checks whether a given value is valid for a particular field.</descrip></descripGrp><ntig><termGrp><term id="149687">validation formula</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1186463">formula pensahihan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17390_641217_1096338"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A low level of encryption that uses a 40-bit key to scramble the contents of a file or data packet to make the data unreadable without the decryption key.</descrip></descripGrp><ntig><termGrp><term id="641217">40-bit encryption</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1096338">penyulitan 40 bit</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17391_641218_1096337"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A high level of encryption that uses a 128-bit key to scramble the contents of a file or data packet to make the data unreadable without the decryption key.</descrip></descripGrp><ntig><termGrp><term id="641218">128-bit encryption</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1096337">penyulitan 128 bit</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17394_642189_1096379"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A database that stores service information for each portal site in a deployment.</descrip></descripGrp><ntig><termGrp><term id="642189">component settings database</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1096379">pangkalan data tetapan komponen</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17396_1104211_2121734"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A program whose function is to install another program, either on a storage medium or in memory. An installation program, also called a setup program, might be used to guide a user through the often complex process of setting up an application for a particular combination of machine, printer, and monitor.</descrip></descripGrp><ntig><termGrp><term id="1104211">setup program</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2121734">program persediaan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17397_645009_1301256"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A character used in a masked control when there is no user input to display.</descrip></descripGrp><ntig><termGrp><term id="645009">mask placeholder</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1301256">ruang letak topeng</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17398_645011_1301257"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A layout style in which adjacent items align against each other as though they were stacked, always taking up the free space in between the items.</descrip></descripGrp><ntig><termGrp><term id="645011">stack layout</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1301257">tataletak tindanan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17399_645012_1301258"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A layout style in which each end of the ToolStrip is the base of a stack, with some items stacked at the head and other items stacked at the tail. Items are stacked from the ends in.</descrip></descripGrp><ntig><termGrp><term id="645012">split stack layout</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1301258">tataletak tindanan cerai</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="174_138672_2726026"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A hierarchical organization of media clips that users can create, import, add additional clips collections to, move, or copy clips from one collection into it.</descrip></descripGrp><ntig><termGrp><term id="138672">clip collection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2726026">koleksi klip</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17400_645013_1301259"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The design-time access point to the Items Collection Editor for a ToolStrip, MenuStrip, ContextMenuStrip, or StatusStrip control.</descrip></descripGrp><ntig><termGrp><term id="645013">template node</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1301259">nod templat</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17401_645014_1301260"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of data binding in which a data-bound control retrieves only as many rows from the database as the user will be able to see on the screen.</descrip></descripGrp><ntig><termGrp><term id="645014">virtual-mode data binding</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1301260">jilidan data mod maya</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17402_645015_1301261"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A way of designing a form in which all elements are positioned one immediately after the other.</descrip></descripGrp><ntig><termGrp><term id="645015">flow layout</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1301261">tataletak aliran</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17405_645096_1301262"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of event that is generated after a series of events of another type have occurred. An aggregate event is used to represent a series of events to avoid flooding the event consumer.</descrip></descripGrp><ntig><termGrp><term id="645096">aggregate event</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1301262">peristiwa agregat</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17406_645097_1301263"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A recipient of notifications that report an occurrence of an event. An event consumer is either temporary or permanent.</descrip></descripGrp><ntig><termGrp><term id="645097">event consumer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1301263">pengguna peristiwa</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17407_645098_1301264"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A provider that determines which permanent event consumer handles a given event.</descrip></descripGrp><ntig><termGrp><term id="645098">event consumer provider</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1301264">pembekal pengguna peristiwa</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17408_645099_1301265"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A filter that registers to receive notification of a specific type of event.</descrip></descripGrp><ntig><termGrp><term id="645099">event filter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1301265">penapis peristiwa</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17409_645100_1301266"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A WMI Query Language statement that event consumers use to register to receive notification of specific events. An event provider uses an event query to register to generate notifications of specific events.</descrip></descripGrp><ntig><termGrp><term id="645100">event query</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1301266">pertanyaan peristiwa</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1741_128742_2589763"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Teleconferencing in which video images are transmitted among the various geographically separated participants in a meeting.</descrip></descripGrp><ntig><termGrp><term id="128742">video conferencing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2589763">persidangan video</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17410_645101_1301267"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A design pattern that uses events to expose asynchronous features of a class.</descrip></descripGrp><ntig><termGrp><term id="645101">event-based asynchronous pattern</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1301267">corak tak segerak berasaskan peristiwa</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17411_645104_1301268"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Software or an algorithm that converts images to a specified file format (encoder) or from file format to displayed image (decoder).</descrip></descripGrp><ntig><termGrp><term id="645104">image codec</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1301268">codec imej</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17411_645105_1301268"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Software or an algorithm that converts images to a specified file format (encoder) or from file format to displayed image (decoder).</descrip></descripGrp><ntig><termGrp><term id="645105">image encoder/decoder</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1301268">codec imej</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17412_645106_1301269"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A provider hosted in a separate process from WMI. Decoupled providers are the recommended way to instrument an application because the provider can control its own lifetime instead of being launched every time a user accesses the provider through WMI.</descrip></descripGrp><ntig><termGrp><term id="645106">decoupled provider</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1301269">pembekal nyahganding</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17413_645109_1096534"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Web Part that is added to a Web page (.aspx file) and that is not in a Web Part zone.</descrip></descripGrp><ntig><termGrp><term id="645109">static Web Part</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1096534">Bahagian Web statik</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17414_645110_1096527"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An email server that uses the Simple Mail Transfer Protocol (SMTP).</descrip></descripGrp><ntig><termGrp><term id="645110">SMTP mail server</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1096527">pelayan mel SMTP</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17415_645111_1096514"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Web Part added to a Web Part Page by a user who is working on the page in shared view.</descrip></descripGrp><ntig><termGrp><term id="645111">shared Web Part</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1096514">Bahagian Web kongsi</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17416_645112_1096501"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Anything in the SharePoint environment on which permissions or permission levels can be set.</descrip></descripGrp><ntig><termGrp><term id="645112">securable object</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular