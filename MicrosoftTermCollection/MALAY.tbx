ype="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22336_1042845_1301336"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of assigning or referring to an address. In programming, the address is typically a value specifying a memory location.</descrip></descripGrp><ntig><termGrp><term id="1042845">addressing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1301336">pengalamatan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2234_318349_444914"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Damaged. Mostly used in regard to files or data.</descrip></descripGrp><ntig><termGrp><term id="318349">corrupted</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="444914">rosak</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22342_1043701_1183285"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A node that makes cached data available to clients needing to retrieve the data.</descrip></descripGrp><ntig><termGrp><term id="1043701">peer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1183285">nod setara</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22360_1043932_1381724"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To apply a skin to an existing user interface.</descrip></descripGrp><ntig><termGrp><term id="1043932">skin</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1381724">kulit</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22362_1043933_1096359"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of maintaining backup files and putting them back onto the source medium if necessary.</descrip></descripGrp><ntig><termGrp><term id="1043933">backup and restore</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1096359">sandaran dan simpan semula</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22373_1043951_1301337"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of adding a digital signature to source code and applications published on the Internet. Code signing is intended to provide a level of security and trust to Internet software distribution.</descrip></descripGrp><ntig><termGrp><term id="1043951">code signing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1301337">tandatangan kod</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22377_1043959_2703062"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of caching the pages of a Web site on geographically dispersed servers to enable faster delivery of Web pages. When a page is requested at a URL that is content-delivery enabled, the content-delivery network routes the user's request to a cache server closer to the user. Content delivery frequently is used for high-traffic Web sites or for specific high-traffic events.</descrip></descripGrp><ntig><termGrp><term id="1043959">content delivery</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2703062">pengagregatan kandungan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22377_1177098_2703062"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of caching the pages of a Web site on geographically dispersed servers to enable faster delivery of Web pages. When a page is requested at a URL that is content-delivery enabled, the content-delivery network routes the user's request to a cache server closer to the user. Content delivery frequently is used for high-traffic Web sites or for specific high-traffic events.</descrip></descripGrp><ntig><termGrp><term id="1177098">content caching</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2703062">pengagregatan kandungan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22377_1177099_2703062"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of caching the pages of a Web site on geographically dispersed servers to enable faster delivery of Web pages. When a page is requested at a URL that is content-delivery enabled, the content-delivery network routes the user's request to a cache server closer to the user. Content delivery frequently is used for high-traffic Web sites or for specific high-traffic events.</descrip></descripGrp><ntig><termGrp><term id="1177099">content distribution</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2703062">pengagregatan kandungan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22388_1044098_1358616"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To apply a marker to content or items (like photos or text) to identify certain types of information.</descrip></descripGrp><ntig><termGrp><term id="1044098">tag</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1358616">tag</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22397_1044372_1301338"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of dealing with errors (or exceptions) as they arise during the running of a program. Some programming languages, such as C++, Ada, and Eiffel, have features that aid in error handling.</descrip></descripGrp><ntig><termGrp><term id="1044372">error handling</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1301338">pengendalian ralat</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22412_1044409_1096435"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of finding, organizing, and displaying information, particularly by electronic means.</descrip></descripGrp><ntig><termGrp><term id="1044409">information retrieval</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1096435">pengambilan maklumat</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termE