mNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="443811">aksara tak cetak</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11241_85464_443811"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A character used to control the format of displayed or printed information, rather than to represent a particular letter, digit, or other special character. The space ( ) is one of the more important nonprinting characters.</descrip></descripGrp><ntig><termGrp><term id="85464">nonprinting character</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="443811">aksara tak cetak</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11245_59333_443634"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A sequence of shades ranging from black through white, used in computer graphics to add detail to images or to represent a color image on a monochrome output device.</descrip></descripGrp><ntig><termGrp><term id="59333">grayscale</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="443634">skala kelabu</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11246_24169_2864025"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To scan a database, a list of files, or the Internet, either for a particular item or for anything that seems to be of interest.</descrip></descripGrp><ntig><termGrp><term id="24169">browse</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2864025">semak seimbas</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11246_385260_2864025"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To scan a database, a list of files, or the Internet, either for a particular item or for anything that seems to be of interest.</descrip></descripGrp><ntig><termGrp><term id="385260">browse for</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2864025">semak seimbas</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11248_233680_1297274"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of pairings of test cases and test configurations to be run. The results of this set of pairings can be viewed together. Test runs are either automated or manual.</descrip></descripGrp><ntig><termGrp><term id="233680">test run</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1297274">jalanan ujian</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11249_1166159_443675"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Light that is beyond red in the color spectrum. While the light is not visible to the human eye, infrared transmitters and receivers can send and receive infrared signals.</descrip></descripGrp><ntig><termGrp><term id="1166159">infrared light</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="443675">inframerah</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11249_66343_443675"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Light that is beyond red in the color spectrum. While the light is not visible to the human eye, infrared transmitters and receivers can send and receive infrared signals.</descrip></descripGrp><ntig><termGrp><term id="66343">infrared</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="443675">inframerah</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11249_66344_443675"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Light that is beyond red in the color spectrum. While the light is not visible to the human eye, infrared transmitters and receivers can send and receive infrared signals.</descrip></descripGrp><ntig><termGrp><term id="66344">IR</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="443675">inframerah</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1125_1359070_2174295"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An operator in the relational algebra used in database management that, when applied to two existing relations (tables), results in the creation of a new table containing all possible ordered concatenations (combinations) of tuples (rows) from the first relation with tuples from the second. The number of rows in the resulting relation is the product of the number of rows in the two source relations.</descrip></descripGrp><ntig><termGrp><term id="1359070">cross product</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2174295">produk Cartesian</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1125_28192_2174295"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An operator in the relational algebra used in database management that, when applied to two existing relations (tables), results in the creation of a new table containing all possible ordered concatenations (combinations) of tuples (rows) from the first relation with tuples from the second. The number of rows in the resulting relation is the product of the number of rows in the two source relations.</descrip></descripGrp><ntig><termGrp><term id="28192">Cartesian product</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2174295">produk Cartesian</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11251_209886_444348"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Someone who visits a Web site and purposefully supplies personal information, such as name, address, and phone number.</descrip></descripGrp><ntig><termGrp><term id="209886">registered user</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="444348">pengguna berdaftar</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11256_557748_2121531"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mailbox used by the E-mail Router to route incoming Microsoft Dynamics CRM email messages and create activities for individual users.</descrip></descripGrp><ntig><termGrp><term id="557748">forward mailbox</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2121531">peti mel pemajuan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11257_211083_1448235"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables records managers to create and manage entries to a “Holds list” such that any document, image, or webpage on that list cannot be deleted, modified, or allowed to expire until the item is removed from the list. The feature is typically used for items that are subject to events such as litigation, audits, or investigations.</descrip></descripGrp><ntig><termGrp><term id="211083">Hold</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1448235">Pegangan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11259_133083_1297275"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A software application designed for use with the Microsoft Windows environment.</descrip></descripGrp><ntig><termGrp><term id="133083">Windows application</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1297275">aplikasi Windows</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1126_396921_408764"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Address Rewriting agent for messages that enter an Exchange Server 2007 organization.</descrip></descripGrp><ntig><termGrp><term id="396921">Address Rewriting Inbound agent</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="408764">ejen Penulisan Semula Alamat Masuk</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11261_67836_1297276"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A COM server that supplies instances of classes and implements methods of the IWbemServices interface to support data retrieval, modification, deletion, enumeration, or query processing.</descrip></descripGrp><ntig><termGrp><term id="67836">instance provider</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1297276">pembekal tika</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11268_2461481_1816553"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Control Panel feature that is used to set restrictions on what traffic is allowed to enter your network from the Internet.</descrip></descripGrp><ntig><termGrp><term id="2461481">Windows Defender Firewall</term><termNote type="partOfSpeech">ProperNoun</termNote><termNo