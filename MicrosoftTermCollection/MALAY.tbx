int titles</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1182944">tajuk cetakan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23331_1073321_1183309"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A slide show mode that displays content in a manageable window that can be resized and features navigation buttons. This mode is optimized for reviewing presentations, allowing users to get the full experience, complete with animations and media, while performing other tasks, such as taking notes.</descrip></descripGrp><ntig><termGrp><term id="1073321">Reading View</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1183309">Paparan Membaca</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23333_1087526_1183310"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows users to easily add links to content within other content (e.g. pages, sections, section groups) and provides quick navigation through these links. The feature operates in the same manner that links work in wikis.</descrip></descripGrp><ntig><termGrp><term id="1087526">linking</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="11833