en-US"><descripGrp><descrip type="definition">A logical wrapper around the SQL Server Integration Services packages that provide the actual mechanism for collecting data and uploading it to the management data warehouse.</descrip></descripGrp><ntig><termGrp><term id="629818">collector type</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2174414">jenis pengumpul</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1695_397155_1974005"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A hidden item that contains information about an event sink, information about what events will trigger the event sink, and options that tell when or under what conditions the event sink will be triggered. The event registration item is created in the same folder that is being monitored for events.</descrip></descripGrp><ntig><termGrp><term id="397155">event registration item</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1974005">item pendaftaran peristiwa</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16955_629939_1677753"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Information about schedules and appointments that is stored in an Exchange Server 2007 user's mailbox and retrievable for display through a client interface or voice mail.</descrip></descripGrp><ntig><termGrp><term id="629939">calendar information</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1677753">maklumat kalendar</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16956_629940_1987824"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A block of sample code in documentation that is used to demonstrate a concept or process.</descrip></descripGrp><ntig><termGrp><term id="629940">code example</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1987824">contoh kod</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16957_629941_1944805"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A dialog box in which a user confirms that he or she wants a specified action to occur, usually by clicking OK.</descrip></descripGrp><ntig><termGrp><term id="629941">confirmation dialog box</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1944805">kotak dialog pengesahan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16959_629943_1301212"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A DBMS (database management system) designed to be run in a client/server environment. These DBMS provide a stand-alone database engine that provides rich support for SQL and transactions. They are accessed through DBMS-based drivers. For example, Oracle, Informix, DB/2, or Microsoft SQL Server.</descrip></descripGrp><ntig><termGrp><term id="629943">database server</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1301212">pelayan pangkalan data</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16960_629944_1944838"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A three-digit string of numbers, such as 5.1.2., that indicates the status of an attempt to deliver an email message.</descrip></descripGrp><ntig><termGrp><term id="629944">DSN code</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1944838">kod DSN</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16962_629946_1944839"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The value that is applied to a specific DWORD.</descrip></descripGrp><ntig><termGrp><term id="629946">DWORD value</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1944839">nilai DWORD</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16963_629993_1301213"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A unique view for displaying appointments, tasks, and other information in the form of a Web page. You can customize the Outlook Today page for your organization, or for individuals or groups within your organization, to display the information most relevant to them.</descrip></descripGrp><ntig><termGrp><term id="629993">Outlook Today</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1301213">Outlook Hari Ini</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16965_632019_1988002"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A resource that Exchange 2007 Setup assigns to a clustered mailbox server. This resource represents the network name of the clustered mailbox server.</descrip></descripGrp><ntig><termGrp><term id="632019">network name</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1988002">nama rangkaian</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16967_636292_1301214"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A LINQ query that is not evaluated until it is iterated over, either with a foreach statement (C#) or a For Each statement (Visual Basic), or by manually using the underlying GetEnumerator and MoveNext methods.</descrip></descripGrp><ntig><termGrp><term id="636292">deferred query</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1301214">pertanyaan tertangguh</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16968_636294_1301215"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The clause that introduces a data source and a range variable in a query expression.</descrip></descripGrp><ntig><termGrp><term id="636294">From clause</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1301215">klausa Daripada</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16969_636298_1301216"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A LINQ query that is evaluated immediately. Any query that returns a single value, as opposed to a sequence of values, or that is terminated by a call to ToList, ToArray, ToDictionary, or ToLookup.</descrip></descripGrp><ntig><termGrp><term id="636298">immediate query</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1301216">pertanyaan segera</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16970_636300_1301217"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A local variable whose type is inferred from the expression that initializes the variable.</descrip></descripGrp><ntig><termGrp><term id="636300">implicitly typed local variable</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1301217">pemboleh ubah setempat jenis tersirat</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16972_636303_1301218"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The set of standard query operators that is available in all LINQ queries, and the rules that define the structure of a LINQ query.</descrip></descripGrp><ntig><termGrp><term id="636303">query pattern</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1301218">corak pertanyaan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16972_636304_1301218"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The set of standard query operators that is available in all LINQ queries, and the rules that define the structure of a LINQ query.</descrip></descripGrp><ntig><termGrp><term id="636304">LINQ pattern</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1301218">corak pertanyaan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16973_636305_1301219"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A technology that makes it possible to query over any enumerable object in ADO.NET by using the LINQ programming model. LINQ to ADO.NET consists of three related LINQ technologies: LINQ to DataSet, LINQ to SQL, and LINQ to Entities.</descrip></descripGrp><ntig><termGrp><term id="636305">LINQ to ADO.NET</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1301219">LINQ ke ADO.NET</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16974_636306_1301220"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A LINQ technology that makes it easier and faster to query over data cached in a DataSet object. The queries are expressed in the programming language itself and not as string literals embedded in the application code.</descrip></descripGrp><ntig><termGrp><term id="636306">LINQ to DataSet</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1301220">LINQ ke Set Data</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16975_636307_1301221"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A LINQ technology that enables developers to create flexible, strongly typed queries against the Entity Framework by using LINQ expressions and the LINQ Standard Query Operators.</descrip></descripGrp><ntig><termGrp><term id="636307">LINQ to Entities</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1301221">LINQ ke Entiti</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16976_636308_1301222"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The use of LINQ to query in-memory data such as arrays and lists.</descrip></descripGrp><ntig><termGrp><term id="636308">LINQ to Objects</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1301222">LINQ ke Objek</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16977_636309_1301223"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A LINQ technology that provides a run-time infrastructure for managing relational data as objects. In LINQ to SQL, the data model of a relational database is mapped to an object model expressed in the programming language of the developer.</descrip></descripGrp><ntig><termGrp><term id="636309">LINQ to SQL</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1301223">LINQ ke SQL</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16978_636310_1301224"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An in-memory programming interface that makes it possible to work with XML from within the .NET Framework programming languages.</descrip></descripGrp><ntig><termGrp><term id="636310">LINQ to XML</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1301224">LINQ ke XML</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16979_636311_1301225"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process in which the compiler infers the type of a local variable that is declared with the var keyword in C# or without an As clause in Visual Basic. The compiler infers the type of the variable from the type of the initializer expression.</descrip></descripGrp><ntig><termGrp><term id="636311">local type inference</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1301225">inferens jenis setempat</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16980_636312_1301226"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A query expressed as a direct method call to one or more Standard Query Operators.</descrip></descripGrp><ntig><termGrp><term id="636312">method-based query</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1301226">pertanyaan berasaskan kaedah</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16981_636313_1301227"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ability to target code to specific versions (for example, 2.0, 3.5, 4, or 4.5) of the .NET Framework.</descrip></descripGrp><ntig><termGrp><term id="636313">multitargeting</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1301227">sasaran berbilang</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16982_636314_1301228"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tool that provides a visual design surface for creating LINQ to SQL entity classes and associations (relationships) based on objects in a database. The Object Relational Designer also provides functionality to map stored procedures and functions to System.Data.Linq.DataContext methods for returning data and manipulating entity classes.</descrip></descripGrp><ntig><termGrp><term id="636314">Object Relational Designer</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1301228">Pereka Hubungan Objek</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16982_636315_1301228"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tool that provides a visual design surface for creating LINQ to SQL entity classes and associations (relationships) based on objects in a database. The Object Relational Designer also provides functionality to map stored procedures and functions to System.Data.Linq.DataContext methods for returning data and manipulating entity classes.</descrip></descripGrp><ntig><termGrp><term id="636315">O/R Designer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1301228">Pereka Hubungan Objek</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16984_636759_1301229"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The selection in a query of a subset of the properties or columns in the data source.</descrip></descripGrp><ntig><termGrp><term id="636759">projection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1301229">unjuran</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16986_636885_1301230"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The C# =&gt; operator that is used to separate the parameters and the body of a lambda expression.</descrip></descripGrp><ntig><termGrp><term id="636885">lambda operator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1301230">operator lambda</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16987_636889_1301231"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A contextual keyword in C# and Visual Basic that designates the query clause of a query expression. For example, from, join, and select are query keywords in C#, and From, Join, and Select are query keywords in Visual basic.</descrip></descripGrp><ntig><termGrp><term id="636889">query keyword</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1301231">kata kunci pertanyaan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16988_636890_1301232"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A variable that stores a query, as opposed to the results of a query.</descrip></descripGrp><ntig><termGrp><term id="636890">query variable</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1301232">pemboleh ubah pertanyaan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16990_636901_1301233"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The type of the query variable in a LINQ query. The type of the variable that represents the data source is also a queryable type. A queryable type can be implicitly or explicitly typed, but in either case it must be a generic IEnumerable or IQueryable type.</descrip></descripGrp><ntig><termGrp><term id="636901">queryable type</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1301233">jenis boleh ditanya</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16991_636903_1301234"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The pop-up window that displays the complete declaration for an identifier when the pointer rests on the identifier in a code editor window.</descrip></descripGrp><ntig><termGrp><term id="636903">Quick Info tooltip</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1301234">petua alat Maklumat Cepat</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16992_636904_1301235"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An instance of a queryable type.</descrip></descripGrp><ntig><termGrp><term id="636904">sequence</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1301235">jujukan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16994_636996_1301236"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A class type whose name is generated by the compiler and that inherits directly from Object. Members of an anonymous type are properties that are inferred from the object initializer that creates instances of the type.</descrip></descripGrp><ntig><termGrp><term id="636996">anonymous type</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1301236">jenis tanpa nama</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16995_636997_1301237"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A single clause of a query expression. There are several different query clauses, each identified by its initiating query keyword. For instance, the "from/From clause" refers to clauses like "From c In customers" in Visual Basic, or "from c in customers" in C#.</descrip></descripGrp><ntig><termGrp><term id="636997">query clause</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1301237">klausa pertanyaan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16996_637035_2214161"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A data region that can render data in table, matrix, and list format. It is intended to convey the unique functionality of the data region object and the users' ability to combine data formats.</descrip></descripGrp><ntig><termGrp><term id="637035">Tablix</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2214161">Tablix</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langS