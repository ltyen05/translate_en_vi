langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2174504">subpertanyaan berhubung kait</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14555_95472_2686113"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To cue the user that the system is requesting input or action.</descrip></descripGrp><ntig><termGrp><term id="95472">prompt</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2686113">menggesa</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14562_318120_444884"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The button on your pointing device that you use to display shortcut menus or other program-specific features.</descrip></descripGrp><ntig><termGrp><term id="318120">right mouse button</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="444884">bebutang kanan tetikus</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14563_188073_1298237"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SQL Server 2005 feature that provides the ability to have more than one pending request per connection, in particular to have more than one default result set open per connection. SQL Server 2000 and earlier restricted the programming model such that at any point in time there would be at most one pending request on a given session, blocking the driver from sending requests to the server until the entire result set is consumed.</descrip></descripGrp><ntig><termGrp><term id="188073">multiple active result set</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1298237">set keputusan aktif berbilang</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14563_188074_1298237"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SQL Server 2005 feature that provides the ability to have more than one pending request per connection, in particular to have more than one default result set open per connection. SQL Server 2000 and earlier restricted the programming model such that at any point in time there would be at most one pending request on a given session, blocking the driver from sending requests to the server until the entire result set is consumed.</descrip></descripGrp><ntig><termGrp><term id="188074">MARS</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1298237">set keputusan aktif berbilang</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14564_20028_1298238">