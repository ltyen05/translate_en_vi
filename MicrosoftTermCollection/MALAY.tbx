es Skype users to make calls to (and receive calls from) mobile phones and landlines and send and receive SMS messages.</descrip></descripGrp><ntig><termGrp><term id="2573934">Phone Plan</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2575338">Pelan Telefon</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45685_2573938_2575339"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The service that enables Skype users to make calls from Skype to mobile phones or landlines, paid for by purchasing credits or a monthly subscription.</descrip></descripGrp><ntig><termGrp><term id="2573938">Skype to Phone</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2575339">Skype ke Telefon</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45686_2573943_2575422"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A small image that users can customize and send to someone in a chat message.</descrip></descripGrp><ntig><termGrp><term id="2573943">sticker</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2575422">pelekat</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNot