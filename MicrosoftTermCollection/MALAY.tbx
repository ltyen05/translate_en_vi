ber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2695618">kapasiti asas</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13268_180471_2199715"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of 128 leaf level pages in logical order in a single file. Used to identify areas of a file that are fragmented.</descrip></descripGrp><ntig><termGrp><term id="180471">region</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2199715">rantau</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1327_86464_1294487"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A formatted string used to access namespaces, classes, and instances. Each object on the system has a unique path that identifies it locally or over the network. Object paths are conceptually similar to Universal Resource Locators (URL).</descrip></descripGrp><ntig><termGrp><term id="86464">object path</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1294487">laluan objek</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13272_264866_2695610"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An amount of time a resource can work based on its project calendar minus standard exceptions such as holidays and planned vacations.</descrip></descripGrp><ntig><termGrp><term id="264866">capacity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2695610">kapasiti</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13276_559843_2177216"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A scheduled job that runs under SQL Server Agent. After all Subscribers have received a transaction, the agent removes the transaction from the distribution database. It also cleans up snapshot files from the file system after entries corresponding to those files have been removed from the distribution database.</descrip></descripGrp><ntig><termGrp><term id="559843">distribution cleanup agent</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2177216">ejen pembersihan pengagihan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13278_24768_2174268"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An action of copying a large set of data.</descrip></descripGrp><ntig><termGrp><term id="24768">bulk copy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber