227_1682805"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mode of Word Automation Services in which requests are processed synchronously, rather than in batches.</descrip></descripGrp><ntig><termGrp><term id="1608227">synchronous conversion</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1682805">penukaran segerak</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3165_19460_443322"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The capability of source code or programs developed on a more advanced system or compiler version to be executed or compiled by a less advanced (older) version.</descrip></descripGrp><ntig><termGrp><term id="19460">backward compatibility</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="443322">keserasian ke belakang</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31650_1608228_1682819"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A handle that enables touch selection scenarios that are not possible or are difficult to accomplish with standard touch gestures alone.</descrip></descripGrp><ntig><termGrp><term id="1608228">touch selection handle</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms">