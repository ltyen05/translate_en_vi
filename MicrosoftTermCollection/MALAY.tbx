rammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26373_1273692_2174205"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method for determining dependencies in observations taken sequentially in time, that also supports multiplicative seasonality.</descrip></descripGrp><ntig><termGrp><term id="1273692">autoregressive integrated moving average</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2174205">purata pergerakan bersepadu autoregresif</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26373_1273693_2174183"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method for determining dependencies in observations taken sequentially in time, that also supports multiplicative seasonality.</descrip></descripGrp><ntig><termGrp><term id="1273693">ARIMA</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2174183">ARIMA</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26373_1273693_2174205"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method for determining dependencies in observations taken sequentially in time, that also supports multiplicative seasonality.</descrip></descripGrp><ntig><termGrp><term id="1273693">ARIMA</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2174205">purata pergerakan bersepadu autoregresif</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26397_1274229_2174436"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A formula that calculates the mean deviation of the daily average price of a commodity from the moving average. A value above 100 indicates that the commodity is overbought, and a value below -100 indicates that the commodity is oversold.</descrip></descripGrp><ntig><termGrp><term id="1274229">commodity channel index formula</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2174436">formula indeks saluran komoditi</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26397_2223203_2174436"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A formula that calculates the mean deviation of the daily average price of a commodity from the moving average. A value above 100 indicates that the commodity is overbought, and a value below -100 indicates that the commodity is oversold.</descrip></descripGrp><ntig><termGrp><term id="2223203">CCI formula</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2174436">formula indeks saluran komoditi</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26398_1274232_2211313"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To execute the current statement and enter Break mode, stepping into the next procedure whenever a call for another procedure is reached.</descrip></descripGrp><ntig><termGrp><term id="1274232">step into</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2211313">langkah masuk</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26399_1274239_2177305"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A financial formula that calculates "envelopes" above and below a moving average using a specified percentage as the shift. The envelopes indicator is used to create signals for buying and selling. You can specify the percentage the formula uses to calculate the envelopes.</descrip></descripGrp><ntig><termGrp><term id="1274239">envelopes formula</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2177305">formula sampul</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="264_181085_2188468"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In a database mirroring session, a failover initiated by the database owner, while the principal server is still running, that transfers service from the principal database to the mirror database while they are in a synchronized state.</descrip></descripGrp><ntig><termGrp><term id="181085">manual failover</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2188468">gagal seluruh manual</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2640_358370_445122"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A copy of a database that is a member of a replica set and can be synchronized with other replicas in the set.</descrip></descripGrp><ntig><termGrp><term id="358370">replica</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="445122">replika</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26417_1274440_2194740"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ',' character that appears in a format string and specifies how a number will be formatted. Each time this character occurs in the format string, the number to be formatted is divided by a thousand. For example, if the format string "#,," is used to format the number 100 million, the output is 100.</descrip></descripGrp><ntig><termGrp><term id="1274440">number scaling specifier</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2194740">penentu penskalaan nombor</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26419_1274444_2213210"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A format used for publishing data on blogs and web sites.</descrip></descripGrp><ntig><termGrp><term id="1274444">syndication format</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2213210">format pensindiketan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26420_1274447_2174219"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A pointer that is displayed as a bar, that is to which the bar type has been applied.</descrip></descripGrp><ntig><termGrp><term id="1274447">bar pointer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2174219">penunjuk bar</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26421_1274456_1461843"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A premium subscription service that provides additional online storage for Hotmail messages, and the suppression of graphical ads within Hotmail.</descrip></descripGrp><ntig><termGrp><term id="1274456">Windows Live Hotmail Plus</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1461843">Windows Live Hotmail Plus</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26433_1274511_2207482"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A query with an excessive running time, that can lead to a blocking problem. Runaway queries usually do not use use a query or lock time out.</descrip></descripGrp><ntig><termGrp><term id="1274511">runaway query</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2207482">pertanyaan lampau masa</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26434_1274570_1676195"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user action, such as a change to status, social tags, or profiles. Notification of these changes can be sent to other users through an activity feed.</descrip></descripGrp><ntig><termGrp><term id="1274570">activity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1676195">aktiviti</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26439_1274575_1677857"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user-specified collection of contacts.</descrip></descripGrp><ntig><termGrp><term id="1274575">contact group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1677857">kumpulan kenalan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2644_14856_443293"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A performer of a song or other audio recording.</descrip></descripGrp><ntig><termGrp><term id="14856">artist</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="443293">artis</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26443_1274579_1677981"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The status that indicates a user is not working but is on personal time.</descrip></descripGrp><ntig><termGrp><term id="1274579">Off Work</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1677981">Tidak bekerja</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26446_1274584_2179987"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To switch processing from a failed component to its backup component.</descrip></descripGrp><ntig><termGrp><term id="1274584">fail over</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2179987">jalankan gagal seluruh</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26448_1274586_2174906"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A volume that is not in the DPM storage pool and is specified to store the replica and recovery points for a protection group member.</descrip></descripGrp><ntig><termGrp><term id="1274586">custom volume</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2174906">volum tersuai</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26449_1274587_2177232"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Data Protection Manager (DPM) Client enables the user to protect and recover their data as per the company protection policy configured by their backup administrator.</descrip></descripGrp><ntig><termGrp><term id="1274587">DPM Client</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2177232">Klien DPM</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26450_1274588_2177234"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The command shell, based on Windows PowerShell (Powershell.exe), that makes available the cmdlets that perform functions in Data Protection Manager.</descrip></descripGrp><ntig><termGrp><term id="1274588">DPM Management Shell</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2177234">DPM Management Shell</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26451_1274589_2177236"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tool that enables DPM administrators to authorize end users to perform self-service recovery of data by creating and managing DPM roles (grouping of users, objects, and permissions).</descrip></descripGrp><ntig><termGrp><term id="1274589">DPM Self-Service Recovery Configuration Tool</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><nti