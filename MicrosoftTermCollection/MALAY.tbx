">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10547_10287_2174154"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In client/server applications, a process that mediates between the client and the server.</descrip></descripGrp><ntig><termGrp><term id="10287">agent</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2174154">ejen</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10558_557724_2121607"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of workflow that runs only when a user specifically starts it from within the Web application UI. User action is required to start the workflow.</descrip></descripGrp><ntig><termGrp><term id="557724">on-demand workflow</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2121607">aliran kerja atas permintaan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10559_32556_1973948"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Occurring on the client side of a client-server system. For example, on the World Wide Web, JavaScript scripts are client-side because they are executed by your browser (the client). In contrast, CGI scripts are server-side because they run on the Web server. Java applets can be either server-side or client-side depending on which computer (the server or the client) executes them.</descrip></descripGrp><ntig><termGrp><term id="32556">client-side</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1973948">pihak klien</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10561_19019_1710692"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A task that is part of an operating system or program, and is operating without interaction with the user while the user is working on another task.</descrip></descripGrp><ntig><termGrp><term id="19019">background task</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1710692">tugas latar belakang</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10565_375737_380435"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The practice of deploying new Edge Transport servers based on the configuration information of a previously configured source server. The configuration information of the previously configured source server is copied and exported to an XML file, which is then imported to the target server.</descrip></descripGrp><ntig><termGrp><term id="375737">cloned configuration</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="380435">konfigurasi klon</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10568_180933_2182730"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The single attribute is used to specify the level of granularity for a given dimension in relation to a given measure group.</descrip></descripGrp><ntig><termGrp><term id="180933">granularity attribute</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2182730">atribut kebutiran</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10573_187711_1297243"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A control in the Web Parts control set that inherits directly or indirectly from the System.Web.UI.WebControls.WebParts.Part class and is used to create the primary user interface of Web Parts applications.</descrip></descripGrp><ntig><termGrp><term id="187711">part control</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1297243">kawalan bahagian</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termG