rmNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25739_1186759_1944617"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A search query syntax that helps produce more precise search results by using targeted queries that search specific properties in a message type. AQS defines certain keywords which can be used to refine the search query, such as specifying boolean operations on searched terms (AND, OR, NOT) as well as to specify further filters based on file metadata or file type. It can also be used to limit results from specific information stores like regular files, offline files cache, or email stores.</descrip></descripGrp><ntig><termGrp><term id="1186759">Advanced Query Syntax</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1944617">Advanced Query Syntax</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25739_1186759_1944624"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A search query syntax that helps produce more precise search results by using targeted queries that search specific properties in a message type. AQS defines certain keywords which can be used to refine the search query, such as specifying boolean operations on searched terms (AND, OR, NOT) as well as to specify further filters based on file metadata or file type. It can also be used to limit results from specific information stores like regular files, offline files cache, or email stores.</descrip></descripGrp><ntig><termGrp><term id="1186759">Advanced Query Syntax</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="g