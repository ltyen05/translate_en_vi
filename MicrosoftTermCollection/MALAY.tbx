rver.</descrip></descripGrp><ntig><termGrp><term id="2026693">Cmdlet Logging Viewer</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2027756">Pemapar Pengelogan Cmdlet</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35346_2026694_2027752"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A procedure in which adding a shape to the drawing canvas automatically also adds the shape's name as a text label.</descrip></descripGrp><ntig><termGrp><term id="2026694">auto-labelling</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2027752">autopelabelan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3535_397220_408885"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Anti-spam functionality that is enabled on computers that have the Edge Transport server role installed to block messages according to characteristics of the sender. The Sender Reputation agent continuously monitors senders and their past Simple Mail Transfer Protocol (SMTP) interactions, such as the amount of spam and messages that are not spam that a sender has sent, and relies on persisted data about the sender to determine what action, if any, to take on an inbound message.</descrip></descripGrp><ntig><termGrp><term id="397220">sender reputation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="408885">reputasi penghantar</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35351_2026819_2388687"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of scaling back resource usage by blocking connectivity of clients that are adversely impacting the overall health of the system.</descrip></descripGrp><ntig><termGrp><term id="2026819">engine throttling</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2388687">pendikitan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35351_2026820_2388687"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of scaling back resource usage by blocking connectivity of clients that are adversely impacting the overall health of the system.</descrip></descripGrp><ntig><termGrp><term id="2026820">throttling</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2388687">pendikitan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termE