ote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16369_566038_2189698"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A valid Multidimensional Expressions (MDX) expression that returns a member.</descrip></descripGrp><ntig><termGrp><term id="566038">member expression</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2189698">ungkapan ahli</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16370_566113_1299162"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A control that allows the creator of a load test scenario to adjust the distribution of tests, browser types, and network types, expressed as percentages. You adjust the percentages by moving sliders.</descrip></descripGrp><ntig><termGrp><term id="566113">mix control</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1299162">kawalan campuran</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16371_566126_1299163"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The threshold at which alerts are triggered. There are two types of thresholds: warning and critical. Counter set definitions contain predefined thresholds for many key performance indicators.</descrip></descripGrp><ntig><termGrp><term id="566126">counter threshold</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1299163">ambang pengira</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16376_567196_1299164"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To encapsulate another piece of software (usually a legacy program or test) so that the contained software can function in the environment of the wrapper.</descrip></descripGrp><ntig><termGrp><term id="567196">wrap</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1299164">membalut</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16380_568046_2121431"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A category of customizations that enable configuration of client extension controls.</descrip></descripGrp><ntig><termGrp><term id="568046">client extension</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2121431">sambungan klien</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16381_2803200_2121463"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A facility used to house mission critical computer systems and associated components. It generally includes environmental controls (air conditioning, fire suppression, etc.), redundant/backup power supplies, redundant data communications connections and high security.</descrip></descripGrp><ntig><termGrp><term id="2803200">datacenter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2121463">pusat data</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16381_568053_2121463"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A facility used to house mission critical computer systems and associated components. It generally includes environmental controls (air conditioning, fire suppression, etc.), redundant/backup power supplies, redundant data communications connections and high security.</descrip></descripGrp><ntig><termGrp><term id="568053">data center</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2121463">pusat data</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16384_568060_2121824"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An XML or XOML file that contains the information that other programs require to instantiate and run the workflow. Optionally, any custom metadata the workflow requires to run.</descrip></descripGrp><ntig><termGrp><term id="568060">workflow definition</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2121824">definisi aliran kerja</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16386_568102_1096349"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Microsoft deployment and management tool for high availability Web applications built on the Microsoft Windows operating system.</descrip></descripGrp><ntig><termGrp><term id="568102">Application Center</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1096349">Pusat Aplikasi</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16388_568111_2121821"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process that occurs when a workflow host calls the WorkflowRuntime.CreateWorkflow method.</descrip></descripGrp><ntig><termGrp><term id="568111">workflow activation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2121821">pengaktifan aliran kerja</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16389_568136_1096357"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A custom group used to target content to people based on membership within the group.</descrip></descripGrp><ntig><termGrp><term id="568136">audience</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1096357">khalayak</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1639_148511_1182932"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A workbook that is configured to allow multiple users on a network to view and make changes at the same time. Each user who saves the workbook sees the changes that are made by other users.</descrip></descripGrp><ntig><termGrp><term id="148511">shared workbook</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1182932">buku kerja kongsi</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16390_568168_2121822"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An elemental unit of a workflow that represents actions and provides functionality for control flow, conditions, event handling, state management, and communication with applications and services.</descrip></descripGrp><ntig><termGrp><term id="568168">workflow activity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2121822">aktiviti aliran kerja</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16396_568178_2121602"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An architectural principle where a single instance of software is used to run a service for multiple clients (tenants).</descrip></descripGrp><ntig><termGrp><term id="568178">multitenancy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2121602">berbilang penyewaan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16400_568187_1319587"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A class whose definition is split over two or more source files. Each source file contains a section of the class definition, and all parts are combined when the application is compiled.</descrip></descripGrp><ntig><termGrp><term id="568187">partial class</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1319587">kelas separa</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16401_573419_2189741"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file that installs the SQL Server Compact 3.5 devices runtime components.</descrip></descripGrp><ntig><termGrp><term id="573419">Microsoft SQL Server Compact 3.5 for Devices</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2189741">Microsoft SQL Server Compact 3.5 untuk Peranti</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16403_583314_1299165"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A rule that clarifies whether an acronym is to be spelt with upper- or lowercase letter or a mix.</descrip></descripGrp><ntig><termGrp><term id="583314">acronym casing guideline</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1299165">garis panduan bingkai akronim</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16404_583699_1299166"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An attribute that tells the CLR to remove the implicit LinkDemands. By default, strongly named, fully trusted assemblies are given an implicit LinkDemand for FullTrust on every public and protected method of every publicly visible class. Essentially, any code that someone outside of your assembly could use as an entry point into your code is protected with this demand.</descrip></descripGrp><ntig><termGrp><term id="583699">Allow Partially Trusted Callers Attribute</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1299166">Atribut Membenarkan Pemanggil Dipercayai Separa</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16405_583705_1299167"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A background process that receives, runs, and reports on Team Foundation Server builds and other property settings on a single computer. The build agent communicates with the build controller, usually located on another computer.</descrip></descripGrp><ntig><termGrp><term id="583705">build agent</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1299167">agen binaan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16406_583706_1299168"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of build activities and the conditions under which the workflow is activated, that together build a single solution or a set of solutions in a team project.</descrip></descripGrp><ntig><termGrp><term id="583706">build definition</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1299168">takrif binaan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16408_583767_1299169"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The degree of coupling to unique classes through parameters, local variables, return types, method calls, generic or template instantiations, base classes, interface implementations, fields defined on external types, and attribute decoration.</descrip></descripGrp><ntig><termGrp><term id="583767">class coupling</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1299169">gandingan kelas</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16409_583769_1299170"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A software measure that provides developers better insight into the code they are developing. By taking advantage of code metrics, developers can understand which types and/or methods should be reworked or more thoroughly tested. Development teams can identify potential risks, understand the current state of a project, and track progress during software development.</descrip></descripGrp><ntig><termGrp><term id="583769">code metric</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1299170">metrik kod</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16410_583773_1299171"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An operator that subtracts 1 from its operand depending on the position of the operator.</descrip></descripGrp><ntig><termGrp><term id="583773">decrement operator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1299171">operator susutan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16411_583774_1299172"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An operator that increases an integer typically by 1.</descrip></descripGrp><ntig><termGrp><term id="583774">increment operator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1299172">operator tokokan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16412_583780_1299173"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An SDK that provides access to debug information stored in program database (.pdb) files generated by Microsoft post-compiler tools.</descrip></descripGrp><ntig><termGrp><term id="583780">Debug Interface Access SDK</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1299173">SDK Capaian Antara Muka Nyahpepijat</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16412_583782_1299173"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An SDK that provides access to debug information stored in program database (.pdb) files generated by Microsoft post-compiler tools.</descrip></descripGrp><ntig><termGrp><term id="583782">DIA SDK</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1299173">SDK Capaian Antara Muka Nyahpepijat</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16413_583812_1299174"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The name given to a programming entity, such as a class or a variable.</descrip></descripGrp><ntig><termGrp><term id="583812">specifier</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1299174">penentu</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16414_583814_2576