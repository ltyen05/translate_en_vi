gSet></termEntry><termEntry id="12063_38186_2917931"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In hardware, a coupler used to join cables or to join a cable to a device (for example, an RS-232-C connector used to join a modem cable to a computer). Most connector types are available in one of two genders--male or female. A male connector is characterized by one or more exposed pins; a female connector is characterized by one or more receptacles--sockets or jacks-- designed to accept the pins on the male connector.</descrip></descripGrp><ntig><termGrp><term id="38186">connector</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2917931">penyambung</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12066_536532_1297313"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A device functionality available through the HasCapability method or the &lt;Choice&gt; element.</descrip></descripGrp><ntig><termGrp><term id="536532">device capability</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1297313">keupayaan peranti</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12067_169248_2211295"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In a restore operation, a file used during the undo phase to hold a "copy-on-write" pre-image of 