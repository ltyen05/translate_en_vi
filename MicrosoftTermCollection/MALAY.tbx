artOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1299095">ungkapan sifat</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15518_112419_443949"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of quitting all programs before closing the operating system.</descrip></descripGrp><ntig><termGrp><term id="112419">shutdown</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="443949">penutupan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15519_271518_1299096"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A condition-consequence statement that helps to clearly articulate risk by expressing a causal relationship between a real, existing project state of affairs or attribute, and a potential, unrealized other project state of affairs or attribute.</descrip></descripGrp><ntig><termGrp><term id="271518">risk statement</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1299096">penyata risiko</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15521_464514_1299097"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Software that is installed on either a virtual machine host or a library server, which enables Virtual Machine Manager to monitor and manage hosts, virtual machines, and library resources. An agent is also installed on the source machine during a physical-to-virtual machine conversion.</descrip></descripGrp><ntig><termGrp><term id="464514">Virtual Machine Manager agent</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1299097">agen Pengurus Mesin Maya</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15524_102746_2188458"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Typically, a register that holds a number representing how many times a repetitive process has been or is to be executed.</descrip></descripGrp><ntig><termGrp><term id="102746">repeat counter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2188458">pembilang gelung</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15524_694607_2188458"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Typically, a register that holds a number representing how many times a repetitive process has been or is to be executed.</descrip></descripGrp><ntig><termGrp><term id="694607">loop counter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2188458">pembilang gelung</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15527_92285_443862"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A round chart that shows the size of items in a single data series, proportional to the sum of the items.</descrip></descripGrp><ntig><termGrp><term id="92285">pie chart</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="443862">carta pai</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15528_143949_444167"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A dot, hyphen, or other character used to create a line that fills the space before a tab stop.</descrip></descripGrp><ntig><termGrp><term id="143949">leader character</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="444167">aksara pelopor</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15533_187306_1299098"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In object-oriented programming, a class created from another class, called the base class. A derived class inherits all the features of its base class. It can then add data elements and routines, redefine routines from the base class, and restrict access to base-class features.</descrip></descripGrp><ntig><termGrp><term id="187306">derived class</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1299098">kelas terbitan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15534_293103_444699"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The main pages in Microsoft Office Live where subscribers can view and access their services as well as statistics regarding their accounts.</descrip></descripGrp><ntig><termGrp><term id="293103">Overview</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="444699">Gambaran Keseluruhan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15538_79326_443775"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A server that hosts and delivers media across a network.</descrip></descripGrp><ntig><termGrp><term id="79326">media server</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="443775">pelayan media</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1554_321131_444985"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In I/O operations, to prevent execution of a thread.</descrip></descripGrp><ntig><termGrp><term id="321131">freeze</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="444985">beku</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15544_187909_1299099"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A template or model program that helps you start writing programs right away.</descrip></descripGrp><ntig><termGrp><term id="187909">starter kit</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1299099">kit permulaan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15545_28557_2716545"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A programmer-specified data conversion from one type to another, such as a conversion from integer to floating point.</descrip></descripGrp><ntig><termGrp><term id="28557">cast</term><termNote type="partOfSpeech">No