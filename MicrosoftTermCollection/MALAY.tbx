p><descrip type="definition">A feature that allows customers using Power Apps and Common Data Service to create external-facing websites that allow users outside their organizations to sign in with a variety of authentication providers, create and view data in Common Data Service, and browse content anonymously.</descrip></descripGrp><ntig><termGrp><term id="2809791">Power Apps portals</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2839007">Portal Power Apps</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49685_2809927_2812863"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The service that allows you to create intelligent virtual agents to provide personalized service and resolve customer issues.</descrip></descripGrp><ntig><termGrp><term id="2809927">Power Virtual Agents</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2812863">Power Virtual Agents</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49689_2810580_2812861"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The platform that allows you to deploy scalable clusters of SQL Server, Spark, and HDFS containers running on Kubernetes, enabling big data analytics within SQL Server.</descrip></descripGrp><ntig><termGrp><term id="2810580">Big Data Clusters</term><termNo