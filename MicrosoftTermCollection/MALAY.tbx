d allows the application or script to enumerate the returned objects as a collection. A semisynchronous method call does not require setting up an object sink, but an asynchronous method call does require setting up an object sink.</descrip></descripGrp><ntig><termGrp><term id="660775">semisynchronous call</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1301270">panggilan kaedah separa segerak</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1958_184137_1448199"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A control that allows users to digitally sign a form or document.</descrip></descripGrp><ntig><termGrp><term id="184137">signature line</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1448199">garis tandatangan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1958_184137_1676160"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A control that allows users to digitally sign a form or document.</descrip></descripGrp><ntig><termGrp><term id="184137">signature line</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1676160">baris tandatangan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19591_661875_1301271"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A coordinate that specifies the X or Y screen position relative to the upper-left corner of the application, which is regarded as the origin (0,0). In right-to-left (RTL) applications, the upper-right corner is the origin.</descrip></descripGrp><ntig><termGrp><term id="661875">client coordinate</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1301271">koordinat pelanggan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19592_661876_1301272"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The coordinate used by the physical device being drawn on, such as a screen or sheet of paper.</descrip></descripGrp><ntig><termGrp><term id="661876">device coordinate</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1301272">koordinat peranti</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19593_661877_1301273"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A rendering mode in which you take responsibility for drawing a control, rather than relying on the control's default rendering behavior.</descrip></descripGrp><ntig><termGrp><term id="661877">owner draw mode</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1301273">mod lukisan pemilik</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19593_684495_1301273"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A rendering mode in which you take responsibility for drawing a control, rather than relying on the control's default rendering behavior.</descrip></descripGrp><ntig><termGrp><term id="684495">owner draw</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1301273">mod lukisan pemilik</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19594_661878_1301274"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An event consumer whose registration lasts until it is explicitly cancelled.</descrip></descripGrp><ntig><termGrp><term id="661878">permanent consumer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1301274">pengguna tetap</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19595_661879_1301275"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An event consumer that receives event notifications only while the consumer is active.</descrip></descripGrp><ntig><termGrp><term id="661879">temporary consumer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1301275">pelanggan sementara</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19596_661880_1301276"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">One of several preinstalled permanent consumers that perform an action, such as sending an email or writing to a log when configured by a managed object format (MOF) file or a script.</descrip></descripGrp><ntig><termGrp><term id="661880">standard consumer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1301276">pelanggan piawai</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19598_661882_1301277"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A template for a type of managed object. WMI classes define the basic units of management. For example, the Win32_LogicalDisk class is a template for all logical disks that occur in the Windows environment. In this case, WMI uses the class template to generate an instance of Win32_LogicalDisk for each disk installed on a computer.</descrip></descripGrp><ntig><termGrp><term id="661882">WMI class</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1301277">kelas WMI</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19599_661883_1301278"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A class that the CIM Object Manager defines to support core features such as event notification, security, and localization. A system class is automatically defined in each namespace.</descrip></descripGrp><ntig><termGrp><term id="661883">system class</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1301278">kelas sistem</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19601_661885_1301279"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The alignment of an item, such as a control.</descrip></descripGrp><ntig><termGrp><term id="661885">orientation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1301279">orientasi</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19602_661886_1301280"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The size and location of an object.</descrip></descripGrp><ntig><termGrp><term id="661886">bound</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1301280">sempadan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19604_661896_1301281"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A URL that has a scheme that is not followed by two slashes (//).</descrip></descripGrp><ntig><termGrp><term id="661896">opaque URL</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1301281">URL legap</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19605_661897_1301282"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A character in a URL that may be altered during transport across the Internet.</descrip></descripGrp><ntig><termGrp><term id="661897">unsafe character</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1301282">aksara tak selamat</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSe