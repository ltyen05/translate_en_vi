process runs under.</descrip></descripGrp><ntig><termGrp><term id="637212">application pool identity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1096352">pengenalan himpunan aplikasi</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17004_1262414_1096565"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An XML file with the .config file name extension that contains settings for an application, Web site, or server. Common configuration files include Machine.config and Web.config.</descrip></descripGrp><ntig><termGrp><term id="1262414">configuration file</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1096565">fail Web.config</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17004_637213_1096565"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An XML file with the .config file name extension that contains settings for an application, Web site, or server. Common configuration files include Machine.config and Web.config.</descrip></descripGrp><ntig><termGrp><term id="637213">Web.config file</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1096565">fail Web.config</term><termNote type="geographicalUsage">BRN, MYS</t