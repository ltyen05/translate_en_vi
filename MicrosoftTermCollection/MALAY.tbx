angSet xml:lang="ms"><ntig><termGrp><term id="1932841">tetap semula</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17191_640175_2743098"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An identifier that is given to a customer record to indicate that the customer is the same as a corresponding customer record in another company that shares the same directory ID.</descrip></descripGrp><ntig><termGrp><term id="640175">directory ID</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2743098">ID direktori</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1721_374823_2192461"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The fixed-length data type with a maximum of 4,000 Unicode characters.</descrip></descripGrp><ntig><termGrp><term id="374823">nchar</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2192461">nchar</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1723_460705_2121651"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The individual elements that represent the product and properties that compose a price list.</descrip></descripGrp><ntig><termGrp><term id="460705">price list item</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2121651">item senarai harga</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1724_71360_1294511"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A technique that catches faults that occur while the program is running outside the development environment. You must set this option in the development environment before executing your program.</descrip></descripGrp><ntig><termGrp><term id="71360">JIT debugging</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1294511">penyahpepijatan JIT</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1724_71361_1294511"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A technique that catches faults that occur while the program is running outside the development environment. You must set this option in the development environment before executing your program.</descrip></descripGrp><ntig><termGrp><term id="71361">just-in-time debugging</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1294511">penyahpepijatan JIT</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="173_537619_1294426"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The behavior and state that a class provides, which is matched with what a client of that class can expect to hold. A contract is expressed partly by the signatures for all public fields, methods, properties, and events of that class. This is augmented by a description (usually in simple descriptive text) of what each field or property represents, together with what each method does.  In the .NET Framework add-in programming model, a non-versioning interface that defines the methods and specifies the data types for transferring data over the communication pipeline between the host and the add-in. The contract is in the middle of the communication pipeline between the add-in and the host. The contract assembly is loaded into the application domains of both the add-in and the host.</descrip></descripGrp><ntig><termGrp><term id="537619">contract</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1294426">kontrak</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17310_640432_1183098"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To locate text or a specific item on a Web page or in a document.</descrip></descripGrp><ntig><termGrp><term id="640432">find</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1183098">cari</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17311_640433_1978678"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The navigation button used to complete and close a wizard.</descrip></descripGrp><ntig><termGrp><term id="640433">Finish</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1978678">Tamat</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17312_640434_3145815"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A navigation button used to return to a page from which the user has navigated away via the web browser Back command.</descrip></descripGrp><ntig><termGrp><term id="640434">Forward</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="3145815">Mara</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17321_640444_2171218"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user who does not have a user account or who does not provide a password.</descrip></descripGrp><ntig><termGrp><term id="640444">guest</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2171218">tetamu</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1735_41913_443498"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To remove part of a document, usually placing it temporarily in memory so that the cut portion can be inserted (pasted) elsewhere.</descrip></descripGrp><ntig><termGrp><term id="41913">cut</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="443498">potong</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17372_640684_2174262"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A virtual container that holds a particular category of items or data.</descrip></descripGrp><ntig><termGrp><term id="640684">bucket</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2174262">baldi</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17384_1507600_1521423"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Web page that a site collection administrator has designated as more relevant than other Web pages. This is typically the URL of the home page for the intranet of an organization. The higher the authority level assigned to a page, the higher the page appears in search results. Also referred to as authoritative page.</descrip></descripGrp><ntig><termGrp><term id="1507600">authority page</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1521423">halaman rasmi</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17384_641205_1521423"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Web page that a site collection administrator has designated as more relevant than other Web pages. This is typically the URL of the home page for the intranet of an organization. The higher the authority level assigned to a page, the higher the page appears in search results. Also referred to as authoritative page.</descrip></descripGrp><ntig><termGrp><term id="641205">authoritative page</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1521423">halaman rasmi</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17385_641206_1096372"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The number of links between a content item and an authoritative page linking to the content item.</descrip><