termGrp><term id="54701">referencing key</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="443606">kunci asing</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11510_148563_1297289"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ability to install and use multiple versions of an assembly in isolation at the same time. Side-by-side execution can apply to applications and components as well as to the .NET Framework. Allowing assemblies to coexist and to execute simultaneously on the same computer is essential to support robust versioning in the common language runtime.</descrip></descripGrp><ntig><termGrp><term id="148563">side-by-side execution</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1297289">pelaksanaan sebelah-menyebelah</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11515_27557_443381"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The use of a capital letter in writing or printing.</descrip></descripGrp><ntig><termGrp><term id="27557">capitalization</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="443381">penghurufbesaran</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="