Entry><termEntry id="33566_2312661_2161716"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The category of products (apps or games) that are current getting the best average overall rating by customers.</descrip></descripGrp><ntig><termGrp><term id="2312661">Best-rated games</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2161716">Aplikasi dinilai terbaik</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33566_2312661_2161717"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The category of products (apps or games) that are current getting the best average overall rating by customers.</descrip></descripGrp><ntig><termGrp><term id="2312661">Best-rated games</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2161717">Permainan dinilai terbaik</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33567_1802883_1846578"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An alternate name a user can give their cards to more easily identify what they are and how they can be used.</descrip></descripGrp><ntig><termGrp><term id="1802883">nickname</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1846578">nama berian</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33568_1802884_1846538"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A description for music or videos stored in the cloud that users may access from their phone. Used for Xbox Music and any other potential cloud-based media services.</descrip></descripGrp><ntig><termGrp><term id="1802884">cloud collection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1846538">koleksi awan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33569_1802886_1846541"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The amount of data the user can download/upload through the carrier's network each month without being billed additional charges.</descrip></descripGrp><ntig><termGrp><term id="1802886">data limit</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1846541">had data</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33570_2164314_2193629"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The pre-loaded app that allows users to better monitor and manage their data usage on their phone or PC. It can notify users when they are close to their cellular data limit and delay some data-intensive tasks until the phone or PC is connected to Wi-Fi.</descrip></descripGrp><ntig><termGrp><term id="2164314">Data usage</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2193629">Penggunaan data</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33571_1802888_1846545"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The button label to note that the user does not like a suggestion in Local Scout.</descrip></descripGrp><ntig><termGrp><term id="1802888">dislike</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1846545">tidak suka</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33576_1803504_1846546"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The default room name in the Rooms feature of the People Hub. Based on the concept of the "family room" in many homes, in which family and guests gather for group activities.</descrip></descripGrp><ntig><termGrp><term id="1803504">Family Room</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1846546">Bilik Keluarga</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33577_1803505_1846588"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A place on the phone where families (or other close-knit groups) can stay in touch. Rooms take the form of a panorama that lives in the People Hub. The panorama includes a family chat card, a shared calendar, a shared photo album, and a shared notebook. Users ask others to join their Room via an SMS invite.</descrip></descripGrp><ntig><termGrp><term id="1803505">room</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1846588">bilik</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33578_1803510_1846547"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An NFC-enabled card (like a credit card) that users can use for payments or other transactions even when the phone is locked.</descrip></descripGrp><ntig><termGrp><term id="1803510">fast card</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1846547">kad pantas</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33579_1803511_1846548"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A flash mode used to set off the flash automatically according to the ambient light conditions.</descrip></descripGrp><ntig><termGrp><term id="1803511">flash auto</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1846548">denyar automatik</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3358_169402_2199689"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The point in the log chain at which rolling forward stops during a recovery.</descrip></descripGrp><ntig><termGrp><term id="169402">recovery point</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2199689">titik pemulihan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33580_1803512_1846549"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A flash mode when the phone's built-in camera flash is set to off.</descrip></descripGrp><ntig><termGrp><term id="1803512">flash off</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1846549">denyar mati</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33581_1803513_1846550"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A flash mode when the phone's built-in camera flash is set to on.</descrip></descripGrp><ntig><termGrp><term id="1803513">flash on</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1846550">denyar hidup</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33582_1803514_1846552"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A camera on the front of an electronic device (such as a smartphone), which faces the user. This allows the user to video chat with another person also using a front-facing device. It may also be used to take videos and pictures.</descrip></descripGrp><ntig><termGrp><term id="1803514">front</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1846552">hadapan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33583_1803517_2058859"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Skype To Go number that is used like a calling card, that allows a user to enter a number manually and dial any phone number.</descrip></descripGrp><ntig><termGrp><term id="1803517">Access number</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2058859">Nombor akses</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33584_1803518_1846555"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A text message thread between a group of people (usually more than 2). It allows you to keep all the replies from people in one thread, so that you can see the whole conversation.</descrip></descripGrp><ntig><termGrp><term id="1803518">group text</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1846555">mesej kepada kumpulan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33585_1803519_1846556"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app that provides easy access to Help and how-to content as well as helpful tips for users.</descrip></descripGrp><ntig><termGrp><term id="1803519">Help+Tips</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1846556">Bantuan+Petua</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33586_1803521_2058936"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A product that enables a user to call mobile phones and landlines from a mobile phone or landline via Skype.</descrip></descripGrp><ntig><termGrp><term id="1803521">Skype To Go number</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2058936">nombor Skype To Go</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33587_1803522_1846559"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An APN (Access Point Name) that determines the cellular data networks to which a phone can connect. It includes information about what kind of connection, security, and type of IP address the phone should use for the Internet connection.</descrip></descripGrp><ntig><termGrp><term id="1803522">Internet APN</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1846559">APN Internet</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33588_1803523_1846568"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The APN (Access Point Name) a phone can use to send MMS messages (text messages with multimedia files attached).</descrip></descripGrp><ntig><termGrp><term id="1803523">MMS APN</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1846568">APN MMS</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33589_1803524_1846560"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The company or organization that issued the user the card they're adding to their wallet. For example, an issuer could be a bank.</descrip></descripGrp><ntig><termGrp><term id="1803524">issuer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1846560">pengeluar</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3359_187952_1294584"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A simple browser providing an outline view of available applications and systems used as a drag source to create references to Application Systems on the Application Connection Designer, System Designer and the System Deployment Designer.</descrip></descripGrp><ntig><termGrp><term id="187952">System View</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1294584">Paparan Sistem</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><te