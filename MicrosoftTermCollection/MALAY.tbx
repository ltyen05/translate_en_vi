<descripGrp><descrip type="definition">The Office 365 Security &amp; Compliance Center feature that allows admins to manage mobile device access to company data, manage data loss, helps them protect the company from inbound and outbound malicious software and spam, and that helps them determine if senders are maliciously spoofing accounts from their domain.</descrip></descripGrp><ntig><termGrp><term id="2701271">Threat management</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2702283">Pengurusan ancaman</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4793_530220_2174492"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The object which represents a party participating in the conversation.</descrip></descripGrp><ntig><termGrp><term id="530220">conversation endpoint</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2174492">titik akhir perbualan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="47930_2701275_2702281"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An email whose purpose is to scam users, steal their data, or take control of their devices.</descrip></descripGrp><ntig><termGrp><term id="2701275">malicious mail</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</t