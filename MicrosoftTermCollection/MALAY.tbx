rmNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="3099966">penawaran dan permintaan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54554_3099643_3099967"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The network of retailers, distributors, transporters, storage facilities and suppliers that participate in the sale, delivery and production of a particular product.</descrip></descripGrp><ntig><termGrp><term id="3099643">supply chain</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="3099967">rantaian bekalan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54555_3099644_3099968"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The cloud-based, modern planning solution that empowers organizations to build an agile, resilient, and sustainable supply chain fueled by intelligence and collaboration.</descrip></descripGrp><ntig><termGrp><term id="3099644">Supply chain planning</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="3099968">perancangan rantaian bekalan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammat