</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2121372">Penganalisis</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34918_2015335_2121752"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Name of the view that has details about the selected source.</descrip></descripGrp><ntig><termGrp><term id="2015335">source details</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2121752">butiran sumber</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34919_2015336_2121386"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Individual, account, or website that published a post that was stored to the application's database.</descrip></descripGrp><ntig><termGrp><term id="2015336">author</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2121386">pengarang</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34920_2015337_2121503"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Fea