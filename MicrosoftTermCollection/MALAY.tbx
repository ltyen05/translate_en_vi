15908_169126_2194784"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An operation that restores one or more data pages. Page restore is intended for repairing isolated damaged pages.</descrip></descripGrp><ntig><termGrp><term id="169126">page restore</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2194784">pemulihan halaman</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15909_535352_2196535"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The order of evaluation (from highest to lowest calculation pass number) and calculation (from lowest to highest calculation pass number) for calculated members, custom members, custom rollup formulas, and calculated cells in a multidimensional cube.</descrip></descripGrp><ntig><termGrp><term id="535352">pass order</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2196535">susunan penilaian</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15916_1177757_2189757"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A technology that helps developers build scalable, secure database applications.</descrip></descripGrp><ntig><termGrp><term id="1177757">Microsoft SQL Server Service Broker</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</term