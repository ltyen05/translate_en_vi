rmNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15677_147745_444196"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The order in which changes are propagated from replica to replica. Topology determines how quickly changes in another replica appear in your replica.</descrip></descripGrp><ntig><termGrp><term id="147745">replica set topology</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="444196">topologi set replika</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15677_147745_445128"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The order in which changes are propagated from replica to replica. Topology determines how quickly changes in another replica appear in your replica.</descrip></descripGrp><ntig><termGrp><term id="147745">replica set topology</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="445128">topologi</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15677_359275_444196"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The order in which changes are propagated from replica to replica. Topology determines how quickly changes in another replica ap