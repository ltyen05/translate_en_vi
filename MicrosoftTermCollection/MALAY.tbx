vel container for all the metadata an organization will store. A catalog contains Users and Assets.</descrip></descripGrp><ntig><termGrp><term id="2362895">catalog</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2364946">katalog</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4076_543577_1294627"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A log that lists the current notes you are typing and the uneditable historical conversation that has already been saved.</descrip></descripGrp><ntig><termGrp><term id="543577">work item log</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1294627">log item kerja</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40760_2362896_2364952"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The security principal that has permissions to perform actions (search the catalog, add, edit or remove items, etc…) in the Catalog.</descrip></descripGrp><ntig><termGrp><term id="2362896">user</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2364952">pengguna</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammatical