 id="2348651">Panggilan Domestik PSTN Skype for Business</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40431_2347755_2348652"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The service plan offer covering international calls as part of the PSTN Calling service in Office 365.</descrip></descripGrp><ntig><termGrp><term id="2347755">Skype for Business PSTN International Calling</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2348652">Panggilan Antarabangsa PSTN Skype for Business</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40432_2347756_2348650"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The service plan offer covering domestic and international calls as part of the PSTN Calling service in Office 365.</descrip></descripGrp><ntig><termGrp><term id="2347756">Skype for Business PSTN Domestic and International Calling</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2348650">Panggilan Domestik dan Antarabangsa PSTN Skype for Business</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termE