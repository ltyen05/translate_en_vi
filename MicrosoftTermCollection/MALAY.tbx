898"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ? character, used as a punctuation mark or wildcard character.</descrip></descripGrp><ntig><termGrp><term id="96502">question mark</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="443898">tanda soal</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13532_536973_1298165"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A System.Web.UI.WebControls.WebParts.ConnectionPoint object associated with the provider and consumer controls that participate in Web Parts connections. A connection point manages the exchange of data between the controls. Providers and consumers each have their own connection points.</descrip></descripGrp><ntig><termGrp><term id="536973">connection point</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1298165">titik sambungan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13534_397143_408839"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The deleted item recovery feature. When the dumpster is enabled, items emptied from the Deleted Items folder are placed in the dumpster for a server-configured number of days. A client can retrieve the items from the dumpster until the number of days has passed. Each folder has its own dumpster.</descrip></descripGrp><ntig><termGrp><term id="397143">dumpster</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="408839">tong pengangkut</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13536_370260_2173243"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The central location from which to view and access all Web sites associated with a specific portal site.</descrip></descripGrp><ntig><termGrp><term id="370260">Site Directory</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2173243">Direktori Laman</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13537_1018_2081327"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A string that identifies a user so that the user can receive Internet email and typically consists of an account name, followed by the @ (at) symbol, a host name, and a domain name.</descrip></descripGrp><ntig><termGrp><term id="1018">address</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2081327">e-mel</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSel