d="6263_88971_2194766"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A join that includes all the rows from the joined tables that meet the search conditions, even rows from one table for which there is no matching row in the other join table.</descrip></descripGrp><ntig><termGrp><term id="88971">outer join</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2194766">cantuman luaran</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6270_380992_1096452"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A version that is ready for a larger group to see or that has changed significantly since the previous major version.</descrip></descripGrp><ntig><termGrp><term id="380992">major version</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1096452">versi utama</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6271_92475_2121639"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A software infrastructure that defines and links together one or more stages of a business process, running them in sequence to complete a specific task. Each stage of a pipeline contains one or more pipeline components (COM objects) that can be configured to work with the unique requirements of the site.</descrip></descripGrp><ntig><termGrp><term id="92475">pipeline</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2121639">talian paip</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6274_2037681_2407029"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of trojan that creates a denial of service attack.</descrip></descripGrp><ntig><termGrp><term id="2037681">trojan denial of service attack</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2407029">serangan trojan nafi khidmat</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6279_26739_443374"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To attempt to establish a voice conversation with another person or other people from a phone, computer, or mobile device.</descrip></descripGrp><ntig><termGrp><term id="26739">call</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="443374">panggil</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6280_180942_2182749"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A way of partitioning a table or index by allowing SQL Server to apply an internal hash algorithm to spread rows across partitions based on the number of partitions specified and the values of one or more partitioning columns.</descrip></descripGrp><ntig><termGrp><term id="180942">hash partitioning</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2182749">pemetakan cincangan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6282_139056_444121"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Colors that are opposite each other on the color wheel, such as yellow and blue.</descrip></descripGrp><ntig><termGrp><term id="139056">complementary colors</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="444121">warna pelengkap</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6285_233124_1295397"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A classification that determines how a project is posted to the ledger. Project type identifies an external project as fixed price or time and materials and an internal project as cost, investment, or time.</descrip></descripGrp><ntig><termGrp><term id="233124">project type</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp><