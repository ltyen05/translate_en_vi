mNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4071_211565_444001"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A measurement used for high-capacity data storage. One terabyte equals 240, or 1,099,511,627,776, bytes, although it is commonly interpreted as simply one trillion bytes.</descrip></descripGrp><ntig><termGrp><term id="211565">TB</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="444001">terabait</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4071_211565_444387"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A measurement used for high-capacity data storage. One terabyte equals 240, or 1,099,511,627,776, bytes, although it is commonly interpreted as simply one trillion bytes.</descrip></descripGrp><ntig><termGrp><term id="211565">TB</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="444387">TB</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40741_2361902_2847229"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The federated authentication protocol that allows a user who has logged in after authenticating from a central identity provider not to have to login or need to authenticate again from the service provider he or she wants to use.</descrip></descripGrp><ntig><termGrp><term id="2361902">SAML-P</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2847229">SAML</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40741_2361912_2847229"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The federated authentication protocol that allows a user who has logged in after authenticating from a central identity provider not to have to login or need to authenticate again from the service provider he or she wants to use.</descrip></descripGrp><ntig><termGrp><term id="2361912">Security Assertion Markup Language</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2847229">SAML</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40741_2840599_2847229"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The federated authentication protocol that allows a user who has logged in after authenticating from a central identity provider not to have to login or need to authenticate again from the service provider he or she wants to use.</descrip></descripGrp><ntig><termGrp><term id="2840599">SAML</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2847229">SAML</term><