e><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37580_2144338_2244276"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Lumia Camera, the feature that allows users to create high-definition photos and videos by capturing a short, high-definition video recording.</descrip></descripGrp><ntig><termGrp><term id="2144338">Lumia Moments</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2244276">Lumia Moments</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37582_2144340_2244277"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app that allows the user to capture multiple images simultaneously with different focus settings.</descrip></descripGrp><ntig><termGrp><term id="2144340">Lumia Refocus</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2244277">Lumia Refocus</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37583_2144341_2244278"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app for capturing, editing, and sharing photos of oneself that can be automatically enhanced with various effects.</descrip></descripGrp><ntig><termGrp><term id="2144341">Lumia Selfie</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2244278">Lumia Selfie</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37584_2144342_2333741"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A photo that one has taken of oneself, normally using a smartphone or a digital camera, that is planned to be uploaded to a social media website.</descrip></descripGrp><ntig><termGrp><term id="2144342">selfie</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2333741">selfie</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37585_2354826_2356754"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that allows the camera to capture multiple shots at different flash and exposure settings, so that the user can shoot first and edit and select the perfect shot later. The resulting photo is produced by merging multiple images to produce different lighting effects, similar to HDR or blended flash.</descrip></descripGrp><ntig><termGrp><term id="2354826">Rich HDR</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2356754">HDR Beraneka</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37586_2144610_2218677"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The button that invokes the Start menu (desktop) and the Start screen (mobile or desktop).</descrip></descripGrp><ntig><termGrp><term id="2144610">Start</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2218677">Mula</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37587_2144631_2193649"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The full-screen view of Start that includes the list of items, such as apps, websites, and other info that a person can specify and customize. It is what is displayed when the Start button is used.</descrip></descripGrp><ntig><termGrp><term id="2144631">Start screen</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2193649">Skrin mula</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37587_2144631_2218678"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The full-screen view of Start that includes the list of items, such as apps, websites, and other info that a person c