rmNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1677955">video masuk</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20780_747558_1301314"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Profiler Performance Report view that helps to automate the process of locating a performance bottleneck.</descrip></descripGrp><ntig><termGrp><term id="747558">Hot Path view</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1301314">paparan Laluan Panas</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20781_747562_2842149"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In a call queue, a method of sending calls to agents whereby incoming calls ring all call agents one by one, from the beginning of the call agent list. If an agent dismisses or does not pick up a call, the call will ring the next agent and will try all agents until it is picked up or times out.</descrip></descripGrp><ntig><termGrp><term id="747562">serial routing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2842149">penghalaan bersiri</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20799_747608_1096451"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A rule that is executed by the SharePoint Maintenance Manager to identify problems that are related to configuration settings, data integrity, performance, security, and other issues.</descrip></descripGrp><ntig><termGrp><term id="747608">maintenance rule</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="1096451">peraturan penyelenggaraan</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20801_747612_2207544"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The local memory (the client-side RAM) that is used by a PHP script.</descrip></descripGrp><ntig><termGrp><term id="747612">script memory</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ms"><ntig><termGrp><term id="2207544">ingatan skrip</term><termNote type="geographicalUsage">BRN, MYS</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20802_747617_2197342"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An open source scripting language that can be embedded in HTML documents to execute interactive functions on a Web server. It is generally used for Web development.</descrip></descripGrp><ntig><termGrp><term id="747617">PHP:Hypertext Preprocessor</term><termNote type="partOf