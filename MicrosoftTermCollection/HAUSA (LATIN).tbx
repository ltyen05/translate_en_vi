 computers.</descrip></descripGrp><ntig><termGrp><term id="269326">Remote Desktop Protocol</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1157562">RDP</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8595_269326_1995075"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The proprietary protocol to provide remote display and input capabilities over network connections for Windows-based applications between two computers.</descrip></descripGrp><ntig><termGrp><term id="269326">Remote Desktop Protocol</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1995075">Furotukol Destof na Nesa</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8595_269327_1157562"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The proprietary protocol to provide remote display and input capabilities over network connections for Windows-based applications between two computers.</descrip></descripGrp><ntig><termGrp><term id="269327">RDP</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1157562">RDP</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8595_269327_1995075"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The proprietary protocol to provide remote display and input capabilities over network connections for Windows-based applications between two computers.</descrip></descripGrp><ntig><termGrp><term id="269327">RDP</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1995075">Furotukol Destof na Nesa</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8600_37568_1335245"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Of, pertaining to, or characteristic of an action or operation that takes place based on whether or not a certain condition is true.</descrip></descripGrp><ntig><termGrp><term id="37568">conditional</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1335245">Na yanayi</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8609_2856023_2574612"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Any of a family of processes that software developers use to minimize risk by developing applications incrementally, over a series of short iterations. In this model, real-time communications, such as in person conversations and telephone calls, are preferred over written documentation; the primary measure of progress is working software, instead of hours spent, tasks completed, documents reviewed, or phases signed-off; stakeholders are expected to collaborate, instead of negotiating; and planning happens continuously in order to respond to change.</descrip></descripGrp><ntig><termGrp><term id="2856023">Agile methodology</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="2574612">Tsari mai juriya</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8609_460694_2574612"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Any of a family of processes that software developers use to minimize risk by developing applications incrementally, over a series of short iterations. In this model, real-time communications, such as in person conversations and telephone calls, are preferred over written documentation; the primary measure of progress is working software, instead of hours spent, tasks completed, documents reviewed, or phases signed-off; stakeholders are expected to collaborate, instead of negotiating; and planning happens continuously in order to respond to change.</descrip></descripGrp><ntig><termGrp><term id="460694">Agile method</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="2574612">Tsari mai juriya</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8612_173657_2294694"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Application software that gathers data from the user, prepares it for the server, and issues a request to the server. The client presents data received from the server to the user through its own user interface.</descrip></descripGrp><ntig><termGrp><term id="173657">client application</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="2294694">Manhajar Abokin Hulɗa</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8614_358362_2294685"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An item in the Exchange store that represents an appointment, a meeting, a meeting request, or an event. It can identify the place, resources, recurrence, and attendees involved at a discrete time.</descrip></descripGrp><ntig><termGrp><term id="358362">calendar item</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="2294685">abun kalanda</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8641_184378_588088"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The permission setting that permits a person or domain to add the user to contact lists, see the user's status, or send instant messages to the user.</descrip></descripGrp><ntig><termGrp><term id="184378">Allow</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="588088">Bada izini</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8643_44563_1335246"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To put into use.</descrip></descripGrp><ntig><termGrp><term id="44563">deploy</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1335246">Aiki da</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8644_185806_1527708"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A UI element that ends a user session or exits a service.</descrip></descripGrp><ntig><termGrp><term id="185806">Sign Out</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1527708">Fita</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8657_2140019_1335247"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The person in charg