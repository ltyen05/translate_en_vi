graphicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10422_318750_588675"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The &lt; character.</descrip></descripGrp><ntig><termGrp><term id="318750">LESS-THAN SIGN</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="588675">Bakan hagu</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10422_74325_1157515"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The &lt; character.</descrip></descripGrp><ntig><termGrp><term id="74325">less than sign</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1157515">alamar ragi</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10422_74325_1157941"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The &lt; character.</descrip></descripGrp><ntig><termGrp><term id="74325">less than sign</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1157941">ALAMAR RAGI</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10422_74325_588675"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The &lt; character.</descrip></descripGrp><ntig><termGrp><term id="74325">less than sign</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="588675">Bakan hagu</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10423_232516_588200"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Data from a table, form, query, view, or stored procedure, displayed in a row-and-column format.</descrip></descripGrp><ntig><termGrp><term id="232516">datasheet</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="588200">Takardar tsara bayanai</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10425_77712_2295079"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A highspeed network that can carry voice, data, and images at up to 200 Mbps or faster over distances of up to 75 km. Based on the network architecture, the transmission speed can be higher for shorter distances. A MAN, which can include one or more LANs as well as telecommunications equipment such as microwave and satellite relay stations, is smaller than a wide area network but generally operates at a higher speed.</descrip></descripGrp><ntig><termGrp><term id="77712">MAN</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="2295079">hanyara sadarwan birni</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10425_77713_2295079"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A highspeed network that can carry voice, data, and images at up to 200 Mbps or faster over distances of up to 75 km. Based on the network architecture, the transmission speed can be higher for shorter distances. A MAN, which can include one or more LANs as well as telecommunications equipment such as microwave and satellite relay stations, is smaller than a wide area network but generally operates at a higher speed.</descrip></descripGrp><ntig><termGrp><term id="77713">metropolitan area network</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="2295079">hanyara sadarwan birni</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10431_232847_1862268"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A view that is designed for reading documents on a computer screen. The document is resized to fit the screen and most toolbars are removed, but commands are available for navigating, commenting, and looking up words.</descrip></descripGrp><ntig><termGrp><term id="232847">reading layout view</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1862268">duban tsarin karatun shafi</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10436_415517_1862307"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Editor feature that gives users feedback on how easy it is for a reader to understand a written text based on information such as average sentence length and average word length.</descrip></descripGrp><ntig><termGrp><term id="415517">Readability Statistics</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1862307">kididdigar karantuwa</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10437_168488_1862194"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An optional Live Meeting tool that allows users to create Live Meeting slides and add a presenter photo as part of a Microsoft PowerPoint file.</descrip></descripGrp><ntig><termGrp><term id="168488">PowerPoint add-in</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1862194">kara-ciki na PowerPoint</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10443_294444_588470"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of chart that compares the aggregate values of a number of data series.</descrip></descripGrp><ntig><termGrp><term id="294444">radar chart</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="588470">Zanen rada</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10444_139402_587882"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A design template that also contains text suggestions on each slide. You replace the text suggestions with the text that you want. A content template contains a slide master and an optional title master.</descrip></descripGrp><ntig><termGrp><term id="139402">content template</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="587882">Ƙumshiyar Zube</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1045_137287_1334979"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Text displayed by Web browsers during image downloads for users who have graphics turned off, and for users who rely on screen-reading software to convert graphics on the scree