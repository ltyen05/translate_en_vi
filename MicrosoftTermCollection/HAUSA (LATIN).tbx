-US"><descripGrp><descrip type="definition">Engaging in fraud or deceptive.</descrip></descripGrp><ntig><termGrp><term id="269324">fraudulent</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="588431">Zambatacce</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="746_316258_1709947"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Text or symbols indicating that a computer program is waiting for input from the user.</descrip></descripGrp><ntig><termGrp><term id="316258">prompt</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1709947">nunin sanar</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7462_148617_1862186"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A data type that stores single-precision floating-point variables as 32-bit (4-byte) floating-point numbers ranging in value from -3.402823E38 to -1.401298E-45 for negative values and 1.401298E-45 to 3.402823E38 for positive values.</descrip></descripGrp><ntig><termGrp><term id="148617">Single data type</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1862186">Nau'in Tilon bayani</term><termNote type="geographicalUsage">NGA</termNote><