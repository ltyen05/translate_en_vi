e, access, and share their files and applications seamlessly on the Web and across their world of devices.</descrip></descripGrp><ntig><termGrp><term id="1379736">Windows Live Mesh</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1381041">Live Mesh</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23935_1092702_2295168"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The value that is to be searched for in a document or any collection of data.</descrip></descripGrp><ntig><termGrp><term id="1092702">search key</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="2295168">maballin bincike</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2397_137813_587866"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A three-dimensional edge effect that is applied to the border of an object.</descrip></descripGrp><ntig><termGrp><term id="137813">bevel</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="587866">Toka – toka</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">NotSele