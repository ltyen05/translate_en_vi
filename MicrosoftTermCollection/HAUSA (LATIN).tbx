Outline data includes both the summary and detail rows or columns of an outline.</descrip></descripGrp><ntig><termGrp><term id="145705">outline data</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1862167">fasalin bayanai</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10561_19019_2086186"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A task that is part of an operating system or program, and is operating without interaction with the user while the user is working on another task.</descrip></descripGrp><ntig><termGrp><term id="19019">background task</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="2086186">aikin bayan bango</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10567_232824_1862264"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A graphic or other object that is inserted in the drawing layer so that you can position it precisely on the page or in front of or behind text or other objects.</descrip></descripGrp><ntig><termGrp><term id="232824">floating object</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1862264">kwayar abu mai yawo</term><termNote type="geographicalUsage">N