en that contains different groups of apps or content open and available for different tasks or aspects of your life.</descrip></descripGrp><ntig><termGrp><term id="2247562">virtual desktop</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="2252943">destof</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38633_2247562_2252948"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A work area on a computer screen that contains different groups of apps or content open and available for different tasks or aspects of your life.</descrip></descripGrp><ntig><termGrp><term id="2247562">virtual desktop</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="2252948">destof mai rumfa</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38633_2247563_2252943"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A work area on a computer screen that contains different groups of apps or content open and available for different tasks or aspects of your life.</descrip></descripGrp><ntig><termGrp><term id="2247563">desktop</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="2252943">destof</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38633_2247563_2252948"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A work area on a computer screen that contains different groups of apps or content open and available for different tasks or aspects of your life.</descrip></descripGrp><ntig><termGrp><term id="2247563">desktop</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="2252948">destof mai rumfa</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38635_2247565_2252949"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An action to express that you agree with similar feedback sent by someone else. Rather than resubmit the same feedback, you can tap "Upvote," which means that you agree with the feedback that has been previously submitted.</descrip></descripGrp><ntig><termGrp><term id="2247565">upvote</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="2252949">zaɓen yarda da</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38636_2247566_2252950"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To agree with similar feedback sent by someone else. Rather than resubmit the same feedback, you can tap "Upvote," which means that you agree with the feedback that has been previously submitted.</descrip></descripGrp><ntig><termGrp><term id="2247566">upvote</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="2252950">zaɓi yarda da</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38638_2247833_2252945"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The user accounts that are connected as a family. This feature allows adults to manage kids’ experiences within the kids’ user account.</descrip></descripGrp><ntig><termGrp><term id="2247833">Microsoft family</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="2252945">iyalin Microsoft</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38639_2247838_2252947"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The section in Windows Store containing the user ratings and reviews for a given app.</descrip></descripGrp><ntig><termGrp><term id="2247838">Ratings and reviews</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="2252947">Kimantawa da bita-bita</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">P