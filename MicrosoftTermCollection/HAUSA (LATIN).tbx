2379_2630025"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A computer (usually quite powerful) that is used solely as a network server.</descrip></descripGrp><ntig><termGrp><term id="782379">dedicated server</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="2630025">zaɓaɓɓar saba</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22019_782423_2484548"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An entry in a list, catalog, or directory providing information about a Web site, product or item for sale, or service.</descrip></descripGrp><ntig><termGrp><term id="782423">listing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="2484548">jeri</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22039_782585_1334315"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A category of sensor that collects biometric data for a variety of applications.</descrip></descripGrp><ntig><termGrp><term id="782585">biometric sensor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1334315">Mai haska bayanan halayar dan Adam</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech"