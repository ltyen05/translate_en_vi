eographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="952_318124_1333932"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To translate all the source code of a program from a high-level language into object code prior to execution of the program.</descrip></descripGrp><ntig><termGrp><term id="318124">build</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1333932">Gina</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="952_318124_587203"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To translate all the source code of a program from a high-level language into object code prior to execution of the program.</descrip></descripGrp><ntig><termGrp><term id="318124">build</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="587203">Tattara</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="952_36555_1333932"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To translate all the source code of a program from a high-level language into object code prior to execution of the program.</descrip></descripGrp><ntig><termGrp><term id="36555">compile</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1333932">Gina</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="952_36555_587203"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To translate all the source code of a program from a high-level language into object code prior to execution of the program.</descrip></descripGrp><ntig><termGrp><term id="36555">compile</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="587203">Tattara</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9521_253747_2709154"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An account provided in a local domain for a user whose regular account is not in a trusted domain. A local account cannot be used to log on interactively. Further, a local account created in one domain cannot be used in a trusted domain.</descrip></descripGrp><ntig><termGrp><term id="253747">local account</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="2709154">asusu na gida</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9534_258951_588331"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The degree of precision and exactness with which one entity represents another.</descrip></descripGrp><ntig><termGrp><term id="258951">fidelity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="588331">Mai tsafta</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9536_61276_1335267"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">For a computer system, to be in an inactive state, but not shut off. When the computer is switched back on, the desktop is restored exactly as it was.</descrip></descripGrp><ntig><termGrp><term id="61276">hibernate</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1335267">Baccin na'ura</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9543_415057_1862304"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A member of a dimension whose value is calculated at run time by using an expression. Calculated member values can be derived from the values of other members.</descrip></descripGrp><ntig><termGrp><term id="415057">calculated member</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1862304">kididdigaggen abu</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9547_177819_588052"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A document that contains general release information and late changes. It is one of the deliverables leading to the release readiness approved milestone.</descrip></descripGrp><ntig><termGrp><term id="177819">release notes</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="588052">Tanbihin manhaja</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9552_266832_1862287"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A secondary data source that is accessible to users who fill out forms offline. When a user is online, data from the data source is stored on the user’s computer so that it can appear in controls when the form is offline.</descrip></descripGrp><ntig><termGrp><term id="266832">offline data source</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1862287">masamar bayanai ta wajen intanet</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9555_139836_1334055"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A field you can create. A custom field can be a blank, combination, or formula field.</descrip></descripGrp><ntig><termGrp><term id="139836">custom field</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1334055">Filin da ka samar</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9561_179696_588062"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A selection technique that involves dragging out a bounding outline (also referred to as a marquee) to define the selected objects.</descrip></descripGrp><ntig><termGrp><term id="179696">region selection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="588062">Gurbin zaɓe</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9566_323154_588766"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To start or reset a computer by turning the power on, by pressing a reset button on the computer case, or by issuing a software command to restart.</descrip></descripGrp><ntig><termGrp><term id="323154">start</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="588766">Fara</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="957_117447_2325931"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Dialog from film or video displayed on the screen (usually at the bottom) and typically used to provide translation from a foreign language.</descrip></descripGrp><ntig><termGrp><term id="117447">subtitle</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="2325931">fassaran zancen fim</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9570_3951_1862029"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The engine at the core of managed code execution. The runtime supplies managed code with services such as cross-language integration, code access security, object lifetime management, and debugging and profiling support.</descrip></descripGrp><ntig><termGrp><term id="3951">common language runtime</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1862029">lokacin bude yaren gama-gari</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9570_3952_1862029"><langSet xml:lang="en-US"><descripGrp><descrip type="definiti