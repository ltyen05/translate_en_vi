_186005_2718444"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The item on a user's My Status menu that resets the user's status to the previous setting after the user has manually selected a status setting.</descrip></descripGrp><ntig><termGrp><term id="186005">Reset Status</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="2718444">Matsayin sake saiti</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12222_146338_1862169"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A field that is assigned a series orientation in a PivotChart report. In a chart, series are represented in the legend.</descrip></descripGrp><ntig><termGrp><term id="146338">PivotChart series field</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1862169">Filin jeri na PivotChart</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1223_147636_1862178"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A link that uses a relative URL.</descrip></descripGrp><ntig><termGrp><term id="147636">relative link</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1862178">makamanciyar rariya</term><termNote type="geogr