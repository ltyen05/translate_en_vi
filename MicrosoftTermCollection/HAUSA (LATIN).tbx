f performing a command.</descrip></descripGrp><ntig><termGrp><term id="79731">menu button</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1157522">mabudin mazaba</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10532_36444_1335294"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature of a computer or operating system that allows it to run programs written for a different system.</descrip></descripGrp><ntig><termGrp><term id="36444">compatibility mode</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1335294">Zaunawa daidai</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10541_168073_1862193"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The area of the workspace that contains the options you select for a given task. Workpanes appear at certain times, such as when a document is opened, or when you click certain items on menus and toolbars.</descrip></descripGrp><ntig><termGrp><term id="168073">workpane</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1862193">bigiren aiki</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="gramm