"40621_2357849_2361001"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that allows users to tag emails by using # followed by a keyword within the message and that enables users to view all emails tagged with that keyword in their email account.</descrip></descripGrp><ntig><termGrp><term id="2357849">Hashtags</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="2361001">Hashtags</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40632_2358041_2359905"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The category of apps or games that are selected based on downloads, usage, and revenue over a 7-day period and ranks them according to those metrics.</descrip></descripGrp><ntig><termGrp><term id="2358041">Most popular</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="2359905">Mafi sananne</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40633_2358042_2359904"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The category for items that are in the top 1000 items based on sales.</descrip></descripGrp><ntig><termGrp><term id="2358042">Best selling</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xm