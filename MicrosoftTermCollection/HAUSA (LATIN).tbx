US"><descripGrp><descrip type="definition">The set of Microsoft software for email, instant messaging, photos, and personal movies available to customers in a single download and installation.</descrip></descripGrp><ntig><termGrp><term id="1636168">Windows Essentials</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1381056">Muhimman abubuwan Windows Live</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24603_1636168_1678268"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The set of Microsoft software for email, instant messaging, photos, and personal movies available to customers in a single download and installation.</descrip></descripGrp><ntig><termGrp><term id="1636168">Windows Essentials</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1678268">Muhimmin Abubuwan Windows</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24604_1136243_1381057"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Windows Live universal roaming contact list that allows users to share their contact information and subscribe to others’ to automatically receive updates across Windows Live Messenger and Windows Live Spaces.</descrip></descripGrp><ntig><termGrp><term id="1136243">Windows Live Contacts</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1381057">Hanyoyin Tuntuɓa na Windows Live</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24606_1136281_1381058"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Windows Live service that allows users to make computer-to-computer or computer-to-phone calls. Users must be signed in to Windows Live Messenger to use it.</descrip></descripGrp><ntig><termGrp><term id="1136281">Windows Live Call</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1381058">Kira na Windows Live</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24607_1136282_1381059"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Windows Live service that lets people and groups add, manage, and share event information.</descrip></descripGrp><ntig><termGrp><term id="1136282">Windows Live Calendar</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1381059">Kalandar Windows Live</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></nt