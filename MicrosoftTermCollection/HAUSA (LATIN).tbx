the feature that allows users to create high-definition photos and videos by capturing a short, high-definition video recording.</descrip></descripGrp><ntig><termGrp><term id="2144338">Lumia Moments</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="2244033">Lumia Moments</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37582_2144340_2244034"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app that allows the user to capture multiple images simultaneously with different focus settings.</descrip></descripGrp><ntig><termGrp><term id="2144340">Lumia Refocus</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="2244034">Lumia Refocus</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37583_2144341_2244035"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app for capturing, editing, and sharing photos of oneself that can be automatically enhanced with various effects.</descrip></descripGrp><ntig><termGrp><term id="2144341">Lumia Selfie</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="2244035">Lumia Selfie</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37584_2144342_2336064"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A photo that one has taken of oneself, normally using a smartphone or a digital camera, that is planned to be uploaded to a social media website.</descrip></descripGrp><ntig><termGrp><term id="2144342">selfie</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="2336064">hoton kanka</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37585_2354826_2357421"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that allows the camera to capture multiple shots at different flash and exposure settings, so that the user can shoot first and edit and select the perfect shot later. The resulting photo is produced by merging multiple images to produce different lighting effects, similar to HDR or blended flash.</descrip></descripGrp><ntig><termGrp><term id="2354826">Rich HDR</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="2357421">Yalwataccen HDR</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37586_2144610_2190102"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The button that invokes the Start menu (desktop) and the Start screen (mobile or desktop).</descrip></descripGrp><ntig><termGrp><term id="2144610">Start</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="2190102">Farawa</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37587_2144631_2190104"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The full-screen view of Start that includes the list of items, such as apps, websites, and other info that a person can specify and customize. It is what is displayed when the Start button is used.</descrip></descripGrp><ntig><termGrp><term id="2144631">Start screen</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="2190104">allon Farawa</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37587_2144631_2218580"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The full-screen view of Start that includes the list of items, such as apps, websites, and other info that a person can specify and customize. It is what is displayed when the Start button is used.</descrip></descripGrp><ntig><termGrp><term id="2144631">Start screen</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml