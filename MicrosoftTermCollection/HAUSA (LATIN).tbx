id="14585_329892_1157319"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A change to an account to correct or update the balance.</descrip></descripGrp><ntig><termGrp><term id="329892">adjustment</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1157319">gyaran asusu</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14606_211370_588124"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The date by which some task or action should be completed.</descrip></descripGrp><ntig><termGrp><term id="211370">due date</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="588124">Ranar</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14609_183539_2463779"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An artificial intelligence program that performs a task on a network as an agent for a user or another program.</descrip></descripGrp><ntig><termGrp><term id="183539">bot</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="2463779">wakilin aiki</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14609_183540_2463779"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An artificial intelligence program that performs a task on a network as an agent for a user or another program.</descrip></descripGrp><ntig><termGrp><term id="183540">robot</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="2463779">wakilin aiki</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14610_25574_587107"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A graphic element that appears similar to a physical button or keyboard key in the UI. A button is "pressed" by clicking on it with a mouse, by hitting ENTER or RETURN on the keyboard (if the button has the focus) or tapping by a finger.</descrip></descripGrp><ntig><termGrp><term id="25574">button</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="587107">Makunni</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14611_123792_1334114"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An automated tool that helps find and fix specific problems on your computer.</descrip></descripGrp><ntig><termGrp><term id="123792">troubleshooter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1334114">Mai gano matsala</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14612_73965_587482"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The key on the keyboard that is labeled with a left arrow.</descrip></descripGrp><ntig><termGrp><term id="73965">left arrow</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="587482">Kibiyar hagu</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14617_93343_1157953"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of industry-standard framing and authentication protocols that are included with Windows to ensure interoperability with other remote access software. PPP negotiates configuration parameters for multiple layers of the Open Systems Interconnection (OSI) model. The Internet standard for serial communications, PPP defines how data packets are exchanged with other Internet-based systems using a modem connection. PPP is documented in RFC 1661.</descrip></descripGrp><ntig><termGrp><term id="93343">Point-to-Point Protocol</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1157953">PPP</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech"