</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14555_95472_2690427"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To cue the user that the system is requesting input or action.</descrip></descripGrp><ntig><termGrp><term id="95472">prompt</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="2690427">sanadi</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14562_318120_1335397"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The button on your pointing device that you use to display shortcut menus or other program-specific features.</descrip></descripGrp><ntig><termGrp><term id="318120">right mouse button</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1335397">Maballin linzamin kwamfuta na dama</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14574_123914_1334113"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Confidence in the reliability of an entity or service and the information that it provides.</descrip></descripGrp><ntig><termGrp><term id="123914">trust</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet