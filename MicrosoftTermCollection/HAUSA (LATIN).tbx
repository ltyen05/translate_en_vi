Note><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40497_2352186_2353881"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature set that integrates data protection at the platform level so as to protect corporate data against inadvertent disclosure to unauthorized users and public services through email, social media and public cloud. It includes encryption of enterprise data when it enters the device or is created on the device, such that data stays protected against disclosure to applications and endpoints outside enterprise control.</descrip></descripGrp><ntig><termGrp><term id="2352186">Enterprise data protection</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="2353881">EDP</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40497_2352186_2353883"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature set that integrates data protection at the platform level so as to protect corporate data against inadvertent disclosure to unauthorized users and public services through email, social media and public cloud. It includes encryption of enterprise data when it enters the device or is created on the device, such that data stays protected against disclosure to applications and endpoints outside enterprise control.</descrip></descripGrp><ntig><termGrp><term id="2352186">Enterprise data protection</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></ter