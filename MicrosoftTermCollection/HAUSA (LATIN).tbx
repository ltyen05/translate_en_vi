g></langSet></termEntry><termEntry id="25918_1231891_1803743"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The link to the Microsoft service agreement.</descrip></descripGrp><ntig><termGrp><term id="1231891">Terms</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1803743">Sharuɗɗan</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25919_1231893_1381089"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Windows Mobile footer link to the site that is built for viewing from a PC.</descrip></descripGrp><ntig><termGrp><term id="1231893">PC site</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1381089">Sait ɗin PC</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25921_1231895_1381090"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Windows Mobile footer link to the site that is built for viewing from mobile devices.</descrip></descripGrp><ntig><termGrp><term id="1231895">Mobile site</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1381090">Sait ɗin Wayar tafi-da-gidanka</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25957_1245016_2294643"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Identity Lifecycle Manager management agent provided by Microsoft to connect to Active Directory Domain Services (AD DS) or Active Directory directory service.</descrip></descripGrp><ntig><termGrp><term id="1245016">Active Directory Management Agent</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="2294643">Wakilin Kula da Ma’ajiya Mai aiki</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25957_1245016_2294647"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Identity Lifecycle Manager management agent provided by Microsoft to connect to Active Directory Domain Services (AD DS) or Active Directory directory service.</descrip></descripGrp><ntig><termGrp><term id="1245016">Active Directory Management Agent</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="2294647">ADMA</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25957_1245017_2294643"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Identity Lifecycle Manager management agent provided by Microsoft to connect to Active Directory Domain Services (AD DS) or Active Directory directory service.</descrip></descripGrp><ntig><termGrp><term id="1245017">ADMA</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="2294643">Wakilin Kula da Ma’ajiya Mai aiki</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25957_1245017_2294647"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Identity Lifecycle Manager management agent provided by Microsoft to connect to Active Directory Domain Services (AD DS) or Active Directory directory service.</descrip></descripGrp><ntig><termGrp><term id="1245017">ADMA</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="2294647">ADMA</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25959_1247422_2295228"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mailbox folder structure on some IMAP servers in which mail folders are accessed with the administrator username and password, and shell login access to the mail server is not allowed. Access to specific mailboxes is managed by access control lists. This means that users are assigned the permissions to only access their mailbox folder, while an administrator has access to all mailboxes. This allows organizations to use administrative credentials to migrate email from an IMAP server to Outlook Live.</descrip></descripGrp><ntig><termGrp><term id="1247422">virtual shared folder</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="2295228">ma'adamar bayanai</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25978_1251313_2294782"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To place a windows Live ID in a forced rename state, while the Windows Live ID and all of its existing settings, including the password, Xbox Live points, or Zune points are preserved. The user can sign in using the Windows Live ID and its password, but they're immediately asked to rename the Windows Live ID. They must specify an email address that's outside the Outlook Live domain.</descrip></descripGrp><ntig><termGrp><term id="1251313">evict</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="2294782">fitar</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25985_1253605_2340759"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A graphical representation of data where the intensity of color corresponds to the related analytical data. For example, low values in a range appear as blue (cold) and high values as red (hot).</descrip></descripGrp><ntig><termGrp><term id="1253605">heat map</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="2340759">tsaurin taswira</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25985_2593079_2340759"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A graphical representation of data where the intensity of color corresponds to the related analytical data. For example, low values in a range appear as blue (cold) and high values as red (hot).</descrip></descripGrp><ntig><termGrp><term id="2593079">heatmap</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="2340759">tsaurin taswira</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2599_211415_1335028"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Intel microprocessor that uses explicitly parallel instruction set computing and 64-bit memory addressing. "Itanium-based" refers to systems or platforms that are based on the Itanium processor. "Itanium2-based" refers to systems or platforms that are based on the Itanium2 processor. "Itanium architecture-based" refers to systems or platforms that are based on the Itanium and Itanium2 processors.</descrip></descripGrp><ntig><termGrp><term id="211415">Itanium</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1335028">Itaniyom</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25992_1253847_1663466"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An online community where members can virtually socialize by posting and commenting on a newsfeed, by chatting, and by sharing photos, images, articles, and other content.</descrip></descripGrp><ntig><termGrp><term id="1253847">social network</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1663466">hanyan sadarwa ta zamantakewa</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25992_1253847_2086737"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An online community where members can virtually socialize by posting and commenting on a newsfeed, by chatting, and by sharing photos, images, articles, and other content.</descrip></descripGrp><ntig><termGrp><term id="1253847">social network</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="2086737">haɗuwar jama'a</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25992_2696313_1663466"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An online community where members can virtually socialize by posting and commenting on a newsfeed, by chatting, and by sharing photos, images, articles, and other content.</descrip></descripGrp><ntig><termGrp><term id="2696313">network</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1663466">hanyan sadarwa ta zamantakewa</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25992_2696313_2086737"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An online community where members can virtually socialize by posting and commenting on a newsfeed, by chatting, and by sharing photos, images, articles, and other content.</descrip></descripGrp><ntig><termGrp><term id="2696313">network</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="2086737">haɗuwar jama'a</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26004_1256406_1453288"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A short summary of the contents of a document that gives the reader a quick overview of its topic and purpose.</descrip></descripGrp><ntig><termGrp><term id="1256406">abstract</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><n