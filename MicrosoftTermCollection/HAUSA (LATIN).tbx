">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="2249228">Tushen aika bayanai</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2500_81423_2295092"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An individual who reviews content in certain online newsgroups, mailing lists, and forums in order to decide if they are appropriate or not, editing or deleting the ones that aren’t prior to them being they are made public.</descrip></descripGrp><ntig><termGrp><term id="81423">moderator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="2295092">mai tsarawa</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25004_1167216_2263595"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that uses speech recognition to enable you to interact with your computer or other devices by voice. You can dictate documents and emails in mainstream applications, and use voice commands to start and switch between applications, control the operating system and even fill out forms on the web.</descrip></descripGrp><ntig><termGrp><term id="1167216">Windows Speech Recognition</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="2263595">Gane Magana na Windows</term><termNote type="geographicalUsage">NGA</term