mmaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="2444020">zane da aka yi da hannu</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43071_2440729_2444012"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tool category for tools that take a 2D freehand drawing and automatically turn that drawing into a 3D object.</descrip></descripGrp><ntig><termGrp><term id="2440729">3D doodle</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="2444012">zane da aka yi da hannu na 3D</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43079_2441032_2445481"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The font style that applies a classic look to the typography of the book that is being read.</descrip></descripGrp><ntig><termGrp><term id="2441032">Classic</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="2445481">Na da</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4308_116719_1862083"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of connector in the form of a rectilinear line that is used for joining two shapes.</descrip></descripGrp><ntig><termGrp><term id="116719">straight connector</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1862083">mai sadarwar kai tsaye</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43092_2441944_2690430"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To provide an initial set of marked-up documents or data to a machine learning system as part of the training process for it to start learning was is relevant and what isn’t.</descrip></descripGrp><ntig><termGrp><term id="2441944">seed</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="2690430">iri</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43100_2441981_2445482"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The font style that applies a particular font to the book that is being read to maximize reading comprehension and speed.</descrip></descripGrp><ntig><termGrp><term id="2441981">Focus</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="2445482">Ƙura ido</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43102_2441983_2445483"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The font style that applies a particular font to the book that is being read, resembling a newspaper or other news source.</descrip></descripGrp><ntig><termGrp><term id="2441983">News</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="2445483">Labarai</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43103_2441984_2445484"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The font style that applies a particular font to the book that is being read to minimize clutter and create a clean look.</descrip></descripGrp><ntig><termGrp><term id="2441984">Pure</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="2445484">Tsantsa</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43104_2441985_2445485"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The font style that applies a particular font to the book that is being read to make it look more fun and friendly.</descrip></descripGrp><ntig><termGrp><term id="2441985">Relaxed</term><termNote type="partOfSpeech">Pro