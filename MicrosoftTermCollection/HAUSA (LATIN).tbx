ber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40603_2357731_2359906"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The display technology that provides high-resolution display, touch and ink capabilities, wide-viewing angle, and more.</descrip></descripGrp><ntig><termGrp><term id="2357731">PixelSense</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="2359906">PixelSense</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40618_2392508_2517838"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Project work management app that helps a team create new plans, organize and assign work, share files, discuss team activity, and get updates on progress.</descrip></descripGrp><ntig><termGrp><term id="2392508">Planner</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="2517838">Planner</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40618_2393978_2517838"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Project work management app that helps a team create new plans, organize and assign work, share files, discuss team activity, and get updates on progress.</descrip></descripGrp><ntig><termGrp><term id="2393978">Microsoft Planner</term><termNote type="partOfSpeech">Pro