Set xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1334955">Ababen da Windows ya kunsa</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5770_133968_1335166"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A local area network (LAN) that sends and receives data via radio, infrared optical signaling, or some other technology that does not require a physical connection between individual nodes and the hub. Wireless LANs are often used in office or factory settings where a user must carry a portable computer from place to place.</descrip></descripGrp><ntig><termGrp><term id="133968">wireless LAN</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1335166">LAN na wayar iska</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5775_148897_587961"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Editing that occurs within a structured document such as a well-formed XML document.</descrip></descripGrp><ntig><termGrp><term id="148897">structural editing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="587961">Sashen aikin edita</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="578_148201_1862183"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">One of the colors defined in a set of chosen colors. If you fill an object with a scheme color, the object's color changes whenever you choose another color scheme for that publication.</descrip></descripGrp><ntig><termGrp><term id="148201">scheme color</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1862183">fasalin launi</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5783_111533_2488391"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To prepare a computer, a device, a software program or application to operate.</descrip></descripGrp><ntig><termGrp><term id="111533">set up</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="2488391">saita</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5788_2731405_2295068"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Exchange Mailbox assistant that applies and processes the message retention settings based on retention policies.</descrip></descripGrp><ntig><termGrp><term id="2731405">Managed Folder Assistant</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-L