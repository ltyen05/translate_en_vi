ig><termGrp><term id="1091334">access</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1529983">isa</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23872_1091335_1527300"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An account holder who is a family member, but not a parent, and who has limited use of the Internet. Children can view their own settings, but they can't change them.</descrip></descripGrp><ntig><termGrp><term id="1091335">child</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1527300">yaro</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23874_1091337_1527450"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An account holder who is the primary administrator (parent) and the family members they manage.</descrip></descripGrp><ntig><termGrp><term id="1091337">family</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1527450">dangi</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23875_10