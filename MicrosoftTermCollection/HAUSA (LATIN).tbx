vatar.</descrip></descripGrp><ntig><termGrp><term id="2396192">Avatar items</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="2399479">Abubuwan Avatar</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42353_2396193_2399481"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The game category with games that allow you to use your phone to interact with Xbox. You can browse and type on Xbox live using your phone instead of the controller.</descrip></descripGrp><ntig><termGrp><term id="2396193">Companion</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="2399481">Mataimaki</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42354_2396194_2399486"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app category that offers utility apps which allow you to change settings and test network connections.</descrip></descripGrp><ntig><termGrp><term id="2396194">Tools</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="2399486">Kaya</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNot