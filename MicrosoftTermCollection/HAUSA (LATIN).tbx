rp></ntig></langSet></termEntry><termEntry id="36782_2238946_2244038"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The setting to minimize distractions while driving.</descrip></descripGrp><ntig><termGrp><term id="2238946">Driving mode</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="2244038">Yanayin tuƙi</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36783_2071243_2084427"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The setting that determines if the screen will rotate automatically when the phone is rotated.</descrip></descripGrp><ntig><termGrp><term id="2071243">screen rotation</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="2084427">kewayawar fuskar waya</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36784_2071244_2084462"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft operating system designed for handheld portable devices.</descrip></descripGrp><ntig><termGrp><term id="2071244">Windows Embedded Handheld</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="2084462">Windows Embedded Handheld</term><termNote type="ge