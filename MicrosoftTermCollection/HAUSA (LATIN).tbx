><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="588574">Ƙari</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6490_183384_2181577"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An agreement between two owners to promote content in different places.</descrip></descripGrp><ntig><termGrp><term id="183384">affiliate marketing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="2181577">kasuwancin dangantaka</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6502_315144_1157506"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A word, symbol, or other group of characters used to identify a file, a storage medium, an element defined in a computer program, or a specific item in a document such as a spreadsheet or a chart.</descrip></descripGrp><ntig><termGrp><term id="315144">label</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1157506">alama</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6507_130126_587804"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A series of measures to protect a machine from being infected by a virus.</descrip></descripGrp><ntig><termGrp><term id="130126">virus protection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="587804">Hanyoyin riga-kafi</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6513_45147_1709553"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Any piece of equipment that can be attached physically or wirelessly to a network or computer, for example, printers, keyboards, external disk drives, or other peripheral equipment.</descrip></descripGrp><ntig><termGrp><term id="45147">device</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1709553">na'ura</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6513_45147_1709558"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Any piece of equipment that can be attached physically or wirelessly to a network or computer, for example, printers, keyboards, external disk drives, or other peripheral equipment.</descrip></descripGrp><ntig><termGrp><term id="45147">device</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1709558">dibayis</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6514_397180_2295064"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Settings that are applied to the managed folders in users' mailboxes to control the retention and journaling of messages for messaging records management (MRM). Managed content settings define when messages that are no longer needed are to be removed or journaled (copied) to a separate storage location outside the mailbox.</descrip></descripGrp><ntig><termGrp><term id="397180">managed content settings</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="2295064">saittunan kunshi da aka kula da</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6516_50772_1335188"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of turning data into a stream of bits. Encoding is part of the serialization process that converts data into a stream of ones and zeros.</descrip></descripGrp><ntig><termGrp><term id="50772">encoding</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1335188">Juyar da bayanai zuwa lamba</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6520_91124_587605"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An effect created by simple, repeating designs such as vertical or horizontal lines.</descrip></descripGrp><ntig><termGrp><term id="91124">pattern</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="587605">Rodi-rodi</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6533_62030_1334016"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A postal address at which a person is normally resident.</descrip></descripGrp><ntig><termGrp><term id="62030">home address</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1334016">Adireshin gida</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6538_360134_2087094"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A view that shows a graphical analysis of data in a datasheet or form. You can see different levels of detail or specify the layout by dragging fields and items or by showing and hiding items in the drop-down lists for the fields.</descrip></descripGrp><ntig><termGrp><term id="360134">PivotChart view</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="2087094">dubin PivotChart</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6540_8001_1157304"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Interactive or animated content used on the Internet. Active content includes ActiveX controls and web browser add-ons.</descrip></descripGrp><ntig><termGrp><term id="8001">active content</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1157304">kumshin budadiyar taga</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6554_112160_1806625"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The paper that a publication is printed on.</descrip></descripGrp><ntig><termGrp><term id="112160">sheet</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1806625">shafin takarda</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6563_123499_1335189"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A data structure containing zero or more nodes that are linked together in a hierarchy. If any nodes are present, one node is the root; each node except the root is the child of one and only one other node, and each node has zero or more nodes as children.</descrip></descripGrp><ntig><termGrp><term id="123499">tree</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1335189">Li'irabin tarin bayanai</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6573_5678_586976"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A compressed file.</descrip></descripGrp><ntig><termGrp><term id="5678">archive</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="586976">Rumbun ajiya</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6576_232820_1157423"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A vertical pane along the left edge of the document window that displays an outline of the document's headings, and enables the user to navigate to or manipulate different parts of the document.</descrip></descripGrp><ntig><termGrp><term id="232820">Document Map</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1157423">taswirar daftarin aiki</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">NotSelected</t