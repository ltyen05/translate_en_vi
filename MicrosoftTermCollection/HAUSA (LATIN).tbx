ting for some effects that camera movement has on images in videos.</descrip></descripGrp><ntig><termGrp><term id="1673865">stabilization</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1680828">kara kyau na bideo</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32405_1674922_1680828"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A technique that increases sharpness and fidelity by compensating for some effects that camera movement has on images in videos.</descrip></descripGrp><ntig><termGrp><term id="1674922">image stabilization</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1680828">kara kyau na bideo</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32406_1673920_1680830"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The cloud service that enables users to communicate and collaborate with people online and access their conversations, photos, documents, contacts, appointments, settings, and services across PC, phone, and other devices.</descrip></descripGrp><ntig><termGrp><term id="1673920">Live</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1680830">Live</term><termNote type="