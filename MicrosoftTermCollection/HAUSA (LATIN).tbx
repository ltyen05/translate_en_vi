><descrip type="definition">To transfer information either to a storage device, such as a disk, or to an output device, such as the monitor or a printer. Writing is the means by which a computer provides the results of processing. A computer can also be said to write to the screen when it displays information on the monitor.</descrip></descripGrp><ntig><termGrp><term id="134615">write</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1334956">Rubuta</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6063_137589_587863"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A database on a server that matches user names to passwords.</descrip></descripGrp><ntig><termGrp><term id="137589">authentication database</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="587863">Tan tagayar tarin bayani</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6064_140594_1773548"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A cell that contains a formula that refers to another cell. For example, if cell D10 contains the formula =B5, cell D10 is a dependent of cell B5.</descrip></descripGrp><ntig><termGrp><term id="140594">dependent</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langS