2926_2721000"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A trojan that accesses remote Web sites in order to download and install malicious or potentially unwanted software to the computer that the Trojan has infected.</descrip></descripGrp><ntig><termGrp><term id="502926">downloader</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="2721000">masaukin troja</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13679_277388_2326604"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An authentication credential similar to a password, consisting of numbers.</descrip></descripGrp><ntig><termGrp><term id="277388">passcode</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="2326604">lambarsirrin shiga</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13683_110861_1334094"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A computer that provides shared resources, such as files or printers, to network users.</descrip></descripGrp><ntig><termGrp><term id="110861">server</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1334094">Saba</term><termNote type="geographicalUsage">NGA</termNote><termNote