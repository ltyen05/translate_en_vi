ted</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9699_150362_587978"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The measurement of the area in front of and behind the subject that is in focus.</descrip></descripGrp><ntig><termGrp><term id="150362">depth of field</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="587978">Zurfin fili</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9707_237833_1453198"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of masters associated with a particular Visio drawing type, or template. By default, stencils that open with a template are docked on the left side of the drawing window.</descrip></descripGrp><ntig><termGrp><term id="237833">stencil</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1453198">sitensil</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9709_144267_1862155"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A fundamental data type that holds large integers. A Long variable is stored as a 32-bit number ranging in value from -2,147,483,648 to 2,147,483,647.</descrip></descripGrp><ntig><termGrp><term id="144267">Long data type</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1862155">Nau'in bayanai masu tsawo</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9718_17587_1998091"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature in Internet Explorer that remembers the information you have typed into the Address bar, web forms, or password fields, and which automatically fills in that information if you start to type the same thing again later.</descrip></descripGrp><ntig><termGrp><term id="17587">AutoComplete</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1998091">Cikawan Oto</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9726_210054_2696605"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of reports or other data that is arranged in a panel format on a single page, or series of pages, in a web browser or SharePoint site.</descrip></descripGrp><ntig><termGrp><term id="210054">dashboard</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="2696605">dashbod</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9734_42848_587250"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The manipulation of data to transform it into some desired result.</descrip></descripGrp><ntig><termGrp><term id="42848">data processing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="587250">Tantance tarin bayani</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9753_141881_1862136"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Text or graphics inserted in a document when Microsoft Word carries out a field's instructions. When you print the document or hide field codes, the field results replace the field codes.</descrip></descripGrp><ntig><termGrp><term id="141881">field results</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1862136">sakamakon fili</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9767_319131_588705"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to text that is aligned along the left margin.</descrip></descripGrp><ntig><termGrp><term id="319131">left-aligned</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="588705">Jirga-dama</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9775_142952_1862141"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A drop-down list box control on a data access page that retrieves records from an underlying recordset based on the value you select from the list. On a grouped page, the control retrieves a specific group of records.</descrip></descripGrp><ntig><termGrp><term id="142952">group filter control</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1862141">mai sarrafa rairayar rukuni</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9789_158215_1157326"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The company placing, and often paying for, a promotional message, or advertisement.</descrip></descripGrp><ntig><termGrp><term id="158215">advertiser</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1157326">dillalin sako</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9800_30472_1335270"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In text-based computer graphics, a block of memory addresses that correspond to character spaces on a display screen. The memory allocated to each character space is used to hold the description of the character to be displayed in that space.</descrip></descripGrp><ntig><termGrp><term id="30472">character map</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1335270">Taswirar harafi</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9805_262641_1335271"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A title animation in Windows Movie Maker.</descrip></descripGrp><ntig><termGrp><term id="262641">Subtitle</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1335271">Dan karamin kan batu</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9820_2727454_588506"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A directory or folder made available to users over the network.</descrip></descripGrp><ntig><termGrp><term id="2727454">file share</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="588506">Rabawa</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9820_298002_588506"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A directory or folder made available to users over the network.</descrip></descripGrp><ntig><termGrp><term id="298002">share</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="588506">Rabawa</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9828_558613_2701318"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A person who takes part in an online interaction such as conference call or meeting.</descrip></descripGrp><ntig><termGrp><term id="558613">participant</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="2701318">mai ma'amala</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9830_13827_2086183"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An activity represented by a time interval that has a start time, an end time, and a duration.</descrip></descripGrp><ntig><termGrp><term id="13827">appointment</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="2086183">tsarin aiki</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="gra