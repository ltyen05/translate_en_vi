/langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1334263">Na'urar sauti mai hoto</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21202_767148_1334264"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An image editing feature that allows a user to isolate the foreground portion of an image and make the background transparent.</descrip></descripGrp><ntig><termGrp><term id="767148">Background Removal</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1334264">Na'urar Gyara Hoto</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21203_767149_1334265"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An option that removes narrations and laser pointer gestures or timings from a presentation or from a specific slide.</descrip></descripGrp><ntig><termGrp><term id="767149">Clear Recordings</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1334265">Share bayanan rikoda</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21208_767313_2108564"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of adding geospatial metadata (e.g. longitude, latitude) to media (e.g. Websites, RSS feeds, or images).</descrip></descripGrp><ntig><termGrp><term id="767313">geotagging</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="2108564">bayanin wurin tambari</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2121_375_586892"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An area of memory reserved for temporarily holding data before that data is used by a receiving device or application. Buffering protects against the interruption of data flow.</descrip></descripGrp><ntig><termGrp><term id="375">buffer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="586892">Tunani na wucin-gadi</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21211_767324_1862426"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of cryptographic algorithms specified by the US National Security Agency to provide an interoperable standard for government and industry.</descrip></descripGrp><ntig><termGrp><term id="767324">Suite B</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1862426">Suit B</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21212_767327_1334266"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ability of software to support customer-preferred algorithms for encryption, hashing, entropy and digital signatures.</descrip></descripGrp><ntig><termGrp><term id="767327">cryptographic agility</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1334266">Hikimar rubutun kalmomin sirri</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21212_767328_1334266"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ability of software to support customer-preferred algorithms for encryption, hashing, entropy and digital signatures.</descrip></descripGrp><ntig><termGrp><term id="767328">crypto agility</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1334266">Hikimar rubutun kalmomin sirri</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21213_767329_1806587"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The portion of InfoPath used to design forms.</descrip></descripGrp><ntig><termGrp><term id="767329">Designer</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1806587">Mai zayyana</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21217_767333_1453261"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To remove a user's changes from the Microsoft Office Document Cache without deleting the file on the server or removing the latest version downloaded from the server from the Office Document Cache.</descrip></descripGrp><ntig><termGrp><term id="767333">discard changes</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1453261">a kawar da canje-canje</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21227_767357_1334267"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A security feature that validates files before allowing them to be loaded by the application, in order to protect against file format vulnerabilities.</descrip></descripGrp><ntig><termGrp><term id="767357">Office File Validation</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1334267">Tabbatar da ingancin fayil na Office</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21244_767583_1334268"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows end users and IT admins to control which file types and versions can be opened and saved in the application.</descrip></descripGrp><ntig><termGrp><term id="767583">File Block</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1334268">Shamakin Fayil</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21253_767590_1334269"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows the user to superimpose a dot over a presentation and control its position with the mouse. The appearance of the dot is similar to that of a traditional laser pointer, and it is broadcast to all presentation viewers and can be recorded into video (Save to Video).</descrip></descripGrp><ntig><termGrp><term id="767590">Laser Pointer</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1334269">Mai saka karin hasken wuta</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21265_767631_1334270"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An option that initiates an email response addressed to all of the recipients on the To or Cc lines of the original message.</descrip></descripGrp><ntig><termGrp><term id="767631">Reply to All</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1334270">Sakon amsa bai daya</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21265_767632_1334270"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An option that initiates an email response addressed to all of the recipients on the To or Cc lines of the original message.</descrip></descripGrp><ntig><termGrp><term id="767632">Reply All</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1334270">Sakon amsa bai daya</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21277_768421_1334271"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The mode of Windows Photo Viewer which consists of a top level window displaying one photograph at a time, with navigation controls.</descrip></descripGrp><ntig><termGrp><term id="768421">Photo Viewer</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1334271">Na'urar Duba Hoto</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21278_768422_1334272"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mode of Windows Photo Viewer which displays full-screen slide shows for photos.</descrip></descripGrp><ntig><termGrp><term id="768422">Slideshow</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1334272">Nuna Hoto</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21290_768424_1334273"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A recordable media (such as CD-RW) to which you can only write once without reformatting.</descrip></descripGrp><ntig><termGrp><term id="768424">single session-only disc</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1334273">Faifan diskin dauka daya kawai</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21291_768440_1334274"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A recordable media to which you can write several times without reformatting.</descrip></descripGrp><ntig><termGrp><term id="768440">multi session-capable disc</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1334274">Faifan diski mai iya dauka da yawa</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21299_768624_1334275"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that is added to the Microsoft Office Compatibility Pack to open Word, Excel, and PowerPoint binary format files and securely convert them to the Office 2007 file formats.</descrip></descripGrp><ntig><termGrp><term id="768624">Microsoft Office Isolated Conversion Environment</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1334275">MOICE</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21299_768624_1862427"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that is added to the Microsoft Office Compatibility Pack to open Word, Excel, and PowerPoint binary format files and securely convert them to the Office 2007 file formats.</descrip></descripGrp><ntig><termGrp><term id="768624">Microsoft Office Isolated Conversion Environment</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1862427">Wararren Wurin canji na Microsoft Office</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21299_768625_1334275"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that is added to the Microsoft Office Compatibility Pack to open Word, Excel, and PowerPoint binary format files and securely convert them to the Office 2007 file formats.</descrip></descripGrp><ntig><termGrp><term id="768625">MOICE</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1334275">MOICE</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21299_768625_1862427"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that is added to the Microsoft Office Compatibility Pack to open Word, Excel, and PowerPoint binary format files and securely convert them to the Office 2007 file formats.</descrip></descripGrp><ntig><termGrp><term id="768625">MOICE</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1862427">Wararren Wurin canji na Microsoft Office</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21300_1054681_2096530"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that makes Outlook auto-complete lists available through the default Exchange mailbox.</descrip></descripGrp><ntig><termGrp><term id="1054681">Suggested Contacts</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="2096530">Bayanan abokan ma'amala da aka tanada</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21301_769458_1334277"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A common credential store and interface that is used to save and manage user credentials, such as user names and passwords, so you can easily log on to Web sites and connect to other resources, such as computers.</descrip></descripGrp><ntig><termGrp><term id="769458">Credential Manager</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1334277">Manajan Bayanan damar iso ga kwamfuta</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21302_769460_1334278"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of credentials that users can create, store and manage in Credential Manager.</descrip></descripGrp><ntig><termGrp><term id="769460">vault</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1334278">Bawult</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21303_769462_1334279"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of vault that contains Web passwords and secure notes that you can place on a USB flash drive and use on another computer.</descrip></descripGrp><ntig><termGrp><term id="769462">personal vault</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1334279">Bawult na mutum</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21309_769803_2086232"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To remove data permanently from a storage medium. This is usually done by replacing existing data with zeros or meaningless text or, in magnetic media, by disturbing the magnetic particles' physical arrangement, either with the erase head or with a large magnet.</descrip></descripGrp><ntig><termGrp><term id="769803">erase</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="2086232">share</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2131_397166_2294806"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process of permanently deleting something by removing it from the store or moving it to the dumpster when dumpster functionality is enabled.</descrip></descripGrp><ntig><termGrp><term id="397166">hard delete</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="2294806">sharewa</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2132_125577_1335018"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">When referring to a device, to remove the corresponding device drivers from the hard disk and physically remove the device from the computer.</descrip></descripGrp><ntig><termGrp><term id="125577">uninstall</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1335018">Kin girka</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21322_769845_1453262"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A control in a form that consists of an actionable image. At run time the user can click the image to run rules or actions similar to a button.</descrip></descripGrp><ntig><termGrp><term id="769845">picture button</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1453262">maɓallin hoto</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21333_770402_2086430"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A note that contains recorded information.</descrip></descripGrp><ntig><termGrp><term id="770402">voice note</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="2086430">ƙarin bayanin murya</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21334_2675561_2402672"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft app that creates sticky notes that can be shared between devices, that cloud sync, that are stored on Exchange, and that provide contextual reminders and actions that can be performed based on the content.</descrip></descripGrp><ntig><termGrp><term id="2675561">Microsoft Sticky Notes</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="2402672">Liƙaƙƙun Rubutu</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21334_2675561_2676909"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft app that creates sticky notes that can be shared between devices, that cloud sync, that are stored on Exchange, and that provide contextual