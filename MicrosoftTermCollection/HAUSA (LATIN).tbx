50860_2503914"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office servicing option in which new feature upgrades are available for installation right after they were first published by Microsoft.</descrip></descripGrp><ntig><termGrp><term id="2350860">CB</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="2503914">Tashar Watanni</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40475_2364917_2503914"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office servicing option in which new feature upgrades are available for installation right after they were first published by Microsoft.</descrip></descripGrp><ntig><termGrp><term id="2364917">Current Channel</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="2503914">Tashar Watanni</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40476_2350861_2544795"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Windows servicing option in which new feature upgrades are available for installation around 4 months after they were first published by Microsoft and the minimum length of servicing lifetime is approximately 8 months.</descrip></descripGrp><ntig><termGrp><term id="2350861">Current Branch for Business</term><termNote type="partOfSpeech">P