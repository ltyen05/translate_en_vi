en-US"><descripGrp><descrip type="definition">A collection of keys or key and value pairs that is used for content or query processing in search.</descrip></descripGrp><ntig><termGrp><term id="1653507">dictionary</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1862805">kamus</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32334_1653508_1862806"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of detecting the file type of an item during content processing, and converting the item to text.</descrip></descripGrp><ntig><termGrp><term id="1653508">document parsing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1862806">rairaye kundi</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32335_1653509_1862807"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of extracting information from unstructured text in an item and storing that information as additional managed properties for the item.</descrip></descripGrp><ntig><termGrp><term id="1653509">entity extraction</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1862807">tsamo abu</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32335_1653510_1862807"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of extracting information from unstructured text in an item and storing that information as additional managed properties for the item.</descrip></descripGrp><ntig><termGrp><term id="1653510">property extraction</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1862807">tsamo abu</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32336_1653514_1862808"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A content processing or query processing pipeline that contains operators that determine how the content or the query is processed.</descrip></descripGrp><ntig><termGrp><term id="1653514">flow</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1862808">gudana</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32337_1653516_1862809"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A copy of a search index within an index partition.</descrip></descripGrp><ntig><termGrp><term id="1653516">index replica</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1862809">makamancin indes</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32338_1653517_1862810"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An object that processes and enhances items in a content processing flow and processes and enhances queries in a query processing flow.</descrip></descripGrp><ntig><termGrp><term id="1653517">operator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1862810">mai sarrafawa</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32339_1653518_1862811"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An XML document that describes how to rank items in search results.</descrip></descripGrp><ntig><termGrp><term id="1653518">ranking model</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1862811">nau'in jerin matsayi</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32340_1653519_1862812"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process that ensures that index replicas on the same index partition remain synchronized during regular operation and during recovery.</descrip></descripGrp><ntig><termGrp><term id="1653519">seeding</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1862812">shukawa</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32341_1653521_1862813"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of managed properties that are updated together in the search index.</descrip></descripGrp><ntig><termGrp><term id="1653521">update group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1862813">sabunta rukuni</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32342_1653526_1862814"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A managed property that can be queried against. The query must contain the managed property field name, either in the query itself or programmatically.</descrip></descripGrp><ntig><termGrp><term id="1653526">queryable managed property</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1862814">kadarar gudanarwa da za'a iya yi tambaya akan</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32343_1653528_1862815"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A managed property that can be used as the basis for a refiner for search results.</descrip></descripGrp><ntig><termGrp><term id="1653528">refinable managed property</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1862815">kadarar gudanarwa da za a iya ingantawa</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32344_1653529_1862816"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A managed property that can be displayed in search results.</descrip></descripGrp><ntig><termGrp><term id="1653529">retrievable managed property</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1862816">kadarar gudanarwa da za a iya ganowa</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32345_1653531_1862817"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A managed property whose value can be returned by a query.</descrip></descripGrp><ntig><termGrp><term id="1653531">searchable managed property</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1862817">kadarar gudanarwa da ake iya bincika</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32346_1653533_1862818"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A managed property whose result set can be sorted based on the property before the result set is returned.</descrip></descripGrp><ntig><termGrp><term id="1653533">sortable managed property</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1862818">kadarar gudanarwa da ake iya warewa</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32350_1656127_1862819"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user defined dictionary that lists single words or phrases that the system matches to words in the content in either a case-sensitive way or a case-insensitive way, depending on the type of dictionary that is used.</descrip></descripGrp><ntig><termGrp><term id="1656127">custom extraction dictionary</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1862819">dauwamar da kamus mai tsamo kalmomi</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32351_1656134_1862820"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A custom extraction dictionary that lists words or phrases that are matched to exact words in the content in a case-sensitive way. For example, the system matches "anchor" to "anchor," but not to "Anchor" or "Anchorage."</descrip></descripGrp><ntig><termGrp><term id="1656134">exact word extraction dictionary</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1862820">kamus mai tsamo kalmar da ake nema</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32352_1656137_1862821"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A custom extraction dictionary that lists words or phrases that are matched anywhere in the content in a case-sensitive way. For example, the system matches "anchor" and "anchorage," but not "Anchor."</descrip></descripGrp><ntig><termGrp><term id="1656137">exact word part extraction dictionary</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1862821">kamus mai tsamo sashen kalmar da ake nema</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32353_1656140_1862822"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A custom extraction dictionary that lists words or phrases that are matched to exact words in the content in a case-insensitive way. For example, the entry "anchor" will match "anchor" and "Anchor," but not "anchorage."</descrip></descripGrp><ntig><termGrp><term id="1656140">word extraction dictionary</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1862822">kamus mai tsamo kalma</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32354_1656141_1862823"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A custom extraction dictionary that lists words or phrases that are matched anywhere in the content in a case-insensitive way. For example, the entry "anchor" will match "anchor," "Anchor," and "anchorage."</descrip></descripGrp><ntig><termGrp><term id="1656141">word part extraction dictionary</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1862823">kamus mai tsamo sashen kalma</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32355_1656142_1862824"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A data structure that describes crawled properties, managed properties, and the mapping between them.</descrip></descripGrp><ntig><termGrp><term id="1656142">search schema</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1862824">tsarin bincike</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32356_1656144_1862825"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A logical portion of the search index.</descrip></descripGrp><ntig><termGrp><term id="1656144">index partition</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1862825">rarraba indes</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32359_1657886_1666539"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of apps that includes Messenger, Photo Gallery, Movie Maker, OneDrive, Mail, Writer, and Family Safety. (Family Safety is only included in Windows 7 downloads; it's built in to Windows 8.)</descrip></descripGrp><ntig><termGrp><term id="1657886">Windows Essentials 2012</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1666539">Muhimmin Abubuwan Windows 2012</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3236_80090_2086294"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The use of computers and data communication equipment to convey messages from one person to another, as by email, voice mail, or fax.</descrip></descripGrp><ntig><termGrp><term id="80090">messaging</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="2086294">aika saƙo</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32361_1658247_1862827"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tool in Office 365 that enables IT professionals to manage how Office is installed for their users. Users receive the correct language and configurations individually tailored to them automatically, without the need to install anything themselves.</descrip></descripGrp><ntig><termGrp><term id="1658247">Office Deployment Tool</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1862827">Kayan aikin assasa Office</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32362_1658249_1862828"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mode in which SharePoint Server is the primary source for all the project details. Project Server scheduling, time and status, and advanced functionality are disabled.</descrip></descripGrp><ntig><termGrp><term id="1658249">visibility mode</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1862828">Tsarin gani</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32367_1666384_1688731"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Windows feature that enables users to connect computers with a simple tap gesture or by browsing for computers within wireless range. If two computers come within 3-4 centimeters of each other, or are tapped together, the operating system of each computer becomes aware of the other computer. Also, a user can browse for computers within wireless range that are advertising for a peer connection. The user can then connect the two computers to share content such as photos or links, or create a multi-player experience. If the connection is made using a tap gesture, the user can also publish and subscribe to messages transmitted during the tap.</descrip></descripGrp><ntig><termGrp><term id="1666384">proximity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1688731">mahadi don raba kaya</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3239_1513455_1646862"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A certification authority that has the ability to issue the intermediate certificates needed to certify the subject identified by the end certificate.</descrip></descripGrp><ntig><termGrp><term id="1513455">intermediate CA</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1646862">matsakaici CA</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3239_1513455_1646865"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A certification authority that has the ability to issue the intermediate certificates needed to certify the subject identified by the end certificate.</descrip></descripGrp><ntig><termGrp><term id="1513455">intermediate CA</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1646865">hukumar badasatifiket na matsakaici</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3239_68764_1646862"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A certification authority that has the ability to issue the intermediate certificates needed to certify the subject identified by the end certificate.</descrip></descripGrp><ntig><termGrp><term id="68764">intermediate certification authority</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1646862">matsakaici CA</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3239_68764_1646865"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A certification authority that has the ability to issue the intermediate certificates needed to certify the subject identified by the end certificate.</descrip></descripGrp><ntig><termGrp><term id="68764">intermediate certification authority</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1646865">hukumar badasatifiket na matsakaici</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32395_1667479_1678239"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature of Windows where a user's credentials are securely stored.</descrip></descripGrp><ntig><termGrp><term id="1667479">Credential Locker</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1678239">Ma'ajiyar Bayanan Maiamfani</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32397_1667525_1680840"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To take action on a message by either replying to the sender, to the sender and all recipients, or by forwarding the message to someone else.</descrip></descripGrp><ntig><termGrp><term id="1667525">respond</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNo