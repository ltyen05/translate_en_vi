id="10189_722343_1806623"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A line that separates groups of controls (on a surface) or commands (on a menu).</descrip></descripGrp><ntig><termGrp><term id="722343">separator bar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1806623">mai rabawa</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1019_36322_1334978"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The degree to which a computer, an attached device, a data file, or a program can work with or understand the same commands, formats, or language as another. True compatibility means that any operational differences are invisible to people and programs alike.</descrip></descripGrp><ntig><termGrp><term id="36322">compatibility</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1334978">Zaunawa daidai</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10190_122191_1157585"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A command button used in a toolbar (or status bar).</descrip></descripGrp><ntig><termGrp><term id="122191">toolbar button</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="11