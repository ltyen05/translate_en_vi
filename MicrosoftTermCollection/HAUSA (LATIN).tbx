pe="definition">The functionality that allows users to switch back to recently used apps.</descrip></descripGrp><ntig><termGrp><term id="1755689">app switching</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1759131">sauyawan ka'ida</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33088_1755690_1759134"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The state that enables a PC to turn on instantly and have tiles and other services update even when the screen is off.</descrip></descripGrp><ntig><termGrp><term id="1755690">connected standby</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1759134">tsarin dakatawa mai haɗi</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33089_1755691_1759135"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of Windows and device settings that users can change grouped into one location.</descrip></descripGrp><ntig><termGrp><term id="1755691">PC settings</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1759135">saittunan kwamfuta</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="gram