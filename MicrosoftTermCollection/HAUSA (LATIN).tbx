 xml:lang="en-US"><descripGrp><descrip type="definition">One of the presets for 3D rotation effects. When selected, specifies that the object will be rotated isometrically.</descrip></descripGrp><ntig><termGrp><term id="186191">isometric</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="588095">Madafin juyawa</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13946_109605_1335387"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To mark text, cells, and similar items that will be subject to a user action, such as copying text.</descrip></descripGrp><ntig><termGrp><term id="109605">select</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1335387">Zaba</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13947_545693_2578495"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that provides a home for the Office Scrapbook, Compatibility Report, Project Palette and Reference Pane and is shown as a floating palette.</descrip></descripGrp><ntig><termGrp><term id="545693">Toolbox</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="2578495">Akwatin kayan aiki</term><termNote type="geograph