a-Latn-NG"><ntig><termGrp><term id="2765117">gwaji</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15242_1490934_2765117"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A version of a product that can be used for a limited period of time for purposes of evaluation.</descrip></descripGrp><ntig><termGrp><term id="1490934">trial edition</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="2765117">gwaji</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15242_1992951_2765117"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A version of a product that can be used for a limited period of time for purposes of evaluation.</descrip></descripGrp><ntig><termGrp><term id="1992951">trial</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="2765117">gwaji</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15253_140165_1334128"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A data structure that is a collection of fields (elements), each with its own name and type. Unlike an array, whose elements all represent the same type of information and are accessed using an index, the elements of a record represent different types of information and are accessed by name. A record can be accessed as a collective unit of elements, or the elements can be accessed individually.</descrip></descripGrp><ntig><termGrp><term id="140165">data record</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1334128">Rekod na tarin bayanai</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15254_1986304_1992452"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables users to provide input through the screen by using a finger or a pen.</descrip></descripGrp><ntig><termGrp><term id="1986304">touch</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1992452">taɓa</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15254_276552_1992452"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables users to provide input through the screen by using a finger or a pen.</descrip></descripGrp><ntig><termGrp><term id="276552">touch input</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1992452">taɓa</term><termNote type="geographicalUsage">NG