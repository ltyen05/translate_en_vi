eech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1862127">yankin da aka nufa</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5015_358327_1335132"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of taking a single-table database and breaking it into a set of smaller, related tables, with each table focused on a single topic or grouping of information.</descrip></descripGrp><ntig><termGrp><term id="358327">normalization</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1335132">Hanyar faskare gundarin bayanai</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50278_2843800_2845057"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of solutions that enhance, enable, and simplify non-persistent Windows computing environments.</descrip></descripGrp><ntig><termGrp><term id="2843800">FSLogix</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="2845057">FSLogix</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5041_157347_2490214"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To terminate the current action before it is complete.</descrip></descripGrp><ntig><termGrp><term id="157347">abandon</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="2490214">kauracewa</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5060_129154_1335133"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In relational database management systems, a logical table created through the specification of one or more relational operations on one or more tables. A view is equivalent to a divided relation in the relational model.</descrip></descripGrp><ntig><termGrp><term id="129154">view</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1335133">Duba</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5061_180517_2690416"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The adherence to stated standards.</descrip></descripGrp><ntig><termGrp><term id="180517">compliance</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="2690416">biyayya</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5069_160054_588021"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A technique for converting a color in one color space to another color space. Typically, this conversion is from YUV colors from a video source to RGB for display.</descrip></descripGrp><ntig><termGrp><term id="160054">color-space conversion</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="588021">Mai sauya launi</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5069_160054_588111"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A technique for converting a color in one color space to another color space. Typically, this conversion is from YUV colors from a video source to RGB for display.</descrip></descripGrp><ntig><termGrp><term id="160054">color-space conversion</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="588111">Maijikita launi</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5069_210048_588021"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A technique for converting a color in one color space to another color space. Typically, this conversion is from YUV colors from a video source to RGB for display.</descrip></descripGrp><ntig><termGrp><term id="210048">color space conversion</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="588021">Mai sauya launi</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5069_210048_588111"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A technique for converting a color in one color space to another color space. Typically, this conversion is from YUV colors from a video source to RGB for display.</descrip></descripGrp><ntig><termGrp><term id="210048">color space conversion</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="588111">Maijikita launi</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5070_346942_1335134"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To provide or give.</descrip></descripGrp><ntig><termGrp><term id="346942">deliver</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1335134">Bayarwa</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5071_119170_1335135"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A character used to align lines and columns on screen and in print. Although a tab is visually indistinguishable from a series of blank spaces in most programs, the tab character and the space character are different to a computer. A tab is a single character and therefore can be added, deleted, or overtyped with a single keystroke.</descrip></descripGrp><ntig><termGrp><term id="119170">tab character</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1335135">Harafin tab</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5072_138277_1157378"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In a shared file, information that is maintained about changes made in past editing sessions. The information includes the name of the person who made each change, when the change was made, and what data was changed.</descrip></descripGrp><ntig><termGrp><term id="138277">change history</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1157378">sauya tarihin bayanai</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5074_307449_2295167"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A normalized value assigned to an email message that indicates, based on the characteristics of the message, the likelihood that the message is spam and that is persisted with the message when the message is sent to other Exchange servers.</descrip></descripGrp><ntig><termGrp><term id="307449">spam confidence level</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="2295167">SCL</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5074_307449_2295185"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A normalized value assigned to an email message that indicates, based on the characteristics of the message, the likelihood that the message is spam and that is persisted with the message when the message is sent to other Exchange servers.</descrip></descripGrp><ntig><termGrp><term id="307449">spam confidence level</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="2295185">matsayin tabbacin spam</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5074_307468_2295167"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A normalized value assigned to an email message that indicates, based on the characteristics of the message, the likelihood that the message is spam and that is persisted with the message when the message is sent to other Exchange servers.</descrip></descripGrp><ntig><termGrp><term id="307468">SCL</term><