 type="definition">A mechanism for a MAPI client to initiate a quick shutdown of the client process, notifying all providers with which the client has an active MAPI session to save data and settings before the client process exits.</descrip></descripGrp><ntig><termGrp><term id="1362482">fast shutdown</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1862603">kashewa mai sauri</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27030_1362593_2778193"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An agreement that is part of the Microsoft volume licensing program.</descrip></descripGrp><ntig><termGrp><term id="1362593">Microsoft Volume Licensing agreement</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="2778193">Yarjejjeniyar Lasisin Ƙarfin murya na Microsoft</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27033_1362691_2778192"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A family of Microsoft licensing agreement offering programs for large numbers of users that provide potentially substantial savings, ease of deployment, flexible acquisition, numerous payment options, and other benefits such as Software Assurance.</descrip></descripGrp><ntig><termGrp><term id="1362691">Microsoft Volume Licensing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="2778192">Lasisin Ƙarfin murya na Microsoft</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27043_1364751_1862604"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file that contains the unique information for each data-merged document.</descrip></descripGrp><ntig><termGrp><term id="1364751">recipient list</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1862604">jerin sunan masu karba sako</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2709_121473_1157275"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Of, pertaining to, or being an object or image having or appearing to have all three spatial dimensions (length, width, and depth).</descrip></descripGrp><ntig><termGrp><term id="121473">three-dimensional</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1157275">3-D</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2709_121473_1157901"><langSet xml:lang="en-US"><des