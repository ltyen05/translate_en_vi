677_258947_588330"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Multimedia content in software, on CD-ROM, or on a Web site that purports to educate the user as well as entertain.</descrip></descripGrp><ntig><termGrp><term id="258947">edutainment</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="588330">Ilimintarwa ta hanyar nishadi</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14684_8743_1157309"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The window in which a user is currently working or directing input. An active window is typically at the top of the Z order and is distinguished by the color of its title bar.</descrip></descripGrp><ntig><termGrp><term id="8743">active window</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1157309">budaddiyar taga</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1469_307402_588543"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The tool which enables users to automatically perform routine tasks on a chosen computer by monitoring whatever criteria the users choose to initiate the tasks (referred to as triggers) and then executing the tasks when the criteria is met.</descrip></descripGrp><ntig><termGrp><term id="307402">Task Scheduler</term><termNote type="partOfSpeech">Pro