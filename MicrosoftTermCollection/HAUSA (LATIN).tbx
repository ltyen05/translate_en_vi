g="en-US"><descripGrp><descrip type="definition">An audio effect setting that allows users with stereo headphones to experience stereo and multi-channel content without the need to set up an extensive multi-channel speaker system.</descrip></descripGrp><ntig><termGrp><term id="262434">Headphone Virtualization mode</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="588343">Mazirorin kunne</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9889_262435_588343"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An audio effect setting that allows users with stereo headphones to experience stereo and multi-channel content without the need to set up an extensive multi-channel speaker system.</descrip></descripGrp><ntig><termGrp><term id="262435">Virtualization Mode</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="588343">Mazirorin kunne</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="989_210451_1333934"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A command that will use a print driver installed by OneNote to create an image of a wide variety of filetypes. Files are printed to the print driver and inserted as images into OneNote.</descrip></descripGrp><ntig><termGrp><term id="210451">File as Printout</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1333934">Fayil a matsayin firin awut</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9891_269336_588439"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An event triggered by Windows system components that is recorded in the system log, such as the failure of a driver or other system component to load during startup.</descrip></descripGrp><ntig><termGrp><term id="269336">system event</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="588439">Matsalar kwamfuta</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="990_26447_1806578"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A system of programs and workstations used in designing engineering, architectural, and scientific models ranging from simple tools to buildings, aircraft, integrated circuits, and molecules.</descrip></descripGrp><ntig><termGrp><term id="26447">CAD</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1806578">CAD</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termN