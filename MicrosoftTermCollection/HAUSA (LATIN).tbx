ammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1762325">talle mai ɗauka  barazana kaya</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33093_1755827_1782512"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A rating of how safe an app is determined to be by SmartScreen, according to age, presence of digital certificate, and other criteria.</descrip></descripGrp><ntig><termGrp><term id="1755827">SmartScreen Application Reputation</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1782512">Kimantan Ka'idar SmartScreen</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33105_1758865_1762329"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Japanese kana characters that indicate the correct pronunciation, sorting, and grouping behavior of a word written in kanji.</descrip></descripGrp><ntig><termGrp><term id="1758865">Yomi</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ha-Latn-NG"><ntig><termGrp><term id="1762329">yomi</term><termNote type="geographicalUsage">NGA</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry