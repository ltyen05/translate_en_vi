"><ntig><termGrp><term id="1880371">फिल्टर गरिएको HTML</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6867_121727_487657"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A certification specifying that a particular message existed at a specific time and date. In a digital context, trusted third parties generate a trusted time stamp for a particular message by having a time stamping service append a time value to a message and then digitally signing the result.</descrip></descripGrp><ntig><termGrp><term id="121727">time stamp</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="487657">समय छाप</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6879_78424_487408"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Moving text that is used on a data access page to draw the user's attention to a specific page element, such as a headline or an important announcement.</descrip></descripGrp><ntig><termGrp><term id="78424">marquee</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="487408">मार्की</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6883_210434_488006"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A device used to copy files to recordable CDs and DVDs.</descrip></descripGrp><ntig><termGrp><term id="210434">disc burner</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="488006">चक्कामा बाल्ने</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6886_2911_486839"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A communications device that converts between digital data from a computer or terminal and analog audio signals that can pass through a standard telephone line.</descrip></descripGrp><ntig><termGrp><term id="2911">modem</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="486839">मोडेम</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6886_2911_486840"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A communications device that converts between digital data from a computer or terminal and analog audio signals that can pass through a standard telephone line.</descrip></descripGrp><ntig><termGrp><term id="2911">modem</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="486840">मोडुलेटर/डिमोडुलेटर</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6886_2912_486839"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A communications device that converts between digital data from a computer or terminal and analog audio signals that can pass through a standard telephone line.</descrip></descripGrp><ntig><termGrp><term id="2912">modulator/demodulator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="486839">मोडेम</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6886_2912_486840"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A communications device that converts between digital data from a computer or terminal and analog audio signals that can pass through a standard telephone line.</descrip></descripGrp><ntig><termGrp><term id="2912">modulator/demodulator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="486840">मोडुलेटर/डिमोडुलेटर</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="689_108242_487572"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">On the IBM PC/XT and AT and compatible keyboards, a key on the top row of the numeric keypad that controls the effect of the cursor control keys and sometimes prevents the screen from scrolling. On the enhanced and Macintosh keyboards, this key is to the right of the function keys on the top row. Many modern applications ignore the Scroll Lock setting.</descrip></descripGrp><ntig><termGrp><term id="108242">SCROLL LOCK key</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="487572">SCROLL LOCK कुञ्जी</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6894_318712_488579"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A statement that the text or program code contained within the item on which the notice appears is the intellectual property of Microsoft (or other entity).</descrip></descripGrp><ntig><termGrp><term id="318712">copyright notice</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="488579">प्रतिलिपिअधिकार-सूचना</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6904_108595_1519655"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To try to locate something (a file, a folder, a computer, a text).</descrip></descripGrp><ntig><termGrp><term id="108595">search</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1519655"