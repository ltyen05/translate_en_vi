ermNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42480_2407917_2793943"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A repository where private keys, certificates and symmetric keys can be stored.</descrip></descripGrp><ntig><termGrp><term id="2407917">keystore</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2793943">मुख्य पसल</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42480_2793217_2793943"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A repository where private keys, certificates and symmetric keys can be stored.</descrip></descripGrp><ntig><termGrp><term id="2793217">key store</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2793943">मुख्य पसल</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42482_2407975_2412725"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To add a digital signature to additions and updates made to source code and applications published on the Internet. Code signing is intended to provide a level of security and trust to Internet software distribution.</descrip></descripGrp>