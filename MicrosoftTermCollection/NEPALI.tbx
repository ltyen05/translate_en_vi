41_1374727"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The set of Microsoft software for email, instant messaging, photos, and personal movies available to customers in a single download and installation.</descrip></descripGrp><ntig><termGrp><term id="1136241">Windows Live Essentials</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1374727">Windows Live आवश्‍यकताहरू</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24603_1136241_1676232"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The set of Microsoft software for email, instant messaging, photos, and personal movies available to customers in a single download and installation.</descrip></descripGrp><ntig><termGrp><term id="1136241">Windows Live Essentials</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1676232">Windows आवश्यकताहरू</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24603_1636168_1374727"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The set of Microsoft software for email, instant messaging, photos, and personal movies available to customers in a single download and installation.</descrip></descripGrp><ntig><termGrp><term id="1636168">Windows Essentials</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="gr