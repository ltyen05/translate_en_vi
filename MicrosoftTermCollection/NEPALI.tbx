<term id="487970">मूल्य सूची</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="606_134615_487729"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To transfer information either to a storage device, such as a disk, or to an output device, such as the monitor or a printer. Writing is the means by which a computer provides the results of processing. A computer can also be said to write to the screen when it displays information on the monitor.</descrip></descripGrp><ntig><termGrp><term id="134615">write</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="487729">लेख्नुहोस्</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6063_137589_487754"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A database on a server that matches user names to passwords.</descrip></descripGrp><ntig><termGrp><term id="137589">authentication database</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="487754">प्रमाणीकरण डेटाबेस</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6064_140594_1225303"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A cell that contains a formula that refers to another cell. For example, if cell D10 contains the formula =B5, cell D10 is a dependent of cell B5.</descrip></descripGrp><ntig><termGrp><term id="140594">dependent</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1225303">आश्रित</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6077_314127_488502"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Information about a client computer that Network Access Protection (NAP) uses to allow or deny access to a network and which is encapsulated in a statement of health (SoH), which is issued by a system health agent (SHA) on the client computer.</descrip></descripGrp><ntig><termGrp><term id="314127">health</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="488502">स्वास्थ्य</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="608_1355238_1641372"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tool or software program designed to detect and respond to malicious software, such as viruses and worms. Responses may include blocking user access to infected files, cleaning infected files or systems, or informing the user that an infected program was detected.</descrip></descripGrp><ntig><termGrp><term id="1355238">anti-malware software</term><termNote type="partOfSp