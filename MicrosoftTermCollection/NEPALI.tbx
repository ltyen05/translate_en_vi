ip type="definition">Repeated execution of one or more statements or instructions. Statements or instructions so executed are said to be in a loop.</descrip></descripGrp><ntig><termGrp><term id="71139">iteration</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="487338">दोहर्‍याउनु</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12180_237293_1951323"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables the user to access Outlook data over the Internet without a VPN connection.</descrip></descripGrp><ntig><termGrp><term id="237293">Outlook Anywhere</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1951323">Outlook जहाँपनि</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12192_33928_487065"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Software that is used to compress or decompress a digital media file.</descrip></descripGrp><ntig><termGrp><term id="33928">codec</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="487065">कोडेक</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote typ