termGrp></ntig></langSet></termEntry><termEntry id="14232_231970_488076"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A chart that provides interactive analysis of data, like a PivotTable report. You can change views of data, see different levels of detail, or reorganize the chart layout by dragging fields and by showing or hiding items in fields.</descrip></descripGrp><ntig><termGrp><term id="231970">PivotChart report</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="488076">पिभोट चित्रपट प्रतिवेदन</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14237_169312_2858168"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A database that functions as a backup of a primary database, receiving copies of every change to the primary database, and that can take over traffic if the primary database becomes unavailable.</descrip></descripGrp><ntig><termGrp><term id="169312">mirror database</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2858168">मिरर डाटाबेस</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14238_2822_486837"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A memory measurement unit that is equal to 1 million bytes.</descrip></descripGrp><ntig><termGrp><term id="2822">MB</term><termNote type="partOfSpeech">Noun</termNo