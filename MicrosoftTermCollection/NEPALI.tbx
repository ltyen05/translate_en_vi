tig></langSet></termEntry><termEntry id="16494_592341_1549248"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A rule associated with an object to regulate which users can gain access to the object and in what manner and that are assigned or denied by the object's owner.</descrip></descripGrp><ntig><termGrp><term id="592341">permission</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1549248">अनुमति</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16496_592343_1988822"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An apartment that consists of exactly one thread.</descrip></descripGrp><ntig><termGrp><term id="592343">single-threaded apartment</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1988822">एकल-थ्रेडेड अपार्टमेन्ट</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16496_592343_1988823"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An apartment that consists of exactly one thread.</descrip></descripGrp><ntig><termGrp><term id="592343">single-threaded apartment</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1988823">STA</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16496_592344_1988822"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An apartment that consists of exactly one thread.</descrip></descripGrp><ntig><termGrp><term id="592344">STA</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1988822">एकल-थ्रेडेड अपार्टमेन्ट</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16496_592344_1988823"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An apartment that consists of exactly one thread.</descrip></descripGrp><ntig><termGrp><term id="592344">STA</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1988823">STA</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="165_127792_2529484"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In computer graphics, a line drawn in a certain direction from a starting point to an endpoint, both of whose locations are identified by the computer using x-y-coordinates on a grid. Vectors are used in the output of some graphics programs instead of groups of dots (on paper) or pixels (on screen).</descrip></descripGrp><ntig><termGrp><term id="127792">vector</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2529484">भेक्टर</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16504_592353_1880449"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A chart that shows a three dimensional surface that connects a set of data points. As in a topographic map, colors and patterns indicate areas that are in the same range of values.</descrip></descripGrp><ntig><termGrp><term id="592353">surface chart</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1880449">सतह चित्रपट</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16505_592354_2765501"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to a resource in a failover cluster or server cluster that is in the process of being brought online or offline.</descrip></descripGrp><ntig><termGrp><term id="592354">pending</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2765501">बाँकी</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16506_592355_1880450"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A surface chart subtype that provides a view of the surface chart from above, with colors representing specific ranges of values.</descrip></descripGrp><ntig><termGrp><term id="592355">contour chart</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1880450">आकार चित्रपट</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16507_592356_1880451"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A contour chart displayed without color.</descrip></descripGrp><ntig><termGrp><term id="592356">wireframe contour chart</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1880451">वायरफ्रेम रूपरेखा चित्रपट</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16508_2909978_1880452"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A chart that displays data in rings, where each ring represents a data series.</descrip></descripGrp><ntig><termGrp><term id="2909978">donut</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1880452">डोनट चित्रपट</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16508_592357_1880452"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A chart that displays data in rings, where each ring represents a data series.</descrip></descripGrp><ntig><termGrp><term id="592357">doughnut chart</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1880452">डोनट चित्रपट</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16511_592360_1880453"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A doughnut chart that displays the contribution of each value to a total while emphasizing individual values, by showing each slice of the doughnut as "pulled out," or separate, from the whole.</descrip></descripGrp><ntig><termGrp><term id="592360">exploded doughnut chart</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1880453">छरिएको डोनट चित्रपट</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16513_592362_1880454"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A best-fit curved trendline that is used when the rate of change in the data increases or decreases quickly and then levels out.</descrip></descripGrp><ntig><termGrp><term id="592362">logarithmic trendline</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1880454">लोगारिदमिक ट्रेन्डलाइन</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16514_592363_1880455"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A curved trendline that is used when data fluctuates.</descrip></descripGrp><ntig><termGrp><term id="592363">polynomial trendline</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1880455">पोलिनोमियल ट्रेन्डलाइन</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16516_592365_1880456"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A curved trendline that is used with data sets that compare measurements that increase at a specific rate.</descrip></descripGrp><ntig><termGrp><term id="592365">power trendline</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1880456">शक्ति ट्रेन्डलाइन</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16518_592368_1880457"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A curved trendline that is used when data values rise or fall at constantly increasing rates.</descrip></descripGrp><ntig><termGrp><term id="592368">exponential trendline</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1880457">एक्पोनेन्सियल ट्रेन्डलाइन</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16519_592369_1880458"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A trendline that smoothes out fluctuations in data to show a pattern or trend more clearly.</descrip></descripGrp><ntig><termGrp><term id="592369">moving average trendline</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1880458">सर्ने औसत ट्रेन्डलाइन</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16525_592375_2699468"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user whose account resides in an account partner organization and who can access federated applications that reside in a resource partner organization. In the context of Office 365, a federated user is one that is sourced (mastered, authenticated, created, and managed) in an organization’s on-premises Active Directory. The on-premises Active Directory has a trust relationship with the cloud that allows authenticated Active Directory users to access cloud resources (or “services,” such a SharePoint Online, Exchange Online, etc).</descrip></descripGrp><ntig><termGrp><term id="592375">federated user</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2699468">संघबद्ध प्रयोगकर्ता</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1654_234919_488156"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A wizard that allows third-party developers to achieve the same look in their dialog boxes as Aero.</descrip></descripGrp><ntig><termGrp><term id="234919">Aero Wizard</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="488156">एइरो विजार्ड</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16543_592397_2699453"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">For BitLocker Drive Encryption, a combination of one or more of the following elements, identified by a globally unique identifier (GUID): personal identification number (PIN), recovery password, recovery key, startup key, and Trusted Platform Module (TPM).</descrip></descripGrp><ntig><termGrp><term id="592397">authentication method</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2699453">प्रमाणीकरण विधि</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16577_592433_1454174"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To ensure that all data sources that are used by a KPI or scorecard are available.</descrip></descripGrp><ntig><termGrp><term id="592433">validate</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1454174">वैध गर्नुहोस्</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16584_592444_2592150"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A directory name, used in an address, that corresponds to a physical directory on the server.</descrip></descripGrp><ntig><termGrp><term id="592444">virtual directory</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2592150">अवास्तविक डाइरेक्टरी</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16594_592578_2217580"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A service or feature that renders the audio content of a television or video program as text on the screen. These captions are usually visible only if decoded or activated.</descrip></descripGrp><ntig><termGrp><term id="592578">closed captioning</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2217580">शीर्षक बनाउन बन्द</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16607_592811_1225426"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A numeric or other designation appended to a product name to identify a particular release.​</descrip></descripGrp><ntig><termGrp><term id="592811">version</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1225426">संस्करण</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16609_592813_1225428"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An effect applied to a graphical object that typically reduces the difference between the outline of the object and the graphical area next to it.</descrip></descripGrp><ntig><termGrp><term id="592813">blur</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1225428">ब्लर</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16647_594141_1988802"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Software that provides encryption for sensitive data, such as passwords, in applications.</descrip></descripGrp><ntig><termGrp><term id="594141">encryption provider</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1988802">गुप्तलेखन प्रदायक</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16658_600620_1880459"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The round button in the lower left-hand corner of the Windows screen that allows the user to click and display the Start menu.</descrip></descripGrp><ntig><termGrp><term id="600620">Start button</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1880459">सुरुवात बटन</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16665_601385_2625753"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An attack by a malicious user or malicious software on a computer or operating system to find a secret password or a symmetric encryption key by guessing passwords or keys until the correct password or key is discovered.</descrip></descripGrp><ntig><termGrp><term id="601385">key search attack</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2625753">ब्रुट फोर्स एट्याक</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16665_601385_2625757"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An attack by a malicious user or malicious software on a computer or operating system to find a secret password or a symmetric encryption key by guessing passwords or keys until the correct password or key is discovered.</descrip></descripGrp><ntig><termGrp><term id="601385">key search attack</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2625757">कि सर्च एट्याक</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16665_601386_2625753"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An attack by a malicious user or malicious software on a computer or operating system to find a secret password or a symmetric encryption key by guessing passwords or keys until the correct password or key is discovered.</descrip></descripGrp><ntig><termGrp><term id="601386">brute force attack</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2625753">ब्रुट फोर्स एट्याक</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16665_601386_2625757"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An attack by a malicious user or malicious software on a computer or operating system to find a secret password or a symmetric encryption key by guessing passwords or keys until the correct password or key is discovered.</descrip></descripGrp><ntig><termGrp><term id="601386">brute force attack</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2625757">कि सर्च एट्याक</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1668_147156_487839"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A grouping of properties presented as a tabbed page of a property sheet.</descrip></descripGrp><ntig><termGrp><term id="147156">property page</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="487839">गुण पृष्ठ</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16697_601660_1696478"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Microsoft site that provides a comprehensive listing of updates that can be distributed over a corporate network.</descrip></descripGrp><ntig><termGrp><term id="601660">Microsoft Update Catalog</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1696478">Microsoft Update तालिका</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16701_607526_1549258"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The amount of something that is consumed over a period of time.</descrip></descripGrp><ntig><termGrp><term id="607526">usage</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1549258">प्रयोग</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16775_1049762_1748127"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature of Remote Desktop Services that enables the user to access a program remotely through Remote Desktop Services but have it appear as if it is running on the user's local computer. Users can run RemoteApp programs side by side with their local programs.</descrip></descripGrp><ntig><termGrp><term id="1049762">RemoteApp</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1748127">RemoteApp</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16775_616468_1748127"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature of Remote Desktop Services that enables the user to access a program remotely through Remote Desktop Services but have it appear as if it is running on the user's local computer. Users can run RemoteApp programs side by side with their local programs.</descrip></descripGrp><ntig><termGrp><term id="616468">Terminal Services RemoteApp</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1748127">RemoteApp</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16775_616469_1748127"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature of Remote Desktop Services that enables the user to access a program remotely through Remote Desktop Services but have it appear as if it is running on the user's local computer. Users can run RemoteApp programs side by side with their local programs.</descrip></descripGrp><ntig><termGrp><term id="616469">TS RemoteApp</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1748127">RemoteApp</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1679_1370400_1225812"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The W3C standard language used for writing XML schema documents.</descrip></descripGrp><ntig><termGrp><term id="1370400">XSD</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1225812">एक्सएमएल स्किमा</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1679_1536620_1225812"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The W3C standard language used for writing XML schema documents.</descrip></descripGrp><ntig><termGrp><term id="1536620">XML schema definition language</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1225812">एक्सएमएल स्किमा</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1679_1536621_1225812"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The W3C standard language used for writing XML schema documents.</descrip></descripGrp><ntig><termGrp><term id="1536621">XSDL</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1225812">एक्सएमएल स्किमा</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1679_257436_1225812"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The W3C standard language used for writing XML schema documents.</descrip></descripGrp><ntig><termGrp><term id="257436">XML schema</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1225812">एक्सएमएल स्किमा</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16798_616805_1880460"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft implementation of an integrity level. In particular, a protection level, refers to an integrity label that contains only level information, without the additional information traditionally contained within integrity level.</descrip></descripGrp><ntig><termGrp><term id="616805">protection level</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1880460">सुरक्षा स्तर</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1682_114990_1880201"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An array (arrangement of items) in which many of the entries are identical, commonly zero. It is not possible to define precisely when an array is sparse, but it is clear that at some point, usually when about one-third of the array consists of identical entries, it becomes worthwhile to redefine the array.</descrip></descripGrp><ntig><termGrp><term id="114990">sparse array</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1880201">स्पार्स एरे</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1685_42287_3025719"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of creating a link between a property and a source. The source can be local or external.</descrip></descripGrp><ntig><termGrp><term id="42287">data binding</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="3025719">डेटा बाइन्डिङ</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1685_494335_3025719"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of creating a link between a property and a source. The source can be local or external.</descrip></descripGrp><ntig><termGrp><term id="494335">binding</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="3025719">डेटा बाइन्डिङ</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1686_90627_1225235"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A distinct chunk of text that is indicated by formatting such as indentation, numbering, or a new line.</descrip></descripGrp><ntig><termGrp><term id="90627">paragraph</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNum