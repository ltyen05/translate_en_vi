termEntry><termEntry id="1418_35626_487087"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A window that mimics an old MS-DOS display for typing command-line instructions.</descrip></descripGrp><ntig><termGrp><term id="35626">command prompt window</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="487087">आदेश प्रोम्प्ट सन्झ्याल</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14189_233405_1225393"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The list or table that's used to create a PivotTable or PivotChart report. Source data can be taken from an Excel list or range, an external database or cube, or another PivotTable report.</descrip></descripGrp><ntig><termGrp><term id="233405">source data</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1225393">स्रोत लगत</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14194_45889_1225394"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To add a digital signature to a macro or file.</descrip></descripGrp><ntig><termGrp><term id="45889">digitally sign</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1225394">डिजिटल हस्ताक्षर गर्नुहोस्</term><termNote ty