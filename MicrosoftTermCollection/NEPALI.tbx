un</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="3157207">अझ सुरक्षित Wi-Fi</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56111_3156312_3157184"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in the Edge management service that will give admins the controls to manage settings for enterprise AI features, including Copilot in Edge.</descrip></descripGrp><ntig><termGrp><term id="3156312">enterprise secure AI</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="3157184">इन्टरप्राइज सुरक्षित AI</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56112_3156313_3157180"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Microsoft Edge management service that gives admins the controls to use Copilot in Edge to manage profile switching for Enterprise AI users.</descrip></descripGrp><ntig><termGrp><term id="3156313">automatic profile switching</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="3157180">स्वचालित प्रोफाइल स्विचिङ</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig><