izing.</descrip></descripGrp><ntig><termGrp><term id="1644678">Exchange Fast Access</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2290254">Exchange द्रुत पहुँच</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32268_1644693_1880866"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A web experience on Office.com that enables users to manage their Office licenses and subscriptions.</descrip></descripGrp><ntig><termGrp><term id="1644693">My Account</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1880866">मेरो खाता</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32269_1644697_1880867"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Click-to-Run feature that enables two versions of Office to exist on the same computer to provide a seamless transition for users in supported scenarios.</descrip></descripGrp><ntig><termGrp><term id="1644697">Office Side-by-Side</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1880867">Office सँग-सँगै</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termN