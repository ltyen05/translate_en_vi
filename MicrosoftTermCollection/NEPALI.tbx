termEntry id="2252_163636_487923"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A network-enabled host running Simple Network Management Protocol (SNMP) management software. This software requests information from SNMP agents.</descrip></descripGrp><ntig><termGrp><term id="163636">management console</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="487923">व्यवस्थापन कन्सोल</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2252_163636_487924"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A network-enabled host running Simple Network Management Protocol (SNMP) management software. This software requests information from SNMP agents.</descrip></descripGrp><ntig><termGrp><term id="163636">management console</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="487924">व्यवस्थापन प्रणाली</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2252_163637_487923"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A network-enabled host running Simple Network Management Protocol (SNMP) management software. This software requests information from SNMP agents.</descrip></descripGrp><ntig><termGrp><term id="163637">management system</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="487923">व्यवस्थापन कन्सोल</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2252_163637_487924"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A network-enabled host running Simple Network Management Protocol (SNMP) management software. This software requests information from SNMP agents.</descrip></descripGrp><ntig><termGrp><term id="163637">management system</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="487924">व्यवस्थापन प्रणाली</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22536_1047907_1225634"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that provides one-click filtering controls that make it easy to narrow down the portion of a data set that's being looked at.</descrip></descripGrp><ntig><termGrp><term id="1047907">Slicers</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1225634">स्लाइसरहरू</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22541_1047912_1225635"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A miniature chart that can be inserted into text or embedded within a cell on a worksheet to illustrate highs, lows, and trends in your data.</descrip></descripGrp><ntig><termGrp><term id="1047912">sparkline</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1225635">स्पार्कलाइन</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22543_1047914_1225636"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Outlook Calendar view in which each calendar is listed vertically (not side-by-side). This view is optimized for viewing a schedule for a group and scheduling a meeting for a group.</descrip></descripGrp><ntig><termGrp><term id="1047914">Schedule View</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1225636">तालिका दृश्य</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22545_1047918_1225637"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that converts each slide in a presentation into a single image and rebuilds a new, compressed PPT presentation that can easily be shared, but not edited.</descrip></descripGrp><ntig><termGrp><term id="1047918">Picture Presentation</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1225637">तस्विर प्रस्तुतीकरण</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22561_1048326_1951330"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A viewer that allows users to display Excel workbooks on a phone’s browser. A file is rendered as an HTML page with sufficient fidelity to convey important data or charts and illustrations.</descrip></descripGrp><ntig><termGrp><term id="1048326">Excel Mobile Viewer</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1951330">Excel Mobile Viewer</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22562_1048367_1951331"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A viewer that allows users to display Word documents on a phone’s browser. A file is rendered as an HTML page with sufficient fidelity to convey text and images on a small screen.</descrip></descripGrp><ntig><termGrp><term id="1048367">Word Mobile Viewer</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1951331">Word Mobile Viewer</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2257_183896_1225246"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables the user to compact or collapse rows when viewing several levels of data.</descrip></descripGrp><ntig><termGrp><term id="183896">compact row axis</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1225246">पङ्क्ति अक्ष खाँद्‍नुहोस्</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22595_1050253_1225638"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Windows Media Player (WMP) specific feature that allows you to use the Internet to access music, pictures and videos available on your home network. The feature must be activated on at least two computers in order to work.</descrip></descripGrp><ntig><termGrp><term id="1050253">remote media connection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1225638">दूर मिडिया जडान</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2260_2421477_2426838"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft program that allows users to select and print a variety of customizable calendar templates.</descrip></descripGrp><ntig><termGrp><term id="2421477">Calendar Printing Assistant</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2426838">पात्रो प्रिन्टिङ सहायक</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2260_331777_2426838"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft program that allows users to select and print a variety of customizable calendar templates.</descrip></descripGrp><ntig><termGrp><term id="331777">Calendar Printing Assistant for Microsoft® Office Outlook® 2007</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2426838">पात्रो प्रिन्टिङ सहायक</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22615_1050744_2258599"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A numeric keypad that is part of a device, is displayed on a device, or is in a computer program that you use to enter information in the context of a phone call.</descrip></descripGrp><ntig><termGrp><term id="1050744">dial pad</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2258599">डायल प्याड</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22615_1050744_3188233"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A numeric keypad that is part of a device, is displayed on a device, or is in a computer program that you use to enter information in the context of a phone call.</descrip></descripGrp><ntig><termGrp><term id="1050744">dial pad</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="3188233">डायल प्याड</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22615_3188175_2258599"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A numeric keypad that is part of a device, is displayed on a device, or is in a computer program that you use to enter information in the context of a phone call.</descrip></descripGrp><ntig><termGrp><term id="3188175">dialpad</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2258599">डायल प्याड</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22615_3188175_3188233"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A numeric keypad that is part of a device, is displayed on a device, or is in a computer program that you use to enter information in the context of a phone call.</descrip></descripGrp><ntig><termGrp><term id="3188175">dialpad</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="3188233">डायल प्याड</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22629_1052639_2578677"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of creating a hyperlink to a specific page within a Web site or Web-based application instead of to the site’s home page.</descrip></descripGrp><ntig><termGrp><term id="1052639">deep linking</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2578677">डिप लिङ्किङ</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22631_1052824_1374710"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An icon that is attached to an event and that is viewable in someone's calendar. Depending on the calendar view, a charm may appear next to an event title, or may be the only visual representation of an event on a calendar day.</descrip></descripGrp><ntig><termGrp><term id="1052824">charm</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1374710">आकर्षण</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22632_1052846_1880616"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A traditional graphics plotter that uses pens to draw on paper. Pen plotters use one or more colored pens, either fiber-tipped pens or, for highest-quality output, drafting pens.</descrip></descripGrp><ntig><termGrp><term id="1052846">pen plotter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1880616">पेन प्लटर</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22638_1052853_2699473"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A pointer to nothing: usually a standardized memory address, such as 0. A null pointer usually marks the last of a linear sequence of pointers or indicates that a data search operation has come up empty.</descrip></descripGrp><ntig><termGrp><term id="1052853">null pointer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2699473">नल पोइन्टर</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22638_1052854_2699473"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A pointer to nothing: usually a standardized memory address, such as 0. A null pointer usually marks the last of a linear sequence of pointers or indicates that a data search operation has come up empty.</descrip></descripGrp><ntig><termGrp><term id="1052854">nil pointer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2699473">नल पोइन्टर</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2268_184296_487980"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A searchable collection of articles and facts about a particular subject area.</descrip></descripGrp><ntig><termGrp><term id="184296">knowledge base</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="487980">ज्ञानाधार</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2268_184296_488767"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A searchable collection of articles and facts about a particular subject area.</descrip></descripGrp><ntig><termGrp><term id="184296">knowledge base</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="488767">केबी</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2268_351589_487980"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A searchable collection of articles and facts about a particular subject area.</descrip></descripGrp><ntig><termGrp><term id="351589">KB</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="487980">ज्ञानाधार</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2268_351589_488767"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A searchable collection of articles and facts about a particular subject area.</descrip></descripGrp><ntig><termGrp><term id="351589">KB</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="488767">केबी</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22734_1054764_1454215"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A view that shows all of the resources on a project and their work over time. This makes it easy to rearrange work, schedule new work, and manage a team's load.</descrip></descripGrp><ntig><termGrp><term id="1054764">Team Planner</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1454215">टिम प्लानर</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22735_1054767_1225640"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows the application of tags to individual Outlook items to specify retention policy for that message, conversation or other item.</descrip></descripGrp><ntig><termGrp><term id="1054767">Retention Policy</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1225640">धारणा नीति</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22781_1054938_1519143"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To permit someone else to perform an action.</descrip></descripGrp><ntig><termGrp><term id="1054938">allow</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1519143">अनुमति दिनुहोस्</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2279_26594_487008"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A piece of software that functions as an electronic calendar used for scheduling.</descrip></descripGrp><ntig><termGrp><term id="26594">calendar program</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="487008">पात्रो कार्यक्रम</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2279_26594_488370"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A piece of software that functions as an electronic calendar used for scheduling.</descrip></descripGrp><ntig><termGrp><term id="26594">calendar program</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="488370">पात्रो</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2279_294450_487008"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A piece of software that functions as an electronic calendar used for scheduling.</descrip></descripGrp><ntig><termGrp><term id="294450">calendar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="487008">पात्रो कार्यक्रम</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2279_294450_488370"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A piece of software that functions as an electronic calendar used for scheduling.</descrip></descripGrp><ntig><termGrp><term id="294450">calendar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="488370">पात्रो</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22798_1055051_2699476"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A microprocessor architecture developed in 1992 by Motorola and IBM, with some participation by Apple. A PowerPC microprocessor is RISC-based and superscalar, with a 64-bit data bus and 32-bit address bus. It also has separate data and instruction caches, although the size of each varies by implementation. All PowerPC microprocessors have multiple integer and floating-point units. The voltage and operating speed varies with the implementation. Starting with the PowerPC 740, the microprocessors were manufactured with copper, instead of aluminum, for better performance and reliability.</descrip></descripGrp><ntig><termGrp><term id="1055051">PowerPC</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2699476">PowerPC</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22823_1055132_1225641"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The navigation button used to return to recently visited Web pages in Internet Explorer, Microsoft Edge, and other internet browsers.</descrip></descripGrp><ntig><termGrp><term id="1055132">Back</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1225641">पछाडि</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2285_109836_1880199"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A join in which records from a table are combined with other records from the same table when there are matching values in the joined fields. A self-join can be an inner join or an outer join. In database diagrams, a self-join is called a reflexive relationship.</descrip></descripGrp><ntig><termGrp><term id="109836">self-join</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1880199">स्वयम्-जडान</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22865_1055946_1225642"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Information that describes the current location of a computer. The location is entered manually in Default Location, and can be used by programs to determine the location of a computer when a location sensor is unavailable.</descrip></descripGrp><ntig><termGrp><term id="1055946">default location</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1225642">पूर्वनिर्धारित स्थान</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2290_103825_487560"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Generally, any part of a computer system or network, such as a disk drive, printer, or memory, that can be allotted to a running program or a process.</descrip></descripGrp><ntig><termGrp><term id="103825">resource</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="487560">संसाधन</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2291_184207_1880325"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The hierarchical HTML tag structure of an opened HTML document that appears in a task pane window.</descrip></descripGrp><ntig><termGrp><term id="184207">tag tree</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1880325">ट्याग ट्री</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22911_1056204_1225643"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A term that can be added to a search to filter the results by a specific property (for example, by author). Relevant search filters appear under the search box in any open folder.</descrip></descripGrp><ntig><termGrp><term id="1056204">search filter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1225643">खोज फिल्टर</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2293_79701_487417"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A rectangular bar displayed in an application's window, often at the top, from which menus can be selected by the user.</descrip></descripGrp><ntig><termGrp><term id="79701">menu bar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="487417">मेनुपट्टी</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22931_1056336_1225644"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of corruption that affects the data in the Windows heap, such as damages caused by a buffer overrun, writing to a stray pointer or a double-free.</descrip></descripGrp><ntig><termGrp><term id="1056336">heap corruption</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1225644">हिप विकृति</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22944_1056351_1225645"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A soft keyboard that is displayed with a different set of settings by default (larger buttons, bigger size, etc.) when you launch the Tablet PC Input Panel with touch. This is to facilitate touch input.</descrip></descripGrp><ntig><termGrp><term id="1056351">touch keyboard</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1225645">टच कुञ्जीपाटी</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22951_1056450_1225646"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A two-way device provided by a cable provider that enables some one-way digital CableCARD-based consumer electronic devices such as high-definition DVRs and Media Center PCs to access digital cable channels delivered using switched digital video.</descrip></descripGrp><ntig><termGrp><term id="1056450">tuning adapter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1225646">टिए</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22951_1056452_1225646"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A two-way device provided by a cable provider that enables some one-way digital CableCARD-based consumer electronic devices such as high-definition DVRs and Media Center PCs to access digital cable channels delivered using switched digital video.</descrip></descripGrp><ntig><termGrp><term id="1056452">TA</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1225646">टिए</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22975_1056711_1994742"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A small, affordable laptop that is designed to perform a limited number of tasks such as web browsing and email.</descrip></descripGrp><ntig><termGrp><term id="1056711">netbook</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1994742">नेटबुक</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22975_1099729_1994742"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A small, affordable laptop that is designed to perform a limited number of tasks such as web browsing and email.</descrip></descripGrp><ntig><termGrp><term id="1099729">small notebook PC</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1994742">नेटबुक</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2299_232415_488087"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A message that appears at a specified interval before an appointment, meeting, or task that announces when the activity is set to occur.</descrip></descripGrp><ntig><termGrp><term id="232415">reminder</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="488087">सम्झाउनी</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22992_1056886_1225647"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A real-time, physical action applied to an object, in which multiple contact points are used simultaneously.</descrip></descripGrp><ntig><termGrp><term id="1056886">multitouch</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1225647">मल्टि-टच</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22992_1056887_1225647"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A real-time, physical action applied to an object, in which multiple contact points are used simultaneously.</descrip></descripGrp><ntig><termGrp><term id="1056887">multi-touch</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1225647">मल्टि-टच</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2301_314116_488500"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An amount that is the difference between the sum of debit entries and the sum of credit entries entered into an account during a financial period.</descrip></descripGrp><ntig><termGrp><term id="314116">account balance</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="488500">खातामा बाँकी रकम</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2301_616949_488500"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An amount that is the difference between the sum of debit entries and the sum of credit entries entered into an account during a financial period.</descrip></descripGrp><ntig><termGrp><term id="616949">balance</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="488500">खातामा बाँकी रकम</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23043_1057319_1225648"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A device used to write CD-ROMs. Because a disc can be written only once on these machines, they are used most commonly to create CD-ROMs for data archives or to produce CD-ROM masters that can be duplicated for mass distribution.</descrip></descripGrp><ntig><termGrp><term id="1057319">CD recorder</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1225648">सिडी बर्नर</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23043_1057320_1225648"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A device used to write CD-ROMs. Because a disc can be written only once on these machines, they are used most commonly to create CD-ROMs for data archives or to produce CD-ROM masters that can be duplicated for mass distribution.</descrip></descripGrp><ntig><termGrp><term id="1057320">CD burner</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1225648">सिडी बर्नर</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2306_210486_1880343"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The formal name for Word 12 file format. This format has an open, royalty-free specification, and is the technology licensed to external parties. This license is the subject in the messaging points where “Open, royalty-free license” is discussed.</descrip></descripGrp><ntig><termGrp><term id="210486">Word XML Format</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1880343">Word XML ढाँचा</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23092_1058116_1225649"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that ensures that all components of a file are preserved, even if they are supported only by the rich client and not viewable in Web Companions.</descrip></descripGrp><ntig><termGrp><term id="1058116">Document Integrity</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1225649">कागजात विश्वसनियता</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2314_117926_1225247"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To change between states or modes.</descrip></descripGrp><ntig><termGrp><term id="117926">switch</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1225247">स्विच गर्नुहोस्</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2316_138366_2741841"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A format that can be applied to selected text characters.</descrip></descripGrp><ntig><termGrp><term id="138366">character formatting</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2741841">वर्ण फर्म्याटिङ</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23174_1060963_1520804"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The heading for information about the time at which something was added, changed, or re-posted.</descrip></descripGrp><ntig><termGrp><term id="1060963">updated</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1520804">अद्यावधिक गरिएको</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23177_1060970_1374711"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A customizable page that launches with Windows Live Messenger and features a summary of news and weather, allows a customer to preview their Windows Live Mail inbox and search the Internet.</descrip></descripGrp><ntig><termGrp><term id="1060970">Today page</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1374711">आज पृष्ठ</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23178_1060971_1519551"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The title of the window in which the Windows Live Messenger Today page is displayed.</descrip></descripGrp><ntig><termGrp><term id="1060971">Today</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1519551">आज</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23180_1060974_1880617"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A text box where someone enters the email addresses of the primary recipients of an email message.</descrip></descripGrp><ntig><termGrp><term id="1060974">To box</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1880617">लागि बाकस</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23184_1060982_1225650"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of features that enables users to improve the quality of their images with just one or two clicks. Galleries help the user optimize characteristics such as brightness, contrast, color, and sharpness.</descrip></descripGrp><ntig><termGrp><term id="1060982">Corrections</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1225650">सुधारहरु</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23200_1062908_1225651"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables Tablet PC users to convert an ink drawing to a standard OfficeArt shape, which can be formatted with colors and effects exactly as if it were inserted using “Insert Shape.”</descrip></descripGrp><ntig><termGrp><term id="1062908">Convert to Shape</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1225651">आकारमा रूपान्तरण गर्नुहोस्</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23201_1062909_1225652"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables presenters to capture all the elements of a live presentation, including narration, slides, mouse clicks, A/V playback, and laser pointer highlights. The user can select which presentation aspects to record.</descrip></descripGrp><ntig><termGrp><term id="1062909">Record Slide Show</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1225652">रेकर्ड स्लाइड प्रदर्शन</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23214_1064085_1649402"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A map view created from aerial photos that shows buildings, roads, and geographical features.</descrip></descripGrp><ntig><termGrp><term id="1064085">aerial view</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1649402">हवाइ दृश्य</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2323_61200_3041927"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to the base-16 number system represented by the digits 0 through 9 and the uppercase or lowercase letters A (equivalent to decimal 10) through F (equivalent to decimal 15). Hexadecimal values are commonly used in HTML code to identify colors.</descrip></descripGrp><ntig><termGrp><term id="61200">hex</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="3041927">हेक्स</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2323_61201_3041927"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to the base-16 number system represented by the digits 0 through 9 and the uppercase or lowercase letters A (equivalent to decimal 10) through F (equivalent to decimal 15). Hexadecimal values are commonly used in HTML code to identify colors.</descrip></descripGrp><ntig><termGrp><term id="61201">hexadecimal</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="3041927">हेक्स</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2325_347934_488755"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The InfoPath design environment in which you can create or modify a form template.</descrip></descripGrp><ntig><termGrp><term id="347934">design mode</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="488755">डिजाइन मोड</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2328_21412_486973"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To associate two pieces of information with one another.</descrip></descripGrp><ntig><termGrp><term id="21412">bind</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="486973">बाँध्नु</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23319_1072508_2433743"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The XML-based vector image format for two-dimensional graphics that supports interactivity and animation and that maintains an image's appearance regardless of screen size or print size.</descrip></descripGrp><ntig><termGrp><term id="1072508">Scalable Vector Graphics</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2433743">SVG</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23319_1072509_2433743"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The XML-based vector image format for two-dimensional graphics that supports interactivity and animation and that maintains an image's appearance regardless of screen size or print size.</descrip></descripGrp><ntig><termGrp><term id="1072509">SVG</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2433743">SVG</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2333_146857_1225248"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Row or column labels that are printed at the top of or on the left side of every page on a printed worksheet.</descrip></descripGrp><ntig><termGrp><term id="146857">print titles</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1225248">छाप्ने शीर्षकहरू</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23331_1073321_1225653"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A slide show mode that displays content in a manageable window that can be resized and features navigation buttons. This mode is optimized for reviewing presentations, allowing users to get the full experience, complete with animations and media, while performing other tasks, such as taking notes.</descrip></descripGrp><ntig><termGrp><term id="1073321">Reading View</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1225653">पाठ्य दृश्य</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23333_1087526_1225654"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows users to easily add links to content within other content (e.g. pages, sections, section groups) and provides quick navigation through these links. The feature operates in the same manner that links work in wikis.</descrip></descripGrp><ntig><termGrp><term id="1087526">linking</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1225654">लिङ्क गरिरहेको</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23334_1073349_1225655"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that highlights new or changed content in a shared notebook that the user has not yet read.</descrip></descripGrp><ntig><termGrp><term id="1073349">Unread Changes</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1225655">नपढेको परिवर्तनहरू</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23335_1073356_1454216"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A high-level linear representation of a project schedule that can be easily formatted, annotated, and copied and pasted from Project into other Office applications.</descrip></descripGrp><ntig><termGrp><term id="1073356">timeline</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1454216">समयरेखा</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23336_1073640_1225656"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that identifies the author of unread new or changed content in a shared notebook.</descrip></descripGrp><ntig><termGrp><term id="1073640">Author Marks</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1225656">लेखकको चिन्हहरु</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23347_1074772_1454217"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A task pane that helps form designers to build and manage custom business rules for use in their forms.</descrip></descripGrp><ntig><termGrp><term id="1074772">Rules Manager</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1454217">नियमहरूको व्यवस्थापक</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23348_1074773_1454218"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A pre-defined table style that allows users to change the look and feel of a form.</descrip></descripGrp><ntig><termGrp><term id="1074773">layout style</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1454218">सजावट शैली</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23349_1074775_1454219"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows form designers to select from a gallery of pre-built rules to make their forms dynamic.</descrip></descripGrp><ntig><termGrp><term id="1074775">Quick Rules</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1454219">द्रुत नियमहरू</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23351_1074778_1454220"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A pre-defined layout that users can select for their InfoPath form sections. Options include single column, two-column, three-column, and four-column layouts.</descrip></descripGrp><ntig><termGrp><term id="1074778">section layout</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1454220">सेक्सन सजावट</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23352_1216614_1454221"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An environment in the InfoPath client that enables users to fill out forms (as opposed to designing them). It must be used if the forms to be filled out are not browser-compatible.</descrip></descripGrp><ntig><termGrp><term id="1216614">InfoPath Filler</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1454221">Infopath Filler</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23352_1216691_1454221"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An environment in the InfoPath client that enables users to fill out forms (as opposed to designing them). It must be used if the forms to be filled out are not browser-compatible.</descrip></descripGrp><ntig><termGrp><term id="1216691">Microsoft InfoPath Filler</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1454221">Infopath Filler</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23361_1074891_2072477"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The combination of hardware (touchscreen or touchpad) and software elements that provides a way to control programs by touching multiple points on the screen simultaneously.</descrip></descripGrp><ntig><termGrp><term id="1074891">multi-touch</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2072477">मल्टि-टच</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="234_237832_1454105"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An object created using drawing tools or commands.</descrip></descripGrp><ntig><termGrp><term id="237832">shape</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1454105">आकार</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2342_138389_487760"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The entire chart and all its elements.</descrip></descripGrp><ntig><termGrp><term id="138389">chart area</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="487760">चित्रपटक्षेत्र</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2344_21520_1225814"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The set of essential software routines that test computer hardware at startup, start the operating system, and support the transfer of information between hardware devices. The BIOS is stored in read-only memory (ROM) so that it can be run when the computer is turned on. Although critical to performance, the BIOS is usually invisible to computer users.</descrip></descripGrp><ntig><termGrp><term id="21520">BIOS</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1225814">BIOS</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2344_21520_486975"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The set of essential software routines that test computer hardware at startup, start the operating system, and support the transfer of information between hardware devices. The BIOS is stored in read-only memory (ROM) so that it can be run when the computer is turned on. Although critical to performance, the BIOS is usually invisible to computer users.</descrip></descripGrp><ntig><termGrp><term id="21520">BIOS</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="486975">सामान्य आगत/निर्गत प्रणाली</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2344_21521_1225814"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The set of essential software routines that test computer hardware at startup, start the operating system, and support the transfer of information between hardware devices. The BIOS is stored in read-only memory (ROM) so that it can be run when the computer is turned on. Although critical to performance, the BIOS is usually invisible to computer users.</descrip></descripGrp><ntig><termGrp><term id="21521">basic input/output system</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1225814">BIOS</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2344_21521_486975"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The set of essential software routines that test computer hardware at startup, start the operating system, and support the transfer of information between hardware devices. The BIOS is stored in read-only memory (ROM) so that it can be run when the computer is turned on. Although critical to performance, the BIOS is usually invisible to computer users.</descrip></descripGrp><ntig><termGrp><term id="21521">basic input/output system</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="486975">सामान्य आगत/निर्गत प्रणाली</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23462_1082215_1225657"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The street address or geographical coordinates of a user, and (by way of extensions) of the user’s computer or devices.</descrip></descripGrp><ntig><termGrp><term id="1082215">location</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1225657">स्थान</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23513_1086437_1225658"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To save the user's work on a continuous basis, so that it is not necessary to save manually.</descrip></descripGrp><ntig><termGrp><term id="1086437">automatically save</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1225658">स्वचालित बचत</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23517_1086719_1225659"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows users to see conflicting appointments directly from Mail view without having to switch to Calendar view. Makes it much easier for users to decide to accept or decline a meeting invite that conflicts with an existing meeting.</descrip></descripGrp><ntig><termGrp><term id="1086719">Calendar Preview</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1225659">पात्रो पूर्वावलोकन</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23520_2781049_1765884"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The suite of web-based productivity offerings from Office.</descrip></descripGrp><ntig><termGrp><term id="2781049">Office on the web</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1765884">Office Web Apps</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig