80844"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A component of the Work Management Service that synchronizes tasks with systems outside of SharePoint, such as an Exchange mailbox, to enable task management in Outlook.</descrip></descripGrp><ntig><termGrp><term id="1637597">Work Management Task Sync</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1880844">कार्य व्यवस्थापन कार्य समक्रमण</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32164_1637809_1880845"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A touch-friendly, contextual control that presents commands in a circular arrangement.</descrip></descripGrp><ntig><termGrp><term id="1637809">radial menu</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1880845">रेडियल मेनु</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32167_1637812_1880846"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A gallery of HTML code snippets for common components that can be customized and added to SharePoint designs.</descrip></descripGrp><ntig><termGrp><term id="1637812">Snippet Gallery</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="18808