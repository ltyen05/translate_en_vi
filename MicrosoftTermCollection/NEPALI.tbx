L</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43102_2441983_2445417"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The font style that applies a particular font to the book that is being read, resembling a newspaper or other news source.</descrip></descripGrp><ntig><termGrp><term id="2441983">News</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2445417">समाचार</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43103_2441984_2445418"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The font style that applies a particular font to the book that is being read to minimize clutter and create a clean look.</descrip></descripGrp><ntig><termGrp><term id="2441984">Pure</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2445418">प्युर</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43104_2441985_2445419"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The font style that applies a particular font to the book that is being read to make it look more fun and friendly.</descrip></descripGrp><ntig><termGrp><term id="2441985">Relaxed</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2445419">रिल्याक्स्ड</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43105_2441990_2450715"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft touchscreen accessory for Surface devices that allows users to access menus and scroll and swipe through documents and images.</descrip></descripGrp><ntig><termGrp><term id="2441990">Surface Dial</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2450715">Surface Dial</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43107_2441993_2450716"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft all-in-one touchscreen computer.</descrip></descripGrp><ntig><termGrp><term id="2441993">Surface Studio</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2450716">Surface Studio</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4314_148023_487847"><langSet xml:lang=