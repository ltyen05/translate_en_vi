fSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2249638">इम्बेड</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38589_2556692_2249638"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Sway card that allows users to embed content into their sway from the web.</descrip></descripGrp><ntig><termGrp><term id="2556692">Embed card</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2249638">इम्बेड</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38590_2244295_2249662"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A button that contains a suggested search term based on what content the user has in his/her sway.</descrip></descripGrp><ntig><termGrp><term id="2244295">search tag</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2249662">खोजी ट्याग</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38592_2244475_2249681"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Sway feature that uses an intelligence platform to suggest color options based on the content in a user’s sway.</descrip></descripGrp><ntig><termGrp><term id="2244475">Suggested color</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2249681">सुझाव गरिएको रङ</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38593_2244476_2249599"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Sway feature that allows users to make Style- and Structure-based changes to their sway.</descrip></descripGrp><ntig><termGrp><term id="2244476">Design</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2249599">डिजाइन</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38594_2244477_2249678"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Sway feature that allows users to choose a color and font for their sway.</descrip></descripGrp><ntig><termGrp><term id="2244477">Style</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2249678">शैली</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38595_2244478_2249636"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Sway panel that provides users with all the Style and Structure options.</descrip></descripGrp><ntig><termGrp><term id="2244478">Design panel</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2249636">डिजाइन प्यानल</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38597_2244480_2249644"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Sway card that takes a set of cards and creates a group out of them with a particular visualization pattern.</descrip></descripGrp><ntig><termGrp><term id="2244480">group card</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2249644">समूह कार्ड</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38598_2244481_2249679"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The gallery that holds all the Style options that can be applied to a sway.</descrip></descripGrp><ntig><termGrp><term id="2244481">Style gallery</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2249679">शैली ग्यालरी</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38599_2244483_2249641"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The option that shows the set of fonts that can be applied to a sway.</descrip></descripGrp><ntig><termGrp><term id="2244483">Font choices</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2249641">फन्ट छनौटहरू</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="386_93737_487520"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A hardware- or software-based interface used to transfer information between a computer and other devices. Hardware ports are physical connections that are visible on the outside of the computer. Software ports are the numbered gateways in programs that software programs use to exchange information.</descrip></descripGrp><ntig><termGrp><term id="93737">port</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="487520">पोर्ट</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38600_2244485_2249639"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Design feature that allows users to save particular Designs, Styles, or Structures for easy use or access later.</descrip></descripGrp><ntig><termGrp><term id="2244485">Favorites</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2249639">मनपर्नेहरू</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38601_2244486_2249683"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The navigation layout that presents content in a single column on the page and that allows user to navigate from top to bottom.​​</descrip></descripGrp><ntig><termGrp><term id="2244486">Vertical</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2249683">ठाडो</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38602_2244487_2249658"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Structure that places content along the horizontal axis and allows users to navigate through it from left and right.</descrip></descripGrp><ntig><termGrp><term id="2244487">Panorama</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2249658">पनोरमा</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun<