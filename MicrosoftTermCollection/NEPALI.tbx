95343">COVARIANCE.S</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52345_2955557_2995344"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Compatibility/Statistical Excel function that returns the smallest value for which the cumulative binomial distribution is less than or equal to a criterion value.</descrip></descripGrp><ntig><termGrp><term id="2955557">CRITBINOM</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2995344">CRITBINOM</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52346_2955558_2995345"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Math and trigonometry Excel function that returns the cosecant of an angle.</descrip></descripGrp><ntig><termGrp><term id="2955558">CSC</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2995345">CSC</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52347_2955559_2995346"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Math and trigonometry Excel function that returns the hyperbolic cosecant of an angle.</descrip></descripGrp><ntig><termGrp><term id="2955559">CSCH</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2995346">CSCH</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52348_2955560_2995347"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Cube Excel function that returns a key performance indicator (KPI) name, property, and measure, and displays the name and property in the cell. A KPI is a quantifiable measurement, such as monthly gross profit or quarterly employee turnover, used to monitor an organization's performance.</descrip></descripGrp><ntig><termGrp><term id="2955560">CUBEKPIMEMBER</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2995347">CUBEKPIMEMBER</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52349_2955561_2995348"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Cube Excel function that returns a member or tuple in a cube hierarchy. Use to validate that the member or tuple exists in the cube.</descrip></descripGrp><ntig><termGrp><term id="2955561">CUBEMEMBER</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2995348">CUBEMEMBER</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52350_2955562_2995349"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Cube Excel function that returns the value of a member property in the cube. Use to validate that a member name exists within the cube and to return the specified property for this member.</descrip></descripGrp><ntig><termGrp><term id="2955562">CUBEMEMBERPROPERTY</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2995349">CUBEMEMBERPROPERTY</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52351_2955563_2995350"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Cube Excel function that returns the nth, or ranked, member in a set. Use to return one or more elements in a set, such as the top sales performer or top 10 students.</descrip></descripGrp><ntig><termGrp><term id="2955563">CUBERANKEDMEMBER</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2995350">CUBERANKEDMEMBER</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52352_2955564_2995351"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Cube Excel function that defines a calculated set of members or tuples by sending a set expression to the cube on the server, which creates the set, and then returns that set to Microsoft Office Excel.</descrip></descripGrp><ntig><termGrp><term id="2955564">CUBESET</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2995351">CUBESET</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52353_2955565_2995352"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Cube Excel function that returns the number of items in a set.</descrip></descripGrp><ntig><termGrp><term id="2955565">CUBESETCOUNT</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2995352">CUBESETCOUNT</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52354_2955566_2995353"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Cube Excel function that returns an aggregated value from a cube.</descrip></descripGrp><ntig><termGrp><term id="2955566">CUBEVALUE</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2995353">CUBEVALUE</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52355_2955567_2995354"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Financial Excel function that returns the cumulative interest paid between two periods.</descrip></descripGrp><ntig><termGrp><term id="2955567">CUMIPMT</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2995354">CUMIPMT</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52356_2955568_2995355"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Financial Excel function that returns the cumulative principal paid on a loan between two periods.</descrip></descripGrp><ntig><termGrp><term id="2955568">CUMPRINC</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2995355">CUMPRINC</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52357_2955569_2995356"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Date and time Excel function that returns the serial number of a particular date.</descrip></descripGrp><ntig><termGrp><term id="2955569">DATE</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></