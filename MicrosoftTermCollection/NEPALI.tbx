tion">The window in which a user is currently working or directing input. An active window is typically at the top of the Z order and is distinguished by the color of its title bar.</descrip></descripGrp><ntig><termGrp><term id="8743">active window</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="486892">सक्रिय सन्झ्याल</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1469_307402_488441"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The tool which enables users to automatically perform routine tasks on a chosen computer by monitoring whatever criteria the users choose to initiate the tasks (referred to as triggers) and then executing the tasks when the criteria is met.</descrip></descripGrp><ntig><termGrp><term id="307402">Task Scheduler</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="488441">कार्य तालिका</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14695_374338_1795738"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A field data type that can contain up to 255 characters or the number of characters specified by the Fieldsize property, whichever is less.</descrip></descripGrp><ntig><termGrp><term id="374338">Text</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1795738">पाठ</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14700_1176605_487514"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A unit of measure referring to the height of a printed character. A point equals 1/72 of an inch, or approximately 1/28 of a centimeter.</descrip></descripGrp><ntig><termGrp><term id="1176605">pt</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="487514">बिन्दु</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14700_93093_487514"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A unit of measure referring to the height of a printed character. A point equals 1/72 of an inch, or approximately 1/28 of a centimeter.</descrip></descripGrp><ntig><termGrp><term id="93093">point</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="487514">बिन्दु</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14701_545433_1432377"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The part of the Microsoft Office user interface above the main work area that presents commands and options to the user. The Ribbon replaced menus and toolbars starting in the 2007 Microsoft Office system.</descrip></descripGrp><ntig><termGrp><term id="545433">Ribbon</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1432377">रिबन</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14713_375730_1454167"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An indent where the text is displaced into the left margin if text direction is set to left-to-right, or toward the right margin if text direction is set to right-to-left.</descrip></descripGrp><ntig><termGrp><term id="375730">outdent</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1454167">आउटडेन्ट</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14713_375730_487443"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An indent where the text is displaced into the left margin if text direction is set to left-to-right, or toward the right margin if text direction is set to right-to-left.</descrip></descripGrp><ntig><termGrp><term id="375730">outdent</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="487443">ऋणात्मक इन्डेन्ट</ter