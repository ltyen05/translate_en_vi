ication.</descrip></descripGrp><ntig><termGrp><term id="2285299">Office add-in</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2290756">Office एड-इन</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32183_1638272_1642405"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user interface element that provides access to sharing files and info with other apps.</descrip></descripGrp><ntig><termGrp><term id="1638272">Share charm</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1642405">शोभा साझा गर्नुहोस्</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32184_1638273_1642391"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user interface element that provides access to search in apps or on the PC.</descrip></descripGrp><ntig><termGrp><term id="1638273">Search charm</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1642391">खोज शोभा</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32185_1638274_1642024"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user interface element that provides access to external devices like media players or printers.</descrip></descripGrp><ntig><termGrp><term id="1638274">Devices charm</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1642024">यन्त्रहरूको शोभा</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32186_1638275_1642399"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user interface element that provides access to PC and app settings.</descrip></descripGrp><ntig><termGrp><term id="1638275">Settings charm</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1642399">सेटिङहरूको शोभा</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="322_318723_488584"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Any disk drive, folder, or other place in which you can store files and folders. Programs will commonly ask you to choose a location to save a file.</descrip></descripGrp><ntig><termGrp><term id="318723">location</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="488584">स्थान</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</t