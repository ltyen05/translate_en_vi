board key that traditionally (as in word processing) is used to insert tab characters into a document.</descrip></descripGrp><ntig><termGrp><term id="2099681">Tab</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2217612">ट्याब</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36882_2099685_2947905"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A GUI tool used to create and manage lists that tell Internet Explorer 11 which websites to run in Enterprise Mode.</descrip></descripGrp><ntig><termGrp><term id="2099685">Enterprise Mode Site List Manager</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2947905">इन्टरप्राइज मोडको साइट सूची प्रबन्धक</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36887_2099902_2194336"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Street level imagery that enables users to experience Bing Maps from the street level. Streetside supplements maps, directions and local search.</descrip></descripGrp><ntig><termGrp><term id="2099902">Streetside</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2194336">Streetside</term><termNote type="geographicalUsage">NPL</termNot