ft Office Web application that provides secure access to email, personal calendar, group scheduling, and collaboration applications on Microsoft Exchange Server with only a Web browser.</descrip></descripGrp><ntig><termGrp><term id="1165894">Outlook Web App</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1880639">Outlook Web App</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1833_1244832_1454115"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft Office Web application that provides secure access to email, personal calendar, group scheduling, and collaboration applications on Microsoft Exchange Server with only a Web browser.</descrip></descripGrp><ntig><termGrp><term id="1244832">Microsoft Outlook Web App</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1454115">Microsoft Outlook Web App</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1833_1244832_1880639"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft Office Web application that provides secure access to email, personal calendar, group scheduling, and collaboration applications on Microsoft Exchange Server with only a Web browser.</descrip></descripGrp><ntig><termGrp><term id="1244832">Microsoft Outlook Web App</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1880639">Outlook Web App</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1835_144218_2737342"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A version of a program that has been localized for other markets and/or translated into other languages.</descrip></descripGrp><ntig><termGrp><term id="144218">localized version</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2737342">स्थानीयकरण गरिएको संस्करण</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1839_127118_487682"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A property that defines valid input values for a field or record in a table, or a control on a form.</descrip></descripGrp><ntig><termGrp><term id="127118">validation rule</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="487682">वैधानिकता नियम</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1846_97122_1225239"><langSet xml:lang="en-US"><descripGrp><de