nd shared keys necessary for computers to communicate by using Internet Protocol security (IPsec).</descrip></descripGrp><ntig><termGrp><term id="262695">IKE</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="488276">इन्टरनेट की एक्सचेन्ज</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9590_134813_487731"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To prevent the writing (recording) of information, usually on a disk.</descrip></descripGrp><ntig><termGrp><term id="134813">write-protect</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="487731">लेख्नबाट बचाउनुहोस्</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9597_347918_488753"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A filter effect in Windows Movie Maker.</descrip></descripGrp><ntig><termGrp><term id="347918">Grayscale</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="488753">खरानी रङ गरिएको</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9605_117359_3074219"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To start using the services of a service provider, e.g. an Internet access provider.</descrip></descripGrp><ntig><termGrp><term id="117359">subscribe</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="3074219">सबस्क्राइब गर्नुहोस्‌</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9608_183935_1454148"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A graphic element on a drawing that is associated with data.</descrip></descripGrp><ntig><termGrp><term id="183935">data graphic</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1454148">लगत ग्राफिक</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9610_2296363_1225832"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The set of authentication methods (NTLM, Kerberos, and Negotiate) used to provide transport-level security.</descrip></descripGrp><ntig><termGrp><term id="2296363">Integrated Windows Authentication</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1225832">एनटिएलएम</term><termNote type="geographicalUsage">NPL</termNote><termNote type="p