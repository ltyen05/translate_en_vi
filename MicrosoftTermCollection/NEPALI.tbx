rtOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2590061">Intune Company Portal</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44329_2489211_2590125"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The application available on devices you manage with Intune which is used to access company data to perform common tasks like enrolling devices, installing apps, and locating information for assistance from your IT department.</descrip></descripGrp><ntig><termGrp><term id="2489211">Intune Company Portal</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2590125">Company Portal</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44329_2490036_2590061"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The application available on devices you manage with Intune which is used to access company data to perform common tasks like enrolling devices, installing apps, and locating information for assistance from your IT department.</descrip></descripGrp><ntig><termGrp><term id="2490036">Company Portal</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2590061">Intune Company Portal</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44329_2490036_2590125"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The application available on devices you manage with Intune which is used to access company data to perform common tasks like enrolling devices, installing apps, and locating information for assistance from your IT department.</descrip></descripGrp><ntig><termGrp><term id="2490036">Company Portal</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2590125">Company Portal</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44349_2490693_2501621"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Outlook feature that allows users to select a later time to automatically deliver emails and where said emails are stored in the Drafts folder until the time selected for sending.​</descrip></descripGrp><ntig><termGrp><term id="2490693">Send Later</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2501621">पछि पठाउनुहोस्</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44350_2490694_2502318"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The value that Excel returns when a formula returns an array of values and one or more of the cells it would spill to already has content.</descrip></descripGrp><ntig><termGrp><term id="2490694">#NOSPILL!</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2502318">#नोस्पिल!</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44351_2490695_2501620"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The value that Excel returns when a function tried to connect to a network resource or a remote service but failed.​​</descrip></descripGrp><ntig><termGrp><term id="2490695">#CONNECT!</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2501620">#जडान गर्नुहोस्</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44351_2490695_2502322"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The value that Excel returns when a function tried to connect to a network resource or a remote service but failed.​​</descrip></descripGrp><ntig><termGrp><term id="2490695">#CONNECT!</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2502322">#जडान गर्नुहोस्!</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44352_2490696_2502320"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Excel cell capability that allows a cell to place array values in neighboring blank cells.</descrip></descripGrp><ntig><termGrp><term id="2490696">Spill</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2502320">स्पिल</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44355_2493977_2513551"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A container for a collection of configuration settings file with extension .ppkg. Provisioning packages are simple enough that with a short set of written instructions, a student or non-technical employee can use them to configure their device.</descrip></descripGrp><ntig><termGrp><term id="2493977">provisioning package</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2513551">प्रावधानको प्याकेज</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44356_2493981_2513554"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The academic disciplines of science, technology, engineering a