ype="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37480_2139120_2249595"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of different visualization patterns and interactions for content shown in Sway.</descrip></descripGrp><ntig><termGrp><term id="2139120">card</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2249595">कार्ड</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37481_2139121_2249646"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Sway card that allows the user to select one or more pieces or types of content and change what is selected into a heading.</descrip></descripGrp><ntig><termGrp><term id="2139121">Header</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2249646">हेडर</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37482_2139122_2249676"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Sway card that shows individual pieces of content sequentially, allowing forward and backward navigation one piece of content at a time.</descrip></descripGrp><ntig><termGrp><term id="2139122">Slideshow</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2249676">स्लाइडशो</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37483_2139123_2249677"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Sway group card that shows individual pieces of content sequentially, as a skeuomorphic stack.</descrip></descripGrp><ntig><termGrp><term id="2139123">Stack</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2249677">स्ट्याक</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37485_2139126_2232303"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Sway option button under “Add Content” that allows users to select an office document and import it into Sway.</descrip></descripGrp><ntig><termGrp><term id="2139126">Import Document</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2232303">कागजात आयात</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37528_2139461_2327975"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Sway button that allows the user to change a set of cards into a group of cards.</descrip></descripGrp><ntig><termGrp><term id="2139461">Group</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2327975">समूह</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37529_2139462_2249590"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The area on a card that allows a user to make the card’s image a background when clicked on.</descrip></descripGrp><ntig><termGrp><term id="2139462">Background</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2249590">पृष्ठभूमि</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37530_2139463_2249592"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Sway card that provides a quote-like treatment with breaks before and after selected content.</descrip></descripGrp><ntig><termGrp><term id="2139463">Block Quote</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2249592">ब्लक उद्धरण</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Prope