Note><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53219_3031672_3032510"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The combined search and audience advertising marketplace made up of Bing, MSN, Outlook, Edge, and partner sites.</descrip></descripGrp><ntig><termGrp><term id="3031672">Microsoft Search Network</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="3032510">Microsoft खोज नेटवर्क</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53220_3031831_3032138"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A policy template that helps detect cross-country or cross-region data transfers, identify the amount and types of personal data being transferred, and take actions to remediate risks, such as applying additional encryption or restricting access for the data being transferred.</descrip></descripGrp><ntig><termGrp><term id="3031831">cross-border transfers</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="3032138">सीमापार स्थानान्तरण</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53221_3031832_3032137"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A transfer of personal data across a geographic border (such as country or regional borders).</descrip></descripGrp><ntig><termGrp><term id="3031832">cross-border transfer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="3032137">सीमापार स्थानान्तरण</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53222_3031833_3032141"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A policy template that helps detect personal data with external, excessive, and idle access and trigger remediation actions including sending notifications to the data or site owners to remove unnecessary accesses.</descrip></descripGrp><ntig><termGrp><term id="3031833">data overexposure</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="3032141">डेटाको ओभरएक्सपोजर</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53223_3031834_3032140"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A policy template that helps detect personal data that has not been used for more than 90 days and trigger remediation actions, including sending notifications to data owners to apply retention labels or disposing of the information immediately.</descrip></descripGrp><ntig><termGrp><term id="3031834">data minimization</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml: