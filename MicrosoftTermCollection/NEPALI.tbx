ry id="31692_1612750_1642313"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Applications in Windows Store are distributed with user-based licensing model. Windows runtime and application model will only allow applications that are for user-based license as well as signed by Windows Store to be installed/run on Windows 8.</descrip></descripGrp><ntig><termGrp><term id="1612750">Microsoft License Terms for Consumers</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1642313">उपभोक्ताहरूको लागि Microsoft का इजाजत सर्तहरू</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31693_1612753_1642310"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Windows 8 all windows portal experiences support and persist Live ID logins streamlining the partner experience when working with multiple services and sites.</descrip></descripGrp><ntig><termGrp><term id="1612753">Microsoft account logins</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1642310">Microsoft खाता लगइनहरू</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31698_1612764_1642371"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of notification sent via the Microsoft Push Notification Service to an app running on Windows Phone. The format and meaning of the data is determined by 