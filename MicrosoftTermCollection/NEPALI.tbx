<termEntry id="8657_9827_486903"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The person in charge of managing a computer. The administrator is responsible for installing software, assigning passwords, and managing files.</descrip></descripGrp><ntig><termGrp><term id="9827">administrator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="486903">व्यवस्थापक</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8657_9827_488546"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The person in charge of managing a computer. The administrator is responsible for installing software, assigning passwords, and managing files.</descrip></descripGrp><ntig><termGrp><term id="9827">administrator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="488546">कम्प्युटर व्यवस्थापक</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="866_312761_488495"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A System Audio Effects (SYSFX) component used to provide a more immersive audio experience in the Windows Media Player and thus an improved listening experience by utilizing the available speakers that a user has attached to his/her PC by sending audio to all of the speakers, regardless of the number of channels the content contains. This will provide a better sounding experience for stereo and quadraphonic content being rendered on multi-channel playback systems.</descrip></descripGrp><ntig><termGrp><term id="312761">speaker fill</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="488495">स्पिकर फिल</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8664_55395_487251"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The stylistic attributes of a font — such as bold, italic, and underline.</descrip></descripGrp><ntig><termGrp><term id="55395">font style</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="487251">फन्ट शैली</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8688_228749_1225340"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A list of users, accounts, Web sites, etc. that are permitted to perform certain actions on a network.</descrip></descripGrp><ntig><termGrp><term id="228749">Allow list</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1225340">अनुमति सूची</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8688_276556_1225340"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A list of users, accounts, Web sites, etc. that are permitted to perform certain actions on a network.</descrip></descripGrp><ntig><termGrp><term id="276556">allow list</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1225340">अनुमति सूची</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="869_557910_1880431"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An optional Microsoft Exchange 2000 Server component that is installed on a designated server in an administrative group. It provides centralized administration and archival of private keys, and maintains every user s private encryption key in an encrypted database. The keys are used for encrypting email messages and signing messages with digital signatures.</descrip></descripGrp><ntig><termGrp><term id="557910">Key Management Service</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1880431">कुञ्जी व्यवस्थापन सेवा</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8696_183901_1880319"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A slide template that defines default formatting or the position of placeholders for one or more slides in a presentation.</descrip></descripGrp><ntig><termGrp><term id="183901">content master</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1880319">सामग्री मास्टर</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8706_186134_487987"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The set of rules on a computer and a portable device that allow digital media files and other information to be synchronized.</descrip></descripGrp><ntig><termGrp><term id="186134">partnership</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="487987">साझेदारी</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8714_186176_1951322"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A context menu that enables the user to preview the contents of a file with the Office Preview Handler (OPH) in Outlook (either documents attached to email or SharePoint documents in Outlook).</descrip></descripGrp><ntig><termGrp><term id="186176">PowerPoint Previewer</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1951322">PowerPoint पूर्वावलोकनकर्ता</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8718_73755_1225829"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The primary access protocol for Active Directory. LDAP is an industry-standard protocol, established by the Internet Engineering Task Force (IETF), that allows users to query and update information in a directory service. Active Directory supports both LDAP version 2 and LDAP version 3.</descrip></descripGrp><ntig><termGrp><term id="73755">LDAP</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1225829">एलडिएपी</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8718_73755_487368"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The primary access protocol for Active Directory. LDAP is an industry-standard protocol, established by the Internet Engineering Task Force (IETF), that allows users to query and update information in a directory service. Active Directory supports both LDAP version 2 and LDAP version 3.</descrip></descripGrp><ntig><termGrp><term id="73755">LDAP</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="487368">लाइटवेट डाइरेक्टरी एक्सेस प्रोटोकल</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8718_73756_1225829"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The primary access protocol for Active Directory. LDAP is an industry-standard protocol, established by the Internet Engineering Task Force (IETF), that allows users to query and update information in a directory service. Active Directory supports both LDAP version 2 and LDAP version 3.</descrip></descripGrp><ntig><termGrp><term id="73756">Lightweight Directory Access Protocol</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1225829">एलडिएपी</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8718_73756_487368"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The primary access protocol for Active Directory. LDAP is an industry-standard protocol, established by the Internet Engineering Task Force (IETF), that allows users to query and update information in a directory service. Active Directory supports both LDAP version 2 and LDAP version 3.</descrip></descripGrp><ntig><termGrp><term id="73756">Lightweight Directory Access Protocol</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="487368">लाइटवेट डाइरेक्टरी एक्सेस प्रोटोकल</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8727_306408_488430"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A filter effect in Windows Movie Maker.</descrip></descripGrp><ntig><termGrp><term id="306408">Threshold</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="488430">सँघार</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8732_137331_1880223"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Adds preset visual effects to text on slides. Ranging from subtle to exciting, each scheme usually includes an effect for the slide title and an effect that is applied to bullets or paragraphs on a slide.</descrip></descripGrp><ntig><termGrp><term id="137331">animation scheme</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1880223">एनिमेसन योजना</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8740_117601_1549256"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A brief content of a larger document.</descrip></descripGrp><ntig><termGrp><term id="117601">summary</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1549256">सारांश</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8744_35474_487084"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A standard system control that initiates a command.</descrip></descripGrp><ntig><termGrp><term id="35474">command button</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="487084">आदेशबटन</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8744_35474_487085"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A standard system control that initiates a command.</descrip></descripGrp><ntig><termGrp><term id="35474">command button</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="487085">पुसबटन</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8744_35475_487084"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A standard system control that initiates a command.</descrip></descripGrp><ntig><termGrp><term id="35475">push button</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="487084">आदेशबटन</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8744_35475_487085"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A standard system control that initiates a command.</descrip></descripGrp><ntig><termGrp><term id="35475">push button</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="487085">पुसबटन</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8747_351591_488768"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in Windows that allows users to access and manage printers, multi-function printers, digital cameras and scanners.</descrip></descripGrp><ntig><termGrp><term id="351591">Printing and Imaging Devices</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="488768">छपाइ तथा छवि यन्त्रहरू</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8751_418607_1519153"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To prevent another user from initiating a conversation and from viewing your presence or other information, such as your personal information.</descrip></descripGrp><ntig><termGrp><term id="418607">block</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1519153">छेक्नुहोस्</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8777_24948_486992"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A list in which each item or block of text is preceded by a bullet.</descrip></descripGrp><ntig><termGrp><term id="24948">bulleted list</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="486992">गोली चिन्ह अङ्कित सूची</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8780_100131_487550"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The temporary storage place on Windows where deleted files are transferred and remain until manually emptied and files are permanently deleted, which allows users to retrieve files until that point.</descrip></descripGrp><ntig><termGrp><term id="100131">Recycle Bin</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="487550">रिसाइकल डालो</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8790_232417_488089"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A list of domain names and email addresses that you want to receive messages from. E-mail addresses in Contacts and in the Global Address Book are included in this list by default. People you sent messages to will be added to the list.</descrip></descripGrp><ntig><termGrp><term id="232417">Safe Senders List</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="488089">सुरक्षित प्रेषकको सूची</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8792_359700_1795679"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A field size or data type that can hold positive integer numbers ranging from 0 to 255.</descrip></descripGrp><ntig><termGrp><term id="359700">byte</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1795679">बाइट</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8795_10234_486904"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application that runs on a Simple Network Management Protocol (SNMP) managed device. The agent application is the object of management activities. A computer running SNMP agent software is also sometimes referred to as an agent.</descrip></descripGrp><ntig><termGrp><term id="10234">agent</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="486904">दलाल</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote