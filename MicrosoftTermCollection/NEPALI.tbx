><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="3096702">ग्राहकको डेटा चोरी</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54302_3096554_3096696"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An issue that has potential to result in a customer data breach, including violations of security policies, acceptable use policies, or standard security practices.</descrip></descripGrp><ntig><termGrp><term id="3096554">security incident</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="3096696">सुरक्षासम्बन्धी घटना</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54303_3096555_3096700"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The mitigation of violations of security policies and recommended practices.</descrip></descripGrp><ntig><termGrp><term id="3096555">incident handling</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="3096700">घटना ह्यान्डलिङ</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54304_3096556_3096698"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A security incident that involves the accidental or unauthorized exposure or alteration of customer content and end-user identifiable information (EUII) in Microsoft 365 services.</descrip></descripGrp><ntig><termGrp><term id="3096556">privacy issue</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="3096698">गोपनीयतासम्बन्धी समस्या</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54312_3097234_3097611"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An observable change to the normal behavior of a system, environment, process, workflow or person; any observable occurrence in a system or network.</descrip></descripGrp><ntig><termGrp><term id="3097234">security event</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="3097611">सुरक्षासम्बन्धी घटना</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54313_3097235_3097609"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An automated notification resulting from a detection.</descrip></descripGrp><ntig><termGrp><term id="3097235">security alert</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="3097609">सुरक्षा अलर्ट</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54314_3097236_3097610"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Engagement of the Microsoft incident response team via formal engagement procedures indicating a potential security issue that requires investigation.</descrip></descripGrp><ntig><termGrp><term id="3097236">security escalation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="3097610">सुरक्षासम्बन्धी एस्कलेशन</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54315_3097237_3097605"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A logical analytical process for identifying security-impacting, anomalous, or suspicious activity.</descrip></descripGrp><ntig><termGrp><term id="3097237">detection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="3097605">पत्ता लगाउने कार्य</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54316_3097238_3097608"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An operational issue (i.e. configuration setting, deployment task, etc.) that adversely impacts the security posture of a service.</descrip></descripGrp><ntig><termGrp><term id="3097238">hygiene issue</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="3097608">स्वच्छता मामिला</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54317_3097239_3097607"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A detection, alert, or escalation that incorrectly indicates that malicious activity is occurring.</descrip></descripGrp><ntig><termGrp><term id="3097239">false positive</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="3097607">फल्स पोजिटिभ</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54318_3097240_3097612"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The source of an adverse event that has the potential to impact or create loss to the confidentiality, integrity, and availability of Microsoft services or data.</descrip></descripGrp><ntig><termGrp><term id="3097240">threat</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="3097612">खतरा</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54319_3097241_3097606"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Windows feature and device specification for RGB devices that can be adjusted in the Settings app for Windows users to view and customize their RGB devices.</descrip></descripGrp><ntig><termGrp><term id="3097241">Dynamic Lighting</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="3097606">डायनेमिक लाइटिङ</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5434_119301_1225296"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A location on the horizontal ruler that indicates how far to indent text or where to begin a column of text.</descrip></descripGrp><ntig><termGrp><term id="119301">tab stop</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1225296">ट्याब रोकिने स्थान</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5437_115318_2360594"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A single- or double-digit number associated with telephone numbers, or email or Web addresses, that enables users to quickly access the numbers or addresses.</descrip></descripGrp><ntig><termGrp><term id="115318">speed dial</term><termNote type="partOfSpeech">Noun</ter