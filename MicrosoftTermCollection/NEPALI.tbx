mNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3962_3044409_487423"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A dialog that requires the user to take some action before the focus can switch to another form or dialog box. Dialog boxes and messages are usually modal.</descrip></descripGrp><ntig><termGrp><term id="3044409">modal</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="487423">रीतिविषयक संवाद</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3962_81228_487423"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A dialog that requires the user to take some action before the focus can switch to another form or dialog box. Dialog boxes and messages are usually modal.</descrip></descripGrp><ntig><termGrp><term id="81228">modal dialog</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="487423">रीतिविषयक संवाद</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3967_93870_487524"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To submit content to an online forum for others to see.</descrip></descripGrp><ntig><termGrp><term id="93870">post</term><termNote type="pa