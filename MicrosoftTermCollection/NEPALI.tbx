 of 9 digits used to identify Russian Federation banks for routing transactions.</descrip></descripGrp><ntig><termGrp><term id="1993208">BIK</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2003917">BIK</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34522_1993210_2005699"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Information that identifies banks and bank account holders in France that includes bank codes, branch codes, account number, and name of the account holder.</descrip></descripGrp><ntig><termGrp><term id="1993210">RIB</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2005699">RIB</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34522_1993211_2005699"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Information that identifies banks and bank account holders in France that includes bank codes, branch codes, account number, and name of the account holder.</descrip></descripGrp><ntig><termGrp><term id="1993211">Relevé d'Identité Bancaire</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2005699">RIB</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Prope