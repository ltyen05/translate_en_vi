350_2829395"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of using a “machine” (in most cases computer software) to translate text from one human language to another.</descrip></descripGrp><ntig><termGrp><term id="747350">machine translation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2829395">स्वतः रूपान्तरण</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20752_747355_1225501"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A pencil tool that works with texture and simulates a real life pencil in stroke.</descrip></descripGrp><ntig><termGrp><term id="747355">natural pencil</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1225501">प्राकृतिक पेन्सिल</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20754_747357_1225502"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Windows feature that enables users to easily roll back their PC to an earlier good state while keeping their data safe.</descrip></descripGrp><ntig><termGrp><term id="747357">System Recovery</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1225502">प्रणाली पुनर् स्थापना</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2077_149214_1225243"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A view on a calendar that displays items such as meetings and events from left to right on a time scale and that can incorporate items from multiple calendars.</descrip></descripGrp><ntig><termGrp><term id="149214">timeline</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1225243">समयरेखा</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20781_747562_2846041"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In a call queue, a method of sending calls to agents whereby incoming calls ring all call agents one by one, from the beginning of the call agent list. If an agent dismisses or does not pick up a call, the call will ring the next agent and will try all agents until it is picked up or times out.</descrip></descripGrp><ntig><termGrp><term id="747562">serial routing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2846041">सिरियल राउटिङ</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20803_3193169_1225503"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process by which multiple authors edit a shared document simultaneously, or collaborate effectively even when they are not online at the same time.</descrip></descripGrp><ntig><termGrp><term id="3193169">coauthoring</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1225503">सह-लेखन</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20803_3193169_3193223"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process by which multiple authors edit a shared document simultaneously, or collaborate effectively even when they are not online at the same time.</descrip></descripGrp><ntig><termGrp><term id="3193169">coauthoring</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="3193223">सह-लेखन</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20803_747620_1225503"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process by which multiple authors edit a shared document simultaneously, or collaborate effectively even when they are not online at the same time.</descrip></descripGrp><ntig><termGrp><term id="747620">co-authoring</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1225503">सह-लेखन</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20803_747620_3193223"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process by which multiple authors edit a shared document simultaneously, or collaborate effectively even when they are not online at the same time.</descrip></descripGrp><ntig><termGrp><term id="747620">co-authoring</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="3193223">सह-लेखन</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20805_1043088_1454209"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A client-side cache for documents that are stored on Web servers. Documents are seamlessly replicated from this local cache, and uploaded to servers as required, enabling faster and more robust file access.</descrip></descripGrp><ntig><termGrp><term id="1043088">Office Document Cache</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1454209">Office Document Cache</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20805_747622_1454209"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A client-side cache for documents that are stored on Web servers. Documents are seamlessly replicated from this local cache, and uploaded to servers as required, enabling faster and more robust file access.</descrip></descripGrp><ntig><termGrp><term id="747622">Microsoft Office Document Cache</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1454209">Office Document Cache</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2081_30138_1225244"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To modify the value of a property or attribute.</descrip></descripGrp><ntig><termGrp><term id="30138">change</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1225244">परिवर्तन</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20839_747785_1225504"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that provides access to gallery of frequently-used actions with the touch of a button. Users can customize the gallery to execute a combination of operations in one click.</descrip></descripGrp><ntig><termGrp><term id="747785">Quick Steps</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1225504">सिघ्र चरणहरु</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20840_747989_1454210"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A frame that contains text, shapes, pictures, or other content. A slide is a digital equivalent to a traditional film slide.</descrip></descripGrp><ntig><termGrp><term id="747989">slide</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1454210">स्लाइड</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20843_748066_2497579"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Windows tool used to capture a screen shot, or snip, of any object on the screen, and then annotate, save, or share the image.</descrip></descripGrp><ntig><termGrp><term id="748066">Snipping Tool</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2497579">स्निपिङ उपकरण</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20848_748169_1225505"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To mark an email conversation so that all current and future messages in the conversation are automatically moved to the Deleted Items folder.</descrip></descripGrp><ntig><termGrp><term id="748169">ignore</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1225505">बेवास्ता गर्नुहोस्</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20849_748170_1225506"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A special control that shows pictures, names and titles of people who are attending a meeting, or who are the recipients of an email message.</descrip></descripGrp><ntig><termGrp><term id="748170">Attendee/Recipient List</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1225506">सहभागी/प्राप्तकर्ता सूची</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20851_1140414_2818589"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of people who can answer calls on behalf of someone else.</descrip></descripGrp><ntig><termGrp><term id="1140414">team-call group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2818589">ट्रेस</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20852_748234_2953850"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A call to a call group that rings the group owner and call group simultaneously. When a member of the group answers the call, the other members get a notification with the status of the call.</descrip></descripGrp><ntig><termGrp><term id="748234">group call</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2953850">सामूहिक कल</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20854_748237_1880526"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user's work day hours as specified in Microsoft Office Outlook by the day of the week and the start and end times.</descrip></descripGrp><ntig><termGrp><term id="748237">working hours</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1880526">कार्य समयहरू</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20855_748246_2926682"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To create an indication that the user has an incoming call.</descrip></descripGrp><ntig><termGrp><term id="748246">ring</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2926682">घण्टी दि