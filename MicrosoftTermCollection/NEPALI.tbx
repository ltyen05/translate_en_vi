compress, or pull out, files from a compressed form. When you extract a file, an uncompressed copy of the file is placed in the folder you specify. The original file remains in the compressed folder. Compressed files frequently have a .zip file name extension.</descrip></descripGrp><ntig><termGrp><term id="155717">extract</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2015487">झिक्नुहोस्</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52360_2955572_2995359"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Database Excel function that returns the average of selected database entries.</descrip></descripGrp><ntig><termGrp><term id="2955572">DAVERAGE</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2995359">DAVERAGE</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52361_2955573_2995360"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Date and time Excel function that converts a serial number to a day of the month.</descrip></descripGrp><ntig><termGrp><term id="2955573">DAY</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2995360">DAY</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52362_2955574_2995361"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Date and time Excel function that returns the number of days between two dates.</descrip></descripGrp><ntig><termGrp><term id="2955574">DAYS</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2995361">DAYS</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52363_2955575_2995362"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Date and time Excel function that calculates the number of days between two dates based on a 360-day year.</descrip></descripGrp><ntig><termGrp><term id="2955575">DAYS360</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2995362">DAYS360</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52364_2955576_2995363"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Financial Excel function that returns the depreciation of an asset for a specified period by using the fixed-declining balance method.</descrip></descripGrp><ntig><termGrp><term id="2955576">DB</term><termNote type="pa