</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53225_3153774_3053629"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The cross-industry experience app in Microsoft Teams that provides seamless scheduling, analytics, and premium experiences for business-to-customer meetings, bringing together current virtual appointment experiences into one single entry point.</descrip></descripGrp><ntig><termGrp><term id="3153774">Virtual Appts</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="3053629">भर्चुअल अपोइन्टमेन्टहरू</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53226_3031837_3032146"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The legacy version of School Data Sync.</descrip></descripGrp><ntig><termGrp><term id="3031837">School Data Sync (classic)</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="3032146">विद्यालय डेटा सिंक (क्लासिक)</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53227_3031838_3032145"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The device marketplace in the Microsoft Teams Admin Center that drives discovery and adoption of Teams devices from Teams Admin Center marketplace.</descrip></descripGrp><ntig><termGrp><term id="3031838">Microsoft Teams device store</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="3032145">Microsoft Teams यन्त्रको स्टोर</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53235_3033414_3033762"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The simulator for ARDK head-mounted displays that runs on Windows PCs and requires a physical + connected Samsung phone.</descrip></descripGrp><ntig><termGrp><term id="3033414">ARDK Simulator</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="3033762">ARDK सिमुलेटर</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53236_3033415_3033761"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The application for ARDK users that provides the software platform for ARDK features like hand tracking and eye tracking.</descrip></descripGrp><ntig><termGrp><term id="3033415">ARDK Platform</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="3033761">ARDK प्लेटफर्म</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntr