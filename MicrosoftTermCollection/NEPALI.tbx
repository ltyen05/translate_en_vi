 navigation pane that shows users where they are in a document.</descrip></descripGrp><ntig><termGrp><term id="1624320">reading position indicator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1880779">पाठन सूचक</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31805_1624320_1880780"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A visual effect in the navigation pane that shows users where they are in a document.</descrip></descripGrp><ntig><termGrp><term id="1624320">reading position indicator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1880780">पाठन स्थिति सूचक</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31806_1624321_1880781"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A marker in the ruler that aligns with the current guide position and enables users to add, edit, or delete a guide from within the ruler.</descrip></descripGrp><ntig><termGrp><term id="1624321">ruler guide marker</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1880781">रूलर निर्देशक चिन्हक</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSe