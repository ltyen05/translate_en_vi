ionary definition for the selected word or words.​​</descrip></descripGrp><ntig><termGrp><term id="2425780">Definition</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2430349">परिभाषा</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42761_2425781_2430355"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Learning Tools feature that provides users synonyms for the selected word or words.​​</descrip></descripGrp><ntig><termGrp><term id="2425781">Synonyms</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2430355">पर्यायवाची</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42762_2425782_2430352"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Learning Tools feature that shows the user a visual representation of the selected word or words.</descrip></descripGrp><ntig><termGrp><term id="2425782">Picture</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2430352">तस्विर</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelect