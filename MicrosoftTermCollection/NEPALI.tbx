ipGrp><descrip type="definition">The Microsoft Office application—for use by both consumer and commercial users—that provides access to email, a personal calendar, group scheduling, task management, and collaboration applications via a web browser, running on Microsoft Exchange Server.</descrip></descripGrp><ntig><termGrp><term id="2234183">Outlook on the web</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2249657">वेबमा Outlook</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38466_2234183_3132095"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft Office application—for use by both consumer and commercial users—that provides access to email, a personal calendar, group scheduling, task management, and collaboration applications via a web browser, running on Microsoft Exchange Server.</descrip></descripGrp><ntig><termGrp><term id="2234183">Outlook on the web</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="3132095">वेबका लागि Outlook</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38466_3131793_2249657"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft Office application—for use by both consumer and commercial users—that provides access to email, a personal calendar, group scheduling, t