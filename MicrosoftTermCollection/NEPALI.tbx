termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1454207">ग्लो</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19508_660023_1225473"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To display an object.</descrip></descripGrp><ntig><termGrp><term id="660023">show</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1225473">देखाउनुहोस्</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1951_169268_1880310"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A log backup taken from a possibly damaged database to capture the log that has not yet been backed up. A tail-log backup is taken after a failure in order to prevent work loss.</descrip></descripGrp><ntig><termGrp><term id="169268">tail-log backup</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1880310">तल्लो-लग ब्याकअप</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19515_660033_2963689"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The gradient of a curve at a point. You can modify a curve that is part of a path object by using the control handles that represent the tangent of the curve.</descrip></descripGrp><ntig><termGrp><term id="660033">tangent</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2963689">स्पर्शरेखा</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19538_660183_1795712"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file that stores an image as graphical objects (lines, circles, polygons) rather than as pixels. Metafiles preserve an image more accurately than pixels when the image is resized.</descrip></descripGrp><ntig><termGrp><term id="660183">metafile</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1795712">मेटाफाइल</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19542_660559_1795672"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A page that you can assign to another page to create multiple layers in a drawing.</descrip></descripGrp><ntig><termGrp><term id="660559">background page</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1795672">पृष्ठभूमि</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19542_660560_1795672"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A page that you can assign to another page to create multiple layers in a drawing.</descrip></descripGrp><ntig><termGrp><term id="660560">background</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1795672">पृष्ठभूमि</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1958_184137_1454117"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A control that allows users to digitally sign a form or document.</descrip></descripGrp><ntig><termGrp><term id="184137">signature line</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1454117">हस्ताक्षर रेखा</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19686_670514_1225474"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The size of the finished page of a printed publication, after trimming.</descrip></descripGrp><ntig><termGrp><term id="670514">page size</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1225474">पृष्ठ साइज</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19687_670515_1225475"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The size of the sheet of paper on which you print the publication, before trimming.</descrip></descripGrp><ntig><termGrp><term id="670515">paper size</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1225475">कागज साइज</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19689_670553_1225476"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A word or string of characters in a formula that represents a cell, range of cells, formula, or constant value.</descrip></descripGrp><ntig><termGrp><term id="670553">defined name</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1225476">परिभाषित गरिएको नाम</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19690_670554_1225477"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A name for an Excel table, which is a collection of data about a particular subject that is stored in records (rows) and fields (columns).</descrip></descripGrp><ntig><termGrp><term id="670554">table name</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1225477">टेबुल नाम</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19695_671377_1880516"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A display mode that shows as much content as possible by hiding elements such as navigation and toolbars.</descrip></descripGrp><ntig><termGrp><term id="671377">full-screen mode</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1880516">पूरा-स्क्रिन ढाँचा</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="197_93813_487522"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An orientation where the long dimension of a rectangular area (for example, screen, photo, or paper) is vertical.​</descrip></descripGrp><ntig><termGrp><term id="93813">portrait orientation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="487522">पोर्ट्रेट पृष्ठविन्यास</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id=