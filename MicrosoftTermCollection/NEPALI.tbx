"27587_1387436_1427515"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that lists files downloaded from the Internet, shows the location of each downloaded file, and allows the user to pause downloads, open files, and take other actions.</descrip></descripGrp><ntig><termGrp><term id="1387436">Download Manager</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1427515">डाउनलोड प्रबन्धक</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27588_1387437_1427529"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A client-server program accessed over a network that uses a web browser as the interface for the end user.</descrip></descripGrp><ntig><termGrp><term id="1387437">web application</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1427529">वेब अनुप्रयोग</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27588_1406417_1427529"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A client-server program accessed over a network that uses a web browser as the interface for the end user.</descrip></descripGrp><ntig><termGrp><term id="1406417">web app</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="142752