al ruler that allows users to draw straight ink and align shapes against​ it.</descrip></descripGrp><ntig><termGrp><term id="2454174">Ruler</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2456295">रूलर</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43325_2454194_2456297"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tool that can positioned within content so that users can align objects and ink straight lines.</descrip></descripGrp><ntig><termGrp><term id="2454194">virtual ruler</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2456297">भर्चुअल रूलर</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43350_2455378_2483421"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A series of characters used to verify an account.</descrip></descripGrp><ntig><termGrp><term id="2455378">verification code</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2483421">प्रमाणीकरण कोड</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43370_2457378_2463467"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office feature that recognizes hand-drawn inked shapes and converts them into computer-generated looking shapes and that provides support for diagram making, shape manipulation and that provides shape information.</descrip></descripGrp><ntig><termGrp><term id="2457378">Ink to shape</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2463467">इंक टू सेप</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43372_2457380_2463460"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Outlook view that leaves emails formatted like classic email threads.</descrip></descripGrp><ntig><termGrp><term id="2457380">Classic</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2463460">क्लासिक</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43374_2490692_2501619"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Outlook view that highlights emails that are part of a thread and then shows that thread as a conversation.</descrip></descripGrp><ntig><termGrp><term id="2490692">Conversational</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2501619">वार्तालापयोग्य</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43393_2457752_2463465"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Editor feature that detects incorrect inflection and suggests corrections.</descrip></descripGrp><ntig><termGrp><term id="2457752">Incorrect Inflection</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2463465">गलत विभक्ति</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43394_2457753_2463463"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Editor feature that detect unnatural collocation and suggests more natural phrasing.</descrip></descripGrp><ntig><termGrp><term id="2457753">Commonly Confused Phrases</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2463463">सामान्यत अस्पष्ट वाक्यांशहरू</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43395_2457779_2463468"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Editor feature that detects errors in infinitive verb usage and suggests corrections.</descrip></descripGrp><ntig><termGrp><term id="2457779">Use of Plain Verb Form</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2463468">प्लेन क्रियापदको प्रयोग</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43396_2457780_2463462"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Editor feature that prompts users to use a comma after a greeting if it is omitted.</descrip></descripGrp><ntig><termGrp><term id="2457780">Comma After Greetings</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2463462">अभिवादपछि अल्पविराम</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43397_2457781_2463459"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Editor feature that detects errors in the capitalization of the months March and May and prompts the user to correct the errors.</descrip></descripGrp><ntig><termGrp><term id="2457781">Capitalization of March and May</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2463459">मार्च र मे को क्यापिटलाइजेसन</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun