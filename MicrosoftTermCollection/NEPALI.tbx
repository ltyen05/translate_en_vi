tOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1454175">सुरू मिति</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16927_629486_3057035"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user-defined description of a particular device.</descrip></descripGrp><ntig><termGrp><term id="629486">device name</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="3057035">यन्त्रको नाम</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16963_629993_1951326"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A unique view for displaying appointments, tasks, and other information in the form of a Web page. You can customize the Outlook Today page for your organization, or for individuals or groups within your organization, to display the information most relevant to them.</descrip></descripGrp><ntig><termGrp><term id="629993">Outlook Today</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1951326">Outlook आज</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="170_502935_1225220"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A part of the user interface dedicated to a particular purpose, such as "instant message area."</descrip></descripGrp><ntig><termGrp><term id="502935">area</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1225220">क्षेत्र</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1700_122674_1454114"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of viewing and updating the actual progress of tasks so that you can see progress across time, evaluate slippage of tasks, compare scheduled or baseline data to actual data, and check the completion percentage of tasks and your project.</descrip></descripGrp><ntig><termGrp><term id="122674">tracking</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1454114">ट्रयाकिङ्</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1701_130254_1795742"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The programming language designed at Microsoft that was derived from BASIC and that was designed to enable the easy development of visual applications and components in Windows.</descrip></descripGrp><ntig><termGrp><term id="130254">Visual Basic</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1795742">Visual Basic</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1701_370712_1795742"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The programming language designed at Microsoft that was derived from BASIC and that was designed to enable the easy development of visual applications and components in Windows.</descrip></descripGrp><ntig><termGrp><term id="370712">VB</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1795742">Visual Basic</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1703_142906_1225236"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A line added to a chart that makes it easier to view and evaluate data.</descrip></descripGrp><ntig><termGrp><term id="142906">gridline</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1225236">ग्रिडलाइन</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1706_3257_486847"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A program that invokes other programs in order to accomplish its tasks.</descrip></descripGrp><ntig><termGrp><term id="3257">script</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="486847">स्क्रिप्ट</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1707_81769_487429"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The action of pressing and releasing one of the mouse buttons.</descrip></descripGrp><ntig><termGrp><term id="81769">mouse click</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="487429">माउस क्लिक</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17153_639951_2600413"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method of authentication by which the client in a client-server communication proves its identity to the server.</descrip></descripGrp><ntig><termGrp><term id="639951">client authentication</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2600413">ग्राहक प्रमाणीकरण</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></lan