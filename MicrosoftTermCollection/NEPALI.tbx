58">CA प्रमाणपत्र</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20621_727659_2699458"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A certificate that identifies the certification authority (CA) that issues server and client authentication certificates to the servers and clients that request these certificates.</descrip></descripGrp><ntig><termGrp><term id="727659">signature certificate</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2699458">CA प्रमाणपत्र</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20621_748022_2699458"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A certificate that identifies the certification authority (CA) that issues server and client authentication certificates to the servers and clients that request these certificates.</descrip></descripGrp><ntig><termGrp><term id="748022">site certificate</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2699458">CA प्रमाणपत्र</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2065_80862_487422"><langSet xml:lang="en-US"><descripGrp><descrip type="defini