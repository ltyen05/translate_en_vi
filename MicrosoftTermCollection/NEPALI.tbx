">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6317_262430_488236"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A security method used by wireless networks. WPA encrypts the information that is sent between computers on a wireless network and authenticates users to help ensure that only authorized people can access the network.</descrip></descripGrp><ntig><termGrp><term id="262430">WPA</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="488236">Wi-Fi संरक्षित पहुँच</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6317_262430_488237"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A security method used by wireless networks. WPA encrypts the information that is sent between computers on a wireless network and authenticates users to help ensure that only authorized people can access the network.</descrip></descripGrp><ntig><termGrp><term id="262430">WPA</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="488237">डब्लुपिए</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6319_343640_488718"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of managing business and/or social contacts in order to follow up, track conversations, etc.</descrip></descripGrp><ntig><termGrp><term id="343640">contact management</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="488718">सम्पर्क व्यवस्थापन</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6333_184278_2487244"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A BIOS developed to enable system-related information, such as information about hardware, to be gathered from computers on a network.</descrip></descripGrp><ntig><termGrp><term id="184278">SMBIOS</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2487244">SMBIOS</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6333_184279_2487244"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A BIOS developed to enable system-related information, such as information about hardware, to be gathered from computers on a network.</descrip></descripGrp><ntig><termGrp><term id="184279">system management BIOS</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2487244">SMBIOS</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6349_345311_488721"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method of arranging data based on the order of specified information. For example, records sorted by class would list all records within a class before moving to records in the next class.</descrip></descripGrp><ntig><termGrp><term id="345311">sorting</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="488721">श्रेणीबद्ध</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6350_276560_488354"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The utility in Windows Vista that presents a view of all PCs, devices, and printers on the network, and is significantly faster and more reliable than My Network Places in Windows XP.</descrip></descripGrp><ntig><termGrp><term id="276560">Network Explorer</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="488354">सञ्जाल एक्सप्लोरर</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6352_152788_2858152"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method by which a client receives a stream, during which he/she cannot control the stream.</descrip></descripGrp><ntig><termGrp><term id="152788">broadcast</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2858152">ब्रोडकास्ट</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6362_99210_2963688"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A number that can be represented in a number system with a given base, such as the decimal system, by a finite or infinite sequence of digits and a radix point. For example, 1.1 is a real number, as is 0.33333....</descrip></descripGrp><ntig><termGrp><term id="99210">real number</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2963688">वास्तविक संख्या</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6374_58539_1225308"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A domain controller that holds a copy of the global catalog for the forest.</descrip></descripGrp><ntig><termGrp><term id="58539">global catalog server</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1225308">विश्वव्यापी विवरणिका सर्भर</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6378_7117_1795666"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An entry in either a securable object's discretionary access control list (DACL) or an object's system access control list (SACL). In a DACL, the entry grants or denies permissions to a user or group. In a SACL, the entry specifies which security events to audit for a particular user or group or controls the Windows Integrity Level for the object.</descrip></descripGrp><ntig><termGrp><term id="7117">access control entry</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1795666">एसिइ</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6378_7119_1795666"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An entry in either a securable object's discretionary access control list (DACL) or an object's system access control list (SACL). In a DACL, the entry grants or denies permissions to a user or group. In a SACL, the entry specifies which security events to audit for a particular user or group or controls the Windows Integrity Level for the object.</descrip></descripGrp><ntig><termGrp><term id="7119">ACE</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1795666">एसिइ</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6381_141638_1880519"><langSet xml:lang="en-US"><descripGrp><des