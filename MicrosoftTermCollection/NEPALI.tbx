ermNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5874_101275_1880195"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A form of statistical analysis used for forecasting. Regression analysis estimates the relationship between variables so that a given variable can be predicted from one or more other variables.</descrip></descripGrp><ntig><termGrp><term id="101275">regression analysis</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1880195">प्रत्यावृति विश्लेषण</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5876_86775_1795719"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In the Microsoft WOSA (Windows Open System Architecture) structure, an interface providing a common language for Windows applications to gain access to a database on a network.</descrip></descripGrp><ntig><termGrp><term id="86775">ODBC</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1795719">ओडिबिसी</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5876_86776_1795719"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In the Microsoft WOSA (Windows Open System Architecture) structure, an interface providing a common language for Windows applications to gain access to a database on a network.</descrip></descripGrp><ntig><termGrp><term id="86776">Open Database Connectivity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1795719">ओडिबिसी</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5877_144194_1880273"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The name used to represent the same computer on which a TCP/IP message originates. If you access a server-based web site by using http://localhost, the request does not actually go out to the Internet.</descrip></descripGrp><ntig><termGrp><term id="144194">localhost</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1880273">स्थानीय होस्ट</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5890_211335_2335675"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application available in an enterprise to help with particular business and process needs, such as payroll, resource planning, supply chain management, and accounting.</descrip></descripGrp><ntig><termGrp><term id="211335">line-of-business application</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><ter