er profile, which is synchronized with a file server so that multiple PCs can use the same profile settings.</descrip></descripGrp><ntig><termGrp><term id="2114594">profile path</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2217599">प्रोफाइल पाथ</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3732_15888_486932"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The separator between account names and domain names in Internet email addresses.</descrip></descripGrp><ntig><termGrp><term id="15888">at sign</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="486932">एट चिह्न</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3732_318434_486932"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The separator between account names and domain names in Internet email addresses.</descrip></descripGrp><ntig><termGrp><term id="318434">COMMERCIAL AT</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="486932">एट चिह्न</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></term