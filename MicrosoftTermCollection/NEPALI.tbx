</termGrp></ntig></langSet></termEntry><termEntry id="6460_66237_1880180"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of settings that enable users to send, store, and receive email, and that define how to store and use addresses.</descrip></descripGrp><ntig><termGrp><term id="66237">information service</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1880180">जानकारी सेवा</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6474_329880_488678"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A technology allowing users to inject faults into an executable without requiring rebuilding the binary or modifying the source code; thus, providing a means of simulating errors and testing recovery.</descrip></descripGrp><ntig><termGrp><term id="329880">fault injection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="488678">गल्ती अंतक्षेपण</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6475_307228_488435"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The heading for the last Mail Merge step, which allows the user to select how the merged publication or letters are produced.</descrip></descripGrp><ntig><termGrp><term id="307228">Complete the merge</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="gramma