ripGrp><ntig><termGrp><term id="2835544">emergency services</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2837683">आपतकालीन सेवाहरू</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50128_2835552_2837684"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A function - when enabled, Teams retrieves policy and location information from the service and includes that information as part of the emergency call.</descrip></descripGrp><ntig><termGrp><term id="2835552">enhanced emergency services</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2837684">उन्नत आपतकालीन सेवाहरू</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50132_2835563_2837678"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A number that identifies an emergency location.</descrip></descripGrp><ntig><termGrp><term id="2835563">Emergency Location Identification Number</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2837678">ELIN</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></nti