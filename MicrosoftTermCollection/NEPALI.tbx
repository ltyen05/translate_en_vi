h">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51171_2887902_2888166"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A virtual visual effect displayed behind a video call/meeting participant's camera-captured image.</descrip></descripGrp><ntig><termGrp><term id="2887902">background</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2888166">पृष्ठभूमिको प्रभाव</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51172_2887897_2888167"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A meeting with a video stream of its participants.</descrip></descripGrp><ntig><termGrp><term id="2887897">video meeting</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2888167">भिडियोमार्फत गरिने बैठक</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5119_319158_488615"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The distance or period of time between a specified start point and a specified end point. For example, the length of an audio or video clip is usually measured in minutes and seconds.</descrip></descripGrp><ntig><termGrp><term id="319158">length</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="488615">लम्बाइ</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="512_14369_1795668"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of chart that displays the trend of values over time or categories. By displaying the sum of the plotted values, an area chart also shows the relationship of parts to a whole.</descrip></descripGrp><ntig><termGrp><term id="14369">area chart</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1795668">क्षेत्र चित्रपट</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5121_73528_1880183"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of symbolic resolution where a symbol is resolved to a specific software routine during program execution instead of during program compilation, enabling polymorphism in object-oriented programs.</descrip></descripGrp><ntig><termGrp><term id="73528">late binding</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1880183">ढिलो बाइन्डिङ्</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5121_73529_1880183"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of symbolic resolution where a symbol is resolved to a specific software routine during program execution instead of during program compilation, enabling polymorphism in object-oriented programs.</descrip></descripGrp><ntig><termGrp><term id="73529">dynamic binding</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1880183">ढिलो बाइन्डिङ्</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5123_26059_487004"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To store frequently used data values in a special memory subsystem for quick access.</descrip></descripGrp><ntig><termGrp><term id="26059">cache</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="487004">क्यास</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51236_2889600_2889657"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that limits battery charging capacity to 50%, which slows the aging process and prolongs battery longevity.</descrip></descripGrp><ntig><termGrp><term id="2889600">Battery Limit Mode</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2889657">ब्याट्री सीमित गर्ने मोड</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51237_2889601_2889656"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that helps protect a battery from the cumulative negative effects of consistent and recurrent use at high temperatures or high states of charge by monitoring battery conditions continuously and implementing a limited number of permanent reductions in charging voltage if these adverse conditions are detected.</descrip></descripGrp><ntig><termGrp><term id="2889601">Battery Lifespan Saver</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2889656">ब्याट्री लाइफस्प्यान सेभर</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5127_340084_488713"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To add new text, objects or cells without overwriting existing data.</descrip></descripGrp><ntig><termGrp><term id="340084">insert</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="488713">घुसाउनुहोस्</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5128_319431_488624"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to characters that are evenly slanted to the right or in the direction of text flow.</descrip></descripGrp><ntig><termGrp><term id="319431">italic</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="488624">तेर्सो</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5129_415567_487228"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An action or occurrence to which a program might respond. Examples include state changes, data transfers, key presses, and mouse movements.</descrip></descripGrp><ntig><termGrp><term id="415567">program event</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="487228">घटना</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5129_51961_487228"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An action or occurrence to which a program might respond. Examples include state changes, data transfers, key presses, and mouse movements.</descrip></descripGrp><ntig><termGrp><term id="51961">event</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="487228">घटना</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51301_2891089_2891330"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Slovenian national holiday celebrated on June 25 to commemorate Slovenia's declaration of independence from Yugoslavia in 1991.</descrip></descripGrp><ntig><termGrp><term id="2891089">Statehood Day</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2891330">स्टेटहुड डे</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51302_2891211_2891331"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The national holiday in Bosnia and Herzegovina celebrated on November 25 to commemorate the day in 1943 on which ZAVNOBiH, the Anti-Fascist Council of Bosnia and Herzegovina, adopted a resolution to declare the country/region an equal community of Muslims, Serbs, and Croats.</descrip></descripGrp><ntig><termGrp><term id="2891211">Statehood Day (Bosnia and Herzegovina)</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2891331">स्टेटहुड डे (बोस्निया र हेर्जेगोभिना)</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51303_2891233_2891332"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Czech national holiday celebrated on September 28 to commemorate the day in 935 on which St. Wenceslas, patron of the Czech state, was murdered by his brother.</descrip></descripGrp><ntig><termGrp><term id="2891233">Czech Statehood Day (St. Wenceslas Day)</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2891332">चेक स्टेटहुड डे (सेन्ट वेन्स्लास डे)</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51304_2891239_2891324"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Argentinian national holiday celebrated on June 20 to commemorate the Argentine flag and its creator, Manuel Belgrano.</descrip></descripGrp><ntig><termGrp><term id="2891239">Flag Day</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2891324">फ्ल्याग डे</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51305_2891254_2891327"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The supplementary holiday day that may be granted during years in which Argentina's Flag Day occurs on a Tuesday or a Thursday and is used to create a four-day weekend.</descrip></descripGrp><ntig><termGrp><term id="2891254">Flag Day (bridge)</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2891327">फ्ल्याग डे (ब्रिज)</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51306_2891255_2891325"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Mexican national holiday celebrated on February 24 to commemorate past and current flags of Mexico.</descrip></descripGrp><ntig><termGrp><term id="2891255">Flag Day</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2891325">फ्ल्याग डे</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51307_2891256_2891326"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The national holiday in Poland celebrated on May 2 to commemorate the raising of the Polish flag over the Victory Column at the end of the Battle of Berlin in 1945.</descrip></descripGrp><ntig><termGrp><term id="2891256">Flag Day</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2891326">फ्ल्याग डे</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51308_2891257_2891328"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Azerbaijan national holiday celebrated on November 9 to commemorate the adoption of the Flag of Azerbaijan on November 9, 1918.</descrip></descripGrp><ntig><termGrp><term id="2891257">National Flag Day</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2891328">नेशनल फ्ल्याग डे</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51309_2891258_2891329"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The day on which the Azerbaijan National Flag Day is celebrated if the official holiday itself falls on a weekend.</descrip></descripGrp><ntig><termGrp><term id="2891258">National Flag Day (Observed)</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2891329">नेशनल फ्ल्याग डे (मनाइने)</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5131_159863_487911"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of detecting and splitting video content into separate clips. Clips are created by Windows Movie Maker when there is a significant change from one frame to another.</descrip></descripGrp><ntig><termGrp><term id="159863">clip creation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="487911">क्लिप सिर्जना</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51323_2892217_2893213"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To prevent a UI element such as an error, notification, button, or a visual feature such as line numbers or page margins, from appearing to the end user.</descrip></descripGrp><ntig><termGrp><term id="2892217">suppress</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2893213">रोक्नु</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51330_2893119_2893206"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Implies that the artifact (object or activity) or some of its characteristics deviate from what is considered ‘normal’; typically a statistical outlier.</descrip></descripGrp><ntig><termGrp><term id="2893119">anomalous</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2893206">असंगत</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51331_2893120_2893211"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A number calculated to let the customer know how vulnerable devices in their organization are.</descrip></descripGrp><ntig><termGrp><term id="2893120">exposure score</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2893211">जोखिमसम्बन्धी स्कोर</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51338_2893964_2893977"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Microsoft 365 Teams background effect that is limited only to uploading the user's own images.</descrip></descripGrp><ntig><termGrp><term id="2893964">custom background</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2893977">आफूले चाहेअनुसारको पृष्ठभूमि</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51339_2893965_2893978"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Xbox Live matchmaking service that groups players based on user information and the request for any users who want to play together.</descrip></descripGrp><ntig><termGrp><term id="2893965">SmartMatch</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2893978">SmartMatch</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51341_2894028_2894089"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">​The next iteration of the Authenticator app in which users can save and automatically fill passwords, addresses, and payment info on mobile devices and computers (via browser extension).</descrip></descripGrp><ntig><termGrp><term id="2894028">Microsoft Autofill</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2894089">Microsoft को स्वतः जानकारी भर्ने सुविधा</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51343_2894031_2894088"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature of the Windows Clock app that allows the user to set a timer for a period of focus time.</descrip></descripGrp><ntig><termGrp><term id="2894031">Focus sessions</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2894088">ध्यान केन्द्रित गर्ने सत्रहरू</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51347_2894037_2894090"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The possibility for a person to input text in Windows with their voice (aka dictation).</descrip></descripGrp><ntig><termGrp><term id="2894037">voice typing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2894090">बोलेर टाइप गराउने सुविधा</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51349_2894217_2894365"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The international holiday celebrated on March 8 that honors women and is commemorated in various ways around the world, including as a public holiday, a day of protest, or as a celebration of womanhood.</descrip></descripGrp><ntig><termGrp><term id="2894217">International Women's Day</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2894365">अन्तर्राष्ट्रिय महिला दिवस</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51350_2894218_2894367"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Vietnamese public holiday celebrated on April 30 to commemorate the day in 1975 when North Vietnamese and Việt Cộng forces captured Saigon (now Ho Chi Minh City), signaling the end of the Vietnam War and the beginning of the reunification process.</descrip></descripGrp><ntig><termGrp><term id="2894218">Reunification Day</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2894367">रियुनिफिकेशन डे</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51351_2894219_2894370"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The day on which the Vietnamese holiday Reunification Day is celebrated if the official holiday itself falls on a weekend.</descrip></descripGrp><ntig><termGrp><term id="2894219">Reunification Day (Observed)</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2894370">रियुनिफिकेशन डे (मनाइने)</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51352_2894246_2895197"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An account from a social identity provider, such as Facebook or Google.</descrip></descripGrp><ntig><termGrp><term id="2894246">social account</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2895197">सामाजिक सञ्जालको खाता</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51364_2894612_3024178"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The transport layer network protocol based on User Datagram Protocol (UDP), which can improve the performance of web applications that currently use TCP.</descrip></descripGrp><ntig><termGrp><term id="2894612">QUIC</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="3024178">QUIC</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51369_2894964_2895003"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The tool that allows customers to compare their EOP policies settings against Microsoft's recommended settings for EOP and Office 365 ATP security.</descrip></descripGrp><ntig><termGrp><term id="2894964">Configuration Analyzer</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2895003">कन्फिगरेशन विश्लेषक</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51379_2895318_2895357"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The application of high quality touchscreen controls to games designed to be played with a controller or mouse/keyboard.</descrip></descripGrp><ntig><termGrp><term id="2895318">touch adaptation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2895357">स्पर्शलाई अनुकूल बनाउने सुविधा</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></ter