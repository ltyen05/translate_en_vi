</termGrp></ntig></langSet></termEntry><termEntry id="7201_147134_1225320"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">independent attributes associated with items, or members, in an OLAP cube. For example, if city items have size and population properties stored in the server cube, a PivotTable report can display the size and population of each city.</descrip></descripGrp><ntig><termGrp><term id="147134">property fields</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1225320">गुण फाँटहरु</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7204_2066257_2072464"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A notification for sharing items, such as calendars, documents or folders, with others.</descrip></descripGrp><ntig><termGrp><term id="2066257">invitation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2072464">निमन्त्रणा</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7204_2066257_2072484"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A notification for sharing items, such as calendars, documents or folders, with others.</descrip></descripGrp><ntig><termGrp><term id="2066257">invitation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet>