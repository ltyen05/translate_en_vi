crosoft मिडिया फाउन्डेसन</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2244_142353_1454118"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An individual box or button with which users enter information on an electronic form.</descrip></descripGrp><ntig><termGrp><term id="142353">form control</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1454118">फारम नियन्त्रण</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2246_2573055_2578676"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A quality of a product to be directly or indirectly usable by individuals with disabilities.</descrip></descripGrp><ntig><termGrp><term id="2573055">a11y</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2578676">a11y</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2246_2573055_486879"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A quality of a product to be directly or indirectly usable by individuals with disabilities.</descrip></descripGrp><ntig><termGrp><term id="2573055">a11y</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="486879">उपलब्धता</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2246_7442_2578676"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A quality of a product to be directly or indirectly usable by individuals with disabilities.</descrip></descripGrp><ntig><termGrp><term id="7442">accessibility</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2578676">a11y</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2246_7442_486879"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A quality of a product to be directly or indirectly usable by individuals with disabilities.</descrip></descripGrp><ntig><termGrp><term id="7442">accessibility</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="486879">उपलब्धता</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22460_1045690_2926618"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A calendar for a group.</descrip></descripGrp><ntig><termGrp><term id="1045690">group calendar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2926618">समूहको पात्रो</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22470_1045704_1519522"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method of blocking access to websites based on their content. For example, In Windows Live Family Safety, parents can specify a filtering level, such as Strict or Basic, for their child.</descrip></descripGrp><ntig><termGrp><term id="1045704">web filtering</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1519522">वेब फिल्टर गर्दै</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22490_1045759_1225630"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An audio or video file that you rent from an online store, typically for a monthly fee.</descrip></descripGrp><ntig><termGrp><term id="1045759">subscription file</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1225630">सदस्यता फाइल</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22492_1045783_1225631"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A troubleshooter that performs common maintenance tasks in Windows, such as cleaning up unused files and shortcuts.</descrip></descripGrp><ntig><termGrp><term id="1045783">Maintenance troubleshooter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1225631">समभार समस्यानिवारण</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22493_1045790_1225632"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A troubleshooter that helps find and fix problems about hardware and devices.</descrip></descripGrp><ntig><termGrp><term id="1045790">Hardware and Devices troubleshooter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1225632">हार्डवेयर तथा यन्त्र समस्यानिवारण</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2250_527637_1374692"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to a process, tool, etc. that is enabled by Windows Live.</descrip></descripGrp><ntig><termGrp><term id="527637">powered by Windows Live</term><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1374692">Windows Live बाट संचालित</term>