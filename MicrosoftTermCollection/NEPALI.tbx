grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2578163">परिष्कृत Xbox One X</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45581_2569585_2574784"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft To-Do feature that enables a user to share a list with other users. All users will be able to add and complete to-dos in a shared list.</descrip></descripGrp><ntig><termGrp><term id="2569585">Sharing</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2574784">साझेदारी</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45582_2569597_2574785"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft To-Do feature that enables a user to break down a to-do into smaller components of work or effort.</descrip></descripGrp><ntig><termGrp><term id="2569597">Steps</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2574785">चरणहरू</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45583_2569598_2574757"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The binding process where authentication is one-directional.</descrip></descripGrp><ntig><termGrp><term id="2569598">1-way binding</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2574757">1-वे बाइन्डिङ</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45584_2569599_2574758"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The binding process where authentication goes both ways.</descrip></descripGrp><ntig><termGrp><term id="2569599">2-way binding</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2574758">2-वे बाइन्डिङ</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45585_2569600_2574765"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To remove association from two or more pieces of information.</descrip></descripGrp><ntig><termGrp><term id="2569600">unbind</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2574765">अनबाइन्ड</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45586_2569602_2583004"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft-owned company that has created the world's largest professional network on the Internet.</descrip></descripGrp><ntig><termGrp><term id="2569602">LinkedIn</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2583004">LinkedIn</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45587_2569603_2578680"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An effect that makes an image appear as if drawn with a pencil.</descrip></descripGrp><ntig><termGrp><term id="2569603">pencil effect</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2578680">पेन्सिल प्रभाव</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45591_2570262_2574762"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The methodology, originally developed in the Japanese automotive industry, that uses digital cards to achieve just-in-time delivery and manage the replenishment cycle in a manufacturing process.</descrip></descripGrp><ntig><termGrp><term id="2570262">Kanban</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2574762">कनबान</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4561_319151_488613"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The " character.</descrip></descripGrp><ntig><termGrp><term id="319151">straight quotation mark</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="488613">सीधा उद्धरणचिन्ह</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4565_31042_1765585"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of finalizing a purchase on a website. For example, when customers shop on your website, they may select several items and save them in their shopping basket. When they have finished shopping, they click on a checkout link or graphical button that takes them to an online form where they enter their name, billing address, payment type, and shipping information.</descrip></descripGrp><ntig><termGrp><term id="31042">checkout</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1765585">खरीद समापन</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4566_118879_487636"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A menu that contains commands you can use to manipulate a window or close a program. You click the program icon at the left of the title bar to open this menu. The context menu of a window replaces this menu.</descrip></descripGrp><ntig><termGrp><term id="118879">system menu</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="487636">नियन्त्रणमेनु</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4566_118880_487636"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A menu that contains commands you can use to manipulate a window or close a program. You click the program icon at the left of the title bar to open this menu. The context menu of a window replaces this menu.</descrip></descripGrp><ntig><termGrp><term id="118880">control menu</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="487636">नियन्त्रणमेनु</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4567_232422_1880363"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The container in a navigation pane that contains shortcuts and shortcut groups.</descrip></descripGrp><ntig><termGrp><term id="232422">Shortcuts Pane</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1880363">सर्टकटहरूको फलक</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45689_2575485_2578683"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office feature that allows users to translate words, segments or full texts and that is powered exclusively by the cloud-based Microsoft Translator service.</descrip></descripGrp><ntig><termGrp><term id="2575485">Translator</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2578683">अनुवादक</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4569_116311_487619"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In information processing, fixed or predetermined.</descrip></descripGrp><ntig><termGrp><term id="116311">static</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="487619">तथ्याङ्कित</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45691_2575532_2588194"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An UI element that allows users to adjust the display angle of an object on the screen.</descrip></descripGrp><ntig><termGrp><term id="2575532">angle indicator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2588194">कोण सूचक</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45789_2579453_2584100"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The extension for Cortana that connects users to custom services and solutions. Skills can be invoked on Cortana to perform certain actions, such as checking the user’s bank balance, reading a bed time story, or booking a cab with Uber.</descrip></descripGrp><ntig><termGrp><term id="2579453">Cortana skill</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2584100">Cortana कौशल</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45790_2579456_2584101"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of policy settings that control updates for devices that use Windows 10. With these settings, information technology administrators decide when and which devices receive updates in their organization, and set different schedules for groups of devices. They can also pause updates for individual devices.</descrip></descripGrp><ntig><termGrp><term id="2579456">Windows Update for Business</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2584101">व्यवसायका लागि Windows Update</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45819_2579515_2582470"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Intelligence about current or potential attacks that threaten an organization.</descrip></descripGrp><ntig><termGrp><term id="2579515">cyber threat intelligence</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2582470">साइबर थ्रेट इन्टेलिजेन्स</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45819_2626583_2582470"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Intelligence about current or potential attacks that threaten an organization.</descrip></descripGrp><ntig><termGrp><term id="2626583">cyber intelligence</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2582470">साइबर थ्रेट इन्टेलिजेन्स</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45819_2813435_2582470"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Intelligence about current or potential attacks that threaten an organization.</descrip></descripGrp><nti