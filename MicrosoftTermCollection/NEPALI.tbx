ermNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="3041915">विन्डोड खेल</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53367_3041362_3041916"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Gaming that utilizes a display format in which the game is put into a window that can be moved around and resized.</descrip></descripGrp><ntig><termGrp><term id="3041362">windowed gaming</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="3041916">विन्डोड गेमिङ</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53368_3041363_3041903"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Gaming that utilizes a display format in which the game/application is run in a window at full-screen size without a border, creating the experience of full-screen gaming while also allowing for other overlays on top of the game, similar to the windowed gaming experience.</descrip></descripGrp><ntig><termGrp><term id="3041363">borderless-windowed gaming</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="3041903">बोर्डरलेस-विन्डोड गेमिङ</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet>