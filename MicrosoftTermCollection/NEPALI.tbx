<ntig><termGrp><term id="2060612">पाठ</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20136_702323_1225484"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Extra information displayed to a user while they are composing an email message. MailTips are displayed in an InfoBar, similar to the banner that appears saying "This message has not been sent." MailTips reveal anything that might be unexpected about the delivery or audience of the message, such as recipient validity or Out of Office status or whether the message might not be delivered.</descrip></descripGrp><ntig><termGrp><term id="702323">MailTip</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1225484">पत्र टिप</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20140_702751_1454208"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of shapes arranged in a tree structure that helps analyze and summarize data in a visual, easy-to-understand format. It starts out as a single shape, called a top node, that contains information imported from a worksheet, table, view, or cube.</descrip></descripGrp><ntig><termGrp><term id="702751">PivotDiagram</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1454208">PivotDiagram</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20141_703430_2217603"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A policy that specifies the length of time during which items such as data, documents, builds, and releases are to be retained.</descrip></descripGrp><ntig><termGrp><term id="703430">retention policy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2217603">स्मरण नीति</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20149_704965_1880522"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A sequence of data such as numbers, number and text combinations, dates, or time periods, based on an established pattern and used to automatically fill data into worksheet cells.</descrip></descripGrp><ntig><termGrp><term id="704965">fill series</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1880522">श्रेणी भर्नुहोस्</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20159_707781_2360589"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A communication technology based on short range (4cm or less) wireless data exchange.</descrip></descripGrp><ntig><termG