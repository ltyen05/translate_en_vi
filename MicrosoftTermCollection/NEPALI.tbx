langSet xml:lang="ne-NP"><ntig><termGrp><term id="487106">सम्पर्क</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11748_136786_487743"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A display setting that holds up to 256 specific color entries. Any color palette attached to a picture is by definition an 8-bit palette.</descrip></descripGrp><ntig><termGrp><term id="136786">8-bit color</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="487743">८-बिट रङ</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11757_146879_487836"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The device that communicates between your software program and your printer.</descrip></descripGrp><ntig><termGrp><term id="146879">printer driver</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="487836">मुद्रकचालक</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11758_153847_487883"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An object created with one program and embedded into a document created by another. Embedding the object, rather than simply inserting or pasting it, ensures that the object retains its original format. If you double-click the embedded object, you can edit it with the toolbars and menus from the program used to create it.</descrip></descripGrp><ntig><termGrp><term id="153847">embedded object</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="487883">सन्निविष्ट वस्तु</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11765_2795839_3084886"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Microsoft's antimalware solution that provides next generation protection for desktops, portable computers, and servers.</descrip></descripGrp><ntig><termGrp><term id="2795839">Microsoft Defender Antivirus</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="3084886">Microsoft Defender एन्टिभाइरस</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11765_2795839_3179490"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Microsoft's antimalware solution that provides next generation protection for desktops, portable computers, and servers.</descrip></descripGrp><ntig><termGrp><term id="2795839">Microsoft Defender Antivirus</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="3179490">Defender एन्टिभाइरस</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11765_3178800_3084886"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Microsoft's antimalware solution that provides next generation protection for desktops, portable computers, and servers.</descrip></descripGrp><ntig><termGrp><term id="3178800">Defender Antivirus</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="3084886">Microsoft Defender एन्टिभाइरस</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11765_3178800_3179490"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Microsoft's antimalware solution that provides next generation protection for desktops, portable computers, and servers.</descrip></descripGrp><ntig><termGrp><term id="3178800">Defender Antivirus</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="3179490">Defender एन्टिभाइरस</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11767_140546_1880245"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file containing data where individual field values are separated by a character, such as a comma or a tab.</descrip></descripGrp><ntig><termGrp><term id="140546">delimited text file</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1880245">सीमा निर्धारित पाठ फाइल</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11777_64765_487305"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tool that lets you enter complex characters and symbols, such as those used in East Asian written languages, using a standard keyboard.</descrip></descripGrp><ntig><termGrp><term id="64765">IME</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="487305">आइएमई</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11777_64765_487306"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tool that lets you enter complex characters and symbols, such as those used in East Asian written languages, using a standard keyboard.</descrip></descripGrp><ntig><termGrp><term id="64765">IME</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="487306">आगतविधि सम्पादक</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11777_64766_487305"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tool that lets you enter complex characters and symbols, such as those used in East Asian written languages, using a standard keyboard.</descrip></descripGrp><ntig><termGrp><term id="64766">input method editor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="487305">आइएमई</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11777_64766_487306"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tool that lets you enter complex characters and symbols, such as those used in East Asian written languages, using a standard keyboard.</descrip></descripGrp><ntig><termGrp><term id="64766">input method editor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="487306">आगतविधि सम्पादक</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11782_149770_487863"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A diagram that is used to show areas of overlap between and among elements.</descrip></descripGrp><ntig><termGrp><term id="149770">Venn diagram</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="487863">भेनचित्र</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11795_147980_1795728"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to keyboard settings, document views, user interface objects, languages, etc. for which text is displayed in a right-to-left direction.</descrip></descripGrp><ntig><termGrp><term id="147980">right-to-left</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1795728">आरटिएल</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11795_147980_487846"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to keyboard settings, document views, user interface objects, languages, etc. for which text is displayed in a right-to-left direction.</descrip></descripGrp><ntig><termGrp><term id="147980">right-to-left</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="487846">दायाँबाट बायाँ</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11795_661874_1795728"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to keyboard settings, document views, user interface objects, languages, etc. for which text is displayed in a right-to-left direction.</descrip></descripGrp><ntig><termGrp><term id="661874">RTL</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1795728">आरटिएल</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11795_661874_487846"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to keyboard settings, document views, user interface objects, languages, etc. for which text is displayed in a right-to-left direction.</descrip></descripGrp><ntig><termGrp><term id="661874">RTL</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="487846">दायाँबाट बायाँ</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11797_149448_1225370"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A list that includes the name of the person who originally sent a task request plus the names of everyone who received the task request, reassigned the task to someone else, or chose to keep an updated copy of the task in their task list.</descrip></descripGrp><ntig><termGrp><term id="149448">update list</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1225370">अद्यावधिक सूची</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11798_106558_2105841"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A line printed above, below, or to the side of some element, either to set that item off from the remainder of the page or to improve the look of the page. Footnotes, for example, often appear below a short rule that sets them off from the main text on the page. The thickness of a rule is typically measured in points. (A point is approximately 1/72 inch.)</descrip></descripGrp><ntig><termGrp><term id="106558">rule</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2105841">नियम रेखा</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11798_2085540_2105841"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A line printed above, below, or to the side of some element, either to set that item off from the remainder of the page or to improve the look of the page. Footnotes, for example, often appear below a short rule that sets them off from the main text on the page. The thickness of a rule is typically measured in points. (A point is approximately 1/72 inch.)</descrip></descripGrp><ntig><termGrp><term id="2085540">rule line</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2105841">नियम रेखा</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11799_234773_488141"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows deletion of the files created during hibernation.</descrip></descripGrp><ntig><termGrp><term id="234773">Hibernation File Cleaner</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="488141">हाइबर्नेसन फाइल क्लिनर</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1180_89323_1225231"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To extend over and cover a part of something.</descrip></descripGrp><ntig><termGrp><term id="89323">overlap</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1225231">खप्ट्याउनुहोस्</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11800_118815_1642590"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The information about a computer that's derived from the System Information program.</descrip></descripGrp><ntig><termGrp><term id="118815">system info</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1642590">प्रणाली जानकारी</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11803_89506_2304628"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A role that controls how permissions are set and can grant permissions to others.</descrip></descripGrp><ntig><termGrp><term id="89506">owner</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2304628">मालिक</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11804_118547_487633"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of entities working together to accomplish a task.</descrip></descripGrp><ntig><termGrp><term id="118547">system</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="487633">प्रणाली</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11805_121970_1880213"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The slide that stores information from the design template pertaining to styles on title slides, including placeholder sizes and positions, background design, and color schemes.</descrip></descripGrp><ntig><termGrp><term id="121970">title master</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1880213">शीर्षक मास्टर</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1181_144723_1880276"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Margins of the left page are a mirror image of those of the right page. That is, the inside margins are the same width, and the outside margins are the same width.</descrip></descripGrp><ntig><termGrp><term id="144723">mirror margins</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1880276">मिरर मार्जिनहरू</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11810_210490_488011"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A networking standard that uses cables to provide network access. Ethernet is the most widely installed technology for connecting computers.</descrip></descripGrp><ntig><termGrp><term id="210490">Ethernet</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="488011">इथरनेट</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11820_125350_487671"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A character-encoding standard developed by the Unicode Consortium that represents almost all of the written languages of the world. The Unicode character repertoire has multiple representation forms, including UTF-8, UTF-16, and UTF-32. Most Windows interfaces use the UTF-16 form.</descrip></descripGrp><ntig><termGrp><term id="125350">Unicode</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="487671">युनिकोड</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11821_77656_487401"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of display that uses a liquid compound having a polar molecular structure, sandwiched between two transparent electrodes. When an electric field is applied, the molecules align with the field, forming a crystalline arrangement that polarizes the light passing through it. A polarized filter laminated over the electrodes blocks polarized light. In this way, a grid of electrodes can selectively "turn on" a cell, or a pixel, containing the liquid crystal material, turning it dark.</descrip></descripGrp><ntig><termGrp><term id="77656">LCD</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="487401">एलसिडी</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11821_77656_487402"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of display that uses a liquid compound having a polar molecular structure, sandwiched between two transparent electrodes. When an electric field is applied, the molecules align with the field, forming a crystalline arrangement that polarizes the light passing through it. A polarized filter laminated over the electrodes blocks polarized light. In this way, a grid of electrodes can selectively "turn on" a cell, or a pixel, containing the liquid crystal material, turning it dark.</descrip></descripGrp><ntig><termGrp><term id="77656">LCD</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="487402">लिक्विड क्रिस्टल प्रदर्शन</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11821_77658_487401"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of display that uses a liquid compound having a polar molecular structure, sandwiched between two transparent electrodes. When an electric field is applied, the molecules align with the field, forming a crystalline arrangement that polarizes the light passing through it. A polarized filter laminated over the electrodes blocks polarized light. In this way, a grid of electrodes can selectively "turn on" a cell, or a pixel, containing the liquid crystal material, turning it dark.</descrip></descripGrp><ntig><termGrp><term id="77658">liquid crystal display</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="487401">एलसिडी</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11821_77658_487402"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of display that uses a liquid compound having a polar molecular structure, sandwiched between two transparent electrodes. When an electric field is applied, the molecules align with the field, forming a crystalline arrangement that polarizes the light passing through it. A polarized filter laminated over the electrodes blocks polarized light. In this way, a grid of electrodes can selectively "turn on" a cell, or a pixel, containing the liquid crystal material, turning it dark.</descrip></descripGrp><ntig><termGrp><term id="77658">liquid crystal display</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="487402">लिक्विड क्रिस्टल प्रदर्शन</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1183_346957_488740"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Information that cannot be found or recovered.</descrip></descripGrp><ntig><termGrp><term id="346957">lost data</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="488740">हराएको लगत</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11832_231956_488069"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A reference to a range that spans two or more worksheets in a workbook.</descrip></descripGrp><ntig><termGrp><term id="231956">3-D reference</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="488069">त्रि-आ सन्दर्भ</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11847_23740_486987"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A location in a program at which execution is halted so that a programmer can examine the program's status, the contents of variables, and so on.</descrip></descripGrp><ntig><termGrp><term id="23740">breakpoint</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="486987">विराम बिन्दु</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11859_1468785_2003915"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A unique bank registration number that a bank uses to identify itself.</descrip></descripGrp><ntig><termGrp><term id="1468785">transit number</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelecte