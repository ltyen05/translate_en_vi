/term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53247_3033521_3034356"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The UK bank holiday celebrated on June 3, 2022 to commemorate the 70th anniversary of Queen Elizabeth II's accession to the throne.</descrip></descripGrp><ntig><termGrp><term id="3033521">Platinum Jubilee Bank Holiday</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="3034356">प्लाटिनम जुबिली बैंक बिदा</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5325_145206_487822"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To minimize the duplication of information in a relational database through effective table design.</descrip></descripGrp><ntig><termGrp><term id="145206">normalize</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="487822">सामान्यकरण गर्नुहोस्</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53251_3033532_3034359"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Canadian holiday (colloquially known as Orange Shirt Day) celebrated on September 30 to recognize the legacy of the Canadian Indian residential school system.</descrip></descripGrp><ntig><termGrp><term id="3033532">National Day for Truth and Reconciliation</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="3034359">सत्य र मेलमिलापको रष्ट्रिय दिन</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53252_3033536_3034364"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The US federal holiday celebrated on June 19 to commemorate the emancipation of African-American slaves, celebrated on the anniversary of June 19, 1865, the date of the announcement of General Order No. 3 by Union Army general Gordon Granger proclaiming freedom for slaves in Texas, the last state of the Confederacy with institutional slavery.</descrip></descripGrp><ntig><termGrp><term id="3033536">Juneteenth</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="3034364">जुनटिन्थ</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53254_3033546_3034362"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The day on which the US holiday Juneteenth is celebrated if the official holiday itself falls on a weekend.</descrip></descripGrp><ntig><termGrp><term id="3033546">Juneteenth (Observed)</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singul