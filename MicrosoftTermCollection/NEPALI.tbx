ormed steps with a simple key combination or name.</descrip></descripGrp><ntig><termGrp><term id="77118">macro</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="487393">म्याक्रो</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54050_3080961_3081064"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The argument in the DATEVALUE Excel function that represents a date in an Excel date format, or a reference to a cell that contains text that represents a date in an Excel date format.</descrip></descripGrp><ntig><termGrp><term id="3080961">date_text</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="3081064">डेटा_पाठ</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54051_3080962_3081038"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The argument in an Excel function that specifies a number in the date-time code used by Excel.</descrip></descripGrp><ntig><termGrp><term id="3080962">serial_number</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="3081038">सिरियल_नम्बर</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammatic