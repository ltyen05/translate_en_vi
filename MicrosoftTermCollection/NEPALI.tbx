.</descrip></descripGrp><ntig><termGrp><term id="237193">check in</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1454160">भित्र जाँच्नुहोस्</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12146_227660_488060"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The practice of recording, classifying, summarizing, and reporting the financial consequences of accounting events.</descrip></descripGrp><ntig><termGrp><term id="227660">accounting</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="488060">लेखापालन</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12159_98936_1795727"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The processor in an imagesetter or desktop printer that interprets the commands sent by a printer driver and converts them to a raster or bitmap grid to mark the paper or film.</descrip></descripGrp><ntig><termGrp><term id="98936">Raster Image Processor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1795727">आरआइपी</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12159_98937_1795727"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The processor in an imagesetter or desktop printer that interprets the commands sent by a printer driver and converts them to a raster or bitmap grid to mark the paper or film.</descrip></descripGrp><ntig><termGrp><term id="98937">RIP</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1795727">आरआइपी</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1216_1505033_3114797"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A central repository that stores operations data for long periods of time and is a core component of business intelligence.</descrip></descripGrp><ntig><termGrp><term id="1505033">data warehouse database</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="3114797">डेटा वेयरहाउस</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1216_43204_3114797"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A central repository that stores operations data for long periods of time and is a core component of business intelligence.</descrip></descripGrp><ntig><termGrp><term id="43204">data warehouse</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singul