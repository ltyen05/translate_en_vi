e></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2894091">Windows घडी</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37048_2106697_2187196"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To group very similar photos together in the Photos app, and show only one (the best shot) in the list view of your photos.</descrip></descripGrp><ntig><termGrp><term id="2106697">stack</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2187196">चाङ मिलाउनुहोस्</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37049_2106698_2187197"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of very similar photos that have been grouped together by the Photos app. The app shows only the best photo of the stack in the list view.</descrip></descripGrp><ntig><termGrp><term id="2106698">stack</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2187197">चाङ</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37050_2106699_2187224"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To remove the "stack" association from a group of similar photos that have been stacked together in the Photos app.</descrip></descripGrp><ntig><termGrp><term id="2106699">unstack</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2187224">चाङबाट हटाउनुहोस्</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37054_2781063_2782452"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The limited-day trial for government organizations for the offer for OneDrive for Business that includes Office Online, and that is hosted in the commercial cloud environment.</descrip></descripGrp><ntig><termGrp><term id="2781063">OneDrive for Business with Office on the web (Government Pricing) Trial</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2782452">वेबमा Office सहित OneDrive for Business (सरकारी मूल्य) परीक्षण</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3706_146703_1880289"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The calendar selected in the regional settings in Windows Control Panel, or the system calendar.</descrip></descripGrp><ntig><termGrp><term id="146703">primary calendar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="