2397"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The transfer of a copy of a file from a remote device to a requesting device by means of a modem or network.</descrip></descripGrp><ntig><termGrp><term id="1636617">download</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1662397">डाउनलोड</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32131_1636624_1642936"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process in which Microsoft tests an app to make sure it meets app requirements.</descrip></descripGrp><ntig><termGrp><term id="1636624">validation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1642936">वैधानिकता</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32132_1636625_1642935"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process in which a developer tests an app to make sure it meets app requirements.</descrip></descripGrp><ntig><termGrp><term id="1636625">verification</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1642935">रुजू</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelecte