7">Drag and drop</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2454616">तान्नुहोस् र छोड्नुहोस</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43302_2452358_2454621"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that provides users asset of standard style options found in Office products.</descrip></descripGrp><ntig><termGrp><term id="2452358">Styles</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2454621">शैलीहरू</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43304_2452360_2454614"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tool that creates extra space for adding additional notes and comments in between content blocks.​</descrip></descripGrp><ntig><termGrp><term id="2452360">Add Space</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2454614">स्पेस थप्नुहोस्</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43305_2452362_2456296"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The OneNote add-in that allows users to stylize notes with virtual stickers.​</descrip></descripGrp><ntig><termGrp><term id="2452362">Stickers</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2456296">स्टीकरहरू</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43308_2452382_3177791"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A part of an image or photo obtained using the cutout tool.</descrip></descripGrp><ntig><termGrp><term id="2452382">cutout</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="3177791">कटआउट</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43309_2452425_2454620"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Word navigation layout that presents content in two columns next to each other and that shows progress as user advances to the right.​​</descrip></descripGrp><ntig><termGrp><term id="2452425">Side to Side</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2454620">साइड देखि साइडसम्म</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><t