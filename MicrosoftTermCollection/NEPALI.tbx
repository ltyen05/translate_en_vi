us on what is deemed to be best for the customer.</descrip></descripGrp><ntig><termGrp><term id="3056784">Customer Advocacy Group</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="3056920">ग्राहक वकालत समूह</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53689_3056785_3056917"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A badge displayed on a profile image to identify a champion.</descrip></descripGrp><ntig><termGrp><term id="3056785">champion badge</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="3056917">च्याम्पियनको ब्याज</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5369_34870_487078"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A special symbol that breaks a column when inserted into a document. It ends the current column and starts the next column.</descrip></descripGrp><ntig><termGrp><term id="34870">column break</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="487078">स्तम्भ विराम</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammatical