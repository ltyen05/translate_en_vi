, a list of data values, all of the same type, any element of which can be referenced by an expression consisting of the array name followed by an indexing expression. Arrays are part of the fundamentals of data structures, which, in turn, are a major fundamental of computer programming.</descrip></descripGrp><ntig><termGrp><term id="14573">array</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2277894">विन्यास</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15635_75737_1225418"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To place information from storage into memory for processing, if it is data, or for execution, if it is program code.</descrip></descripGrp><ntig><termGrp><term id="75737">load</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1225418">लोड गर्नुहोस्</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15641_231839_2776343"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The "digital persona" by which other users recognize and interact with you.</descrip></descripGrp><ntig><termGrp><term id="231839">identity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2776343">डिजिटल परिचय</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15641_231839_488067"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The "digital persona" by which other users recognize and interact with you.</descrip></descripGrp><ntig><termGrp><term id="231839">identity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="488067">परिचय</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15641_2772978_2776343"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The "digital persona" by which other users recognize and interact with you.</descrip></descripGrp><ntig><termGrp><term id="2772978">digital identity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2776343">डिजिटल परिचय</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15641_2772978_488067"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The "digital persona" by which other users recognize and interact with you.</descrip></descripGrp><ntig><termGrp><term id="2772978">digital identity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="488067">परिचय</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15649_1177110_2699465"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process wherein data in memory or on disk is unintentionally changed, with its meaning thereby altered or obliterated.</descrip></descripGrp><ntig><termGrp><term id="1177110">data corruption</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2699465">डाटा दुषित हुने</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15649_40131_2699465"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process wherein data in memory or on disk is unintentionally changed, with its meaning thereby altered or obliterated.</descrip></descripGrp><ntig><termGrp><term id="40131">corruption</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2699465">डाटा दुषित हुने</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1565_116540_487621"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To halt a process or action, typically without restoring the