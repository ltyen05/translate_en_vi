></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="3013374">एनोटेट गर्नु</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52991_3012677_3013405"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The link in Teams that allows a user to access information about a meeting.</descrip></descripGrp><ntig><termGrp><term id="3012677">Info</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="3013405">जानकारी</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52992_3012678_3013375"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The link in Teams that allows a user to access and add applications like Forms or PowerApps.</descrip></descripGrp><ntig><termGrp><term id="3012678">Apps</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="3013375">एपहरू</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52993_3012679_3013409"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The high-fidelity music mode in Teams that offers a richer sound experience when the user transmits music to listeners.</descrip></descripGrp><ntig><termGrp><term id="3012679">Music</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="3013409">संगीत</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52994_3012680_3013413"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The link in Teams that allows users to access a participant roster which shows a list of people present in a meeting.</descrip></descripGrp><ntig><termGrp><term id="3012680">People</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="3013413">मानिसहरू</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53001_3012995_3014489"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An element that acts as supporting evidence that helps in increasing the confidence of the match. It can be a regular expression with or without a checksum validation, keyword list, keyword dictionary.</descrip></descripGrp><ntig><termGrp><term id="3012995">supporting element</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="3014489">समर्थक सामग्री</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammati