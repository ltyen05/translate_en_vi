ion">The Microsoft app that helps deskless workers and their supervisors manage work routines, contacts and communication, document work-related events, and disseminate announcements.</descrip></descripGrp><ntig><termGrp><term id="2455371">StaffHub</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2430351">Microsoft StaffHub</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42766_2426026_2431745"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A unique identification number assigned to a custom translation system created through the Microsoft Translator Hub.</descrip></descripGrp><ntig><termGrp><term id="2426026">hub category identifier</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2431745">हब कोटी अभिज्ञापक</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42778_2427816_2431748"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Learning Tools feature that translates the selected word or words into another language.​​</descrip></descripGrp><ntig><termGrp><term id="2427816">Translate</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2431748">अनुवाद</term><termNote type="geographical