onvert a table to text, or where you want new rows or columns to begin when you convert text to a table.</descrip></descripGrp><ntig><termGrp><term id="148370">separator character</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1225419">विभाजक क्यारेक्टर</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15861_87814_2596355"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Running low on memory.</descrip></descripGrp><ntig><termGrp><term id="87814">out of memory</term><termNote type="partOfSpeech">Adverb</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2596355">स्मृतिको बाहिर</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Adverb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15886_319136_487292"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ‐ character, used to break a word between syllables at the end of a line or to separate the parts of a compound word.</descrip></descripGrp><ntig><termGrp><term id="319136">HYPHEN</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="487292">योजकचिन्ह</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></