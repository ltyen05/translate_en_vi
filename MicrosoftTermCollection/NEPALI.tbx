ntally reveals content in handwriting, or incrementally hides the content if going in reverse.</descrip></descripGrp><ntig><termGrp><term id="2410885">Ink Replay</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2416741">इंक रिप्ले</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42562_2410889_2416742"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The button that converts inked math equations into digital equations.</descrip></descripGrp><ntig><termGrp><term id="2410889">Ink to Math</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2416742">गणितमा इंक</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42564_2410899_2416747"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A program capability to play text as spoken words.</descrip></descripGrp><ntig><termGrp><term id="2410899">text-to-speech</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2416747">पाठ-देखि-वाचन</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termG