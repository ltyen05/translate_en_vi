157418">access violation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="487901">पहुँच-उल्लङ्‍घन</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11983_381857_1880404"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An email folder with associated retention, archive, or expiration policies that are applied to its contents. Organizations can facilitate policy enforcement by providing such folders for users to classify email messages.</descrip></descripGrp><ntig><termGrp><term id="381857">Managed E-mail Folder</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1880404">व्यवस्थित इ-मेल फोल्डर</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11985_115735_1225857"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A database query and programming language widely used for accessing, querying, updating, and managing data in relational database systems.</descrip></descripGrp><ntig><termGrp><term id="115735">SQL</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1225857">एसक्युएल</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSel