="9148_61333_487283"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Text that does not display in the normal view of a document's content.</descrip></descripGrp><ntig><termGrp><term id="61333">hidden text</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="487283">लुकाएको पाठ</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9153_298005_1880397"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows users to see and interact with E-mail messages and their attachments side by side in the reading pane.</descrip></descripGrp><ntig><termGrp><term id="298005">Attachment Previewing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1880397">संलग्न पूर्वावलोकन</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9160_187435_1549245"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A page that presents a categorical view of select Help content that the user can browse. Depending on the edition, multiple How Do I pages might be available for use.</descrip></descripGrp><ntig><termGrp><term id="187435">How do I</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1549245">मैले कसरी</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9169_32178_1795190"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A font display technology that dramatically improves font display resolution so that letters on the computer screen appear smooth, not jagged. ClearType dramatically improves the readability of text on color LCD monitors with a digital interface, such as those found in laptops and high-quality flat-panel desktop displays.</descrip></descripGrp><ntig><termGrp><term id="32178">ClearType</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1795190">ClearType</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="917_264897_1432622"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The program that enables users to send and receive business card information digitally and shares data storage with Outlook.</descrip></descripGrp><ntig><termGrp><term id="264897">Microsoft Office InterConnect</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1432622">Microsoft Office इन्टरकनेक्ट</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9201_185833_3013414"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A common menu item that enables the user to select how the contents of the current program are displayed.</descrip></descripGrp><ntig><termGrp><term id="185833">View</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="3013414">दृश्य</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9204_494727_2858170"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A UI container that docks to a pane, can be part of a panel group, and is represented by a tab.</descrip></descripGrp><ntig><termGrp><term id="494727">panel</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="2858170">प्यानल</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9206_85254_1880187"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A space that is used to prevent multiple words from breaking if they fall at the end of a line.</descrip></descripGrp><ntig><termGrp><term id="85254">nonbreaking space</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1880187">अविच्छिन्न स्थान</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9219_88069_1225342"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A domain controller that has been assigned one or more special roles in an Active Directory domain.</descrip></descripGrp><ntig><termGrp><term id="88069">operations master</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1225342">सञ्चालन मास्टर</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="922_1177130_487095"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process for removing redundant data from a digital media file or stream to reduce its size or the bandwidth used.</descrip></descripGrp><ntig><termGrp><term id="1177130">data compaction</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="487095">खाँदिएको</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="922_37103_487095"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process for removing redundant data from a digital media file or stream to reduce its size or the bandwidth used.</descrip></descripGrp><ntig><termGrp><term id="37103">compression</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="487095">खाँदिएको</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9221_141157_1880251"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A fundamental data type that holds double-precision floating-point numbers. It's stored as a 64-bit number ranging in value from approximately -1.797E308 to -4.940E-324 (negative), from 4.94E-324 to 1.797E308 (positive), and 0.</descrip></descripGrp><ntig><termGrp><term id="141157">Double data type</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1880251">दोब्बर लगत प्रकार</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9238_116710_487622"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A precompiled collection of SQL statements and optional control-of-flow statements stored under a name and processed as a unit. They are stored in an SQL database and can be run with one call from an application.</descrip></descripGrp><ntig><termGrp><term id="116710">stored procedure</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="487622">भण्डार गरिएको कार्यविधि</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9239_145825_1225343"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A worksheet view that displays the areas to be printed and the locations of page breaks. The area to be printed is displayed in white, automatic page breaks appear as dashed lines, and manual page breaks appear as solid lines.</descrip></descripGrp><ntig><termGrp><term id="145825">page break preview</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1225343">पृष्ठ विच्छेद पूर्वावलोकन</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9241_558509_1225344"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of software functionality designed to solve a specific problem or to provide a new functionality to the user.</descrip></descripGrp><ntig><termGrp><term id="558509">feature</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1225344">सुविधा</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9242_143427_487811"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A field that stores hyperlink addresses.</descrip></descripGrp><ntig><termGrp><term id="143427">hyperlink field</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet 