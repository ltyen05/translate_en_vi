">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55167_3127759_3128248"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft Teams add-on license that allows offices to designate devices as shared devices, including common area phones, Teams displays for hot-desks, and Teams panels for meeting spaces.</descrip></descripGrp><ntig><termGrp><term id="3127759">Teams Shared Devices</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="3128248">Microsoft Teams साझा यन्त्रहरू</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55167_3127759_3128254"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft Teams add-on license that allows offices to designate devices as shared devices, including common area phones, Teams displays for hot-desks, and Teams panels for meeting spaces.</descrip></descripGrp><ntig><termGrp><term id="3127759">Teams Shared Devices</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="3128254">Teams साझा यन्त्रहरू</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55170_3127858_3128247"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Mi