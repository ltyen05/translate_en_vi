000"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A unit of work that is represented to users in the form of buttons, links, and menu items.</descrip></descripGrp><ntig><termGrp><term id="209940">action</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="488000">कार्य</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10994_147111_487838"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To move an item to a higher level within a structure.</descrip></descripGrp><ntig><termGrp><term id="147111">promote</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="487838">प्रवर्धन गर्नुहोस्</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="110_312762_488496"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A service or feature of Windows that enables licensing at the feature level; thereby broadening the distribution and licensing options for retailers, ISVs, and OEMs. New business models may include: trials, subscriptions, gifting, transfers, or pay-for-use.</descrip></descripGrp><ntig><termGrp><term id="312762">Software Licensing Commerce Client</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="488496">सफ्टव