p type="definition">To make a transmission appear to come from a user other than the user who performed the action.</descrip></descripGrp><ntig><termGrp><term id="115576">spoof</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1976692">स्पूफ गर्नुहोस्</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14246_343618_1225396"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A diagramming capability that shows charts in three dimensions.</descrip></descripGrp><ntig><termGrp><term id="343618">3-D effect</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1225396">त्रि-आ प्रभाव</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14256_72076_487344"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To adjust horizontal spacing so that text is aligned evenly along both the left and right margins. Justifying text creates a smooth edge on both sides.</descrip></descripGrp><ntig><termGrp><term id="72076">justify</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="487344">समरेखन गर्नुहोस्</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelec