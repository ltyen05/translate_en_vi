 by the system, after which the operating system is loaded from disk into memory.</descrip></descripGrp><ntig><termGrp><term id="34049">cold start</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="487066">कोल्डबुट</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8922_34049_487067"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A startup process that begins with turning on the computer's power. Typically, a cold boot involves some basic hardware checking by the system, after which the operating system is loaded from disk into memory.</descrip></descripGrp><ntig><termGrp><term id="34049">cold start</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="487067">कोल्डसुरु</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8924_112244_487590"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The command interpreter that is used to pass commands to the operating system.</descrip></descripGrp><ntig><termGrp><term id="112244">shell</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="487590">शेल</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8929_81571_487426"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A device on which images generated by the computer's video adapter are displayed.</descrip></descripGrp><ntig><termGrp><term id="81571">monitor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="487426">मनिटर</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8931_84940_1988787"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of one or more COM objects in a process. A COM object lives in exactly one apartment, in the sense that its methods can legally be directly called only by a thread that belongs to that apartment. Any other thread that wants to call the object must go through a proxy.</descrip></descripGrp><ntig><termGrp><term id="84940">apartment</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1988787">अपार्टमेन्ट</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8945_117177_487627"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An index entry that falls under a more general heading. For example, the index entry "planets" could have the subentries "Mars" and "Venus."</descrip></descripGrp><ntig><termGrp><term id="117177">subentry</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="487627">उपप्रविष्ट</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8949_140209_1944289"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Related data points that are plotted in a chart. Each data series in a chart has a unique color or pattern and is represented in the chart legend. You can plot one or more data series in a chart. Pie charts have only one data series.</descrip></descripGrp><ntig><termGrp><term id="140209">data series</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1944289">लगत शृङ्खला</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8949_1508235_1944289"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Related data points that are plotted in a chart. Each data series in a chart has a unique color or pattern and is represented in the chart legend. You can plot one or more data series in a chart. Pie charts have only one data series.</descrip></descripGrp><ntig><termGrp><term id="1508235">series</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1944289">लगत शृङ्खला</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8960_545680_1880426"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A view of a document as it will appear on the printed page.</descrip></descripGrp><ntig><termGrp><term id="545680">page layout view</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1880426">पृष्ठ सजावट दृश्य</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8960_545691_1880426"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A view of a document as it will appear on the printed page.</descrip></descripGrp><ntig><termGrp><term id="545691">print layout view</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1880426">पृष्ठ सजावट दृश्य</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8961_318125_1943443"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Colors that are directly next to each other on the color wheel. Each color has two analogous colors (one on each side of it).</descrip></descripGrp><ntig><termGrp><term id="318125">analogous colors</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1943443">समान रङहरू</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8983_61675_1880178"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A fixed-disk file system that organizes the disk into volumes, rather than partitions and logical drives. HPFS supports long, mixed-case filenames and extended attributes, and implements several levels of caching, for improved operating-system performance. The IBM OS/2 operating system supports HPFS.</descrip></descripGrp><ntig><termGrp><term id="61675">high performance file system</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1880178">HPFS</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8983_61676_1880178"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A fixed-disk file system that organizes the disk into volumes, rather than partitions and logical drives. HPFS supports long, mixed-case filenames and extended attributes, and implements several levels of caching, for improved operating-system performance. The IBM OS/2 operating system supports HPFS.</descrip></descripGrp><ntig><termGrp><term id="61676">high-performance file system</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1880178">HPFS</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8983_61677_1880178"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A fixed-disk file system that organizes the disk into volumes, rather than partitions and logical drives. HPFS supports long, mixed-case filenames and extended attributes, and implements several levels of caching, for improved operating-system performance. The IBM OS/2 operating system supports HPFS.</descrip></descripGrp><ntig><termGrp><term id="61677">HPFS</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1880178">HPFS</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9010_347945_488759"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group in the data source that can occur more than once. Controls such as repeating sections and repeating tables are bound to repeating groups.</descrip></descripGrp><ntig><termGrp><term id="347945">repeating group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="488759">दोह्याउने समूह</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9025_253693_1795687"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A data type that stores a signed, exact numeric value described as the number of digits appearing before and after the decimal point, with a maximum of 29 total digits. All possible digits cannot be represented if you are using the maximum number of digits.</descrip></descripGrp><ntig><termGrp><term id="253693">Decimal</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1795687">डेसिमल</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9026_44196_487147"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of rewriting parts of a file to contiguous sectors on a hard disk to increase the speed of access and retrieval.</descrip></descripGrp><ntig><termGrp><term id="44196">defragmentation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="487147">डिफ्राग्मेन्टेसन</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9028_143088_487809"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The blank area between two or more columns of text or between two facing pages in a publication.</descrip></descripGrp><ntig><termGrp><term id="143088">gutter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="487809">गटर</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9030_146463_1880287"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In a 2-D chart, the area bounded by the axes, including all data series. In a 3-D chart, the area bounded by the axes, including the data series, category names, tick-mark labels, and axis titles.</descrip></descripGrp><ntig><termGrp><term id="146463">plot area</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1880287">प्लट क्षेत्र</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9035_13104_486920"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A small piece of code that can be transported over the Internet and executed on the recipient's machine. The term is especially used to refer to such programs as they are embedded in line as objects in HTML documents on the World Wide Web.</descrip></descripGrp><ntig><termGrp><term id="13104">applet</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="486920">एप्लेट</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9064_232419_1880361"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The alternate calendar that is selected from within Outlook. The secondary calendar appears when dual calendar support is enabled.</descrip></descripGrp><ntig><termGrp><term id="232419">secondary calendar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="1880361">दोस्रो पात्रो</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9067_3665_486852"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A software package that replaces an existing version of a product or a feature with a newer and/or more powerful or sophisticated version of the same product or feature. The upgrade process typically leaves existing customer data and preferences intact while replacing the existing software with the newer version.</descrip></descripGrp><ntig><termGrp><term id="3665">upgrade</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ne-NP"><ntig><termGrp><term id="486852">स्तरवृद्धि गर्नुहोस्</term><termNote type="geographicalUsage">NPL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9067_3665_486853"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A software package that replaces an existing version of a product or a feature with a newer and/or more powerful or sophisticated version of the same product or feature. The upgrade process typically leaves existing customer data and preferences intact while replacing the existing software with the newer version.</descrip></descr