 xml:lang="en-US"><descripGrp><descrip type="definition">To direct a call.</descrip></descripGrp><ntig><termGrp><term id="694377">route</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="2787937">ródaigh</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20093_694568_1979380"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To accept an incoming telephone call.</descrip></descripGrp><ntig><termGrp><term id="694568">answer</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="1979380">freagair</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20099_694715_1260991"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To execute a program.</descrip></descripGrp><ntig><termGrp><term id="694715">run</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="1260991">rith</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20104_694766_1979355"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A picture made by combining a series of photos into one large picture to provide a complete view of an area or location that cannot fit in a single shot.</descrip></descripGrp><ntig><termGrp><term id="694766">panoramic photo</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="1979355">lánléargas</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20104_694768_1979355"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A picture made by combining a series of photos into one large picture to provide a complete view of an area or location that cannot fit in a single shot.</descrip></descripGrp><ntig><termGrp><term id="694768">panorama</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="1979355">lánléargas</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2012_357288_514483"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A graphical control used to display text.</descrip></descripGrp><ntig><termGrp><term id="357288">label</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="514483">lipéad</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20125_700660_2300272"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Meeting an organization's various obligations, which may arise from laws, regulations, rules, and many other legal instruments, such as court judgments, litigation, and even contracts. Specific and important examples of these obligations include the Sarbanes-Oxley Act (SOX) and the California Law on Notice of Security Breach, formerly known as SB-1386. These regulatory obligations may be created by many sources, such as national and local governments and from industry-specific oversight groups, such as the Payment Card Industry Data Security Standards.</descrip></descripGrp><ntig><termGrp><term id="700660">compliance</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="2300272">comhlíonadh</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20126_700661_2300273"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Person responsible for ensuring that an organization complies with the various regulations and standards that are imposed by government and other regulatory bodies.</descrip></descripGrp><ntig><termGrp><term id="700661">compliance officer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="2300273">oifigeach comhlíonta</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20127_700662_1260992"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of communications (email, IM, text messaging, voice mail, and so on) between two or more participants.</descrip></descripGrp><ntig><termGrp><term id="700662">conversation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="1260992">comhrá</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20129_1810820_1520124"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A short alphanumeric message that is sent between mobile phones or devices using the SMS protocol.</descrip></descripGrp><ntig><termGrp><term id="1810820">text</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="1520124">teachtaireacht téacs</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20129_1810820_2065877"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A short alphanumeric message that is sent between mobile phones or devices using the SMS protocol.</descrip></descripGrp><ntig><termGrp><term id="1810820">text</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="2065877">SMS</term><t