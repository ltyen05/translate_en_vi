ingular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="513683">Eagarthóir Airíonna</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1337_297179_514102"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A form of trojan that causes systems equipped with modems to dial phone numbers without the consent of the user. In most cases, the phone numbers dialed are premium rate numbers which result in unexpected charges on the affected user's phone bill.</descrip></descripGrp><ntig><termGrp><term id="297179">dialer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="514102">Traíoch diaileora</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13370_33049_512773"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To end an application's relationship with an open file so that the application will no longer be able to access the file without opening it again.</descrip></descripGrp><ntig><termGrp><term id="33049">close</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="512773">dún</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13372_413712_1260906"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A symbol that is displayed beside a paragraph in outline view. You can use the symbol to display or hide subordinate levels of text and to reorganize text quickly.</descrip></descripGrp><ntig><termGrp><term id="413712">outline symbol</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="1260906">siombail imlíne</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13374_359204_1095577"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A complete Web site stored in a named subdirectory of the top-level Web site.</descrip></descripGrp><ntig><termGrp><term id="359204">subsite</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="1095577">Fo-shuíomh</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13374_359204_1095578"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A complete Web site stored in a named subdirectory of the top-level Web site.</descrip></descripGrp><ntig><termGrp><term id="359204">subsite</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="1095578">foghréasán</term><termNote type="geographicalUsage">IRL</termNote><term