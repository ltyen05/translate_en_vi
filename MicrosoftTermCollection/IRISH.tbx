rip></descripGrp><ntig><termGrp><term id="1032196">Windows Live Events</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="1373558">Imeachtaí Windows Live</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22243_1032209_1520141"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The link that appears above an incomplete content set and leads to the full list of items. For example, when a content module displays items 1–6, a "View all" link in line with the module label leads to a webpage that lists all items. The items that are available in preview are redundantly available in the list of all items, which may be paginated.</descrip></descripGrp><ntig><termGrp><term id="1032209">View all</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="1520141">Féach gach</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22246_1034324_1519751"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A piece of feedback left by someone viewing content on a site.</descrip></descripGrp><ntig><termGrp><term id="1034324">comment</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="1519751">nóta tráchta</term><termNote type="geographica