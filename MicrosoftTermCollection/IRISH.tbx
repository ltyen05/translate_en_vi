gSet xml:lang="en-US"><descripGrp><descrip type="definition">A precompiled collection of SQL statements and optional control-of-flow statements stored under a name and processed as a unit. They are stored in an SQL database and can be run with one call from an application.</descrip></descripGrp><ntig><termGrp><term id="116710">stored procedure</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="513332">gnás stóráilte</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9239_145825_1260867"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A worksheet view that displays the areas to be printed and the locations of page breaks. The area to be printed is displayed in white, automatic page breaks appear as dashed lines, and manual page breaks appear as solid lines.</descrip></descripGrp><ntig><termGrp><term id="145825">page break preview</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="1260867">réamhamharc ar bhriseadh leathanaigh</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9241_558509_1260868"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of software functionality designed to solve a specific problem or to provide a new functionality to the user.</descrip></descripGrp><ntig><termGrp><term id="558509">feature</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="1260868">gné</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9242_143427_513521"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A field that stores hyperlink addresses.</descrip></descripGrp><ntig><termGrp><term id="143427">hyperlink field</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="513521">réimse hipearnasc</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9248_268851_514033"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Files that are used to help detect harmful or unwanted software and to prevent it from installing or running on your computer.</descrip></descripGrp><ntig><termGrp><term id="268851">definitions</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="514033">sainmhínithe</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9255_298014_514119"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A button on the message toolbar that compares the names in the To, Cc, and Bcc boxes against the names in the Address Book and against those contact folders that you've specified as Outlook Address Books.</descrip></descripGrp><ntig><termGrp><term id="298014">Check Names</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="514119">Seiceáil Ainmneacha</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9260_321121_514346"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user interface element that provides users with a quick and easy way to navigate across a large group of opened Web pages by providing the user with a visual representation of all of the opened thumbnails. Through this visualization, the user can easily spot and select a desired thumbnail.</descrip></descripGrp><ntig><termGrp><term id="321121">Quick Tabs</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="514346">Mearchlibeanna</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9273_144584_513529"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A "document that contains a set of separate files or subdocuments.</descrip></descripGrp><ntig><termGrp><term id="144584">master document</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="513529">máistirdhoiciméad</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9274_1507614_1522613"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A string that is used to identify a user or entity to an operating system, directory service, or distributed system. For example, in Windows® integrated authentication, a login name uses the form "DOMAIN\username."</descrip></descripGrp><ntig><termGrp><term id="1507614">login name</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="1522613">ainm logála isteach</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9274_76690_1522613"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A string that is used to identify a user or entity to an operating system, directory service, or distributed system. For example, in Windows® integrated authentication, a login name uses the form "DOMAIN\username."</descrip></descripGrp><ntig><termGrp><term id="76690">login ID</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="1522613">ainm logála isteach</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9275_237771_513914"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of column that displays the results of mathematical or logical operations or expressions instead of stored data.</descrip></descripGrp><ntig><termGrp><term id="237771">calculated column</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="513914">colún áirithe</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9278_318317_514269"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An audio CD that contains both audio and other multimedia content.</descrip></descripGrp><ntig><termGrp><term id="318317">enhanced audio CD</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="514269">CD fuaime breisithe</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="928_177550_2297761"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Windows Server 2003 technology that supports creation of single point-in-time shadow copies - also known as snapshots - of single or multiple volumes without impacting file server performance. Volume Shadow Copy Service also supports backups of open files.</descrip></descripGrp><ntig><termGrp><term id="177550">Volume Shadow Copy Service</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></