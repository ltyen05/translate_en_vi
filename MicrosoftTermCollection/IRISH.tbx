/termNote></termGrp></ntig></langSet></termEntry><termEntry id="53611_3052168_3053433"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in Outlook that empowers individuals to set up personal appointment booking pages to eliminate the back-and-forth of scheduling 1:1 meetings while still maintaining control of their calendar.</descrip></descripGrp><ntig><termGrp><term id="3052168">Bookings with me</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="3053433">Bookings liomsa</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53612_3052180_3053473"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app in Microsoft Teams that allows organizations to create basic check-in forms for a range of processes (end of shift, store evaluations, recurring action items) based off out-of-the-box tools.</descrip></descripGrp><ntig><termGrp><term id="3052180">Updates</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="3053473">Nuashonruithe</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53613_3052187_3053472"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app that connects business owners with payment providers in Microsoft Teams and helps them receive payments from customers while they register for a webinar and during a meeting.</descrip></descripGrp><ntig><termGrp><term id="3052187">Payments</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="3053472">Íocaíochtaí</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53614_3052229_3053437"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The free Microsoft-owned domain used by default for some automatic user creation and domain transfer scenarios when the tenant hasn't added a custom domain.</descrip></descripGrp><ntig><termGrp><term id="3052229">fallback domain</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="3053437">fearann cúltaca</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53615_3052230_3053462"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A message that admins can have sent to their users through an automated system, and which can be made to appear as notifications inside Office apps, as Windows notifications, on the Windows desktop, and on other specific surfaces.</descrip></descripGrp><ntig><termGrp><term id="3052230">organizational message</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="3053462">teachtaireacht eagraíochtúil</term><termNote type="geographi