ermEntry><termEntry id="7878_236973_513891"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature of Parental Controls that allows users to block Web sites that they don't want to view.</descrip></descripGrp><ntig><termGrp><term id="236973">Web restrictions</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="513891">srianta Gréasáin</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7885_48295_512911"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To move an item on the screen (1) by touching the item on a screen and then sliding the finger across the screen or (2) by pressing and holding down the left mouse button while moving the mouse.</descrip></descripGrp><ntig><termGrp><term id="48295">drag</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="512911">tarraing</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7904_234775_513852"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Visual impairment that results in great reduction in vision capabilities and that cannot be aided by glasses or contact lenses. It could, however, be aided by special devices.</descrip></descripGrp><ntig><termGrp><term id="234775">low vision</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></n