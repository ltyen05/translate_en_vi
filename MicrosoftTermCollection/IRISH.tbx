m id="2016663">scéim cumhachta</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16161_94159_2016664"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of preset power-management options. For example, you can set elapsed times for putting your computer on standby and for turning off your monitor and hard disk. You save these settings as a named power scheme.</descrip></descripGrp><ntig><termGrp><term id="94159">power scheme</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="2016664">plean cumhachta</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16175_1508829_1818587"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An area at the left side in some dialog boxes, such as Save As, Open, and Insert Picture that contains shortcuts to various folders.</descrip></descripGrp><ntig><termGrp><term id="1508829">Places Bar</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="1818587">Barra Áiteanna</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16175_477172_1818587"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An area at the left side in some dialog boxes, such as Save As, Open, and Insert Picture that contains shortcuts to various folders.</descrip></descripGrp><ntig><termGrp><term id="477172">My Places bar</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="1818587">Barra Áiteanna</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16176_143109_1818124"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A margin setting that adds extra space to the side or top margin of a document you plan to bind. A gutter margin ensures that text isn't obscured by the binding.</descrip></descripGrp><ntig><termGrp><term id="143109">gutter margin</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="1818124">imeall gáitéir</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16183_1608214_2787938"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The server-based report generation environment for enterprise, Web-enabled reporting functionality that allows users to create reports that draw content from a variety of data sources, publish reports in various formats, and centrally manage security and subscriptions.</descrip></descripGrp><ntig><termGrp><term id="1608214">Microsoft SQL Server Reporting Services</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="2787938">SSRS</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16183_169566_2787938"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The server-based report generation environment for enterprise, Web-enabled reporting functionality that allows users to create reports that draw content from a variety of data sources, publish reports in various formats, and centrally manage security and subscriptions.</descrip></descripGrp><ntig><termGrp><term id="169566">SQL Server Reporting Services</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="2787938">SSRS</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16183_169567_2787938"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The server-based report generation environment for enterprise, Web-enabled reporting functionality that allows users to create reports that draw content from a variety of data sources, publish reports in various formats, and centrally manage security and subscriptions.</descrip></descripGrp><ntig><termGrp><term id="169567">SSRS</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="2787938">SSRS</term><termNote type="geographicalUsage">IRL</termNote><termN