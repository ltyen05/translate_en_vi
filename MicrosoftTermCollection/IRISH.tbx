44694">Microsoft Corporation</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28358_1585472_2297511"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A connection established between on-premises and cloud email systems that not only allows users to use email from either location with the same set of credentials, but provides a richer management experience.</descrip></descripGrp><ntig><termGrp><term id="1585472">Exchange hybrid deployment</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="2297511">imlonnú hibrideach Exchange</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2839_37265_1540982"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of instructions in some computer language intended to be executed on a computer so as to perform some task. The term usually implies a self-contained entity, as opposed to a routine or a library.</descrip></descripGrp><ntig><termGrp><term id="37265">computer program</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="1540982">ríomhchlár</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28437_1487680_1944082"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A hyperlink on an outside domain that points into the user's domain.</descrip></descripGrp><ntig><termGrp><term id="1487680">incoming link</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="1944082">nasc isteach</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2846_297003_514096"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A trojan that captures and/or transmits passwords to an attacker.</descrip></descripGrp><ntig><termGrp><term id="297003">password stealer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="514096">gadaí pasfhocal</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28462_1488403_2297562"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that allows the preservation of items in user mailboxes and the protection of the items from deletion by users or automated processes.</descrip></descripGrp><ntig><termGrp><term id="1488403">Litigation Hold</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="2297562">coinneáil le haghaidh dlíthíochta</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28541_1489075_1931715"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A service under which customers can acquire and redeem points for certain online services and digital products.</descrip></descripGrp><ntig><termGrp><term id="1489075">Microsoft Points</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="1931715">Pointí Microsoft</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28593_1489612_2074558"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process of repeated installation of a product, feature, tool, kit, pack, etc.</descrip></descripGrp><ntig><termGrp><term id="1489612">reinstallation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="2074558">athshuiteáil</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="286_157947_2700633"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">On Windows-based computers, a user account that is a member of the computer’s local Administrators group or a member of a group that is a member of the local Administrators group, such as the Domain Admins group in a Windows domain. This is the first account that is created when you install an operating system on a new workstation, stand-alone server, or member server. By default, this account has the highest level of administrative access to the local computer.</descrip></descripGrp><ntig><termGrp><term id="157947">administrator account</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="2700633">cuntas riarthóra</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="286_157947_2700637"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">On Windows-based computers, a user account that is a member of the computer’s local Administrators group or a member of a group that is a member of the local Administrators group, such as the Domain Admins group in a Windows domain. This is the first account that is created when you install an operating system on a new workstation, stand-alone server, or member server. By default, this account has the highest level of administrative access to the local computer.</descrip></descripGrp><ntig><termGrp><term id="157947">administrator account</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="2700637">riarthóir réamhshocraithe</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="286_157947_2700638"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">On Windows-based computers, a user account that is a member of the comput