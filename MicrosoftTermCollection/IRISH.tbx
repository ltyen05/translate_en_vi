3_512764"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A small x or other sign that appears in the check box if the option represented by the box is selected.</descrip></descripGrp><ntig><termGrp><term id="30983">check mark</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="512764">ticmharc</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8882_187096_1095414"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To retrieve a writable copy of a file or project from a source repository. This locks the file for editing to prevent others from overwriting or editing it inadvertently.</descrip></descripGrp><ntig><termGrp><term id="187096">check out</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="1095414">seiceáil amach</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8885_210477_1818203"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A floating task pane that allows users to view and customize specific paragraph and text style properties.</descrip></descripGrp><ntig><termGrp><term id="210477">style inspector</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="1818203">cigire stíle</term><termNote type="geogr