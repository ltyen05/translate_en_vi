ification message</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="2297619">teachtaireacht fógra</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22668_1053572_2297624"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A part of a schema that defines the representation of a resource in ILM "2".</descrip></descripGrp><ntig><termGrp><term id="1053572">object type</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="2297624">cineál oibiachta</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2267_318112_1095477"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A server built upon and integrated with the Microsoft Windows SharePoint Services platform to enable Web-based use of InfoPath form templates, by rendering editable InfoPath forms in HTML in the browser.</descrip></descripGrp><ntig><termGrp><term id="318112">InfoPath Forms Services</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="1095477">Seirbhísí Fhoirmeacha InfoPath</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plur