peech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20542_725950_2193976"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of visual elements and sounds for your computer desktop or device User Interface. A theme determines the look of the various visual elements of your User Interface, such as windows, icons, fonts, and colors, and it can include sounds.</descrip></descripGrp><ntig><termGrp><term id="725950">desktop theme</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="2193976">téama</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20543_760171_2279905"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Internet Explorer feature that allows users to surf the Web without leaving a browsing history, cookies or other information on the PC so they can do online banking on a shared computer, for example.</descrip></descripGrp><ntig><termGrp><term id="760171">InPrivate</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="2279905">InPrivate</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20560_725996_1769437"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The service for wireless products that allows users to send and receive brief messages consisting of text and numbers to and from mobile phones and devices.</descrip></descripGrp><ntig><termGrp><term id="725996">SMS</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="1769437">SMS</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20595_726386_2020425"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A virtual community that provides people with opportunities to interact (via blogs, chats, newsgroups, webcasts, user groups, and forums) with Microsoft employees, experts, and peers in order to share knowledge and news about Microsoft technology.</descrip></descripGrp><ntig><termGrp><term id="726386">Microsoft community</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="2020425">comhphobal Microsoft</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20600_726850_1260994"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The sound made by a mobile device or other phone to indicate an incoming call or message, for example, a series of beeps or an audio recording.</descrip></descripGrp><ntig><termGrp><term id="726850">ringtone</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="1260994">ton clingthe</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20602_727015_2323099"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A calendar view that displays all scheduled items.</descrip></descripGrp><ntig><termGrp><term id="727015">Agenda view</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="2323099">amharc ar an gclár oibre</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20606_727019_1954796"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An alert that is set by the user to be activated at a particular time.</descrip></descripGrp><ntig><termGrp><term id="727019">alarm</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="1954796">aláram</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20612_727401_1260995"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An authentication device that digitally scans an individual's fingerprint, records the unique pattern of the individual's ridges and valleys, and determines if the pattern matches the pattern of the person who has access permission to a particular device, such as a computer or a phone, or to a Web site.</descrip></descripGrp><ntig><termGrp><term id="727401">fingerprint reader</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="1260995">léitheoir méarlorg</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20613_727416_1260996"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A renamed .cab file which contains a .theme file, and optionally one or more desktop backgrounds, icons, mouse pointer files, and sound files. It does not contain executables or screen savers.</descrip></descripGrp><ntig><termGrp><term id="727416">theme pack</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="1260996">paca téama</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20613_727417_1260996"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A renamed .cab file which contains a .theme file, and optionally one or more desktop backgrounds, icons, mouse pointer files, and sound files. It does not contain executables or screen savers.</descrip></descripGrp><ntig><termGrp><term id="727417">.themepack file</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="1260996">paca téama</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20614_727418_1260997"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A renamed .ini file that points to the theme resources and contains theme values such as colors, fonts, and window size metrics.</descrip></descripGrp><ntig><termGrp><term id="727418">.theme file</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="1260997">comhad .theme</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2062_2793271_2794976"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that displays the identity of the originator of an incoming call on the device screen.</descrip></descripGrp><ntig><termGrp><term id="2793271">caller identification</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="2794976">ID glaoiteora</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2062_2793271_2794978"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that displays the identity of the originator of an incoming call on the device screen.</descrip></descripGrp><ntig><termGrp><term id="