ion">The section in Windows Store containing the user ratings and reviews for a given app.</descrip></descripGrp><ntig><termGrp><term id="2247838">Ratings and reviews</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="2250592">Rátálacha agus léirmheasanna</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38657_2249394_2257775"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A view that displays web articles in a distraction-free layout that is optimized for their screen size.</descrip></descripGrp><ntig><termGrp><term id="2249394">reading view</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="2257775">amharc léitheoireachta</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3866_318126_514253"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A language whose characters require ligation or shaping, such as a right-to-left language (Arabic, Persian, Hebrew, and Urdu) or certain South Asian languages.</descrip></descripGrp><ntig><termGrp><term id="318126">complex script</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="514253">script choimpléascach</term><termNote type="geographicalUsage">IRL</termNote><termNote type=