nd New Zealand to identify banks and their branches and for routing transactions.</descrip></descripGrp><ntig><termGrp><term id="1993212">bank state branch number</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="2004512">BSB</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34523_1993213_2004512"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A series of 6 digits used in Australia and New Zealand to identify banks and their branches and for routing transactions.</descrip></descripGrp><ntig><termGrp><term id="1993213">state branch number</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="2004512">BSB</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34523_1993220_2004512"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A series of 6 digits used in Australia and New Zealand to identify banks and their branches and for routing transactions.</descrip></descripGrp><ntig><termGrp><term id="1993220">BSB</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="2004512">BSB</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termN