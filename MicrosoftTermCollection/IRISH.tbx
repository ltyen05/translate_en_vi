><term id="1555644">subscription</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="2787941">síntiús</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3087_178259_2741678"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The mobile, larger form-factor computing device small enough to fit in a coat pocket that uses the Microsoft Windows CE or Windows Mobile operating system.</descrip></descripGrp><ntig><termGrp><term id="178259">Pocket PC</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="2741678">Pocket PC</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="30900_1567772_1818593"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To track content, people, or entities by adding them to a list of things for which you would like to surface updates about changes and activities.</descrip></descripGrp><ntig><termGrp><term id="1567772">follow</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="1818593">lean</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="30961_1579321_1587494"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Software that enables management of Hotmail email, calendar, and contacts from within Outlook.</descrip></descripGrp><ntig><termGrp><term id="1579321">Outlook Connector Pack</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="1587494">Pacáiste Nascóirí Outlook</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3098_228472_513771"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A written order on a bank to pay a sum of money from funds in an account. Checks show the name of the company or individual receiving payment, the signature and account number of the person issuing the check, the payment amount and the current date. Checks usually are numbered in sequence.</descrip></descripGrp><ntig><termGrp><term id="228472">check</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="513771">seic</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="30985_1579880_1587429"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Someone with whom a user has established a mutual social relationship.</descrip></descripGrp><ntig><termGrp><term id="1579880">connection</term><termNote type="partOfSpeech">Noun</termNote><termNote typ