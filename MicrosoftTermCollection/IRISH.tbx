"en-US"><descripGrp><descrip type="definition">A record of information about user searches, such as search terms and time of access.</descrip></descripGrp><ntig><termGrp><term id="1507117">search query log</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="1944265">loga na n-iarratas cuardaigh</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29336_1507118_1944266"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A report that is generated from query log information. For example, a search query log report might include the number of queries that were executed every day over the past thirty days.</descrip></descripGrp><ntig><termGrp><term id="1507118">search query log report</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="1944266">tuairisc ar loga na n-iarratas cuardaigh</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29337_1507119_1944267"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The user search security filter that specifies group and user permissions for a specific FAST Search user. FAST Search Authorization (FSA) filters out inappropriate search results by intersecting the user’s query with the user's search security filter, and checking each document’s access control list to determine if the user has permission to view that document. The user search security filter is FSA's primary means of enforcing document-level security ("security trimming"), which helps to ensure that search results display only documents that the user has permissions to read.</descrip></descripGrp><ntig><termGrp><term id="1507119">user search security filter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="1944267">scagaire slándála cuardaigh an úsáideora</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29338_1507120_1944268"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The condition of a Web Part and the Web Part chrome surrounding it. Possible values are zero (0) for normal state or one (1) for minimized state.</descrip></descripGrp><ntig><termGrp><term id="1507120">Web Part chrome state</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="1944268">an staid cróm atá ag Comhpháirt Gréasáin</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29339_1507121_1944269"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A default group of users on a SharePoint site. By default, the Visitors group is assigned the Read permission level.</descrip></descripGrp><ntig><termGrp><term id="1507121">Visitors group</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></nti