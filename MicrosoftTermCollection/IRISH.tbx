E"><ntig><termGrp><term id="2297603">Microsoft Office 365 (Plean E4)</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28691_1490094_2787920"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The offer from Microsoft Office 365 that provides a unified communications plan with advanced capabilities, including enterprise instant messaging, presence, and online meetings with audio and video conferencing and multiparty data sharing.</descrip></descripGrp><ntig><termGrp><term id="1490094">Lync Online (Plan 2)</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="2787920">Lync Online (Plean 2)</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28719_1491626_2787902"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An act that has an effect in a system.</descrip></descripGrp><ntig><termGrp><term id="1491626">action</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="2787902">gníomh</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28720_1491627_2488694"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A defini