artOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46330_2609539_2663794"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app that enables Cortana to take over your mouse pointer and literally show you how to change a setting when you ask her to "show me (how to do something)." She performs each step for you in a sequence of clicks needed to make a particular change in Windows Settings.</descrip></descripGrp><ntig><termGrp><term id="2609539">Cortana Show Me</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="2663794">Cortana Show Me</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46337_2609835_2787209"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To plan an event for a specific time slot.</descrip></descripGrp><ntig><termGrp><term id="2609835">schedule</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="2787209">sceidealaigh</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46341_2610077_2611769"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The consumer-facing name for Hypervisor Code Integrity (HVCI). The HVCI service in Windows 10 determines whether code executing in kernel mode is securely designed and trustworthy, and helps ensure that all software running in kernel mode, including drivers, securely allocate memory and operate as they are intended.</descrip></descripGrp><ntig><termGrp><term id="2610077">memory integrity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="2611769">sláine na cuimhne</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46344_2834959_2837187"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The desktop-only sync app for OneDrive that enables on-demand file sharing and navigation in File Explorer and that comes pre-installed on PCs.</descrip></descripGrp><ntig><termGrp><term id="2834959">Microsoft OneDrive sync</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="2837187">Microsoft OneDrive Sync</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46344_2834959_2837188"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The desktop-only sync app for OneDrive that enables on-demand file sharing and navigation in File Explorer and that comes pre-installed on PCs.</descrip></descripGrp><ntig><termGrp><term id="2834959">Microsoft OneDrive sync</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><la