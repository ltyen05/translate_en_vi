uch as Internal Use Only, to the message header. Security labels in your organization are controlled by security policies set up by your email administrator.</descrip></descripGrp><ntig><termGrp><term id="232420">security label</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="1260940">lipéad slándála</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16250_174770_1818181"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A rectangle with sizing handles that surrounds a selected object or objects.</descrip></descripGrp><ntig><termGrp><term id="174770">selection rectangle</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="1818181">dronuilleog roghnúcháin</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16250_645093_1818181"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A rectangle with sizing handles that surrounds a selected object or objects.</descrip></descripGrp><ntig><termGrp><term id="645093">selection box</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="1818181">dronuilleog roghnúcháin</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGen