p></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="1944134">comhpháirt innéacs lán-téacs</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29151_1506735_1944135"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of propagating of one full-text index component.</descrip></descripGrp><ntig><termGrp><term id="1506735">full-text index propagation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="1944135">forleathadh innéacs lán-téacs</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29152_1506736_1944136"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A list whose base type is Generic List.</descrip></descripGrp><ntig><termGrp><term id="1506736">generic list</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="1944136">liosta cineálach</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29153_1506737_1944137"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The condition of a document whose content is stored in a location other than the content database. If a document is ghosted, the front-end Web server determines the location of the content by using the SetupPath value for the document.</descrip></descripGrp><ntig><termGrp><term id="1506737">ghosted</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="1944137">scáilithe</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29154_1506738_1944138"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An object that represents a chart and the datasheet that contains the data for the chart.</descrip></descripGrp><ntig><termGrp><term id="1506738">graph object</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="1944138">oibíocht ghraif</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29155_1506739_1944139"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A string that uniquely identifies a document that is subject to the policies defined for a Group Approval workflow. The string is generated and assigned automatically to a document by a protocol server.</descrip></descripGrp><ntig><termGrp><term id="1506739">Group Approval document identifier</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="1944139">aitheantóir doiciméid an Fhormheasa Grúpa</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29156_1506740_1522596"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A cell that no longer appears in a worksheet view because it is contained within a hidden row or a hidden column.</descrip></descripGrp><ntig><termGrp><term id="1506740">hidden cell</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="1522596">cill fholaithe</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29157_1506741_1944140"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A column that does not appear in a worksheet view because its width is set to zero (0). A column can be hidden if an outline is collapsed.</descrip></descripGrp><ntig><termGrp><term id="1506741">hidden column</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="1944140">colún folaithe</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29158_1506742_1944141"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A row that does not appear in a worksheet view because its height is set to zero (0). A row can be hidden if a user is filtering or if an outline is collapsed.</descrip></descripGrp><ntig><termGrp><term id="1506742">hidden row</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="1944141">ró folaithe</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29159_1506743_1944142"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A managed property from the metadata index that the administrator identifies as a good indicator of a highly relevant item. It is used to produce a high confidence result.</descrip></descripGrp><ntig><termGrp><term id="1506743">high confidence property</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="1944142">airí ardmhuiníne</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29160_1506744_1522599"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A formatting setting that specifies how content is positioned within the horizontal space of a cell, object, or page. Content can be aligned along the left or right edge, or distributed evenly across the horizontal space.</descrip></descripGrp><ntig><termGrp><term id="1506744">horizontal alignment</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="1522599">ailíniú cothrománach</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29161_1506745_1944143"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The number of allowable host hops for a content source.</descrip></descripGrp><ntig><termGrp><term id="1506745">host depth</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="1944143">doimhneacht an óstaigh</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29162_1506746_1944144"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of traversing to a server with a different host name during a crawl.</descrip></descripGrp><ntig><termGrp><term id="1506746">host hop</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="1944144">preab óstaigh</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29164_1506748_1944145"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">For each token that is encountered in a corpus of indexed items, a data structure that stores a list of postings that identify which documents matched and a list of occurrences that identify which position in each document.</descrip></descripGrp><ntig><termGrp><term id="1506748">inverted index</term><termNote type="partOfSpeech">Nou