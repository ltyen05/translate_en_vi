/termGrp></ntig></langSet></termEntry><termEntry id="8279_143597_1818132"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A movie clip that plays when the user opens a Web page, or when the pointer rests on a movie image, or in both instances, depending on the object's settings. Not all Web browsers support inline movies.</descrip></descripGrp><ntig><termGrp><term id="143597">inline movie</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="1818132">scannán inlíne</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="828_178555_2736878"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An item that is frequently accessed when using Business Contact Manager for Outlook and that is often listed on the Business Tools menu.</descrip></descripGrp><ntig><termGrp><term id="178555">business tool</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="2736878">uirlis ghnó</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8283_153889_513594"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A derivative of the file allocation table (FAT) file system. FAT32 supports smaller cluster sizes and larger volumes than FAT, which results in more efficient space allocation on FAT32 volumes.</descrip></descripGrp><ntig><termGrp><term id="153889">FAT32</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="513594">FAT32</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8286_2119323_2279915"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A unique set of letters or numbers that identifies a wireless network. For a computer or device to connect to a wireless network, it must supply that network’s SSID. An SSID can be up to 32 characters.</descrip></descripGrp><ntig><termGrp><term id="2119323">Service Set Identifier</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="2279915">Aitheantóir Líonra gan Sreang</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8286_2119323_514042"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A unique set of letters or numbers that identifies a wireless network. For a computer or device to connect to a wireless network, it must supply that network’s SSID. An SSID can be up to 32 characters.</descrip></descripGrp><ntig><termGrp><term id="2119323">Service Set Identifier</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="514042">SSID</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">No