Gender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21104_766799_1261045"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of computing resources such as programs and virtual desktops that enable a user to accomplish a set of related tasks.</descrip></descripGrp><ntig><termGrp><term id="766799">workspace</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="1261045">spás oibre</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21106_766801_1261046"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The entity that offers a remote workspace, typically the IT department of the user’s employer, a business partner or vendor, or less commonly, a commercial application service provider. The publisher may use a digital certificate to represent its identity and use it to sign the remote resource files (e.g. RDP files) and the workspace description (e.g. Web Service feed).</descrip></descripGrp><ntig><termGrp><term id="766801">publisher</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="1261046">foilsitheoir</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21113_766809_1261047"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Silent and unexpected process termination by the process itself or by another application.</descrip></descripGrp><ntig><termGrp><term id="766809">silent process exit</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="1261047">scor próiseála ciúin</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21114_766811_1261048"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To shut down a core processor for power saving purpose.</descrip></descripGrp><ntig><termGrp><term id="766811">park</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="1261048">páirceáil</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21115_766812_1261049"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To reopen a core processor that had been parked for power saving purpose.</descrip></descripGrp><ntig><termGrp><term id="766812">unpark</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="1261049">dípháirceáil</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21116_766813_1261050"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature of Windows Media Player that allows users to remove gaps between tracks that they burn to audio CDs.</descrip></descripGrp><ntig><termGrp><term id="766813">gapless CD burning</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="1261050">dó gan bhearna</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21116_766816_1261050"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature of Windows Media Player that allows users to remove gaps between tracks that they burn to audio CDs.</descrip></descripGrp><ntig><termGrp><term id="766816">gapless burning</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="1261050">dó gan bhearna</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21117_766814_1261051"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Existing in reference to the removal of silences or clicks between tracks when they are burnt to an audio CD or when they are played back from the CD.</descrip></descripGrp><ntig><termGrp><term id="766814">gapless</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="1261051">gan bhearna</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21120_766842_1261052"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A unique identifier made from four otherwise separate pieces of information. For example, a color can be specified by a black, yellow, magenta and cyan quad.</descrip></descripGrp><ntig><termGrp><term id="766842">quad</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="1261052">cuad</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21126_766858_1261053"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Any information (e.g. account numbers, sensitive data, etc.) with a title and some free-form text that can be stored in a secure manner in a personal vault.</descrip></descripGrp><ntig><termGrp><term id="766858">secure note</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="1261053">nóta slán</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21128_766863_1261054"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To make an object, such as a file, accessible.</descrip></descripGrp><ntig><termGrp><term id="766863">open</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="1261054">oscail</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2113_1130279_514325"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The symbol or character used to indicate that a word, phrase, symbol, or design is a trademark, but not a registered trademark.</descrip></descripGrp><ntig><termGrp><term id="1130279">™</term><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="514325">siombail trádmhairc</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2113_319159_514325"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The symbol or character used to indicate that a word, phrase, symbol, or design is a trademark, but not a registered trademark.</descrip></descripGrp><ntig><termGrp><term id="319159">trademark symbol</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="514325">siombail trádmhairc</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntr