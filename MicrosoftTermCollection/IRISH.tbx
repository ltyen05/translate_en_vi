inition">The binding process where authentication is one-directional.</descrip></descripGrp><ntig><termGrp><term id="2569598">1-way binding</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="2572597">ceangal aontreo</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45584_2569599_2572598"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The binding process where authentication goes both ways.</descrip></descripGrp><ntig><termGrp><term id="2569599">2-way binding</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="2572598">ceangal déthreo</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45585_2569600_2572612"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To remove association from two or more pieces of information.</descrip></descripGrp><ntig><termGrp><term id="2569600">unbind</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="2572612">dícheangal</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45586_2569602_2583071"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft-owned company that has created the world's largest professional network on the Internet.</descrip></descripGrp><ntig><termGrp><term id="2569602">LinkedIn</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="2583071">LinkedIn</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45587_2569603_2576986"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An effect that makes an image appear as if drawn with a pencil.</descrip></descripGrp><ntig><termGrp><term id="2569603">pencil effect</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="2576986">maisíocht peann luaidhe</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45591_2570262_2572663"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The methodology, originally developed in the Japanese automotive industry, that uses digital cards to achieve just-in-time delivery and manage the replenishment cycle in a manufacturing process.</descrip></descripGrp><ntig><termGrp><term id="2570262">Kanban</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="2572663">Kanban</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4561_319151_514322"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The " character.</descrip></descripGrp><ntig><termGrp><term id="319151">straight quotation mark</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="514322">comhartha (díreach) athfhriotail</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4565_31042_1769365"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of finalizing a purchase on a website. For example, when customers shop on your website, they may select several items and save them in their shopping basket. When they have finished shopping, they click on a checkout link or graphical button that takes them to an online form where they enter their name, billing address, payment type, and shipping information.</descrip></descripGrp><ntig><termGrp><term id="31042">checkout</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="1769365">seiceáil amach</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4566_118879_513346"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A menu that contains commands you can use to manipulate a window or close a program. You click the program icon at the left of the title bar to open this menu. The context menu of a window replaces this menu.</descrip></descripGrp><ntig><termGrp><term id="118879">system menu</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="513346">roghchlár rialúcháin</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4566_118880_513346"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A menu that contains commands you can use to manipulate a window or close a program. You click the program icon at the left of the title bar to open this menu. The context menu of a window replaces this menu.</descrip></descripGrp><ntig><termGrp><term id="118880">control menu</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="513346">roghchlár rialúcháin</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4567_232422_1818235"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The container in a navigation pane that contains shortcuts and shortcut groups.</descrip></descripGrp><ntig><termGrp><term id="232422">Shortcuts Pane</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="