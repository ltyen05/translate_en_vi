o a page layout to generate an HTML page for display to a reader. Publishing pages have specific fields that contain the content that is displayed in an HTML page.</descrip></descripGrp><ntig><termGrp><term id="1506812">publishing page</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="1522638">leathanach foilsitheoireachta</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29227_1506814_1944191"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A system to rank items that uses features that do not vary with different queries.</descrip></descripGrp><ntig><termGrp><term id="1506814">query independent rank</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="1944191">rangú atá neamhspleách ar iarratais</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29228_1506815_1522639"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of recording information about user searches, such as search terms and time of access.</descrip></descripGrp><ntig><termGrp><term id="1506815">query logging</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="1522639">logáil iarratas</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29229_1506817_1522640"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A result for a given query, which contains the title and URL of the item, and can also contain other managed properties and a hit-highlighted summary.</descrip></descripGrp><ntig><termGrp><term id="1506817">query result</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="1522640">toradh iarratais</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2923_59620_2700667"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method of specifying software behavior by system administrators. Administrators set policies that are used to control how software features behave.</descrip></descripGrp><ntig><termGrp><term id="59620">Group Policy</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="2700667">Polasaí grúpa</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2923_59620_512985"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method of specifying software behavior by system administrators. Administrators set policies that are used to control how software features behave.</descrip></descripGrp><ntig><termGrp><term id="59620">Group Policy</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="512985">Polasaí Grúpa</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29230_1506818_1522641"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A two-dimensional table that presents data from an external data source.</descrip></descripGrp><ntig><termGrp><term id="1506818">query table</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="1522641">tábla iarratas</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29231_1506819_1522642"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The textual string portion of a query. Frequently, a user enters query text, but it can be programmatically amended and is not guaranteed to be exactly what the user typed.</descrip></descripGrp><ntig><termGrp><term id="1506819">query text</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="1522642">téacs iarratais</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29232_1506820_1944192"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A value that is used to influence the algorithm that determines the rank of an item.</descrip></descripGrp><ntig><termGrp><term id="1506820">ranking parameter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="1944192">paraiméadar rangaithe</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29233_1506822_1944193"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A system for specifying cells or ranges of cells and that is used in formulas. A reference style is used to specify a specific cell in a two-dimensional table by identifying the row and column that contain that cell or range of cells.</descrip></descripGrp><ntig><termGrp><term id="1506822">reference style</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="1944193">stíl tagartha</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29234_1506823_1522646"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An element of markup in a page that defines a relationship between binary files on the server that implements Web Parts and Web controls. The register directive also serves as the namespace of the markup in the Web Part Page that will refer to those binary files.</descrip></descripGrp><ntig><termGrp><term id="1506823">register directive</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="1522646">treoir cláraithe</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29235_1506824_1944194"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A search result that is relevant to a query term based on rank. By default, the higher the rank, the higher the item appears in the query results.</descrip></descripGrp><ntig><termGrp><term id="1506824">relevant result</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="1944194">toradh ábhartha</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29236_1506826_1944195"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An event in which various statistics are calculated and recorded in the main catalog.</descrip></descripGrp><ntig><termGrp><term id="1506826">reranking</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="1944195">athrangú</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29237_1506827_1944196"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An integer that identifies the relative location of a relevant result within a search results page. The first relevant result has a result position of 1, the second has 2, the 11th has 11, and so on.</descrip></descripGrp><ntig><termGrp><term id="1506827">result position</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="1944196">ionad toraidh</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29238_1506828_1944197"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An integer that uniquely identifies a role definition within a site.</descrip></descripGrp><ntig><termGrp><term id="1506828">role identifier</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="1944197">aitheantóir róil</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29239_1506830_1944198"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A document in the root folder of a site.</descrip></descripGrp><ntig><termGrp><term id="1506830">root document</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="1944198">fréamhdhoiciméad</term><termNote type="geographicalUs