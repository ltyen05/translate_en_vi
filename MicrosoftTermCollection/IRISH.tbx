et xml:lang="en-US"><descripGrp><descrip type="definition">The name used to represent the same computer on which a TCP/IP message originates. If you access a server-based web site by using http://localhost, the request does not actually go out to the Internet.</descrip></descripGrp><ntig><termGrp><term id="144194">localhost</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="1818135">localhost</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5890_211335_1095488"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application available in an enterprise to help with particular business and process needs, such as payroll, resource planning, supply chain management, and accounting.</descrip></descripGrp><ntig><termGrp><term id="211335">line-of-business application</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="1095488">feidmhchlár líne gnó</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5890_211335_2332078"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application available in an enterprise to help with particular business and process needs, such as payroll, resource planning, supply chain management, and accounting.</descrip></descripGrp><ntig><termGrp><term id="211335">line-of-business application</term><termNote type="partOfSpeech">Noun</termNote>