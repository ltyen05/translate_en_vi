ech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="2176954">cuairt</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37785_2157432_2179044"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The total amount of time up to a given point that the user marks while using the stopwatch. After marking a split, the stopwatch continues running in the background.</descrip></descripGrp><ntig><termGrp><term id="2157432">split</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="2179044">am geábha</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37786_2157433_2174880"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A technology that enables app publishers to send ad requests to multiple ad networks to ensure that publishers can match the right ad networks to the right inventory and maximize the ad revenue.</descrip></descripGrp><ntig><termGrp><term id="2157433">ad mediation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="2174880">idirghabháil fógraíochta</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></n