mail messages, appointments, contacts, tasks, journal entries, notes, posted items, and documents.</descrip></descripGrp><ntig><termGrp><term id="234575">item</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="514527">mír Outlook</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9120_363601_513837"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The basic element that holds information in Outlook (similar to a file in other programs). Items include email messages, appointments, contacts, tasks, journal entries, notes, posted items, and documents.</descrip></descripGrp><ntig><termGrp><term id="363601">Outlook item</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="513837">mír</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9120_363601_514527"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The basic element that holds information in Outlook (similar to a file in other programs). Items include email messages, appointments, contacts, tasks, journal entries, notes, posted items, and documents.</descrip></descripGrp><ntig><termGrp><term id="363601">Outlook item</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="514527">mír Outlook<