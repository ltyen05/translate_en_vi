t; character.</descrip></descripGrp><ntig><termGrp><term id="318356">left angle bracket</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="514282">lúibín uilleach ar chlé</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10422_318750_513086"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The &lt; character.</descrip></descripGrp><ntig><termGrp><term id="318750">LESS-THAN SIGN</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="513086">comhartha 'níos lú ná'</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10422_318750_514282"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The &lt; character.</descrip></descripGrp><ntig><termGrp><term id="318750">LESS-THAN SIGN</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="514282">lúibín uilleach ar chlé</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10422_74325_513086"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The &lt; character.</descrip></descripGrp>