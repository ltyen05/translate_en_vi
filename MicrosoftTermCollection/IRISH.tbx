 and consumers to purchase.</descrip></descripGrp><ntig><termGrp><term id="3007455">Microsoft Teams Essentials</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="3007787">Microsoft Teams Essentials</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52949_3007455_3122292"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The paid Teams standalone MSA-based SKU that will be available for both small businesses and consumers to purchase.</descrip></descripGrp><ntig><termGrp><term id="3007455">Microsoft Teams Essentials</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="3122292">Teams Essentials</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52949_3121608_3007787"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The paid Teams standalone MSA-based SKU that will be available for both small businesses and consumers to purchase.</descrip></descripGrp><ntig><termGrp><term id="3121608">Teams Essentials</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="3007787">Microsoft Teams Essentials</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNot