 id="8747_351591_514477"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in Windows that allows users to access and manage printers, multi-function printers, digital cameras and scanners.</descrip></descripGrp><ntig><termGrp><term id="351591">Printing and Imaging Devices</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="514477">Gléasanna Priontála agus Íomháithe</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8751_418607_1519746"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To prevent another user from initiating a conversation and from viewing your presence or other information, such as your personal information.</descrip></descripGrp><ntig><termGrp><term id="418607">block</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="1519746">bac</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8757_558600_1943945"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The list of answers to a search request that match the search criteria specified by the user.</descrip></descripGrp><ntig><termGrp><term id="558600">search results</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="1943945">torthaí an chuardai