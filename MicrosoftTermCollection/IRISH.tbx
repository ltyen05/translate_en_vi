<langSet xml:lang="ga-IE"><ntig><termGrp><term id="2396989">Feisteas abhatár</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42353_2396193_2396981"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The game category with games that allow you to use your phone to interact with Xbox. You can browse and type on Xbox live using your phone instead of the controller.</descrip></descripGrp><ntig><termGrp><term id="2396193">Companion</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="2396981">Compánach</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42354_2396194_2396960"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app category that offers utility apps which allow you to change settings and test network connections.</descrip></descripGrp><ntig><termGrp><term id="2396194">Tools</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="2396960">Uirlisí</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42355_2396195_2396987"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The game category that offers massively multiplayer online role-playing games. The users can choose a certain character and fight against other users on a map.</descrip></descripGrp><ntig><termGrp><term id="2396195">Multi-player online battle arena</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="2396987">Láthair chatha il-imreora ar líne</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4236_16880_2297402"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process an operating system uses to detect and record security-related events, such as an attempt to create, to access, or to delete objects such as files and directories. The records of such events are stored in a file known as a security log, whose contents are available only to those with the proper clearance.</descrip></descripGrp><ntig><termGrp><term id="16880">auditing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="2297402">iniúchadh</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42378_2396738_2405110"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office service that allows users to publish documents to Docs.com with one click from Word, Excel, PowerPoint, and Sway while retaining the original formatting and animation of the document.</descrip></descripGrp><ntig><termGrp><term id="2396738">Publish to Docs.co