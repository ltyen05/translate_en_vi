al</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="2643169">Gléastairseach Windows</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4005_44392_512862"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">One or more special characters used to separate peers in a delimited structure, at any level (fields, records, and so on).</descrip></descripGrp><ntig><termGrp><term id="44392">delimiter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="512862">teormharcóir</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40063_2329165_2927349"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An image representing the user, visible under their profile</descrip></descripGrp><ntig><termGrp><term id="2329165">profile picture</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="2927349">pictiúr próifíle</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40080_2329245_2331601"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that lets a user hide an email message from their inbox, setting it to return to the top of their inbox at a specified date and time. It lets the user clear their inbox by postponing items that aren't urgent.</descrip></descripGrp><ntig><termGrp><term id="2329245">Schedule</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="2331601">Sceideal</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40081_2329246_2331600"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To mark an email message or conversation such that it moves to the top of your inbox and is flagged at a specified date and time.</descrip></descripGrp><ntig><termGrp><term id="2329246">schedule</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="2331600">cuir i sceideal</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40082_2329247_2329587"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The combination of enterprise-related hardware and software security features that, when configured together, will lock a device down so that it can only run trusted applications.​​​</descrip></descripGrp><ntig><termGrp><term id="2329247">Device Guard</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="2329587">Device Guard</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40082_2329247_3085732"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The combination of enterprise-related hardware and software security features that, when configured together, will lock a device down so that it can only run trusted applications.​​​</descrip></descripGrp><ntig><termGrp><term id="2329247">Device Guard</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="3085732">Cosaint Gléasanna Microsoft Defender</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40082_2795844_2329587"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The combination of enterprise-related hardware and software security features that, when configured together, will lock a device down so that it can only run trusted applications.​​​</descrip></descripGrp><ntig><termGrp><term id="2795844">Microsoft Defender Device Guard</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="2329587">Device Guard</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGr