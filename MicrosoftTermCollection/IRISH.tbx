type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53009_3013009_3014747"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To prevent a person's identity from being connected with information pertaining to him/her.</descrip></descripGrp><ntig><termGrp><term id="3013009">de-identify</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="3014747">dí-aithin</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53010_3013010_3014748"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A constraint on the algorithms used to publish aggregate information about a statistical database which limits the privacy impact on individuals whose information is in the database.</descrip></descripGrp><ntig><termGrp><term id="3013010">differential privacy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="3014748">príobháideachas difreálach</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5303_76437_2998707"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In mathematics, the power to which a base must be raised to equal a given number. For example, for the base 10, the logarithm of 16 is (approximately) 1.2041 because 101.2041 equals (approximately) 16. Both natural logarithms (to the base e, which is approximately 2.71828) and common logarithms (to the base 10) are used in programming. Languages such as C and Basic include functions for calculating natural logarithms.</descrip></descripGrp><ntig><termGrp><term id="76437">logarithm</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="2998707">logartam</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53031_3014789_3059317"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Azure offering that supports Azure Virtual Desktop on Azure Stack HCI.</descrip></descripGrp><ntig><termGrp><term id="3014789">Azure Virtual Desktop on Azure Stack HCI</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="3059317">Azure Virtual Desktop ar Azure Stack HCI</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53031_3014789_3059319"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Azure offering that supports Azure Virtual Desktop on Azure Stack HCI.</descrip></descripGrp><ntig><termGrp><term id="3014789">Azure Virtual Desktop on Azure Stack HCI</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="