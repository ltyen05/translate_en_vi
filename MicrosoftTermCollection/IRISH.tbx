h</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="3055675">Windows 365 Switch</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53668_3055383_3059321"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to device features that can detect if someone is coming or going from a device, triggering the device to wake or lock.</descrip></descripGrp><ntig><termGrp><term id="3055383">presence sensing</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="3059321">braite láithreachta</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53669_3055384_3055677"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Windows feature on select devices with a sensor to detect motion as someone approaches so the device powers back on.</descrip></descripGrp><ntig><termGrp><term id="3055384">wake on approach</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="3055677">dúisigh ar theacht i dtreo</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp