 type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10451_16349_1260342"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Relating to frequencies within the range of perception by the human ear - from about 15 to 20,000 hertz (cycles per second).</descrip></descripGrp><ntig><termGrp><term id="16349">audio</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="1260342">fuaim-</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10451_16349_512650"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Relating to frequencies within the range of perception by the human ear - from about 15 to 20,000 hertz (cycles per second).</descrip></descripGrp><ntig><termGrp><term id="16349">audio</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="512650">fuaime</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10452_107217_3041615"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In color management, the purity of a color's hue, moving from gray to the pure color.</descrip></descripGrp><ntig><termGrp><term id="107217">saturation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="30