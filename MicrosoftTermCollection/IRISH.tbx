finition">The block of filled-in cells that includes the currently selected cell or cells. The region extends in all directions to the first empty row or column.</descrip></descripGrp><ntig><termGrp><term id="139724">current region</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="1260764">réigiún reatha</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7201_147134_1260844"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">independent attributes associated with items, or members, in an OLAP cube. For example, if city items have size and population properties stored in the server cube, a PivotTable report can display the size and population of each city.</descrip></descripGrp><ntig><termGrp><term id="147134">property fields</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="1260844">réimsí airíonna</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7204_2066257_2074565"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A notification for sharing items, such as calendars, documents or folders, with others.</descrip></descripGrp><ntig><termGrp><term id="2066257">invitation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="20