tig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="514337">comhartha méadaithe</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3568_234787_513853"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file backup feature that performs scheduled incremental backups of data to the target media. It also allows the user to restore an individual file or a group of files.</descrip></descripGrp><ntig><termGrp><term id="234787">Windows Backup</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="513853">Cúltaca Windows</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35685_2052902_2071468"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A licensing mode that enables Office 365 subscribers to access their account from different computers and that allows multiple users belonging to the same subscription to log in and use their account from the same computer.</descrip></descripGrp><ntig><termGrp><term id="2052902">shared computer activation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="2071468">gníomhachtú comhríomhaire</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35685_2488791_2071468"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A licensing mode that enables Office 365 subscribers to access their account from different computers and that allows multiple users belonging to the same subscription to log in and use their account from the same computer.</descrip></descripGrp><ntig><termGrp><term id="2488791">SCA</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="2071468">gníomhachtú comhríomhaire</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35686_2052903_2071467"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An email sent at a specified time to a user to remind them of an upcoming event. Users can create reminder emails for themselves for any event in their calendars and for all attendees (when users are also the organizers). The email contains all details of the event and optional notes that users might add.</descrip></descripGrp><ntig><termGrp><term id="2052903">email reminder</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="2071467">meabhrúchán ríomhphoist</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3569_105900_1954825"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The uppermost directory on a computer, partition or volume.</descrip