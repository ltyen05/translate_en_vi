557844">dump</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="514241">comhad cúltaca</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6059_182676_513680"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A compilation of the specific prices that can be charged for each unit in the unit group of a product.</descrip></descripGrp><ntig><termGrp><term id="182676">price list</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="513680">praghasliosta</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="606_134615_513439"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To transfer information either to a storage device, such as a disk, or to an output device, such as the monitor or a printer. Writing is the means by which a computer provides the results of processing. A computer can also be said to write to the screen when it displays information on the monitor.</descrip></descripGrp><ntig><termGrp><term id="134615">write</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="513439">scríobh</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6063_137589_513464"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A database on a server that matches user names to passwords.</descrip></descripGrp><ntig><termGrp><term id="137589">authentication database</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="513464">bunachar sonraí fíordheimhnithe</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6064_140594_1937034"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A cell that contains a formula that refers to another cell. For example, if cell D10 contains the formula =B5, cell D10 is a dependent of cell B5.</descrip></descripGrp><ntig><termGrp><term id="140594">dependent</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="1937034">spleáchóg</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6077_314127_514211"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Information about a client computer that Network Access Protection (NAP) uses to allow or deny access to a network and which is encapsulated in a statement of health (SoH), which is issued by a system health agent (SHA) on the client computer.</descrip></descripGrp><ntig><termGrp><term id="314127">health</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="514211">sláine</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="608_1355238_1644259"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tool or software program designed to detect and respond to malicious software, such as viruses and worms. Responses may include blocking user access to infected files, cleaning infected files or systems, or informing the user that an infected program was detected.</descrip></descripGrp><ntig><termGrp><term id="1355238">anti-malware software</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="1644259">ríomhchlár in aghaidh bogearraí mailíseacha</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="608_1355238_1644270"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tool or software program designed to detect and respond to malicious software, such as viruses and worms. Responses may include blocking user access to infected files, cleaning infected files or systems, or informing the user that an infected program was detected.</descrip></descripGrp><ntig><termGrp><term id="1355238">anti-malware software</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="1644270">bogearr