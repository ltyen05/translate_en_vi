rp><descrip type="definition">A temporary property of a user-interface object, such as a window, view, dialog box, or button, that permits the object to receive keyboard input from the user. The focus is usually conveyed through highlighting.</descrip></descripGrp><ntig><termGrp><term id="55239">focus</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="1818039">fócas</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12544_76022_513095"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A security group that can be granted rights and permissions only to resources on the computer on which the group is created. Local groups can have any user accounts that are local to the computer as members, as well as users, groups, and computers from a domain to which the computer belongs.</descrip></descripGrp><ntig><termGrp><term id="76022">local group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="513095">grúpa logánta</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12547_155493_513599"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A technical document in the Microsoft Knowledge Base accessible through Microsoft.com.</descrip></descripGrp><ntig><termGrp><term id="155493">KB article</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Sin