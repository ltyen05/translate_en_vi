escrip type="definition">A Structure and Style choice for a sway that is initially made by the user, which Sway will remember and intelligently implement based upon content, prior behavior, and abstract expressions of intent.</descrip></descripGrp><ntig><termGrp><term id="2277489">design lever</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="2281590">luamhán deartha</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3923_215040_2700658"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A common interface between transport-level applications, such as Microsoft Remote Procedure Call (RPC), and security support providers (SSPs), such as Windows Distributed Security. SSPI allows a transport application to call one of the SSPs to obtain an authenticated connection. These calls do not require extensive knowledge of the security protocol's details.</descrip></descripGrp><ntig><termGrp><term id="215040">Security Support Provider Interface</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="2700658">SSPI</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3923_215041_2700658"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A common interface between transport-level applications, such as Microsoft Remote Procedure Call (RPC), and security support providers (SSPs), 