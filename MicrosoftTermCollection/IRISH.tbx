><termGrp><term id="2612756">tacar</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46375_2612854_2923207"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A date when Microsoft will no longer provide updates to a feature release of a product, such that a customer needs to upgrade to a new feature release to continue receiving support from Microsoft.</descrip></descripGrp><ntig><termGrp><term id="2612854">end of service</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="2923207">deireadh leis an tseirbhís</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46375_2878237_2923207"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A date when Microsoft will no longer provide updates to a feature release of a product, such that a customer needs to upgrade to a new feature release to continue receiving support from Microsoft.</descrip></descripGrp><ntig><termGrp><term id="2878237">EOL</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="2923207">deireadh leis an tseirbhís</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46381_3128246_3128674"><langS