 feel.</descrip></descripGrp><ntig><termGrp><term id="2550038">Chilled</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="2552945">Gormuaine</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45157_2550041_2553018"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The filter that users can apply to a photo or video clip, which gives it a feeling of energy, and the purple light you might see before an electrical storm. This is also the name of a theme that applies this filter along with a related text style and music.</descrip></descripGrp><ntig><termGrp><term id="2550041">Electric</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="2553018">Leictreach</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45158_2550043_2553164"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The filter that users can apply to a photo or video clip, which gives it a golden brownish hue like sand.</descrip></descripGrp><ntig><termGrp><term id="2550043">Sandy</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="2553164">Fionnrua</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45159_2550044_2553069"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The filter that users can apply to a photo or video clip, which gives it a cheerful, playful, sunny feeling. This is also the name of a theme that applies this filter along with a related text style and music.</descrip></descripGrp><ntig><termGrp><term id="2550044">Joy</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="2553069">Sonas</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45160_2550045_2552964"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The filter that users can apply to a photo or video clip, which gives it a yellow tone.</descrip></descripGrp><ntig><termGrp><term id="2550045">Citrus</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="2552964">Buí</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45161_2550046_2553134"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The filter that users can apply to a photo or video clip, which has a coarse texture and hard edges like metal.</descrip></descripGrp><ntig><termGrp><term id="2550046">Metallic</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="2553134">Miotalach</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45162_2550047_2552897"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The filter that users can apply to a photo or video clip, which has the faded quality of photos taken in the mid-1960s.</descrip></descripGrp><ntig><termGrp><term id="2550047">1966</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="2552897">1966</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45163_2550050_2553130"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The filter that users can apply to a photo or video clip, which has a warm, sentimental feeling. This is also the name of a theme that applies this filter along with a related text style and music.</descrip></descripGrp><ntig><termGrp><term id="2550050">Loved</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="2553130">Teolaí</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected<