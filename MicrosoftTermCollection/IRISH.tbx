.</descrip></descripGrp><ntig><termGrp><term id="2411210">dry ink</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="2416471">dúch tirim</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42570_2411211_2416472"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An ink whose thickness and color can be changed even after drying.</descrip></descripGrp><ntig><termGrp><term id="2411211">editable ink</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="2416472">dúch ineagarthóireachta</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42571_2411212_2416474"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An ink that is retained as dry ink and not converted to a command.</descrip></descripGrp><ntig><termGrp><term id="2411212">ink as ink</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="2416474">dúch mar dhúch</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42572_2411213_2416477"><langSet xml:lang="en-US">