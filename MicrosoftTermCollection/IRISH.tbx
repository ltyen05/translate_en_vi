angSet xml:lang="en-US"><descripGrp><descrip type="definition">An area in the taskbar that shows icons for network connectivity, volume control, clock, and on laptops and Tablet computers, the battery.</descrip></descripGrp><ntig><termGrp><term id="311012">system control area</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="514196">limistéar rialaithe córais</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13562_361562_1095585"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tool used to categorize content into areas automatically.</descrip></descripGrp><ntig><termGrp><term id="361562">Topic Assistant</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="1095585">Cúntóír Ábhair</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13564_56172_1260907"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To send a received content either modified or in its entirety, to a new recipient.</descrip></descripGrp><ntig><termGrp><term id="56172">forward</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="1260907">seol ar aghaidh</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Verb</termNote><termNote ty