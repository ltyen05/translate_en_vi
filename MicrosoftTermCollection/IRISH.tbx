S"><descripGrp><descrip type="definition">A style option that makes an image or photograph look like a watercolor painting.</descrip></descripGrp><ntig><termGrp><term id="3161606">watercolor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="3161882">uiscedhath</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56227_3161607_3161881"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A style option that is part of the inline editing experience within Copilot. Block print technique involves carving a design into wood or linoleum and using that block to print the design onto paper or fabric.</descrip></descripGrp><ntig><termGrp><term id="3161607">block print</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="3161881">blocphrionta</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56228_3161608_3161880"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A style option that is part of the inline editing experience within Copilot. Steampunk images often combine elements of the Victorian era with futuristic technology, including gears, cogs, brass, and steam-powered machinery.</descrip></descripGrp><ntig><termGrp><term id="3161608">steampunk</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="3161880">galphunc</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56229_3161609_3161879"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A style option that is part of the inline editing experience within Copilot. Claymation images use movable clay characters and are often seen in children's films and cartoons.</descrip></descripGrp><ntig><termGrp><term id="3161609">claymation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="3161879">crébheochan</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56230_3161610_3161878"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A style option that is part of the inline editing experience within Copilot. Art deco images often blends modernity and luxury, creating a glamorous style.</descrip></descripGrp><ntig><termGrp><term id="3161610">art deco</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="3161878">art deco</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56231_3161611_3163398"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A style option that is part of the inline editing experience within Copilot. Low poly images use a limited number of polygons to represent shapes and are characterized by their simplicity and geometric shapes.</descrip></descripGrp><ntig><termGrp><term id="3161611">low poly</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="3163398">pola íseal</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56232_3161612_3161875"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A style option that is part of the inline editing experience within Copilot. Origami style is characterized by its minimalism, geometric shapes and creativity.</descrip></descripGrp><ntig><termGrp><term id="3161612">origami</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="3161875">oragámaí</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56233_3161613_3161877"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows users to take 1-2 images/photos and select a style or type a prompt and have your images combined and reimagined, generating an image with a new style.</descrip></descripGrp><ntig><termGrp><term id="3161613">restyle image</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</ter