anagement</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="514427">bainistiú teagmhálaithe</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6333_184278_2486091"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A BIOS developed to enable system-related information, such as information about hardware, to be gathered from computers on a network.</descrip></descripGrp><ntig><termGrp><term id="184278">SMBIOS</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="2486091">SMBIOS</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6333_184279_2486091"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A BIOS developed to enable system-related information, such as information about hardware, to be gathered from computers on a network.</descrip></descripGrp><ntig><termGrp><term id="184279">system management BIOS</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="2486091">SMBIOS</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6349_345311_514430"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method of arranging data based on the order of specified information. For example, records sorted by class would list all records within a class before moving to records in the next class.</descrip></descripGrp><ntig><termGrp><term id="345311">sorting</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="514430">sórtáil</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6350_276560_514063"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The utility in Windows Vista that presents a view of all PCs, devices, and printers on the network, and is significantly faster and more reliable than My Network Places in Windows XP.</descrip></descripGrp><ntig><termGrp><term id="276560">Network Explorer</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="514063">Taiscéalaí Líonra</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6352_152788_2787906"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method by which a client receives a stream, during which he/she cannot control the stream.</descrip></descripGrp><ntig><termGrp><term id="152788">broadcast</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="2787906">craolachán</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6362_99210_2998728"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A number that can be represented in a number system with a given base, such as the decimal system, by a finite or infinite sequence of digits and a radix point. For example, 1.1 is a real number, as is 0.33333....</descrip></descripGrp><ntig><termGrp><term id="99210">real number</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="2998728">réaduimhir</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6374_58539_1260834"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A domain controller that holds a copy of the global catalog for the forest.</descrip></descripGrp><ntig><termGrp><term id="58539">global catalog server</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="1260834">freastalaí catalóg domhanda</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6378_7117_1792233"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An entry in either a securable object's discretionary access control list (DACL) or an object's system access control list (SACL). In a DACL, the entry grants or denies permissions to a user or group. In a SACL, the entry specifies which security events to audit for a particular user or group or controls the Windows Integrity Level for the object.</descrip></descripGrp><ntig><termGrp><term id="7117">access control entry</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="1792233">ACE</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6378_7119_1792233"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An entry in either a securable object's discretionary access control list (DACL) or an object's system access control list (SACL). In a DACL, the entry grants or denies permissions to a user or group. In a SACL, the entry specifies which security events to audit for a particular user or group or controls the Windows Integrity Level for the object.</descrip></descripGrp><ntig><termGrp><term id="7119">ACE</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="1792233">ACE</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6381_141638_1818389"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A control that, when clicked, expands or collapses a grouped record to display or hide its detail records.</d