997"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of drop-down menu that appears when a user points to a command on a higher-level menu.</descrip></descripGrp><ntig><termGrp><term id="61415">submenu</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="512997">fo-roghchlár</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15739_140279_513494"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of ensuring that data meets specified criteria.</descrip></descripGrp><ntig><termGrp><term id="140279">data validation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="513494">bailíochtú sonraí</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15742_85088_513159"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user-friendly name displayed in place of a network location, email address, contact name, or other, more formal names.</descrip></descripGrp><ntig><termGrp><term id="85088">nickname</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ga-IE"><ntig><termGrp><term id="513159">leasainm</term><termNote type="geographicalUsage">IRL</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNot