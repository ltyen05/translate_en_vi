28"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To group very similar photos together in the Photos app, and show only one (the best shot) in the list view of your photos.</descrip></descripGrp><ntig><termGrp><term id="2106697">stack</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2199528">स्टॅक करा</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37049_2106698_2199529"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of very similar photos that have been grouped together by the Photos app. The app shows only the best photo of the stack in the list view.</descrip></descripGrp><ntig><termGrp><term id="2106698">stack</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2199529">स्टॅक</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37050_2106699_2199556"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To remove the "stack" association from a group of similar photos that have been stacked together in the Photos app.</descrip></descripGrp><ntig><termGrp><term id="2106699">unstack</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2199556">अनस्टॅक करा</term><termNote type="geographicalUsage">IND</