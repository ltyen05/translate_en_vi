ition">A searchable collection of articles and facts about a particular subject area.</descrip></descripGrp><ntig><termGrp><term id="351589">KB</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="468198">नॉलेज बेस</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2268_351589_468985"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A searchable collection of articles and facts about a particular subject area.</descrip></descripGrp><ntig><termGrp><term id="351589">KB</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="468985">KB</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22692_1053737_1962031"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A procedure by which a user's password can be changed to a known value, in situations where the user has forgotten or lost their password.</descrip></descripGrp><ntig><termGrp><term id="1053737">password reset</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1962031">पासवर्ड रिसेट</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22734_1054764_1424995"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A view that shows all of the resources on a project and their work over time. This makes it easy to rearrange work, schedule new work, and manage a team's load.</descrip></descripGrp><ntig><termGrp><term id="1054764">Team Planner</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1424995">टीम प्लॅनर</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22735_1054767_1206487"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows the application of tags to individual Outlook items to specify retention policy for that message, conversation or other item.</descrip></descripGrp><ntig><termGrp><term id="1054767">Retention Policy</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1206487">धारणा नीति</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22771_1054905_1962084"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user interface implemented by a software application via a component of a web server, such as IIS.</descrip></descripGrp><ntig><termGrp><term id="1054905">web portal</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1962084">वेब पोर्टल</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22781_1054938_2290194"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To permit someone else to perform an action.</descrip></descripGrp><ntig><termGrp><term id="1054938">allow</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2290194">परवानगी द्या</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2279_26594_467225"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A piece of software that functions as an electronic calendar used for scheduling.</descrip></descripGrp><ntig><termGrp><term id="26594">calendar program</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="467225">दिनदर्शिका कार्यक्रम</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2279_26594_468588"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A piece of software that functions as an electronic calendar used for scheduling.</descrip></descripGrp><ntig><termGrp><term id="26594">calendar program</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="468588">दिनदर्शिका</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2279_294450_467225"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A piece of software that functions as an electronic calendar used for scheduling.</descrip></descripGrp><ntig><termGrp><term id="294450">calendar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="467225">दिनदर्शिका कार्यक्रम</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2279_294450_468588"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A piece of software that functions as an electronic calendar used for scheduling.</descrip></descripGrp><ntig><termGrp><term id="294450">calendar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="468588">दिनदर्शिका</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22798_1055051_2700998"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A microprocessor architecture developed in 1992 by Motorola and IBM, with some participation by Apple. A PowerPC microprocessor is RISC-based and superscalar, with a 64-bit data bus and 32-bit address bus. It also has separate data and instruction caches, although the size of each varies by implementation. All PowerPC microprocessors have multiple integer and floating-point units. The voltage and operating speed varies with the implementation. Starting with the PowerPC 740, the microprocessors were manufactured with copper, instead of aluminum, for better performance and reliability.</descrip></descripGrp><ntig><termGrp><term id="1055051">PowerPC</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2700998">PowerPC</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22823_1055132_1206488"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The navigation button used to return to recently visited Web pages in Internet Explorer, Microsoft Edge, and other internet browsers.</descrip></descripGrp><ntig><termGrp><term id="1055132">Back</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1206488">मागे</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22826_1055147_1959125"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A staging area that contains representations of selected objects and attributes in a connected data source.</descrip></descripGrp><ntig><termGrp><term id="1055147">connector space</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1959125">कनेक्टर स्थान</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22828_1055149_1959255"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The data store that is used by ILM to contain the aggregated identity information from multiple connected data sources, providing a single global, integrated view of all combined objects.</descrip></descripGrp><ntig><termGrp><term id="1055149">metaverse</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1959255">metaverse</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2285_109836_1879376"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A join in which records from a table are combined with other records from the same table when there are matching values in the joined fields. A self-join can be an inner join or an outer join. In database diagrams, a self-join is called a reflexive relationship.</descrip></descripGrp><ntig><termGrp><term id="109836">self-join</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1879376">स्वयं-जोडलेली</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22865_1055946_1206489"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Information that describes the current location of a computer. The location is entered manually in Default Location, and can be used by programs to determine the location of a computer when a location sensor is unavailable.</descrip></descripGrp><ntig><termGrp><term id="1055946">default location</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1206489">डिफॉल्ट स्थान</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22886_1056046_1962060"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A software system that retrieves information from a source data store and synchronizes (pushes) to a target data store. Examples of synchronization engines are the ILM 2007 and FIM 2010 synchronization engines, and the service that synchronizes data rows in the SQL Server Express database with objects in the Microsoft Office Outlook data store.</descrip></descripGrp><ntig><termGrp><term id="1056046">synchronization engine</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1962060">सिंक्रोनायझेशन इंजिन</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22886_1056047_1962060"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A software system that retrieves information from a source data store and synchronizes (pushes) to a target data store. Examples of synchronization engines are the ILM 2007 and FIM 2010 synchronization engines, and the service that synchronizes data rows in the SQL Server Express database with objects in the Microsoft Office Outlook data store.</descrip></descripGrp><ntig><termGrp><term id="1056047">SyncEngine</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1962060">सिंक्रोनायझेशन इंजिन</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22889_1056052_1962040"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To refuse to accept a file or message.</descrip></descripGrp><ntig><termGrp><term id="1056052">reject</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1962040">अस्वीकृत करा</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2290_103825_467778"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Generally, any part of a computer system or network, such as a disk drive, printer, or memory, that can be allotted to a running program or a process.</descrip></descripGrp><ntig><termGrp><term id="103825">resource</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="467778">संसाधन</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22904_1056071_1959105"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of components and services that enable users to access their Exchange mailboxes through the Outlook Web Access application.</descrip></descripGrp><ntig><termGrp><term id="1056071">Client Access server</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1959105">क्लायंट ऍक्सेस सर्व्हर</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2291_184207_1879507"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The hierarchical HTML tag structure of an opened HTML document that appears in a task pane window.</descrip></descripGrp><ntig><termGrp><term id="184207">tag tree</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1879507">टॅग ट्री</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22911_1056204_1206490"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A term that can be added to a search to filter the results by a specific property (for example, by author). Relevant search filters appear under the search box in any open folder.</descrip></descripGrp><ntig><termGrp><term id="1056204">search filter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1206490">फिल्टर शोधा</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22911_1056204_1268562"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A term that can be added to a search to filter the results by a specific property (for example, by author). Relevant search filters appear under the search box in any open folder.</descrip></descripGrp><ntig><termGrp><term id="1056204">search filter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1268562">शोध फिल्टर</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22919_1056243_1959067"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of Internet Protocol subnets, usually used to connect a group of computers that are physically close to each other.</descrip></descripGrp><ntig><termGrp><term id="1056243">Active Directory site</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1959067">Active Directory साइट</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22926_1056255_1959064"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of sign-in credentials (username and password) for an Active Directory account.</descrip></descripGrp><ntig><termGrp><term id="1056255">Active Directory credentials</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1959064">Active Directory क्रेडेंशियल्स</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22928_1056257_1959061"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The identity of a user, which can be used to grant access to resources or authority to perform certain tasks.</descrip></descripGrp><ntig><termGrp><term id="1056257">Active Directory account</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1959061">Active Directory खाते</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2293_79701_467635"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A rectangular bar displayed in an application's window, often at the top, from which menus can be selected by the user.</descrip></descripGrp><ntig><termGrp><term id="79701">menu bar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="467635">मेनू पट्‍टी</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22931_1056336_1206491"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of corruption that affects the data in the Windows heap, such as damages caused by a buffer overrun, writing to a stray pointer or a double-free.</descrip></descripGrp><ntig><termGrp><term id="1056336">heap corruption</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1206491">हीप करप्शन</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22944_1056351_1206492"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A soft keyboard that is displayed with a different set of settings by default (larger buttons, bigger size, etc.) when you launch the Tablet PC Input Panel with touch. This is to facilitate touch input.</descrip></descripGrp><ntig><termGrp><term id="1056351">touch keyboard</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1206492">स्पर्श कीबोर्ड</term><termNote type="geographicalUsage">IND</termNote><termNote type="pa