ech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2739788">माझ्या शिफ्टची देवाणघेवाण करा</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42431_2400569_2739768"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The StaffHub view where users can request that another employee accept a shift offer created by them.</descrip></descripGrp><ntig><termGrp><term id="2400569">Offer my shift</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2739768">माझी शिफ्ट ऑफर करा</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42445_2404433_2410253"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office setting that will save a user's work automatically without him/her needing to use the save button or ctrl+s and that works across apps and across platforms.</descrip></descripGrp><ntig><termGrp><term id="2404433">AutoSave</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2410253">स्वयं जतन</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><