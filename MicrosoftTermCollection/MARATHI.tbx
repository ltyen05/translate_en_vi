ech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1959169">डंपस्‍टर</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13537_1018_1651175"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A string that identifies a user so that the user can receive Internet email and typically consists of an account name, followed by the @ (at) symbol, a host name, and a domain name.</descrip></descripGrp><ntig><termGrp><term id="1018">address</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1651175">ईमेल पत्ता</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13537_1018_467012"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A string that identifies a user so that the user can receive Internet email and typically consists of an account name, followed by the @ (at) symbol, a host name, and a domain name.</descrip></descripGrp><ntig><termGrp><term id="1018">address</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="467012">ई-मेल पत्ता</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEnt