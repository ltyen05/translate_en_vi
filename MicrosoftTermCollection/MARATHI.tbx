ermNote></termGrp></ntig></langSet></termEntry><termEntry id="3366_1413164_467014"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process of converting readable data (plaintext) into a coded form (ciphertext) to prevent it from being read by an unauthorized party.</descrip></descripGrp><ntig><termGrp><term id="1413164">encipherment</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="467014">एनक्रिप्शन</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3366_694688_467014"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process of converting readable data (plaintext) into a coded form (ciphertext) to prevent it from being read by an unauthorized party.</descrip></descripGrp><ntig><termGrp><term id="694688">data encryption</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="467014">एनक्रिप्शन</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3367_297187_468615"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Software designed to provide access to a computer from a remote location. These programs are often installed by the computer owner or administrator, and are only a risk if unexpected.</descrip></descripGrp><ntig><termGrp><term id="297187">remote control software</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="468615">रिमोट कंट्रोल सॉफ्टवेअर</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33697_1808999_2021150"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To put your finger on a touchscreen and then swipe it quickly, lifting your finger off the screen, in the direction you want.</descrip></descripGrp><ntig><termGrp><term id="1808999">flick</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2021150">फ्लिक करा</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33700_1809907_2075915"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Skype feature that allows users to call directly from Skype to landlines and mobile phones.</descrip></descripGrp><ntig><termGrp><term id="1809907">call phones</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2075915">कॉल फोन</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33701_1809933_2076007"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables the user to store video clips.</descrip></descripGrp><ntig><termGrp><term id="1809933">video storage</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2076007">व्हिडिओ संग्रह</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33702_1810821_2075994"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The document that covers how users may use Skype software, Skype products, and the Skype website.</descrip></descripGrp><ntig><termGrp><term id="1810821">Terms of Use</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2075994">सेवा अटी</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33703_1810823_2075986"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables the user to connect to public WiFi hotspots, paying per minute with Skype Credit.</descrip></descripGrp><ntig><termGrp><term id="1810823">Skype WiFi</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2075986">Skype WiFi</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3