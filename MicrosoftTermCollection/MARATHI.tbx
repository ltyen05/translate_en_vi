pe="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2065549">PST आयात</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35632_2045864_2047760"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A HIP challenge that requires a user to view an image and then type a set of characters contained in that image.</descrip></descripGrp><ntig><termGrp><term id="2045864">visual challenge</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2047760">दृश्‍य आव्‍हान</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35633_2045865_2047753"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A security task that a user must complete to verify they are a human and not a machine.</descrip></descripGrp><ntig><termGrp><term id="2045865">challenge</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2047753">आव्हान</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35636_2277612_2281429"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Office 365 subscription service for nonprofit organizations (up to 5 PCs, Macs, or mobile devices) that includes Word, PowerPoint, Excel, Outlook, OneNote, Publisher, Access, and Lync.</descrip></descripGrp><ntig><termGrp><term id="2277612">Office 365 ProPlus for Nonprofits</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2281429">नानफ्यांसाठी Office 365 ProPlus</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35645_2046828_2601693"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">All data, including all text, sound, image files, or software, given to Microsoft by, or on behalf of, Customer or its Affiliates through use of an Online Service or in connection with Professional Services.</descrip></descripGrp><ntig><termGrp><term id="2046828">customer data</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2601693">ग्राहक डेटा</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3566_134897_467950"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to a disk to which content cannot be recorded.</descrip></descripGrp><ntig><termGrp><term id="134897">write-protected</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="467950">लेखन-संरक्षित</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3567_320423_468846"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The × character.</descrip></descripGrp><ntig><termGrp><term id="320423">multiplication sign</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="468846">गुणाकार चिन्ह</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3567_320424_468846"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The × character.</descrip></descripGrp><ntig><termGrp><term id="320424">MULTIPLICATION SIGN</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="468846">गुणाकार चिन्ह</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3568_234787_468361"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file backup feature that performs scheduled incremental backups of data to the target media. It also allows the user to restore an individual file or a group of files.</descrip></descripGrp><ntig><termGrp><term id="234787">Windows Backup</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="468361">Windows बॅकअप</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35685_2052902_2071498"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A licensing mode that enables Office 365 subscribers to access their account from different computers and that allows multiple users belonging to the same subscription to log in and use their account from the same computer.</descrip></descripGrp><ntig><termGrp><term id="2052902">shared computer activation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2071498">सामायिक केलेले कॉम्‍प्‍यूटर सक्रीयकरण</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35685_2488791_2071498"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A licensing mode that enables Office 365 subscribers to access their account from different computers and that allows multiple users belonging to the same subscription to log in and use their account from the same computer.</descrip></descripGrp><ntig><termGrp><term id="2488791">SCA</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2071498">सामायिक केलेले कॉम्‍प्‍यूटर सक्रीयकरण</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">N