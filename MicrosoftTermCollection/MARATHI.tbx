The feature that helps to isolate enterprise-defined untrusted sites based on a list of trusted web sites, cloud resources and internal networks defined by an enterprise administrator. Everything not on that list is considered untrusted.</descrip></descripGrp><ntig><termGrp><term id="2795831">Microsoft Defender Application Guard</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2723466">अ‍ॅप्लिकेशन गार्ड</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43468_2795831_2800212"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that helps to isolate enterprise-defined untrusted sites based on a list of trusted web sites, cloud resources and internal networks defined by an enterprise administrator. Everything not on that list is considered untrusted.</descrip></descripGrp><ntig><termGrp><term id="2795831">Microsoft Defender Application Guard</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2800212">Microsoft Defender अ‍ॅप्लिकेशन गार्ड</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43471_2795848_2800214"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The name of a Windows feature that enables IT to lock down devices so they can only use trusted devices and peripherals, and provides the capability to isolate parts of the operating system by using virtualization-based security (VBS).​</descrip></descripGrp><ntig><termGrp><term id="2795848">Microsoft Defender Device Control</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2800214">Microsoft Defender डिव्हाइस नियंत्रण</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43472_2795843_2800216"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The umbrella name for the Windows vulnerability mitigation features designed to address inherently technical attacks and prevent discovered vulnerabilities from being exploited.</descrip></descripGrp><ntig><termGrp><term id="2795843">Microsoft Defender Exploit Guard</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2800216">Microsoft Defender एक्सप्लॉइट गार्ड</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4349_58489_1207763"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to an entire entity such as document, file, or program rather than to a restricted segment of it.</descrip></descripGrp><ntig><termGrp><term id="58489">global</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1207763">सर्वंकष</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43506_2462246_2466758"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The mixed-reality shell experience, in which content can be placed and used in virtual (or, in the case of HoloLens, real) surroundings.</descrip></descripGrp><ntig><termGrp><term id="2462246">mixed world</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2466758">मिश्रित जग</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4353_151854_2235026"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method of delivering digital media across a network in a continuous flow. The digital media is played by client software as it is received.</descrip></descripGrp><ntig><termGrp><term id="151854">streaming</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2235026">मीडिया प्रवाहन</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4353_2227182_2235026"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method of delivering digital media across a network in a continuous flow. The digital media is played by client software as it is received.</descrip></descripGrp><ntig><termGrp><term id="2227182">media streaming</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2235026">मीडिया प्रवाहन</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43582_2464277_2926629"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app destination for solutions that extend the capabilities of the technology you already own.</descrip></descripGrp><ntig><termGrp><term id="2464277">Microsoft AppSource</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2926629">Microsoft AppSource</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43582_2464281_2926629"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app destination for solutions that extend the capabilities of the technology you already own.</descrip></descripGrp><ntig><termGrp><term id="2464281">AppSource</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2926629">Microsoft AppSource</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43608_2464387_2466757"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A UI screen that appears in the Network flyout when a paid Wi-Fi hotspot is in range and paid Wi-Fi plans are available from Windows Store. A customer can then tap Connect with a data plan to open the Paid Wi-Fi &amp; Cellular app, choose a paid Wi-Fi data plan that’s offered from Windows Store, and then buy a plan using the payment information that’s stored in their Microsoft account.</descrip></descripGrp><ntig><termGrp><term id="2464387">Connect with a data plan</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2466757">डेटा योजनेसह कनेक्ट करा</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4362_153205_1268841"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A high-speed Internet connection. Broadband connections are typically 256 kilobytes per second (KBps) or faster.</descrip></descripGrp><ntig><termGrp><term id="153205">broadband connection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1268841">ब्रॉडबँड जोडणी</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43627_2465102_2470741"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Any very simple computer program that outputs or displays the words "Hello World" in some form to the user. Such a program is often created as an example, to introduce the basic syntax of a programming language to students or others new to that language.</descrip></descripGrp><ntig><termGrp><term id="2465102">Hello World</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2470741">हॅलो वर्ल्ड</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43628_2781062_2782437"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The offer for OneDrive for Business that includes Office Online and that is available through the User purchase subscription program.</descrip></descripGrp><ntig><termGrp><term id="2781062">OneDrive for Business with Office on the web (user purchased)</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2782437">वेबवरील Office सह OneDrive for Business (प्रयोक्‍त्‍याने खरेदी केलेले)</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43662_2465860_2517582"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A web application on Xbox.com that allows Xbox One or PC gamers to design and purchase their own Xbox Wireless controller.</descrip></descripGrp><ntig><termGrp><term id="2465860">Xbox Design Lab</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></nti