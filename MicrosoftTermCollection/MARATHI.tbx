 xml:lang="mr"><ntig><termGrp><term id="468075">टॉगल बटण</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11310_232414_468304"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to items that occur repeatedly. For example, an appointment or task that occurs on a regular basis, such as a weekly status meeting or a monthly haircut, can be designated as recurring.</descrip></descripGrp><ntig><termGrp><term id="232414">recurring</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="468304">वारंवार येणारे</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11311_297189_1268896"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Software that changes settings without adequate consent.</descrip></descripGrp><ntig><termGrp><term id="297189">settings modifier</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1268896">सेटिंग्स परिवर्तक</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11312_149466_468080"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An action query that changes a set of records according to criteria you specif