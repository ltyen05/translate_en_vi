035_1880045"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that extends AutoComplete functionality to show a live preview of suggested values for an entire range of cells based on what the user is typing.</descrip></descripGrp><ntig><termGrp><term id="1641035">Flash Fill</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1880045">फ्लॅश फिल</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32224_1641036_1950829"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Collections of proofing tools for different languages that that are available to users of Office applications.</descrip></descripGrp><ntig><termGrp><term id="1641036">Microsoft Office Proofing Tools</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1950829">Microsoft Office लेखन शोधक साधने</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32225_1718117_1880134"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of controls that helps users navigate directly to where they want to go in SharePoint, without having to navigate the hierarchy or edit the URL.</descrip></descripGrp><ntig><termGrp><term id="1718117">Search-Driven Navigation</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet>