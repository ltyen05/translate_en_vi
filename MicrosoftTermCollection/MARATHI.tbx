ia Skype for Business.</descrip></descripGrp><ntig><termGrp><term id="2242121">Skype for Business conversations</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2261587">Skype for Business संभाषणे</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38562_2242136_2253680"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The web page were users can find and modify all of their Office 365 settings.</descrip></descripGrp><ntig><termGrp><term id="2242136">Office 365 settings</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2253680">Office 365 सेटिंग्ज</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38563_2242141_2253691"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The pane held in the flex pane that contains the top Office 365 settings as well as contextual settings based on what Microsoft service you are currently using.</descrip></descripGrp><ntig><termGrp><term id="2242141">Settings pane</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2253691">सेटिंग्ज उपखंड</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="g