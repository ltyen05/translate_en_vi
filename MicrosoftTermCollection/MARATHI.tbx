Set xml:lang="mr"><ntig><termGrp><term id="467059">परवानगी</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13219_3051_468729"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Authorization to perform operations associated with a specific shared resource, such as a file, directory, or printer and that must be granted by the system administrator to individual user accounts or administrative groups.</descrip></descripGrp><ntig><termGrp><term id="3051">permissions</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="468729">ऍक्सेस परवानगी</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13219_315150_467059"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Authorization to perform operations associated with a specific shared resource, such as a file, directory, or printer and that must be granted by the system administrator to individual user accounts or administrative groups.</descrip></descripGrp><ntig><termGrp><term id="315150">access permissions</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="467059">परवानगी</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13219_315150_468729"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Authorization to perform operations associated with a specific shared resource, such as a file, directory, or printer and that must be granted by the system administrator to individual user accounts or administrative groups.</descrip></descripGrp><ntig><termGrp><term id="315150">access permissions</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="468729">ऍक्सेस परवानगी</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13220_210458_1879517"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An option that changes a 2-dimensional linear expression, such as 5^2, to a built-up (3-dimensional) format.</descrip></descripGrp><ntig><termGrp><term id="210458">linear expression</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1879517">रेखीय पदावली</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13221_50960_1961758"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ultimate user of a computer or computer application in its finished, marketable form.</descrip></descripGrp><ntig><termGrp><term id="50960">end user</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="19617