"><ntig><termGrp><term id="467767">रेकॉर्ड</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7749_99659_468583"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of related fields (columns) of information treated as a unit and arranged in a horizontal line in a table or spreadsheet.</descrip></descripGrp><ntig><termGrp><term id="99659">record</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="468583">पंक्ति</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7753_42713_1879345"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A bar, area, dot, slice, or other symbol in a chart that represents a single data point or value.</descrip></descripGrp><ntig><termGrp><term id="42713">data marker</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1879345">डेटा चिन्हक</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="776_149884_468082"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of comments that users attach to web pages and documents.</descrip></descripGrp><ntig><termGrp><term id="149884">Web discussion</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="468082">वेब चर्चा</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7764_1975517_1981871"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A hard disk that contains a small amount of solid-state nonvolatile memory which, when used as a cache, can realize significant benefits such as faster booting, extended battery life, and a more rugged PC.</descrip></descripGrp><ntig><termGrp><term id="1975517">hybrid drive</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1981871">हायब्रिड ड्राइव</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7764_314130_1981871"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A hard disk that contains a small amount of solid-state nonvolatile memory which, when used as a cache, can realize significant benefits such as faster booting, extended battery life, and a more rugged PC.</descrip></descripGrp><ntig><termGrp><term id="314130">hybrid hard disk</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1981871">हायब्रिड ड्राइव</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7764_366903_1981871"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A hard disk that contains a small amount of solid-state nonvolatile memory which, when used as a cache, can realize significant benefits such as faster booting, extended battery life, and a more rugged PC.</descrip></descripGrp><ntig><termGrp><term id="366903">hybrid disk</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1981871">हायब्रिड ड्राइव</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7781_179526_468168"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A control (composed of a text box and spin button control) that allows a user to adjust a value from a limited range of possible values.</descrip></descripGrp><ntig><termGrp><term id="179526">spin box</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="468168">स्पिन बॉक्स</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7785_120062_467860"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The bar that contains the 'Start' button and appears by default at the bottom of the desktop. You can click the taskbar buttons to switch between programs. You can also hide the taskbar, move it to the sides or top of the desktop, and customize it in other ways.</descrip></descripGrp><ntig><termGrp><term id="120062">taskbar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="467860">कार्य पट्‍टी</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7785_2785563_467860"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The bar that contains the 'Start' button and appears by default at the bottom of the desktop. You can click the taskbar buttons to switch between programs. You can also hide the taskbar, move it to the sides or top of the desktop, and customize it in other ways.</descrip></descripGrp><ntig><termGrp><term id="2785563">task bar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="467860">कार्य पट्‍टी</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7797_54308_467459"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In an operating system, the overall structure in which files are named, stored, and organized. NTFS, FAT, and FAT32 are types of file systems.</descrip></descripGrp><ntig><termGrp><term id="54308">file system</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="467459">फाइल सिस्टम</term><termNote type="geographicalUsage">IND</termNote><termNote type="partO