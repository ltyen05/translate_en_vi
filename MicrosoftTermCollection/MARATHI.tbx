69326_468549"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The proprietary protocol to provide remote display and input capabilities over network connections for Windows-based applications between two computers.</descrip></descripGrp><ntig><termGrp><term id="269326">Remote Desktop Protocol</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="468549">RDP</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8595_269327_468548"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The proprietary protocol to provide remote display and input capabilities over network connections for Windows-based applications between two computers.</descrip></descripGrp><ntig><termGrp><term id="269327">RDP</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="468548">रिमोट डेस्कटॉप प्रोटोकॉल</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8595_269327_468549"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The proprietary protocol to provide remote display and input capabilities over network connections for Windows-based applications between two computers.</descrip></descripGrp><ntig><termGrp><term id="269327">RDP</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="468549">RDP</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8600_37568_1268869"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Of, pertaining to, or characteristic of an action or operation that takes place based on whether or not a certain condition is true.</descrip></descripGrp><ntig><termGrp><term id="37568">conditional</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1268869">सशर्त</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8609_2856023_2574841"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Any of a family of processes that software developers use to minimize risk by developing applications incrementally, over a series of short iterations. In this model, real-time communications, such as in person conversations and telephone calls, are preferred over written documentation; the primary measure of progress is working software, instead of hours spent, tasks completed, documents reviewed, or phases signed-off; stakeholders are expected to collaborate, instead of negotiating; and planning happens continuously in order to respond to change.</descrip></descripGrp><ntig><termGrp><term id="2856023">Agile methodology</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2574841">अजाइक पद्धत</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8609_460694_2574841"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Any of a family of processes that software developers use to minimize risk by developing applications incrementally, over a series of short iterations. In this model, real-time communications, such as in person conversations and telephone calls, are preferred over written documentation; the primary measure of progress is working software, instead of hours spent, tasks completed, documents reviewed, or phases signed-off; stakeholders are expected to collaborate, instead of negotiating; and planning happens continuously in order to respond to change.</descrip></descripGrp><ntig><termGrp><term id="460694">Agile method</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2574841">अजाइक पद्धत</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8612_173657_1961988"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Application software that gathers data from the user, prepares it for the server, and issues a request to the server. The client presents data received from the server to the user through its own user interface.</descrip></descripGrp><ntig><termGrp><term id="173657">client application</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1961988">क्लायंट अनुप्रयोग</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8614_358362_1959096"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An item in the Exchange store that represents an appointment, a meeting, a meeting request, or an event. It can identify the place, resources, recurrence, and attendees involved at a discrete time.</descrip></descripGrp><ntig><termGrp><term id="358362">calendar item</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1959096">दिनदर्शिका आयटम</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8641_184378_468199"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The permission setting that permits a person or domain to add the user to contact lists, see the user's status, or send instant messages to the user.</descrip></descripGrp><ntig><termGrp><term id="184378">Allow</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="468199">परवानगी द्या</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8643_44563_467368"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To put into use.</descrip></descripGrp><ntig><termGrp><term id="44563">deploy</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="467368">डिप्लॉय करा</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8644_185806_1959345"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A UI element that ends a user session or exits a service.</descrip></descripGrp><ntig><termGrp><term id="185806">Sign Out</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1959345">साइन आउट</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8657_2140019_1207808"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The person in charge of managing a computer. The administrator is responsible for installing software, assigning passwords, and managing files.</descrip></descripGrp><ntig><termGrp><term id="2140019">admin</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1207808">संगणक प्रशासक</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8657_2140019_467120"><lan