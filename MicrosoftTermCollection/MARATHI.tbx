/termGrp></ntig></langSet></termEntry><termEntry id="15140_320449_468847"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The € character.</descrip></descripGrp><ntig><termGrp><term id="320449">euro symbol</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="468847">यूरो प्रतीक</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15140_320450_468847"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The € character.</descrip></descripGrp><ntig><termGrp><term id="320450">EURO SIGN</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="468847">यूरो प्रतीक</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15144_346594_468945"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The time for which a dry or alkaline cell is able to produce an electric current before it needs to be replaced.</descrip></descripGrp><ntig><termGrp><term id="346594">battery life</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="468945">बॅटरी आयु</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15151_68314_467544"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Characterized by conversational exchange of input and output, as when a user enters a question or command and the system immediately responds. The interactivity of microcomputers is one of the features that makes them approachable and easy to use.</descrip></descripGrp><ntig><termGrp><term id="68314">interactive</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="467544">परस्परसंवादी</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15153_304427_1206262"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An exponentiation operator used in some programming languages. For example, the expression 3^2 represents the number 3 raised to the second power.</descrip></descripGrp><ntig><termGrp><term id="304427">caret</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1206262">कॅरेट</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15181_84318_2217165"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A link between a user's computer and a group of computers and other devices that enables the user to access printers, servers etc. The link can be through a wire, cable, phone line or wireless transmissions.</descrip></descripGrp><ntig><termGrp><term id="84318">network connection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2217165">नेटवर्क कनेक्शन</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15190_235033_1207862"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A device that creates or initiates requests or events.</descrip></descripGrp><ntig><termGrp><term id="235033">initiator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1207862">प्रारंभ करणारा</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15190_235033_468377"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A device that creates or initiates requests or events.</descrip></descripGrp><ntig><termGrp><term id="235033">initiator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="468377">इनिशिएटर</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15201_36468_467308"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to a product that can work with or is equivalent to an