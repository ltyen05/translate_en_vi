party providers.</descrip></descripGrp><ntig><termGrp><term id="3046579">Operator Connect Accelerator</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="3048728">ऑपरेटर कनेक्ट अ‍ॅक्सलरेटर</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53509_3047005_3047900"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The period of time that a user has had an Xbox Live account, displayed on the user's Xbox console.</descrip></descripGrp><ntig><termGrp><term id="3047005">tenure</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="3047900">कार्यकाळ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53510_3047006_3047887"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To make changes to a video game or piece of computer equipment. [Short for "modify"]</descrip></descripGrp><ntig><termGrp><term id="3047006">mod</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="3047887">सुधारित करा</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEnt