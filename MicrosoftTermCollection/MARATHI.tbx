mber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2353689">फीडबॅक हब</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40502_2353112_2353691"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app that consumers can use to send feedback to the Windows team, to check for responses to that feedback, and to get news about the latest updates.</descrip></descripGrp><ntig><termGrp><term id="2353112">Windows Feedback Hub</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2353691">Windows फीडबॅक हब</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40502_2353113_2353689"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app that consumers can use to send feedback to the Windows team, to check for responses to that feedback, and to get news about the latest updates.</descrip></descripGrp><ntig><termGrp><term id="2353113">Feedback Hub</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2353689">फीडबॅक हब</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40502_2353113_2353691"><