termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2815_362568_1268404"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A security solution that segregates one portion of a network from another portion, allowing only authorized network traffic to pass through according to traffic filtering rules.</descrip></descripGrp><ntig><termGrp><term id="362568">security-edge gateway</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1268404">फायरवॉल</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28152_1468775_2076001"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tax on products at each stage of their production based on the value added during that stage.</descrip></descripGrp><ntig><termGrp><term id="1468775">VAT</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2076001">VAT</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2820_206426_468213"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Windows Presentation Foundation, an event routing strategy where the event instance moves down the element tree (starting at the root of the visual tree and ending with the source). The names of events that use this routing strategy are prefixed with the word "Preview". These events have the same signature as their counterparts that use the bubbling event routing strategy.</descrip></descripGrp><ntig><termGrp><term id="206426">tunneling</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="468213">टनेलिंग</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28204_1475084_1879901"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The upper limit in a permitted range of values.</descrip></descripGrp><ntig><termGrp><term id="1475084">upper bound</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1879901">उच्च सीमा</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2824_2685641_467529"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A listing of keywords and associated data that point to the location of more comprehensive information, such as files and records on a disk or record keys in a database.</descrip></descripGrp><ntig><termGrp><term id="2685641">search index</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="467529">अनुक्रमणिका</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Femini