rip></descripGrp><ntig><termGrp><term id="1496237">Microsoft Windows SharePoint Services</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1962023">Microsoft Windows SharePoint सर्व्हिसेस</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1254_1496237_1962087"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A family of Microsoft Web-based team collaboration environments that provide the ability to create and access virtual workspaces for managing documents, discussions, lists, surveys and other important contextual information such as team member status and presence.</descrip></descripGrp><ntig><termGrp><term id="1496237">Microsoft Windows SharePoint Services</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1962087">Windows SharePoint सर्व्हिस</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1254_415809_1962023"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A family of Microsoft Web-based team collaboration environments that provide the ability to create and access virtual workspaces for managing documents, discussions, lists, surveys and other important contextual information such as team member status and presence.</descrip></descripGrp><ntig><termGrp><term id="415809">Windows SharePoint Services</term><termNote type="partOfSpeech">Pro