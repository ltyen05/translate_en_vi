><term id="2337457">SMS सतर्कता</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40041_2329143_2337456"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Skype call hosted by one user where lots of other users can join and participate in</descrip></descripGrp><ntig><termGrp><term id="2329143">Skypecast</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2337456">Skypecast</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40043_2329145_2337454"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application that can be installed on any mobile or landline in any supported country. It provides users with numbers that let them call friends, family and colleagues abroad from any mobile or landline while avoiding international calling charges.</descrip></descripGrp><ntig><termGrp><term id="2329145">Skype to Go</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2337454">Skype टू गो</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40044_2329146_2337453"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A web-based meeting scheduling and management tool. With Skype for Business Web Scheduler, you can create new meetings, change your existing meetings, and send invitations using your favorite email program.</descrip></descripGrp><ntig><termGrp><term id="2329146">Skype for Business Web Scheduler</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2337453">Skype for Business वेब शेड्यूलर</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40045_2329147_2337452"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An add-on for Skype for Business Online that provides phone capabilities.</descrip></descripGrp><ntig><termGrp><term id="2329147">Skype for Business Online Phone Add-on</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2337452">Skype for Business ऑनलाइन फोन ऍड-ऑन</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40046_2329148_2337451"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Skype for Business app for use on mobile devices</descrip></descripGrp><ntig><termGrp><term id="2329148">Skype for Business Mobile app</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2337451">Skype for Business मोबाईल अनुप्रयोग</term><termNote typ