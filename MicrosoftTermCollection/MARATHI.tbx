mNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2645355">घोषणा</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43790_2470567_2645448"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Kaizala Action that allows users to create and assign jobs, as well as track their progress.</descrip></descripGrp><ntig><termGrp><term id="2470567">Job</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2645448">कार्य</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43791_2470568_2645450"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Kaizala Action that allows users to send meeting invites and confirm availability of the invitees.</descrip></descripGrp><ntig><termGrp><term id="2470568">Let's Meet</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2645450">चला भेटूया</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43792_2470569_2645451"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Kaizala Action that allows users to request the current location of other users and view their trip progress in real time.</descrip></descripGrp><ntig><termGrp><term id="2470569">Live Location</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2645451">सध्याचे ठिकाण</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43793_2470571_2645447"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Kaizala view where users can select from the available features.</descrip></descripGrp><ntig><termGrp><term id="2470571">Discover</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2645447">शोधणे</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43794_2470573_2645455"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Kaizala Action that allows users to share their current location with other users as well as their trip progress in real time.</descrip></descripGrp><ntig><termGrp><term id="2470573">Share Location</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2645455">स्थान शेअर करा</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43795_2470574_2645454"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Kaizala feature that allows users to request to see the time slots that other users have available to meet or chat.</descrip></descripGrp><ntig><termGrp><term id="2470574">Request Availability</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2645454">उपलब्धतेबाबतची विनंती</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43799_2470927_2472117"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The lightweight markup language with plain text formatting syntax designed to be converted to HTML and other formats and that is used to format readme files, write messages in online discussion forums, and create rich text using a plain text editor.</descrip></descripGrp><ntig><termGrp><term id="2470927">Markdown</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2472117">Markdown</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43800_2470929_2472118"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Word add-in that converts Markdown documents to Word format for e