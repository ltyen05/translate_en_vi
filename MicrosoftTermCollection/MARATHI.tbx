</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="3072399">स्टॉक व्हिडिओ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53737_3060423_3072396"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An audio clip from a library of professional stock assets that is integrated in the Clipchamp video editor for use in editing projects.</descrip></descripGrp><ntig><termGrp><term id="3060423">stock audio</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="3072396">स्टॉक ऑडिओ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53738_3060424_3072397"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An image/photo from a library of professional stock assets that is integrated in the Clipchamp video editor for use in editing projects.</descrip></descripGrp><ntig><termGrp><term id="3060424">stock image</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="3072397">स्टॉक प्रतिमा</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53739_3060425_3067617"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of visual elements such as animated clips, GIFs, images, colored backgrounds or overlays that are used in video editing projects.</descrip></descripGrp><ntig><termGrp><term id="3060425">graphics</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="3067617">ग्राफिक्स</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53740_3060426_3072395"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An animated or still image such as a cartoon figure that can be inserted in video editing projects.</descrip></descripGrp><ntig><termGrp><term id="3060426">sticker</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="3072395">स्टिकर</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53741_3060427_3070600"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The name of an aspect ratio preset in Clipchamp that lets users create videos that have the correct height and width to be uploaded as videos on popular social media platforms.</descrip></descripGrp><ntig><termGrp><term id="3060427">Social</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><te