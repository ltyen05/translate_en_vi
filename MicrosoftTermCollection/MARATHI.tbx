ip type="definition">A domain controller that holds a copy of the global catalog for the forest.</descrip></descripGrp><ntig><termGrp><term id="58539">global catalog server</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1206159">समान केटालॉग सर्व्हर</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6374_58539_1268424"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A domain controller that holds a copy of the global catalog for the forest.</descrip></descripGrp><ntig><termGrp><term id="58539">global catalog server</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1268424">ग्लोबल केटालॉग सर्व्हर</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6378_7117_1795420"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An entry in either a securable object's discretionary access control list (DACL) or an object's system access control list (SACL). In a DACL, the entry grants or denies permissions to a user or group. In a SACL, the entry specifies which security events to audit for a particular user or group or controls the Windows Integrity Level for the object.</descrip></descripGrp><ntig><termGrp><term id="7117">access control entry</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></