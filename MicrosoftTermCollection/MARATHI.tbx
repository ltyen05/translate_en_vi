</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2461072">मार्गदर्शन नेव्हिगेशन</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35716_2065926_2360605"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature where users can add contacts that they call frequently so that they can get to their numbers quickly rather than going through the Contact list in People.</descrip></descripGrp><ntig><termGrp><term id="2065926">speed dial</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2360605">स्पीड डायल</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3573_73656_467581"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The protocol or protocols operating at a particular level within a protocol suite, such as IP within the TCP/IP suite.</descrip></descripGrp><ntig><termGrp><term id="73656">layer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="467581">थर</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35734_2067082_2217187"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that provi