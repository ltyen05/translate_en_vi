 type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2253685">पॅनोरमा</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38603_2244846_2253661"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Sway feature that allows a user to click on an embedded image to see any of the following: a high resolution version of it, a link to where the image was found, as well as related images.</descrip></descripGrp><ntig><termGrp><term id="2244846">Detail view</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2253661">तपशीलवार दृश्य</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38605_2244852_2253641"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Sway button that allows users to create a bulleted list out of their text.</descrip></descripGrp><ntig><termGrp><term id="2244852">Bulleted list</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2253641">बुलेट चिन्हांकित यादी</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38625_2244876_225367