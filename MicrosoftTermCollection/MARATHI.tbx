 type="definition">A privacy setting that allows the operating system, apps, and services to detect a user's approximate location (within several miles/km), without sharing their exact location.</descrip></descripGrp><ntig><termGrp><term id="2374281">general location</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2380116">सर्वसाधारण स्थान</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41856_2374312_2380115"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A location that you can set for your device that can be used by Windows, apps, and services when an exact location isn't available, such as on a desktop PC without GPS.​ ​</descrip></descripGrp><ntig><termGrp><term id="2374312">default location</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2380115">डीफॉल्ट स्थान</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41878_2897507_2897803"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The unified security platform for preventative protection, post-breach detection, automated investigation, and response.</descrip></descripGrp><ntig><termGrp><term id="2897507">Microsoft Defender for Endpoint</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"