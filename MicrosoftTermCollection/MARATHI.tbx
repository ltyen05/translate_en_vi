termEntry><termEntry id="45865_2582769_2603729"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A list of items that a customer has selected to purchase from a commerce Web site. It is usually compiled into a file and sometimes visually represented by a shopping bag.</descrip></descripGrp><ntig><termGrp><term id="2582769">shopping bag</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2603729">शॉपिंग कार्ट</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45865_2582770_2603729"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A list of items that a customer has selected to purchase from a commerce Web site. It is usually compiled into a file and sometimes visually represented by a shopping bag.</descrip></descripGrp><ntig><termGrp><term id="2582770">bag</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2603729">शॉपिंग कार्ट</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4587_137765_467974"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The underlying or original style on which other styles in a document are dependent. When you change a formatting element of the base style in a document, all other styles that originate from the base style will also reflect the change.</descrip></descripGrp><ntig><termGrp><term id="137765">base style</term