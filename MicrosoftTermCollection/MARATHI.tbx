.</descrip></descripGrp><ntig><termGrp><term id="319430">infrared</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="468841">इन्फ्रारेड</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15024_322622_468880"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A measure of processing power, given in megahertz (MHz).</descrip></descripGrp><ntig><termGrp><term id="322622">clock speed</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="468880">घड्‍याळ गती</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15026_26543_467223"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A field defined in a query that displays the result of an expression rather than displaying stored data. The value is recalculated each time a value in the expression changes.</descrip></descripGrp><ntig><termGrp><term id="26543">calculated field</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="467223">गणिती फिल्ड</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEn