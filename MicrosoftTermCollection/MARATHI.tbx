k champion badge over a profile image for display across the Microsoft 365 solutions.</descrip></descripGrp><ntig><termGrp><term id="3055646">Digital Badge</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="3056026">डिजिटल बॅज</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53678_3055647_3056030"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature in Champion Management Platform that enables adoption themed tournaments for the entire organization to participate in.</descrip></descripGrp><ntig><termGrp><term id="3055647">Tournament of Teams</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="3056030">संघांची स्पर्धा</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53679_3055653_3056028"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The group of community champions that participate in the Microsoft 365 Champion Program.</descrip></descripGrp><ntig><termGrp><term id="3055653">Microsoft 365 Champion Community</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="3056028">Microsoft 365 चॅम्पियन समुदाय</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech