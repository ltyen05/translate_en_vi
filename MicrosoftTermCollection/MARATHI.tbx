349281">Show likes</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2352501">पसंती दर्शवा</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40438_2349283_2352502"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A menu item connected the heart-feature, whereby a participant can remove a "heart" from a chat message, indicating that the participant does not like a chat message. The heart-feature refers to giving and removing hearts and is distinct from the Like-feature known from e.g. Facebook.</descrip></descripGrp><ntig><termGrp><term id="2349283">Unlike</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2352502">नापसंती द्या</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40439_2349284_2352496"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An amount of money added to an account.</descrip></descripGrp><ntig><termGrp><term id="2349284">credit</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2352496">क्रेडिट</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40440_2349285_2352497"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A menu item connected the heart-feature, whereby a participant can give a "heart" to a chat message, indicating that the participant likes a chat message. The heart-feature refers to giving and removing hearts and is distinct from the Like-feature known from e.g. Facebook.</descrip></descripGrp><ntig><termGrp><term id="2349285">Like</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2352497">पसंती द्या</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40441_2349286_2352498"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A list of hearts showing how many particpant have liked a chat message. The heart-feature refers to giving and removing hearts and is distinct from the Like-feature known from e.g. Facebook.</descrip></descripGrp><ntig><termGrp><term id="2349286">Likes</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2352498">पसंती</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40454_3113359_3113490"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The security service that provides a consolidated view into risk events and potential vulnerabilities affecting your organization’s identi