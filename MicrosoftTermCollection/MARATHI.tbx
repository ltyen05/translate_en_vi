 element that enables users to locate and select files.</descrip></descripGrp><ntig><termGrp><term id="1598627">file picker</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1641246">फाइल पिकर</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3131_12131_467131"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The &lt;&gt; characters.</descrip></descripGrp><ntig><termGrp><term id="12131">angle brackets</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="467131">कोनाकार कंस</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31311_1598845_1640648"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The activation of systems in an enterprise environment by using an established Active Directory implementation and the same key types.</descrip></descripGrp><ntig><termGrp><term id="1598845">Active Directory-based activation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1640648">Active Directory-आधारित सक्रियकरण</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSe