="mr"><ntig><termGrp><term id="1358092">फोन कॉल</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2425_34681_467291"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A predefined set of harmonized colors that you can apply to text and objects. Text and objects with an applied scheme color will change automatically when you switch to a new color scheme or modify the current color scheme.</descrip></descripGrp><ntig><termGrp><term id="34681">color scheme</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="467291">रंग योजना</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24254_1117166_2855803"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A device that connects networks using the same communications protocols so that information can be passed from one to the other.</descrip></descripGrp><ntig><termGrp><term id="1117166">bridge</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2855803">ब्रिज</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24287_1119142_1358202"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The button next to a search box that someone clicks to search for something.</descrip></descripGrp><ntig><termGrp><term id="1119142">Search button</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1358202">खोज बटन</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24287_1119142_1650633"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The button next to a search box that someone clicks to search for something.</descrip></descripGrp><ntig><termGrp><term id="1119142">Search button</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1650633">शोध बटण</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24288_1119143_1367880"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that displays a thumbnail preview next to each search result. Pointing to the preview enlarges it.</descrip></descripGrp><ntig><termGrp><term id="1119143">search preview</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1367880">शोध पूर्वावलोकन</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></