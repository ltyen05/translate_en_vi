Grp><term id="725782">email</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="468872">मेल</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10048_1167260_1424948"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An object (such as a customer, item, or employee) that shares a set of defined attributes or characteristics, and that is used to manage rules for data.</descrip></descripGrp><ntig><termGrp><term id="1167260">external content type</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1424948">एन्टिटि</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10048_1167260_1424949"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An object (such as a customer, item, or employee) that shares a set of defined attributes or characteristics, and that is used to manage rules for data.</descrip></descripGrp><ntig><termGrp><term id="1167260">external content type</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1424949">बाह्य सामुग्री प्रकार</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termN