ation to inform the user of recent events.</descrip></descripGrp><ntig><termGrp><term id="2306966">user notification badge</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2640996">बैज अधिसूचना</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39618_2635506_2640996"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A visual indication to inform the user of recent events.</descrip></descripGrp><ntig><termGrp><term id="2635506">notification badge</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2640996">बैज अधिसूचना</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3962_3044409_467641"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A dialog that requires the user to take some action before the focus can switch to another form or dialog box. Dialog boxes and messages are usually modal.</descrip></descripGrp><ntig><termGrp><term id="3044409">modal</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="467641">मोडल संवाद</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3962_81228_467641"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A dialog that requires the user to take some action before the focus can switch to another form or dialog box. Dialog boxes and messages are usually modal.</descrip></descripGrp><ntig><termGrp><term id="81228">modal dialog</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="467641">मोडल संवाद</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3967_93870_467742"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To submit content to an online forum for others to see.</descrip></descripGrp><ntig><termGrp><term id="93870">post</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="467742">पोस्ट करा</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39692_2308052_2311146"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mark or piece of information that you can add to a map, save, and share with others.</descrip></descripGrp><ntig><termGrp><term id="2308052">note</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2311146">नकाशा नोट</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</