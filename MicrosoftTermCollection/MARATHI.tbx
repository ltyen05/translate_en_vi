try id="6175_766467_1640907"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To transmit content such as a message or file through a communications channel.</descrip></descripGrp><ntig><termGrp><term id="766467">email</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1640907">ईमेल करा</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6175_766467_467801"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To transmit content such as a message or file through a communications channel.</descrip></descripGrp><ntig><termGrp><term id="766467">email</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="467801">पाठवा</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6177_264614_468514"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of merging information into a document from a data source, such as an address book or database, to create customized documents, such as form letters or mailing labels.</descrip></descripGrp><ntig><termGrp><term id="264614">mail merge</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="468514">मेल मर्ज</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6184_107441_467785"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To enlarge or reduce the display of an item, such as a drawing or a proportional character font, by adjusting its size proportionally.</descrip></descripGrp><ntig><termGrp><term id="107441">scale</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="467785">स्केल करा</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6186_418609_2075913"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A voice session that can be conducted between two or more telephones, two or more devices (such as computers or smartphones), or between two or more such devices and telephones.</descrip></descripGrp><ntig><termGrp><term id="418609">call</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2075913">कॉल</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6190_142020_1879435"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The small black square in the lower-right corner of a selected cell that can be used to copy data and to fill adjacent cells with a series of data.</descrip></descripGrp><ntig><termGrp><term id="142020">fill handle</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1879435">भरण हँडल</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6196_144404_1879453"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of information service used to configure messaging programs to send and receive email.</descrip></descripGrp><ntig><termGrp><term id="144404">mail delivery service</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1879453">मेल वितरण सेवा</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6197_76338_467604"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file that stores messages generated by an application, service, or operating system that are used to track the operations performed.</descrip></descripGrp><ntig><termGrp><term id="76338">log file</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="467604">लॉग फाइल</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="62_3160_467063"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A server located on a network between client software, such as a Web browser, and another server. It intercepts all requests to the server to determine whether it can fulfill them itself. If not, it forwards the request to another server.</descrip></descripGrp><ntig><termGrp><term id="3160">proxy server</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="467063">प्रॉक्सी सर्व्हर</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6200_50329_467435"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To insert information created in one program, such as a chart, an equation, an image, a video or a font, into another program or Web page.</descrip></descripGrp><ntig><termGrp><term id="50329">embed</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="467435">ऍम्बेड करा</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6202_70557_467555"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To reverse something or change it to its opposite.</descrip></descripGrp><ntig><termGrp><term id="70557">invert</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="467555">उलट करा</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6208_147957_1879479"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A field that can show formatting and graphics, such as an embedded object, and not just text.</descrip></descripGrp><ntig><termGrp><term id="147957">rich text field</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1879479">रिच टेक्स्ट फिल्ड</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="621_121364_467871"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of object within a process that runs program instructions. Using multiple threads allows concurrent operations within a process and enables one process to run different parts of its program on different processors simultaneously. A thread has its own set of registers, its own kernel stack, a thread environment block, and a user stack in the address space of its process.</descrip></descripGrp><ntig><termGrp><term id="121364">thread</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="467871">थ्रेड</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6215_2282727_2284292"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Microsoft word processing software designed for use with handheld computing devices.</descrip></descripGrp><ntig><termGrp><term id="2282727">Word Mobile</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2284292">Word Mobile</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6215_331740_2284292"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Microsoft word processing software designed for use with handheld computing devices.</descrip></descripGrp><ntig><termGrp><term id="331740">Microsoft® Office Word Mobile</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2284292">Word Mobile</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6217_2282728_2284255"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Microsoft spreadsheet software designed for use with handheld computing devices.</descrip></descripGrp><ntig><termGrp><term id="2282728">Excel Mobile</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2284255">Excel Mobile</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6217_331756_2284255"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Microsoft spreadsheet software designed for use with handheld computing devices.</descrip></descripGrp><ntig><termGrp><term id="331756">Microsoft® Office Excel® Mobile</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2284255">Excel Mobile</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6223_307422_1959142"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A password or a passcode that the users set on their device such as smartphones.</descrip></descripGrp><ntig><termGrp><term id="307422">device password</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1959142">डिव्हाइस पासवर्ड</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6224_144653_468038"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A placeholder for text or pictures that you insert into your document.</descrip></descripGrp><ntig><termGrp><term id="144653">merge field</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="468038">मर्ज फील्ड</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6231_144677_1206158"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A single cell that is created by combining two or more selected cells. The cell reference for a merged cell is the upper-left cell in the original selected range.</descrip></descripGrp><ntig><termGrp><term id="144677">merged cell</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1206158">विलीन कक्ष</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6231_144677_1268423"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A single cell that is created by combining two or more selected cells. The cell reference for a merged cell is the upper-left cell in the original selected range.</descrip></descripGrp><ntig><termGrp><term id="144677">merged cell</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1268423">मर्ज केलेले कक्ष</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6232_141181_468014"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An area upon which users can draw multiple shapes, such that the shapes can be moved and resized as a unit.</descrip></descripGrp><ntig><termGrp><term id="141181">drawing canvas</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="468014">रेखांकन कॅनव्हास</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6239_264786_468521"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A view for delivering a presentation that provides the presenter with additional options for viewing and controlling its delivery.</descrip></descripGrp><ntig><termGrp><term id="264786">Presenter View</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="468521">प्रस्तुतकर्ता दृश्य</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6240_30724_467265"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of payment card where the supplier is paid by the card issuer. The card holder then pays the card issuer.</descrip></descripGrp><ntig><termGrp><term id="30724">credit card</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="467265">क्रेडिट कार्ड</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6247_318716_468800"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of compositions or memorabilia of a specific type or for a particular purpose, such as audio recordings, photographs, or documents.</descrip></descripGrp><ntig><termGrp><term id="318716">album</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="468800">अल्बम</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6250_105621_467780"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A return to a previous stable condition, as when the contents of a hard disk are restored from a backup after a destructive hard disk error.</descrip></descripGrp><ntig><termGrp><term id="105621">rollback</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="467780">रोलबॅक</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6259_1054660_2698308"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A device consisting of a number of connected circuit elements, such as transistors and resistors, fabricated on a small rectangle (a "die") cut from a silicon (or, in some special cases, a sapphire) wafer. Chips are categorized by the number of elements they contain.</descrip></descripGrp><ntig><termGrp><term id="1054660">integrated circuit</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2698308">चिप</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6259_1054661_2698308"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A device consisting of a number of connected circuit elements, such as transistors and resistors, fabricated on a small rectangle (a "die") cut from a silicon (or, in some special cases, a sapphire) wafer. Chips are categorized by the number of elements they contain.</descrip></descripGrp><ntig><termGrp><term id="1054661">IC</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2698308">चिप</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6259_31338_2698308"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A device consisting of a number of connected circuit elements, such as transistors and resistors, fabricated on a small rectangle (a "die") cut from a silicon (or, in some special cases, a sapphire) wafer. Chips are categorized by the number of elements they contain.</descrip></descripGrp><ntig><termGrp><term id="31338">chip</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2698308">चिप</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="626_61316_467499"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Not visible to the user.</descrip></descripGrp><ntig><termGrp><term id="61316">hidden</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="467499">लपलेले</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6273_145441_1879463"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of software that provides access to a particular type of OLAP database. This software can include a data source driver and other client software that is necessary to connect to a database.</descrip></descripGrp><ntig><termGrp><term id="145441">OLAP provider</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1879463">OLAP प्रदाता</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6279_26739_2076014"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To attempt to establish a voice conversation with another person or other people from a phone, computer, or mobile device.</descrip></descripGrp><ntig><termGrp><term id="26739">call</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2076014">कॉल करा</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6279_26739_467226"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To attempt to establish a voice conversation with another person or other people from a phone, computer, or mobile device.</descrip></descripGrp><ntig><termGrp><term id="26739">call</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="467226">कॉल</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6282_139056_467985"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Colors that are opposite each other on the color wheel, such as yellow and blue.</descrip></descripGrp><ntig><termGrp><term id="139056">complementary colors</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="467985">पूरक रंग</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6287_89072_467701"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Worksheet data in which rows or columns of detail data are grouped so that you can create summary reports. The outline can summarize either an entire worksheet or a selected portion of it.</descrip></descripGrp><ntig><termGrp><term id="89072">outline</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="467701">बाह्यरेखा</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6288_307448_1962044"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Outlook and Outlook Web Access feature that automatically suggests the best meeting times for a given a group of attendees, allowing users to schedule people and resources quickly and efficiently.</descrip></descripGrp><ntig><termGrp><term id="307448">Scheduling Assistant</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1962044">शेड्यूलिंग सहाय्यक</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6293_1060959_2290250"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A document on the World Wide Web that consists of an HTML file, with associated files for graphics and scripts, in a particular directory on a particular machine (and thus identifiable by an URL).</descrip></descripGrp><ntig><termGrp><term id="1060959">webpage</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2290250">वेबपृष्ठ</term><termNote type="geographicalUsage">IND</termNote><termNote type="part