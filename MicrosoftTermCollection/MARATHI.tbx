ments they will be applied to.</descrip></descripGrp><ntig><termGrp><term id="2276501">Color palette</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2281410">रंग पॅलेट</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39206_2276506_2281433"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Sway card that turns content into a pull quote.</descrip></descripGrp><ntig><termGrp><term id="2276506">Pull quote</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2281433">निष्कर्श</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39207_2276511_2281448"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The subscription plan that allows individual users that are part of a tenant to purchase a month-to-month subscription to both Microsoft and third party applications.</descrip></descripGrp><ntig><termGrp><term id="2276511">User purchase</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2281448">प्रयोक्ता खरेदी</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammatical