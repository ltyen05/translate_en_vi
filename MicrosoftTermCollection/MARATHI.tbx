hat is owned by an individual but is not treated as a separate entity from the business owner for tax purposes.</descrip></descripGrp><ntig><termGrp><term id="1993406">disregarded entity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2007469">उपेक्षित घटक</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34575_1993407_2007498"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An individual or entity that has no tax liability under US tax laws because they are not a citizen, resident alien, or an organization created or organized under the laws of the United States.</descrip></descripGrp><ntig><termGrp><term id="1993407">exempt payee</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2007498">मुक्त आदाता</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34576_1993408_2007507"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The federal revenue agency under the United States Department of the Treasury that is responsible for the collection of taxes in addition to the interpretation and enforcement of federal tax laws.</descrip></descripGrp><ntig><termGrp><term id="1993408">Internal Revenue Service</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2007507">अंतर्गत महसूल सेवा</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34576_1993408_2007514"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The federal revenue agency under the United States Department of the Treasury that is responsible for the collection of taxes in addition to the interpretation and enforcement of federal tax laws.</descrip></descripGrp><ntig><termGrp><term id="1993408">Internal Revenue Service</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2007514">IRS</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34576_1993409_2007507"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The federal revenue agency under the United States Department of the Treasury that is responsible for the collection of taxes in addition to the interpretation and enforcement of federal tax laws.</descrip></descripGrp><ntig><termGrp><term id="1993409">IRS</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2007507">अंतर्गत महसूल सेवा</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34576_1993409_2007514"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The federal revenue agency under the United States Department of the Treasury that is responsible for the collection of taxes in addition to the interpretation and enforcement of federal tax laws.</descrip></descripGrp><ntig><termGrp><term id="1993409">IRS</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2007514">IRS</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34577_1993410_2007545"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A business entity allowed for by state statutes in the United States that protects each owner (member) from personal liabilities but is not taxed since it passes all profits and losses to each member who is taxed accordingly.</descrip></descripGrp><ntig><termGrp><term id="1993410">limited liability company</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2007545">मर्यादित दायित्व कंपनी</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34577_1993411_2007545"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A business entity allowed for by state statutes in the United States that protects each owner (member) from personal liabilities but is not taxed since it passes all profits and losses to each member who is taxed accordingly.</descrip></