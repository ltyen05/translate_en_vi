crosoft Workplace Discount Program</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="3047614">Microsoft वर्कप्लेस डिस्काउंट प्रोग्राम</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53521_3047804_3059268"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Azure Percept component that provides a virtual gateway appliance designed for Azure Stack HCI environments to build, train, and run end-to-end vision AI solutions at the edge with Azure Percept.</descrip></descripGrp><ntig><termGrp><term id="3047804">Azure Percept on Azure Stack HCI</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="3059268">Azure Percept on Azure Stack HCI</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53545_3048644_3048726"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft Purview solution that provides advanced retention, deletion, and lifecycle management configuration options for content in Microsoft 365 to help customers meet recordkeeping laws and regulations.</descrip></descripGrp><ntig><termGrp><term id="3048644">Microsoft Purview Records Management</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="3048726