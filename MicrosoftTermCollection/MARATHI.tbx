report. It is created automatically when you create a new PivotChart report. When you change the layout of either report, the other also changes.</descrip></descripGrp><ntig><termGrp><term id="231957">associated PivotTable report</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="468288">संबंधित PivotTable अहवाल</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="823_144037_468033"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of buttons representing hyperlinks to pages both within a Web site and to external sites.</descrip></descripGrp><ntig><termGrp><term id="144037">link bar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="468033">लिंक पट्‍टी</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="824_129372_467911"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Of or pertaining to a device or service that appears to the user as something it actually is not or that does not physically exist.</descrip></descripGrp><ntig><termGrp><term id="129372">virtual</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="467911">व्हर्च्युअल</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Adjective</t