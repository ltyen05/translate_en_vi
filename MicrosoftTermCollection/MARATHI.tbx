rmNote></termGrp></ntig></langSet></termEntry><termEntry id="7904_234775_468360"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Visual impairment that results in great reduction in vision capabilities and that cannot be aided by glasses or contact lenses. It could, however, be aided by special devices.</descrip></descripGrp><ntig><termGrp><term id="234775">low vision</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="468360">अल्प दृष्टी</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7916_144827_1879455"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The path that a specified object or text will follow as part of an animation sequence for a slide.</descrip></descripGrp><ntig><termGrp><term id="144827">motion path</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1879455">गती पाथ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7928_237030_468405"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A data repository, in which items such as text, text boxes, pictures, tables, shapes, etc. can be stored and re-used within the same document and across multiple documents.</descrip></descripGrp><ntig><termGrp><term id="237030">content library</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></te