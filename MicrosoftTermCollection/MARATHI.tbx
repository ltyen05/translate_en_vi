USY</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55100_3123961_3124184"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The error in Excel that is shown when the time it takes to evaluate the Python formula surpasses the max allotted execution time.</descrip></descripGrp><ntig><termGrp><term id="3123961">#TIMEOUT</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="3124184">#TIMEOUT</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55101_3123962_3124586"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The error in Excel that is shown when there is an error evaluating the user's Python formula in the Python runtime environment.</descrip></descripGrp><ntig><termGrp><term id="3123962">#PYTHON</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="3124586">#PYTHON</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55102_3123963_3124185"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The experience of controlling a digital system without any form of physical contact.</descrip></descripGrp><nt