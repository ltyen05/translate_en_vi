ntains errors and exceptions that occur when SharePoint tries to connect to external systems through Business Connectivity Services. It can be retrieved by tenant administrators.</descrip></descripGrp><ntig><termGrp><term id="1641042">tenant-level external data log</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1880048">भाडेकरू-स्तरीय बाह्य डेटा लॉग</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32232_1641044_1880049"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Outlook calendar feature that can be enabled to display the weather forecast for a selected location.</descrip></descripGrp><ntig><termGrp><term id="1641044">Weather Bar</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1880049">हवामान पट्टी</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32240_1641050_1880050"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A property grid that only displays the properties that appear in the sentence-level view of an action.</descrip></descripGrp><ntig><termGrp><term id="1641050">top-level property grid</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1880050">शीर्ष-स्तरीय गुणधर्म ग्रिड</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32261_1644639_1880051"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A contextual summary of appointment or meeting information, which is displayed in a callout without opening the item.</descrip></descripGrp><ntig><termGrp><term id="1644639">calendar item peek</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1880051">दिनदर्शिका आयटम दृष्टिक्षेप</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32262_1644650_1880052"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A contextual summary of the user's daily schedule, which is displayed in a callout without switching to the Calendar module.</descrip></descripGrp><ntig><termGrp><term id="1644650">Calendar peek</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1880052">दिनदर्शिका दृष्टिक्षेप</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32263_1644654_1880053"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A contextual summary of the user's task list, which is displayed in a callout without switching to the Tasks module.</descrip></descripGrp><ntig><termGrp><ter