ge</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="3019362">स्टेज</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27742_1427142_2748233"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To share a PowerPoint presentation, where only the PowerPoint document is shown and only the presenter can edit the content being presented.</descrip></descripGrp><ntig><termGrp><term id="1427142">present</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2748233">सादर करा</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27751_1430080_1879896"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A series of equations that are stacked vertically, and that can be aligned at a particular character if desired.</descrip></descripGrp><ntig><termGrp><term id="1430080">pile</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1879896">पाइल</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27752_1430082_1879897"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A space in a template where a user can type text or insert symbols.</descrip></descripGrp><ntig><termGrp><term id="1430082">slot</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1879897">खाच</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27754_1430088_1879898"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A slot where the user can type text.</descrip></descripGrp><ntig><termGrp><term id="1430088">text slot</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1879898">मजकूर खाच</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2776_420864_1962029"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A defined set of values that Microsoft Office Outlook uses to keep track of user accounts.</descrip></descripGrp><ntig><termGrp><term id="420864">Outlook profile</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1962029">Outlook प्रोफाइल</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27772_1448163_2654230"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Rules by which one must agree to abide by in order to use a service. The accompanying Microsoft software includes computer software and may include associated media, printed materials, “online” or electronic documentation, and Internet-based services for use with a Microsoft software product (collectively, the “ADD-IN SOFTWARE”).</descrip></descripGrp><ntig><termGrp><term id="1448163">terms of service</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2654230">सेवा अटी</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27793_1464067_1879899"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The combined schedule of a number of people or resources.</descrip></descripGrp><ntig><termGrp><term id="1464067">group schedule</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1879899">समूह शेड्यूल</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27799_1464802_2837635"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A call center for answering emergency calls and providing emergency services.</descrip></descripGrp><ntig><termGrp><term id="1464802">Public Safety Answering Point</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></lang