rmNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2894306">आवाज टायपिंग</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51349_2894217_2894461"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The international holiday celebrated on March 8 that honors women and is commemorated in various ways around the world, including as a public holiday, a day of protest, or as a celebration of womanhood.</descrip></descripGrp><ntig><termGrp><term id="2894217">International Women's Day</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2894461">आंतरराष्ट्रीय महिला दिन</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51350_2894218_2894466"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Vietnamese public holiday celebrated on April 30 to commemorate the day in 1975 when North Vietnamese and Việt Cộng forces captured Saigon (now Ho Chi Minh City), signaling the end of the Vietnam War and the beginning of the reunification process.</descrip></descripGrp><ntig><termGrp><term id="2894218">Reunification Day</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2894466">पुनर्मिलन दिवस</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51351_2894219_2894468"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The day on which the Vietnamese holiday Reunification Day is celebrated if the official holiday itself falls on a weekend.</descrip></descripGrp><ntig><termGrp><term id="2894219">Reunification Day (Observed)</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2894468">पुनर्मिलन दिवस (साजरा केला)</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51352_2894246_2895195"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An account from a social identity provider, such as Facebook or Google.</descrip></descripGrp><ntig><termGrp><term id="2894246">social account</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2895195">सामाजिक खाते</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51364_2894612_3024629"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The transport layer network protocol based on User Datagram Protocol (UDP), which can improve the performance of web applications that currently use TCP.</descrip></descripGrp><ntig><termGrp><term id="2894612">QUIC</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="3024629">QUIC</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51369_2894964_2895082"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The tool that allows customers to compare their EOP policies settings against Microsoft's recommended settings for EOP and Office 365 ATP security.</descrip></descripGrp><ntig><termGrp><term id="2894964">Configuration Analyzer</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2895082">कॉन्फिगरेशन विश्लेषणकार</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51379_2895318_2895406"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The application of high quality touchscreen controls to games designed to be played with a controller or mouse/keyboard.</descrip></descripGrp><ntig><termGrp><term id="2895318">touch adaptation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2895406">स्पर्श ऍडप्टेशन</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51380_2895330_2895404"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method of grouping players for game matchmaking purposes together based on information provided by the title or stored in user statistics, or based on the user's preferences, or based on quality of service.</descrip></descripGrp><ntig><termGrp><term id="2895330">hopper</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2895404">हॉपर</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51405_2896240_2897246"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An authentication process that sends an SMS message to the phone number provided by the user.</descrip></descripGrp><ntig><termGrp><term id="2896240">SMS verification</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2897246">SMS पडताळणी</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51406_2896246_2897247"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A cookie that is used to connect user's activity on websites to the user's social media profile so the ads and content that the users see on websites and social media will better reflect their interests.</descrip></descripGrp><ntig><termGrp><term id="2896246">social media cookie</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langS