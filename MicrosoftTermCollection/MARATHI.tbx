95_2424812"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The global meeting place (App, Social Media, and website) for Windows users to find more information about Windows, engage with each other and the Windows Engineering team, and provide feedback.</descrip></descripGrp><ntig><termGrp><term id="2422395">Community</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2424812">Windows समुदाय</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42742_2795835_2800218"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The offline scanning tool that runs from a trusted environment, without starting your operating system.</descrip></descripGrp><ntig><termGrp><term id="2795835">Microsoft Defender Offline</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2800218">Microsoft Defender ऑफलाइन</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42743_2422534_2428831"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Excel function that accepts a sequence of Boolean expressions paired with values, evaluates each expression in order, and returns the value corresponding to the first Boolean expression that evaluates to TRUE.</descrip></descripGrp><ntig><termGrp><term id="2422534">IFSV2</term><termNote type="partOfSpeech">ProperNoun</te