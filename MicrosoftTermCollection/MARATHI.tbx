tig><termGrp><term id="468191">गुणधर्म संपादक</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1337_297179_468611"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A form of trojan that causes systems equipped with modems to dial phone numbers without the consent of the user. In most cases, the phone numbers dialed are premium rate numbers which result in unexpected charges on the affected user's phone bill.</descrip></descripGrp><ntig><termGrp><term id="297179">dialer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="468611">डायलर</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13370_33049_1207850"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To end an application's relationship with an open file so that the application will no longer be able to access the file without opening it again.</descrip></descripGrp><ntig><termGrp><term id="33049">close</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1207850">मिटवा</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13370_33049_467278"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To end an application's relationship with an open file so that the application will no longer be able to access the file without opening it again.</descrip></descripGrp><ntig><termGrp><term id="33049">close</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="467278">बंद करा</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13372_413712_1206233"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A symbol that is displayed beside a paragraph in outline view. You can use the symbol to display or hide subordinate levels of text and to reorganize text quickly.</descrip></descripGrp><ntig><termGrp><term id="413712">outline symbol</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1206233">बाह्यरेखेचे चिन्ह</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13374_359204_468998"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A complete Web site stored in a named subdirectory of the top-level Web site.</descrip></descripGrp><ntig><termGrp><term id="359204">subsite</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="468998">सबसाइट</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><te