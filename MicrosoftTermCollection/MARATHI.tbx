e></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="467668">नोड</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="938_584283_1937079"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A bar chart subtype that shows the relationship of individual items to the whole.</descrip></descripGrp><ntig><termGrp><term id="584283">stacked bar chart</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1937079">संग्रहित पट्‍टी रेखाचित्र</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9386_105576_2698319"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A server-based user profile that is downloaded to the local computer when a user logs on and that is updated both locally and on the server when the user logs off.</descrip></descripGrp><ntig><termGrp><term id="105576">roaming user profile</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2698319">रोमिंग प्रयोक्‍ता प्रोफाइल</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9386_503125_2698319"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A server-based user profile that is downloaded to the local computer when a user logs on and that is updated both locally and on the server when the user logs off.</descrip></descripGrp><ntig><termGrp><term id="503125">roaming profile</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2698319">रोमिंग प्रयोक्‍ता प्रोफाइल</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9391_318770_467351"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The † character.</descrip></descripGrp><ntig><termGrp><term id="318770">DAGGER</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="467351">डॅगर</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9391_42062_467351"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The † character.</descrip></descripGrp><ntig><termGrp><term id="42062">dagger</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="467351">डॅगर</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9394_144700_1206198"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Used by Microsoft Exchange to identify, locate, and open a form.</descrip></descripGrp><ntig><termGrp><term id="144700">message class</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1206198">संदेश वर्ग</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9394_144700_1268442"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Used by Microsoft Exchange to identify, locate, and open a form.</descrip></descripGrp><ntig><termGrp><term id="144700">message class</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1268442">संदेश श्रेणी</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9396_303757_468634"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A function of some Web browsers that allows users to surf and view multiple pages by loading Web sites into sections (or tabs) of one page, rather than multiple pages.</descrip></descripGrp><ntig><termGrp><term id="303757">tabbed browsing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="468634">टॅब्ड ब्राउझिंग</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9399_186186_1879508"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A notification bar warning the user about data that is blocked in the loaded file. Trust Bars can be for information only (non-actionable) or actionable.</descrip></descripGrp><ntig><termGrp><term id="186186">Trust Bar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1879508">विश्वस्त पट्टी</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="94_397174_1962018"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mail-enabled Active Directory user that represents a user outside the Exchange organization. Each mail user has an external email address. A mail user is similar to a mail contact, except that a mail user has Active Directory logon credentials and can access resources.</descrip></descripGrp><ntig><termGrp><term id="397174">mail user</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1962018">मेलबॉक्स प्रयोक्ता</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="940_39810_467337"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A processor that performs additional functions or assists the CPU.</descrip></descripGrp><ntig><termGrp><term id="39810">coprocessor</term><termNote type="partOfSpeech">Noun<