ype="definition">A Web Storage System content class defines the intent or purpose of an item along with the names of properties that are intended for items in this class.</descrip></descripGrp><ntig><termGrp><term id="139328">content class</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="467990">सामुग्री क्लास</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51163_2887244_2887253"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The product that uses artificial intelligence to process content across existing Microsoft technologies in order to organize content and expertise into a knowledge network based around relationships among topics, content, and people.</descrip></descripGrp><ntig><termGrp><term id="2887244">Project Cortex</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2887253">प्रोजेक्ट Cortex</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51164_2887245_2887254"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The line an error gets underscored with in apps like Word or Outlook during spell check.</descrip></descripGrp><ntig><termGrp><term id="2887245">squiggle</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2887254">स्क्विगल</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51165_2887246_2887250"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To orchestrate a collaboration session.</descrip></descripGrp><ntig><termGrp><term id="2887246">host</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2887250">होस्ट करा</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51166_2887247_2887251"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature of sharing access to the user's current location, letting others see what their geographical position is.</descrip></descripGrp><ntig><termGrp><term id="2887247">location sharing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2887251">स्थान सामायिकरण</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51168_2887249_2887252"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The act of using a smartphone app to block and filter websites and apps, monitor chats and texts, manage screen time, and perform other functions related to controlling and reporting on that phone's activities, usually with the aim towards making the phone safer to use by children.</descrip></descripGrp><ntig><termGrp><term id="2887249">phone monitoring</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2887252">फोन मॉनिटरींग</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5117_262544_1206144"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A visual effect that imparts a quality of translucency to windows.</descrip></descripGrp><ntig><termGrp><term id="262544">glass</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1206144">विंडो चौकट</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5117_262544_1268419"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A visual effect that imparts a quality of translucency to windows.</descrip></descripGrp><ntig><termGrp><term id="262544">glass</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1268419">विंडो ग्लास</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5117_262544_468477"><langSet xml:lang="en-US"><descri