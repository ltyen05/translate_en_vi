ip type="definition">The Excel function that returns the text representation of a value.</descrip></descripGrp><ntig><termGrp><term id="2855256">VALUETOTEXT</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2885657">VALUETOTEXT</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50427_2855257_2885652"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Excel function that returns the text representation of an array.</descrip></descripGrp><ntig><termGrp><term id="2855257">ARRAYTOTEXT</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2885652">ARRAYTOTEXT</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50428_2855258_2997439"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Excel function that assigns calculation results to names. Useful for storing intermediate calculations, values, or defining names inside a formula. These names only apply within the scope of the LET function.</descrip></descripGrp><ntig><termGrp><term id="2855258">LET</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2997439">LET</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="g