"2410900">Speak</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2416718">बोला</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42566_2410901_2416720"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An ink that is shown while the user is drawing with a stylus before the stylus has been lifted up.</descrip></descripGrp><ntig><termGrp><term id="2410901">wet ink</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2416720">ओली इंक</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42569_2411210_2416709"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An ink that results after the user has drawn with a stylus and has lifted up the stylus.</descrip></descripGrp><ntig><termGrp><term id="2411210">dry ink</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2416709">कोरडी इंक</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42570_2411211_2416710"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An ink whose thickness and color can be changed even after drying.</descrip></descripGrp><ntig><termGrp><term id="2411211">editable ink</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2416710">संपादन योग्य इंक</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42571_2411212_2416712"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An ink that is retained as dry ink and not converted to a command.</descrip></descripGrp><ntig><termGrp><term id="2411212">ink as ink</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2416712">इंक म्हणून इंक</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42572_2411213_2416715"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An ink whose look resembles a #2 pencil.</descrip></descripGrp><ntig><termGrp><term id="2411213">pencil ink</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2416715">पेन्सिल इंक</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42607_2413500_2420897"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office button that launches a task pane where users can research papers by typing queries to get information such as sources, citations, quotes, and images.</descrip></descripGrp><ntig><termGrp><term id="2413500">Researcher</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2420897">संशोधक</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42608_2413506_2420898"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office feature that allows users type queries and find information, sources, citations, quotes, and images, without leaving the application that they are using.</descrip></descripGrp><ntig><termGrp><term id="2413506">Researcher</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2420898">संशोधक</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42614_2414369_2417564"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">T​o quickly return to an app, website, or document you were using earlier.</descrip></descripGrp><ntig><termGrp><term id="2414369">jump back</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2417564">मागे जंप करा</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42615_2414370_2417565"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of documents, apps, and websites that, in one click, allows you to pick up your work exactly where you left it earlier, on any device connected with the same Microsoft account.​​</descrip></descripGrp><ntig><termGrp><term id="2414370">jump group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2417565">जंप समूह</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42616_2414371_2417563"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To quickly jump to a document or application on another device that is connected to the same Microsoft account.</descrip></descripGrp><ntig><termGrp><term id="2414371">jump</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2417563">जंप करा</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42617_2414373_2417566"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that lets customers reset their network settings back to the Windows defaults.</descrip></descripGrp><ntig><termGrp><term id="2414373">network reset</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2417566">नेटवर्क रीसेट</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42639_2414859_2417567"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A control that contains a customizable and extensible collection of ink-related features for Universal Windows apps. By default, the toolbar may include buttons for drawing, erasing, highlighting, setting ink color and stroke thickness, and displaying a ruler.</descrip></descripGrp><ntig><termGrp><term id="2414859">Windows Ink toolbar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2417567">Windows Ink साधनपट्टी</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42642_2414869_2529446"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To move the camera forward or backwards, to zoom in and out the 3D object.</descrip></descripGrp><ntig><termGrp><term id="2414869">zoom</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2529446">झूम करा</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42643_2415081_2489907"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office 365 app that allows users to submit timesheets and report progress on tasks tracked in Project Online.</descrip></descripGrp><ntig><termGrp><term id="2415081">Office 365 Project Time Reporter</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2489907">Office 365 Project Time Reporter</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42643_2415081_2489908"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office 365 app that allows users to submit timesheets and report progress on tasks tracked in Project Online.</descrip></descripGrp><ntig><termGrp><term id="2415081">Office 365 Project Time Reporter</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2489908">Time Reporter</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42643_2415082_2489907"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office 365 app that allows users to submit timesheets and report progress on tasks tracked in Project Online.</descrip></descripGrp><ntig><termGrp><term id="2415082">Time Reporter</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2489907">Office 365 Project Time Reporter</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42643_2415082_2489908"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office 365 app that allows users to submit timesheets and report progress on tasks tracked in Project Online.</descrip></descripGrp><ntig><termGrp><term id="2415082">Time Reporter</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2489908">Time Reporter</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42644_2415086_2489909"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office 365 Project Time Reporter view that allows user to manage and record how they spend their personal and work time during a given week.</descrip></descripGrp><ntig><termGrp><term id="2415086">Timesheet</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2489909">Timesheet</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42645_2415869_2420895"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The context menu that pops up when text is selected in the Researcher panel giving the option of adding the selected text only or adding the selected text and a citation for the text.</descrip></descripGrp><ntig><termGrp><term id="2415869">Add Cite</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2420895">साइट जोडा</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4265_101189_467772"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A database repository for information about a computer's configuration. The registry contains information that Windows continually references during operation, such as: profiles for each user; the programs installed on the computer and the types of documents that each can create; property settings for folders and program icons; what hardware exists on the system; which ports are being used. The registry is organized hierarchically as a tree, and it is made up of keys and their subkeys, hives, and entries.</descrip></descripGrp><ntig><termGrp><term id="101189">registry</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="467772">रजिस्ट्री</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4265_1167347_467772"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A database repository for information about a computer's configuration. The registry contains information that Windows continually references during operation, such as: profiles for each user; the programs installed on the computer and the types of documents that each can create; property settings for folders and program icons; what hardware exists on the system; which ports are being used. The registry is organized hierarchically as a tree, and it is made up of keys and their subkeys, hives, and entries.</descrip></descripGrp><ntig><termGrp><term id="1167347">system registry</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="467772">रजिस्ट्री</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42654_2417345_3110053"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tool for erasing markings on a 2D surface.</descrip></descripGrp><ntig><termGrp><term id="2417345">eraser</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="3110053">इरेझर</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42660_2418366_2425168"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that puts together a PowerPoint or Sway outline based on the user's query, giving him or her a set of options to choose from, as well as advice on what can be included in the presentation or the sway.</descrip></descripGrp><ntig><termGrp><term id="2418366">QuickStarter</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2425168">द्रुत स्टार्टर</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42661_2418994_2421713"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A device, such as a PC, some tablets, a 2-in-1, or an All-in-one, that uses the traditional Win32 app model and typically make use of COM or .NET runtime.</descrip></descripGrp><ntig><termGrp><term id="2418994">desktop</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2421713">डेस्कटॉप</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42661_2418994_2421714"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A device, such as a PC, some tablets, a 2-in-1, or an All-in-one, that uses the traditional Win32 app model and typically make use of COM or .NET runtime.</descrip></descripGrp><ntig><termGrp><term id="2418994">desktop</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2421714">डेस्कटॉप डिव्हाइस</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42661_2419397_2421713"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A device, such as a PC, some tablets, a 2-in-1, or an All-in-one, that uses the traditional Win32 app model and typically make use of COM or .NET runtime.</descrip></descripGrp><ntig><termGrp><term id="2419397">desktop device</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2421713">डेस्कटॉप</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42661_2419397_2421714"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A device, such as a PC, some tablets, a 2-in-1, or an All-in-one, that uses the traditional Win32 app model and typically make use of COM or .NET runtime.</descrip></descripGrp><ntig><termGrp><term id="2419397">desktop device</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2421714">डेस्कटॉप डिव्हाइस</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42664_2419020_2421716"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A business rule that provides explicit, mandatory criteria to use when making a decision or taking action.</descrip></descripGrp><ntig><termGrp><term id="2419020">policy</term><termNote type="partOfSpeec