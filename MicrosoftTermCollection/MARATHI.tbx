term id="1962036">प्रोग्राम इव्हेंट</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51301_2891089_2891351"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Slovenian national holiday celebrated on June 25 to commemorate Slovenia's declaration of independence from Yugoslavia in 1991.</descrip></descripGrp><ntig><termGrp><term id="2891089">Statehood Day</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2891351">राज्य दिन</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51302_2891211_2891353"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The national holiday in Bosnia and Herzegovina celebrated on November 25 to commemorate the day in 1943 on which ZAVNOBiH, the Anti-Fascist Council of Bosnia and Herzegovina, adopted a resolution to declare the country/region an equal community of Muslims, Serbs, and Croats.</descrip></descripGrp><ntig><termGrp><term id="2891211">Statehood Day (Bosnia and Herzegovina)</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2891353">राज्य दिन (बोस्निया अणि हर्जेगोविना)</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51303_2891233_2891361"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Czech national holiday celebrated on September 28 to commemorate the day in 935 on which St. Wenceslas, patron of the Czech state, was murdered by his brother.</descrip></descripGrp><ntig><termGrp><term id="2891233">Czech Statehood Day (St. Wenceslas Day)</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2891361">झेक राज्य दिन (सेंट वेन्सेलास दिवस)</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51304_2891239_2891354"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Argentinian national holiday celebrated on June 20 to commemorate the Argentine flag and its creator, Manuel Belgrano.</descrip></descripGrp><ntig><termGrp><term id="2891239">Flag Day</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2891354">ध्वज दिन</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51305_2891254_2891357"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The supplementary holiday day that may be granted during years in which Argentina's Flag Day occurs on a Tuesday or a Thursday and is used to create a four-day weekend.</descrip></descripGrp><ntig><termGrp><term id="2891254">Flag Day (bridge)</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2891357">ध्वज दिन (ब्रिज)</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51306_2891255_2891355"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Mexican national holiday celebrated on February 24 to commemorate past and current flags of Mexico.</descrip></descripGrp><ntig><termGrp><term id="2891255">Flag Day</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2891355">ध्वज दिन</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51307_2891256_2891356"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The national holiday in Poland celebrated on May 2 to commemorate the raising of the Polish flag over the Victory Column at the end of the Battle of Berlin in 1945.</descrip></descripGrp><ntig><termGrp><term id="2891256">Flag Day</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2891356">ध्वज दिन</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51308_2891257_2891359"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Azerbaijan national holiday celebrated on November 9 to commemorate the adoption of the Flag of Azerbaijan on November 9, 1918.</descrip></descripGrp><ntig><termGrp><term id="2891257">National Flag Day</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2891359">राष्ट्रीय ध्वज दिन</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51309_2891258_2891360"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The day on which the Azerbaijan National Flag Day is celebrated if the official holiday itself falls on a weekend.</descrip></descripGrp><ntig><termGrp><term id="2891258">National Flag Day (Observed)</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2891360">राष्ट्रीय ध्वज दिन (साजरा केला)</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5131_159863_468129"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of detecting and splitting video content into separate clips. Clips are created by Windows Movie Maker when there is a significant change from one frame to another.</descrip></descripGrp><ntig><termGrp><term id="159863">clip creation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><la