of a vast amount of data in its original, untransformed state.</descrip></descripGrp><ntig><termGrp><term id="2752884">data lake</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="3115185">डेटा लेक</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48650_2753556_2757371"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A means of marketing that uses one or more digital signage device and that targets a specific audience.</descrip></descripGrp><ntig><termGrp><term id="2753556">digital signage</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2757371">डिजिटल सायनेज</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48651_3030415_3031107"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The latest generation of the Windows Console, designed with fundamental concepts familiar to developers around the world, and updating the Windows Command Line experience with modern paradigms and a fresh, new user interface.</descrip></descripGrp><ntig><termGrp><term id="3030415">Terminal</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="3031107">टर्मिनल</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Pro