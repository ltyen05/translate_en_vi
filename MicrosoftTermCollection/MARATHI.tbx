"1880058">माझे खाते</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32269_1644697_1880059"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Click-to-Run feature that enables two versions of Office to exist on the same computer to provide a seamless transition for users in supported scenarios.</descrip></descripGrp><ntig><termGrp><term id="1644697">Office Side-by-Side</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1880059">Office शेजारी-शेजारी</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32270_1645770_1880060"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SharePoint document library that administrators can use to distribute apps for Office and SharePoint to their end users.</descrip></descripGrp><ntig><termGrp><term id="1645770">App Catalog</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1880060">अनुप्रयोग कॅटलॉग</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32271_1645771_1880061"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An individual page in a topic series, or any page that is primarily search-driven.</descrip></descripGrp><ntig><termGrp><term id="1645771">dynamic landing page</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1880061">डायनॅमिक लँडिंग पृष्ठ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32272_1645772_1880062"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A storage method in which a file is split into pieces that are stored and updated separately, and streamed together when a user requests the file.</descrip></descripGrp><ntig><termGrp><term id="1645772">Efficient File Storage</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1880062">कार्यक्षम फाइल संग्रह</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32273_1645773_1880063"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables SharePoint customers to build their site navigation around a metadata term set, and that enables friendly URLs for pages in the navigation structure.</descrip></descripGrp><ntig><termGrp><term id="1645773">managed navigation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1880063">व्यवस्थापित नेव्हिगेशन</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNo