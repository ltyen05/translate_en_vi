scripGrp><descrip type="definition">A disjunction which is true if only one, but not both, of its disjuncts is true.</descrip></descripGrp><ntig><termGrp><term id="2956728">exclusive disjunction</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2995746">अनन्य वेगळे</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52749_2956729_2995773"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The symbol of the trigonometric function tangent.</descrip></descripGrp><ntig><termGrp><term id="2956729">tan</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2995773">टॅन</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52750_2956730_2995750"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To show what part of the number line contains values that will “satisfy” the given inequality.</descrip></descripGrp><ntig><termGrp><term id="2956730">Graph Inequality</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2995750">आलेख असमानता</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52751_2956731_2995762"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Of a function, the state of either never decreasing or never increasing as its independent variable increases.</descrip></descripGrp><ntig><termGrp><term id="2956731">Monotonicity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2995762">मोनोटॉनिसिटी</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52752_2956732_2995755"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A complex number, usually denoted with i, that is defined by i2=-1.</descrip></descripGrp><ntig><termGrp><term id="2956732">imaginary unit</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2995755">काल्पनिक युनिट</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52753_2956733_2995754"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Of a complex number a+bi, where a and b are real numbers, the value b.</descrip></descripGrp><ntig><termGrp><term id="2956733">imaginary part</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2995754">काल्पनिक भाग</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52754_2956734_2995737"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A function whose derivative is a given function, an indefinite integral.</descrip></descripGrp><ntig><termGrp><term id="2956734">antiderivative</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2995737">अ‍ॅंटीडेरिव्हेटिव्ह</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52755_2956735_2995763"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An identity that expresses the Pythagorean theorem in terms of trigonometric functions.</descrip></descripGrp><ntig><termGrp><term id="2956735">Pythagorean Identity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2995763">पायथागोरियन ओळख</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52756_2956736_2995770"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mnemonic device for computing the determinant of a 3x3 matrix named after the French mathematician Pierre Frédéric Sarrus.</descrip></descripGrp><ntig><termGrp><term id="2956736">Sarrus' Rule</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig><