ch other using various means, such as a telephone conference call.</descrip></descripGrp><ntig><termGrp><term id="168692">Web conference</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2592162">ऑनलाइन भेट</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11506_2588085_2592162"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An online gathering of people facilitated by software that allows participants to view, and optionally control, shared content and communicate with each other using various means, such as a telephone conference call.</descrip></descripGrp><ntig><termGrp><term id="2588085">virtual meeting</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2592162">ऑनलाइन भेट</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11506_2588086_2592162"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An online gathering of people facilitated by software that allows participants to view, and optionally control, shared content and communicate with each other using various means, such as a telephone conference call.</descrip></descripGrp><ntig><termGrp><term id="2588086">online meeting</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><ter