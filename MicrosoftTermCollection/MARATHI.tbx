mEntry id="26979_1361742_1463235"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The UI label for a permissions setting that indicates an item is being shared with (made available to) all of someone's friends.</descrip></descripGrp><ntig><termGrp><term id="1361742">Friends</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1463235">मित्र</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26980_1361743_1463557"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The UI label for a permissions setting that indicates an item is being shared with (made available to) only friends who don't have limited access.</descrip></descripGrp><ntig><termGrp><term id="1361743">Some friends</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1463557">काही मित्र</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26981_1361744_1463243"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The UI label for a permissions setting that indicates an item is being shared with (made available to) all of someone's friends, and all of those friends' friends.</descrip></descripGrp><ntig><termGrp><term id="1361744">My friends and their friends</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></nti