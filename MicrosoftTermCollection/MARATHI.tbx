rip></descripGrp><ntig><termGrp><term id="1288500">retention hold</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1962041">धारणा होल्ड</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26605_1289182_1425022"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A view for delivering a presentation that displays it as the audience will see it.</descrip></descripGrp><ntig><termGrp><term id="1289182">Slide Show view</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1425022">स्लाइड शो</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26605_1289182_1879881"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A view for delivering a presentation that displays it as the audience will see it.</descrip></descripGrp><ntig><termGrp><term id="1289182">Slide Show view</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1879881">स्लाइड शो दृश्य</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26605_1289183_1425022"><langSet 