ngSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature within the inline editing canvas of Designer in Copilot where you can select an object and AI highlights the color to make the object pop and then mutes the color of the rest of the image.</descrip></descripGrp><ntig><termGrp><term id="3161604">color pop</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="3162976">कलर पॉप</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56225_3161605_3162980"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A style option that is part of the inline editing experience within Copilot. Pixel art images are built using pixels as the only building blocks.</descrip></descripGrp><ntig><termGrp><term id="3161605">pixel art</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="3162980">पिक्सेल आर्ट</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56226_3161606_3162983"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A style option that makes an image or photograph look like a watercolor painting.</descrip></descripGrp><ntig><termGrp><term id="3161606">watercolor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="3162983">वॉटरकलर</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56227_3161607_3162969"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A style option that is part of the inline editing experience within Copilot. Block print technique involves carving a design into wood or linoleum and using that block to print the design onto paper or fabric.</descrip></descripGrp><ntig><termGrp><term id="3161607">block print</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="3162969">ब्लॉक प्रिंट</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56228_3161608_3162985"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A style option that is part of the inline editing experience within Copilot. Steampunk images often combine elements of the Victorian era with futuristic technology, including gears, cogs, brass, and steam-powered machinery.</descrip></descripGrp><ntig><termGrp><term id="3161608">steampunk</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="3162985">स्टीमपंक</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56229_3161609_3162970"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A style option that is part of the inline editing experience within Copilot. Claymation images use movable clay characters and are often seen in children's films and cartoons.</descrip></descripGrp><ntig><termGrp><term id="3161609">claymation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="3162970">क्लेमेशन</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56230_3161610_3162966"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A style option that is part of the inline editing experience within Copilot. Art deco images often blends modernity and luxury, creating a glamorous style.</descrip></descripGrp><ntig><termGrp><term id="3161610">art deco</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="3162966">आर्ट डेको</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56231_3161611_3162978"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A style option that is part of the inline editing experience within Copilot. Low poly images use a limited number of polygons to represent shapes and are characterized by their simplicity and geometric shapes.</descrip></descripGrp><ntig><termGrp><term id="3161611">low poly</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="3162978">लो पॉली</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56232_3161612_3162979"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A style option that is part of the inline editing experience within Copilot. Origami style is characterized by its minimalism, geometric shapes and creativity.</descrip></descripGrp><ntig><termGrp><term id="3161612">origami</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="3162979">ओरिगॅमी</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56233_3161613_3162982"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows users to take 1-2 images/photos and select a style or type a prompt and have your images combined and reimagined, generating an image with a new style.</descrip></descripGrp><ntig><termGrp><term id="3161613">restyle image</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="3162982">रीस्टाईल इमेज</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56242_3161706_3166360"><langSet xml:lang="en