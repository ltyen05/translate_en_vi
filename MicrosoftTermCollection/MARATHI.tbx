Services</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1959185">Exchange कॉन्फरन्स सर्व्हिस</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2690_19121_467171"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A keyboard key that moves the cursor to the left, one character at a time, usually erasing each character as it moves.</descrip></descripGrp><ntig><termGrp><term id="19121">BACKSPACE key</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="467171">BACKSPACE कळ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26949_1359312_1463234"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A person someone has established a mutual connection with, particularly via social networks or digital communication channels.</descrip></descripGrp><ntig><termGrp><term id="1359312">friend</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1463234">मित्र</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26950_1359313_1463240"><langSet xml:l