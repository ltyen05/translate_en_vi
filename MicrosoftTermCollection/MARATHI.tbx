.</descrip></descripGrp><ntig><termGrp><term id="2397421">DataMart</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="3115189">डेटा मार्ट</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2099_418571_3115189"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A subset of the contents of a data warehouse that tends to contain data focused at the department level, or on a specific business area.</descrip></descripGrp><ntig><termGrp><term id="418571">data mart</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="3115189">डेटा मार्ट</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20992_762951_2290216"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An email that a customer does not want delivered to their inbox, including spam and phishing messages (identified by the mail service) and messages from blocked senders and domains.</descrip></descripGrp><ntig><termGrp><term id="762951">junk e-mail</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2290216">जंक</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNum