>सारांश कार्य</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19229_652201_1424991"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A task that is made up of subtasks and summarizes those subtasks. Use outlining to create summary tasks. Project automatically determines summary task information [such as duration and cost] by using information from the subtasks.</descrip></descripGrp><ntig><termGrp><term id="652201">summary task</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1424991">सारांश कार्य</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19232_652204_1424777"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An horizontal or vertical line that divides a diagram into partitions and which is used to arrange related parts of a process.</descrip></descripGrp><ntig><termGrp><term id="652204">swimlane</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1424777">स्वीमलेन</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19234_652206_1795489"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Any application or process that you want to model. Examples of systems include a computer game, a process for assembling microchips, and a library information system.</descrip></descripGrp><ntig><termGrp><term id="652206">system</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1795489">सिस्टम</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19250_652222_1879688"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">One of a set of major and minor fonts that is applied to a file. Theme fonts, theme colors, and theme effects compose a theme.</descrip></descripGrp><ntig><termGrp><term id="652222">theme font</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1879688">थीम फॉन्ट</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19251_652223_1879689"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of pane that presents the current scanned document as one or more small images.</descrip></descripGrp><ntig><termGrp><term id="652223">thumbnail pane</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1879689">लघुप्रतिमा उपखंड</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19254_652226_1424774"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The time period indicator at the top of the Gantt views, the Resource Graph view, the Task Usage view, and the Resource Usage view. You can customize it to show up to three tiers that can display various time units: top, middle, and bottom.</descrip></descripGrp><ntig><termGrp><term id="652226">timescale</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1424774">टाइमस्केल</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19258_652230_1879690"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A special row in a list or table that provides a selection of aggregate functions useful for working with numerical data.</descrip></descripGrp><ntig><termGrp><term id="652230">total row</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1879690">एकूण पंक्ती</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19258_760167_1879690"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A special row in a list or table that provides a selection of aggregate functions useful for working with numerical data.</descrip></descripGrp><ntig><termGrp><term id="760167">totals row</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1879690">एकूण पंक्ती</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19261_652233_1879691"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An arrow that shows the relationship between the active cell and its related cells. Tracer arrows are blue when pointing from a cell that provides data to another cell, and red if a cell contains an error value, such as #DIV/0!.</descrip></descripGrp><ntig><termGrp><term id="652233">tracer arrow</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1879691">ट्रेसर बाण</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19264_652236_1879692"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Optional text for a trendline, including either the regression equation or the R-squared value, or both. A trendline label can be formatted and moved; it cannot be sized.</descrip></descripGrp><ntig><termGrp><term id="652236">trendline label</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1879692">ट्रेंडलाइन लेबल</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19265_652237_1206313"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A folder or file path on your computer or a location on your intranet from which it is safe to run code. Default trusted locations include the Templates, Addins, and Startup folders, and you can specify your own trusted locations.</descrip></descripGrp><ntig><termGrp><term id="652237">trusted location</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1206313">विश्वस्त स्थान</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19266_652238_1879693"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A list of software publisher certificates used to digitally sign code, such as macros. Because you explicitly trust the software publishers, their code is allowed to run on your computer without needing to prompt for permission.</descrip></descripGrp><ntig><termGrp><term id="652238">trusted publisher store</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1879693">विश्वासू प्रकाशक संग्रह</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19271_652243_1424773"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The percentage of a work resource’s time that is assigned to a task.</descrip></descripGrp><ntig><termGrp><term id="652243">unit</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1424773">एकक</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19273_652245_1879694"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In line charts with multiple data series, bars that indicate the difference between data points in the first and last series.</descrip></descripGrp><ntig><termGrp><term id="652245">up-down bars</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1879694">वर-खाली पट्ट्या</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19276_652248_1879695"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A chart axis that displays scaled numerical values.</descrip></descripGrp><ntig><termGrp><term id="652248">value axis</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1879695">मूल्य अक्ष</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1928_90900_467708"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To break input into smaller chunks so that a program can act upon the information.</descrip></descripGrp><ntig><termGrp><term id="90900">parse</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="467708">पार्स करा</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19280_652252_1268488"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A bar displayed along the left side of a document window. You can use the vertical ruler to adjust the top and bottom page margins and the row height in tables.</descrip></descripGrp><ntig><termGrp><term id="652252">vertical ruler</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1268488">अनुलंब मापनी</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19285_652286_1206315"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A calendar in widespread use. It was introduced in 1582 A.D. as a revision to the Julian calendar.</descrip></descripGrp><ntig><termGrp><term id="652286">Gregorian calendar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1206315">ग्रेगरीअन दिनदर्शिका</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19291_652263_1206316"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An XML structure that consists of a start tag, an end tag, and the information between the tags. Elements can have attributes and can contain other elements.</descrip></descripGrp><ntig><termGrp><term id="652263">XML element</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1206316">XML घटक</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19295_652267_1879696"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A switch (\#) or instruction that specifies how Microsoft Word will display the numeric result of a field.</descrip></descripGrp><ntig><termGrp><term id="652267">numeric picture switch</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1879696">सांख्यिक चित्र स्विच</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19296_652268_1879697"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A switch (\*) or instruction that specifies the capitalization, numeral style, and character formatting that Microsoft Word uses in a field result.</descrip></descripGrp><ntig><termGrp><term id="652268">format switch</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1879697">स्वरूप स्विच</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1930_46651_467396"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A device used to store information.</descrip></descripGrp><ntig><termGrp><term id="46651">disk</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="467396">डिस्क</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19300_652272_1206317"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to information that shows what has actually occurred. For example, the actual start date for a task is the day that the task actually started.</descrip></descripGrp><ntig><termGrp><term id="652272">actual</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1206317">वास्तविक</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19301_652273_1424771"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The percentage of a resource's capacity that is designated for a specific assignment.</descrip></descripGrp><ntig><termGrp><term id="652273">allocation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1424771">ऍलोकेशन</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19302_652274_1795492"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An allowed path from one state to another.</descrip></descripGrp><ntig><termGrp><term id="652274">transition</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1795492">संक्रमण</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19311_652285_1206318"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Having a digital signature.</descrip></descripGrp><ntig><termGrp><term id="652285">digitally signed</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1206318">डिजिटली केलेली स्वाक्षरी</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19312_652287_1424769"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The number of levels that a task is indented from the top level of the outline. You can indent tasks up to 65,000 levels in Project.</descrip></descripGrp><ntig><termGrp><term id="652287">outline level</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1424769">बाह्यरेखा स्तर</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19314_652289_1879698"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Resource cost per hour. Project includes two types of pay rates: standard rates and overtime rates.</descrip></descripGrp><ntig><termGrp><term id="652289">pay rate</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1879698">वेतन दर</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19315_652290_1424768"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of related tasks that completes a major step in a project.</descrip></descripGrp><ntig><termGrp><term id="652290">phase</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1424768">चरण</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1932_211418_1962012"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The computer that you are currently logged on to as a user. More generally, a local computer is a computer that you can access directly without using a communications line or a communications device, such as a network adapter or a modem.</descrip></descripGrp><ntig><termGrp><term id="211418">local computer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1962012">स्थानिक कॉम्प्यूटर</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1932_535324_1962012"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The computer that you are currently logged on to as a user. More generally, a local computer is a computer that you can access directly without using a communications line or a communications device, such as a network adapter or a modem.</descrip></descripGrp><ntig><termGrp><term id="535324">local machine</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1962012">स्थानिक कॉम्प्यूटर</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19320_652420_1424766"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Conditions you specify to limit which records are included in the result set of a query or filter.</descrip></descripGr