escripGrp><ntig><termGrp><term id="17347">authoritative server</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1959083">अधिकृत सर्व्हर</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23796_1089872_2698315"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A loop that, because of semantic or logic errors, can never terminate through normal means.</descrip></descripGrp><ntig><termGrp><term id="1089872">infinite loop</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2698315">अनंत लूप</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="238_41773_1959128"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Exchange 5.5 and earlier, a custom recipient is a user who is not hosted by Exchange. In Exchange 2003, such users can be added to Active Directory as contacts, Windows users, or users whose Windows accounts are disabled. In any case, they are mail-enabled, but not mailbox-enabled, because their mailboxes are hosted on another messaging system.</descrip></descripGrp><ntig><termGrp><term id="41773">custom recipient</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1959128">सानुकूल प्राप्तकर्ता</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2382_231960_1879528"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method of summarizing values in the data area of a PivotTable report by using the values in other cells in the data area. Use the Show data as list on the PivotTable Field dialog for a data field to create custom calculations.</descrip></descripGrp><ntig><termGrp><term id="231960">custom calculation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1879528">सानुकूल गणना</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23840_1091236_1206513"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A video clip that has been inserted into another file or Web page.</descrip></descripGrp><ntig><termGrp><term id="1091236">embedded video clip</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1206513">एम्बडिड व्हिडिओ क्लिप</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23841_1091237_1933031"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An audio clip that has been inserted into another file or Web page.</descrip></descripGrp><ntig><termGrp><term id="1091237">embedded audio clip</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1933031">ऍम्बेडेड ओडियो क्लिप</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23864_1091326_1963163"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A standard control that resembles a notebook and lets the user navigate different sections of information without leaving the current element on the screen.</descrip></descripGrp><ntig><termGrp><term id="1091326">tab control</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1963163">टॅब नियंत्रण</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23869_1091332_2818429"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In mathematics, an item that is multiplied in a multiplication problem; for example, 2 and 3 are factors in the problem 2 x 3. The prime factors of a number are a set of prime numbers that, when multiplied together, produce the number.</descrip></descripGrp><ntig><termGrp><term id="1091332">factor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2818429">घटक</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23871_1091334_2290188"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An ability to view data or navigate to or within a physical or virtual computer environment.</descrip></descripGrp><ntig><termGrp><term id="1091334">access</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2290188">ऍक्सेस</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23872_1091335_2290204"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An account holder who is a family member, but not a parent, and who has limited use of the Internet. Children can view their own settings, but they can't change them.</descrip></descripGrp><ntig><termGrp><term id="1091335">child</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2290204">चाइल्‍ड</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23873_1091336_2952146"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An account holder who is a parent or a child.</descrip></descripGrp><ntig><termGrp><term id="1091336">family member</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2952146">कुटुंब सदस्य</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23874_1091337_2290209"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An account holder who is the primary administrator (parent) and the family members they manage.</descrip></descripGrp><ntig><termGrp><term id="1091337">family</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2290209">कुटुंब</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23875_1091338_1206515"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To combine thereby increasing the quantity or size of something.</descrip></descripGrp><ntig><termGrp><term id="1091338">add</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1206515">जोडा</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23876_1091339_2290217"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To adjust the action or aspects of a group of items, typically done more than once.</descrip></descripGrp><ntig><termGrp><term id="1091339">manage</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2290217">व्‍यवस्‍थापित करा</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2388_415516_1879600"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A name assigned to a cell or group of cells.</descrip></descripGrp><ntig><termGrp><term id="415516">range name</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1879600">परिक्षेत्र नाव</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="239_252121_1879576"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A combination of list formatting options identified by a style name.</descrip></descripGrp><ntig><termGrp><term id="252121">list style</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1879576">यादी क्षेत्र</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23916_1091985_1367868"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Storage space provided over the Internet that's allotted to users for keeping digital information, such as photos or documents.</descrip></descripGrp><ntig><termGrp><term id="1091985">online storage</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1367868">ऑनलाइन संग्रह</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23919_1092267_1463573"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A “software-plus-services” platform and experience that enables PCs and other devices to “come alive” by making them aware of each other through the Internet, enabling individuals and organizations to manage, access, and share their files and applications seamlessly on the Web and across their world of devices.</descrip></descripGrp><ntig><termGrp><term id="1092267">Live Mesh</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1463573">Windows Live Mesh</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23919_1379736_1463573"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A “software-plus-services” platform and experience that enables PCs and other devices to “come alive” by making them aware of each other through the Internet, enabling individuals and organizations to manage, access, and share their files and applications seamlessly on the Web and across their world of devices.</descrip></descripGrp><ntig><termGrp><term id="1379736">Windows Live Mesh</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1463573">Windows Live Mesh</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23935_1092702_1959335"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The value that is to be searched for in a document or any collection of data.</descrip></descripGrp><ntig><termGrp><term id="1092702">search key</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1959335">शोध की</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23957_1092760_2847871"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In communications, a channel connecting two switching stations. A trunk usually carries a large number of calls at the same time.</descrip></descripGrp><ntig><termGrp><term id="1092760">trunk</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2847871">ट्रंक</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23957_1092760_2847872"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In communications, a channel connecting two switching stations. A trunk usually carries a large number of calls at the same time.</descrip></descripGrp><ntig><termGrp><term id="1092760">trunk</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2847872">आवाज ट्रंक</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23957_2843750_2847871"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In communications, a channel connecting two switching stations. A trunk usually carries a large number of calls at the same time.</descrip></descripGrp><ntig><termGrp><term id="2843750">voice trunk</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2847871">ट्रंक</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23957_2843750_2847872"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In communications, a channel connecting two switching stations. A trunk usually carries a large number of calls at the same time.</descrip></descripGrp><ntig><termGrp><term id="2843750">voice trunk</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2847872">आवाज ट्रंक</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelect