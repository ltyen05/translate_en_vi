termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2397859">झूम किनारी</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42304_2393983_2397861"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Zoom ribbon group where users can change the image, reset layout, enable/disable transition in their Summary Zoom, Slide Zoom, or Section Zoom, and return to Zoom.</descrip></descripGrp><ntig><termGrp><term id="2393983">Zoom Options</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2397861">झूम पर्याय</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42326_2394553_2399519"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">After a build update, to load an app with domain data (such as data from a database, from the network, or from a file system), during the download process. Before this step, the app cannot be used.</descrip></descripGrp><ntig><termGrp><term id="2394553">hydrate</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2399519">हायड्रेट करा</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4233_30878_1206132"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To verify, test or control by comparison or examination.</descrip></descripGrp><ntig><termGrp><term id="30878">check</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1206132">तपासा</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42351_2396187_2399524"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Windows Hello feature gives business customers the fastest and most secure way to sign-in to Windows devices, apps and services. It uses your face, fingerprint or companion device to recognize you instantly, no password needed.</descrip></descripGrp><ntig><termGrp><term id="2396187">Windows Hello for Business</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2399524">व्यवसायासाठी Windows Hello</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42352_2396192_2399516"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The gaming category where you can get clothing, weapons, tools or other useful items you can add to your game avatar.</descrip></descripGrp><ntig><termGrp><term id="2396192">Avatar items</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2399516">अवतार आयटम्स</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42353_2396193_2399518"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The game category with games that allow you to use your phone to interact with Xbox. You can browse and type on Xbox live using your phone instead of the controller.</descrip></descripGrp><ntig><termGrp><term id="2396193">Companion</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2399518">सहयोगी</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42354_2396194_2399523"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app category that offers utility apps which allow you to change settings and test network connections.</descrip></descripGrp><ntig><termGrp><term id="2396194">Tools</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2399523">साधने</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42355_2396195_2399520"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The game category that offers massively multiplayer online role-playing games. The users can choose a certain character and fight against other users on a map.</descrip></descripGrp><ntig><termGrp><term id="2396195">Multi-player online battle arena</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="2399520">मल्टी-प्लेअर ऑनलाइन बॅटल अरेना</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4236_16880_1961981"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process an operating system uses to detect and record security-related events, such as an attempt to create, to access, or to delete objects such as files and directories. The records of such events are stored in a file known as a security log, whose contents are available only to those with the proper clearance.</descrip></descripGrp><ntig><termGrp><term id="16880">auditing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="mr"><ntig><termGrp><term id="1961981">लेखा परीक्षण</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42378_2396738_2405621"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office service that allows users to publish documents to Docs.com with one click from Word, Excel, PowerPoint, and Sway while retaining the original formatting and animation of the document.</descrip></descr