="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="1256140">অফিস স্বতঃ- পুনর্বিবেচনাসমূহ</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21358_773112_1466688"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that makes automatic versions of user documents during each autosave operation and allows the user to revert to previous copies of the document with ease.</descrip></descripGrp><ntig><termGrp><term id="773112">Office Auto-Revisions</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="1466688">Office স্বয়ংসৃষ্ট প্রতিলিপিসমূহ</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21360_773163_1256141"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that alerts users to potential issues with email recipients before the message is sent.</descrip></descripGrp><ntig><termGrp><term id="773163">MailTips</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="1256141">মেল ইঙ্গিতসমূহ</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2