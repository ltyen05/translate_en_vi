88794">Deals won</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2490895">ডিলগুলি জিতেছে</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44293_2488795_2490899"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The field in Outlook Customer Manager that records the number of deals have not been finalized (won or lost), as well as their sum.</descrip></descripGrp><ntig><termGrp><term id="2488795">Deals active</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2490899">সক্রিয় ডিলগুলি</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44315_2489135_2493867"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The offer for students and educators that includes the Universal Windows Platform versions of Excel, PowerPoint, and Word, and that allows shared computer activation.</descrip></descripGrp><ntig><termGrp><term id="2489135">Office 365 Education Cart</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2493867">Office 365 শিক্ষা কার্ট</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44329_2489211_2590031"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The application available on devices you manage with Intune which is used to access company data to perform common tasks like enrolling devices, installing apps, and locating information for assistance from your IT department.</descrip></descripGrp><ntig><termGrp><term id="2489211">Intune Company Portal</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2590031">Intune Company Portal</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44329_2489211_2590095"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The application available on devices you manage with Intune which is used to access company data to perform common tasks like enrolling devices, installing apps, and locating information for assistance from your IT department.</descrip></descripGrp><ntig><termGrp><term id="2489211">Intune Company Portal</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2590095">Company Portal</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44329_2490036_2590031"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The application available on devices you manage with Intune which is used to access company data to perform common tasks like enrolling devices, installing apps, and locating information for assistance from your IT department.</descrip></descripGrp><ntig><termGrp><term id="2490036">Company Portal</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2590031">Intune Company Portal</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44329_2490036_2590095"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The application available on devices you manage with Intune which is used to access company data to perform common tasks like enrolling devices, installing apps, and locating information for assistance from your IT department.</descrip></descripGrp><ntig><termGrp><term id="2490036">Company Portal</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2590095">Company Portal</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44349_2490693_2499692"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Outlook feature that allows users to select a later time to automatically deliver emails and where said emails are stored in the Drafts folder until the time selected for sending.​</descrip></descripGrp><ntig><termGrp><term id="2490693">Send Later</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2499692">পরে পাঠান</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44350_2490694_2502249"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The value that Excel returns when a formula returns an array of values and one or more of the cells it would spill to already has content.</descrip></descripGrp><ntig><termGrp><term id="2490694">#NOSPILL!</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2502249">#অপ্রকাশ!</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44350_2490694_2502470"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The value that Excel returns when a formula returns an array of values and one or more of the cells it would spill to already has content.</descrip></descripGrp><ntig><termGrp><term id="2490694">#NOSPILL!</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2502470">#নোস্পিল!</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44351_2490695_2499690"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The value that Excel returns when a function tried to connect to a network resource or a remote service but failed.​​</descrip></descripGrp><ntig><termGrp><term id="2490695">#CONNECT!</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2499690">#সংযোগ স্থাপন!</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44351_2490695_2499706"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The value that Excel returns when a function tried to connect to a network resource or a remote service but failed.​​</descrip></descripGrp><ntig><termGrp><term id="2490695">#CONNECT!</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2499706">#সংযোগ!</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44352_2490696_2502252"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Excel cell capability that allows a cell to place array values in neighboring blank cells.</descrip></descripGrp><ntig><termGrp><term id="2490696">Spill</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2502252">প্রকাশ</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44352_2490696_2502480"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Excel cell capability that allows a cell to place array values in neighboring blank cells.</descrip></descripGrp><ntig><termGrp><term id="2490696">Spill</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2502480">স্পিল</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44355_2493977_2513436"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A container for a collection of configuration settings file with extension .ppkg. Provisioning packages are simple enough that with a short set of written instructions, a student or non-technical employee can use them to configure their device.</descrip></descripGrp><ntig><termGrp><term id="2493977">provisioning package</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2513436">সংস্থাপন প্যাকেজ</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44355_2493977_2513451"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A container for a collection of configuration settings file with extension .ppkg. Provisioning packages are simple enough that with a short set of written instructions, a student or non-technical employee can use them to configure their device.</descrip></descripGrp><ntig><termGrp><term id="2493977">provisioning package</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2513451">প্রভিশনিং প্যাকেজ</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44356_2493981_2513439"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The academic disciplines of science, technology, engineering and mathematics, used when addressing education policy and curriculum choices in schools.</descrip></descripGrp><ntig><termGrp><term id="2493981">STEM</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2513439">STEM</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44357_2493985_2513434"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collaborative work space, tool, app, or program for making, learning, exploring and sharing. It can refer to a literal space or place, or to digital environments where people are encouraged to create and share with a community.</descrip></descripGrp><ntig><termGrp><term id="2493985">makerspace</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2513434">মার্কারস্পেস</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44357_2493985_2513449"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collaborative work space, tool, app, or program for making, learning, exploring and sharing. It can refer to a literal space or place, or to digital environments where people are encouraged to create and share with a community.</descrip></descripGrp><ntig><termGrp><term id="2493985">makerspace</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2513449">মেকারস্পেস</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44358_2493987_2513431"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A test with important consequences for the test taker or which is the basis of a major decision.</descrip></descripGrp><ntig><termGrp><term id="2493987">high-stakes testing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2513431">হাই-স্টেক পরীক্ষা</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44360_2496992_2504251"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The portal where admins in educational institutions can acquire and distribute apps for their students, faculty, and staff to use.​​</descrip></descripGrp><ntig><termGrp><term id="2496992">Microsoft Store for Education</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2504251">শিক্ষার জন্য Microsoft Store</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44377_2499540_2501758"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Chrome browser extension that allows users to easily view, attach, and share their OneDrive files to anyone with Gmail.</descrip></descripGrp><ntig><termGrp><term id="2499540">Project Copenhagen</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2501758">Project Copenhagen</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44378_2499542_2501759"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The PowerPoint plugin that allows users to post their slides as images, videos, or albums on social media accounts, automatically upload them to OneDrive, and that shows any comments directly in PowerPoint.</descrip></descripGrp><ntig><termGrp><term id="2499542">Social Share</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2501759">Social Share</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44379_2499544_2501757"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app for Android that allows users to select links, text, and images, save it on their clipboard, and then put it somewhere universally accessible, such as Wunderlist, even from applications that don’t allow selection.</descrip></descripGrp><ntig><termGrp><term id="2499544">Clip Layer</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2501757">Clip Layer</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44407_2500737_2698878"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The solution that provides a summary view of all ongoing user activities in Office 365 including SharePoint, Exchange, and Azure Active Directory.</descrip></descripGrp><ntig><termGrp><term id="2500737">Office 365 Analytics</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2698878">Office 365 Analytics</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSel