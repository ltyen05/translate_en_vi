ermEntry><termEntry id="49799_2816514_2817675"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A bot in Office 365 Advisor for Teams that assists in the deployment of Microsoft Teams by providing guidance and resources to team members during roll out.</descrip></descripGrp><ntig><termGrp><term id="2816514">Advisor for Teams bot</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2817675">Teams বটের জন্য পরামর্শদাতা</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49800_2816515_2817749"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of telephone number that is not linked to any specific locality.</descrip></descripGrp><ntig><termGrp><term id="2816515">non-geographic number</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2817749">অ-ভৌগলিক নম্বর</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49801_2816516_2817716"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of telephone number that is linked to a specific locality, such as with a country code.</descrip></descripGrp><ntig><termGrp><term id="2816516">geographic number</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2817716">ভৌগলিক নম্বর</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49802_2816517_2817677"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of backing up data to a remote, cloud-based server.</descrip></descripGrp><ntig><termGrp><term id="2816517">cloud backup</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2817677">ক্লাউড ব্যাক আপ</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49803_2816518_2817678"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A service that backs up data to the cloud.</descrip></descripGrp><ntig><termGrp><term id="2816518">cloud backup service</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2817678">ক্লাউড ব্যাক আপ পরিষেবা</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49804_2816519_2817682"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A connected experience that is optional, more precisely, it is not covered by the organization's license with Microsoft, but is instead licensed directly to the user.</descrip></descripGrp><ntig><termGrp><term id="2816519">cloud-backed service</term>