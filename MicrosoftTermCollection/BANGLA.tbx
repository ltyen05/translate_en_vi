in a dialog box or pulling down a menu and then releasing the mouse button on one of its options.</descrip></descripGrp><ntig><termGrp><term id="31389">choose</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="1258146">চয়ন করা</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14733_31389_1771816"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To pick a command or an option from within a graphical user interface, as by clicking a button in a dialog box or pulling down a menu and then releasing the mouse button on one of its options.</descrip></descripGrp><ntig><termGrp><term id="31389">choose</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="1771816">বেছে নিন</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14734_2631390_2677642"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The duration of time for which the data should be available.</descrip></descripGrp><ntig><termGrp><term id="2631390">retention period</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2677642">রক্ষণের মেয়াদ</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14734_418816_2677642"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The duration of time for which the data should be available.</descrip></descripGrp><ntig><termGrp><term id="418816">retention range</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2677642">রক্ষণের মেয়াদ</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14738_124210_1853735"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A unit of measure used in typesetting and desktop publishing, equal to one-twentieth of a printer's point, or 1/1440th of an inch.</descrip></descripGrp><ntig><termGrp><term id="124210">twip</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="1853735">টুইপ</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14742_375721_1961422"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature available in Outlook 2007 and some mobile devices that automatically configures the clients for access to Exchange Server 2007. The client sends the user name and password information to the Exchange 2007 server. The Autodiscover Web service that is running on the Exchange Client Access server returns an XML file that contains configuration information, which is interpreted by the client. If the user is moved to a different server later, the client will automatically query the Autodiscover Web service again to update the client configuration.</descrip></descripGrp><ntig><termGrp><term id="375721">Autodiscover</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="1961422">স্বয়ংঅবিষ্কার</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14742_375721_2297000"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature available in Outlook 2007 and some mobile devices that automatically configures the clients for access to Exchange Server 2007. The client sends the user name and password information to the Exchange 2007 server. The Autodiscover Web service that is running on the Exchange Client Access server returns an XML file that contains configuration information, which is interpreted by the client. If the user is moved to a different server later, the client will automatically query the Autodiscover Web service again to update the client configuration.</descrip></descripGrp><ntig><termGrp><term id="375721">Autodiscover</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2297000">স্বয়ংআবিষ্কার</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14749_397189_1959669"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process by which Exchange Server creates and updates the OAB. Administrators can define when the OAB generation process will run.</descrip></descripGrp><ntig><termGrp><term id="397189">offline address book generation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="1959669">OAB প্রজন্ম</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14749_397189_1959673"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process by which Exchange Server creates and updates the OAB. Administrators can define when the OAB generation process will run.</descrip></descripGrp><ntig><termGrp><term id="397189">offline address book generation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="1959673">অফলাইন ঠিকানা পুস্তক প্রজন্ম</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14749_397189_2297221"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process by which Exchange Server creates and updates the OAB. Administrators can define when the OAB generation process will run.</descrip></descripGrp><ntig><termGrp><term id="397189">offline address book generation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term