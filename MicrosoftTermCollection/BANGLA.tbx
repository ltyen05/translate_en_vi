ion">The feature that enables customers to control access to rows in a database table based on the characteristics of the user executing a query (e.g., group membership or execution context).</descrip></descripGrp><ntig><termGrp><term id="2520274">Row Level Security</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="3115501">রোয়ের স্তরের নিরাপত্তা</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44765_2520275_3115501"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that enables customers to control access to rows in a database table based on the characteristics of the user executing a query (e.g., group membership or execution context).</descrip></descripGrp><ntig><termGrp><term id="2520275">RLS</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="3115501">রোয়ের স্তরের নিরাপত্তা</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44765_3114827_3115501"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that enables customers to control access to rows in a database table based on the characteristics of the user executing a query (e.g., group membership or execution context).</descrip></descripGrp><ntig><termGrp><term id="3114827">row-level security</term><termNote type="partOfSpeech">Noun</termNote><termNote type=