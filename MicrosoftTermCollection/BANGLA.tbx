ographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51850_2910396_2911073"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A URL used by attackers to install malware on a user's machine by either setting up a legitimate-looking website that they then lure users into visiting or by compromising an existing legitimate website that they know users will visit.</descrip></descripGrp><ntig><termGrp><term id="2910396">drive-by URL</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2911073">ড্রাইভ-বাই URL</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51850_2910397_2911072"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A URL used by attackers to install malware on a user's machine by either setting up a legitimate-looking website that they then lure users into visiting or by compromising an existing legitimate website that they know users will visit.</descrip></descripGrp><ntig><termGrp><term id="2910397">drive by URL</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2911072">ড্রাইভ বাই URL</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51850_2910397_2911073"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A URL used by attackers to install malware on a user's machine by either setting up a legitimate-looking website that they then lure users into visiting or by compromising an existing legitimate website that they know users will visit.</descrip></descripGrp><ntig><termGrp><term id="2910397">drive by URL</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2911073">ড্রাইভ-বাই URL</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51864_2911594_2911980"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Microsoft Edge feature that improves browser performance by reducing system resources (RAM, CPU) being used by background, inactive browser tabs.</descrip></descripGrp><ntig><termGrp><term id="2911594">sleeping tabs</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2911980">নিষ্ক্রিয় ট্যাবগুলি</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51865_2911595_2911975"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Surface feature that helps to adjust your gaze on video calls and recordings so that you appear to be looking directly into the camera.</descrip></descripGrp><ntig><termGrp><term id="2911595">Eye Contact</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2911975">সরাসরি চোখের দিকে তাকানো</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51866_2911596_2911967"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The FastTrack service that provides users with advisory and remediation services to support them as they migrate to Windows 10 and deploy their apps to Microsoft 365 Apps and the new Microsoft Edge.</descrip></descripGrp><ntig><termGrp><term id="2911596">App Assure</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2911967">App Assure</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51870_2911837_2912501"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A security capability that automatically investigates and remediates potentially compromised assets—identities, mailboxes, and devices—by orchestrating signals and remediation actions across workloads.</descrip></descripGrp><ntig><termGrp><term id="2911837">self-healing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2912501">self-healing</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote><