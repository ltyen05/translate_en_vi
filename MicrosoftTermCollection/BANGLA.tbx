ech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="1546234">অ্যাপ্লিকেশন</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7365_188095_1546234"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Commerce Server application is a logical representation of an application in Microsoft Internet Information Services (IIS); it appears in both Commerce Server Manager and the IIS console trees. In the IIS console tree an application is either at the root directory level of the Web site or at a subdirectory level of the Web site.</descrip></descripGrp><ntig><termGrp><term id="188095">Commerce Server application</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="1546234">অ্যাপ্লিকেশন</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7369_80126_1752531"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Information about the properties or structure of data that is not part of the values the data contains.</descrip></descripGrp><ntig><termGrp><term id="80126">metadata</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="1752531">মেটাডাটা</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender"