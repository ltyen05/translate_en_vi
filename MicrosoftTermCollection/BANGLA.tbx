volume</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="1467600">ভলিউম</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7712_130661_472001"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An area of storage on a hard disk. A volume is formatted by using a file system, such as NTFS, and has a drive letter assigned to it. A single hard disk can have multiple volumes. Some volumes can span multiple hard disks.</descrip></descripGrp><ntig><termGrp><term id="130661">volume</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="472001">আয়তন</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7719_175788_1255900"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A handle (often, a tall, thin rectangle) that appears on a rebar or command band. By touching and dragging a gripper bar with a stylus or mouse, a user can reposition or resize a rebar or command band.</descrip></descripGrp><ntig><termGrp><term id="175788">gripper bar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="1255900">গ্রিপার</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">