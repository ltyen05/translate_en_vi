33">জাংক</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20992_762956_2289960"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An email that a customer does not want delivered to their inbox, including spam and phishing messages (identified by the mail service) and messages from blocked senders and domains.</descrip></descripGrp><ntig><termGrp><term id="762956">junk</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2289960">জাঙ্ক</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20998_763011_1373233"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of colors and background images that lets users change the appearance of Windows Live pages. The theme is common to all pages, except for group, event, and space pages, which may each have their own theme.</descrip></descripGrp><ntig><termGrp><term id="763011">theme</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="1373233">থিম</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20999_763132_1520275"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To copy something from a computer to a location online, such as a photo album or a blog post.</descrip></descripGrp><ntig><termGrp><term id="763132">publish</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="1520275">প্রকাশ করা</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21000_763151_1520262"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Parental consent for a child to use a service, view a website, or communicate with a person.</descrip></descripGrp><ntig><termGrp><term id="763151">permission</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="1520262">অনুমতি</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21003_763869_1256092"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout type that includes layouts designed to show nonsequential information.</descrip></descripGrp><ntig><termGrp><term id="763869">List</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="1256092">তালিকা</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp><