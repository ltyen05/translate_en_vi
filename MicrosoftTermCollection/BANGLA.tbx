rip></descripGrp><ntig><termGrp><term id="2345593">curated by</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2347829">এর দ্বারা সংগৃহিত</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40344_2345594_2347828"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To collect content and present it together.</descrip></descripGrp><ntig><termGrp><term id="2345594">curate</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2347828">সংগৃহিত</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40345_2345596_2347368"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The place inside Microsoft Wallet where you store your credit cards, loyalty cards, coupons, boarding passes, and event tickets.</descrip></descripGrp><ntig><termGrp><term id="2345596">wallet</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2347368">ওয়ালেট</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40353_2346147_2347830"><lang