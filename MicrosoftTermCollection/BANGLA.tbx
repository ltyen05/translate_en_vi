y measurement unit that is equal to 1 million bytes.</descrip></descripGrp><ntig><termGrp><term id="2822">MB</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="471138">MB</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14238_2822_471139"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A memory measurement unit that is equal to 1 million bytes.</descrip></descripGrp><ntig><termGrp><term id="2822">MB</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="471139">মেগাবাইট</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14238_2823_471138"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A memory measurement unit that is equal to 1 million bytes.</descrip></descripGrp><ntig><termGrp><term id="2823">megabyte</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="471138">MB</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14238_2823_471139"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A memory measurement