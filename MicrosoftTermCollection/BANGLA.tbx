"1275659">speed dialing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="1959762">দ্রুত ডায়ালিং</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26529_1275659_2297312"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process by which a user presses and holds a key on their mobile phone keypad to dial a specific phone number.</descrip></descripGrp><ntig><termGrp><term id="1275659">speed dialing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2297312">দ্রুত ডায়াল</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26530_1275661_2297086"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The settings, related to the domain, a user needs to configure to get messaging up and running.</descrip></descripGrp><ntig><termGrp><term id="1275661">domain settings</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2297086">ডোমেন সেটিংস</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26531_1275663_2718316"><langSet xml:lang="en-U