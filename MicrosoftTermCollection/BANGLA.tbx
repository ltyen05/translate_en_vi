ech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37478_2139118_2352071"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Sway view that allows the user to see what the Sway would look and behave like to anyone else reading it by switching from the edit view to the reading view.</descrip></descripGrp><ntig><termGrp><term id="2139118">Preview</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2352071">পূর্বরূপ</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37479_2139119_2352073"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Sway feature that allows users to edit, add, reorder, delete, and structure their Sway content.</descrip></descripGrp><ntig><termGrp><term id="2139119">Storyline</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2352073">কাহিনিসূত্র</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37480_2139120_2254481"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of different visualization patterns and interactions for content shown in Sway.</descrip></descripGrp><ntig><termGrp><term id="2139120">card</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2254481">কার্ড</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37481_2139121_2254502"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Sway card that allows the user to select one or more pieces or types of content and change what is selected into a heading.</descrip></descripGrp><ntig><termGrp><term id="2139121">Header</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2254502">শিরোলেখ</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37481_2139121_2256313"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Sway card that allows the user to select one or more pieces or types of content and change what is selected into a heading.</descrip></descripGrp><ntig><termGrp><term id="2139121">Header</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2256313">শিরোনাম</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37482_2139122_2254673"><lan