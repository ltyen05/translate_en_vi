</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="613759">প্রধান মাউস বোতাম</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56350_3169478_3169800"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A filter that applies special effects to your camera.​</descrip></descripGrp><ntig><termGrp><term id="3169478">creative filter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="3169800">ক্রিয়েটিভ ফিল্টার</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56351_3169479_3170007"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Windows feature that applies a more subtle level of blurring and doesn’t obscure background details.</descrip></descripGrp><ntig><termGrp><term id="3169479">portrait blur</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="3170007">পোর্ট্রেট অস্পষ্ট</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56352_3169480_3170092"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A box that appears in Recall fe