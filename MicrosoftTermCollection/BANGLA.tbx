l.</descrip></descripGrp><ntig><termGrp><term id="318717">fast forward</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="1772064">দ্রুত এগিয়ে যান</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16348_318717_1783128"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To advance audio or video playback at a speed that is faster than normal.</descrip></descripGrp><ntig><termGrp><term id="318717">fast forward</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="1783128">দ্রুত ফরোয়ার্ড</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16358_210492_472314"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of attack that tries to trick users into revealing personal information, such as credit card numbers, bank accounts, or passwords, often using links to fake websites included in emails and chat messages.</descrip></descripGrp><ntig><termGrp><term id="210492">phishing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="472314">ফিশিং</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammatica