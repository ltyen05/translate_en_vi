="2269_2037686_2406566"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A program that appears to be useful or harmless but that contains hidden code designed to exploit or damage the system on which it is run.</descrip></descripGrp><ntig><termGrp><term id="2037686">trojan horse</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2406566">ট্রোজান হর্স</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2269_2037686_2718019"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A program that appears to be useful or harmless but that contains hidden code designed to exploit or damage the system on which it is run.</descrip></descripGrp><ntig><termGrp><term id="2037686">trojan horse</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2718019">ট্রোজান</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22692_1053737_1959685"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A procedure by which a user's password can be changed to a known value, in situations where the user has forgotten or lost their password.</descrip></descripGrp><ntig><termGrp><term id="1053737">password reset</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><ter