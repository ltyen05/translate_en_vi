="4972_75877_1255861"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In information processing, an operation performed by the computer at hand rather than by a remote computer.</descrip></descripGrp><ntig><termGrp><term id="75877">local</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="1255861">স্থানীয়</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4973_141204_1467486"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In line and area charts, lines that extend from a data point to the category (x) axis. Useful in area charts to clarify where one data marker ends and the next begins.</descrip></descripGrp><ntig><termGrp><term id="141204">drop lines</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="1467486">পতিত রেখা</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4973_141204_472099"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In line and area charts, lines that extend from a data point to the category (x) axis. Useful in area charts to clarify where one data marker ends and the next begins.</descrip></descripGrp><ntig><termGrp><term id="141204">drop lines</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="bn">