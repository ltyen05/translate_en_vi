termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56464_3173993_3174979"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A style option available in Designer that makes an image or photograph look like a flat illustration, with clean lines, bold color palettes, and absence of gradients, shadows, or textures.</descrip></descripGrp><ntig><termGrp><term id="3173993">flat illustration</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="3174979">ফ্ল্যাট চিত্রায়ণ</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56466_3173995_3174976"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A style option available in Designer that makes an image or photograph look like a whimsical doodle expressed through wandering lines and shapes, exuding spontaneity and intricacy.</descrip></descripGrp><ntig><termGrp><term id="3173995">doodle art</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="3174976">ডুডল আর্ট</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56467_3173996_3174982"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A style option available in Designer that makes an image or photograph look like folk art with a modern twist, combining hints of cultural traditions, heritages, and beliefs, with vibrant colors, patterns, and motifs.</descrip></descripGrp><ntig><termGrp><term id="3173996">modern folk art</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="3174982">মডার্ন ফোক আর্ট</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56469_3174000_3174972"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A style option available in Designer that takes a photograph or image and creates an alternate form of reality, often depicting the subject from multiple points of view simultaneously, resulting in a fractured and compartmentalized aesthetic.</descrip></descripGrp><ntig><termGrp><term id="3174000">cubism</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="3174972">কিউবিজম</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56470_3174014_3174969"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that uses AI to create a video based on a user’s prompt or inputs.</descrip></descripGrp><ntig><termGrp><term id="3174014">auto compose</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="3174969">অটো কম্পোজ</term><termNote type="geog