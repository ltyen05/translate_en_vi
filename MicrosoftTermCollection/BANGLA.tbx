="definition">The Financial Excel function that returns the cumulative interest paid between two periods.</descrip></descripGrp><ntig><termGrp><term id="2955567">CUMIPMT</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2960399">CUMIPMT</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52356_2955568_2960400"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Financial Excel function that returns the cumulative principal paid on a loan between two periods.</descrip></descripGrp><ntig><termGrp><term id="2955568">CUMPRINC</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2960400">CUMPRINC</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52357_2955569_2960401"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Date and time Excel function that returns the serial number of a particular date.</descrip></descripGrp><ntig><termGrp><term id="2955569">DATE</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2960401">DATE</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNo