া প্রোগ্রাম</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56484_3175466_3176098"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A series of surveys.</descrip></descripGrp><ntig><termGrp><term id="3175466">survey program</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="3176098">পালস প্রোগ্রাম</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56484_3175466_3176102"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A series of surveys.</descrip></descripGrp><ntig><termGrp><term id="3175466">survey program</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="3176102">সমীক্ষা প্রোগ্রাম</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56485_3175462_3176095"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A single survey within a program.</descrip></descripGrp><ntig><termGrp><term id="3175462">cycle</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="3176095">চক্র</term><term