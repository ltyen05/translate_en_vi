termGrp></ntig></langSet></termEntry><termEntry id="48135_2717013_2718026"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A cybersecurity process that looks at normal user and entity behavior and patterns and that detects any abnormal behavior or instances where there is a deviation from normal patterns.</descrip></descripGrp><ntig><termGrp><term id="2717013">UEBA</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2718026">ব্যবহারকারীর ও সত্তার আচরণগত অ্যানালিটিক্স</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48136_2717034_2718014"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A means of bypassing normal security and authentication protocols on a device or in software that was intentionally designed that way.</descrip></descripGrp><ntig><termGrp><term id="2717034">backdoor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2718014">চুপিসারে</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48137_2717038_2717886"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Potential damage to the interests of an organization by a person or persons regarded, inaccurately, as loyally working for or on behalf of the organization, or who inadvertently commits security breaches.</descrip></descripGrp><ntig><termGrp><term id="2717038">insider threat</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2717886">ইনসাইডার থ্রেট</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48138_2717322_2718028"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A breach of an account.</descrip></descripGrp><ntig><termGrp><term id="2717322">account breach</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2718028">অ্যাকাউন্ট লঙ্ঘন</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48139_2717335_2718032"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A container that holds a list of documents within a case where they can be indexed and analyzed by Advanced eDiscovery to identify the most important documents for litigation, investigation, public data request, or government inquiry.</descrip></descripGrp><ntig><termGrp><term id="2717335">working set</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2718032">কাজের সেট</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langS