rammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12524_73352_471661"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of binaries that can be installed on top of the core product and enables users to select a preferred language so that the user interface and Help files appear in that preferred language.</descrip></descripGrp><ntig><termGrp><term id="73352">language pack</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="471661">ভাষা প্যাক</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12524_73352_613592"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of binaries that can be installed on top of the core product and enables users to select a preferred language so that the user interface and Help files appear in that preferred language.</descrip></descripGrp><ntig><termGrp><term id="73352">language pack</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="613592">ভাষা সম্ভার</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12530_262704_472585"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A common programming interface to the lower-level system area network (SAN) implementations, developed by Microsoft. W