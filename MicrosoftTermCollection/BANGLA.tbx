en-US"><descripGrp><descrip type="definition">In an organization chart, a shape that is placed below and connected to any other shape with an elbow connector. This shape is placed above any additional subordinate shapes for the particular superior shape it is attached to.</descrip></descripGrp><ntig><termGrp><term id="137569">assistant shape</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="1853747">সহায়ক আকৃতি</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7604_1509002_1853747"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In an organization chart, a shape that is placed below and connected to any other shape with an elbow connector. This shape is placed above any additional subordinate shapes for the particular superior shape it is attached to.</descrip></descripGrp><ntig><termGrp><term id="1509002">assistant box</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="1853747">সহায়ক আকৃতি</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7612_47524_1778320"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In windowing environments, such as the Apple Macintosh and Microsoft Windows, an on-screen window (enclosed work area) in which the user can create, view, or work on a document.</descrip></descripGrp><ntig><termGrp><term id="47524">document wi