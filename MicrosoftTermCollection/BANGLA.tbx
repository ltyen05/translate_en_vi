><ntig><termGrp><term id="1258039">অধিবেশন</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7864_342527_614932"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A logical connection created between two hosts to exchange data.</descrip></descripGrp><ntig><termGrp><term id="342527">session</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="614932">অধিবেশন</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7869_78635_471711"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The key used by the client and server for all session key generation. The master key is used to generate the client-read key, the client-write key, the server-read key, and the server-write key. Master keys can be exported as simple key BLOBs.</descrip></descripGrp><ntig><termGrp><term id="78635">master key</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="471711">মাস্টার কী</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7869_78635_613642"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The key used by the client and server for all session key generation. The master key is used to generate the client-read key, the client-write key, the server-read key, and the server-write key. Master keys can be exported as simple key BLOBs.</descrip></descripGrp><ntig><termGrp><term id="78635">master key</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="613642">মূল কী</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7870_232418_1955185"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A search folder created in Outlook that provides a view of all email items matching specific search criteria and where the items are still stored in one or more Outlook folder.</descrip></descripGrp><ntig><termGrp><term id="232418">Search Folders</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="1955185">সন্ধান ফোল্ডার</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7870_232418_1955191"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A search folder created in Outlook that provides a view of all email items matching specific search criteria and where the items are still stored in one or more Outlook folder.</descrip></descripGrp><ntig><termGrp><term id="232418">Search Folders</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langS