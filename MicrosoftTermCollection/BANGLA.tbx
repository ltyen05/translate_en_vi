mNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2115838">ভিডিও আলো</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35726_2067032_2115785"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that allows you to sync some of the settings on your phone across all of your Windows 8 devices.</descrip></descripGrp><ntig><termGrp><term id="2067032">sync my settings</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2115785">আমার সেটিংস সিঙ্ক করুন</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35727_2067033_2115786"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To touch an NFC-capable device to a tag, an NFC reader, or another device to wirelessly transfer content or information.</descrip></descripGrp><ntig><termGrp><term id="2067033">tap</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2115786">টোকা দিন</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35728_2067075_2115493"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A ticket for transit, such as on an airplane or a train.</descrip></descripGrp><ntig><termGrp><term id="2067075">boarding pass</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2115493">বোর্ডিং পাস</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35729_2067076_2115755"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The hardware slot (or tray) in which a SIM card is placed. Some phones have more than one SIM slot.</descrip></descripGrp><ntig><termGrp><term id="2067076">SIM slot</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2115755">SIM স্লট</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3573_73656_471665"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The protocol or protocols operating at a particular level within a protocol suite, such as IP within the TCP/IP suite.</descrip></descripGrp><ntig><termGrp><term id="73656">layer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="471665">স্তর</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35730_2067078_2115495"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The multiple photos taken on shutter press to capture moving subjects. The user can pick the best one or just accept the photo recommended by the software.</descrip></descripGrp><ntig><termGrp><term id="2067078">burst</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2115495">বারস্ট</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35731_2067079_2115613"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A span of IP addresses.</descrip></descripGrp><ntig><termGrp><term id="2067079">IP range</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2115613">আইপি পরিসীমা</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35732_2067080_2115525"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">One of the pivots for a contact pinned to your Start screen, where you can find all your apps through which you can connect with that contact.</descrip></descripGrp><ntig><termGrp><term id="2067080">connect</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2115525