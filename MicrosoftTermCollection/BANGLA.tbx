rm id="2635486">Device Portal</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2641017">ডিভাইস পোর্টাল</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40030_2635486_2641030"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The web-based interface that is included as part of specialized Windows devices and used by developers to manage device services remotely.</descrip></descripGrp><ntig><termGrp><term id="2635486">Device Portal</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2641030">Windows ডিভাইস পোর্টাল</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40031_2338749_2339775"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The standalone 3D scanning app available in the Windows Store.​​</descrip></descripGrp><ntig><termGrp><term id="2338749">3D Scan</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2339775">3D Scan</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40032_2328169_2328900"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature of the 3D Scanner app that allows users to take 3D selfies.​</descrip></descripGrp><ntig><termGrp><term id="2328169">3D Selfie</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2328900">3D সেলফি</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40033_2328170_2328373"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A 3D printing format that allows design applications to send 3D models to other applications, platforms, services, and printers.​</descrip></descripGrp><ntig><termGrp><term id="2328170">3MF</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2328373">3MF</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40034_2328171_2328901"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The rectangular boundaries of the object to be scanned.​​</descrip></descripGrp><ntig><termGrp><term id="2328171">boundary cube</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2328901">সীমানা ঘনফল</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40035_2328172_2328903"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that simulates a body scanning booth by using a turntable in combination with the Kinect.​​​</descrip></descripGrp><ntig><termGrp><term id="2328172">scanning booth</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2328903">স্ক্যানিং বুথ</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40036_2328173_2328904"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A circular revolving platform where you can place an object for 3D scanning.​​</descrip></descripGrp><ntig><termGrp><term id="2328173">turntable</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2328904">টার্নটেবিল</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40037_2328194_2328902"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The multi-app package for Windows 10 that includes the Messaging app for SMS, instant messaging, and Skype chat, and the Skype video app for VoIP video and audio calling.</descrip></descripGrp><ntig><termGrp><term id="2328194">Messaging + Skype</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2328902">বার্তা প্রেরণ + Skype</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40039_2329141_2336306"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To add a previously banned person to a contact list again, so a user can receive calls or instant messages from the person.</descrip></descripGrp><ntig><termGrp><term id="2329141">unblock</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2336306">অবরোধমুক্ত করুন</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40040_2329142_2336305"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Text message sent to an electronic device to notify the receiver of something because the receiver has requested notification or accepted an offer to be notified about something.</descrip></descripGrp><ntig><termGrp><term id="2329142">SMS alert</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2336305">SMS সতর্কতা</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40041_2329143_2336304"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Skype call hosted by one user where lots of other users can join and participate in</descrip></descripGrp><ntig><termGrp><term id="2329143">Skypecast</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2336304">Skypecast</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40043_2329145_2336302"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application that can be installed on any mobile or landline in any supported country. It provides users with numbers that let them call friends, family and colleagues abroad from any mobile or landline while avoiding international calling charges.</descrip></descripGrp><ntig><termGrp><term id="2329145">Skype to Go</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2336302">যেতে যেতে Skype</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40044_2329146_2336301"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A web-based meeting scheduling and management tool. With Skype for Business Web Scheduler, you can create new meetings, change your existing meetings, and send invitations using your favorite email program.</descrip></descripGrp><ntig><termGrp><term id="2329146">Skype for Business Web Scheduler</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2336301">Skype for Business ওয়েব সময়সূচি স্থিরকারী</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40045_2329147_2336300"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An add-on for Skype for Business Online that provides phone capabilities.</descrip></descripGrp><ntig><termGrp><term id="2329147">Skype for Business Online Phone Add-on</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2336300">Skype for Business অনলাইন ফোন অন্তর্যোগ</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40046_2329148_2336299"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Skype for Business app for use on mobile devices</descrip></descripGrp><ntig><termGrp><term id="2329148">Skype for Business Mobile app</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2336299">Skype for Business মোবাইল অ্যাপ</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40047_2329149_2336298"><langSet xml:lang="e