ing that the user can tap to connect an accessory over Bluetooth.</descrip></descripGrp><ntig><termGrp><term id="1634214">tap to pair</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2115791">যুক্ত করতে আলতো চাপুন</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32072_1634258_2115801"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The menu option to change the flag status of an email.</descrip></descripGrp><ntig><termGrp><term id="1634258">toggle flag</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2115801">ফ্ল্যাগ টগল করুন</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32073_1634269_2115809"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The most played music playlists.</descrip></descripGrp><ntig><termGrp><term id="1634269">top playlists</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2115809">শীর্ষস্থানীয় প্লেলিস্ট</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><te