definition">When a ribbon is divided into multiple views, any one of the views. Every tab contains functionally related commands and other controls that are organized in groups. Typically, ribbon tabs are labeled.</descrip></descripGrp><ntig><termGrp><term id="1309629">ribbon tab</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="1854230">রিবন ট্র্যাব</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1975_73133_471658"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A designation used to conduct sorting or searching operations.</descrip></descripGrp><ntig><termGrp><term id="73133">keyword</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="471658">কীওয়ার্ড</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1975_73133_613589"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A designation used to conduct sorting or searching operations.</descrip></descripGrp><ntig><termGrp><term id="73133">keyword</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="613589">মূলশব্দ</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19767_674770_2767786"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A rating unit, e.g. assigning a "one-star rating" to an image.</descrip></descripGrp><ntig><termGrp><term id="674770">star</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2767786">তারা</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1978_45320_1257932"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To enter numbers on a device, such as telephone or mobile, in order to make a phone call.</descrip></descripGrp><ntig><termGrp><term id="45320">dial</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="1257932">ডায়াল করা</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1978_45320_1467401"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To enter numbers on a device, such as telephone or mobile, in order to make a phone call.</descrip></descripGrp><ntig><termGrp><term id="45320">dial</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="1467401">ডায়াল করুন</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">V