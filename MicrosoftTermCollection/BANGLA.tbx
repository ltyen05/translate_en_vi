langSet xml:lang="en-US"><descripGrp><descrip type="definition">A list of items that a customer has selected to purchase from a commerce Web site. It is usually compiled into a file and sometimes visually represented by a shopping basket, shopping cart, or other container used when shopping.</descrip></descripGrp><ntig><termGrp><term id="188099">basket</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2483295">তালিকা</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15855_148370_1466534"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A character you choose to indicate where you want text to separate when you convert a table to text, or where you want new rows or columns to begin when you convert text to a table.</descrip></descripGrp><ntig><termGrp><term id="148370">separator character</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="1466534">পৃথকীকরণ বর্ণচিহ্ন</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15855_148370_1944582"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A character you choose to indicate where you want text to separate when you convert a table to text, or where you want new rows or columns to begin when you convert text to a table.</descrip></descripGrp><ntig><termGrp><term id="148370">separator character</term><ter