angSet xml:lang="en-US"><descripGrp><descrip type="definition">The practice of structuring information models and associated data schemas such that every data element is mastered (or edited) in only one place.</descrip></descripGrp><ntig><termGrp><term id="3119825">single source of truth</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="3119926">সত্যির একক সূত্র</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55036_3119828_3120011"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The enterprise-grade data lake as a service provided within each tenant of Microsoft Fabric.</descrip></descripGrp><ntig><termGrp><term id="3119828">OneLake</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="3120011">OneLake</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55037_3119830_3120096"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Microsoft Fabric, the virtualized copy of data in the lake that all analytical engines can access.</descrip></descripGrp><ntig><termGrp><term id="3119830">One Copy</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="3120096">ওয়ান কপি</term><termNote type="geographicalUsa