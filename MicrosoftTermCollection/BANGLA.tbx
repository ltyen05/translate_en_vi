tig><termGrp><term id="1453954">পশ্চাদপট অপসারণ</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24903_1165764_3138653"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An option that isolates the foreground portion of an image and make the background transparent.</descrip></descripGrp><ntig><termGrp><term id="1165764">Remove Background</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="3138653">পটভূমি অপসারণ</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24913_1165825_1959475"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that lets users receive and send mail from other email accounts in Outlook Web App. They can add and delete those accounts, check their account synchronization status, and manage email from those accounts in their Inbox using Inbox rules.</descrip></descripGrp><ntig><termGrp><term id="1165825">Connected Accounts</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="1959475">সংযুক্ত অ্যাকাউন্টগুলি</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24913_1165825_2297042"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that lets users receive and send mail from other email accounts in Outlook Web App. They can add and delete those accounts, check their account synchronization status, and manage email from those accounts in their Inbox using Inbox rules.</descrip></descripGrp><ntig><termGrp><term id="1165825">Connected Accounts</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2297042">সংযুক্ত অ্যাকাউন্টগুলি</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24914_1165826_1959567"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A bubble that appears when a user clicks in a field or on a control in the user interface. The Help bubble contains information that helps the user know what to do.</descrip></descripGrp><ntig><termGrp><term id="1165826">Help bubble</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="1959567">সহায়তা বুদ্বুদ</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24914_1165826_2297132"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A bubble that appears when a user clicks in a field or on a control in the user interface. The Help bubble contains information that helps the user know what to do.</descrip></descripGrp><ntig><termGrp><term id="1165826">Help bubble</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2297132">সহায়তা বাবল</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24915_1165827_1959577"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A rule that is defined by an end-user using Outlook or Outlook Web App. When a message that meets the conditions of the rule is sent or received, the rule triggers an action that is performed automatically.</descrip></descripGrp><ntig><termGrp><term id="1165827">Inbox rule</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="1959577">ইনবক্স বিধি</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24915_1165827_2297142"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A rule that is defined by an end-user using Outlook or Outlook Web App. When a message that meets the conditions of the rule is sent or received, the rule triggers an action that is performed automatically.</descrip></descripGrp><ntig><termGrp><term id="1165827">Inbox rule</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2297142">ইনবক্সের বিধি</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24917_1165829_1959654"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A company that provides text messaging services.</descrip></descripGrp><ntig><termGrp><term id="1165829">mobile service provider</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="1959654">মোবাইল সেবা প্রদানকারী</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24917_1165829_2297209"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A company that provides text messaging services.</descrip></descripGrp><ntig><termGrp><term id="1165829">mobile service provider</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2297209">মোবাইল পরিষেবা প্রদানকারী</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24919_1165832_1854172"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A slider control where the maximum and minimum values of the range can be modified.</descrip></descripGrp><ntig><termGrp><term id="1165832">multi-stop slider</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="1854172">একাধিক-স্টপ স্লাইডার</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2492_397154_1959539"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An item that resides in a folder that uses an event sink. The item provides the store with information that includes what events will trigger the sink, the name of the sink, and options such as restrictions for when the event will fire.</descrip></descripGrp><ntig><termGrp><term id="397154">event registration</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="1959539">ঘটনা নিবন্ধীকরণ</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2492_397154_2297103"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An item that resides in a folder that uses an event sink. The item provides the store with information that includes what events will trigger the sink, the name of the sink, and options such as restrictions for when the event will fire.</descrip></descripGrp><ntig><termGrp><term id="397154">event registration</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2297103">ঘটনার নথিভুক্তিকরণ</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24928_1165905_1855591"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that contains galleries where the user can create, store, and find reusable pieces of content, including AutoText, document properties, fields and building blocks.</descrip></descripGrp><ntig><termGrp><term id="1165905">Quick Parts</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="1855591">দ্রুত অংশ</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24931_1165919_1519996"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To set again with a different value.</descrip></descripGrp><ntig><termGrp><term id="1165919">reset</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="1519996">রিসেট করা</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24935_1165946_1520281"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To obtain a new password when the old one is forgotten or expired.</descrip></descripGrp><ntig><termGrp><term id="1165946">reset</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="1520281">রিসেট করুন</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">