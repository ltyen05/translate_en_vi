></ntig></langSet></termEntry><termEntry id="2000_72983_471654"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A combination of keystrokes that can be used to perform a task that would otherwise require a mouse or other pointing device.</descrip></descripGrp><ntig><termGrp><term id="72983">keyboard shortcut</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="471654">কীবোর্ড শর্টকাট</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20056_694301_2309922"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A person who has been invited to an event.</descrip></descripGrp><ntig><termGrp><term id="694301">invitee</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2309922">আমন্ত্রিত ব্যক্তি</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20059_694304_2462839"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To answer a message.</descrip></descripGrp><ntig><termGrp><term id="694304">reply</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2462839">উত্তর দিন</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termN