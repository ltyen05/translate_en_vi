23"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The offer that bundles the required hardware and software for an immersive Teams meeting experience in a conference room setting.</descrip></descripGrp><ntig><termGrp><term id="2794241">Teams Rooms</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2794623">Teams Rooms</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="47769_2686648_2691666"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The offer for software that offers functionality for the Teams Rooms Systems hardware.</descrip></descripGrp><ntig><termGrp><term id="2686648">Meeting Room</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2691666">সভা কক্ষ</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="47778_2688723_2690230"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office 365 Security &amp; Compliance dashboard that provides users with information on how Office 365 implements security, privacy, and compliance controls, details of how third-party independent auditors perform audits to test these controls, and that provides users with third-party independent audit reports, and information on encryption, incident management, tenant isolation and data resiliency.</descrip></descripGrp><ntig><termGrp><term id="2688723">Service assurance</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2690230">পরিষেবার নিশ্চয়তা</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="47779_2689354_2690235"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A report that provides the status of email messages as they travel through an Exchange organization along with summary information such as date, sender, recipient, subject, and status.</descrip></descripGrp><ntig><termGrp><term id="2689354">Summary report</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2690235">সংক্ষিপ্ত প্রতিবেদন</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="47780_2689355_2690219"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An email report that provides the same details as a Summary report, plus additional details such as recipient status, message ID, and original client IP address.</descrip></descripGrp><ntig><termGrp><term id="2689355">Enhanced summary report</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2690219">বর্ধিত সংক্ষিপ্ত প্রতিবেদন</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="par