="2312659">New and rising games</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2185879">নতুন ও ক্রমবর্ধমান গেমগুলি</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33606_1803761_2115673"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An external device that interacts with an NFC-enabled phone. These devices exchange data, such as contact details or secure payment information, with NFC-enabled phones through contactless communication.</descrip></descripGrp><ntig><termGrp><term id="1803761">NFC reader</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2115673">NFC পাঠক</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33607_1803831_2115674"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An exchange of information between two devices using NFC, or near field communication. Using NFC transactions, a person can use their phone to make payments in a store or as a bus pass.</descrip></descripGrp><ntig><termGrp><term id="1803831">NFC transaction</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2115674">NFC লেনদেন</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33608_1803832_2115678"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The data limit plan where users purchase upfront a quota of data for a given time. For instance, pre-paid 500MB which expire in 6 months.</descrip></descripGrp><ntig><termGrp><term id="1803832">One time</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2115678">একবার</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33609_1803833_2115682"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To navigate through screens or menus at a controlled rate, performed by putting your finger(s) on and keeping contact with the phone's touch screen while moving it around.</descrip></descripGrp><ntig><termGrp><term id="1803833">pan</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2115682">প্যান</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33610_1803834_2063832"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The policy that states the rules of acceptable use, determined by Skype.</descrip></descripGrp><ntig><termGrp><term id="1803834">Fair Usage Policy</term><termNot