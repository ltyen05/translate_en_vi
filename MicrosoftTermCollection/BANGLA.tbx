 id="2740063">লবি</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20076_694372_2115765"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The microphone and speaker on a calling device/phone that allows you to converse with someone without using the handset or headset.</descrip></descripGrp><ntig><termGrp><term id="694372">speakerphone</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2115765">স্পীকার</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20076_761637_2115765"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The microphone and speaker on a calling device/phone that allows you to converse with someone without using the handset or headset.</descrip></descripGrp><ntig><termGrp><term id="761637">speaker</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2115765">স্পীকার</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20077_694377_2767784"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To direct a call.</descrip></descripGrp><ntig><termGrp><term id="694377">route</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2767784">রাউট করা</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20077_694377_2767796"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To direct a call.</descrip></descripGrp><ntig><termGrp><term id="694377">route</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2767796">রুট করুন</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20084_694548_2115608"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A current attempt by a second party to establish communication with a user.</descrip></descripGrp><ntig><termGrp><term id="694548">incoming call</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2115608">ইনকামিং কল</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20087_694562_2115604"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To take action to not answer a call. The call goes to voice mail if that service is available.</descrip></descripGrp><ntig><termGrp