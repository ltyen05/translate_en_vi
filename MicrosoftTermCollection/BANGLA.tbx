24"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A rectangular UI element on a dashboard that contains a report, alerts, and/or related actions and that can be moved or customized by the user.</descrip></descripGrp><ntig><termGrp><term id="2735730">card</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2736824">কার্ড</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48390_2735736_2737214"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The view contains a set of cards that contain information on security and compliance trends and that track the protection status of an organization’s identities, data, devices, apps, and infrastructure.</descrip></descripGrp><ntig><termGrp><term id="2735736">Monitoring &amp; reports</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2737214">পর্যবেক্ষণ ও প্রতিবেদন</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48405_2736256_2738712"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The button that initiates a proactive search for security threats.</descrip></descripGrp><ntig><termGrp><term id="2736256">Start hunting</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2738712">খোঁজ শুরু</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48406_2736257_2738666"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The card that allows users to hunt for email related activities that put users and data at risk, and take action against the threats.</descrip></descripGrp><ntig><termGrp><term id="2736257">Email &amp; data</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2738666">ইমেল ও ডেটা</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48407_2736262_2738662"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The card that allows users to hunt for activity that poses a security threat across devices using customizable queries.</descrip></descripGrp><ntig><termGrp><term id="2736262">Devices</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2738662">ডিভাইস</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48408_2736263_2738673"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The card that allows users to hunt for suspicious account activity on your network.</descrip></descripGrp><ntig><termGrp><term id="2736263">Identity</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2738673">পরিচয়</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48409_2736264_2738707"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The view that allows users to create policies and set up alerts regarding device usage, activities, security, data governance, and device management.</descrip></descripGrp><ntig><termGrp><term id="2736264">Policies</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2738707">নীতি</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48417_2736689_2772636"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A person that sets up a collaboration session.</descrip></descripGrp><ntig><termGrp><term id="2736689">collaboration session host</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2772636">হোস্ট</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNo