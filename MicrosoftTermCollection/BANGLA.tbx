Speech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31970_1629243_2115626"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A list of two or more email inboxes that have been linked so that users can view their email from all linked accounts at the same time. The accounts themselves are not combined.</descrip></descripGrp><ntig><termGrp><term id="1629243">linked inbox</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2115626">সংযুক্ত ইনবক্স</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31971_1629244_2115631"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature accessed from Search or Maps that displays things to see and do, shopping, and restaurants in a user's current location and the surrounding area.</descrip></descripGrp><ntig><termGrp><term id="1629244">Local Scout</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2115631">স্থানীয় স্কাউট</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31971_1629244_2115733"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature accessed from Search or Maps that displays things to see and do, shopping, and restaurants