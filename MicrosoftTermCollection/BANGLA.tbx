Grp><ntig><termGrp><term id="87023">offline</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="613696">অফলাইন</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8871_73980_471674"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The { character.</descrip></descripGrp><ntig><termGrp><term id="73980">left brace</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="471674">বাম দ্বিতীয় বন্ধনী</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8876_30983_1467639"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A small x or other sign that appears in the check box if the option represented by the box is selected.</descrip></descripGrp><ntig><termGrp><term id="30983">check mark</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="1467639">পরীক্ষণ চিহ্ন</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8876_30983_471353"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A small x or other sign that appears in the check box if the option represented by the box is selected.</descrip></descripGrp><ntig><termGrp><term id="30983">check mark</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="471353">চেক মার্ক</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8882_187096_1424649"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To retrieve a writable copy of a file or project from a source repository. This locks the file for editing to prevent others from overwriting or editing it inadvertently.</descrip></descripGrp><ntig><termGrp><term id="187096">check out</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="1424649">চেক আউট</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8882_187096_1453867"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To retrieve a writable copy of a file or project from a source repository. This locks the file for editing to prevent others from overwriting or editing it inadvertently.</descrip></descripGrp><ntig><termGrp><term id="187096">check out</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="1453867">চেক আউট করুন</term><termNote type="geographicalUsage">IND, BGD</termNote