ngSet xml:lang="en-US"><descripGrp><descrip type="definition">A device that connects networks using different communications protocols so that information can be passed from one to the other. A gateway both transfers information and converts it to a form compatible with the protocols used by the receiving network.</descrip></descripGrp><ntig><termGrp><term id="2026494">network gateway</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="1467388">গেটওয়ে</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1399_57949_1257922"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A device that connects networks using different communications protocols so that information can be passed from one to the other. A gateway both transfers information and converts it to a form compatible with the protocols used by the receiving network.</descrip></descripGrp><ntig><termGrp><term id="57949">gateway</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="1257922">প্রবেশদ্বার</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1399_57949_1467388"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A device that connects networks using different communications protocols so that information can be passed from one to the other. A gateway both transfers information and converts it to 