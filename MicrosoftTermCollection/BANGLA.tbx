Speech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="1467437">পূর্ণ PC ব্যাকআপ</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3643_323598_472970"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tool in Windows Vista that backs up the entire computer (OS, settings, and files).</descrip></descripGrp><ntig><termGrp><term id="323598">Complete PC Backup</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="472970">সম্পূর্ণ পিসি ব্যাকআপ</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3644_116003_1467438"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A statistical measure of the amount by which a set of values differs from the arithmetical mean, equal to the square root of the mean of the differences' squares.</descrip></descripGrp><ntig><termGrp><term id="116003">standard deviation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="1467438">প্রমিত বিচ্যুতি</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3644_116003_471917"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A statistical measure of the amount by which a set of values differs from the arithmetical mean, equal to the square root of the mean of the differences' squares.</descrip></descripGrp><ntig><termGrp><term id="116003">standard deviation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="471917">আদর্শ চ্যুতি</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3655_85228_471753"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A hyphen that is used to prevent a hyphenated word, number, or phrase from breaking if it falls at the end of a line.</descrip></descripGrp><ntig><termGrp><term id="85228">nonbreaking hyphen</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="471753">অবিরত হাইফেন</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3655_85228_613684"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A hyphen that is used to prevent a hyphenated word, number, or phrase from breaking if it falls at the end of a line.</descrip></descripGrp><ntig><termGrp><term id="85228">nonbreaking hyphen</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="613684">অবিভাজিত হাইফেন</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3657_16207_1961415"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A characteristic of an object.</descrip></descripGrp><ntig><termGrp><term id="16207">attribute</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="1961415">গুণ</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3657_16207_2767407"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A characteristic of an object.</descrip></descripGrp><ntig><termGrp><term id="16207">attribute</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2767407">গুণ</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3659_319140_472910"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ( character.</descrip></descripGrp><ntig><termGrp><term id="319140">opening parenthesis</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="472910">প্রারম্ভিক বন্ধনী</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3662_77222_471696"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that makes the screen more readable by people who have low vision by creating a separate window that displays a magnified portion of the screen.</descrip></descripGrp><ntig><termGrp><term id="77222">Magnifier</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="471696">বিবর্ধক</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36774_2070563_2115713"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A subset of settings and features that can be assigned to one of four slots in action center for quick, one-tap access. In addition, they can provide useful, actionable, or critical info regarding the setting or feature.</descrip></descripGrp><ntig><termGrp><term id="2070563">quick action</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2115713">দ্রুত ব্যবস্থা</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36775_2070564_2115821"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An app that is built using the Windows universal app platform. Developers can create a Windows universal app that runs on all Windows-based device types, or they can choose to limit an app to specific devices.</descrip></descripGrp><ntig><termGrp><term id="2070564">universal app</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2115821">সর্বজনীন অ্যাপ</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36775_2070564_2360555"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An app that is built using the Windows universal app platform. Developers can create a Windows universal app that runs on all Windows-based device types, or they can choose to limit an app to specific devices.</descrip></descripGrp><ntig><termGrp><term id="2070564">universal app</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2360555">সর্বজনীন অ্যাপ</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36775_2247950_2115821"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An app that is built using the Windows universal app platform. Developers can create a Windows universal app that runs on all Windows-based device types, or they can choose to limit an app to specific devices.</descrip></descripGrp><ntig><termGrp><term id="2247950">Windows universal app</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2115821">সর্বজনীন অ্যাপ</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36775_2247950_2360555"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An app that is built using the Windows universal app platform. Developers can create a Windows universal app that runs on all Windows-based device types, or they can choose to limit an app to specific devices.</descrip></descripGrp><ntig><termGrp><term id="2247950">Windows universal app</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2360555">সর্বজনীন অ্যাপ</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36776_2070565_2115558"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To provide Wi-Fi credentials to Outlook.com contacts, Skype contacts, and Facebook friends.</descrip></descripGrp><ntig><termGrp><term id="2070565">exchange</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2115558">আদান-প্রদান</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36778_2071066_2115606"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The phone's volume mode when in a call.</descrip></descripGrp><ntig><termGrp><term id="2071066">In-Call</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2115606">কল চলাকালীন</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36779_2071067_2115532"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The use of data connection in a roaming area. Generally making phone calls or using your data connection when the phone is roaming is more expensive, and the user will be charged additional fees for voice roaming calls.</descrip></descripGrp><ntig><termGrp><term id="2071067">data roaming</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2115532">ডেটা রোমিং</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36780_2071068_2115843"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The connection on your phone that allows you to make phone calls.</descrip></descripGrp><ntig><termGrp><term id="2071068">voice connection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2115843">ভয়েস সংযোগ</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36781_2071069_2115846"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A phone call made in a roaming area. Generally making phone calls or using your data connection when the phone is roaming is more expensive, and the user will be charged additional fees for voice roaming calls.</descrip></descripGrp><ntig><termGrp><term id="2071069">voice roaming</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2115846">ভয়েস রোমিং</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36782_2238946_2115544"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The setting to minimize distractions while driving.</descrip></descripGrp><ntig><termGrp><term id="2238946">Driving mode</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2115544">ড্রাইভিং মোড</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36783_2071243_2115735"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The setting that determines if the screen will rotate automatically when the phone is rotated.</descrip></descripGrp><ntig><termGrp><term id="2071243">screen rotation</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2115735">স্ক্রিন আবর্তন</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36784_2071244_2115859"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft operating system designed for handheld portable devices.</descrip></descripGrp><ntig><termGrp><term id="2071244">Windows Embedded Handheld</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2115859">Windows Embedded Handheld</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36785_2071245_2115858"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft operating system built on Windows Phone 8 designed for handheld portable devices.</descrip></descripGrp><ntig><termGrp><term id="2071245">Windows Embedded 8 Handheld</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2115858">Windows Embedded 8 Handheld</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36786_2071246_2115796"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A predetermined text reply that can be automatically sent in response to incoming calls, text messages, or both when Driving Mode is turned on. The text reply is sent with no action on the part of the user.</descrip></descripGrp><ntig><termGrp><term id="2071246">text reply</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2115796">বার্তার উত্তর</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36787_2071247_2115797"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A response to an incoming call using a text message when the caller is a contact calling from a mobile phone.</descrip></descripGrp><ntig><termGrp><term id="2071247">text reply</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2115797">বার্তার উত্তর</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36791_2071377_2115773"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A photo you can choose to use as the background for some Live Tiles on the Start screen.</descrip></descripGrp><ntig><termGrp><term id="2071377">Start background</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2115773">পটভূমির ব্যবহার</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36791_2071377_2360554"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A photo you can choose to use as the background for some Live Tiles on the Start screen.</descrip></descripGrp><ntig><termGrp><term id="2071377">Start background</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2360554">পটভূমি সূচনা করুন</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36792_2071378_2115839"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Windows Phone feature to upgrade a phone call into a Skype video call.</descrip></descripGrp><ntig><termGrp><term id="2071378">video upgrade</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2115839">ভিডিও আপগ্রেড</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36793_2071379_2115857"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A visual setting that enables app screen content to display in a window.</descrip></descripGrp><ntig><termGrp><term id="2071379">windowed mode</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2115857">উইন্ডো মোড</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36794_2071380_2115559"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A visual setting that is similar to “stretch” - the resolution of the phone screen is refitted to fill as much of the external screen as possible without compromising its dimensionality.</descrip></descripGrp><ntig><termGrp><term id="2071380">expanded screen mode</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2115559">প্রসারিত স্ক্রিন মোড</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36795_2071381_2115706"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Windows desktop application that is required to enable users to project their phone screen to a Windows device using a USB connection.</descrip></descripGrp><ntig><termGrp><term id="2071381">Project My Screen App</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2115706">আমার স্ক্রিন অ্যাপ প্রদর্শন</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36805_2072311_2089662"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that unifies components across applications, such as people, conversations, calendars, emails, and files, to create a seamless collaboration experience. Creating a group anywhere in Microsoft 365 will automatically provision a corresponding Yammer conversation feed, an Outlook inbox and calendar, and a SharePoint document library for every Group member. Groups make these components persistent across applications, so that changes made to components in part of Microsoft 365 will carry through to the others, thus enabling a unified experience.</descrip></descripGrp><ntig><termGrp><term id="2072311">Groups</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2089662">গোষ্ঠীগুলি</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36805_2072311_2123718"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that unifies components across applications, such as people, conversations, calendars, emails, and files, to create a seamless collaboration experience. Creating a group anywhere in Microsoft 365 will automatically provision a corresponding Yammer conversation feed, an Outlook inbox and calendar, and a SharePoint document library for every Group member. Groups make these components persistent across applications, so that changes made to components in part of Microsoft 365 will carry through to the others, thus enabling a unified experience.</descrip></descripGrp><ntig><termGrp><term id="2072311">Groups</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2123718">গোষ্ঠীসমূহ</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36805_2072311_2382889"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that unifies components across applications, such as people, conversations, calendars, emails, and files, to create a seamless collaboration experience. Creating a group anywhere in Microsoft 365 will automatically provision a corresponding Yammer conversation feed, an Outlook inbox and calendar, and a SharePoint document library for every Group member. Groups make these components persistent across applications, so that changes made to components in part of Microsoft 365 will carry through to the others, thus enabling a unified experience.</descrip></descripGrp><ntig><termGrp><term id="2072311">Groups</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2382889">Office 365 গোষ্ঠীসমূহ</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36805_2874478_2089662"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that unifies components across applications, such as people, conversations, calendars, emails, and files, to create a seamless collaboration experience. Creating a group anywhere in Microsoft 365 will automatically provision a corresponding Yammer conversation feed, an Outlook inbox and calendar, and a SharePoint document library for every Group member. Groups make these components persistent across applications, so that changes made to components in part of Microsoft 365 will carry through to the others, thus enabling a unified experience.</descrip></descripGrp><ntig><termGrp><term id="2874478">Microsoft 365 Groups</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2089662">গোষ্ঠীগুলি</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36805_2874478_2123718"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that unifies components across applications, such as people, conversations, calendars, emails, and files, to create a seamless collaboration experience. Creating a group anywhere in Microsoft 365 will automatically provision a corresponding Yammer conversation feed, an Outlook inbox and calendar, and a SharePoint document library for every Group member. Groups make these components persistent across applications, so that changes made to components in part of Microsoft 365 will carry through to the others, thus enabling a unified experience.</descrip></descripGrp><ntig><termGrp><term id="2874478">Microsoft 365 Groups</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2123718">গোষ্ঠীসমূহ</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote 