y communications in their organization so it can be examined by reviewers to see if it is compliant with the organization's policies.</descrip></descripGrp><ntig><termGrp><term id="2738464">Supervision</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2740095">পর্যবেক্ষণ</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48468_2738468_2739472"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft 365 compliance center view that allows users to search, investigate, and take action on data-related incidents such as a data breach, data spillage, or needing to search for and purge messages that contain a harmful attachment.</descrip></descripGrp><ntig><termGrp><term id="2738468">Data investigations</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2739472">ডেটা তদন্ত</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48469_2738471_2739474"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft 365 compliance center view that allows users to respond to a data subject request and create data subject request cases.</descrip></descripGrp><ntig><termGrp><term id="2738471">Data subject requests</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2739474">ডেটা বিষয় অনুরোধ</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48472_2739176_2742069"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A piece of targeted information that is meant to change an individual's perception on something in a way that is untrue such that the shift will cause harm.</descrip></descripGrp><ntig><termGrp><term id="2739176">weaponized information</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2742069">হাতিয়ার হিসেবে ব্যবহার করা তথ্য</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48474_2739487_2742047"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A condition under which a policy is triggered.</descrip></descripGrp><ntig><termGrp><term id="2739487">policy trigger</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2742047">পলিসি ট্রিগার</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48482_2741337_2742562"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to authentication means that do not require a password.</descrip></descripGrp><ntig><termGrp><term id="2741337">password-less</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2742562">পাসওয়ার্ড-হীন</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48482_2741337_2924769"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to authentication means that do not require a password.</descrip></descripGrp><ntig><termGrp><term id="2741337">password-less</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2924769">পাসওয়ার্ডহীন</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48482_2917812_2742562"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to authentication means that do not require a password.</descrip></descripGrp><ntig><termGrp><term id="2917812">passwordless</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2742562">পাসওয়ার্ড-হীন</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48482_2917812_2924769"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to authentication means that do not require a password.</descrip></descripGrp><ntig><termGrp><term id="2917812">passwordless</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2924769">পাসওয়ার্ডহীন</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48485_2741340_2742565"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A means of authentication in which key-based authentication is used to enable a user credential that is tied to a device and the users are not required to provide a password.</descrip></descripGrp><ntig><termGrp><term id="2741340">password-less authentication</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2742565">পাসওয়ার্ড-হীন প্রমাণীকরণ</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48485_2917816_2742565"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A means of authentication in which key-based authentication is used to enable a user credential that is tied to a device and the users are not required to provide a password.</descrip></descripGrp><ntig><termGrp><term id="2917816">passwordless authentication</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2742565">পাসওয়ার্ড-হীন প্রমাণীকরণ</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48488_2741343_2742572"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The security model that requires authentication and encryption of each access request as though it originates from an open network. Principles include segmentation, to make it harder for attackers to move through the network, and restricting user access to the minimum amount needed to do their job.</descrip></descripGrp><ntig><termGrp><term id="2741343">Zero Trust</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2742572">জিরো ট্রাস্ট</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4849_184188_1424636"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The collection of custom properties for a shape.</descrip></descripGrp><ntig><termGrp><term id="184188">shape data</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="1424636">আকৃতি ডাটা</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langS