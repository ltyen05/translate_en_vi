><ntig><termGrp><term id="74325">less than sign</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="613608">&lt; চিহ্ন</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10422_74325_614793"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The &lt; character.</descrip></descripGrp><ntig><termGrp><term id="74325">less than sign</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="614793">বাম কৌনিক বন্ধনী</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10423_232516_1770688"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Data from a table, form, query, view, or stored procedure, displayed in a row-and-column format.</descrip></descripGrp><ntig><termGrp><term id="232516">datasheet</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="1770688">ডেটাশিট</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10423_232516_472396"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Data from a table, form, query, view, or stored procedure, displayed in a row-and-column format.</descrip></descripGrp><ntig><termGrp><term id="232516">datasheet</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="472396">ডাটাপত্রক</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10425_77712_1959622"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A highspeed network that can carry voice, data, and images at up to 200 Mbps or faster over distances of up to 75 km. Based on the network architecture, the transmission speed can be higher for shorter distances. A MAN, which can include one or more LANs as well as telecommunications equipment such as microwave and satellite relay stations, is smaller than a wide area network but generally operates at a higher speed.</descrip></descripGrp><ntig><termGrp><term id="77712">MAN</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="1959622">MAN</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10425_77712_1959639"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A highspeed network that can carry voice, data, and images at up to 200 Mbps or faster over distances of up to 75 km. Based on the network architecture, the transmission speed can be higher for shorter distances. A MAN, which can include one or more LANs as well as telecommunications equipment such as microwave and satellite relay stations, is smaller than a wide area network but generally operates at a higher speed.</descrip></descripGrp><ntig><termGrp><term id="77712">MAN</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="1959639">মেট্রোপলিটন এরিয়া নেটওয়ার্ক</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10425_77713_1959622"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A highspeed network that can carry voice, data, and images at up to 200 Mbps or faster over distances of up to 75 km. Based on the network architecture, the transmission speed can be higher for shorter distances. A MAN, which can include one or more LANs as well as telecommunications equipment such as microwave and satellite relay stations, is smaller than a wide area network but generally operates at a higher speed.</descrip></descripGrp><ntig><termGrp><term id="77713">metropolitan area network</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="1959622">MAN</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10425_77713_1959639"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A highspeed network that can carry voice, data, and images at up to 200 Mbps or faster over distances of up to 75 km. Based on the network architecture, the transmission speed can be higher for shorter distances. A MAN, which can include one or more LANs as well as telecommunications equipment such as microwave and satellite relay stations, is smaller than a wide area network but generally operates at a higher speed.</descrip></descripGrp><ntig><termGrp><term id="77713">metropolitan area network</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="1959639">মেট্রোপলিটন এরিয়া নেটওয়ার্ক</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10431_232847_1853905"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A view that is designed for reading documents on a computer screen. The document is resized to fit the screen and most toolbars are removed, but commands are available for navigating, commenting, and looking up words.</descrip></descripGrp><ntig><termGrp><term id="232847">reading layout view</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="1853905">পঠন লেআউট দর্শন</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10436_415517_2441231"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Editor feature that gives users feedback on how easy it is for a reader to understand a written text based on information such as average sentence length and average word length.</descrip></descripGrp><ntig><termGrp><term id="415517">Readability Statistics</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2441231">পঠনযোগ্যতার মাপকাঠি</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10437_168488_1945134"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An optional Live Meeting tool that allows users to create Live Meeting slides and add a presenter photo as part of a Microsoft PowerPoint file.</descrip></descripGrp><ntig><termGrp><term id="168488">PowerPoint add-in</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="1945134">PowerPoint অ্যাড-ইন</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10443_294444_472669"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of chart that compares the aggregate values of a number of data series.</descrip></descripGrp><ntig><termGrp><term id="294444">radar chart</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="472669">রাডার চার্ট</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10444_139402_1945466"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A design template that also contains text suggestions on each slide. You replace the text suggestions with the text that you want. A content template contains a slide master and an optional title master.</descrip></descripGrp><ntig><termGrp><term id="139402">content template</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="1945466">বিষয়বস্তু টেমপ্লেট</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10444_139402_472075"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A design template that also contains text suggestions on each slide. You replace the text suggestions with the text that you want. A content template contains a slide master and an optional title master.</descrip></descripGrp><ntig><termGrp><term id="139402">content template</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="472075">সামগ্রী টেমপ্লেট</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1045_137287_1424612"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Text displayed by Web browsers during image downloads for users who have graphics turned off, and for users who rely on screen-reading software to convert graphics on the screen to spoken words.</descrip></descripGrp><ntig><termGr