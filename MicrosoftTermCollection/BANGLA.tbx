ook.</descrip></descripGrp><ntig><termGrp><term id="2522672">Business Card</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2525195">ব্যবসা কার্ড</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44818_2522794_2525199"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pointing in the direction of the user of the device.</descrip></descripGrp><ntig><termGrp><term id="2522794">front facing</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2525199">সামনের দিকে মুখ করে থাকা</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44819_2522797_2525194"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pointing away from the direction of the user of the device.</descrip></descripGrp><ntig><termGrp><term id="2522797">back facing</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2525194">পিছনের দিকে মুখ করে থাকা</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4482_151787_1467466"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A view of the workspace that displays the sequence of your clips.</descrip></descripGrp><ntig><termGrp><term id="151787">storyboard</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="1467466">কথনফলক</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4482_151787_472176"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A view of the workspace that displays the sequence of your clips.</descrip></descripGrp><ntig><termGrp><term id="151787">storyboard</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="472176">স্টোরিবোর্ড</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44820_2522800_2525200"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A piece of code incorporated into a project that was not written by the owners of the project.</descrip></descripGrp><ntig><termGrp><term id="2522800">third-party code</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2525200">তৃতীয় পক্ষের কোড</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNot