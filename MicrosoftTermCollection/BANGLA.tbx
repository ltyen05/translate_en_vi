ch">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2336397">সরঞ্জামবাক্স</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40108_2330214_2336616"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The container that holds all the tools for the authoring canvas.</descrip></descripGrp><ntig><termGrp><term id="2330214">toolbox</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2336616">টুলবাক্স</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40109_2330388_2336351"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that enables customers to satisfy stringent SEC Rule 17a-4 record retention requirements with advanced administrative controls for archiving such as restricting changes to archiving policies and preventing such policies from being turned off or removed.</descrip></descripGrp><ntig><termGrp><term id="2330388">Preservation Lock</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2336351">সংরক্ষণ লক</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40111_2330390_2335006"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A generic reference to an organization's Windows Store for Business to offer specific content to their users, and for users to download approved content.</descrip></descripGrp><ntig><termGrp><term id="2330390">private store</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2335006">ব্যক্তিগত স্টোর</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40112_2330405_2335004"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A map downloaded to your PC, phone or tablet that can be used to get directions and search for places even when you are not connected to the Internet.</descrip></descripGrp><ntig><termGrp><term id="2330405">offline map</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2335004">অফলাইন মানচিত্র</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40116_2331304_2335001"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A person or business that makes line-of-business apps available to customers through an online market.</descrip></descripGrp><ntig><termGrp><term id="2331304">line-of-business publisher</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</te