ripGrp><descrip type="definition">A payment method used in Brazil that is issued in the form of a paper ticket from ATMs or various agencies or businesses.</descrip></descripGrp><ntig><termGrp><term id="1993200">Boleto Bancário</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2005061">Boleto Bancário</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34515_1993201_2005061"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A payment method used in Brazil that is issued in the form of a paper ticket from ATMs or various agencies or businesses.</descrip></descripGrp><ntig><termGrp><term id="1993201">boleto</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2005061">Boleto Bancário</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34516_1993202_2005068"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A series of 18 digits used to identify bank accounts and their holders in Mexico and used to route electronic funds transfers.</descrip></descripGrp><ntig><termGrp><term id="1993202">CLABE</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2005068">CLABE</term><termNote type="geographicalUsage">IND, BGD</te