Number">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52729_2956707_2996771"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A way to manage how members of a family use their Microsoft accounts, get reports on a child's activity, set screen time limits, check on a child's location, limit which websites and games they can access, and require approval to purchase from the Microsoft Store.</descrip></descripGrp><ntig><termGrp><term id="2956707">family group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2996771">পারিবারিক গ্রুপ</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52730_2956708_2996970"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Software that searches through on-premises file shares and SharePoint document libraries and folders for sensitive items that meet the criteria of a data loss prevention policy.</descrip></descripGrp><ntig><termGrp><term id="2956708">scanner</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2996970">স্ক্যানার</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52731_2956709_2996661"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To calculate the derivative, or rate of change, or a function.</descrip></descripGrp><ntig><termGrp><term id="2956709">differentiate</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2996661">ডিফারেনশিয়েট</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52732_2956710_2996439"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To multiply on the left by one element and on the right by its inverse.</descrip></descripGrp><ntig><termGrp><term id="2956710">conjugate</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2996439">কনজুগেট</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52733_2956711_2996962"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Denoting different kinds of mutual relation, often with reference to the substitution of reciprocals for given quantities.</descrip></descripGrp><ntig><termGrp><term id="2956711">reciprocal</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2996962">রেসিপ্রোকাল</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52734_2956714_2996860"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To subject to the operation of finding the integral of a function.</descrip></descripGrp><ntig><termGrp><term id="2956714">Integrate</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2996860">ইন্টিগ্রেট</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52735_2956715_2996802"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The largest positive integer that is a factor/divisor of each of a given set of integers.</descrip></descripGrp><ntig><termGrp><term id="2956715">greatest common factor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2996802">সর্বোচ্চ সাধারণ গুণিতক</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52736_2956716_2996966"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Of a number or expression, a number which, when raised to a specified power, yields the specified number or expression.</descrip></descripGrp><ntig><termGrp><term id="2956716">root</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2996966">মূল</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52737_2956717_2996984"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An expression consisting of three terms.</descrip></descripGrp><ntig><termGrp><term id="2956717">trinomial</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2996984">ত্রিপদ রাশি</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52738_2956718_2996915"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A polynomial equation of the second degree.</descrip></descripGrp><ntig><termGrp><term id="2956718">quadratic equation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2996915">কোয়াড্রেটিক সমীকরণ</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52739_2956719_2996858"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A multiplicative factor consisting of a whole number.</descrip></descripGrp><ntig><termGrp><term id="2956719">Integer coefficient</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2996858">ইন্টিগার কোএফিসিয়েন্ট</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5274_168784_1467501"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To go back to a previous state by reversing the effects of one or more commands.</descrip></descripGrp><ntig><termGrp><term id="168784">undo</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="1467501">অকার্যকর করুন</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5274_168784_472234"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To go back to a previous state by reversing the effects of one or more commands.</descrip></descripGrp><ntig><termGrp><term id="168784">undo</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="472234">পূর্বাবস্থা</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52741_2956721_2996960"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A solution that is a rational number, that is any number that can be represented in the form of p/q where q=/=0.</descrip></descripGrp><ntig><termGrp><term id="2956721">rational solution</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2996960">যুক্তিযুক্ত সমাধান</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52742_2956722_2996640"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A scalar value that is a function of the entries of a square matrix.</descrip></descripGrp><ntig><termGrp><term id="2956722">determinant</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2996640">ডিটারমিন্যান্ট</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52743_2956723_2996854"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A statement that of two quantities one is specifically less than or greater than another.</descrip></descripGrp><ntig><termGrp><term id="2956723">inequality</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2996854">অসম</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52744_2956724_2996979"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The replacement of the variables in an algebraic expression by their values in terms of another set of variables.</descrip></descripGrp><ntig><termGrp><term id="2956724">transformation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2996979">স্থানান্তরণ</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52745_2956725_2996634"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The derived function of a function.</descrip></descripGrp><ntig><termGrp><term id="2956725">derivative</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2996634">ডেরিভেটিভ</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52746_2956726_2996864"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The coordinate of the point at which a curve intersects an axis.</descrip></descripGrp><ntig><termGrp><term id="2956726">intercept</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2996864">ইন্টারসেপ্ট</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52747_2956727_2996629"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In a right triangle, the reciprocal of the sine of an angle.</descrip></descripGrp><ntig><termGrp><term id="2956727">cosecant</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2996629">কোসেক্যান্ট</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52748_2956728_2996671"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A disjunction which is true if only one, but not both, of its disjuncts is true.</descrip></descripGrp><ntig><termGrp><term id="2956728">exclusive disjunction</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2996671">এক্সক্লুসিভ ডিসজাংশন</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52749_2956729_2996976"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The symbol of the trigonometric function tangent.</descrip></descripGrp><ntig><termGrp><term id="2956729">tan</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2996976">ট্যান</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52750_2956730_2996797"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To show what part of the number line contains values that will “satisfy” the given inequality.</descrip></descripGrp><ntig><termGrp><term id="2956730">Graph Inequality</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2996797">গ্রাফে অসাম্য</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52751_2956731_2996877"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Of a function, the state of either never decreasing or never increasing as its independent variable increases.</descrip></descripGrp><ntig><termGrp><term id="2956731">Monotonicity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2996877">মনোটনোসিটি</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52752_2956732_2996846"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A complex number, usually denoted with i, that is defined by i2=-1.</descrip></descripGrp><ntig><termGrp><term id="2956732">imaginary unit</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2996846">ইমাজিনারি ইউনিট</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52753_2956733_2996837"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Of a complex number a+bi, where a and b are real numbers, the value b.</descrip></descripGrp><ntig><termGrp><term id="2956733">imaginary part</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2996837">ইমাজিনারি পার্ট</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52754_2956734_2996436"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A function whose derivative is a given function, an indefinite integral.</descrip></descripGrp><ntig><termGrp><term id="2956734">antiderivative</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2996436">অ্যান্টিডেরিভেটিভ</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52755_2956735_2996881"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An identity that expresses the Pythagorean theorem in terms of trigonometric functions.</descrip></descripGrp><ntig><termGrp><term id="2956735">Pythagorean Identity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2996881">পিথাগোরিয়ান আইডেন্টিটি</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52756_2956736_2996968"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mnemonic device for computing the determinant of a 3x3 matrix named after the French mathematician Pierre Frédéric Sarrus.</descrip></descripGrp><ntig><termGrp><term id="2956736">Sarrus' Rule</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2996968">সারুর নীতি</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52757_2956737_2996977"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">For a polynomial sorted by degree, the last monomial term.</descrip></descripGrp><ntig><termGrp><term id="2956737">trailing term</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2996977">ট্রেলিং টার্ম</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52758_2956738_2996755"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A way of representing repeated multiplications of the same number by writing the number as a base with the number of repeats written as a small number to its upper right.</descrip></descripGrp><ntig><termGrp><term id="2956738">exponential form</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2996755">এক্সপোনেন্সিয়াল ফর্ম</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52759_2956739_2996955"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mathematical root expressed with a radical sign, generally a square root or cube root.</descrip></descripGrp><ntig><termGrp><term id="2956739">radical form</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2996955">রাডিক্যাল ফর্ম</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52760_2956740_2996874"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The capability that gives the user instantaneous access to a device by using a remote shell connection, granting them the power to do in-depth investigative work and take immediate response actions to promptly contain identified threats in real time.</descrip></descripGrp><ntig><termGrp><term id="2956740">Live Response</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2996874">লাইভ প্রতিক্রিয়া</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52773_2997773_2997784"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Information Excel function that returns TRUE if the value is any error value.</descrip></descripGrp><ntig><termGrp><term id="2997773">ISERROR</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2997784">ISERROR</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52774_2997860_2999057"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature in Microsoft Edge that allows the user to keep track of their ideas on the web by adding pages, images, links, or text to a nameable collection that can be saved and synced across signed-in devices.</descrip></descripGrp><ntig><termGrp><term id="2997860">Collections</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2999057">সংগ্রহগুলি</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52775_2997861_2999056"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of pages, notes, images, or other content saved by the user in the Collections feature in Microsoft Edge.</descrip></descripGrp><ntig><termGrp><term id="2997861">collection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2999056">সংকলন</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52776_2997862_2999084"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">SDK for developers to leverage features and capabilities that are part of the core OS code.</descrip></descripGrp><ntig><termGrp><term id="2997862">Windows Platform SDK</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2999084">Windows প্ল্যাটফর্ম SDK</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52777_2997863_2999081"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">SDK for developers to leverage features and capabilities that have been decoupled from the core OS code.</descrip></descripGrp><ntig><termGrp><term id="2997863">Windows App SDK</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2999081">Windows অ্যাপ SDK</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52778_2997864_2999066"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The edition of Windows 11 that is based on the Windows 11 Enterprise bits and optimized for Education customers.</descrip></descripGrp><ntig><termGrp><term id="2997864">Windows 11 Education</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2999066">Windows 11 শিক্ষা</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52779_2997865_2999077"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The edition of Windows 11 that is based on Windows 11 Pro and optimized for Education customers and can be pre-installed on EDU devices.</descrip></descripGrp><ntig><termGrp><term id="2997865">Windows 11 Pro Education</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2999077">Windows 11 প্রো শিক্ষা</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52780_2997866_2999071"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The edition of Windows 11 targeting enterprise customers.</descrip></descripGrp><ntig><termGrp><term id="2997866">Windows 11 Enterprise</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2999071">Windows 11 এন্টারপ্রাইজ</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52781_2997867_2999064"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The edition of the Windows 11 operating system that is available through a subscription targeting commercial customers.</descrip></descripGrp><ntig><termGrp><term id="2997867">Windows 11 Business</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2999064">Windows 11 ব্যবসা</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52782_2997868_2999078"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The edition of the Windows 11 operating system that has been specifically optimized for workstations.</descrip></descripGrp><ntig><termGrp><term id="2997868">Windows 11 Pro for Workstations</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2999078">ওয়ার্কস্টেশনের জন্য Windows 11 প্রো</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52783_2997869_2999075"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The edition of the Windows 11 operating system that targets business customers and comes pre-installed on devices.</descrip></descripGrp><ntig><termGrp><term id="2997869">Windows 11 Pro</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2999075">Windows 11 প্রো</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52784_2997870_2999073"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The edition of the Windows 11 operating system that targets consumers.</descrip></descripGrp><ntig><termGrp><term id="2997870">Windows 11 Home</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2999073">Windows 11 হোম</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52785_2997871_2999062"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The version 11 of the Windows operating system.</descrip></descripGrp><ntig><termGrp><term id="2997871">Windows 11</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2999062">Windows 11</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52786_2998899_2999755"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Costa Rican national holiday celebrated on December 1 to commemorate the day in 1948 on which then-President José Figueres Ferrer abolished the armed forces following the end of the Costa Rican Civil War.</descrip></descripGrp><ntig><termGrp><term id="2998899">Abolition of the Army</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2999755">সেনাবাহিনীর অবলুপ্তি</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52787_2998900_2999757"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The audio-centric user experience that enables Teams customers to catch up on communications, events, and activities when getting back online and to stay connected with work while being distracted from everyday chores.</descrip></descripGrp><ntig><termGrp><term id="2998900">Catch Me Up</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2999757">কথোপকথন করা</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52788_2999688_2999965"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Expressed in terms of a power of e; or, characterized by a rate of change that is proportional to the value of the varying quantity.</descrip></descripGrp><ntig><termGrp><term id="2999688">exponential</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2999965">এক্সপোনেন্সিয়াল</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52789_2999689_2999963"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Of a complex number, the number with a real part and an imaginary part equal in magnitude but opposite in sign; for example, if a and b are real, then the complex conjugate of a+bi is equal to a-bi.</descrip></descripGrp><ntig><termGrp><term id="2999689">complex conjugate</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2999963">জটিল অনুবন্ধী</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5279_95225_471835"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A sequence of 25 letters and numbers. To activate some software, you must enter a product key during the activation process.</descrip></descripGrp><ntig><termGrp><term id="95225">product key</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="471835">পণ্য কী</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52790_2999690_2999966"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mathematical object that can be interpreted as an area or a generalization of an area.</descrip></descripGrp><ntig><termGrp><term id="2999690">integral</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2999966">ইন্টিগ্রাল</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52793_3000145_3000423"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A person's default space in the Mesh app for HoloLens, private and only accessible by its owner.</descrip></descripGrp><ntig><termGrp><term id="3000145">home space</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="3000423">হোম স্পেস</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52794_3000146_3000420"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A space in which multiple people connect and collaborate together in the Mesh app for HoloLens.</descrip></descripGrp><ntig><termGrp><term id="3000146">collaborative space</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="3000420">সহযোগিতামূলক স্পেস</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52795_3000147_3000433"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A location in mixed reality that persists, contains content (models, ink, images, etc), supports real-time presence of the members of the space, and can be bound to one (or more) locations in the real world.</descrip></descripGrp><ntig><termGrp><term id="3000147">space</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="3000433">স্পেস</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52796_3000148_3000430"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Set of settings accessible directly from the right corner of the Windows 11 taskbar (e.g. brightness, Wi-Fi, Bluetooth, etc.).</descrip></descripGrp><ntig><termGrp><term id="3000148">quick settings</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="3000430">দ্রুত সেটিংসসমূহ</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52797_3000149_3000431"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Refreshed version of the Segoe UI font redesigned as a variable font to improve readability and scalability for Windows 11.</descrip></descripGrp><ntig><termGrp><term id="3000149">Segoe UI Variable</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="3000431">Segoe UI ভেরিয়েবল</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52798_3000151_3000427"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The service, powered by Azure, that enables presence and shared experiences from anywhere – on any device – through mixed reality applications; the app for Hololens that lets people connect, share, and collaborate in mixed reality that runs on that service.</descrip></descripGrp><ntig><termGrp><term id="3000151">Microsoft Mesh</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="3000427">Mesh</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52798_3000151_3000429"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The service, powered by Azure, that enables presence and shared experiences from anywhere – on any device – through mixed reality applications; the app for Hololens that lets people connect, share, and collaborate in mixed reality that runs on that service.</descrip></descripGrp><ntig><termGrp><term id="3000151">Microsoft Mesh</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="3000429">Microsoft Mesh</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52798_3000152_3000427"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The service, powered by Azure, that enables presence and shared experiences from anywhere – on any device – through mixed reality applications; the app for Hololens that lets people connect, share, and collaborate in mixed reality that runs on that service.</descrip></descripGrp><ntig><termGrp><term id="3000152">Mesh</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="3000427">Mesh</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52798_3000152_3000429"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The service, powered by Azure, that enables presence and shared experiences from anywhere – on any device – through mixed reality applications; the app for Hololens that lets people connect, share, and collaborate in mixed reality that runs on that service.</descrip></descripGrp><ntig><termGrp><term id="3000152">Mesh</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="3000429">Microsoft Mesh</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="528_67425_471618"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The location where the user is currently directing input.</descrip></descripGrp><ntig><termGrp><term id="67425">input focus</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="471618">ইনপুট ফোকাস</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="528_67425_613549"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The location where the user is currently directing input.</descrip></descripGrp><ntig><termGrp><term id="67425">input focus</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="613549">ইনপুট ফোকাস</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52810_3001101_3001440"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature in Microsoft Teams for Education that allows educators to quickly and easily communicate with their students’ parents and guardians.</descrip></descripGrp><ntig><termGrp><term id="3001101">Parents</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="3001440">মা-বাবারা</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52811_3001102_3001437"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature in Outlook that allows customers to book the time and means of transportation they need to travel between meetings or events, including options like walking, biking, driving, public transport, and even 3rd party resources like Lyft or Uber.</descrip></descripGrp><ntig><termGrp><term id="3001102">Commute</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="3001437">যাতায়াতের অবলম্বন</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52812_3001103_3001438"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature in Microsoft Teams Rooms that provides users in the room with an enhanced meeting layout by bringing meeting information gathered from fluid components to the forefront of the screen and bringing the gallery to the bottom so people can meet face to face.</descrip></descripGrp><ntig><termGrp><term id="3001103">Front row</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="3001438">সামনের সারি</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52813_3001104_3001442"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Teams channel to which team owners can add users (people) who aren't members of the team.</descrip></descripGrp><ntig><termGrp><term id="3001104">shared channel</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="3001442">শেয়ারকৃত চ্যানেল</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52814_3001105_3001443"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The last portion of the URL for a SharePoint site.</descrip></descripGrp><ntig><termGrp><term id="3001105">site address</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="3001443">সাইটের ঠিকানা</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52815_3001106_3001441"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Teams channel that's created for a subset of people in the team.</descrip></descripGrp><ntig><termGrp><term id="3001106">private channel</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="3001441">ব্যক্তিগত চ্যানেল</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote typ