6195"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A physical or electronic card storing currency that customers can use to buy apps and similar items.</descrip></descripGrp><ntig><termGrp><term id="1982878">gift card</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="1986195">উপহারের কার্ড</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34187_1986150_1989256"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">likely to produce a situation in which one of several threads is waiting for the other thread(s) to do something</descrip></descripGrp><ntig><termGrp><term id="1986150">deadlock-prone</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="1989256">আটক-পরিস্থিতি</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34187_1986150_1989296"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">likely to produce a situation in which one of several threads is waiting for the other thread(s) to do something</descrip></descripGrp><ntig><termGrp><term id="1986150">deadlock-prone</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="1989296">অচলাবস্থা-প্রবণ</term><termNote type="geographicalUsage">IN