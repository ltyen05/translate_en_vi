t xml:lang="en-US"><descripGrp><descrip type="definition">A container for items that are deleted. Items in this container are visible to users with the appropriate permissions and to site collection administrators.</descrip></descripGrp><ntig><termGrp><term id="1506722">first-stage Recycle Bin</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2308560">প্রথম পর্যায়ের রিসাইকেল বিন</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29193_1644672_1854401"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Web Part that renders named objects or named items in a workbook, such as tables, charts, slicers or a named range of cells.</descrip></descripGrp><ntig><termGrp><term id="1644672">named item view</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="1854401">নামযুক্ত আইটেম দৃশ্য</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2923_59620_471575"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method of specifying software behavior by system administrators. Administrators set policies that are used to control how software features behave.</descrip></descripGrp><ntig><termGrp><term id="59620">Group Policy</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="471575">গোষ্ঠী নীতি</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2923_59620_613507"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method of specifying software behavior by system administrators. Administrators set policies that are used to control how software features behave.</descrip></descripGrp><ntig><termGrp><term id="59620">Group Policy</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="613507">গ্রুপ পলিসি</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29256_1506853_2308567"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A container for items that have been deleted from a first-stage Recycle Bin. Items in a second-stage Recycle Bin are visible only to site collection administrators.</descrip></descripGrp><ntig><termGrp><term id="1506853">second-stage Recycle Bin</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2308567">দ্বিতীয় পর্যায়ের রিসাইকেল বিন</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29257_1506854_1588737"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A symmetric encryption key shared by two entities, such as between a user and the domain controller (DC), with a long lifetime. A password is a common example of a secret key. When used in a context that implies Kerberos only, a principal's secret key.</descrip></descripGrp><ntig><termGrp><term id="1506854">secret key</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="1588737">গোপন কী</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29257_1506854_1588780"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A symmetric encryption key shared by two entities, such as between a user and the domain controller (DC), with a long lifetime. A password is a common example of a secret key. When used in a context that implies Kerberos only, a principal's secret key.</descrip></descripGrp><ntig><termGrp><term id="1506854">secret key</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="1588780">গোপন কী</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="293_147704_1255803"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A reference to data stored in a document from another program.</descrip></descripGrp><ntig><termGrp><term id="147704">remote reference</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</te