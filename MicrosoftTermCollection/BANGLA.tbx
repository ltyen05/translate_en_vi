70638"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The set of REST APIs that allows app developers unified access to entities and relationships from Microsoft and Office 365 services.</descrip></descripGrp><ntig><termGrp><term id="2267302">Microsoft Graph</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2270638">Microsoft Graph</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38981_2267303_2352066"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Sway feature that figures out which part of an image is important, and then determines how to best fit the image within its current context and Design.</descrip></descripGrp><ntig><termGrp><term id="2267303">Focus Points</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2352066">ফোকাস পয়েন্ট</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38983_2267305_2352065"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Sway card that takes two images and creates a swipe left/right interaction so that they can be compared.</descrip></descripGrp><ntig><termGrp><term id="2267305">Comparison</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"