</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2767518">ফেডারেশন</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11968_1089155_472874"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The &amp; character.</descrip></descripGrp><ntig><termGrp><term id="1089155">&amp;</term><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="472874">এবং চিহ্ন</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11968_1089155_614792"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The &amp; character.</descrip></descripGrp><ntig><termGrp><term id="1089155">&amp;</term><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="614792">এম্পারসেন্ড</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11968_318355_472874"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The &amp; character.</descrip></descripGrp><ntig><termGrp><term id="318355">ampersand</term><termNote type="partOfSpeech">Noun</termNote><termNote type="gra