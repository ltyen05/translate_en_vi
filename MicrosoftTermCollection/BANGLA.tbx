descrip type="definition">An auditing record that records any action, based on a Windows PowerShell cmdlet, performed by an administrator. This can help the administrator troubleshoot configuration issues or identify the cause of security- or compliance-related problems.</descrip></descripGrp><ntig><termGrp><term id="1496240">administrator audit log</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="1959408">প্রশাসক নিরীক্ষা লগ</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28774_1496240_2296980"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An auditing record that records any action, based on a Windows PowerShell cmdlet, performed by an administrator. This can help the administrator troubleshoot configuration issues or identify the cause of security- or compliance-related problems.</descrip></descripGrp><ntig><termGrp><term id="1496240">administrator audit log</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2296980">প্রশাসক সমীক্ষা লগ</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28777_1496243_1959484"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An email migration process that provisions new cloud-based mailboxes and then migrates mailbox data to the cloud.</descrip></descripGrp><ntig><termGrp><term id="1496243">cutover migration</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="1959484">কাটওভার মাইগ্রেশন</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28777_1496243_2297051"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An email migration process that provisions new cloud-based mailboxes and then migrates mailbox data to the cloud.</descrip></descripGrp><ntig><termGrp><term id="1496243">cutover migration</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2297051">দ্রুত স্থানান্তরকরণ</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28778_1496244_1959536"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of message journaling in which the original unaltered message is included as an attachment in the journal report.</descrip></descripGrp><ntig><termGrp><term id="1496244">envelope journaling</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="1959536">এনভালোপ জার্নালিং</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28778_1496244_2297100"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of message journaling in which the original unaltered message is included as an attachment in the journal report.</descrip></descripGrp><ntig><termGrp><term id="1496244">envelope journaling</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2297100">এনভেলাপ জার্নালিং</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28779_1496245_1959562"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A template applied to the distribution group names in your Microsoft Exchange organization. Specifically, you can specify that a prefix, a suffix, or both be applied to all distribution group names. You can also block certain words from being used in the names.</descrip></descripGrp><ntig><termGrp><term id="1496245">group naming policy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="1959562">গোষ্ঠীর নামকরণ নীতিমালা</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28779_1496245_2297127"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A template applied to the distribution group names in your Microsoft Exchange organization. Specifically, you can specify that a prefix, a suffix, or both be applied to all distribution group names. You can also block certain words from being used in the names.</descrip></descripGrp><ntig><termGrp><term id="1496245">group naming policy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2297127">গোষ্ঠী নামকরণের নীতি</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28780_1496246_1959581"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In email migration, the stage when the mailboxes in the on-premises Exchange organization and the corresponding cloud-based mailboxes are synchronized every 24 hours, after the initial synchronization. This means that any new messages sent to the mailboxes on the Exchange server are copied to the corresponding cloud-based mailboxes. Incremental synchronization continues until the administrator completes the overall migration.</descrip></descripGrp><ntig><termGrp><term id="1496246">incremental synchronization</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="1959581">ক্রমবর্ধমান সিংক্রোনাইজেশন</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28780_1496246_2297146"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In email migration, the stage when the mailboxes in the on-premises Exchange organization and the corresponding cloud-based mailboxes are synchronized every 24 hours, after the initial synchronization. This means that any new messages sent to the mailboxes on the Exchange server are copied to the corresponding cloud-based mailboxes. Incremental synchronization continues until the administrator completes the overall migration.</descrip></descripGrp><ntig><termGrp><term id="1496246">incremental synchronization</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2297146">ক্রমবর্ধমান সমলয়</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28781_1496247_1959592"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The message that is generated when a message matches a journal rule. The body of the journal report contains information from the original message such as the sender email address, message subject, message-ID, and recipient email addresses. The journal report also includes the original unaltered message as an attachment.</descrip></descripGrp><ntig><termGrp><term id="1496247">journal report</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="1959592">জার্নাল প্রতিবেদন</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28782_1496248_1959593"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Exchange rule that is used to record the email messages sent to or from specific recipients.</descrip></descripGrp><ntig><termGrp><term id="1496248">journal rule</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="1959593">জার্নাল বিধি</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28784_1496250_1959766"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of email migration that migrates a subset of on-premises mailboxes to the cloud. This type of migration allows the admin to maintain coexistence between their on-premises and cloud-based email organizations.</descrip></descripGrp><ntig><termGrp><term id="1496250">staged migration</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="1959766">অগ্রগমনশীল মাইগ্রেশন</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28784_1496250_2297316"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of email migration that migrates a subset of on-premises mailboxes to the cloud. This type of migration allows the admin to maintain coexistence between their on-premises and cloud-based email organizations.</descrip></descripGrp><ntig><termGrp><term id="1496250">staged migration</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2297316">পর্যায়ভুক্ত স্থানান্তরণ</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28785_1496251_1959493"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of saving only one copy of duplicate items in the search results</descrip></descripGrp><ntig><termGrp><term id="1496251">deduplication</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="1959493">একক অনুরূপ</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28785_1496251_2297059"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of saving only one copy of duplicate items in the search results</descrip></descripGrp><ntig><termGrp><term id="1496251">deduplication</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2297059">একবার মাত্র অনুলিপি করার পদ্ধতি</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28786_1496252_1959574"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A unique user identifier that must not change for the user over the lifetime of the user being in the system.</descrip></descripGrp><ntig><termGrp><term id="1496252">immutable ID</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="1959574">অপরিবর্তনীয় ID</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28786_1496252_2297139"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A unique user identifier that must not change for the user over the lifetime of the user being in the system.</descrip></descripGrp><ntig><termGrp><term id="1496252">immutable ID</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2297139">অপরিবর্তনীয় ID</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2879_237829_2735848"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An alpha-numeric identifier for a marketing campaign that is distinct from its name.</descrip></descripGrp><ntig><termGrp><term id="237829">campaign code</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="bn"><ntig><termGrp><term id="2735848">প্রচার কোড</term><termNote type="geographicalUsage">IND, BGD</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2879_237829_2735883"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An alpha-numeric identifier for a marketing campaign that is distinct from its name.</descrip></descripGrp><ntig><termGrp><term id="237829">campai