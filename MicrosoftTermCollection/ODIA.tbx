ork</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="3017224">ହାଇବ୍ରିଡ୍ କାର୍ଯ୍ୟ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53055_3017115_3017239"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The option in Presenter Mode in which the content is displayed as one rectangle to the left and the video of the presenter is displayed in another rectangle to the right.</descrip></descripGrp><ntig><termGrp><term id="3017115">Side-by-side</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="3017239">ସାଥେ ସାଥେ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53056_3017116_3017232"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The universal interactive canvas application that moves freely across applications, bringing human connection back into hybrid work to enable teams to think, plan, and create together.</descrip></descripGrp><ntig><termGrp><term id="3017116">Loop</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="3017232">Loop</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="gramma