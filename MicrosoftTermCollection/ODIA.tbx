 type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="484543">ମାର୍ଜିନ୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12253_322621_485798"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The blank space outside the printing area on a page.</descrip></descripGrp><ntig><termGrp><term id="322621">page margin</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="485798">ପୃଷ୍ଠା ମାର୍ଜିନ୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12253_78289_484543"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The blank space outside the printing area on a page.</descrip></descripGrp><ntig><termGrp><term id="78289">margin</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="484543">ମାର୍ଜିନ୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12253_78289_485798"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The blank space outside the printing area on a page.</descrip></descripGrp><ntig><termGrp><term id="78289">margin</term><termNote type="pa