on">In Music, a highly personalized form of auto-playlist (rules-based playlist) that is created by Microsoft for the customer, drawing music from the customer's music collection, and, if the customer has an active music pass, may also include songs from our music catalog.</descrip></descripGrp><ntig><termGrp><term id="2321515">mixtape</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2325755">ମିକ୍ସଟ୍ୟାପ୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39012_2268334_2269559"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Cellular data that customers can buy from the Windows Store to connect to their Windows device.</descrip></descripGrp><ntig><termGrp><term id="2268334">paid cellular data</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2269559">ଦେୟଯୁକ୍ତ ସେଲ୍ୟୁଲାର୍ ଡାଟା</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39013_2268335_2269560"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Wi-Fi data or cellular data network that customers can connect to by buying minutes from the Windows Store.</descrip></descripGrp><ntig><termGrp><term id="2268335">paid data network</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2269560">ଦେୟଯୁକ୍ତ ଡାଟା ନେଟ୍‌ୱାର୍କ୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39015_2268349_2269563"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An area in the Music app where recently played songs/albums and service-generated mixes are aggregated.</descrip></descripGrp><ntig><termGrp><term id="2268349">quick play</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2269563">ଶୀଘ୍ର ଚାଳନ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3902_139982_1259028"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A presentation within a presentation in which you group slides in an existing presentation so that you can show that section of the presentation to a particular audience.</descrip></descripGrp><ntig><termGrp><term id="139982">custom show</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1259028">କଷ୍ଟମ୍ ପ୍ରଦର୍ଶନ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3906_30558_1259873"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A distance between characters in a line of text.</descrip></descripGrp><ntig><termGrp><term id="30558">character spacing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1259873">ବର୍ଣ୍ଣ ବ୍ୟବଧାନୀକରଣ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39063_2269425_2279560"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The year 2016 edition of Microsoft Office available to students who attend an educational institution.</descrip></descripGrp><ntig><termGrp><term id="2269425">Office Professional Academic 2016</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2279560">Office Professional Academic 2016</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39063_2482683_2279560"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The year 2016 edition of Microsoft Office available to students who attend an educational institution.</descrip></descripGrp><ntig><termGrp><term id="2482683">Office Professional Academic 2016 for PC</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2279560">Office Professional Academic 2016</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammat