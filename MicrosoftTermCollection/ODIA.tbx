te type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14727_168754_1802615"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A logical network connection between two entities such as a user or computer, that has a defined lifetime and associated state, and that might involve multiple physical connections.</descrip></descripGrp><ntig><termGrp><term id="168754">session</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1802615">ଅଧିବେଶନ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14733_31389_1260129"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To pick a command or an option from within a graphical user interface, as by clicking a button in a dialog box or pulling down a menu and then releasing the mouse button on one of its options.</descrip></descripGrp><ntig><termGrp><term id="31389">choose</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1260129">ମନୋନୟନ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14738_124210_1881120"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A unit of measure used in typesetting and desktop publishing, equal to one-twentieth of a printer's point, or 1/1440th of an inch.</descrip></descripGrp><ntig><termGrp><term id="124210">twip</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1881120">ଟୁଇପ୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14742_375721_1957404"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature available in Outlook 2007 and some mobile devices that automatically configures the clients for access to Exchange Server 2007. The client sends the user name and password information to the Exchange 2007 server. The Autodiscover Web service that is running on the Exchange Client Access server returns an XML file that contains configuration information, which is interpreted by the client. If the user is moved to a different server later, the client will automatically query the Autodiscover Web service again to update the client configuration.</descrip></descripGrp><ntig><termGrp><term id="375721">Autodiscover</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1957404">ସ୍ଵତଃଆବିଷ୍କାର</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14749_397189_1957635"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process by which Exchange Server creates and updates the OAB. Administrators can define when the OAB generation process will run.</descrip></descripGrp><ntig><termGrp><term id="397189">offline address book generation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1957635">OAB ଜେନେରେସନ୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14749_397189_1957639"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process by which Exchange Server creates and updates the OAB. Administrators can define when the OAB generation process will run.</descrip></descripGrp><ntig><termGrp><term id="397189">offline address book generation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1957639">ଅଫଲାଇନ୍ ଠିକଣା ପୁସ୍ତକ ଜେନେରେସନ୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14749_397190_1957635"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process by which Exchange Server creates and updates the OAB. Administrators can define when the OAB generation process will run.</descrip></descripGrp><ntig><termGrp><term id="397190">OAB generation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1957635">OAB ଜେନେରେସନ୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="gra