p type="definition">A software that was installed on the system without user's consent.</descrip></descripGrp><ntig><termGrp><term id="236971">unwanted software</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1259894">ଆଯାଜିତ ସଫ୍ଟଓ୍ୱେୟାର</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46533_2619438_2621807"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature in Windows Defender Security Center that helps protect devices running Windows 10 by checking web content that Microsoft Store apps use.​</descrip></descripGrp><ntig><termGrp><term id="2619438">App protection</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2621807">ଆପ୍ଲିକେସନ୍ ସୁରକ୍ଷା</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46534_2619566_2621808"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature in Windows Defender Security Center that helps protect devices running Windows 10 from malicious websites and downloads.​​</descrip></descripGrp><ntig><termGrp><term id="2619566">Web protection</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2621808">ଓ୍ୱେବ୍ ସୁରକ୍ଷା</term><termNote type="geographicalUsage">IND</termNote><termNote