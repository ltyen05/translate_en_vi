e interfaces to remote CORBA objects.</descrip></descripGrp><ntig><termGrp><term id="731998">IDL</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1802584">IDL</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7002_157648_485042"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A time limit that is applied to the life of an account, so that it can be used only for a predetermined period of time.</descrip></descripGrp><ntig><termGrp><term id="157648">account expiration</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="485042">ଆକାଉଣ୍ଟ୍ ଅବଧି ଶେଷ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7010_1249014_484649"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An auxiliary software component that extends or enhances the features of other software.</descrip></descripGrp><ntig><termGrp><term id="1249014">callout</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="484649">ପ୍ଲଗ୍-ଇନ୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><te