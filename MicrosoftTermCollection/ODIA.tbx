en-US"><descripGrp><descrip type="definition">A pre-released version of a product that is sent to customers and partners for evaluation and feedback.</descrip></descripGrp><ntig><termGrp><term id="1981778">technical preview</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2623598">ଟେକନିକାଲ୍‌ ପୂର୍ବାଲୋକନ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9733_694772_2623598"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A pre-released version of a product that is sent to customers and partners for evaluation and feedback.</descrip></descripGrp><ntig><termGrp><term id="694772">beta product</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2623598">ଟେକନିକାଲ୍‌ ପୂର୍ବାଲୋକନ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9734_42848_484276"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The manipulation of data to transform it into some desired result.</descrip></descripGrp><ntig><termGrp><term id="42848">data processing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="484276">ଡାଟା ପ୍ରକ୍ରିଯାକରଣ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9753_141881_1881159"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Text or graphics inserted in a document when Microsoft Word carries out a field's instructions. When you print the document or hide field codes, the field results replace the field codes.</descrip></descripGrp><ntig><termGrp><term id="141881">field results</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1881159">କ୍ଷେତ୍ର ଫଳାଫଳଗୁଡିକ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9767_319131_1260019"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to text that is aligned along the left margin.</descrip></descripGrp><ntig><termGrp><term id="319131">left-aligned</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1260019">ବାମପାର୍ଶ୍ୱ ଶ୍ରେଣୀବଦ୍ଧତା</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9775_142952_1881164"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A drop-down list box control on a data access page that retrieves records from an underlying recordset based on the value you select from the list. On a grouped page, the control retrieves a specific group of records.</descrip></descripGrp><ntig><termGrp><term id="142952">group filter control</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1881164">ଗୋଷ୍ଠୀ ଫିଲ୍ଟର୍ ନିୟନ୍ତ୍ରଣ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9789_158215_485044"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The company placing, and often paying for, a promotional message, or advertisement.</descrip></descripGrp><ntig><termGrp><term id="158215">advertiser</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="485044">ବିଜ୍ଞାପନଦାତା</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9800_30472_484181"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In text-based computer graphics, a block of memory addresses that correspond to character spaces on a display screen. The memory allocated to each character space is used to hold the description of the character to be displayed in that space.</descrip></descripGrp><ntig><termGrp><term id="30472">character map</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="484181">ବର୍ଣ୍ଣ ମାନଚିତ୍ର</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9805_262641_485405"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A title animation in Windows Movie Maker.</descrip></descripGrp><ntig><termGrp><term id="262641">Subtitle</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="485405">ଉପଟାଇଟେଲ୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9820_2727454_485540"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A directory or folder made available to users over the network.</descrip></descripGrp><ntig><termGrp><term id="2727454">file share</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="485540">ଅଂଶ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9820_298002_485540"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A directory or folder made available to users over the network.</descrip></descripGrp><ntig><termGrp><term id="298002">share</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="485540">ଅଂଶ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9831_235026_485295"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of confirming that data passing into the system is correct and complies with predefined rules, definitions, or parameters.</descrip></descripGrp><ntig><termGrp><term id="235026">validation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="485295">ବୈଧିକରଣ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9837_23010_484121"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The partition that contains the Windows operating system and its support files. The boot partition can be, but does not have to be, the same as the system partition.</descrip></descripGrp><ntig><termGrp><term id="23010">boot partition</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="484121">ବୁଟ୍ ବିଭାଜନ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9839_503120_2372689"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A standardized service agreement between a user and a mobile operator that establishes data service details such as pricing, types of services, and bandwidth.</descrip></descripGrp><ntig><termGrp><term id="503120">data plan</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2372689">ଡାଟା ପ୍ଲାନ୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9843_54256_2910415"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The use of computer files on networks, wherein files are stored on a central computer or a server and are requested, reviewed, and modified by more than one individual. When a file is used with different programs or different computers, file sharing can require conversion to a mutually acceptable format. When a single file is shared by many people, access can be regulated through such means as password protection, security clearances, or file locking to prohibit changes to a file by more than one person at a time.</descrip></descripGrp><ntig><termGrp><term id="54256">file sharing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2910415">ଫାଇଲ୍ ଅଂଶୀଦାର</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9849_20127_484100"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In the printing and display of characters on the screen, an imaginary horizontal line with which the base of each character, excluding descenders, is aligned.</descrip></descripGrp><ntig><termGrp><term id="20127">base line</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="484100">ଆଧାରରେଖା</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9849_20128_484100"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In the printing and display of characters on the screen, an imaginary horizontal line with which the base of each character, excluding descenders, is aligned.</descrip></descripGrp><ntig><termGrp><term id="20128">baseline</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="484100">ଆଧାରରେଖା</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9856_307429_1957535"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The amount of time that can elapse before the Exchange server asks a mobile device running Exchange ActiveSync to connect again.</descrip></descripGrp><ntig><termGrp><term id="307429">heartbeat interval</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1957535">ହାର୍ଟବିଟ୍ ବିରତି</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9865_145487_1259105"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A component database architecture that provides efficient network and Internet access to many types of data sources, including relational data, mail files, flat files, and spreadsheets. OLE DB comprises a specialized set of COM interfaces that expose data from a variety of data stores, both relational and nonrelational.</descrip></descripGrp><ntig><termGrp><term id="145487">OLE DB</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1259105">OLE DB</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9865_2072504_1259105"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A component database architecture that provides efficient network and Internet access to many types of data sources, including relational data, mail files, flat files, and spreadsheets. OLE DB comprises a specialized set of COM interfaces that expose data from a variety of data stores, both relational and nonrelational.</descrip></descripGrp><ntig><termGrp><term id="2072504">Object Linking and Embedding Database</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1259105">OLE DB</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9865_2440377_1259105"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A component database architecture that provides efficient network and Internet access to many types of data sources, including relational data, mail files, flat files, and spreadsheets. OLE DB comprises a specialized set of COM interfaces that expose data from a variety of data stores, both relational and nonrelational.</descrip></descripGrp><ntig><termGrp><term id="2440377">OLEDB</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1259105">OLE DB</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9880_142307_1881162"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A substitution that occurs when Windows or your printer uses a font similar to the one you used in your publication to display or print your publication.</descrip></descripGrp><ntig><termGrp><term id="142307">font substitution</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1881162">ଫଣ୍ଟ୍ ବିକଳ୍ପନ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9884_84006_1260020"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of devices that communicate either wirelessly or via a physical connection.</descrip></descripGrp><ntig><termGrp><term id="84006">network</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1260020">ନେଟ୍ଓ୍ୱାର୍କ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9889_262434_485377"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An audio effect setting that allows users with stereo headphones to experience stereo and multi-channel content without the need to set up an extensive multi-channel speaker system.</descrip></descripGrp><ntig><termGrp><term id="262434">Headphone Virtualization mode</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="485377">ହେଡଫୋନ୍ ବାସ୍ତବୀକରଣ ମୋଡ୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9889_262434_485378"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An audio effect setting that allows users with stereo headphones to experience stereo and multi-channel content without the need to set up an extensive multi-channel speaker system.</descrip></descripGrp><ntig><termGrp><term id="262434">Headphone Virtualization mode</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="485378">ବାସ୍ତବୀକରଣ ମୋଡ୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9889_262435_485377"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An audio effect setting that allows users with stereo headphones to experience stereo and multi-channel content without the need to set up an extensive multi-channel speaker system.</descrip></descripGrp><ntig><termGrp><term id="262435">Virtualization Mode</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="485377">ହେଡଫୋନ୍ ବାସ୍ତବୀକରଣ ମୋଡ୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9889_262435_485378"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An audio effect setting that allows users with stereo headphones to experience stereo and multi-channel content without the need to set up an extensive multi-channel speaker system.</descrip></descripGrp><ntig><termGrp><term id="262435">Virtualization Mode</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="485378">ବାସ୍ତବୀକରଣ ମୋଡ୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="989_210451_1258989"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A command that will use a print driver installed by OneNote to create an image of a wide variety of filetypes. Files are printed to the print driver and inserted as images into OneNote.</descrip></descripGrp><ntig><termGrp><term id="210451">File as Printout</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1258989">ମୁଦ୍ରଣ ପାଇଁ ଫାଇଲ୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9891_269336_485473"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An event triggered by Windows system components that is recorded in the system log, such as the failure of a driver or other system component to load during startup.</descrip></descripGrp><ntig><termGrp><term id="269336">system event</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="485473">ସିଷ୍ଟମ ଇଭେଣ୍ଟ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="990_26447_1802564"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A system of programs and workstations used in designing engineering, architectural, and scientific models ranging from simple tools to buildings, aircraft, integrated circuits, and molecules.</descrip></descripGrp><ntig><termGrp><term id="26447">CAD</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1802564">CAD</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="990_26448_1802564"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A system of programs and workstations used in designing engineering, architectural, and scientific models ranging from simple tools to buildings, aircraft, integrated circuits, and molecules.</descrip></descripGrp><ntig><termGrp><term id="26448">computer-aided design</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1802564">CAD</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9900_185600_1374315"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The status that users can select to indicate that they are currently busy.</descrip></descripGrp><ntig><termGrp><term id="185600">Busy</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1374315">ବ୍ୟସ୍ତ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9911_33170_484199"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The » character.</descrip></descripGrp><ntig><termGrp><term id="33170">closing chevron</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="484199">ମୁଦ୍ରିତ ସେଭ୍ରନ୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9913_234815_1260021"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An item on the Control Panel.</descrip></descripGrp><ntig><termGrp><term id="234815">Solutions to Problems</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1260021">ସମସ୍ୟାର ସମାଧାନ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="993_72941_1259812"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The key arrangement used for a particular keyboard, including such factors as the number of keys (101 is the current standard) and the configuration of the keys (QWERTY is the United States standard). Some proprietary systems use different layouts, and many allow you to map the keys to characters according to your preferences.</descrip></descripGrp><ntig><termGrp><term id="72941">keyboard layout</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1259812">କି-ବୋର୍ଡ ଲେ ଆଉଟ୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9930_34655_484210"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A profile that contains the data needed for translating the values of a color gamut. This data includes information about color, hue, saturation, and brightness.</descrip></descripGrp><ntig><termGrp><term id="34655">color profile</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="484210">ରଙ୍ଗ ପ୍ରୋଫାଇଲ୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9934_149313_1259106"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An animation effect that specifies how the display changes as a user moves from one item (such as a slide or Web page) to another.</descrip></descripGrp><ntig><termGrp><term id="149313">transition</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1259106">ସଂକ୍ରମଣ ପ୍ରଭାବ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9934_149313_484996"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An animation effect that specifies how the display changes as a user moves from one item (such as a slide or Web page) to another.</descrip></descripGrp><ntig><termGrp><term id="149313">transition</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="484996">ସଂକ୍ରମଣ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9934_777481_1259106"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An animation effect that spe