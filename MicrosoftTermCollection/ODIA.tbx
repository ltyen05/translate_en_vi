n">A graphic element from the SmartArt feature.</descrip></descripGrp><ntig><termGrp><term id="545626">SmartArt graphic</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1951426">SmartArt ଗ୍ରାଫିକ୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16158_143130_484947"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Paragraph formatting in which the second and subsequent lines of a paragraph are indented more than the first line.</descrip></descripGrp><ntig><termGrp><term id="143130">hanging indent</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="484947">ଝୁଲା ଇନଡେଣ୍ଟ୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16161_234782_2015580"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of preset power-management options. For example, you can set elapsed times for putting your computer on standby and for turning off your monitor and hard disk. You save these settings as a named power scheme.</descrip></descripGrp><ntig><termGrp><term id="234782">power plan</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2015580">ପାୱାର୍ ପ୍ଲାନ୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</t