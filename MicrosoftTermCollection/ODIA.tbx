angSet xml:lang="en-US"><descripGrp><descrip type="definition">The Excel add-in that finds functions needed to transform and format data when the user gives it examples of the desired output.</descrip></descripGrp><ntig><termGrp><term id="2521577">Transform Data by Example</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2523993">Transform Data by Example</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4481_1133582_1996190"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Windows feature that allows users to connect remotely to a computer and access programs, files, and network resources as though they were sitting at the computer.</descrip></descripGrp><ntig><termGrp><term id="1133582">RD</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1996190">ରିମୋଟ୍ ଡେସ୍କଟପ୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4481_543804_1996190"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Windows feature that allows users to connect remotely to a computer and access programs, files, and network resources as though they were sitting at the computer.</descrip></descripGrp><ntig><termGrp><term id="543804">Remote Desktop</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</ter