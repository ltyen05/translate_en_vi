auses for disk access because memory is insufficient to hold an entire program plus the data the program is using.</descrip></descripGrp><ntig><termGrp><term id="1088805">degradation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1957471">ଅଧୋପତନ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23717_1088887_1881524"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of conditional formatting that is configured within Microsoft SQL Server Analysis Services.</descrip></descripGrp><ntig><termGrp><term id="1088887">data source formatting</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1881524">OLAP ସର୍ଭର୍ ଫର୍ମାଟିଂ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23717_1089137_1881524"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of conditional formatting that is configured within Microsoft SQL Server Analysis Services.</descrip></descripGrp><ntig><termGrp><term id="1089137">OLAP server formatting</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1881524">OLAP ସର୍ଭର୍ ଫର୍ମାଟିଂ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected<