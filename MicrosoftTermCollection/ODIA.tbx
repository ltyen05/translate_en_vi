 set of Windows features that provides parents and individuals with the ability to customize key aspects of the online experience in order to protect their children and/or themselves.</descrip></descripGrp><ntig><termGrp><term id="652974">Family Safety</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="3042837">Microsoft Family Safety</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19346_652986_1520271"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The folder that by default receives new messages.</descrip></descripGrp><ntig><termGrp><term id="652986">Inbox folder</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1520271">ଇନ୍‌ବାକ୍ସ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19346_725615_1520271"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The folder that by default receives new messages.</descrip></descripGrp><ntig><termGrp><term id="725615">Inbox</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1520271">ଇନ୍‌ବାକ୍ସ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammat