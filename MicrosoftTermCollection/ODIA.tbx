 id="24966_1166080_1957573"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An intermediary between a software publisher and a certification authority (CA). The local registration authority can, for example, verify a publisher's credentials before sending them to the CA.</descrip></descripGrp><ntig><termGrp><term id="1166080">LRA</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1957573">LRA</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24987_1166123_1881547"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A defined point in a workflow that is entered when specified conditions are met.</descrip></descripGrp><ntig><termGrp><term id="1166123">workflow stage</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1881547">କାର୍ଯ୍ୟସ୍ରୋତ ଷ୍ଟେଜ୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25_42999_484277"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In communications, the portion of a Data Terminal Equipment (DTE) device that sends data.</descrip></descripGrp><ntig><termGrp><term id="42999">data source</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="484277">ଡାଟା ଉତ୍ସ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2500_81423_1957621"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An individual who reviews content in certain online newsgroups, mailing lists, and forums in order to decide if they are appropriate or not, editing or deleting the ones that aren’t prior to them being they are made public.</descrip></descripGrp><ntig><termGrp><term id="81423">moderator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1957621">ମୋଡରେଟର୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25004_1167216_2263700"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that uses speech recognition to enable you to interact with your computer or other devices by voice. You can dictate documents and emails in mainstream applications, and use voice commands to start and switch between applications, control the operating system and even fill out forms on the web.</descrip></descripGrp><ntig><termGrp><term id="1167216">Windows Speech Recognition</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2263700">Windows ସ୍ପିଚ୍ ଚିହ୍ନଟକରଣ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSe