en shopping.</descrip></descripGrp><ntig><termGrp><term id="1056053">cart</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2483391">କାର୍ଟ୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15850_188099_2483391"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A list of items that a customer has selected to purchase from a commerce Web site. It is usually compiled into a file and sometimes visually represented by a shopping basket, shopping cart, or other container used when shopping.</descrip></descripGrp><ntig><termGrp><term id="188099">basket</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2483391">କାର୍ଟ୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15855_148370_1259169"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A character you choose to indicate where you want text to separate when you convert a table to text, or where you want new rows or columns to begin when you convert text to a table.</descrip></descripGrp><ntig><termGrp><term id="148370">separator character</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1259169">ବିଚ୍ଛେଦକ ଅକ୍ଷର</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15861_87814_2595341"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Running low on memory.</descrip></descripGrp><ntig><termGrp><term id="87814">out of memory</term><termNote type="partOfSpeech">Adverb</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2595341">କମ୍ ମେମୋରୀ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Adverb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15886_319136_484429"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ‐ character, used to break a word between syllables at the end of a line or to separate the parts of a compound word.</descrip></descripGrp><ntig><termGrp><term id="319136">HYPHEN</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="484429">ହାଇଫେନ୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15886_63086_484429"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ‐ character, used to break a word between syllables at the end of a line or to separate the parts of a compound word.</descrip></descripGrp><ntig><termGrp><term id="63086">hyphen</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="484429">ହାଇଫେନ୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15888_62684_3042777"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A color model used in some graphics programs to define a color by three values: Hue, the color itself; Saturation, the purity of the color; and Value, the lightness or darkness of a color.</descrip></descripGrp><ntig><termGrp><term id="62684">HSV</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="3042777">HSV</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15888_757192_3042777"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A color model used in some graphics programs to define a color by three values: Hue, the color itself; Saturation, the purity of the color; and Value, the lightness or darkness of a color.</descrip></descripGrp><ntig><termGrp><term id="757192">hue-saturation-value</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="3042777">HSV</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15904_138795_484900"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A range of colors in which each color gradually blends into the next one. For example, a blue ramp gradually blends hues of blue from pure black to pure blue.</descrip></descripGrp><ntig><termGrp><term id="138795">color ramp</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="484900">ରଙ୍ଗ ରାମ୍ପ୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15921_140658_484926"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file that contains the styles in a presentation, including the type and size of bullets and fonts; placeholder sizes and positions; background design and fill; color schemes; and a slide master and optional title master.</descrip></descripGrp><ntig><termGrp><term id="140658">design template</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="484926">ଡିଜାଇନ୍ ଟେମ୍ପଲେଟ୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15926_234817_485283"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An item on the Control Panel that provides user a comprehensive view over all roamed content, as well as ability to check on the synchronization progress of individual items.</descrip></descripGrp><ntig><termGrp><term id="234817">Sync Center</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="485283">Sync କେନ୍ଦ୍ର</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15928_140842_1881153"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An animation enhancement that lets you apply effects to a diagram piece by piece; for example, from top to bottom of a pyramid diagram.</descrip></descripGrp><ntig><termGrp><term id="140842">diagram effect option</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1881153">ଡାଇଗ୍ରାମ୍ ପ୍ରଭାବ ବିକଳ୍ପ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1593_108356_484712"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A component of a scroll bar that indicates the relative position (and optionally the proportion) of the visible information relative to the entire amount of information. The user can drag the scroll box to view areas of information not currently visible.</descrip></descripGrp><ntig><termGrp><term id="108356">scroll box</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="484712">ସ୍କ୍ରୋଲ୍ ବାକ୍ସ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15930_299912_1259170"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The time that a OneNote page was created.</descrip></descripGrp><ntig><termGrp><term id="299912">page time</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1259170">ପୃଷ୍ଠା ସମୟ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15934_323608_485808"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A navigational element, usually appearing at the top of a window, that displays, and allows users to change, their current location.</descrip></descripGrp><ntig><termGrp><term id="323608">breadcrumb bar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="485808">ଠିକଣା ଦଣ୍ଡିକା</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15934_323624_485808"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A navigational element, usually appearing at the top of a window, that displays, and allows users to change, their current location.</descrip></descripGrp><ntig><termGrp><term id="323624">address bar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="485808">ଠିକଣା ଦଣ୍ଡିକା</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</term