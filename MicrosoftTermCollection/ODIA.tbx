.</descrip></descripGrp><ntig><termGrp><term id="1673106">video mail</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1681104">ସ୍ଵର ବାର୍ତ୍ତା</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32403_1673107_1681103"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A short video sent as an email message to someone in the contact list.</descrip></descripGrp><ntig><termGrp><term id="1673107">video message</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1681103">ସ୍ଵର ମେଲ୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32403_1673107_1681104"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A short video sent as an email message to someone in the contact list.</descrip></descripGrp><ntig><termGrp><term id="1673107">video message</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1681104">ସ୍ଵର ବାର୍ତ୍ତା</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32405_1673865_1678188"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A technique that increases sharpness and fidelity by compensating for some effects that camera movement has on images in videos.</descrip></descripGrp><ntig><termGrp><term id="1673865">stabilization</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1678188">ପ୍ରତିଛବି ସ୍ଥିରୀକରଣ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32405_1673865_1678217"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A technique that increases sharpness and fidelity by compensating for some effects that camera movement has on images in videos.</descrip></descripGrp><ntig><termGrp><term id="1673865">stabilization</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1678217">ସ୍ଥିରୀକରଣ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32405_1674922_1678188"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A technique that increases sharpness and fidelity by compensating for some effects that camera movement has on images in videos.</descrip></descripGrp><ntig><termGrp><term id="1674922">image stabilization</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1678188">ପ୍ରତିଛବି ସ୍ଥିରୀକରଣ</term><termNote typ