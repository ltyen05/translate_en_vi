="7874_7042_484012"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A string of characters entered by a user to verify his or her identity to a network or to a local computer, device, or client, or to sign in to an account, app, and so on.</descrip></descripGrp><ntig><termGrp><term id="7042">password</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="484012">ପ୍ରବେଶ କୋଡ୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7875_307417_1959887"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A technology that allows Outlook and mobile devices to automatically discover and connect to the correct Exchange server without requiring the user to know the Exchange server name or other details, even if the mailbox has been moved or a server has failed.</descrip></descripGrp><ntig><termGrp><term id="307417">AutoConnect</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1959887">ସ୍ଵୟଂ ସଂଯୋଗ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7878_236973_1259987"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature of Parental Controls that allows users to block Web sites that they don't want to view.</descrip></descripGrp><ntig><termGrp><term id="236973">Web restrictions</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1259987">ଓ୍ୱେବ୍ ସୀମାବଦ୍ଧତା</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="788_397211_1957790"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An international messaging standard that can be used by a variety of messaging systems. X.400 uses a strict addressing method that reflects a hierarchical environment. The use of X.400 has been largely supplanted by the combination of SMTP and MIME.</descrip></descripGrp><ntig><termGrp><term id="397211">X.400</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1957790">X.400</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7885_48295_484337"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To move an item on the screen (1) by touching the item on a screen and then sliding the finger across the screen or (2) by pressing and holding down the left mouse button while moving the mouse.</descrip></descripGrp><ntig><termGrp><term id="48295">drag</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="484337">ଡ୍ରାଗ୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7904_234775_485279"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Visual impairment that results in great reduction in vision capabilities and that cannot be aided by glasses or contact lenses. It could, however, be aided by special devices.</descrip></descripGrp><ntig><termGrp><term id="234775">low vision</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="485279">ଦୁର୍ବଳ ଦୃଷ୍ଟିଶକ୍ତି</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7916_144827_1881181"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The path that a specified object or text will follow as part of an animation sequence for a slide.</descrip></descripGrp><ntig><termGrp><term id="144827">motion path</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1881181">ମୋସନ୍ ପଥ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7928_237030_485324"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A data repository, in which items such as text, text boxes, pictures, tables, shapes, etc. can be stored and re-used within the same document and across multiple documents.</descrip></descripGrp><ntig><termGrp><term id="237030">content library</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="485324">ବିଷଯ଼ ଲାଇବ୍ରେରୀ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7931_106258_484701"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A device that sends, or routes, information between two networks (for example, between a home network and the Internet).</descrip></descripGrp><ntig><termGrp><term id="106258">router</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="484701">ରାଉଟର୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7933_265341_485448"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Characterized by row or column-specific formatting. Often describes rows or columns of data that use alternating colors or shading to enhance readability.</descrip></descripGrp><ntig><termGrp><term id="265341">banded</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="485448">ବ୍ଯାଣ୍ଡେଡ୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7942_76244_484522"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of rules and data specific to a language and a geographic area. Locales include information on sorting rules, date and time formatting, numeric and monetary conventions, and character classification.</descrip></descripGrp><ntig><termGrp><term id="76244">locale</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="484522">ଆଞ୍ଚଳିକ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7948_52504_1259988"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To output data and database objects to another database, spreadsheet, or file format so another database, application, or program can use the data or database objects.</descrip></descripGrp><ntig><termGrp><term id="52504">export</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1259988">ରପ୍ତାନି କରନ୍ତୁ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7949_1509579_1676015"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A portable computer that allows you to write on or interact with the screen.</descrip></descripGrp><ntig><termGrp><term id="1509579">tablet PC</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1676015">ଟାବଲେଟ୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><t