="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2976004">COUPPCD</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52342_2955554_2976005"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Compatibility/Statistical Excel function that returns covariance, the average of the products of paired deviations.</descrip></descripGrp><ntig><termGrp><term id="2955554">COVAR</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2976005">COVAR</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52343_2955555_2976006"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Statistical Excel function that returns covariance, the average of the products of paired deviations.</descrip></descripGrp><ntig><termGrp><term id="2955555">COVARIANCE.P</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2976006">COVARIANCE.P</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52344_2955556_2976007"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Statistical Excel function that returns the sample covariance, the average of the products deviations for each data point pair in two data sets.</descrip></descripGrp><ntig><termGrp><term id="2955556">COVARIANCE.S</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2976007">COVARIANCE.S</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52345_2955557_2976008"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Compatibility/Statistical Excel function that returns the smallest value for which the cumulative binomial distribution is less than or equal to a criterion value.</descrip></descripGrp><ntig><termGrp><term id="2955557">CRITBINOM</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2976008">CRITBINOM</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52346_2955558_2976009"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Math and trigonometry Excel function that returns the cosecant of an angle.</descrip></descripGrp><ntig><termGrp><term id="2955558">CSC</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2976009">CSC</term><termNote type="geographicalUsage">IND</termNo