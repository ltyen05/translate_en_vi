hat returns an aggregated value from a cube.</descrip></descripGrp><ntig><termGrp><term id="2955566">CUBEVALUE</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2976017">CUBEVALUE</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52355_2955567_2976018"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Financial Excel function that returns the cumulative interest paid between two periods.</descrip></descripGrp><ntig><termGrp><term id="2955567">CUMIPMT</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2976018">CUMIPMT</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52356_2955568_2976019"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Financial Excel function that returns the cumulative principal paid on a loan between two periods.</descrip></descripGrp><ntig><termGrp><term id="2955568">CUMPRINC</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2976019">CUMPRINC</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</