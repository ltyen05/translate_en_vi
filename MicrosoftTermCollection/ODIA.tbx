<termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1931390">Microsoft ପଏଣ୍ଟଗୁଡିକ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28593_1489612_2072590"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process of repeated installation of a product, feature, tool, kit, pack, etc.</descrip></descripGrp><ntig><termGrp><term id="1489612">reinstallation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2072590">ପୁନଃସଂସ୍ଥାପନ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="286_157947_2701005"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">On Windows-based computers, a user account that is a member of the computer’s local Administrators group or a member of a group that is a member of the local Administrators group, such as the Domain Admins group in a Windows domain. This is the first account that is created when you install an operating system on a new workstation, stand-alone server, or member server. By default, this account has the highest level of administrative access to the local computer.</descrip></descripGrp><ntig><termGrp><term id="157947">administrator account</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2701005">ବ୍ୟବସ୍ଥାପକ ଏକାଉଣ୍ଟ୍‌</term><termNote type="geograp