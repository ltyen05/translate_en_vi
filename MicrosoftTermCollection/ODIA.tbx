<descrip type="definition">A form component, such as a template part or ActiveX control, that isn't included with InfoPath by default. Form designers can add or remove custom controls by using the Controls task pane.</descrip></descripGrp><ntig><termGrp><term id="234305">custom control</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="485253">କଷ୍ଟମ ନିୟନ୍ତ୍ରଣ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15834_83662_484579"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An area of an application window that enables the user to navigate quickly to different parts of the program.</descrip></descripGrp><ntig><termGrp><term id="83662">navigation pane</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="484579">ନେଭିଗେସନ୍ ଫଳକ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15842_210445_1426196"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A function that verifies the technology is compatible with the target browser.</descrip></descripGrp><ntig><termGrp><term id="210445">compatibility checker</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1426196">କମ୍ପାଟିବିଲିଟି ଚେକର୍</term><termNote type="geographicalUsage">IND</termNote><termN