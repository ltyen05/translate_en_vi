date, but not in the product.​</descrip></descripGrp><ntig><termGrp><term id="2375534">Windows 10 Anniversary Update</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2378315">Windows 10 ଆନିଭର୍ସରୀ ଅଦ୍ୟତନ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42013_2376461_2381220"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The grouping of similar apps together on the taskbar.</descrip></descripGrp><ntig><termGrp><term id="2376461">glomming</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2381220">ଗ୍ଲୁମିଂ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42014_2376761_2383292"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ribbon tab that gives users a set of options for editing graphics in their PowerPoint slides, Word documents, and Excel documents.</descrip></descripGrp><ntig><termGrp><term id="2376761">Graphics Tools</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2383292">ଗ୍ରାଫିକ୍ସ୍ ଉପକରଣସମୂହ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">