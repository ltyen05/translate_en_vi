 rules.</descrip></descripGrp><ntig><termGrp><term id="141659">Extensible Stylesheet Language</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="484939">XSL</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="317_141660_1259795"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An XML vocabulary that is used to transform XML data to another form, such as HTML, by means of a style sheet that defines presentation rules.</descrip></descripGrp><ntig><termGrp><term id="141660">XSL</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1259795">ପ୍ରସାରଣକ୍ଷମ ଶୈଳୀପତ୍ର ଭାଷା</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="317_141660_484939"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An XML vocabulary that is used to transform XML data to another form, such as HTML, by means of a style sheet that defines presentation rules.</descrip></descripGrp><ntig><termGrp><term id="141660">XSL</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="484939">XSL</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular