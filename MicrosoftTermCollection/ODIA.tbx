m><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2412733">ସମ୍ପର୍କ ସୂଚନା</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8577_502819_2412733"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Information, such as name, phone number, email address, or address, that is used to contact someone.</descrip></descripGrp><ntig><termGrp><term id="502819">contact information</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2412733">ସମ୍ପର୍କ ସୂଚନା</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8587_185573_1650621"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A button in the Options dialog box, on the Phones tab, that users click to enter their work phone number. The Work Phone button is disabled if the work phone number has been supplied through the corporate directory.</descrip></descripGrp><ntig><termGrp><term id="185573">Work Phone</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1650621">କାର୍ଯ୍ୟ ଫୋନ୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8595_269326_485467"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The proprietary protocol to provide remote display and input capabilities over network connections for Windows-based applications between two computers.</descrip></descripGrp><ntig><termGrp><term id="269326">Remote Desktop Protocol</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="485467">ଦୂରବର୍ତ୍ତି ଡେସ୍କଟପ୍ ପ୍ରୋଟୋକଲ୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8595_269326_485468"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The proprietary protocol to provide remote display and input capabilities over network connections for Windows-based applications between two computers.</descrip></descripGrp><ntig><termGrp><term id="269326">Remote Desktop Protocol</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="485468">RDP</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8595_269327_485467"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The proprietary protocol to provide remote display and input capabilities over network connections for Windows-based applications between two computers.</descrip></descripGrp><ntig><termGrp><term id="269327">RDP</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="485467">ଦୂରବର୍ତ୍ତି ଡେସ୍କଟପ୍ ପ୍ରୋଟୋକଲ୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8595_269327_485468"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The proprietary protocol to provide remote display and input capabilities over network connections for Windows-based applications between two computers.</descrip></descripGrp><ntig><termGrp><term id="269327">RDP</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="485468">RDP</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8600_37568_484235"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Of, pertaining to, or characteristic of an action or operation that takes place based on whether or not a certain condition is true.</descrip></descripGrp><ntig><termGrp><term id="37568">conditional</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="484235">ସର୍ତ୍ତମୂଳକ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8609_2856023_2572594"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Any of a family of processes that software developers use to minimize risk by developing applications incrementally, over a series of short iterations. In this model, real-time communications, such as in person conversations and telephone calls, are preferred over written documentation; the primary measure of progress is working software, instead of hours spent, tasks completed, documents reviewed, or phases signed-off; stakeholders are expected to collaborate, instead of negotiating; and planning happens continuously in order to respond to change.</descrip></descripGrp><ntig><termGrp><term id="2856023">Agile methodology</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2572594">ଆଜାଇଲ୍ ପଦ୍ଧତି</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8609_460694_2572594"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Any of a family of processes that software developers use to minimize risk by developing applications incrementally, over a series of short iterations. In this model, real-time communications, such as in person conversations and telephone calls, are preferred over written documentation; the primary measure of progress is working software, instead of hours spent, tasks completed, documents reviewed, or phases signed-off; stakeholders are expected to collaborate, instead of negotiating; and planning happens continuously in order to respond to change.</descrip></descripGrp><ntig><termGrp><term id="460694">Agile method</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2572594">ଆଜାଇଲ୍ ପଦ୍ଧତି</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8612_173657_1957430"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Application software that gathers data from the user, prepares it for the server, and issues a request to the server. The client presents data received from the server to the user through its own user interface.</descrip></descripGrp><ntig><termGrp><term id="173657">client application</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1957430">କ୍ଲାଏଣ୍ଟ୍ ଆପ୍ଲିକେସନ୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8614_358362_1957420"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An item in the Exchange store that represents an appointment, a meeting, a meeting request, or an event. It can identify the place, resources, recurrence, and attendees involved at a discrete time.</descrip></descripGrp><ntig><termGrp><term id="358362">calendar item</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1957420">କ୍ୟାଲେଣ୍ଡର୍ ଆଇଟମ୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8641_184378_1259995"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The permission setting that permits a person or domain to add the user to contact lists, see the user's status, or send instant messages to the user.</descrip></descripGrp><ntig><termGrp><term id="184378">Allow</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1259995">ମଞ୍ଜୁର</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8643_44563_1259996"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To put into use.</descrip></descripGrp><ntig><termGrp><term id="44563">deploy</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1259996">ଉପଯୋଗ କରନ୍ତୁ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8644_185806_1519863"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A UI element that ends a user session or exits a service.</descrip></descripGrp><ntig><termGrp><term id="185806">Sign Out</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1519863">ସାଇନ୍ ଆଉଟ୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8657_2140019_1259997"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The person in charge of managing a computer. The administrator is responsible for installing software, assigning passwords, and managing files.</descrip></descripGrp><ntig><termGrp><term id="2140019">admin</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1259997">ବ୍ୟବସ୍ଥାପକ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8657_2140019_1259998"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The person in charge of managing a computer. The administrator is responsible for installing software, assigning passwords, and managing files.</descrip></descripGrp><ntig><termGrp><term id="2140019">admin</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1259998">କମ୍ପ୍ୟୁଟର ବ୍ୟବସ୍ଥାପକ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8657_318135_1259997"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The person in charge of managing a computer. The administrator is responsible for installing software, assigning passwords, and managing files.</descrip></descripGrp><ntig><termGrp><term id="318135">computer administrator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1259997">ବ୍ୟବସ୍ଥାପକ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8657_318135_1259998"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The person in charge of managing a computer. The administrator is responsible for installing software, assigning passwords, and managing files.</descrip></descripGrp><ntig><termGrp><term id="318135">computer administrator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1259998">କମ୍ପ୍ୟୁଟର ବ୍ୟବସ୍ଥାପକ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8657_9827_1259997"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The person in charge of managing a computer. The administrator is responsible for installing software, assigning passwords, and managing files.</descrip></descripGrp><ntig><termGrp><term id="9827">administrator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1259997">ବ୍ୟବସ୍ଥାପକ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8657_9827_1259998"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The person in charge of managing a computer. The administrator is responsible for installing software, assigning passwords, and managing files.</descrip></descripGrp><ntig><termGrp><term id="9827">administrator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1259998">କମ୍ପ୍ୟୁଟର ବ୍ୟବସ୍ଥାପକ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="866_312761_485632"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A System Audio Effects (SYSFX) component used to provide a more immersive audio experience in the Windows Media Player and thus an improved listening experience by utilizing the available speakers that a user has attached to his/her PC by sending audio to all of the speakers, regardless of the number of channels the content contains. This will provide a better sounding experience for stereo and quadraphonic content being rendered on multi-channel playback systems.</descrip></descripGrp><ntig><termGrp><term id="312761">speaker fill</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="485632">ବକ୍ତା ପୂରଣ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8664_55395_484388"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The stylistic attributes of a font — such as bold, italic, and underline.</descrip></descripGrp><ntig><termGrp><term id="55395">font style</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="484388">ଫଣ୍ଟ ଶୈଳୀ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8684_397181_1957591"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A managed folder that is created by an Exchange administrator and placed in a user’s mailbox for messaging records management purposes where retention and journaling of messages is controlled by managed content settings that are applied to the folder.</descrip></descripGrp><ntig><termGrp><term id="397181">managed custom folder</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1957591">ପରିଚାଳିତ କଷ୍ଟମ୍ ଫୋଲ୍ଡର୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8688_228749_1259094"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A list of users, accounts, Web sites, etc. that are permitted to perform certain actions on a network.</descrip></descripGrp><ntig><termGrp><term id="228749">Allow list</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1259094">ଅନୁମତି ତାଲିକା</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8688_276556_1259094"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A list of users, accounts, Web sites, etc. that are permitted to perform certain actions on a network.</descrip></descripGrp><ntig><termGrp><term id="276556">allow list</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1259094">ଅନୁମତି ତାଲିକା</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="869_557910_1881341"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An optional Microsoft Exchange 2000 Server component that is installed on a designated server in an administrative group. It provides centralized administration and archival of private keys, and maintains every user s private encryption key in an encrypted database. The keys are used for encrypting email messages and signing messages with digital signatures.</descrip></descripGrp><ntig><termGrp><term id="557910">Key Management Service</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1881341">କୀ ପରିଚାଳନା ସେବା</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8696_183901_1881226"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A slide template that defines default formatting or the position of placeholders for one or more slides in a presentation.</descrip></descripGrp><ntig><termGrp><term id="183901">content master</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1881226">ବିଷୟବସ୍ତୁ ମାଷ୍ଟର୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8706_186134_485124"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The set of rules on a computer and a portable device that allow digital media files and other information to be synchronized.</descrip></descripGrp><ntig><termGrp><term id="186134">partnership</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="485124">ଭାଗୀଦାରୀ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8714_186176_1951423"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A context menu that enables the user to preview the contents of a file with the Office Preview Handler (OPH) in Outlook (either documents attached to email or SharePoint documents in Outlook).</descrip></descripGrp><ntig><termGrp><term id="186176">PowerPoint Previewer</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1951423">PowerPoint ପୂର୍ବାବଲୋକନକାରୀ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8718_73755_484504"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The primary access protocol for Active Directory. LDAP is an industry-standard protocol, established by the Internet Engineering Task Force (IETF), that allows users to query and update information in a directory service. Active Directory supports both LDAP version 2 and LDAP version 3.</descrip></descripGrp><ntig><termGrp><term id="73755">LDAP</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="484504">LDAP</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8718_73755_484505"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The primary access protocol for Active Directory. LDAP is an industry-standard protocol, established by the Internet Engineering Task Force (IETF), that allows users to query and update information in a directory service. Active Directory supports both LDAP version 2 and LDAP version 3.</descrip></descripGrp><ntig><termGrp><term id="73755">LDAP</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="484505">ଲଘୁ ଡାଇରେକ୍ଟୋରୀ ପ୍ରବେଶାଧିକାର ପ୍ରୋଟୋକଲ୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8718_73756_484504"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The primary access protocol for Active Directory. LDAP is an industry-standard protocol, established by the Internet Engineering Task Force (IETF), that allows users to query and update information in a directory service. Active Directory supports both LDAP version 2 and LDAP version 3.</descrip></descripGrp><ntig><termGrp><term id="73756">Lightweight Directory Access Protocol</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="484504">LDAP</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8718_73756_484505"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The primary access protocol for Active Directory. LDAP is an industry-standard protocol, established by the Internet Engineering Task Force (IETF), that allows users to query and update information in a directory service. Active Directory supports both LDAP version 2 and LDAP version 3.</descrip></descripGrp><ntig><termGrp><term id="73756">Lightweight Directory Access Protocol</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="484505">ଲଘୁ ଡାଇରେକ୍ଟୋରୀ ପ୍ରବେଶାଧିକାର ପ୍ରୋଟୋକଲ୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8727_306408_1260000"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A filter effect in Windows Movie Maker.</descrip></descripGrp><ntig><termGrp><term id="306408">Threshold</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1260000">ଥ୍ରେସହୋଲ୍ଡ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8732_137331_1881127"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Adds preset visual effects to text on slides. Ranging from subtle to exciting, each scheme usually includes an effect for the slide title and an effect that is applied to bullets or paragraphs on a slide.</descrip></descripGrp><ntig><termGrp><term id="137331">animation scheme</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1881127">ଆନେମେସନ୍ ସ୍କିମ୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8740_117601_1545931"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A brief content of a larger document.</descrip></descripGrp><ntig><termGrp><term id="117601">summary</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1545931">ସାରାଂଶ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8744_35474_484221"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A standard system control that initiates a command.</descrip></descripGrp><ntig><termGrp><term id="35474">command button</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="484221">ନିର୍ଦ୍ଦେଶ ବଟନ୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8744_35474_484222"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A standard system control that initiates a command.</descrip></descripGrp><ntig><termGrp><term id="35474">command button</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="484222">ଚିପା ବଟନ୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8744_35475_484221"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A standard system control that initiates a command.</descrip></descripGrp><ntig><termGrp><term id="35475">push button</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="484221">ନିର୍ଦ୍ଦେଶ ବଟନ୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8744_35475_484222"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A standard system control that initiates a command.</descrip></descripGrp><ntig><termGrp><term id="35475">push button</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="484222">ଚିପା ବଟନ୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8747_351591_1260001"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in Windows that allows users to access and manage printers, multi-function printers, digital cameras and scanners.</descrip></descripGrp><ntig><termGrp><term id="351591">Printing and Imaging Devices</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1260001">ମୁଦ୍ରଣ ଏବଂ ପ୍ରତିଛବି ଡ଼ିଭାଇସେସ୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8751_418607_1519816"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To prevent another user from initiating a conversation and from viewing your presence or other information, such as your personal information.</descrip></descripGrp><ntig><termGrp><term id="418607">block</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1519816">ଅବରୋଧ କରିବା</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8757_558600_1957706"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The list of answers to a search request that match the search criteria specified by the user.</descrip></descripGrp><ntig><termGrp><term id="558600">search results</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1957706">ସନ୍ଧାନ ଫଳାଫଳ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8769_9149_1957386"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The part of an agreement that defines the business process that is used, your role, your partner's role, and the policies or parameters that are used in that relationship along with documentation, such as a list of business and legal terms.</descrip></descripGrp><ntig><termGrp><term id="9149">addendum</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1957386">ପରିଶିଷ୍ଠ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8777_24948_1260002"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A list in which each item or block of text is preceded by a bullet.</descrip></descripGrp><ntig><termGrp><term id="24948">bulleted list</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1260002">ବୁଲେଟେଡ଼୍ ତାଲିକା</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8780_100131_484687"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The temporary storage place on Windows where deleted files are transferred and remain until manually emptied and files are permanently deleted, which allows users to retrieve files until that point.</descrip></descripGrp><ntig><termGrp><term id="100131">Recycle Bin</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="484687">ରିସାଇକ୍ଲି ବିନ୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8790_232417_1260003"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A list of domain names and email addresses that you want to receive messages from. E-mail addresses in Contacts and in the Global Address Book are included in this list by default. People you sent messages to will be added to the list.</descrip></descripGrp><ntig><termGrp><term id="232417">Safe Senders List</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1260003">ନିରାପଦ ପ୍ରେରକ ତାଲିକା</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGende