raphicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38416_2226110_2235421"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The service that is installed as part of the MultiPoint role on server and ensures that some MultiPoint configuration settings remain set to keep Windows MultiPoint Server running smoothly.</descrip></descripGrp><ntig><termGrp><term id="2226110">Windows MultiPoint Server Repair Service</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2235421">Windows MultiPoint Server ମରାମତି ସେବା</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38419_2227157_2234100"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A keypad that is available in Programmer mode, which allows the user to look at numbers represented as various combinations of 1s and 0s, and to toggle between 1 and 0 for each binary bit to form a new number.</descrip></descripGrp><ntig><termGrp><term id="2227157">bit toggling keypad</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2234100">ବିଟ୍‍ ଟୋଗଲିଂ କୀପ୍ୟାଡ୍‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38420_2227158_2234101"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of thematically related apps, games, music tracks, videos, or other items available for purchase or download in the Store. A thematic group of editorially chosen apps and games for merchandising or marketing purposes.</descrip></descripGrp><ntig><termGrp><term id="2227158">Collection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2234101">ସଂଗ୍ରହ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38421_2227159_2234102"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows the user to select a color and increase or decrease the vibrancy of that color in an image.</descrip></descripGrp><ntig><termGrp><term id="2227159">color boost</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2234102">ରଙ୍ଗ ବୃଦ୍ଧି</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38422_2227160_2791408"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The menu invoked with a shortcut key (Windows + G) when gaming that allows users to take a screenshot, take a 30 second clip of a game, and adjust volume controls.</descrip></descripGrp><ntig><termGrp><term id="2227160">Game Bar</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2791408">Game Bar</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38423_2227161_2230216"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The platform on which the operating system runs on form factors other than PCs, tablets, and phones.</descrip></descripGrp><ntig><termGrp><term id="2227161">IoT</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2230216">IoT</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38423_2227161_2269557"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The platform on which the operating system runs on form factors other than PCs, tablets, and phones.</descrip></descripGrp><ntig><termGrp><term id="2227161">IoT</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2269557">ଦ୍ରବ୍ୟଗୁଡିକର ଇଣ୍ଟର୍ନେଟ୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38423_2268355_2230216"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The platform on which the operating system runs on form factors other than PCs, tablets, and phones.</descrip></descripGrp><ntig><termGrp><term id="2268355">Internet of Things</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2230216">IoT</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38423_2268355_2269557"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The platform on which the operating system runs on form factors other than PCs, tablets, and phones.</descrip></descripGrp><ntig><termGrp><term id="2268355">Internet of Things</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2269557">ଦ୍ରବ୍ୟଗୁଡିକର ଇଣ୍ଟର୍ନେଟ୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38424_2227162_2234111"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A broad set of all the user's local and cloud-based content, including documents, apps, settings, photos, videos, music, and email.  Cortana or Bing can search this content and return it in search results.</descrip></descripGrp><ntig><termGrp><term id="2227162">my stuff</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2234111">ମୋ ବିଷୟବସ୍ତୁ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</