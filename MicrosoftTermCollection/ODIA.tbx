er">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45139_2843752_2845733"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that provides a way to pay for calls and helps ensure that the users are able to make audio conferences or international phone calls.</descrip></descripGrp><ntig><termGrp><term id="2843752">prepaid wallet</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2845733">ପ୍ରିପେଡ୍ ୱାଲେଟ୍‌</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45141_2547964_2573789"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The tool that allows users to store web content and share it with friends and family on Skype.</descrip></descripGrp><ntig><termGrp><term id="2547964">Skype Backpack</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2573789">Skype ବ୍ୟାକପ୍ୟାକ୍‌</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45144_2549937_2556009"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The filter that users can apply to a photo or video clip to add an adventurous atmosphere and create a theme along with a related text style and music.</descrip></descripGrp><ntig><termGrp><term id="2549937">Adventure</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2556009">ଆଡଭେଞ୍ଚର୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45145_2549940_2556015"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The filter that users can apply to a photo or video clip to give it a classic look. This is also the name of a theme that applies this filter along with a related text style and music. It evokes a simple, classic, and elegant look and feel.</descrip></descripGrp><ntig><termGrp><term id="2549940">Classic</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2556015">କ୍ଲାସିକ୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45146_2549941_2556010"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The filter that users can apply to a photo or video clip to give it a slightly whitened, lightened, or bleached effect.</descrip></descripGrp><ntig><termGrp><term id="2549941">Blanch</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2556010">ବ୍ଲାଞ୍ଚ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45147_2549942_2556030"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The black and white filter that users can apply to a photo or video clip.</descrip></descripGrp><ntig><termGrp><term id="2549942">Portrait</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2556030">ପୋଟ୍ରେଟ୍‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45148_2549943_2556024"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The black and white filter that users can apply to a photo or video clip. This filter has deeper blacks and whiter whites than other filters.</descrip></descripGrp><ntig><termGrp><term id="2549943">Inky</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2556024">ଇଙ୍କି</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45149_2549945_2556033"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The filter that users can apply to a photo or video clip, which gives it an effect of muted late evening light.</descrip></descripGrp><ntig><termGrp><term id="2549945">Twilight</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2556033">ଟ୍ୱିଲାଇଟ୍‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45150_2549970_2556020"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The filter that users can apply to a photo or video clip, which intensifies the red and orange tones in the image.</descrip></descripGrp><ntig><termGrp><term id="2549970">Energy</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2556020">ଏନର୍ଜି</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45151_2549985_2556023"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The filter that users can apply to a photo or video clip, which intensifies the blue tones in the image.</descrip></descripGrp><ntig><termGrp><term id="2549985">Iceberg</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2556023">ଆଇସ୍‌ବର୍ଗ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45152_2550010_2556026"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The filter that users can apply to a photo or video clip, which intensifies the green tones in the image.</descrip></descripGrp><ntig><termGrp><term id="2550010">Kelly</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2556026">କେଲି</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45153_2550035_2556012"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The filter that users can apply to a photo or video clip, which intensifies the colors.</descrip></descripGrp><ntig><termGrp><term id="2550035">Brassy</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2556012">ବ୍ରାସି</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45154_2550036_2556017"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The filter that users can apply to a photo or video clip, which gives it a slightly rough and worn out quality.</descrip></descripGrp><ntig><termGrp><term id="2550036">Denim</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2556017">ଡେନିମ୍‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45155_2550037_2556016"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The filter that users can apply to a photo or video clip, which sharpens the image and keeps colors intact.</descrip></descripGrp><ntig><termGrp><term id="2550037">Clean</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2556016">କ୍ଲିନ୍‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45156_2550038_2556013"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The filter that users can apply to a photo or video clip, which gives it a muted, blue-green effect. This is also the name of a theme that applies this filter along with a related text style and music. It evokes a subdued, cool, relaxed look and feel.</descrip></descripGrp><ntig><termGrp><term id="2550038">Chilled</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2556013">ଚିଲଡ୍‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45157_2550041_2556019"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The filter that users can apply to a photo or video clip, which gives it a feeling of energy, and the purple light you might see before an electrical storm. This is also the name of a theme that applies this filter along with a related text style and music.</descrip></descripGrp><ntig><termGrp><term id="2550041">Electric</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2556019">ଇଲେକ୍ଟ୍ରିକ୍‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45158_2550043_2556032"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The filter that users can apply to a photo or video clip, which gives it a golden brownish hue like sand.</descrip></descripGrp><ntig><termGrp><term id="2550043">Sandy</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2556032">ସାଣ୍ଡି</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45159_2550044_2556025"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The filter that users can apply to a photo or video clip, which gives it a cheerful, playful, sunny feeling. This is also the name of a theme that applies this filter along with a related text style and music.</descrip></descripGrp><ntig><termGrp><term id="2550044">Joy</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2556025">ଆନନ୍ଦ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45160_2550045_2556014"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The filter that users can apply to a photo or video clip, which gives it a yellow tone.</descrip></descripGrp><ntig><termGrp><term id="2550045">Citrus</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2556014">ସିଟରସ୍‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45161_2550046_2556028"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The filter that users can apply to a photo or video clip, which has a coarse texture and hard edges like metal.</descrip></descripGrp><ntig><termGrp><term id="2550046">Metallic</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2556028">ମେଟାଲିକ୍‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45162_2550047_2556008"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The filter that users can apply to a photo or video clip, which has the faded quality of photos taken in the mid-1960s.</descrip></descripGrp><ntig><termGrp><term id="2550047">1966</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2556008">1966</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45163_2550050_2556027"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The filter that users can apply to a photo or video clip, which has a warm, sentimental feeling. This is also the name of a theme that applies this filter along with a related text style and music.</descrip></descripGrp><ntig><termGrp><term id="2550050">Loved</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2556027">ପ୍ରିୟଜନ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45187_2550377_2556021"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The text overlay style in Story Remix. This style is simple, classic, and fresh, with white text that animates in with a rising motion.</descrip></descripGrp><ntig><termGrp><term id="2550377">Fresh</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2556021">ଫ୍ରେସ୍‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45188_2550381_2556029"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A text overlay style in Story Remix. This style resembles the typography of a printed book of poetry or a novel.</descrip></descripGrp><ntig><termGrp><term id="2550381">Poetry</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2556029">ପୋଏଟ୍ରି</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45189_2550383_2556011"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The text overlay style in Story Remix. This style is big, bold and uses very large type.</descrip></descripGrp><ntig><termGrp><term id="2550383">Boom</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2556011">ବୁମ୍‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45190_2550385_2556022"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The text overlay style in Story Remix. This style is big, bold, and uses a colored block with transparent lettering that resembles a stencil or poster graphic.</descrip></descripGrp><ntig><termGrp><term id="2550385">Graphic</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2556022">ଗ୍ରାଫିକ୍‍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="gramma