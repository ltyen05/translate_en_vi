84797"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A horizontal bar at the top of a window that displays the name of the window.</descrip></descripGrp><ntig><termGrp><term id="671383">caption</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="484797">ଟାଇଟେଲ୍ ଦଣ୍ଡିକା</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2137_679024_484797"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A horizontal bar at the top of a window that displays the name of the window.</descrip></descripGrp><ntig><termGrp><term id="679024">caption bar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="484797">ଟାଇଟେଲ୍ ଦଣ୍ଡିକା</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2138_165180_485063"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A single character that represents a sequence of characters, usually a combination of a base character and one or more diacritics.</descrip></descripGrp><ntig><termGrp><term id="165180">precomposed character</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="485063">ପୂର୍ବ ରଚିତ ବର୍ଣ୍ଣ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21381_1102876_1937108"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that displays a definition or translation of a word or piece of text in a ScreenTip when the pointer is moved over the selection.</descrip></descripGrp><ntig><termGrp><term id="1102876">Mini Translator</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1937108">କ୍ଷୁଦ୍ର ଅନୁବାଦକ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21402_775135_2372687"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A radio network that provides coverage for cellular telephone communications.</descrip></descripGrp><ntig><termGrp><term id="775135">cellular network</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2372687">ସେଲ୍ୟୁଲାର୍ ନେଟ୍‌ୱାର୍କ୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21402_775136_2372687"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A radio network that provides coverage for cellular telephone communications.</descrip></descripGrp><ntig><termGrp><term id="775136">cellular</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig