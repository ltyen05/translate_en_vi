 seen</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="3015099">ଶେଷ ସ୍କ୍ରିନ୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4713_29105_484168"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A device that reads the information stored on a compact disc. A compact disc player contains the optical equipment necessary for reading a disc's contents and the electronic circuitry for interpreting the data as it is read.</descrip></descripGrp><ntig><termGrp><term id="29105">CD player</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="484168">ସିଡ଼ି ପ୍ଲେୟର</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4713_29105_484169"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A device that reads the information stored on a compact disc. A compact disc player contains the optical equipment necessary for reading a disc's contents and the electronic circuitry for interpreting the data as it is read.</descrip></descripGrp><ntig><termGrp><term id="29105">CD player</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="484169">କମ୍ପାକ୍ଟ ଡିସ୍କ ପ୍ଲେୟର</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech