34"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The user accounts that are connected as a family. This feature allows adults to manage kids’ experiences within the kids’ user account.</descrip></descripGrp><ntig><termGrp><term id="2247833">Microsoft family</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2252134">Microsoft ପରିବାର</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38639_2247838_2252136"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The section in Windows Store containing the user ratings and reviews for a given app.</descrip></descripGrp><ntig><termGrp><term id="2247838">Ratings and reviews</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2252136">ମୂଲ୍ୟାଙ୍କନ ଏବଂ ସମୀକ୍ଷା</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38657_2249394_2258620"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A view that displays web articles in a distraction-free layout that is optimized for their screen size.</descrip></descripGrp><ntig><termGrp><term id="2249394">reading view</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2258620">ପଠନ ଦର୍ଶନ</term><termNote type="geographicalUsage">IND</t