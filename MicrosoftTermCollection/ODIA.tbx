ouching the device's screen.</descrip></descripGrp><ntig><termGrp><term id="2556878">scroll handle</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2557817">ସ୍କ୍ରୋଲ୍ ହ୍ୟାଣ୍ଡେଲ୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45282_2556931_2557815"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ink effect in the colors of a rainbow.</descrip></descripGrp><ntig><termGrp><term id="2556931">rainbow</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2557815">ଇନ୍ଦ୍ରଧନୁ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45283_2556932_2557812"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An effect applied to digital ink.</descrip></descripGrp><ntig><termGrp><term id="2556932">ink effect</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2557812">ସ୍ୟାହୀ ପ୍ରଭାବ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45284_2556933_2557807"><langSet xml:lang="en-US"><descripGrp><descrip type="de