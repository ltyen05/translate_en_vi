y><termEntry id="197_93813_484659"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An orientation where the long dimension of a rectangular area (for example, screen, photo, or paper) is vertical.​</descrip></descripGrp><ntig><termGrp><term id="93813">portrait orientation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="484659">ପ୍ରତିକୃତି ଓରିଏଣ୍ଟେସନ୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="197_93813_484660"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An orientation where the long dimension of a rectangular area (for example, screen, photo, or paper) is vertical.​</descrip></descripGrp><ntig><termGrp><term id="93813">portrait orientation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="484660">ପ୍ରତିକୃତି</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="197_93814_484659"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An orientation where the long dimension of a rectangular area (for example, screen, photo, or paper) is vertical.​</descrip></descripGrp><ntig><termGrp><term id="93814">portrait</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="484659">ପ୍ରତିକୃତି ଓରିଏଣ୍ଟେସନ୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="197_93814_484660"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An orientation where the long dimension of a rectangular area (for example, screen, photo, or paper) is vertical.​</descrip></descripGrp><ntig><termGrp><term id="93814">portrait</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="484660">ପ୍ରତିକୃତି</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19722_673385_3071486"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The amount of light emitted onto a film or image sensor.</descrip></descripGrp><ntig><termGrp><term id="673385">exposure</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="3071486">ଏକ୍ସପୋଜର୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19723_673395_1259227"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A control on most digital cameras that lets you control the under -or over- exposure of the image.</descrip></descripGrp><ntig><termGrp><term id="673395">exposure bias</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp><