m id="2108">toolbar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="483959">ଉପକରଣ ଦଣ୍ଡିକା</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10841_180035_485098"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A standard Windows control that is similar to a standard text box, except that it also supports individual character and paragraph properties.</descrip></descripGrp><ntig><termGrp><term id="180035">rich-text box</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="485098">ରିଚ୍-ପାଠ ବାକ୍ସ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10853_14662_1881061"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A formula that performs multiple calculations on one or more sets of values, and then returns either a single result or multiple results.</descrip></descripGrp><ntig><termGrp><term id="14662">array formula</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1881061">ଆରେ ସୂତ୍ର</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10864_141438_1881156"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A chart that is placed on a worksheet rather than on a separate chart sheet. Embedded charts are beneficial when you want to view or print a chart or a PivotChart report with its source data or other information in a worksheet.</descrip></descripGrp><ntig><termGrp><term id="141438">embedded chart</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1881156">ଏମ୍ଵାଡ୍ ହୋଇଥିବା ଚାର୍ଟ୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10871_30752_484186"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A graphic or diagram that displays data or the relationships between sets of data in pictorial rather than numeric form.</descrip></descripGrp><ntig><termGrp><term id="30752">chart</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="484186">ଚାର୍ଟ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10894_225713_1260040"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A list that can be opened to reveal all choices for a given field.</descrip></descripGrp><ntig><termGrp><term id="225713">drop-down list</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term i