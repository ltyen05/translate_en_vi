</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3273_4401_1957789"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An XML format for describing Web services. WSDL allows Web service providers and users of such services to work together easily by enabling the separation of the description of the abstract functionality offered by a service from concrete details of a service description such as "how" and "where" that functionality is offered.</descrip></descripGrp><ntig><termGrp><term id="4401">WSDL</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1957789">WSDL</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32734_1707158_1951442"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Windows service application that reads data files uploaded by the Office Telemetry Agent and inserts the data into SQL Server.</descrip></descripGrp><ntig><termGrp><term id="1707158">Office Telemetry Processor</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1951442">Office ଟେଲେମେଟ୍ରେ ପ୍ରୋସେସର୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32741_1698172