h">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1259033">ଟ୍ରେଣ୍ଡଲାଇନ୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45820_2579516_2580553"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To bring a system or piece of software into compliance with a policy or configuration intent.</descrip></descripGrp><ntig><termGrp><term id="2579516">remediate</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2580553">ପ୍ରତିକାର କରିବା</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45829_2580598_2583361"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A review of material that has reached the end of its retention period in order to decide whether it should be disposed of.</descrip></descripGrp><ntig><termGrp><term id="2580598">disposition review</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2583361">ସଜ୍ଜିକରଣ ସମୀକ୍ଷା</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45831_2580607_2583368"><langSet xml:lang="en-US"><descripGrp><descrip t