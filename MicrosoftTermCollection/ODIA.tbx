pe="definition">A Structure and Style choice for a sway that is initially made by the user, which Sway will remember and intelligently implement based upon content, prior behavior, and abstract expressions of intent.</descrip></descripGrp><ntig><termGrp><term id="2277489">design lever</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2280805">ଡିଜାଇନ୍ ଲିଭର୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3923_215040_2701038"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A common interface between transport-level applications, such as Microsoft Remote Procedure Call (RPC), and security support providers (SSPs), such as Windows Distributed Security. SSPI allows a transport application to call one of the SSPs to obtain an authenticated connection. These calls do not require extensive knowledge of the security protocol's details.</descrip></descripGrp><ntig><termGrp><term id="215040">Security Support Provider Interface</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2701038">SSPI</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3923_215041_2701038"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A common interface between transport-level applications, such as Microsoft Remote Procedure Call (RPC), and security support providers (SSPs), such as Windows Distributed Security. SSPI allows a transport application to call one of the SSPs to obtain an authenticated connection. These calls do not require extensive knowledge of the security protocol's details.</descrip></descripGrp><ntig><termGrp><term id="215041">SSPI</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2701038">SSPI</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39255_2277611_2279557"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The button on the Sway homepage that takes users to the My Sways webpage.</descrip></descripGrp><ntig><termGrp><term id="2277611">My Sways</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2279557">ମୋର Sways</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39256_2277617_2285031"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A pane that holds cross-suite experiences including global notifications, Skype for business conversations, a notification pane, the ​What's New container, and that stays open as long as the user keeps it open even across page navigation.</descrip></descripGrp><ntig><termGrp><term id="2277617">flex pane</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang=