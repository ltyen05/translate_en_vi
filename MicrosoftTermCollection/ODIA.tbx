erm id="1520337">ଟର୍ନ୍ ଅନ୍ କରିବା</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12958_1060966_1606460"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To activate something making it available for use.</descrip></descripGrp><ntig><termGrp><term id="1060966">turn on</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1606460">ସାମର୍ଥ୍ୟ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12958_50552_1520337"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To activate something making it available for use.</descrip></descripGrp><ntig><termGrp><term id="50552">enable</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1520337">ଟର୍ନ୍ ଅନ୍ କରିବା</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12958_50552_1606460"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To activate something making it available for use.</descrip></descripGrp><ntig><termGrp><term id="50552">enable</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:l