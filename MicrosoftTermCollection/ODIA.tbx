icalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2711_63131_484430"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The complementary tasks of gathering and distributing data. Input is data that is acquired from a device or entered by the user through a device. Output is data that is sent to a device.</descrip></descripGrp><ntig><termGrp><term id="63131">input/output</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="484430">I/O</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2711_63131_484431"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The complementary tasks of gathering and distributing data. Input is data that is acquired from a device or entered by the user through a device. Output is data that is sent to a device.</descrip></descripGrp><ntig><termGrp><term id="63131">input/output</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="484431">ଇନପୁଟ୍ / ଆଉଟପୁଟ୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27118_1365371_1881608"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A single document that is converted as part of a conversion.</descrip></descripGrp><ntig><termGrp><term id="1365371">conversion item</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1881608">ପରିବର୍ତ୍ତନ ଆଇଟମ୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27130_1365513_2344712"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A software component that intermediates requests from client software components and responses from service or server software components that respond to those requests.</descrip></descripGrp><ntig><termGrp><term id="1365513">proxy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2344712">ପ୍ରକ୍ସି</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27131_1365515_1519767"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An online action, such as updating a status message, publishing photos, or updating profile info.</descrip></descripGrp><ntig><termGrp><term id="1365515">activity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1519767">କାର୍ଯ୍ୟକଳାପ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27134_1367496_1881609"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A reference to a table or subset of a table by the table name and column specifier instead of cell coordinates.</descrip></descripGrp><ntig><termGrp><term id="1367496">structured reference</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1881609">ପଦ୍ଧତିଗତ ଅନୁସରଣ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27137_1367505_2344702"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A commercial message that consists of a visual component (text, rich media, etc.) and associated metadata (URLs, placement information, etc.).</descrip></descripGrp><ntig><termGrp><term id="1367505">ad</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2344702">ବିଜ୍ଞାପନ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2716_145576_3042780"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The quality that defines how much light passes through an object's pixels. If an object is 100 percent opaque, no light passes through it.</descrip></descripGrp><ntig><termGrp><term id="145576">opacity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="3042780">ଅପାରଗତା</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2720_102645_1259848"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The creation of an image containing geometric models, using color and shading to give the image a realistic look. Usually part of a geometric modeling package such as a CAD program, rendering uses mathematics to describe the location of a light source in relation to the object and to calculate the way in which the light would create highlights, shading, and variations in color. The degree of realism can range from opaque, shaded polygons to images approximating photographs in their complexity.</descrip></descripGrp><ntig><termGrp><term id="102645">rendering</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1259848">ରୂପାୟନ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2727_261574_485372"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that provides detailed Web site statistics and reports related to the subscriber's Web site.</descrip></descripGrp><ntig><termGrp><term id="261574">Site Reports</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="485372">ସାଇଟ୍ ରିପୋର୍ଟସ୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27270_1368065_1881610"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application service for storing and handling an organization's documents.</descrip></descripGrp><ntig><termGrp><term id="1368065">document management system</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1881610">ଡକ୍ୟୁମେଣ୍ଟ ପରିଚାଳନା ପଦ୍ଧତି</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="273_108331_484711"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A standard Windows control that supports scrolling.</descrip></descripGrp><ntig><termGrp><term id="108331">scroll bar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="484711">ସ୍କ୍ରୋଲ୍ ଦଣ୍ଡିକା</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27311_1370396_1520340"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An action considered to have social relevance and that might appear in an activity feed. For example, photo activity and status updates are considered to be socially relevant.</descrip></descripGrp><ntig><termGrp><term id="1370396">social update</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1520340">ଅଦ୍ୟତନ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27311_1375269_1520340"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An action considered to have social relevance and that might appear in an activity feed. For example, photo activity and status updates are considered to be socially relevant.</descrip></descripGrp><ntig><termGrp><term id="1375269">update</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1520340">ଅଦ୍ୟତନ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27346_1370438_2335695"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A fault that occurs when a page sought in the file system cache is not found and must be retrieved from disk.</descrip></descripGrp><ntig><termGrp><term id="1370438">hard fault</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2335695">ହାର୍ଡ୍ ତ୍ରୁଟି</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27346_1370438_2335696"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A fault that occurs when a page sought in the file system cache is not found and must be retrieved from disk.</descrip></descripGrp><ntig><termGrp><