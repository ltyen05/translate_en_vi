ntry><termEntry id="11249_1166159_484449"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Light that is beyond red in the color spectrum. While the light is not visible to the human eye, infrared transmitters and receivers can send and receive infrared signals.</descrip></descripGrp><ntig><termGrp><term id="1166159">infrared light</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="484449">ଅବଲୋହିତ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11249_66343_484449"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Light that is beyond red in the color spectrum. While the light is not visible to the human eye, infrared transmitters and receivers can send and receive infrared signals.</descrip></descripGrp><ntig><termGrp><term id="66343">infrared</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="484449">ଅବଲୋହିତ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11249_66344_484449"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Light that is beyond red in the color spectrum. While the light is not visible to the human eye, infrared transmitters and receivers can send and receive infrared signals.</descrip></descripGrp><ntig><termGrp><term id="66344">IR</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNo