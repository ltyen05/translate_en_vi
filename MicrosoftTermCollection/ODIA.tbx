39897">MSFT</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1639484">Microsoft Corporation</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="28358_1585472_1957517"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A connection established between on-premises and cloud email systems that not only allows users to use email from either location with the same set of credentials, but provides a richer management experience.</descrip></descripGrp><ntig><termGrp><term id="1585472">Exchange hybrid deployment</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1957517">Exchange ହାଇବ୍ରିଡ୍ ନିୟୋଜନ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2839_37265_1545915"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of instructions in some computer language intended to be executed on a computer so as to perform some task. The term usually implies a self-contained entity, as opposed to a routine or a library.</descrip></descripGrp><ntig><termGrp><term id="37265">computer program</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1545915">କମ୍ପ୍ୟୁଟର୍ ପ୍ରୋଗ୍ରାମ୍</term><termNote type="geographicalUsage">IND</termNote><termNote