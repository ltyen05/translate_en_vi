ion">An encoding mechanism that converts binary data into printable ASCII characters so that the data can be included in the message body without violating SMTP conventions.</descrip></descripGrp><ntig><termGrp><term id="358369">UUENCODE</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1957768">UUENCODE</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13604_34469_484207"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The particular range of colors that a device or color model is able to produce.</descrip></descripGrp><ntig><termGrp><term id="34469">color gamut</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="484207">ରଙ୍ଗ ଭଣ୍ଡାର</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13604_660552_484207"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The particular range of colors that a device or color model is able to produce.</descrip></descripGrp><ntig><termGrp><term id="660552">gamut</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="484207">ରଙ୍ଗ ଭଣ୍ଡାର</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammatic