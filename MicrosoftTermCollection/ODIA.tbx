5354"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A line or row of characters used to lead the eye from a data label to a data point, or from a callout to the appropriate part of an illustration.</descrip></descripGrp><ntig><termGrp><term id="73800">leader</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="485354">ପ୍ରମୁଖ ରେଖା</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14854_359997_485934"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A field in a table that draws data from another table.</descrip></descripGrp><ntig><termGrp><term id="359997">Lookup field</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="485934">ଦୃଷ୍ଟିପାତ ଫିଲ୍ଡ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14856_370913_1802613"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In a cascading style sheet style definition (or style rule), the HTML element linked to a particular set of style properties and values.</descrip></descripGrp><ntig><termGrp><term id="370913">selector</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1802613">ଚୟନକାରୀ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14866_396930_1957502"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A distribution group that uses recipient filters and conditions to derive its membership at the time the message is sent.</descrip></descripGrp><ntig><termGrp><term id="396930">dynamic distribution group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1957502">ଡାଇନାମିକ୍ ବିତରଣ ଗୋଷ୍ଠୀ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1488_136966_484886"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A row in the upper part of the Macro window in which you enter macro names, actions, conditions, and comments associated with a particular macro or macro group.</descrip></descripGrp><ntig><termGrp><term id="136966">action row</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="484886">କ୍ରୀଯା ଧାଡ଼ି</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14885_397156_1957518"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Exchange 2007 graphical user interface (GUI) from which administrators can perform tasks to configure and manage Exchange servers. The Exchange Management Console is based on Windows Microsoft Management Console (MMC) 3.0.</descrip></descripGrp><ntig><termGrp><term id="397156">Exchange Management Console</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1957518">Exchange ପରିଚାଳନା କନସୋଲ୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14886_321129_485777"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that helps improve the recognition of a user's touch flicks by a process in which the user's touch flicks are analyzed.</descrip></descripGrp><ntig><termGrp><term id="321129">touch training</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="485777">ସ୍ପର୍ଶ ପ୍ରଶିକ୍ଷଣ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14888_125490_1259159"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An address that uniquely identifies a location on the Internet. A URL is usually preceded by http://, as in http://www.microsoft.com. A URL can contain more detail, such as the name of a page of hypertext, often with the file name extension .html or .htm.</descrip></descripGrp><ntig><termGrp><term id="125490">Uniform Resource Locator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1259159">URL</term><termNote type="geograp