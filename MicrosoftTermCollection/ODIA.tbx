ular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35716_2065926_2360584"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature where users can add contacts that they call frequently so that they can get to their numbers quickly rather than going through the Contact list in People.</descrip></descripGrp><ntig><termGrp><term id="2065926">speed dial</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2360584">ସ୍ପିଡ୍ ଡାୟଲ୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3573_73656_484500"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The protocol or protocols operating at a particular level within a protocol suite, such as IP within the TCP/IP suite.</descrip></descripGrp><ntig><termGrp><term id="73656">layer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="484500">ସ୍ତର</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35734_2067082_2218643"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that provides quick access to settings and notifications specified by the user.</descrip></descripGrp><ntig><termGrp><term id="2067082">action center</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><n