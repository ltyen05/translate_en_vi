ype କମ୍ୟୁନିଟି</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40056_2329158_2337614"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A web solution that enables broadcasting on the Internet, with a dedicated producer.</descrip></descripGrp><ntig><termGrp><term id="2329158">Skype broadcast</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2337614">Skype ବ୍ରଡକାଷ୍ଟ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40058_2329160_2337612"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A telephone call that the person you are calling agrees to pay for.</descrip></descripGrp><ntig><termGrp><term id="2329160">reverse charge calling</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2337612">ବିପରୀତ ଚାର୍ଜ୍ କଲିଂ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40059_2329161_2337611"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A long-distance telephone call to be paid for by the receiving end</descrip></descripGrp><ntig><termGrp><term id="2329161">reverse charge call</term><termNote type="partOfSpeech">Noun</termNote><termNote 