or editing a file.</descrip></descripGrp><ntig><termGrp><term id="49332">edit mode</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1881693">ସମ୍ପାଦନ ମୋଡ୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6458_1274286_1650302"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Text that is entered by drawing or writing on a screen, rather with a keyboard.</descrip></descripGrp><ntig><termGrp><term id="1274286">digital handwriting</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1650302">ହସ୍ତଲିଖନ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6458_1274286_1881583"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Text that is entered by drawing or writing on a screen, rather with a keyboard.</descrip></descripGrp><ntig><termGrp><term id="1274286">digital handwriting</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1881583">ଡିଜିଟାଲ୍ ହସ୍ତଲିଖନ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6458_60255_1650302"><la