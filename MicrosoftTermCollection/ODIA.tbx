certain installation settings and options, such as which components will be installed.</descrip></descripGrp><ntig><termGrp><term id="317517">custom installation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="485667">କଷ୍ଟମ ସଂସ୍ଥାପନାକରଣ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11926_41721_484267"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of installation that allows the user to specify certain installation settings and options, such as which components will be installed.</descrip></descripGrp><ntig><termGrp><term id="41721">custom install</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="484267">କଷ୍ଟମ ସଂସ୍ଥାପନ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11926_41721_485667"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of installation that allows the user to specify certain installation settings and options, such as which components will be installed.</descrip></descripGrp><ntig><termGrp><term id="41721">custom install</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="485667">କଷ୍ଟମ ସଂସ୍ଥାପନାକରଣ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote>