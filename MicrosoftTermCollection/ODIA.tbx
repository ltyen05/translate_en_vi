ch information or a resource is no longer valid.</descrip></descripGrp><ntig><termGrp><term id="308318">expiration date</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="485589">ମିଆଦ ତାରିଖ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24202_1115320_1881528"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process, thread, or set of related processes or threads that requires significant system resources or time, or requires exclusive access to large amounts of data.</descrip></descripGrp><ntig><termGrp><term id="1115320">resource-intensive task</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1881528">ଉତ୍ସ –ପ୍ରାରମ୍ଭ ଟାସ୍କ୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24212_1119987_1881532"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A custom solution that can be deployed to a site by a site collection administrator, without approval from the farm administrator. Without that approval, the solution has full access to the immediate site and restricted access to system resources and other sites.</descrip></descripGrp><ntig><termGrp><term id="1119987">sandboxed solution</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term 