ipGrp><descrip type="definition">The edition of Windows 11 targeting enterprise customers.</descrip></descripGrp><ntig><termGrp><term id="2997866">Windows 11 Enterprise</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2997931">Windows 11 Enterprise</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52781_2997867_2997927"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The edition of the Windows 11 operating system that is available through a subscription targeting commercial customers.</descrip></descripGrp><ntig><termGrp><term id="2997867">Windows 11 Business</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2997927">Windows 11 Business</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52782_2997868_2997935"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The edition of the Windows 11 operating system that has been specifically optimized for workstations.</descrip></descripGrp><ntig><termGrp><term id="2997868">Windows 11 Pro for Workstations</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2997935">Windows 11 Pro for Workstations</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52783_2997869_2997933"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The edition of the Windows 11 operating system that targets business customers and comes pre-installed on devices.</descrip></descripGrp><ntig><termGrp><term id="2997869">Windows 11 Pro</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2997933">Windows 11 Pro</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52784_2997870_2997932"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The edition of the Windows 11 operating system that targets consumers.</descrip></descripGrp><ntig><termGrp><term id="2997870">Windows 11 Home</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2997932">Windows 11 Home</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52785_2997871_2997926"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The version 11 of the Windows operating system.</descrip></descripGrp><ntig><termGrp><term id="2997871">Windows 11</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2997926">Windows 11</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52786_2998899_2999749"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Costa Rican national holiday celebrated on December 1 to commemorate the day in 1948 on which then-President José Figueres Ferrer abolished the armed forces following the end of the Costa Rican Civil War.</descrip></descripGrp><ntig><termGrp><term id="2998899">Abolition of the Army</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2999749">ସେନାର ଏବୋଲେସନ୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52787_2998900_2999751"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The audio-centric user experience that enables Teams customers to catch up on communications, events, and activities when getting back online and to stay connected with work while being distracted from everyday chores.</descrip></descripGrp><ntig><termGrp><term id="2998900">Catch Me Up</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2999751">କ୍ୟାଚ୍ ମି ଆପ୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52788_2999688_2999746"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Expressed in terms of a power of e; or, characterized by a rate of change that is proportional to the value of the varying quantity.</descrip></descripGrp><ntig><termGrp><term id="2999688">exponential</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2999746">ଘାତୀୟ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52789_2999689_2999745"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Of a complex number, the number with a real part and an imaginary part equal in magnitude but opposite in sign; for example, if a and b are real, then the complex conjugate of a+bi is equal to a-bi.</descrip></descripGrp><ntig><termGrp><term id="2999689">complex conjugate</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2999745">କମ୍ପ୍ଲେକ୍ସ କଞ୍ଜୁଗେଟ୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5279_95225_484670"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A sequence of 25 letters and numbers. To activate some software, you must enter a product key during the activation process.</descrip></descripGrp><ntig><termGrp><term id="95225">product key</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="484670">ଉତ୍ପାଦ କୀ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52790_2999690_2999747"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mathematical object that can be interpreted as an area or a generalization of an area.</descrip></descripGrp><ntig><termGrp><term id="2999690">integral</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2999747">ପୂର୍ଣ୍ଣସଂଖ୍ୟା</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52793_3000145_3000565"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A person's default space in the Mesh app for HoloLens, private and only accessible by its owner.</descrip></descripGrp><ntig><termGrp><term id="3000145">home space</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="3000565">ହୋମ୍ ସ୍ପେସ୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52794_3000146_3000564"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A space in which multiple people connect and collaborate together in the Mesh app for HoloLens.</descrip></descripGrp><ntig><termGrp><term id="3000146">collaborative space</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="3000564">ସହଯୋଗୀତାମୂଳକ ସ୍ଥାନ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52795_3000147_3000572"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A location in mixed reality that persists, contains content (models, ink, images, etc), supports real-time presence of the members of the space, and can be bound to one (or more) locations in the real world.</descrip></descripGrp><ntig><termGrp><term id="3000147">space</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="3000572">ସ୍ଥାନ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52796_3000148_3000570"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Set of settings accessible directly from the right corner of the Windows 11 taskbar (e.g. brightness, Wi-Fi, Bluetooth, etc.).</descrip></descripGrp><ntig><termGrp><term id="3000148">quick settings</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="3000570">ଦ୍ରୁତ ସେଟିଂସ୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52797_3000149_3000571"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Refreshed version of the Segoe UI font redesigned as a variable font to improve readability and scalability for Windows 11.</descrip></descripGrp><ntig><termGrp><term id="3000149">Segoe UI Variable</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="3000571">Segoe UI ଭେରିଏବଲ୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52798_3000151_3000567"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The service, powered by Azure, that enables presence and shared experiences from anywhere – on any device – through mixed reality applications; the app for Hololens that lets people connect, share, and collaborate in mixed reality that runs on that service.</descrip></descripGrp><ntig><termGrp><term id="3000151">Microsoft Mesh</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="3000567">Mesh</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52798_3000151_3000569"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The service, powered by Azure, that enables presence and shared experiences from anywhere – on any device – through mixed reality applications; the app for Hololens that lets people connect, share, and collaborate in mixed reality that runs on that service.</descrip></descripGrp><ntig><termGrp><term id="3000151">Microsoft Mesh</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="3000569">Microsoft Mesh</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52798_3000152_3000567"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The service, powered by Azure, that enables presence and shared experiences from anywhere – on any device – through mixed reality applications; the app for Hololens that lets people connect, share, and collaborate in mixed reality that runs on that service.</descrip></descripGrp><ntig><termGrp><term id="3000152">Mesh</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="3000567">Mesh</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52798_3000152_3000569"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The service, powered by Azure, that enables presence and shared experiences from anywhere – on any device – through mixed reality applications; the app for Hololens that lets people connect, share, and collaborate in mixed reality that runs on that service.</descrip></descripGrp><ntig><termGrp><term id="3000152">Mesh</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="3000569">Microsoft Mesh</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="528_67425_484453"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The location where the user is currently directing input.</descrip></descripGrp><ntig><termGrp><term id="67425">input focus</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="484453">ଇନପୁଟ୍ କେନ୍ଦ୍ରିକ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52810_3001101_3001431"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature in Microsoft Teams for Education that allows educators to quickly and easily communicate with their students’ parents and guardians.</descrip></descripGrp><ntig><termGrp><term id="3001101">Parents</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="3001431">ପ୍ୟାରେଣ୍ଟ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52811_3001102_3001428"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature in Outlook that allows customers to book the time and means of transportation they need to travel between meetings or events, including options like walking, biking, driving, public transport, and even 3rd party resources like Lyft or Uber.</descrip></descripGrp><ntig><termGrp><term id="3001102">Commute</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="3001428">କମ୍ୟୁଟେ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52812_3001103_3001429"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature in Microsoft Teams Rooms that provides users in the room with an enhanced meeting layout by bringing meeting information gathered from fluid components to the forefront of the screen and bringing the gallery to the bottom so people can meet face to face.</descrip></descripGrp><ntig><termGrp><term id="3001103">Front row</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="3001429">ସମ୍ମୁଖ ଧାଡି</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52813_3001104_3001433"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Teams channel to which team owners can add users (people) who aren't members of the team.</descrip></descripGrp><ntig><termGrp><term id="3001104">shared channel</term><termNote type="partOf