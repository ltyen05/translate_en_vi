></descripGrp><ntig><termGrp><term id="652287">outline level</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1426226">ବାହ୍ୟରେଖା ସ୍ତର</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19314_652289_1881417"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Resource cost per hour. Project includes two types of pay rates: standard rates and overtime rates.</descrip></descripGrp><ntig><termGrp><term id="652289">pay rate</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1881417">ଦେୟ ଦର</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19315_652290_1426227"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of related tasks that completes a major step in a project.</descrip></descripGrp><ntig><termGrp><term id="652290">phase</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1426227">ପର୍ଯ୍ୟାୟ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1932_211418_1957568"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The computer that you are currently logged on to as a user. More generally, a local computer is a computer that you can access directly without using a communications line or a communications device, such as a network adapter or a modem.</descrip></descripGrp><ntig><termGrp><term id="211418">local computer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1957568">ସ୍ଥାନୀୟ କମ୍ପ୍ୟୁଟର୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1932_535324_1957568"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The computer that you are currently logged on to as a user. More generally, a local computer is a computer that you can access directly without using a communications line or a communications device, such as a network adapter or a modem.</descrip></descripGrp><ntig><termGrp><term id="535324">local machine</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1957568">ସ୍ଥାନୀୟ କମ୍ପ୍ୟୁଟର୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19320_652420_1426228"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Conditions you specify to limit which records are included in the result set of a query or filter.</descrip></descripGrp><ntig><termGrp><term id="652420">criteria</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammat