US"><descripGrp><descrip type="definition">A state in which your computer consumes less power when it is idle, but remains available for immediate use. While your computer is on standby, information in computer memory is not saved on your hard disk. If there is an interruption in power, the information in memory is lost.</descrip></descripGrp><ntig><termGrp><term id="116089">standby</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="484753">ଷ୍ଟାଣ୍ଡବାଏ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49147_2782725_2783960"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft client/server messaging and collaboration software that is delivered as a cloud service hosted by Microsoft.</descrip></descripGrp><ntig><termGrp><term id="2782725">Exchange Online</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2783960">Exchange</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49147_2783738_2783960"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft client/server messaging and collaboration software that is delivered as a cloud service hosted by Microsoft.</descrip></descripGrp><ntig><termGrp><term id="2783738">Exchange</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected<