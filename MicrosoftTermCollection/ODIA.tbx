on">A picture that is stored within a document rather than being linked to a source file outside of the document.</descrip></descripGrp><ntig><termGrp><term id="2199065">embedded image</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1881384">ଏମ୍ଵାଡ୍ ହୋଇଥିବା ଛବି</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18517_650871_1881384"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A picture that is stored within a document rather than being linked to a source file outside of the document.</descrip></descripGrp><ntig><termGrp><term id="650871">embedded picture</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1881384">ଏମ୍ଵାଡ୍ ହୋଇଥିବା ଛବି</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18523_650877_1259196"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An address similar to a URL that provides network access to an event, such as a live broadcast. Attendees go to this address to view the event from their computers.</descrip></descripGrp><ntig><termGrp><term id="650877">event address</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1259196">ଇଭେଣ୍ଟ୍ ଠିକଣା</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18525_650879_1802583"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A text string that unambiguously refers to a hardware or software component under a certain context and can be used to access the data in that component.</descrip></descripGrp><ntig><termGrp><term id="650879">identifier</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1802583">ପରିଚାୟକ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18529_650883_1259197"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Data that is stored outside of the application that is currently in use.</descrip></descripGrp><ntig><termGrp><term id="650883">external data</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1259197">ବାହ୍ୟ ଡ଼ାଟା</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18530_650884_1259198"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A range of data that is brought into a worksheet but that originates outside of Excel, such as in a database or text file.</descrip></descripGrp><ntig><termGrp><term id="650884">external data range</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1259198">ବାହ୍ୟ ଡ଼ାଟା ପରିସର</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18535_650889_1881385"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A pane located on top of the Navigation Pane that has copies of your Inbox, Sent Items, and so on. You can add, remove, and arrange folders in this pane. Collapse or expand the pane by clicking the arrow in the Favorite Folders header.</descrip></descripGrp><ntig><termGrp><term id="650889">Favorite Folders</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1881385">ପସନ୍ଦିତା ଫୋଲ୍ଡର୍‌ଗୁଡିକ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18536_650890_1259199"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A button that identifies a field in a PivotTable or PivotChart report. You can drag the field buttons to change the layout of the report, or click the arrows next to the buttons to change the level of detail displayed in the report.</descrip></descripGrp><ntig><termGrp><term id="650890">field button</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1259199">ଫିଲ୍ଡ ବଟନ୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18538_650892_1259200"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The part of PivotTable or PivotChart view that contains filter fields.</descrip></descripGrp><ntig><termGrp><term id="650892">filter area</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1259200">ଫିଲ୍ଟର କ୍ଷେତ୍ର</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18539_650893_1259201"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A field in the filter area that you can use to filter data displayed in PivotTable or PivotChart view. Filter fields perform the same functions as page fields in Microsoft Excel PivotTable reports.</descrip></descripGrp><ntig><termGrp><term id="650893">filter field</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1259201">ଫିଲ୍ଟର ଫିଲ୍ଡ୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18542_650896_1426208"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The date that a project or task is scheduled to be completed. This date is based on the task's start date, duration, calendars, predecessor dates, task dependencies, and constraints.</descrip></descripGrp><ntig><termGrp><term id="650896">finish date</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1426208">ସମାପ୍ତ ତାରିଖ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18549_650903_1259202"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Internet Web page or intranet page that is associated with an Outlook folder. If a page has been associated with the folder and the option is set, the Web page appears in the Outlook window whenever you select the folder.</descrip></descripGrp><ntig><termGrp><term id="650903">folder home page</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1259202">ଫୋଲ୍ଡର୍ ମୂଳ ପୃଷ୍ଠା</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1855_307383_1413146"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of validating software with the manufacturer. Activation confirms the genuine status of a product and that the product key has not been compromised. It establishes a relationship between the software’s product key and a particular installation of that software on a device.</descrip></descripGrp><ntig><termGrp><term id="307383">activation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1413146">ସକ୍ରିୟକରଣ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18551_650905_1259203"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A location on a computer's hard drive to store a local copy of a form to improve performance when opening a form subsequent times.</descrip></descripGrp><ntig><termGrp><term id="650905">forms cache</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1259203">ଫର୍ମସ୍ କ୍ୟାଚ୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18558_650912_1259204"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method to find a specific value for a cell by adjusting the value of one other cell. When goal seeking, Excel varies the value in a cell that you specify until a formula that's dependent on that cell returns the result you want.</descrip></descripGrp><ntig><termGrp><term id="650912">goal seek</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1259204">ଗୋଲ୍ ଖୋଜିବା</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18559_650913_1802582"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A rank or category assigned to a material resource that denotes functional use but not level of quality. A low-grade resource is not necessarily a low-quality resource.</descrip></descripGrp><ntig><termGrp><term id="650913">grade</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1802582">ଗ୍ରେଡ୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1856_52994_1881079"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Expressed as n! (n factorial), the result of multiplying the successive integers from 1 through n; n! equals n x (n - 1) x (n - 2) x ... x 1.</descrip></descripGrp><ntig><termGrp><term id="52994">factorial</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1881079">ଫ୍ୟାକ୍ଟୋରିଆଲ୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18560_650914_1259205"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The faint vertical and horizontal lines that appear in the drawing window when the grid is turned on. You can use grid lines to help position shapes precisely.</descrip></descripGrp><ntig><termGrp><term id="650914">grid lines</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1259205">ଗ୍ରିଡ୍ ଲାଇନ୍ସ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18561_650915_1259206"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The point that defines the layout of grid lines on the drawing page. A vertical grid line and a horizontal grid line pass through the grid origin, and all other grid lines are drawn at specified intervals from these reference lines.</descrip></descripGrp><ntig><termGrp><term id="650915">grid origin</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1259206">ଗ୍ରିଡ୍ ଉତ୍ପତ୍ତି</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1858_128261_484823"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The | character.</descrip></descripGrp><ntig><termGrp><term id="128261">vertical bar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="484823">ଅନୁଲମ୍ବ ଦଣ୍ଡିକା</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1858_128261_484824"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The | character.</descrip></descripGrp><ntig><termGrp><term id="128261">vertical bar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="484824">ପାଇପ୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1858_128262_484823"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The | character.</descrip></descripGrp><ntig><termGrp><term id="128262">VERTICAL LINE</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="484823">ଅନୁଲମ୍ବ ଦଣ୍ଡିକା</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1858_128262_484824"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The | character.</descrip></descripGrp><ntig><termGrp><term id="128262">VERTICAL LINE</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="484824">ପାଇପ୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1858_128263_484823"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The | character.</descrip></descripGrp><ntig><termGrp><term id="128263">pipe</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="484823">ଅନୁଲମ୍ବ ଦଣ୍ଡିକା</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1858_128263_484824"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The | character.</descrip></descripGrp><ntig><termGrp><term id="128263">pipe</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="484824">ପାଇପ୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18583_650937_1881386"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A phone number format for dialing any call from any location or with a calling card.</descrip></descripGrp><ntig><termGrp><term id="650937">international format</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1881386">ଅନ୍ତଃରାଷ୍ଟ୍ରୀୟ ସ୍ଵରୁପ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18585_650939_1259208"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A line that connects fields between two tables and shows how the data is related. The type of join indicates which records are selected for the query's result set.</descrip></descripGrp><ntig><termGrp><term id="650939">join line</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1259208">ଯୋଗଦାନ ରେଖା</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18587_650941_1259209"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The special characters used to extend the joiner between two Arabic characters. Used to improve the appearance of justified text by visually lengthening words rather than increasing the spacing between words. Can also function like a hyphen.</descrip></descripGrp><ntig><termGrp><term id="650941">kashidas</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1259209">କାସିଦାଶ୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18590_650944_1426209"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Resolving resource conflicts or overallocations by delaying or splitting certain tasks. When Project levels a resource, its selected assignments are distributed and rescheduled.</descrip></descripGrp><ntig><termGrp><term id="650944">leveling</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1426209">ସମାନ୍ତରଣ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18594_650948_1259210"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of cascading style sheet that exists in a separate file and is referenced throughout one or more Web pages.</descrip></descripGrp><ntig><termGrp><term id="650948">linked style sheet</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1259210">ସଂଯୁକ୍ତ ଷ୍ଟାଇଲ୍ ସିଟ୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18598_650952_1881387"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A character, usually a comma or semicolon, that separates elements in a list.</descrip></descripGrp><ntig><termGrp><term id="650952">list-separator character</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1881387">ତାଲିକା ବିଚ୍ଛେଦକ ବର୍ଣ୍ଣ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="186_3712_2349587"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To change to a newer, and/or more powerful or sophisticated version of a product.</descrip></descripGrp><ntig><termGrp><term id="3712">upgrade</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2349587">ନବୀକରଣ କରନ୍ତୁ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18601_650955_1881388"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A calendar that is based on cycles of the moon phase.</descrip></descripGrp><ntig><termGrp><term id="650955">Lunar calendar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1881388">ଲୁନାର୍ କ୍ୟାଲେଣ୍ଡର୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18604_650958_1881389"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A range in an XML list that has been linked to an element in an XML map.</descrip></descripGrp><ntig><termGrp><term id="650958">mapped range</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1881389">ମ୍ୟାପ୍ ହୋଇଥିବା ପରିସର</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18605_650959_1426210"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A shape on a stencil that you use repeatedly to create drawings. When you drag a shape from a stencil onto the drawing page, the shape becomes an instance of that master.</descrip></descripGrp><ntig><termGrp><term id="650959">master shape</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1426210">ମାଷ୍ଟର ଆକୃତି</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18614_650968_1881390"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tone in a picture that is in the middle of the tonal range, between the lightest and darkest tones</descrip></descripGrp><ntig><termGrp><term id="650968">midtone</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1881390">ମିଡ୍‌ଟୋନ୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1881_68580_484464"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Software that enables a program to work with the user (the user interface, which can be a command-line interface, menu-driven, or a graphical user interface), with another program such as the operating system, or with the computer's hardware.</descrip></descripGrp><ntig><termGrp><term id="68580">interface</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="484464">ଇଣ୍ଟରଫେସ୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1883_318780_485736"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The = character.</descrip></descripGrp><ntig><termGrp><term id="318780">equal sign</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="485736">ସମାନ ଚିହ୍ନ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18831_651182_1906317"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A character that does not have strong right-to-left or left-to-right language attributes.</descrip></descripGrp><ntig><termGrp><term id="651182">neutral character</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1906317">ପ୍ରାକୃତିକ ବର୍ଣ୍ଣ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18840_651191_1906318"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file you create on your hard disk or a network share to store OLAP source data for a PivotTable or PivotChart report. Offline cube files allow you to keep working when you are not connected to the OLAP server.</descrip></descripGrp><ntig><termGrp><term id="651191">offline cube file</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1906318">ଅଫ୍‌ଲାଇନ୍ କ୍ୟୁବ୍ ଫାଇଲ୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1885_69963_1258999"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ability for two or more software applications to work together with little effort from the user.</descrip></descripGrp><ntig><termGrp><term id="69963">interoperability</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1258999">ପ୍ରକ୍ଷେପକ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18851_651202_1426211"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The result of assigning more tasks to a resource than the resource can accomplish in the working time available.</descrip></descripGrp><ntig><termGrp><term id="651202">overallocation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1426211">ସାମଗ୍ରିକ ଦୃଷ୍ଟିପାତ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18860_651211_1802603"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Principles that guide developers as they assign responsibilities to software classes and design system behavior. They are most useful when creating collaboration diagrams where messages imply responsibility.</descrip></descripGrp><ntig><termGrp><term id="651211">patterns</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1802603">ନମୁନାଗୁଡିକ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18862_651213_1881391"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A field that you use to enter or display how much of a task has been completed. This value is expressed as the percentage of the task duration that has been completed.</descrip></descripGrp><ntig><termGrp><term id="651213">percent complete</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1881391">ଶତକଡା ସମ୍ପୁର୍ଣ୍ଣ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18865_651216_1259211"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A view of a list, SharePoint document library, or Web Part Page that is available only to a particular user.</descrip></descripGrp><ntig><termGrp><term id="651216">personal view</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1259211">ବ୍ୟକ୍ତିଗତ ଦର୍ଶନ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18873_651224_1426212"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A schedule of task start and finish dates and resource and cost data.</descrip></descripGrp><ntig><termGrp><term id="651224">plan</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1426212">ଯୋଜନା</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18876_651227_1881392"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A list of projects within an organization that may share common management of scope, budget, or resources.</descrip></descripGrp><ntig><termGrp><term id="651227">portfolio</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1881392">ପୋର୍ଟ୍‌ଫୋଲିଓ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18877_651228_1426213"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Placing elements, such as text and graphics, on a page to let the page author control the exact location and layer order of a page element.</descrip></descripGrp><ntig><termGrp><term id="651228">positioning</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1426213">ଅବସ୍ଥାନ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18878_651229_1881393"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A bookmark that Microsoft Word automatically sets in each document.</descrip></descripGrp><ntig><termGrp><term id="651229">predefined bookmark</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1881393">ପୂର୍ବନିର୍ଦ୍ଧାରିତ ପୁସ୍ତକଚିହ୍ନ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18891_651242_1426214"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The degree of excellence, or the desired standards, in a product, process, or project.</descrip></descripGrp><ntig><termGrp><term id="651242">quality</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1426214">ଗୁଣବତ୍ତା</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18892_651243_1881394"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A default color category that is assigned to an item when you click the Categories column for the item in your Inbox or other table view. You set this color category from the Categorize menu.</descrip></descripGrp><ntig><termGrp><term id="651243">Quick Click category</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1881394">ଶୀଘ୍ର କ୍ଲିକ୍ ବିଭଗ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18894_651245_1802585"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To move a task to a lower outline level [to the right] in the Task Name field. When you indent a task, it becomes a subtask of the nearest preceding task at a higher outline level.</descrip></descripGrp><ntig><termGrp><term id="651245">indent</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1802585">ଇଣ୍ଡେଣ୍ଟ୍ କରିବା</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18895_651246_1881395"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A task that occurs repeatedly during the course of a project. For example, you might define the weekly status meeting as a recurring task.</descrip></descripGrp><ntig><termGrp><term id="651246">recurring task</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1881395">ପୌନଃପୁନିକ ଟାସ୍କ୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18908_651259_1881396"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Excel template (.xlt file) that includes one or more queries or PivotTable reports that are based on external data. When you save a report template, Excel saves the query definition but doesn't store the queried data in the template.</descrip></descripGrp><ntig><termGrp><term id="651259">report template</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1881396">ରିପୋର୍ଟ୍ ଟେମ୍ପଲେଟ୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18909_651260_1259212"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A category of reports that all contain similar information.</descrip></descripGrp><ntig><termGrp><term id="651260">report type</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1259212">ରିପୋର୍ଟ ପ୍ରକାର</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="18916_651267_1881397"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A certificate that has been cancelled by a certificate authority (CA) and is no longer valid.</descrip></descripGrp><ntig><termGrp><term id="651267">revoked certificate</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></te