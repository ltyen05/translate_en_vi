ermNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52949_3121608_3122133"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The paid Teams standalone MSA-based SKU that will be available for both small businesses and consumers to purchase.</descrip></descripGrp><ntig><termGrp><term id="3121608">Teams Essentials</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="3122133">Teams ଏସେନ୍‌ସିଆଲ୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52950_3007456_3007972"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that allows users to publish full screen photo or short video content to their storyline, appearing in Viva Connections, Yammer, and elsewhere in Microsoft 365, allowing the user to express themselves, share their thoughts, or showcase an important moment or campaign to their followers or colleagues.</descrip></descripGrp><ntig><termGrp><term id="3007456">stories</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="3007972">କାହାଣୀଗୁଡିକ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52951_3007457_3007975"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A personal space for users to post thoughts and share ideas that are not confined to a specific community or event, allowing users to share their expertise on any subject of their choosing, build their personal brand within the company, or promote ideas and events that apply to more than one community, or even the entire network.</descrip></descripGrp><ntig><termGrp><term id="3007457">storyline</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="3007975">ଷ୍ଟୋରୀଲାଇନ୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52952_3007458_3007947"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An add-on with two associated SKUs that enables Microsoft 365 customers to store their Microsoft 365 user data at rest in their local geography at the tenant level​.</descrip></descripGrp><ntig><termGrp><term id="3007458">Advanced Data Residency Plan 1</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="3007947">ଅଗ୍ରୀମ ଡାଟା ରେସିଡେନ୍ସି ପ୍ଲାନ୍ 1</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52953_3007459_3007950"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An add-on with two associated SKUs that enables Microsoft 365 customers to store their Microsoft 365 user data at rest in their local geography at the user account level​.</descrip></descripGrp><ntig><termGrp><term id="3007459">Advanced Data Residency Plan 2</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="3007950">ଅଗ୍ରୀମ ଡାଟା ରେସିଡେନ୍ସି ପ୍ଲାନ୍ 2</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52954_3079521_3079541"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The service that enables organizations to use a single SIM-enabled number for Teams Phone serving as desk phone number, mobile number and Teams number.</descrip></descripGrp><ntig><termGrp><term id="3079521">Microsoft Teams Phone Mobile</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="3079541">Microsoft Teams ଫୋନ୍ ମୋବାଇଲ୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52955_3007461_3007976"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature in the M365 Compliance Center used by customers to look up individuals as part of a Data Subject Access Request (DSAR), most commonly in response to a GDPR or CCPA data access request.</descrip></descripGrp><ntig><termGrp><term id="3007461">user data search</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="3007976">ଉପଭୋକ୍ତା ଡାଟା ସନ୍ଧାନ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52956_3007463_3007970"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature in PowerPoint and Microsoft Teams that leverages AI to help professionals, students, and even those who just want to practice a speech for a wedding or graduation by providing users with feedback on their pace, use of monotone pitch, use of filler words, grammar, lack of originality, use of sensitive phrases, and more while they rehearse their presentations.</descrip></descripGrp><ntig><termGrp><term id="3007463">Speaker coach</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="3007970">ସ୍ପିକୋର୍ କୋଚ୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52957_3007464_3007956"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The tab in Microsoft Teams for Education that allows educators to view, grade, and return routine student work and allows students to view their assignments and routine grades.</descrip></descripGrp><ntig><termGrp><term id="3007464">Grades</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="3007956">ଗ୍ରେଡ୍‌ଗୁଡିକ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52960_3010666_3011471"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Describes an object, such as a file or email, that has been inspected and found to not contain any harmful or potentially harmful content.</descrip></descripGrp><ntig><termGrp><term id="3010666">no threats found</term><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="3011471">କୌଣସି ବିପଦ ମିଳିଲା ନାହିଁ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5297_107243_1259915"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To write data (typically a file) to a storage medium.</descrip></descripGrp><ntig><termGrp><term id="107243">save</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1259915">ସଂରକ୍ଷଣ କରନ୍ତୁ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52979_3011592_3011784"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The view in PowerPoint that allows users to read notes, which are hidden from the presentation, when a user is recording a video of their PowerPoint presentation.</descrip></descripGrp><ntig><termGrp><term id="3011592">Teleprompter</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="3011784">ଟେଲିପ୍ରୋମ୍ପ୍ଟର୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5298_9459_484037"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of contact information for particular individuals, groups or organizations.</descrip></descripGrp><ntig><termGrp><term id="9459">address book</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="484037">ଠିକଣା ପୁସ୍ତକ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52980_3011955_3012006"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A graphical control element in the form of a progress bar that shows playback progress and allows the user to move backward/forward along a slider in order to rewind/fast-forward video playback or click on a point along the slider to move to a particular point in time of the recording.</descrip></descripGrp><ntig><termGrp><term id="3011955">seek bar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="3012006">ବାର୍ ଖୋଜିବା</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52981_3011956_3012004"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The high-definition video format characterized by a display resolution of 1920x1080 pixels.</descrip></descripGrp><ntig><termGrp><term id="3011956">Full HD</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="3012004">ସଂପୂର୍ଣ୍ଣ HD</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52982_3011957_3012005"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The duration of time in a music album or an audio disc.</descrip></descripGrp><ntig><termGrp><term id="3011957">run time</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="3012005">ଚଳନ ସମୟ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52984_3012061_3012434"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An add-on available to Microsoft Viva Insights subscribers, which provides additional capacity for usage of custom analysis tools.</descrip></descripGrp><ntig><termGrp><term id="3012061">Microsoft Viva Insights Capacity</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="3012434">Microsoft Viva Insights Capacity</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52989_3012675_3012698"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature of the Calculator app that allows the user to store a figure for use in future calculations.</descrip></descripGrp><ntig><termGrp><term id="3012675">Memory</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="3012698">ମୋମରୀ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52990_3012676_3013567"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Teams feature that allows a user to draw on and annotate an object on the screen.</descrip></descripGrp><ntig><termGrp><term id="3012676">Annotate</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="3013567">ଏନୋଟେଟ୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52991_3012677_3013571"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The link in Teams that allows a user to access information about a meeting.</descrip></descripGrp><ntig><termGrp><term id="3012677">Info</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="3013571">ସୂଚନା</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOf