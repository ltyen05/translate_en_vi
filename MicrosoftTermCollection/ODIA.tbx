tion">A type of CD on which files can be copied, erased, and replaced.</descrip></descripGrp><ntig><termGrp><term id="136606">CD-RW</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="484879">CD-RW</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9355_309006_2709834"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The legal agreement between Microsoft and the user, with regard to the terms of use and transfer of software.</descrip></descripGrp><ntig><termGrp><term id="309006">Microsoft Software License Terms</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2709834">Microsoft ସଫ୍ଟଓ୍ୱେୟାର୍ ଲାଇସେନ୍ସ ସର୍ତ୍ତାବଳୀ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9375_85176_484587"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">For local area networks (LANs), a device that is connected to the network and is capable of communicating with other network devices.</descrip></descripGrp><ntig><termGrp><term id="85176">node</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="484587">ସଂଯୋଗ ବିନ୍ଦୁ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalG