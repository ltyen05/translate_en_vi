older that stores messages that have been created but not yet sent.</descrip></descripGrp><ntig><termGrp><term id="88948">outbox</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="484619">ବାହାର ବାକ୍ସ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13067_138300_1881134"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An icon that designates a change made by a reviewer to a presentation.</descrip></descripGrp><ntig><termGrp><term id="138300">change marker</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1881134">ପରିବର୍ତ୍ତନ ମାର୍କର୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1307_319132_1259817"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to text that is aligned along the right margin.</descrip></descripGrp><ntig><termGrp><term id="319132">right-aligned</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1259817">ଦକ୍ଷିଣପାର୍ଶ୍ୱ ଶ୍ରେଣୀବଦ୍ଧତା</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id=