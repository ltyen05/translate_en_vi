le key combination or name.</descrip></descripGrp><ntig><termGrp><term id="77118">macro</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="484530">ମାକ୍ରୋ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54050_3080961_3082961"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The argument in the DATEVALUE Excel function that represents a date in an Excel date format, or a reference to a cell that contains text that represents a date in an Excel date format.</descrip></descripGrp><ntig><termGrp><term id="3080961">date_text</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="3082961">date_text</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54051_3080962_3082974"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The argument in an Excel function that specifies a number in the date-time code used by Excel.</descrip></descripGrp><ntig><termGrp><term id="3080962">serial_number</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="3082974">serial_number</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote