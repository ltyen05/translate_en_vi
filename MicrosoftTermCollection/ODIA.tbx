78_485338"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The pane at the bottom of the Calendar module where tasks are displayed. Tasks that are completed on a particular day "stick" to the day and are shown as a record of what work was performed on that day. Tasks not completed roll over to the next day and accumulate until completed.</descrip></descripGrp><ntig><termGrp><term id="237378">Daily Task List</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="485338">ଦୈନିକ ଟାସ୍କ ସାରଣୀ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12222_146338_1881192"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A field that is assigned a series orientation in a PivotChart report. In a chart, series are represented in the legend.</descrip></descripGrp><ntig><termGrp><term id="146338">PivotChart series field</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1881192">PivotChart କ୍ରମାଙ୍କ ଫିଲ୍ଡ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1223_147636_1881200"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A link that uses a relative URL.</descrip></descripGrp><ntig><termGrp><term id="147636">relative link</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet