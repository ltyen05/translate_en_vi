g="or-IN"><ntig><termGrp><term id="2929337">Viva Learning</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51979_2929085_2929338"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Part of the Microsoft Viva family of employee experience offerings, it is a central hub for learning where people can discover, share, assign, and learn from best-in-class content libraries across the organization—including LinkedIn Learning, Microsoft Learn, third-party content providers, and an organization’s own custom content—to help teams and individuals to make learning a natural part of their day.</descrip></descripGrp><ntig><termGrp><term id="2929085">Learning</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2929338">Learning</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51981_2926576_2927727"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows users to convert the image to text with screenshare during a Microsoft Teams meeting (the ability for meeting attendees to digitize and interact with text and URLs on the Teams meeting stage).</descrip></descripGrp><ntig><termGrp><term id="2926576">screen share scanner</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2927727">ସ୍କ୍ରିନ୍ ସେୟାର୍ ସ୍କାନର୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51982_2926577_2927711"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Microsoft Teams service that simplifies the communications services acquisition and adoption process for business customers, providing the option to provision/deprovision phone numbers and (eventually) acquire/obtain capabilities from certified Carriers, all through the Teams Admin Center.</descrip></descripGrp><ntig><termGrp><term id="2926577">Operator Connect</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2927711">ଅପରେଟର୍ ସଂଯୋଗ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51983_2926579_2927701"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The tab in Microsoft Teams that allows the user to create, manage, and share approval requests such as stakeholder authorizations, customer signatures, or manager acknowledgements.</descrip></descripGrp><ntig><termGrp><term id="2926579">Approvals</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2927701">ଅନୁମୋଦନଗୁଡିକ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51984_2926583_2927706"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Teams, the way to present in which only the shared content itself is shown.</descrip></descripGrp><ntig><termGrp><term id="2926583">Content only</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2927706">କେବଳ ବିଷୟବସ୍ତୁ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51985_2926584_2927732"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Teams, option in Presenter Mode in which the shared content is shown as a background to the video of the presenter.</descrip></descripGrp><ntig><termGrp><term id="2926584">Standout</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2927732">ସ୍ୱତନ୍ତ୍ର</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51986_2926585_2927710"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The preview version of the Learning app in Microsoft Teams.</descrip></descripGrp><ntig><termGrp><term id="2926585">Learning (Preview)</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2927710">ଶିକ୍ଷଣ (ପୂର୍ବାବଲୋକନ)</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote typ