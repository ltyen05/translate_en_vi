nition">The name of a category of information in a mail-merge data source. For example, "City," "State," and "PostalCode" are commonly used field names in an address list.</descrip></descripGrp><ntig><termGrp><term id="141858">field name</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1259031">ଫିଲ୍ଡ ନାମ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43324_2454174_2456301"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The button that launches a digital ruler that allows users to draw straight ink and align shapes against​ it.</descrip></descripGrp><ntig><termGrp><term id="2454174">Ruler</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2456301">ରୁଲର୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43325_2454194_2456303"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tool that can positioned within content so that users can align objects and ink straight lines.</descrip></descripGrp><ntig><termGrp><term id="2454194">virtual ruler</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2456303">ଭିର୍ଚୁଆଲ୍ ରୁଲର୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech"