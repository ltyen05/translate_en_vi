active calls.</descrip></descripGrp><ntig><termGrp><term id="340130">swap</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2742200">ସ୍ୱାପ୍ କରିବା</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6985_58943_484406"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A gradual progression.</descrip></descripGrp><ntig><termGrp><term id="58943">gradient</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="484406">ଗ୍ରାଡ଼ିଏଣ୍ଟ୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6987_1354392_1957666"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of attributes that provides an indication of a person's status, activity, location, willingness to communicate, and contact information.</descrip></descripGrp><ntig><termGrp><term id="1354392">presence information</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1957666">ଉପସ୍ଥିତି</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6987_230790_1957666"><langSet xml:lang="en-U