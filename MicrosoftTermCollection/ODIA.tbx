ry><termEntry id="50540_2862042_2862779"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Microsoft web-hosted technology product such as Bing, MSN, OneDrive, Outlook.com, Devices, and Profile, all of which are accessed via a Microsoft account.</descrip></descripGrp><ntig><termGrp><term id="2862042">Microsoft Service</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2862779">Microsoft ସେବା</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50547_2862401_2862780"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature in Microsoft Edge that notifies users whenever a password that they have saved through the browser has been identified as compromised.</descrip></descripGrp><ntig><termGrp><term id="2862401">Password Monitor</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2862780">ପାସୱାର୍ଡ ମନିଟର</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50548_2862405_2862781"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft Edge feature that allows users to select, copy, and paste content that they find across the Web while maintaining the source site's formatting, spacing, and text so the copy looks like the original.</descrip></descripGrp><ntig><termGrp><term id="2862405">Smart copy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2862781">ସ୍ମାର୍ଟ କପି</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50549_2862409_2862783"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that lets Microsoft Edge users move their horizontal tabs at the top of the browser to a vertical pane at the right side of their screen.</descrip></descripGrp><ntig><termGrp><term id="2862409">vertical tabs</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2862783">ଭାର୍ଟିକାଲ୍ ଟ୍ୟାବଗୁଡିକ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50559_2862649_2862786"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of renewing one's energy over the course of a full night's sleep.</descrip></descripGrp><ntig><termGrp><term id="2862649">nightly recharge</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2862786">ରାତ୍ରୀ ରିଚାର୍ଜ୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50572_2864258_2864265"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A daily personalized email sent by Cortana to Office 365 users containing tasks and commitments made by the user, a summary of the user's meetings, and relevant documents for the user's day, all using information extracted from the user's Office 365 messages.</descrip></descripGrp><ntig><termGrp><term id="2864258">Cortana Briefing</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2864265">Cortana ସଂକ୍ଷିପ୍ତ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50572_2864258_2864266"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A daily personalized email sent by Cortana to Office 365 users containing tasks and commitments made by the user, a summary of the user's meetings, and relevant documents for the user's day, all using information extracted from the user's Office 365 messages.</descrip></descripGrp><ntig><termGrp><term id="2864258">Cortana Briefing</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2864266">Cortana ସଂକ୍ଷିପ୍ତ ଇମେଲ୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50572_2864259_2864265"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A daily personalized email sent by Cortana to Office 365 users containing tasks and commitments made by the user, a summary of the user's meetings, and relevant documents for the user's day, all using information extracted from the user's Office 365 messages.</descrip></descripGrp><ntig><termGrp><term id="2864259">Cortana Briefing email</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2864265">Cortana ସଂକ୍ଷିପ୍ତ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50572_2864259_2864266"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A daily personalized email sent by Cortana to Office 365 users containing tasks and commitments made by the user, a summary of the user's meetings, and relevant documents for the user's day, all using information extracted from the user's Office 365 messages.</descrip></descripGrp><ntig><termGrp><term id="2864259">Cortana Briefing email</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2864266">Cortana ସଂକ୍ଷିପ୍ତ ଇମେଲ୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50578_2864897_2864957"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that protects sensitive information on disk and makes it inaccessible to attackers when the device is locked using encryption keys that are temporarily wiped from the device and only made available when the device is unlocked.</descrip></descripGrp><ntig><termGrp><term id="2864897">personal information encryption</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2864957">ବ୍ୟକ୍ତିଗତ ସୂଚନା ଏନକ୍ରିପସନ୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50578_2864898_2864957"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that protects sensitive information on disk and makes it inaccessible to attackers when the device is locked using encryption keys that are temporarily wiped from the device and only made available when the device is unlocked.</descrip></descripGrp><ntig><termGrp><term id="2864898">Data Protection under Lock</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2864957">ବ୍ୟକ୍ତିଗତ ସୂଚନା ଏନକ୍ରିପସନ୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50578_2864899_2864957"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that protects sensitive information on disk and makes it inaccessible to attackers when the device is locked using encryption keys that are temporarily wiped from the device and only made available when the device is unlocked.</descrip></descripGrp><ntig><termGrp><term id="2864899">DPL</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2864957">ବ୍ୟକ୍ତିଗତ ସୂଚନା ଏନକ୍ରିପସନ୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50579_2864948_2864956"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The option in Microsoft Photos that allows the user to adjust the brightest part of a photo to be either darker or brighter.</descrip></descripGrp><ntig><termGrp><term id="2864948">Highlights</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2864956">ହାଇଲାଇଟ୍ସ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50591_2865796_2865832"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A headless app in the Microsoft Store that contains OpenGL and OpenCL API mapping layers on top of DirectX 12 that enable OpenCL and OpenGL apps to run with GPU acceleration in environments where there is no IHV OpenCL or OpenGL driver (for example, on Windows 10 ARM-based PCs).</descrip></descripGrp><ntig><termGrp><term id="2865796">OpenCL™ and OpenGL® Compatibility Pack</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2865832">OpenCL™ ଏବଂ OpenGL® ଦକ୍ଷତା ପ୍ୟାକ୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5060_129154_484826"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In relational database management systems, a logical table created through the specification of one or more relational operations on one or more tables. A view is equivalent to a divided relation in the relational model.</descrip></descripGrp><ntig><termGrp><term id="129154">view</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="484826">ଦର୍ଶନ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50607_2866400_2866425"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The search function in Microsoft Edge that lets users select text or images on web pages, then open the right-click context menu to search and view results in a sidebar to the right of the browser tab while keeping the current website visible.</descrip></descripGrp><ntig><termGrp><term id="2866400">sidebar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2866425">ସାଇଡବାର୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50666_2867744_2867834"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The option in Microsoft Edge in which a customer can copy a URL and paste as a visual link, which provides a card with a key image and title, as well as additional information from the page where available.</descrip></descripGrp><ntig><termGrp><term id="2867744">web preview</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2867834">ୱେବ୍ ପୂର୍ବାବଲୋକନ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50672_2868545_2868718"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Two apps that are grouped together by the customer, so both apps open at the same time.​</descrip></descripGrp><ntig><termGrp><term id="2868545">app group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2868718">ଆପ୍ଲିକେସନ୍ ଗୋଷ୍ଠୀ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50673_2868546_2868766"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To enlarge an app on a dual-screen device so that it goes across both screens.</descrip></descripGrp><ntig><termGrp><term id="2868546">maximize</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2868766">ସର୍ବାଧିକ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50674_2868547_2868759"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To reorient a dual-screen device that is folded in order to see the other screen.</descrip></descripGrp><ntig><termGrp><term id="2868547">flip</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2868759">ଫ୍ଲିପ୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50675_2868548_2868763"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To move one screen of a dual-screen device backward.</descrip></descripGrp><ntig><termGrp><term id="2868548">fold</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2868763">ଭାଂଗ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50679_2868550_2868723"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An app that has been designed specifically for dual-screen devices.</descrip></descripGrp><ntig><termGrp><term id="2868550">Dual-screen enhanced app</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2868723">ଡୁଆଲ୍-ସ୍କ୍ରିନ୍ ବର୍ଦ୍ଧିତ ଆପ୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50681_2868552_2868725"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The hinge that holds the two screens together on the Surface Duo dual-screen device.</descrip></descripGrp><ntig><termGrp><term id="2868552">Dynamic 360° Hinge</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2868725">Dynamic 360° Hinge</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5069_160054_485049"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A technique for converting a color in one color space to another color space. Typically, this conversion is from YUV colors from a video source to RGB for display.</descrip></descripGrp><ntig><termGrp><term id="160054">color-space conversion</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="485049">ରଙ୍ଗ-ସ୍ପେସ୍ ପରିବର୍ତ୍ତନ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5069_210048_485049"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A technique for converting a color in one color space to another color space. Typically, this conversion is from YUV colors from a video source to RGB for display.</descrip></descripGrp><ntig><termGrp><term id="210048">color space conversion</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><n