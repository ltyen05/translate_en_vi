ND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25584_1177245_1957644"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft Identity Lifecycle Manager (ILM) 2007 management agent provided by Microsoft to connect to Outlook Live. It is an ILM component that consists of properties, rules, and rules extensions that determine how an object is processed.</descrip></descripGrp><ntig><termGrp><term id="1177245">OLMA</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1957644">Outlook Live Management Agent</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25584_1177245_2290277"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft Identity Lifecycle Manager (ILM) 2007 management agent provided by Microsoft to connect to Outlook Live. It is an ILM component that consists of properties, rules, and rules extensions that determine how an object is processed.</descrip></descripGrp><ntig><termGrp><term id="1177245">OLMA</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2290277">ELMA</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25584_135440