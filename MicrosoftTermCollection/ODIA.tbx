p><ntig><termGrp><term id="2432492">draw</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2436949">ଅଙ୍କନ କରନ୍ତୁ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42887_2432493_2436952"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tool that allows users to use ink to draw using their mouse, finger, or an inking tool, and whose ink resembles pencil graphite.</descrip></descripGrp><ntig><termGrp><term id="2432493">pencil</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2436952">ପେନସିଲ୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42888_2432494_2436951"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tool that allows users to use ink to draw using their mouse, finger, or an inking tool, and whose ink resembles traditional pen ink.</descrip></descripGrp><ntig><termGrp><term id="2432494">pen</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2436951">ପେନ୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42889_2432495_2436955"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A button that is activated when clicked once, and when clicked a second time, opens a menu that allows the user to modify the mode of the selected tool.</descrip></descripGrp><ntig><termGrp><term id="2432495">secondary action button</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2436955">ଦ୍ଵିତୀୟ କ୍ରିୟା ବଟନ୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42890_2432497_2436956"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A menu that is opened via a secondary action button and that gives users one or more options for changing the mode of the selected tool.</descrip></descripGrp><ntig><termGrp><term id="2432497">secondary action menu</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2436956">ଦ୍ଵିତୀୟ କ୍ରିୟା ମେନୁ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42891_2432499_2436954"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An in-ribbon container that holds a collection of buttons and where the user can add additional buttons, reorganize buttons, and scroll through them when they are not all visible within the container.</descrip></descripGrp><ntig><termGrp><term id="2432499">scrollable button group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2436954">ସ୍କ୍ରୋଲ୍ ହୋଇପାରୁଥିବା ବଟନ୍ ଗୋଷ୍ଠୀ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42895_2433212_2436953"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The contextual ribbon tab that appears when users select a picture.​</descrip></descripGrp><ntig><termGrp><term id="2433212">Picture</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2436953">ଛବି</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42900_2433217_2436207"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Literally, "without stroke"; describes any typeface in which the characters have no serifs (the short lines or ornaments at the upper and lower ends of the strokes.) A sans serif typeface usually possesses a more straightforward, geometric appearance than a typeface with serifs and typically lacks the contrast between thick and thin strokes found in serif faces.</descrip></descripGrp><ntig><termGrp><term id="2433217">sans serif</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2436207">sans serif</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Adjectiv