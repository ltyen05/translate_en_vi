xchanging structured data in a format that is independent of operating systems and applications. XML is a World Wide Web Consortium (W3C) specification and is a subset of Standard Generalized Markup Language (SGML).</descrip></descripGrp><ntig><termGrp><term id="1208">Extensible Markup Language</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1259158">XML</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14842_1209_1259158"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A markup language for describing and exchanging structured data in a format that is independent of operating systems and applications. XML is a World Wide Web Consortium (W3C) specification and is a subset of Standard Generalized Markup Language (SGML).</descrip></descripGrp><ntig><termGrp><term id="1209">XML</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1259158">XML</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14843_318774_485735"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The $ character.</descrip></descripGrp><ntig><termGrp><term id="318774">dollar sign</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="485735">ଡଲାର୍ ଚିହ୍ନ</term