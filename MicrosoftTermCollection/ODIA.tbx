ip type="definition">The Date and time Excel function that converts a serial number to a day of the month.</descrip></descripGrp><ntig><termGrp><term id="2955573">DAY</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2976024">DAY</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52362_2955574_2976025"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Date and time Excel function that returns the number of days between two dates.</descrip></descripGrp><ntig><termGrp><term id="2955574">DAYS</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2976025">DAYS</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52363_2955575_2976026"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Date and time Excel function that calculates the number of days between two dates based on a 360-day year.</descrip></descripGrp><ntig><termGrp><term id="2955575">DAYS360</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2976026">DAYS360</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termN