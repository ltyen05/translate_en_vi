><term id="1426200">ଆରମ୍ଭ ତାରିଖ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16907_627847_1426200"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The date when a project or task is scheduled to begin.</descrip></descripGrp><ntig><termGrp><term id="627847">start date</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1426200">ଆରମ୍ଭ ତାରିଖ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16924_629472_1957470"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The name automatically assigned to an object by a program or process when the user does not specify an alternative.</descrip></descripGrp><ntig><termGrp><term id="629472">default name</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1957470">ଡିଫଲ୍ଟ୍ ନାମ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16927_629486_1957475"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user-defined description of a particular device.</descrip></descripGrp><ntig><termGrp><term id="629486">device name</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1957475">ଡିଭାଇସ୍ ନାମ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1695_397155_1957511"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A hidden item that contains information about an event sink, information about what events will trigger the event sink, and options that tell when or under what conditions the event sink will be triggered. The event registration item is created in the same folder that is being monitored for events.</descrip></descripGrp><ntig><termGrp><term id="397155">event registration item</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1957511">ଘଟଣା ପଞ୍ଜିକରଣ ଆଇଟମ୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16957_629941_1957448"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A dialog box in which a user confirms that he or she wants a specified action to occur, usually by clicking OK.</descrip></descripGrp><ntig><termGrp><term id="629941">confirmation dialog box</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1957448">ସୁନିଶ୍ଚିତକରଣ ସଂଳାପ ବାକ୍ସ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16960_629944_1957498"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A three-digit string of numbers, such as 5.1.2., that indicates the status of an attempt to deliver an email message.</descrip></descripGrp><ntig><termGrp><term id="629944">DSN code</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1957498">DSN କୋଡ୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16962_629946_1957501"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The value that is applied to a specific DWORD.</descrip></descripGrp><ntig><termGrp><term id="629946">DWORD value</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1957501">DWORD ମୂଲ୍ୟ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16963_629993_1951427"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A unique view for displaying appointments, tasks, and other information in the form of a Web page. You can customize the Outlook Today page for your organization, or for individuals or groups within your organization, to display the information most relevant to them.</descrip></descripGrp><ntig><termGrp><term id="629993">Outlook Today</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1951427">Outlook ଆଜି</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="170_502935_1258981"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A part of the user interface dedicated to a particular purpose, such as "instant message area."</descrip></descripGrp><ntig><termGrp><term id="502935">area</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1258981">କ୍ଷେତ୍ର</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1700_122674_1426139"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of viewing and updating the actual progress of tasks so that you can see progress across time, evaluate slippage of tasks, compare scheduled or baseline data to actual data, and check the completion percentage of tasks and your project.</descrip></descripGrp><ntig><termGrp><term id="122674">tracking</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1426139">ମାର୍ଗକରଣ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1701_130254_1802625"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The programming language designed at Microsoft that was derived from BASIC and that was designed to enable the easy development of visual applications and components in Windows.</descrip></descripGrp><ntig><termGrp><term id="130254">Visual Basic</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1802625">Visual Basic</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1701_370712_1802625"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The programming language designed at Microsoft that was derived from BASIC and that was designed to enable the easy development of visual applications and components in Windows.</descrip></descripGrp><ntig><termGrp><term id="370712">VB</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1802625">Visual Basic</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1703_142906_1258995"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A line added to a chart that makes it easier to view and evaluate data.</descrip></descripGrp><ntig><termGrp><term id="142906">gridline</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1258995">ଗ୍ରିଡଲାଇନ୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1706_3257_483984"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A program that invokes other programs in order to accomplish its tasks.</descrip></descripGrp><ntig><termGrp><term id="3257">script</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="483984">ସ୍କ୍ରିପ୍ଟ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1707_81769_484566"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The action of pressing and releasing one of the mouse buttons.</descrip></descripGrp><ntig><termGrp><term id="81769">mouse click</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="484566">ମାଉସ୍ କ୍ଲିକ୍</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17153_639951_2599565"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method of authentication by which the client in a client-server communication proves its identity to the server.</descrip></descripGrp><ntig><termGrp><term id="639951">client authentication</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2599565">କ୍ଲାଏଣ୍ଟ୍ ପ୍ରାମାଣିକରଣ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1716_84183_1259826"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A computer hardware component providing access to a network.</descrip></descripGrp><ntig><termGrp><term id="84183">network adapter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1259826">ନେଟ୍ଓ୍ୱାର୍କ ଆଡ଼ାପ୍ଟର</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17167_639982_1346404"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To eliminate an entity by removing it from a list, database, or other item, or by uninstalling it.</descrip></descripGrp><ntig><termGrp><term id="639982">remove</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1346404">ଅପସାରଣ କରିବା</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17184_640166_1259180"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To set an entity, such as a feature, configuration, or object, back to its defaults.</descrip></descripGrp><ntig><termGrp><term id="640166">reset</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1259180">ପୁନଃସ୍ଥାପନ କରିବା</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1730_36286_1881067"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of search conditions that is used to find data. Comparison criteria can be a series of characters that you want to match, such as "Northwind Traders," or an expression, such as "&gt;300."</descrip></descripGrp><ntig><termGrp><term id="36286">comparison criteria</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1881067">ତୁଳନାତ୍ମକ ବିଶେଷତା</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17310_640432_1259181"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To locate text or a specific item on a Web page or in a document.</descrip></descripGrp><ntig><termGrp><term id="640432">find</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1259181">ଖୋଜିବା</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17311_640433_1976771"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The navigation button used to complete and close a wizard.</descrip></descripGrp><ntig><termGrp><term id="640433">Finish</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1976771">ସମାପ୍ତ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17312_640434_3144769"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A navigation button used to return to a page from which the user has navigated away via the web browser Back command.</descrip></descripGrp><ntig><termGrp><term id="640434">Forward</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="3144769">ଅଗ୍ରଗାମୀ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17321_640444_2768023"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user who does not have a user account or who does not provide a password.</descrip></descripGrp><ntig><termGrp><term id="640444">guest</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2768023">ଅତିଥି</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1735_41913_1259827"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To remove part of a document, usually placing it temporarily in memory so that the cut portion can be inserted (pasted) elsewhere.</descrip></descripGrp><ntig><termGrp><term id="41913">cut</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1259827">ଛେଦନ କରନ୍ତୁ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17387_641212_1426202"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A container with a set of properties that can be configured to control the organization and format of Web Parts on a Web Part Page.</descrip></descripGrp><ntig><termGrp><term id="641212">Web Part zone</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1426202">ଓ୍ୱେବ୍ ଅଂଶ କ୍ଷେତ୍ର</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1739_149687_1258996"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A formula that checks whether a given value is valid for a particular field.</descrip></descripGrp><ntig><termGrp><term id="149687">validation formula</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1258996">ବୈଧିକରଣ ସୂତ୍ର</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="174_138672_2724931"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A hierarchical organization of media clips that users can create, import, add additional clips collections to, move, or copy clips from one collection into it.</descrip></descripGrp><ntig><termGrp><term id="138672">clip collection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2724931">କ୍ଲିପ୍ ସଂଗ୍ରହ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1740_231978_1881261"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">For automatic subtotals and worksheet outlines, all rows or columns that summarize detail data. Summary data usually is adjacent to and below the detail data.</descrip></descripGrp><ntig><termGrp><term id="231978">summary data</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1881261">ସାରାଂଶ ଡାଟା</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1741_128742_2590004"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Teleconferencing in which video images are transmitted among the various geographically separated participants in a meeting.</descrip></descripGrp><ntig><termGrp><term id="128742">video conferencing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="2590004">ଭିଡିଓ କନଫରେନ୍ସିଂ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17419_645117_1426203"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of reusable settings that describes the shared attributes and behaviors of a list item, a document, or a folder.</descrip></descripGrp><ntig><termGrp><term id="645117">content type</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1426203">ବିଷୟ ପ୍ରକାର</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17422_645120_1881372"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Stored on a server or client computer that is configured to control access to content by using information rights management (IRM) technology.</descrip></descripGrp><ntig><termGrp><term id="645120">rights-managed</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="1881372">ପରିଚାଳିତ ଅଧିକାର</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1744_27670_484156"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Descriptive text that is associated with a piece of content, such as an image.</descrip></descripGrp><ntig><termGrp><term id="27670">caption</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="484156">କ୍ୟାପସନ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1744_592579_484156"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Descriptive text that is associated with a piece of content, such as an image.</descrip></descripGrp><ntig><termGrp><term id="592579">caption text</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="or-IN"><ntig><termGrp><term id="484156">କ୍ୟାପସନ</term><termNote type="geographicalUsage">IND</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17445_2285004_2290675"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A statistical type of chart that uses boxes to indicate statistical distribution and easily identify outlier points. There are five values: upper quartile, lower quartile, High Box, Low Box, and Median.</descrip></descripGrp><ntig><termGrp><term id="2285004">box and whisker chart</term><termNote type="partOfSpeech">Noun</termNote>