calGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3644_116003_1864163"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A statistical measure of the amount by which a set of values differs from the arithmetical mean, equal to the square root of the mean of the differences' squares.</descrip></descripGrp><ntig><termGrp><term id="116003">standard deviation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1864163">сярэдняе квадратычнае адхіленне</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3655_85228_1864138"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A hyphen that is used to prevent a hyphenated word, number, or phrase from breaking if it falls at the end of a line.</descrip></descripGrp><ntig><termGrp><term id="85228">nonbreaking hyphen</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1864138">неразрыўны злучок</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3657_16207_2772549"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A characteristic of an object.</descrip></descripGrp><ntig><termGrp><term id="16207">attribute</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2772549">атрыбут</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3662_77222_1573861"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that makes the screen more readable by people who have low vision by creating a separate window that displays a magnified portion of the screen.</descrip></descripGrp><ntig><termGrp><term id="77222">Magnifier</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1573861">Лупа</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36774_2070563_2080556"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A subset of settings and features that can be assigned to one of four slots in action center for quick, one-tap access. In addition, they can provide useful, actionable, or critical info regarding the setting or feature.</descrip></descripGrp><ntig><termGrp><term id="2070563">quick action</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2080556">хуткае дзеянне</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36775_2070564_2080580"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An app that is built using the Windows universal app platform. Developers can create a Windows universal app that runs on all Windows-based device types, or they can choose to limit an app to specific devices.</descrip></descripGrp><ntig><termGrp><term id="2070564">universal app</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2080580">універсальная праграма</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36775_2247950_2080580"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An app that is built using the Windows universal app platform. Developers can create a Windows universal app that runs on all Windows-based device types, or they can choose to limit an app to specific devices.</descrip></descripGrp><ntig><termGrp><term id="2247950">Windows universal app</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2080580">універсальная праграма</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36776_2070565_2080534"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To provide Wi-Fi credentials to Outlook.com contacts, Skype contacts, and Facebook friends.</descrip></descripGrp><ntig><termGrp><term id="2070565">exchange</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2080534">абмяняцца</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36778_2071066_2080539"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The phone's volume mode when in a call.</descrip></descripGrp><ntig><termGrp><term id="2071066">In-Call</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2080539">Падчас размовы</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36779_2071067_2080530"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The use of data connection in a roaming area. Generally making phone calls or using your data connection when the phone is roaming is more expensive, and the user will be charged additional fees for voice roaming calls.</descrip></descripGrp><ntig><termGrp><term id="2071067">data roaming</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2080530">перадача дадзеных у роўмінгу</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36780_2071068_2080585"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The connection on your phone that allows you to make phone calls.</descrip></descripGrp><ntig><termGrp><term id="2071068">voice connection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2080585">галасавая сувязь</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36781_2071069_2072389"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A phone call made in a roaming area. Generally making phone calls or using your data connection when the phone is roaming is more expensive, and the user will be charged additional fees for voice roaming calls.</descrip></descripGrp><ntig><termGrp><term id="2071069">voice roaming</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2072389">галасавы роўмінг</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36782_2238946_2080532"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The setting to minimize distractions while driving.</descrip></descripGrp><ntig><termGrp><term id="2238946">Driving mode</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2080532">Аўтамабільны рэжым</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termN