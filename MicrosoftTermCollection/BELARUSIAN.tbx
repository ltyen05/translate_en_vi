Note><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46355_2612189_2612746"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The most important person in a video that you create using the video remix feature in Microsoft Photos. When ​the user selects a person as the "star," then photos and video clip​s of that person will be featured more prominently than other content in the video.​</descrip></descripGrp><ntig><termGrp><term id="2612189">star</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2612746">зорка</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46356_2612191_2615039"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The pre-release version of Microsoft People app.</descrip></descripGrp><ntig><termGrp><term id="2612191">People Preview</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2615039">Перадфінальная версія «Людзі Microsoft»</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46356_2612191_2615040"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The pre-release version of Microsoft People app.</descrip></descripGrp><ntig><termGrp><term id="2612191">People Preview</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2615040">Перадфінальная версія «Людзі»</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46356_2612764_2615039"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The pre-release version of Microsoft People app.</descrip></descripGrp><ntig><termGrp><term id="2612764">Microsoft People Preview</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2615039">Перадфінальная версія «Людзі Microsoft»</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46356_2612764_2615040"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The pre-release version of Microsoft People app.</descrip></descripGrp><ntig><termGrp><term id="2612764">Microsoft People Preview</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2615040">Перадфінальная версія «Людзі»</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46375_2612854_2616470"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A date when Microsoft will no longer provide updates to a feature release of a product, such that a customer needs to upgrade to a new feature release to continue receiving support from Microsoft.</descrip></descripGrp><ntig><termGrp><term id="2612854">end of service</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2616470">заканчэнне абслугоўвання</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46375_2878237_2616470"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A date when Microsoft will no longer provide updates to a feature release of a product, such that a customer needs to upgrade to a new feature release to continue receiving support from Microsoft.</descrip></descripGrp><ntig><termGrp><term id="2878237">EOL</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2616470">заканчэнне абслугоўвання</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46382_2613039_2616473"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The wizard that helps users to change their Office 365 plan in the Office 365 Admin center.</descrip></descripGrp><ntig><termGrp><term id="2613039">Switch plans wizard</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2616473">Майстар пераключэння планаў</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4639_108282_1574073"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To move a document or other data in a window in order to view a particular portion of the document. Scrolling may be controlled by the mouse, arrow keys, or other keys on the keyboard, eventually with one or more fingers.</descrip></descripGrp><ntig><termGrp><term id="108282">scroll</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1574073">прагартаць</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46410_2613241_2805543"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A team in Microsoft Teams that is available for all users in an organization to join.</descrip></descripGrp><ntig><termGrp><term id="2613241">public team</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2805543">агульнадаступная каманда</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46428_2613586_2616516"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The software platform composed of services and plug-ins that provides an authoritative source of the knowledge that employees need to do their job.</descrip></descripGrp><ntig><termGrp><term id="2613586">Employee Self-Service</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2616516">Employee Self-Service</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46429_2613862_2618530"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Excel function that returns data stored in a PivotTable.</descrip></descripGrp><ntig><termGrp><term id="2613862">GETPIVOTDATA</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2618530">GETPIVOTDATA</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46431_2613866_2618531"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The support plan that covers all Microsoft products, offers 24/7 support for urgent technical issues, access to a team of support engineers for guidance, and an online portal where users can control their support experience.</descrip></descripGrp><ntig><termGrp><term id="2613866">Unified Support</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2618531">Microsoft Unified Support</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46431_2613866_2618535"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The support plan that covers all Microsoft products, offers 24/7 support for urgent technical issues, access to a team of support engineers for guidance, and an online portal where users can control their support experience.</descrip></descripGrp><ntig><termGrp><term id="2613866">Unified Support</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2618535">Unified Support</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46431_2613868_2618531"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The support plan that covers all Microsoft products, offers 24/7 support for urgent technical issues, access to a team of support engineers for guidance, and an online portal where users can control their support experience.</descrip></descripGrp><ntig><termGrp><term id="2613868">Microsoft Unified Support</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2618531">Microsoft Unified Support</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46431_2613868_2618535"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The support plan that covers all Microsoft products, offers 24/7 support for urgent technical issues, access to a team of support engineers for guidance, and an online portal where users can control their support experience.</descrip></descripGrp><ntig><termGrp><term id="2613868">Microsoft Unified Support</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2618535">Unified Support</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46432_2613867_2618532"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Unified Support add-on service that provides customers with direct access to the Office engineering team on important business events.</descrip></descripGrp><ntig><termGrp><term id="2613867">Office 365 Engineering Direct</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2618532">Office 365 Engineering Direct</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46432_3156420_2618532"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Unified Support add-on service that provides customers with direct access to the Office engineering team on important business events.</descrip></descripGrp><ntig><termGrp><term id="3156420">Engineering Direct</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2618532">Office 365 Engineering Direct</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46433_2613869_2618533"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The portal that provides tools to track, implement, and manage auditing controls to help organizations reach compliance with security or data protection industry standards when measured against Microsoft cloud services.</descrip></descripGrp><ntig><termGrp><term id="2613869">Service Trust Portal</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2618533">Service Trust Portal</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46433_2613869_2618534"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The portal that provides tools to track, implement, and manage auditing controls to help organizations reach compliance with security or data protection industry standards when measured against Microsoft cloud services.</descrip></descripGrp><ntig><termGrp><term id="2613869">Service Trust Portal</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2618534">STP</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46433_2613870_2618533"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The portal that provides tools to track, implement, and manage auditing controls to help organizations reach compliance with security or data protection industry standards when measured against Microsoft cloud services.</descrip></descripGrp><ntig><termGrp><term id="2613870">STP</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2618533">Service Trust Portal</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46433_2613870_2618534"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The portal that provides tools to track, implement, and manage auditing controls to help organizations reach compliance with security or data protection industry standards when measured against Microsoft cloud services.</descrip></descripGrp><ntig><termGrp><term id="2613870">STP</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2618534">STP</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4645_39469_1788415"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Windows program that collects and displays for users the system-level features of the computer, including hardware and software setup and configuration.</descrip></descripGrp><ntig><termGrp><term id="39469">Control Panel</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1788415">панэль кіравання</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4646_184693_2718865"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The status that a user selects to indicate to others that he/she does not want to be interrupted.</descrip></descripGrp><ntig><termGrp><term id="184693">Do Not Disturb</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2718865">Не турбаваць</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4646_2729705_2718865"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The status that a user selects to indicate to others that he/she does not want to be interrupted.</descrip></descripGrp><ntig><termGrp><term id="2729705">Do not disturb</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2718865">Не турбаваць</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46478_2615085_2618029"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The security feature that protects your device by providing startup and runtime protections that the operating system can validate and report on.</descrip></descripGrp><ntig><termGrp><term id="2615085">System Guard</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2618029">Ахова сістэмы</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46479_2615093_2618032"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The remote attestation service that checks the health of Windows 10-based devices to allow or deny access to networks, apps, or services, based on whether devices prove to be healthy.</descrip></descripGrp><ntig><termGrp><term id="2615093">Windows Health Attestation Service</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2618032">Сэрвіс атэстацыі стану Windows</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46481_2615123_2618027"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The area in Windows Defender Security Center that helps customers keep their devices refreshed and up to date with the latest version of Windows 10. Device health advisor monitors the device and provides information and recommendations in a Health report to address common issues with storage capacity, device drivers, battery life, or Windows Update.</descrip></descripGrp><ntig><termGrp><term id="2615123">Device performance &amp; health</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2618027">Прадукцыйнасць і стан прылады</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4649_50166_1864110"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A typographical unit of measure that is equal in width to the point size of a particular font. For many fonts, this is equal to the width of a capital M, from which the em space takes its name.</descrip></descripGrp><ntig><termGrp><term id="50166">em space</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1864110">шырокі прабел</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46505_2618212_2619708"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tenant that consists of a central location and one or more satellite geo locations.</descrip></descripGrp><ntig><termGrp><term id="2618212">Multi-Geo tenant</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2619708">кліент з некалькімі геаграфічнымі зонамі</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46509_2618259_2792438"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of standard procedures and strategies that are considered to be suitable for a particular activity, industry, or job.</descrip></descripGrp><ntig><termGrp><term id="2618259">playbook</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2792438">звод правіл</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46511_2618261_2619707"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The single web portal where Microsoft 365 admins can manage user accounts and settings for each of the Microsoft 365 services they subscribe to.</descrip></descripGrp><ntig><termGrp><term id="2618261">Microsoft 365 admin center</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2619707">Цэнтр адміністравання Microsoft 365</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></