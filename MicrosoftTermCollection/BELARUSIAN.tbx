0245">org-wide</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2752915">у цэлай арганізацыі</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48609_2754104_2757534"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Phone System add-on feature that allows organizations to create a customized call with the ability to create a customized greeting, multiple call queues, as well the ability to automatically put calls on hold, search for the next available call agent, and play music while callers are in their queues.</descrip></descripGrp><ntig><termGrp><term id="2754104">Cloud call queue</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2757534">чарга выклікаў у воблаку</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48621_2751548_2752912"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A template for a sensitive information type used for classifying documents for transport rules, the prevention of oversharing information, and the creation of Data Loss Protection policies.</descrip></descripGrp><ntig><termGrp><term id="2751548">document fingerprint</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2752912">лі