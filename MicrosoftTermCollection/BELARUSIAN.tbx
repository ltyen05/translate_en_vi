Note type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2182155">клавіша табуляцыі</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36887_2099902_2189314"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Street level imagery that enables users to experience Bing Maps from the street level. Streetside supplements maps, directions and local search.</descrip></descripGrp><ntig><termGrp><term id="2099902">Streetside</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2189314">Streetside</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36900_2101411_2106269"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Outlook email filter that moves low priority messages out of the Inbox to the Clutter folder based on individual user preferences.</descrip></descripGrp><ntig><termGrp><term id="2101411">Clutter</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2106269">Другарадныя</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36910_2101809_2124465"><langSet xml:lang=