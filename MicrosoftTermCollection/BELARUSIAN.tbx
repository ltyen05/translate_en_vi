><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1030_82944_1573899"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to something for which an answer is not available or appropriate.</descrip></descripGrp><ntig><termGrp><term id="82944">n/a</term><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1573899">не прымяніма</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1030_82945_1573899"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to something for which an answer is not available or appropriate.</descrip></descripGrp><ntig><termGrp><term id="82945">N/A</term><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1573899">не прымяніма</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1030_82946_1573899"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to something for which an answer is not available or appropriate.</descrip></descripGrp><ntig><termGrp><term id="82946">not applicable</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1573899">не прымяніма</term><termNote type="geographicalUsage">BLR</termNote><term