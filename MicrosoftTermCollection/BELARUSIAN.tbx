07_1791908"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A piece of handheld equipment such as a portable music or video player, PDA (personal digital assistant), mobile phone, tablet or warehouse device that works on its own but can also be connected to a computer.</descrip></descripGrp><ntig><termGrp><term id="1527307">device</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1791908">мабiльная прылада</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12345_2419401_1791908"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A piece of handheld equipment such as a portable music or video player, PDA (personal digital assistant), mobile phone, tablet or warehouse device that works on its own but can also be connected to a computer.</descrip></descripGrp><ntig><termGrp><term id="2419401">mobile</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1791908">мабiльная прылада</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12345_763955_1791908"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A piece of handheld equipment such as a portable music or video player, PDA (personal digital assistant), mobile phone, tablet or warehouse device that works on its own but can also be connected to a computer.</descrip></descripGrp><ntig><termGrp><term id="763955">handheld device</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1791908">мабiльная прылада</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12345_81161_1791908"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A piece of handheld equipment such as a portable music or video player, PDA (personal digital assistant), mobile phone, tablet or warehouse device that works on its own but can also be connected to a computer.</descrip></descripGrp><ntig><termGrp><term id="81161">mobile device</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1791908">мабiльная прылада</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12359_235413_1573549"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A modular unit of code that acts as part of a larger system or structure.</descrip></descripGrp><ntig><termGrp><term id="235413">component</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1573549">кампанент</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1236_42543_1864104"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file consisting of data in the form of text, numbers, or graphics, as distinct from a program file of commands and instructions.</descrip></descripGrp><ntig><termGrp><term id="42543">data file</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1864104">файл дадзеных</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12362_464497_2296711"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">User's perception about the utility usability and desirability of a product as they integrate it into their lives and their family system. The user experience will be the differentiator that drives adoption and use of hardware software and services.</descrip></descripGrp><ntig><termGrp><term id="464497">user experience</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296711">уражанні ад выкарыстання</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12363_121418_1864175"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In an online forum, such as a newsgroup, a series of messages or articles in which replies to a message are nested directly under it instead of arranged in chronological or alphabetical order.</descrip></descripGrp><ntig><termGrp><term id="121418">threaded discussion</te