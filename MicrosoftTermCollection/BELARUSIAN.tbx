termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1864749">Сувязь</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21008_763874_1864750"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout type that includes layouts designed to show how parts relate to a whole.</descrip></descripGrp><ntig><termGrp><term id="763874">Matrix</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1864750">Матрыца</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21009_763875_1864751"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout type that includes layouts designed to show proportional relationships with the largest component on the top or bottom.</descrip></descripGrp><ntig><termGrp><term id="763875">Pyramid</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1864751">Піраміда</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21012_1135481_1696977"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The descriptive information about a user that is shown to other users. This editable information is separate from the registration information they provide to establish their Windows Live account. This separation allows users to disclose or conceal personal information as they choose.</descrip></descripGrp><ntig><termGrp><term id="1135481">Windows Live Profile</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1696977">профіль</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21012_763878_1696977"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The descriptive information about a user that is shown to other users. This editable information is separate from the registration information they provide to establish their Windows Live account. This separation allows users to disclose or conceal personal information as they choose.</descrip></descripGrp><ntig><termGrp><term id="763878">profile</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1696977">профіль</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21022_1216839_2296562"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The user role that is assigned to a user account, which determines the options that are visible to that user and the tasks that the user can perform in the management interface for Exchange 