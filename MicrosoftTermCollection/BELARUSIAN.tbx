_1864924"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature of Microsoft Office that allows the user to view and edit image document formats like .TIF, which is the format most traditionally used in fax transmissions (IOs, T&amp;Cs, etc.).</descrip></descripGrp><ntig><termGrp><term id="1177410">MODI</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1864924">апрацоўка выяў у дакументах Microsoft Office</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25447_1606736_1865023"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A free online service that enables Office users to share presentations with people who view them on the web.</descrip></descripGrp><ntig><termGrp><term id="1606736">Office Presentation Service</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1865023">Служба прэзентацый Office</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25451_1176752_1864926"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A converter that supports dynamic viewing of PowerPoint presentations (with animation) in a Web environment.</descrip></descripGrp><ntig><termGrp><term id="1176752">PowerPoint render</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><