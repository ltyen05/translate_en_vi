 id="17795_650155_1744070"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The code that credit card companies use to authorize credit card charges. For example, American Express uses a four-digit number on the front of the credit card, and Visa, MasterCard, and Discover use a three-digit number on the back.</descrip></descripGrp><ntig><termGrp><term id="650155">card validation code</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1744070">CVV</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17795_650155_2011665"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The code that credit card companies use to authorize credit card charges. For example, American Express uses a four-digit number on the front of the credit card, and Visa, MasterCard, and Discover use a three-digit number on the back.</descrip></descripGrp><ntig><termGrp><term id="650155">card validation code</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2011665">код бяспекі MasterCard</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17796_650156_1864650"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A chart axis that represents the category for each data point. It displays arbitrary text values like Qtr1, Qtr2, and Qtr3; it cannot display scaled numerical values.</descrip></descripGrp><ntig><termGrp><term id="650156">category axis</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1864650">вось катэгорый</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17797_650157_1864651"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A field that is displayed in the category area of PivotChart view. Items in a category field appear as labels on the category axis.</descrip></descripGrp><ntig><termGrp><term id="650157">category field</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1864651">поле катэгорый</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17800_650160_1864652"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A way to see if a certificate used to sign a message is valid. Outlook can check the status of the certificate from the issuing certification authority's database.</descrip></descripGrp><ntig><termGrp><term id="650160">certificate revocation checking</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1864652">праверка адклікання сертыфіката</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote>