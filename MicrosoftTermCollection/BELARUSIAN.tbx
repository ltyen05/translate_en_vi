descrip type="definition">The cloud service that enables customers to generate encryption keys on premises and send them securely to Azure-managed hardware security modules where they can be decrypted and used.</descrip></descripGrp><ntig><termGrp><term id="2468787">BYOK</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2471090">Bring Your Own Key</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43759_2468787_2471092"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The cloud service that enables customers to generate encryption keys on premises and send them securely to Azure-managed hardware security modules where they can be decrypted and used.</descrip></descripGrp><ntig><termGrp><term id="2468787">BYOK</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2471092">BYOK</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43759_2468788_2471090"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The cloud service that enables customers to generate encryption keys on premises and send them securely to Azure-managed hardware security modules where they can be decrypted and used.</descrip></descripGrp><ntig><termGrp><term id="2468788">Bring Your Own Key</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2471090">Bring Your Own Key</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43759_2468788_2471092"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The cloud service that enables customers to generate encryption keys on premises and send them securely to Azure-managed hardware security modules where they can be decrypted and used.</descrip></descripGrp><ntig><termGrp><term id="2468788">Bring Your Own Key</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2471092">BYOK</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43761_2469253_2471098"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Word print layout that allows horizontal movement between pages in a document.</descrip></descripGrp><ntig><termGrp><term id="2469253">Page-Stack navigation</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2471098">Гарызантальная навігацыя па старонках</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43762_2469812_2472826"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Sound that is spatialized or is precisely located around a listener in 3D space. Developers can use spatial sound in an application to convincingly place sounds in a 3D space all around the user. Sounds will then seem as if they are coming from real physical objects even though the user may only be using regular stereo headphones.</descrip></descripGrp><ntig><termGrp><term id="2469812">spatial sound</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2472826">аб'ёмны гук</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43768_2470183_2472827"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Technology that enables a 3D graphics processor to display the image at the moment it is rendered for more fluid and better detailed gameplay, and for reducing or eliminating lag, stutter and frame tearing.</descrip></descripGrp><ntig><termGrp><term id="2470183">variable refresh rate</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2472827">зменная частата абнаўлення</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43768_2470196_2472827"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Technology that enables a 3D graphics processor to display the image at the moment it is rendered for more fluid and better detailed gameplay, and for reducing or eliminating lag, stutter and frame tearing.</descrip></descripGrp><ntig><termGrp><term id="2470196">VRR</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2472827">зменная частата абнаўлення</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43769_2470203_2474020"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office 365 Advanced Threat Protection reporting feature that gives users interactive, personalized visual reports of the threats to their organization, provides context for attacks, and that provides actionable steps for protection.</descrip></descripGrp><ntig><termGrp><term id="2470203">Threat explorer</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2474020">Выкрывальнік пагроз</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43799_2470927_2472159"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The lightweight markup language with plain text formatting syntax designed to be converted to HTML and other formats and that is used to format readme files, write messages in online discussion forums, and create rich text using a plain text editor.</descrip></descripGrp><ntig><termGrp><term id="2470927">Markdown</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2472159">Markdown</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43800_2470929_2472160"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Word add-in that converts Markdown documents to Word format for editing and then converts the Word document back to Markdown format, using the Paragraph, Table, List, and Range objects.</descrip></descripGrp><ntig><termGrp><term id="2470929">Markdown editor</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2472160">Markdown editor</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43813_2471611_2478841"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A numerical summary of an organization's security posture based on system configurations, user behavior and other security related measurements that represents the extent to which an organization has adopted security controls in their Microsoft environment which can help offset the risk of being breached.</descrip></descripGrp><ntig><termGrp><term id="2471611">secure score</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2478841">ацэнка бяспекі</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43827_2472567_2499262"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A movie created in the Photos app, featuring a set of related pictures and videos combined with a soundtrack, transitions and other effects. This term can also be used to refer to the set of photos and videos included in the story. ​A story may be created automatically by the app, or manually by the user.</descrip></descripGrp><ntig><termGrp><term id="2472567">story</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2499262">аповед</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43879_2473454_2480462"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in Holograms app that allows the user to input text and have that text become a hologram that they can place in their space. User inputs text to make a holographic label.</descrip></descripGrp><ntig><termGrp><term id="2473454">holographic label maker</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2480462">рэдактар галаграфічных подпісаў</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43880_2473560_2480464"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The edition of Microsoft HoloLens hardware and software released for developers.</descrip></descripGrp><ntig><termGrp><term id="2473560">Microsoft HoloLens Development Edition</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2480464">Microsoft HoloLens Development Edition</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43881_2473564_2480463"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The edition of HoloLens sold for organizations. Includes the HoloLens Development Edition hardware, plus a warranty and enterprise features for added security and device management.</descrip></descripGrp><ntig><termGrp><term id="2473564">Microsoft HoloLens Commercial Suite</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2480463">Microsoft HoloLens Commercial Suite</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43905_2475911_2480467"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An action or mechanism to explicitly consent to participate in programs or offerings, typically for marketing purposes.</descrip></descripGrp><ntig><termGrp><term id="2475911">opt-in</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2480467">зго