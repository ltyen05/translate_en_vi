tOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1864934">cc:Mail</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25542_1177000_2296414"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An email program originally introduced by cc:mail, Inc., and currently produced by the Lotus Development Corporation. Lotus cc:Mail runs on multiple networking platforms and the Internet and is closely integrated with Lotus Notes collaborative software.</descrip></descripGrp><ntig><termGrp><term id="1177000">Lotus cc:Mail</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296414">Lotus cc:Mail</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25542_1177001_1864934"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An email program originally introduced by cc:mail, Inc., and currently produced by the Lotus Development Corporation. Lotus cc:Mail runs on multiple networking platforms and the Internet and is closely integrated with Lotus Notes collaborative software.</descrip></descripGrp><ntig><termGrp><term id="1177001">cc:Mail</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1864934">cc:Mail</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25542_1177001_2296414"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An email program originally introduced by cc:mail, Inc., and currently produced by the Lotus Development Corporation. Lotus cc:Mail runs on multiple networking platforms and the Internet and is closely integrated with Lotus Notes collaborative software.</descrip></descripGrp><ntig><termGrp><term id="1177001">cc:Mail</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296414">Lotus cc:Mail</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25575_1177084_2296083"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A legal doctrine that is intended to protect the confidentiality of communications between an attorney and his or her client. The underlying rationale is that by assuring confidential communications, lawyers and their clients will feel free to discuss sensitive legal matters thoroughly.</descrip></descripGrp><ntig><termGrp><term id="1177084">attorney-client privilege</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296083">адвакацкая тайна</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25576_1177085_2296044"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A function that corresponds to the "Then" part of a rule (If-Then) and is used to specify what is to be done when a condition evaluates as true.</descrip></descripGrp><ntig><termGrp><term id="1177085">action</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296044">дзеянне</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25577_1177086_2296100"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A specific word or phrase that is specified on the basis of an organization's messaging policy and used in keyword filtering (content filtering) to identify and prevent unwanted email messages from being delivered to users in the organization.</descrip></descripGrp><ntig><termGrp><term id="1177086">bad word</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296100">непрыстойнае слова</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25578_1177087_2296619"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The runspace on the datacenter (host) server, which contains the commands used by the remote user in a client-side session.</descrip></descripGrp><ntig><termGrp><term id="1177087">server-side session</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296619">серверны сеанс</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25579_1177088_2296141"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Windows PowerShell session on a user's local computer, which has the basic Windows PowerShell commands available to it.</descrip></descripGrp><ntig><termGrp><term id="1177088">client-side session</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296141">кліенцкі сеанс</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25582_1177091_2296054"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mailbox that has been accessed at least once in the last 30 days.</descrip></descripGrp><ntig><termGrp><term id="1177091">active mailbox</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296054">актыўная паштовая скрынка</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25583_1177092_2296169"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A directory, database, file, or other data repository that is typically offsite and that needs to be accessed remotely.</descrip></descripGrp><ntig><termGrp><term id="1177092">connected data source</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296169">падлучаная крыніца дадзеных</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25584_1177093_2296260"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft Identity Lifecycle Manager (ILM) 2007 management agent provided by Microsoft to connect to Outlook Live. It is an ILM component that consists of properties, rules, and rules extensions that determine how an object is processed.</descrip></descripGrp><ntig><termGrp><term id="1177093">Outlook Live Management Agent</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296260">ELMA</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25584_1177093_2296495"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft Identity Lifecycle Manager (ILM) 2007 management agent provided by Microsoft to connect to Outlook Live. It is an ILM component that consists of properties, rules, and rules extensions that determine how an object is processed.</descrip></descripGrp><ntig><termGrp><term id="1177093">Outlook Live Management Agent</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296495">Агент кіравання Outlook Live (OLMA)</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25584_1177093_2296503"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft Identity Lifecycle Manager (ILM) 2007 management agent provided by Microsoft to connect to Outlook Live. It is an ILM component that consists of properties, rules, and rules extensions that determine how an object is processed.</descrip></descripGrp><ntig><termGrp><term id="1177093">Outlook Live Management Agent</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296503">Агент кіравання Outlook Live</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25584_1177245_2296260"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft Identity Lifecycle Manager (ILM) 2007 management agent provided by Microsoft to connect to Outlook Live. It is an ILM component that consists of properties, rules, and rules extensions that determine how an object is processed.</descrip></descripGrp><ntig><termGrp><term id="1177245">OLMA</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296260">ELMA</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25584_1177245_2296495"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft Identity Lifecycle Manager (ILM) 2007 management agent provided by Microsoft to connect to Outlook Live. It is an ILM component that consists of properties, rules, and rules extensions that determine how an object is processed.</descrip></descripGrp><ntig><termGrp><term id="1177245">OLMA</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296495">Агент кіравання Outlook Live (OLMA)</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25584_1177245_2296503"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft Identity Lifecycle Manager (ILM) 2007 management agent provided by Microsoft to connect to Outlook Live. It is an ILM component that consists of properties, rules, and rules extensions that determine how an object is processed.</descrip></descripGrp><ntig><termGrp><term id="1177245">OLMA</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296503">Агент кіравання Outlook Live</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25584_1354408_2296260"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft Identity Lifecycle Manager (ILM) 2007 management agent provided by Microsoft to connect to Outlook Live. It is an ILM component that consists of properties, rules, and rules extensions that determine how an object is processed.</descrip></descripGrp><ntig><termGrp><term id="1354408">ELMA</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296260">ELMA</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25584_1354408_2296495"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft Identity Lifecycle Manager (ILM) 2007 management agent provided by Microsoft to connect to Outlook Live. It is an ILM component that consists of properties, rules, and rules extensions that determine how an object is processed.</descrip></descripGrp><ntig><termGrp><term id="1354408">ELMA</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296495">Агент кіравання Outlook Live (OLMA)</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25584_1354408_2296503"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft Identity Lifecycle Manager (ILM) 2007 management agent provided by Microsoft to connect to Outlook Live. It is an ILM component that consists of properties, rules, and rules extensions that determine how an object is processed.</descrip></descripGrp><ntig><termGrp><term id="1354408">ELMA</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296503">Агент кіравання Outlook Live</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25585_1177094_2296229"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A person who has a business need to search the mailboxes in their organization for email and other message types that contain specific keywords.</descrip></descripGrp><ntig><termGrp><term id="1177094">discovery manager</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296229">менеджар па выяўленні</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25588_1177100_2296289"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">People outside the Outlook Live organization who can be added to public groups and displayed in your organization's address book and other address lists. External contacts have email addresses outside the organization and can't sign in to your domain.</descrip></descripGrp><ntig><termGrp><term id="1177100">external contact</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296289">знешні кантакт</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25589_1177102_2296307"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The state that a Windows Live ID takes when the user account with which it is associated is deleted from Outlook Live, but the Windows Live ID for the account isn't deleted. The credentials for that Windows Live ID are still valid and recognized, but the Windows Live ID is put into a forced rename state. If someone tries to sign in using that Windows Live ID and its password, they're asked to rename the Windows Live ID. They can rename the Windows Live ID, but because the new email address can't exist in the Outlook Live domain, the Windows Live ID is no longer functional in Outlook Live.</descrip></descripGrp><ntig><termGrp><term id="1177102">forced rename state</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296307">стан прымусовага перайменавання</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25593_1177108_2296448"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Identity Lifecycle Manager (ILM) 2007 object that has been projected into the metaverse from a connector space object and is linked to at least one object in the connector space. A metaverse entry represents the aggregated view of objects from one or several connected data sources.</descrip></descripGrp><ntig><termGrp><term id="1177108">metaverse entry</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296448">элемент метасусвету</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25594_1177109_2296473"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The set of numbers found in the MX server field in the MX Record Configuration section on the Domain Settings page of the Windows Live Admin Center. The MX token value is unique for each domain. It is required to create an MX record or a CNAME record at DNS hosting services.</descrip></descripGrp><ntig><termGrp><term id="1177109">MX token</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296473">маркер MX</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25595_1177111_2296502"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The address by which a Exchange Server recipient object is recognized in a foreign messaging system. In Outlook Live, proxy addresses let people receive email that is sent to different email addresses.</descrip></descripGrp><ntig><termGrp><term id="1177111">proxy address</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296502">іншы адрас электроннай пошты</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25595_1177111_2296556"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The address by which a Exchange Server recipient object is recognized in a foreign messaging system. In Outlook Live, proxy addresses let people receive email that is sent to different email addresses.</descrip></descripGrp><ntig><termGrp><term id="1177111">proxy address</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296556">проксі-адрас</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25595_1218373_2296502"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The address by which a Exchange Server recipient object is recognized in a foreign messaging system. In Outlook Live, proxy addresses let people receive email that is sent to different email addresses.</descrip></descripGrp><ntig><termGrp><term id="1218373">other e-mail address</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296502">іншы адрас электроннай пошты</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25595_1218373_2296556"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The address by which a Exchange Server recipient object is recognized in a foreign messaging system. In Outlook Live, proxy addresses let people receive email that is sent to different email addresses.</descrip></descripGrp><ntig><termGrp><term id="1218373">other e-mail address</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296556">проксі-адрас</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25597_1177114_2296573"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A specially-configured domain that defines settings for mail flow based on the destination domain of each email message. Administrators can configure specific settings for a specific destination domain, or configure default settings for all destination domains. In this way, they can control the types of messages that are sent to a domain. They can also apply message format policies and acceptable character sets for messages that are sent from users in their organization to the remote domain.</descrip></descripGrp><ntig><termGrp><term id="1177114">remote domain</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296573">аддалены дамен</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25599_1177116_2296626"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Simple Mail Transfer Protocol (SMTP) address space or domain suffix that is shared by two different messaging systems. For example, you may have to share the SMTP address space between Microsoft Exchange and a third-party email system, or between Exchange environments that are configured in different Active Directory forests. In these scenarios, users in each email system have the same domain suffix as part of their email addresses.</descrip></descripGrp><ntig><termGrp><term id="1177116">shared address space</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296626">агульная адрасная прастора</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25599_1177116_2296639"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Simple Mail Transfer Protocol (SMTP) address space or domain suffix that is shared by two different messaging systems. For example, you may have to share the SMTP address space between Microsoft Exchange and a third-party email system, or between Exchange environments that are configured in different Active Directory forests. In these scenarios, users in each email system have the same domain suffix as part of their email addresses.</descrip></descripGrp><ntig><termGrp><term id="1177116">shared address space</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296639">падзелены дамен</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25599_1177117_2296626"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Simple Mail Transfer Protocol (SMTP) address space or domain suffix that is shared by two different messaging systems. For example, you may have to share the SMTP address space between Microsoft Exchange and a third-party email system, or between Exchange environments that are configured in different Active Directory forests. In these scenarios, users in each email system have the same domain suffix as part of their email addresses.</descrip></descripGrp><ntig><termGrp><term id="1177117">split domain</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296626">агульная адрасная прастора</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25599_1177117_2296639"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Simple Mail Transfer Protocol (SMTP) address space or domain suffix that is shared by two different messaging systems. For example, you may have to share the SMTP address space between Microsoft Exchange and a third-party email system, or between Exchange environments that are configured in different Active Directory forests. In these scenarios, users in each email system have the same domain suffix as part of their email addresses.</descrip></descripGrp><ntig><termGrp><term id="1177117">split domain</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296639">падзелены дамен</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25609_1177142_1864936"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A specialized activation option available for approved Microsoft Volume Licensing customers that enables customers to use public key infrastructure (PKI) and digital certificates (or “tokens,” typically stored on smart cards) to activate Windows Vista Enterprise and Windows Server 2008 SP2 locally without contacting either customer-hosted KMS or the Microsoft-hosted activation service using MAK.</descrip></descripGrp><ntig><termGrp><term id="1177142">token-based activation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1864936">актывацыя на аснове маркёраў</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25611_1177146_2671424"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A physical card on which a product key is printed.</descrip></descripGrp><ntig><termGrp><term id="1177146">product key card</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2671424">PKC</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25611_2667272_2671424"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A physical card on which a product key is printed.</descrip></descripGrp><ntig><termGrp><term id="2667272">PKC</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2671424">PKC</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2564_11046_1769210"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In operating systems, the process of reserving memory for use by a program.</descrip></descripGrp><ntig><termGrp><term id="11046">allocation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1769210">вылучэнне памяці</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2564_1593445_1769210"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In operating systems, the process of reserving memory for use by a program.</descrip></descripGrp><ntig><termGrp><term id="1593445">storage allocation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1769210">вылучэнне памяці</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2564_693442_1769210"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In operating systems, the process of reserving memory for use by a program.</descrip></descripGrp><ntig><termGrp><term id="693442">memory allocation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1769210">вылучэнне памяці</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25674_1177476_1864937"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A gallery to which users can add reusable content to be displayed in Quick Parts and the Building Blocks Organizer.</descrip></descripGrp><ntig><termGrp><term id="1177476">Quick Parts gallery</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1864937">Галерэя экспрэс-частак</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25683_1177653_2296236"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A service that runs Domain Name System (DNS) servers. Most, but not all, domain name registrars include DNS hosting service with registration.</descrip></descripGrp><ntig><termGrp><term id="1177653">DNS hosting service</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296236">служба размяшчэння DNS</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25695_1179897_1806391"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An online process that confirms whether installed software was properly activated.</descrip></descripGrp><ntig><termGrp><term id="1179897">validation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1806391">праверка</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25738_1231857_1864943"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A format for user assistance content that presents simple steps on a given topic that enable a user to begin using a feature quickly.</descrip></descripGrp><ntig><termGrp><term id="1231857">Quick start</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1864943">Кароткая інструкцыя</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25739_1186759_2296067"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A search query syntax that helps produce more precise search results by using targeted queries that search specific properties in a message type. AQS defines certain keywords which can be used to refine the search query, such as specifying boolean operations on searched terms (AND, OR, NOT) as well as to specify further filters based on file metadata or file type. It can also be used to limit results from specific information stores like regular files, offline files cache, or email stores.</descrip></descripGrp><ntig><termGrp><term id="1186759">Advanced Query Syntax</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296067">Пашыраны сінтаксіс запытаў</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25739_1186759_2296079"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A search query syntax that helps produce more precise search results by using targeted queries that search specific properties in a message type. AQS defines certain keywords which can be used to refine the search query, such as specifying boolean operations on searched terms (AND, OR, NOT) as well as to specify further filters based on file metadata or file type. It can also be used to limit results from specific information stores like regular files, offline files cache, or email stores.</descrip></descripGrp><ntig><termGrp><term id="1186759">Advanced Query Syntax</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296079">AQS</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25739_1230149_2296067"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A search query syntax that helps produce more precise search results by using targeted queries that search specific properties in a message type. AQS defines certain keywords which can be used to refine the search query, such as specifying boolean operations on searched terms (AND, OR, NOT) as well as to specify further filters based on file metadata or file type. It can also be used to limit results from specific information stores like regular files, offline files cache, or email stores.</descrip></descripGrp><ntig><termGrp><term id="1230149">AQS</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296067">Пашыраны сінтаксіс запытаў</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25739_1230149_2296079"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A search query syntax that helps produce more precise search results by using targeted queries that search specific properties in a message type. AQS defines certain keywords which can be used to refine the search query, such as specifying boolean operations on searched terms (AND, OR, NOT) as well as to specify further filters based on file metadata or file type. It can also be used to limit results from specific information stores like regular files, offline files cache, or email stores.</descrip></descripGrp><ntig><termGrp><term id="1230149">AQS</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296079">AQS</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25740_1403948_2296281"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The web-based management tool for Microsoft Exchange administrators and enterprise email users.</descrip></descripGrp><ntig><termGrp><term id="1403948">Exchange Control Panel</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296281">Панэль кіравання Exchange</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25740_1403948_2795546"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The web-based management tool for Microsoft Exchange administrators and enterprise email users.</descrip></descripGrp><ntig><termGrp><term id="1403948">Exchange Control Panel</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2795546">EAC</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25740_1755528_2296281"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The web-based management tool for Microsoft Exchange administrators and enterprise email users.</descrip></descripGrp><ntig><termGrp><term id="1755528">Exchange admin center</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296281">Панэль кіравання Exchange</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25740_1755528_2795546"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The web-based management tool for Microsoft Exchange administrators and enterprise email users.</descrip></descripGrp><ntig><termGrp><term id="1755528">Exchange admin center</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2795546">EAC</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25740_1756842_2296281"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The web-based management tool for Microsoft Exchange administrators and enterprise email users.</descrip></descripGrp><ntig><termGrp><term id="1756842">Exchange Administration Center</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296281">Панэль кіравання Exchange</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25740_1756842_2795546"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The web-based management tool for Microsoft Exchange administrators and enterprise email users.</descrip></descripGrp><ntig><termGrp><term id="1756842">Exchange Administration Center</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2795546">EAC</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25740_2794247_2296281"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The web-based management tool for Microsoft Exchange administrators and enterprise email users.</descrip></descripGrp><ntig><termGrp><term id="2794247">EAC</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296281">Панэль кіравання Exchange</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25740_2794247_2795546"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The web-based management tool for Microsoft Exchange administrators and enterprise email users.</descrip></descripGrp><ntig><termGrp><term id="2794247">EAC</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2795546">EAC</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25741_1186781_2296417"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The primary navigation tab for mail flow management features in Outlook Live: Transport rules, called “rules” in Outlook Live service; Supervision policies, including closed campus supervision policy and bad words supervision policy, and anti-bullying supervision policy; IP safelisting; Domain types: hosted or shared.</descrip></descripGrp><ntig><termGrp><term id="1186781">Mail Control</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296417">Кіраванне поштай</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25742_1186782_2296451"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Web-based management interface for Live@edu administrators. Administrators enroll their domain there initially, and then use the portal to keep their contact information up to date; access DNS record information; view the status of enrolled domains; manage IP safelists; request support for single sign-on; submit or escalate a support request; link to all other resources.</descrip></descripGrp><ntig><termGrp><term id="1186782">Microsoft Live@edu Service Management Portal</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296451">партал кіравання службамі Microsoft Live@edu</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25743_1186784_2296663"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of email policy settings that can help primary and secondary school administrators comply with some requirements of the Children's Internet Protection Act (CIPA). Using these policy settings, administrators can control who can send email to and receive email from the users in their organization, and filter and reject email that contains objectionable words.</descrip></descripGrp><ntig><termGrp><term id="1186784">supervision policy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296663">палітыка кантролю</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25744_1187169_2296143"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">E-mail policy settings that apply inbound and outbound email restrictions so students can send email to or receive email from addresses inside the organization only. Administrators can set up organization-wide exceptions so email can be sent to or from specific domains and public groups. Administrators can also configure per-user exceptions so students can send email to and receive email from specific addresses outside the organization.</descrip></descripGrp><ntig><termGrp><term id="1187169">closed campus supervision policy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296143">палітыка кантролю закрытага кампуса</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25745_1187170_2296073"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An email policy that administrators use to prevent a bully from sending email messages to specific people by adding the bully's email address as an entry on the "victim's" supervision list. This functionality supports anti-harassment policies in schools and other organizations.</descrip></descripGrp><ntig><termGrp><term id="1187170">anti-bullying supervision policy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296073">палітыка кантролю за абразлівымі выразамі</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25747_1188776_2296662"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An individual item on the list of email addresses or users that are subject to or excepted from the actions of the closed campus supervision policy or anti-bullying supervision policy. For example, a bully's email address would be an entry on the supervision list of a "victim", and a parent's email address might be added as an entry on the supervision list of their child, who is a student subject to the closed campus supervision policy.</descrip></descripGrp><ntig><termGrp><term id="1188776">supervision list entry</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296662">элемент спіса кантролю</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25748_1188777_2296661"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The list of email addresses or users that are subject to or excepted from the actions of the closed campus supervision policy or anti-bullying supervision policy.</descrip></descripGrp><ntig><termGrp><term id="1188777">supervision list</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296661">спіс кантролю</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25749_1188778_2296101"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">E-mail policy settings that prevent sending and receiving email that has specifically banned content. Administrators can use this policy to reject email that contains profanity or other objectionable words, also known as "bad words".</descrip></descripGrp><ntig><termGrp><term id="1188778">bad word supervision policy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296101">палітыка кантролю за непрыстойнымі словамі</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25750_1188779_2296462"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of user accounts that are being submitted in a CSV file for migration from an on-premises messaging system to an email system in the cloud.</descrip></descripGrp><ntig><termGrp><term id="1188779">migration batch</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296462">пакет міграцыі</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25751_1188780_2296463"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The action of submitting a migration batch for migration from an on-premises messaging system to an email system in the cloud.</descrip></descripGrp><ntig><termGrp><term id="1188780">migration batch request</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296463">запыт пакета міграцыі</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25753_1188783_2296200"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The time span between the start and end dates.</descrip></descripGrp><ntig><termGrp><term id="1188783">date range</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296200">дыяпазон дат</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25770_1216602_2158035"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SharePoint service application that is deployed and managed on premises and that enables enterprise search functionality.</descrip></descripGrp><ntig><termGrp><term id="1216602">Search service application</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2158035">Службовая праграма пошуку</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25779_1216616_2296065"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A universal security group with administrative rights assigned to it. These administrative rights are specified by built-in management roles, which are part of the role-based access control (RBAC) permissions model in Exchange Server 2010.</descrip></descripGrp><ntig><termGrp><term id="1216616">administrator role group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296065">група роляў адміністратараў</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25779_1216616_2296595"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A universal security group with administrative rights assigned to it. These administrative rights are specified by built-in management roles, which are part of the role-based access control (RBAC) permissions model in Exchange Server 2010.</descrip></descripGrp><ntig><termGrp><term id="1216616">administrator role group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296595">група роляў</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25779_1230147_2296065"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A universal security group with administrative rights assigned to it. These administrative rights are specified by built-in management roles, which are part of the role-based access control (RBAC) permissions model in Exchange Server 2010.</descrip></descripGrp><ntig><termGrp><term id="1230147">role group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296065">група роляў адміністратараў</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25779_1230147_2296595"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A universal security group with administrative rights assigned to it. These administrative rights are specified by built-in management roles, which are part of the role-based access control (RBAC) permissions model in Exchange Server 2010.</descrip></descripGrp><ntig><termGrp><term id="1230147">role group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296595">група роляў</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25780_1216617_2296593"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of one or more end-user management roles that enable users to manage the settings of their Outlook Live account and public groups.</descrip></descripGrp><ntig><termGrp><term id="1216617">role assignment policy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296593">палітыка прызначэння роляў</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25782_1216619_2296227"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A system mailbox in which copies of the mailbox search results are stored.</descrip></descripGrp><ntig><termGrp><term id="1216619">discovery mailbox</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296227">паштовая скрынка знойдзеных паведамленняў</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25782_1216619_2606894"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A system mailbox in which copies of the mailbox search results are stored.</descrip></descripGrp><ntig><termGrp><term id="1216619">discovery mailbox</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2606894">паштовая скрынка eDiscovery</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25782_2603788_2296227"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A system mailbox in which copies of the mailbox search results are stored.</descrip></descripGrp><ntig><termGrp><term id="2603788">discovery system mailbox</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296227">паштовая скрынка знойдзеных паведамленняў</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25782_2603788_2606894"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A system mailbox in which copies of the mailbox search results are stored.</descrip></descripGrp><ntig><termGrp><term id="2603788">discovery system mailbox</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2606894">паштовая скрынка eDiscovery</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25782_2604808_2296227"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A system mailbox in which copies of the mailbox search results are stored.</descrip></descripGrp><ntig><termGrp><term id="2604808">eDiscovery mailbox</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296227">паштовая скрынка знойдзеных паведамленняў</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25782_2604808_2606894"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A system mailbox in which copies of the mailbox search results are stored.</descrip></descripGrp><ntig><termGrp><term id="2604808">eDiscovery mailbox</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2606894">паштовая скрынка eDiscovery</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25783_1216620_2296383"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The collection of IP addresses that are in a gateway servers list or internal mail servers list of IP addresses that should not be treated as spam.</descrip></descripGrp><ntig><termGrp><term id="1216620">IP safelist</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296383">спіс надзейных IP-адрасоў</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25783_1216620_2296605"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The collection of IP addresses that are in a gateway servers list or internal mail servers list of IP addresses that should not be treated as spam.</descrip></descripGrp><ntig><termGrp><term id="1216620">IP safelist</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296605">спіс надзейных адпраўнікоў</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25783_1216842_2296383"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The collection of IP addresses that are in a gateway servers list or internal mail servers list of IP addresses that should not be treated as spam.</descrip></descripGrp><ntig><termGrp><term id="1216842">safelist</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296383">спіс надзейных IP-адрасоў</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25783_1216842_2296605"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The collection of IP addresses that are in a gateway servers list or internal mail servers list of IP addresses that should not be treated as spam.</descrip></descripGrp><ntig><termGrp><term id="1216842">safelist</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296605">спіс надзейных адпраўнікоў</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25784_1216621_2296594"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The individual entry on a management role. Role entries provide access to cmdlets, scripts, and other special permissions that let users perform a specific task. A role entry is often a single cmdlet and the parameters that members of a role group can run when the role is assigned to the role group.</descrip></descripGrp><ntig><termGrp><term id="1216621">role entry</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296594">запіс ролі</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25785_1216622_2296597"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The scope of influence or impact of a role assignment. The scope defines what objects a role group member can manage. In Outlook Live, there is the recipient scope and the configuration scope.</descrip></descripGrp><ntig><termGrp><term id="1216622">role scope</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296597">вобласць прымянення ролі</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25786_1216623_2296596"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A member of an administrator role group, which is a universal security group with administrative rights assigned to it. The roles assigned to the role group are applied to each member who is added to the role group. This grants each user all the permissions allowed by the roles assigned to the role group.</descrip></descripGrp><ntig><termGrp><term id="1216623">role group member</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296596">удзельнік групы роляў</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25787_1216679_1599431"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The link to the Microsoft service agreement.</descrip></descripGrp><ntig><termGrp><term id="1216679">Terms of use</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1599431">Умовы выкарыстання</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25798_1216733_1599412"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The link to the personal page where users can store information (such as personal interests) and links (such as to friends and photos).</descrip></descripGrp><ntig><termGrp><term id="1216733">Profile</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1599412">Профіль</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2580_141226_1573637"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A shaded outline that appears behind an object or text and creates the illusion of depth.</descrip></descripGrp><ntig><termGrp><term id="141226">drop shadow</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1573637">прасвечванне ценю</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2580_141226_1574097"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A shaded outline that appears behind an object or text and creates the illusion of depth.</descrip></descripGrp><ntig><termGrp><term id="141226">drop shadow</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1574097">цень</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2580_298001_1573637"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A shaded outline that appears behind an object or text and creates the illusion of depth.</descrip></descripGrp><ntig><termGrp><term id="298001">shadow</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1573637">прасвечванне ценю</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2580_298001_1574097"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A shaded outline that appears behind an object or text and creates the illusion of depth.</descrip></descripGrp><ntig><termGrp><term id="298001">shadow</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1574097">цень</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25810_1217801_1599409"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The link to the list of contacts from your mail and messenger accounts.</descrip></descripGrp><ntig><termGrp><term id="1217801">People</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1599409">Людзі</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25811_1217802_1599394"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The link to Windows Live Hotmail.</descrip></descripGrp><ntig><termGrp><term id="1217802">Mail</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1599394">Пошта</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25813_1217804_1599400"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The link to the list of more links to other Microsoft sites.</descrip></descripGrp><ntig><termGrp><term id="1217804">More</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1599400">Дадаткова</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25814_1217805_1599360"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The link to the online calendar on Windows Live Calendar.</descrip></descripGrp><ntig><termGrp><term id="1217805">Calendar</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1599360">Каляндар</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25815_1217807_1599377"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The link to the online shared event organiser on Windows Live Events.</descrip></descripGrp><ntig><termGrp><term id="1217807">Events</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1599377">Падзеі</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25816_1217808_1599384"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The link to the online communities on Windows Live Groups.</descrip></descripGrp><ntig><termGrp><term id="1217808">Groups</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1599384">Групы</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25817_1217809_1599424"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The link to the user's personal online space, with blog functionality, photo albums, and lists, on Windows Live Spaces.</descrip></descripGrp><ntig><termGrp><term id="1217809">Spaces</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1599424">Сферы</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25819_1217811_1599397"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The link to the Windows Live site where users can register their mobile phone and find information about the Windows Live for Mobile services.</descrip></descripGrp><ntig><termGrp><term id="1217811">Mobile</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1599397">Мабільны тэлефон</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25820_1217812_1769287"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The link to the site to download client versions of Windows Live products such as Windows Live Mail, Windows Live Messenger, etc.</descrip></descripGrp><ntig><termGrp><term id="1217812">Downloads</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1769287">Спампоўкі</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25821_1217813_1771037"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The link to the overview page of all Windows Live, MSN, and Microsoft products on offer.</descrip></descripGrp><ntig><termGrp><term id="1217813">All services</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1771037">Усе сэрвісы</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25822_1217817_1599367"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The link to the page where users enter information for the methods by which they can be contacted, such as Messenger, home phone, mobile phone, and email.</descrip></descripGrp><ntig><termGrp><term id="1217817">Contact info</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1599367">Кантактныя дадзеныя</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25825_1217869_1864939"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An option that enables the user to see the different parts of a nested formula evaluated in the order the formula is calculated.</descrip></descripGrp><ntig><termGrp><term id="1217869">Evaluate Formula</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1864939">Ацаніць формулу</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25837_1217966_2296263"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Outlook Live feature in the Web management interface that enables migration of the contents of user mailboxes from an on-premises IMAP messaging system to Outlook Live (or Exchange Online).</descrip></descripGrp><ntig><termGrp><term id="1217966">Email Migration</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296263">Міграцыя электроннай пошты</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25844_1218374_2296555"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The domain name of the Outlook Live domain that you are configuring with Outlook Live Directory Sync (OLSync)(previously known as GALSync 2010). When you deploy OLSync, you manually enter at least one provisioning domain, for example, student.contoso.edu, during the ILM 2007 configuration process. The provisioning domain must be an accepted domain in your Outlook Live deployment.</descrip></descripGrp><ntig><termGrp><term id="1218374">provisioning domain</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296555">дамен падрыхтоўкі</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25845_1218375_2296106"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A domain or a person that an end user doesn't want to receive email messages from. Messages received from any email address or domain listed in the users' Blocked Senders list are sent directly to the user's Junk E-Mail folder.</descrip></descripGrp><ntig><termGrp><term id="1218375">blocked sender</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296106">заблакаваны адпраўнік</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25846_1218376_2296430"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Active Directory security principal object that has at least one associated SMTP address</descrip></descripGrp><ntig><termGrp><term id="1218376">mail-enabled user</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296430">карыстальнік з актываванай поштай</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25847_1218377_2296341"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The administrator user interface in Outlook Live used to import new users with a CSV file.</descrip></descripGrp><ntig><termGrp><term id="1218377">Import users</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296341">Імпарт карыстальнікаў</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25848_1218378_2296182"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A comma separated value (CSV) file used to provision many new users at one time.</descrip></descripGrp><ntig><termGrp><term id="1218378">CSV import file</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296182">CSV-файл імпарту</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25849_1218379_2296340"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of provisioning new users using a CSV file.</descrip></descripGrp><ntig><termGrp><term id="1218379">import process</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296340">працэс імпарту</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25850_1218380_2296747"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The administrative boundary in which members of an Exchange 2010 role group can make changes. For the Outlook Live hosted service, the write scope is the entire Outlook Live organization. For on-premises implementations of Microsoft Exchange Server 2010, write scopes may be smaller in breadth, such as those defined by a specific organizational unit or a database.</descrip></descripGrp><ntig><termGrp><term id="1218380">write scope</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296747">вобласць запісу</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25851_1218381_2296228"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The role group that gives users the permissions needed to use Multi-Mailbox Search.</descrip></descripGrp><ntig><termGrp><term id="1218381">Discovery Management</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296228">Кіраванне выяўленнем</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25852_1218382_2296328"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The role group that gives users the permissions to reset passwords for users and manage settings on the Options page for users' Outlook Live account. To help troubleshoot user issues, members can also view, but not modify, all mailboxes, public groups, and external contacts in the organization.</descrip></descripGrp><ntig><termGrp><term id="1218382">Help Desk</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296328">Служба падтрымкі</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25853_1218383_2296566"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The role group that gives users the permissions to create and manage mailboxes, public groups, and external contacts. Members can also import new users, track messages sent and received by users, and manage Exchange ActiveSync settings for the organization.</descrip></descripGrp><ntig><termGrp><term id="1218383">Recipient Management</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296566">Кіраванне атрымальнікамі</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25854_1218384_2296568"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The role group that gives users permissions to create and manage organization-wide rules, also known as transport rules. Members of the role group can also track messages sent and received by users.</descrip></descripGrp><ntig><termGrp><term id="1218384">Records Management</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296568">Кіраванне запісамі</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25855_1218385_2296696"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The role group that gives users the permissions to manage Unified Messaging (UM) server configurations, UM properties on mailboxes, UM prompts, and UM auto attendant configuration.</descrip></descripGrp><ntig><termGrp><term id="1218385">UM Management</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296696">Кіраванне адзінай сістэмай абмену паведамленнямі</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25856_1218386_2296720"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The administrator role group that gives users permissions to view, but not modify, all mailboxes, public groups, and external contacts in the organization. Members can also view settings for role assignment policies, transport rules, and supervision policies.</descrip></descripGrp><ntig><termGrp><term id="1218386">View-Only Organization Management</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296720">Кіраванне арганізацыяй з правамі толькі на прагляд</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25857_1218387_2296604"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A domain or a person that a user wants to always receive email messages from. Users add recipients and domains to the Safe Senders list.</descrip></descripGrp><ntig><termGrp><term id="1218387">safe sender</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296604">надзейны адпраўнік</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25858_1218388_2296469"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in Exchange 2010 and Outlook Live that enables users to search the mailboxes in their organization for email and other message types that contain specific keywords. The results of a search are then copied to a mailbox that you have specified so that you can review, organize, and export the search results.</descrip></descripGrp><ntig><termGrp><term id="1218388">Multi-Mailbox Search</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296469">Пошук у некалькіх паштовых скрынках</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25859_1218389_2296707"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An item that can't be indexed for a mailbox search using Multi-Mailbox Search. This includes unrecognized message types and messages that contain attachments that are encrypted or have an unrecognized format.</descrip></descripGrp><ntig><termGrp><term id="1218389">unsearchable item</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296707">элемент, пошук якога немагчымы</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25860_1218390_2296321"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A person who is assigned the ability to approve and reject any messages sent to a public group or a dynamic distribution group.</descrip></descripGrp><ntig><termGrp><term id="1218390">group moderator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296321">мадэратар групы</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25862_1223075_2296599"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of resource mailbox that is assigned to a meeting location such as a conference room, auditorium, or training room. Room mailboxes can be included as resources in meeting requests, providing a simple and efficient way of organizing meetings for an organization.</descrip></descripGrp><ntig><termGrp><term id="1223075">room mailbox</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296599">паштовая скрынка памяшкання</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25865_1223099_2729736"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A notice sent to employees of an organization instructing them to preserve all documents that may be relevant to a legal case.</descrip></descripGrp><ntig><termGrp><term id="1223099">legal hold</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2729736">захоўванне па юрыдычных прычынах</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25865_1223099_2729738"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A notice sent to employees of an organization instructing them to preserve all documents that may be relevant to a legal case.</descrip></descripGrp><ntig><termGrp><term id="1223099">legal hold</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2729738">захоўванне для судовага разбору</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25865_2726542_2729736"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A notice sent to employees of an organization instructing them to preserve all documents that may be relevant to a legal case.</descrip></descripGrp><ntig><termGrp><term id="2726542">litigation hold</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2729736">захоўванне па юрыдычных прычынах</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25865_2726542_2729738"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A notice sent to employees of an organization instructing them to preserve all documents that may be relevant to a legal case.</descrip></descripGrp><ntig><termGrp><term id="2726542">litigation hold</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2729738">захоўванне для судовага разбору</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25869_1224269_2296660"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Elevated credentials that have rights to access objects that ordinary users without elevated credentials can't access.</descrip></descripGrp><ntig><termGrp><term id="1224269">super-user credentials</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296660">уліковыя дадзеныя суперкарыстальніка</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25870_1224270_2296530"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A subscription that gathers messages from POP3 mailboxes and delivers the messages to a designated Outlook Live mailbox so that the Outlook Live end user can centralize their email accounts and only have to check one mailbox.</descrip></descripGrp><ntig><termGrp><term id="1224270">POP subscription</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296530">POP-падпіска</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25871_1224271_2296259"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Windows Live ID created in a domain, and using the domain name, before the domain was enrolled in Outlook Live. After the Windows Live ID is imported into the Outlook Live domain, it is subject to the security and privacy policies of the organization.</descrip></descripGrp><ntig><termGrp><term id="1224271">unmanaged Windows Live ID</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296259">EASI ID</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25871_1224271_2296262"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Windows Live ID created in a domain, and using the domain name, before the domain was enrolled in Outlook Live. After the Windows Live ID is imported into the Outlook Live domain, it is subject to the security and privacy policies of the organization.</descrip></descripGrp><ntig><termGrp><term id="1224271">unmanaged Windows Live ID</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296262">электронная пошта ў якасці ідэнтыфікатара для ўваходу</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25871_1275550_2296259"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Windows Live ID created in a domain, and using the domain name, before the domain was enrolled in Outlook Live. After the Windows Live ID is imported into the Outlook Live domain, it is subject to the security and privacy policies of the organization.</descrip></descripGrp><ntig><termGrp><term id="1275550">e-mail as sign in ID</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296259">EASI ID</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25871_1275550_2296262"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Windows Live ID created in a domain, and using the domain name, before the domain was enrolled in Outlook Live. After the Windows Live ID is imported into the Outlook Live domain, it is subject to the security and privacy policies of the organization.</descrip></descripGrp><ntig><termGrp><term id="1275550">e-mail as sign in ID</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296262">электронная пошта ў якасці ідэнтыфікатара для ўваходу</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25871_1275551_2296259"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Windows Live ID created in a domain, and using the domain name, before the domain was enrolled in Outlook Live. After the Windows Live ID is imported into the Outlook Live domain, it is subject to the security and privacy policies of the organization.</descrip></descripGrp><ntig><termGrp><term id="1275551">EASI ID</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296259">EASI ID</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25871_1275551_2296262"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Windows Live ID created in a domain, and using the domain name, before the domain was enrolled in Outlook Live. After the Windows Live ID is imported into the Outlook Live domain, it is subject to the security and privacy policies of the organization.</descrip></descripGrp><ntig><termGrp><term id="1275551">EASI ID</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296262">электронная пошта ў якасці ідэнтыфікатара для ўваходу</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25872_1224272_2296536"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of validating data before it is processed. This validation helps detect and exclude some errors from the intended process, which might be the import or migration of users using a CSV file, for example.</descrip></descripGrp><ntig><termGrp><term id="1224272">preliminary data validation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296536">папярэдняя праверка дадзеных</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25873_1224273_2296090"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A DNS server that is responsible for the DNS records that are associated with a domain.</descrip></descripGrp><ntig><termGrp><term id="1224273">authoritative name server</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296090">паўнамоцны сервер даменных імён</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25884_1230078_1864940"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The year 2010 edition of the Microsoft spreadsheet software with tools for analyzing, charting, and communicating data.</descrip></descripGrp><ntig><termGrp><term id="1230078">Microsoft Excel 2010</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1864940">Microsoft Excel 2010</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25885_1230079_1864941"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The year 2010 edition of the Microsoft spreadsheet software, with tools for analyzing, charting, and communicating data, designed for home and students.</descrip></descripGrp><ntig><termGrp><term id="1230079">Microsoft Excel Home and Student 2010</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1864941">Microsoft Excel Home and Student 2010</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25886_1230086_1864942"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The year 2010 edition of the Microsoft spreadsheet software designed for use with handheld computing devices.</descrip></descripGrp><ntig><termGrp><term id="1230086">Microsoft Excel Mobile 2010</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1864942">Microsoft Excel Mobile 2010</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25900_1509435_1659574"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The device that runs Windows Phone Operating System.</descrip></descripGrp><ntig><termGrp><term id="1509435">Windows Phone</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1659574">Windows Phone</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25900_2195811_1659574"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The device that runs Windows Phone Operating System.</descrip></descripGrp><ntig><termGrp><term id="2195811">WP</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1659574">Windows Phone</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25901_1231845_1599361"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The menu item on the Bing menu that links to http://www.bing.com/cashback/.</descrip></descripGrp><ntig><termGrp><term id="1231845">Cashback</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1599361">Cashback</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25902_1231846_1599413"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Web page object that assists users in finding both public (Web and Windows Live) and private (my Windows Live content) content for insertion into their authored content.</descrip></descripGrp><ntig><termGrp><term id="1231846">Quick add</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1599413">Хуткае дадаванне</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25903_1231847_1599372"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The link to the free online workspace for accessing, editing, and sharing Excel, Word, PowerPoint and OneNote documents across your PC, smartphone, and web browser.</descrip></descripGrp><ntig><termGrp><term id="1231847">Documents</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1599372">Дакументы</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25904_1231848_1599356"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The link to bing.com in some regions but to a dropdown list of more Bing options in other regions.</descrip></descripGrp><ntig><termGrp><term id="1231848">Bing</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1599356">Bing</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25905_1231849_1599371"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Windows Mobile header link that opens a menu that contains more options.</descrip></descripGrp><ntig><termGrp><term id="1231849">Do more</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1599371">Іншыя магчымасці</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25906_1231850_1599370"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The link to the website where customers add computers (both PCs and Macs), mobile phones, and digital photo frames so they can access their synced folders and connect remotely to their devices.</descrip></descripGrp><ntig><termGrp><term id="1231850">Devices</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1599370">Прылады</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25907_1231852_1599364"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The link to the code of conduct, which contains rules that explain how someone should behave while using a service or product.</descrip></descripGrp><ntig><termGrp><term id="1231852">Code of Conduct</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1599364">Правілы паводзін</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25912_1231866_1806392"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The year 2010 edition of the Microsoft messaging and collaboration client software for personal computers accessing Microsoft Exchange Server-based email and collaboration services.</descrip></descripGrp><ntig><termGrp><term id="1231866">Microsoft Outlook 2010</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1806392">Microsoft Outlook 2010</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25917_1231890_1769218"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The link to photos that only you and people that you select can view (versus public photos that anyone can view).</descrip></descripGrp><ntig><termGrp><term id="1231890">Shared photos</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1769218">Сумесныя фатаграфіі</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25918_1231891_1599430"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The link to the Microsoft service agreement.</descrip></descripGrp><ntig><termGrp><term id="1231891">Terms</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1599430">Умовы</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25919_1231893_1599407"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Windows Mobile footer link to the site that is built for viewing from a PC.</descrip></descripGrp><ntig><termGrp><term id="1231893">PC site</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1599407">Сайт для ПК</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25921_1231895_1754437"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Windows Mobile footer link to the site that is built for viewing from mobile devices.</descrip></descripGrp><ntig><termGrp><term id="1231895">Mobile site</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1754437">Сайт для мабільных прылад</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25957_1245016_2296052"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Identity Lifecycle Manager management agent provided by Microsoft to connect to Active Directory Domain Services (AD DS) or Active Directory directory service.</descrip></descripGrp><ntig><termGrp><term id="1245016">Active Directory Management Agent</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296052">агент кіравання Active Directory</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25957_1245016_2296060"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Identity Lifecycle Manager management agent provided by Microsoft to connect to Active Directory Domain Services (AD DS) or Active Directory directory service.</descrip></descripGrp><ntig><termGrp><term id="1245016">Active Directory Management Agent</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296060">ADMA</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25957_1245017_2296052"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Identity Lifecycle Manager management agent provided by Microsoft to connect to Active Directory Domain Services (AD DS) or Active Directory directory service.</descrip></descripGrp><ntig><termGrp><term id="1245017">ADMA</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296052">агент кіравання Active Directory</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25957_1245017_2296060"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Identity Lifecycle Manager management agent provided by Microsoft to connect to Active Directory Domain Services (AD DS) or Active Directory directory service.</descrip></descripGrp><ntig><termGrp><term id="1245017">ADMA</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296060">ADMA</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25959_1247422_2296722"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mailbox folder structure on some IMAP servers in which mail folders are accessed with the administrator username and password, and shell login access to the mail server is not allowed. Access to specific mailboxes is managed by access control lists. This means that users are assigned the permissions to only access their mailbox folder, while an administrator has access to all mailboxes. This allows organizations to use administrative credentials to migrate email from an IMAP server to Outlook Live.</descrip></descripGrp><ntig><termGrp><term id="1247422">virtual shared folder</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296722">віртуальная агульная папка</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2596_335540_2774631"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To provide your name and contact information to an organization so that you can receive product information, updates, and special offers.</descrip></descripGrp><ntig><termGrp><term id="335540">register</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2774631">рэгістраваць</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25978_1251313_2296277"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To place a windows Live ID in a forced rename state, while the Windows Live ID and all of its existing settings, including the password, Xbox Live points, or Zune points are preserved. The user can sign in using the Windows Live ID and its password, but they're immediately asked to rename the Windows Live ID. They must specify an email address that's outside the Outlook Live domain.</descrip></descripGrp><ntig><termGrp><term id="1251313">evict</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296277">выключыць</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25985_1253605_2340722"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A graphical representation of data where the intensity of color corresponds to the related analytical data. For example, low values in a range appear as blue (cold) and high values as red (hot).</descrip></descripGrp><ntig><termGrp><term id="1253605">heat map</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2340722">цеплавая карта</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25985_2593079_2340722"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A graphical representation of data where the intensity of color corresponds to the related analytical data. For example, low values in a range appear as blue (cold) and high values as red (hot).</descrip></descripGrp><ntig><termGrp><term id="2593079">heatmap</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2340722">цеплавая карта</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2599_211415_1573793"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Intel microprocessor that uses explicitly parallel instruction set computing and 64-bit memory addressing. "Itanium-based" refers to systems or platforms that are based on the Itanium processor. "Itanium2-based" refers to systems or platforms that are based on the Itanium2 processor. "Itanium architecture-based" refers to systems or platforms that are based on the Itanium and Itanium2 processors.</descrip></descripGrp><ntig><termGrp><term id="211415">Itanium</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1573793">Itanium</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25992_1253847_1659581"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An online community where members can virtually socialize by posting and commenting on a newsfeed, by chatting, and by sharing photos, images, articles, and other content.</descrip></descripGrp><ntig><termGrp><term id="1253847">social network</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1659581">сацыяльная сетка</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25992_2696313_1659581"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An online community where members can virtually socialize by posting and commenting on a newsfeed, by chatting, and by sharing photos, images, articles, and other content.</descrip></descripGrp><ntig><termGrp><term id="2696313">network</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1659581">сацыяльная сетка</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26004_1256406_1864948"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A short summary of the contents of a document that gives the reader a quick overview of its topic and purpose.</descrip></descripGrp><ntig><termGrp><term id="1256406">abstract</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1864948">анатацыя</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></t