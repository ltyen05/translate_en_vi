r">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2081493">Windows Embedded 8 Handheld</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36786_2071246_2080571"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A predetermined text reply that can be automatically sent in response to incoming calls, text messages, or both when Driving Mode is turned on. The text reply is sent with no action on the part of the user.</descrip></descripGrp><ntig><termGrp><term id="2071246">text reply</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2080571">адказ па SMS</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36787_2071247_2080572"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A response to an incoming call using a text message when the caller is a contact calling from a mobile phone.</descrip></descripGrp><ntig><termGrp><term id="2071247">text reply</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2080572">адказаць па SMS</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36790_2071376_2080561"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A camera option to capture just one image when the user presses the camera button.</descrip></descripGrp><ntig><termGrp><term id="2071376">single photo</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2080561">адзіночнае фота</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36791_2071377_2080564"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A photo you can choose to use as the background for some Live Tiles on the Start screen.</descrip></descripGrp><ntig><termGrp><term id="2071377">Start background</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2080564">фон экрана запуску</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36792_2071378_2080583"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Windows Phone feature to upgrade a phone call into a Skype video call.</descrip></descripGrp><ntig><termGrp><term id="2071378">video upgrade</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2080583">перавод у відэавыклік</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36793_2071379_2080588"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A visual setting that enables app screen content to display in a window.</descrip></descripGrp><ntig><termGrp><term id="2071379">windowed mode</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2080588">аконны рэжым</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36794_2071380_2080535"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A visual setting that is similar to “stretch” - the resolution of the phone screen is refitted to fill as much of the external screen as possible without compromising its dimensionality.</descrip></descripGrp><ntig><termGrp><term id="2071380">expanded screen mode</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2080535">рэжым пашыранага экрана</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36795_2071381_2080555"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Windows desktop application that is required to enable users to project their phone screen to a Windows device using a USB connection.</descrip></descripGrp><ntig><termGrp><term id="2071381">Project My Screen App</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2080555">Праграма вываду выяў на экран</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36805_2072311_2085113"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that unifies components across applications, such as people, conversations, calendars, emails, and files, to create a seamless collaboration experience. Creating a group anywhere in Microsoft 365 will automatically provision a corresponding Yammer conversation feed, an Outlook inbox and calendar, and a SharePoint document library for every Group member. Groups make these components persistent across applications, so that changes made to components in part of Microsoft 365 will carry through to the others, thus enabling a unified experience.</descrip></descripGrp><ntig><termGrp><term id="2072311">Groups</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2085113">Групы</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36805_2072311_2382875"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that unifies components across applications, such as people, conversations, calendars, emails, and files, to create a seamless collaboration experience. Creating a group anywhere in Microsoft 365 will automatically provision a corresponding Yammer conversation feed, an Outlook inbox and calendar, and a SharePoint document library for every Group member. Groups make these components persistent across applications, so that changes made to components in part of Microsoft 365 will carry through to the others, thus enabling a unified experience.</descrip></descripGrp><ntig><termGrp><term id="2072311">Groups</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2382875">Групы Office 365</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36805_2874478_2085113"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that unifies components across applications, such as people, conversations, calendars, emails, and files, to create a seamless collaboration experience. Creating a group anywhere in Microsoft 365 will automatically provision a corresponding Yammer conversation feed, an Outlook inbox and calendar, and a SharePoint document library for every Group member. Groups make these components persistent across applications, so that changes made to components in part of Microsoft 365 will carry through to the others, thus enabling a unified experience.</descrip></descripGrp><ntig><termGrp><term id="2874478">Microsoft 365 Groups</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2085113">Групы</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36805_2874478_2382875"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that unifies components across applications, such as people, conversations, calendars, emails, and files, to create a seamless collaboration experience. Creating a group anywhere in Microsoft 365 will automatically provision a corresponding Yammer conversation feed, an Outlook inbox and calendar, and a SharePoint document library for every Group member. Groups make these components persistent across applications, so that changes made to components in part of Microsoft 365 will carry through to the others, thus enabling a unified experience.</descrip></descripGrp><ntig><termGrp><term id="2874478">Microsoft 365 Groups</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2382875">Групы Office 365</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36806_2072312_2085115"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The database that stores search feature settings which include but are not limited to query rules and the search schema.</descrip></descripGrp><ntig><termGrp><term id="2072312">search settings database</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2085115">база дадзеных параметраў пошуку</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36807_2072313_2085114"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables the user to record on-screen activity, and embeds the video automatically in PowerPoint.</descrip></descripGrp><ntig><termGrp><term id="2072313">Screen Recording</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2085114">Запіс экрана</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36824_2077814_2093811"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Skype software application that uses the non-desktop user interface introduced with Windows 8.</descrip></descripGrp><ntig><termGrp><term id="2077814">Skype for modern Windows</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2093811">Skype для сучаснай Windows</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36825_2078795_2252498"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Skype software application for Windows desktop.</descrip></descripGrp><ntig><termGrp><term id="2078795">Skype for Windows desktop</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2252498">Skype для камп'ютараў з Windows</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36832_2085426_2099718"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A menu that contains the most commonly used contextual commands such as Cut, Copy, Paste, Comment, and Proofing.</descrip></descripGrp><ntig><termGrp><term id="2085426">Mini Toolbar</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2099718">Міні-панэль інструментаў</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36833_2085429_2099716"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A yellow bar with a warning icon appearing below the ribbon that provides information or alerts the user. Information can be security alerts, errors, or notifications.</descrip></descripGrp><ntig><termGrp><term id="2085429">Message Bar</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2099716">Панэль паведамленняў</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36834_2085430_2099721"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A dialog box that shows the progress of an operation.</descrip></descripGrp><ntig><termGrp><term id="2085430">Progress UI</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2099721">Інтэрфейс прагрэсу</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36835_2085431_2099720"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A recurring meeting that does not have a standard pattern of daily, weekly, monthly, etc.</descrip></descripGrp><ntig><termGrp><term id="2085431">custom repeat</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2099720">Персаналізаваны паўтор</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="36836_2086047_2099723"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The icon on the upper-left corner of the Office 365 suite. The icon is the entry point to all Office 365 services for which the user has a valid subscription, and to the Admin center (only if the user is an admin).</descrip></descripGrp><ntig><termGrp><term id="2086047">app launcher</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2099723">кнопка выкліку праграмы</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammatical