ographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49787_2816024_2818608"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An office organization system which involves multiple workers using a single physical work station or surface during different time periods.</descrip></descripGrp><ntig><termGrp><term id="2816024">hot-desking</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2818608">супольнае выкарыстанне працоўных сталоў</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49788_2816025_2818613"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A service that protects against harmful links (URLs) in incoming emails.</descrip></descripGrp><ntig><termGrp><term id="2816025">URL threat protection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2818613">абарона ад шкодных URL-адрасоў</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49789_2816026_2818611"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Sample content used to train a classifier.</descrip></descripGrp><ntig><termGrp><term id="2816026">seed content</term><termNote type="partOfSpeech">Noun</termNote><termN