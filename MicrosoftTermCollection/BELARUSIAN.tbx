<langSet xml:lang="be"><ntig><termGrp><term id="1770529">RTM</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33276_1764505_1770526"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To reset a system using a method that restores PC settings to defaults but retains a user's files and personalization touches.</descrip></descripGrp><ntig><termGrp><term id="1764505">refresh your PC</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1770526">абнавіць ПК</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33278_1764509_1770528"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To reset a system so that all user customizations are removed.</descrip></descripGrp><ntig><termGrp><term id="1764509">reset your PC</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1770528">вярнуць ПК у зыходны стан</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33281_1764780_1770520"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The service run by the Windows Store team that supports the end-to-end process for registering Windows Store developers and onboarding apps into the Windows Store catalog.</descrip></descripGrp><ntig><termGrp><term id="1764780">dashboard</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1770520">панэль</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33281_1764780_1998043"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The service run by the Windows Store team that supports the end-to-end process for registering Windows Store developers and onboarding apps into the Windows Store catalog.</descrip></descripGrp><ntig><termGrp><term id="1764780">dashboard</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1998043">панэль Крамы Windows</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33282_1764781_1978947"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A control that slows down the speed of panning from a user interaction.</descrip></descripGrp><ntig><termGrp><term id="1764781">speed bump</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1978947">абмежавальнік хуткасці</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33288_1764988_1770519"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The button that allows customers to finalize their purchase on a website.</descrip></descripGrp><ntig><termGrp><term id="1764988">Checkout</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1770519">Завяршыць пакупку</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33298_1765238_1770521"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The out-of-the-box encryption capabilities that are automatically included on PCs running Windows RT.</descrip></descripGrp><ntig><termGrp><term id="1765238">Device Encryption</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1770521">Шыфраванне прылад</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="333_232846_1864476"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A comment created by using a stylus. Microsoft Office Word treats a pen comment like any other drawing object. Pen comments don't appear in the Reviewing Pane, and Word doesn't insert comment marks in the document window.</descrip></descripGrp><ntig><termGrp><term id="232846">pen comment</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalN