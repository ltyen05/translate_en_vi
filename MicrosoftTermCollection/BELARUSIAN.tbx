ion such as step counts or activities (such as walking, running).</descrip></descripGrp><ntig><termGrp><term id="2258789">motion data</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2262982">дадзеныя руху</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38736_2258791_2542715"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Playing or viewing activity that you can instantly see among people that you follow.</descrip></descripGrp><ntig><termGrp><term id="2258791">trending</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2542715">сачыць</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38737_2258792_2542716"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To allow people to see your real name and Microsoft account picture.</descrip></descripGrp><ntig><termGrp><term id="2258792">trust</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2542716">давяраць</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38738_2258793_2542719"><l