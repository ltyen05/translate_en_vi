g><termGrp><term id="2189618">згрупаваць</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37049_2106698_2189619"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of very similar photos that have been grouped together by the Photos app. The app shows only the best photo of the stack in the list view.</descrip></descripGrp><ntig><termGrp><term id="2106698">stack</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2189619">група</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37050_2106699_2189621"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To remove the "stack" association from a group of similar photos that have been stacked together in the Photos app.</descrip></descripGrp><ntig><termGrp><term id="2106699">unstack</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2189621">разгрупаваць</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37054_2781063_2783790"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The limited-day trial for government organizations for the offer for OneDrive for Business that includes Office Online, and that is hosted in the commercial cloud environment.</descrip></descripGrp><ntig><termGrp><term id="2781063">OneDrive for Business with Office on the web (Government Pricing) Trial</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2783790">пробная вэб-версія OneDrive для бізнесу з пакетам Office (цана для дзяржаўных устаноў)</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3706_146703_1864318"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The calendar selected in the regional settings in Windows Control Panel, or the system calendar.</descrip></descripGrp><ntig><termGrp><term id="146703">primary calendar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1864318">асноўны каляндар</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3711_359685_1574164"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A marker that can be associated with content or items, such as photos or text, to identify certain types of information, and that allows users to find, view, and sort marked content.</descrip></descripGrp><ntig><termGrp><term id="359685">note tag</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1574164">цэтлік</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3711_359685_1864565"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A marker that can be associated with content or items, such as photos or text, to identify certain types of information, and that allows users to find, view, and sort marked content.</descrip></descripGrp><ntig><termGrp><term id="359685">note tag</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1864565">тэг нататкі</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3711_359686_1574164"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A marker that can be associated with content or items, such as photos or text, to identify certain types of information, and that allows users to find, view, and sort marked content.</descrip></descripGrp><ntig><termGrp><term id="359686">tag</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1574164">цэтлік</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3711_359686_1864565"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A marker that can be associated with content or items, such as p