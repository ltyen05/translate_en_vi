="42212_2389893_2420828"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A series of points with color and varying thickness that resembles physical ink on a digital screen.</descrip></descripGrp><ntig><termGrp><term id="2389893">ink</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2420828">рукапіс</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42213_2390287_2395213"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A standalone application that requires the user to have an Office 365 subscription.</descrip></descripGrp><ntig><termGrp><term id="2390287">companion app</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2395213">спадарожная праграма</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4228_96236_1864152"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">During software upgrades, the product that is already installed on the machine, i.e. the version to be upgraded.</descrip></descripGrp><ntig><termGrp><term id="96236">qualifying product</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1864152">адпаведны прадукт</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpe