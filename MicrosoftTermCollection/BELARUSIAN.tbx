/termGrp></ntig></langSet></termEntry><termEntry id="33253_1763768_1791905"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SharePoint field type that enables annotation of a SharePoint list with latitude and longitude.</descrip></descripGrp><ntig><termGrp><term id="1763768">Geolocation</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1791905">Геаграфiчнае распалажэнне</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33254_1763770_1791903"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SharePoint view that provides an optimized mobile browser experience for users and renders in HTML5.</descrip></descripGrp><ntig><termGrp><term id="1763770">contemporary view</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1791903">сучасны выгляд</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33255_1763771_1791902"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SharePoint view that renders in HTML format, or a similar markup language such as CHTML or WML, and provides backward compatibility for mobile browsers that cannot support the contemporary view.</descrip></descripGrp><ntig><termGrp><term id="1763771">classic view</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></nti