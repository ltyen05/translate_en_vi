="be"><ntig><termGrp><term id="1806211">экземпляр</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7276_231962_1864413"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Sheet.xlt template that you create to change the default format of new worksheets. Excel uses the template to create a blank worksheet when you add a new worksheet to a workbook.</descrip></descripGrp><ntig><termGrp><term id="231962">default worksheet template</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1864413">шаблон ліста па змаўчанні</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="728_483_1573531"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An entity, such as a device or program, that connects to another entity over a network.</descrip></descripGrp><ntig><termGrp><term id="483">client</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1573531">кліент</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="728_483_1864070"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An entity, such as a device or program, that connects to another entity over a network.</descrip></descripGrp><ntig><termGrp><term id="483">client</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1864070">кліенцкі камп'ютэр</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="728_484_1573531"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An entity, such as a device or program, that connects to another entity over a network.</descrip></descripGrp><ntig><termGrp><term id="484">client computer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1573531">кліент</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="728_484_1864070"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An entity, such as a device or program, that connects to another entity over a network.</descrip></descripGrp><ntig><termGrp><term id="484">client computer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1864070">кліенцкі камп'ютэр</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7280_502936_1791663"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A presence status the user can select, while signed in, to make it appear to other users that he or she is currently willing to be contacted.</descrip></descripGrp><ntig><termGrp><term id="502936">available</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1791663">прысутнічае</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7290_60173_1573735"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Any token that a program can use to identify and access an object such as a device, a file, a window, or a dialog box.</descrip></descripGrp><ntig><termGrp><term id="60173">handle</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1573735">дэскрыптар</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7306_119668_1770875"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To touch an item once with the tablet pen and then lift the pen quickly.</descrip></descripGrp><ntig><termGrp><term id="119668">tap</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1770875">даткнуцца</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender