on">The meaning of data as it is intended to be interpreted by people.</descrip></descripGrp><ntig><termGrp><term id="66163">information</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1573767">інфармацыя</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8292_66163_1776124"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The meaning of data as it is intended to be interpreted by people.</descrip></descripGrp><ntig><termGrp><term id="66163">information</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1776124">звесткі</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="832_1176946_1778326"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Having two components, alternatives, or outcomes. The binary number system has 2 as its base, so values are expressed as combinations of two digits, 0 and 1. These two digits can represent the logical values true and false as well as numerals, and they can be represented in an electronic device by the two states on and off, recognized as two voltage levels. Therefore, the binary number system is at the heart of digital computing.</descrip></descripGrp><ntig><termGrp><term id="1176946">base 2</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1778326">двайковы</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="832_21220_1778326"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Having two components, alternatives, or outcomes. The binary number system has 2 as its base, so values are expressed as combinations of two digits, 0 and 1. These two digits can represent the logical values true and false as well as numerals, and they can be represented in an electronic device by the two states on and off, recognized as two voltage levels. Therefore, the binary number system is at the heart of digital computing.</descrip></descripGrp><ntig><termGrp><term id="21220">binary</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1778326">двайковы</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8320_346966_1574005"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To safeguard a resource from attack or loss.</descrip></descripGrp><ntig><termGrp><term id="346966">protect</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1574005">ахоўваць</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8333_397163_2296306"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A hierarchy of folders in the Exchange store very similar in structure to the standard file system. A single folder can contain child folders, which, in turn, can contain other child folders.</descrip></descripGrp><ntig><termGrp><term id="397163">folder tree</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296306">дрэва папак</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8356_116839_1574147"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to a formatting style in which characters are crossed out by horizontal line.</descrip></descripGrp><ntig><termGrp><term id="116839">strikethrough</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1574147">перакрэсліванне</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8369_226552_1769180"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that notifies a user when there is a change to posted content, workflow status, or when other user-defined criteria are met.</descrip></descripGrp><ntig><termGrp><term id="226552">alert</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet