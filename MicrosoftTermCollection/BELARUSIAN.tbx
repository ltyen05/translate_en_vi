"45114_2547316_2549984"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A conversation window that displays transcribed voice text in a game session.</descrip></descripGrp><ntig><termGrp><term id="2547316">Xbox game speech window</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2549984">акенца гульнявых перамоў Xbox</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45118_2547320_2549971"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The section in the Xbox Store where developers participating in the Xbox Live Creators Program publish their games directly. The collection offers exciting and diverse games that are fun to pick up and play.</descrip></descripGrp><ntig><termGrp><term id="2547320">Creators Collection</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2549971">Калекцыя ад стваральнікаў</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4512_145048_2296475"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A search method that lets you direct your search using conversational language.</descrip></descripGrp><ntig><termGrp><term id="145048">natural language searching</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><n