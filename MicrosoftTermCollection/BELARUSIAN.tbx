/ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1573508">Катэгорыі</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20861_748512_1772833"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows the user to apply custom or default markers to items (e.g. Outlook messages or OneNote content) in order to categorize information for easy retrieval and sorting.</descrip></descripGrp><ntig><termGrp><term id="748512">Tags</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1772833">Цэтлікі</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20861_748513_1573508"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows the user to apply custom or default markers to items (e.g. Outlook messages or OneNote content) in order to categorize information for easy retrieval and sorting.</descrip></descripGrp><ntig><termGrp><term id="748513">Categories</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1573508">Катэгорыі</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20861_748513_1772833"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows the user to apply custom or default markers to items (e.g. Outlook messages or OneNote content) in order to categorize information for easy retrieval and sorting.</descrip></descripGrp><ntig><termGrp><term id="748513">Categories</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1772833">Цэтлікі</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20865_748916_2080562"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in Internet Explorer that helps detect phishing websites and can help protect you from installing malicious software or malware.</descrip></descripGrp><ntig><termGrp><term id="748916">SmartScreen Filter</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2080562">фільтр SmartScreen</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20867_2676671_2678645"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that allows the user to fill cells with data that follows a pattern or that is based on data in other cells.</descrip></descripGrp><ntig><termGrp><term id="2676671">AutoFill</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2678645">Аўтазапаўненне</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20867_752822_2678645"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that allows the user to fill cells with data that follows a pattern or that is based on data in other cells.</descrip></descripGrp><ntig><termGrp><term id="752822">Auto Fill</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2678645">Аўтазапаўненне</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2087_22056_1806177"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A page where there is no information displayed</descrip></descripGrp><ntig><termGrp><term id="22056">blank page</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1806177">пустая старонка</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20874_757176_1864748"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tool used to turn on language-specific options for the languages one wants to use with a product.</descrip></descripGrp><ntig><termGrp><term id="757176">Language Settings tool</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1864748">Моўныя налады</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20883_759067_2296675"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of creating and sending text messages between or to mobile phones and devices using the SMS protocol.</descrip></descripGrp><ntig><termGrp><term id="759067">text messaging</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296675">абмен тэкставымі паведамленнямі</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20884_759071_1778297"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Any hardware or software that can detect events or environmental changes, such as your current location or the amount of light around your computer. For example, a notebook with a location sensor, such as a Global Positioning System (GPS) receiver, can determine your exact location. An ambient light sensor can detect when there is a change in lighting, and then a program can use that information to adjust the brightness of your screen.</descrip></descripGrp><ntig><termGrp><term id="759071">sensor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1778297">датчык</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20888_759108_1790778"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A device that includes an antenna, a radio receiver, and a processor for use with the worldwide GPS (Global Positioning System). A GPS receiver uses position and time information from four GPS satellites to calculate precise information about its current location, its speed of travel, and the current time.</descrip></descripGrp><ntig><termGrp><term id="759108">GPS receiver</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1790778">GPS-прыёмнік</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20889_759109_1772773"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A category of sensor that can detect the current location of your computer.</descrip></descripGrp><ntig><termGrp><term id="759109">location sensor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1772773">датчык месцазнаходжання</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20907_759640_1772772"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An area within the Windows Control Panel that provides support for sensors such as enabling, disabling or uninstalling sensors and sensor-enabled applications, changing sensor settings, etc.</descrip></descripGrp><ntig><termGrp><term id="759640">Location and Other Sensors</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1772772">Датчык месцазнаходжання і іншыя датчыкі</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2091_50057_1573649"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A unit of information within a markup language that is defined by a tag, or a pair of tags surrounding some content, and includes any attributes defined within the initial tag.</descrip></descripGrp><ntig><termGrp><term id="50057">element</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1573649">элемент</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20916_759739_1791641"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An arrangement of search results ordered by relevance using a special search algorithm.</descrip></descripGrp><ntig><termGrp><term id="759739">top results</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1791641">найлепшыя вынікі</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20936_760098_2107778"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A radio navigation system developed by the U.S. Department of Defense that uses a constellation of 24 earth satellites, which are monitored by ground-based control stations, to provide precise, continuous worldwide positioning and timing information.</descrip></descripGrp><ntig><termGrp><term id="760098">Global Positioning System</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2107778">GPS</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20936_760099_2107778"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A radio navigation system developed by the U.S. Department of Defense that uses a constellation of 24 earth satellites, which are monitored by ground-based control stations, to provide precise, continuous worldwide positioning and timing information.</descrip></descripGrp><ntig><termGrp><term id="760099">GPS</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2107778">GPS</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig><