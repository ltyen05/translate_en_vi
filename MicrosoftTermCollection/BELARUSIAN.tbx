Note><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2050281">карта змесціва</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35500_2037509_2763180"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The opt-in release track that gives Office 365 tenant admins the ability to decide whether users in their organization receive new features as soon as they are released by Microsoft.</descrip></descripGrp><ntig><termGrp><term id="2037509">Office 365 First Release program</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2763180">Першы выпуск</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35500_2760467_2763180"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The opt-in release track that gives Office 365 tenant admins the ability to decide whether users in their organization receive new features as soon as they are released by Microsoft.</descrip></descripGrp><ntig><termGrp><term id="2760467">First Release</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2763180">Першы выпуск</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35532_2037736_2542734"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The all-in-one entertainment system from Microsoft.</descrip></descripGrp><ntig><termGrp><term id="2037736">Xbox One</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2542734">Xbox One</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35556_2039229_2542670"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Trigger buttons on the Xbox One controller that can be made to vibrate, giving the player haptic feedback.</descrip></descripGrp><ntig><termGrp><term id="2039229">Impulse Triggers</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2542670">Імпульсныя пераключальнікі</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35557_2039230_2542683"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The button on the Xbox One controller and remote control that invokes Xbox help and other options from within an app or game.</descrip></descripGrp><ntig><termGrp><term id="2039230">Menu button</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2542683">Кнопка меню</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35558_2039231_2542722"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The button on the Xbox One controller and remote control that provides a different view or perspective in a game or app, such as a map view or health status.</descrip></descripGrp><ntig><termGrp><term id="2039231">View button</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2542722">Кнопка прагляду</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35559_2039232_2542725"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The button on the Xbox One controller and remote control that returns focus to Home, as well as turning on and off the console.</descrip></descripGrp><ntig><termGrp><term id="2039232">Xbox button</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2542725">Кнопка Xbox</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35563_2039552_2050283"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables users to send content via email to their OneNote notebooks. Users must first enable th