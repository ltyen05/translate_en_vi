><descripGrp><descrip type="definition">A trojan that records user activity, such as keystrokes, and that can send this information to an attacker using email or other methods.</descrip></descripGrp><ntig><termGrp><term id="2488684">key logger</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2718582">клавіятурны шпіён</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12103_297183_2718582"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A trojan that records user activity, such as keystrokes, and that can send this information to an attacker using email or other methods.</descrip></descripGrp><ntig><termGrp><term id="297183">keylogger</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2718582">клавіятурны шпіён</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12106_65506_1573764"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To displace the left or right edge of a text item, such as a block or a line, relative to the margin or to another text item.</descrip></descripGrp><ntig><termGrp><term id="65506">indent</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1573764">адступаць</term><termNote type="geographicalUsage">BLR</termNo