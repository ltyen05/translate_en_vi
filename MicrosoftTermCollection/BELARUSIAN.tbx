at automatically recovers content if the user's program or computer malfunctions.</descrip></descripGrp><ntig><termGrp><term id="2409385">AutoRecovery</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2417370">Аўтаматычнае аднаўленне</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14821_234960_1790776"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A lightweight and task-specific add-in program that integrates with applications to expose data at a glance.</descrip></descripGrp><ntig><termGrp><term id="234960">gadget</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1790776">гаджэт</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14822_187314_2182122"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The amount of storage space available for storing and processing on a disc.</descrip></descripGrp><ntig><termGrp><term id="187314">disk space</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2182122">месца на дыску</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termN