</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296320">група</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="47920_2700296_2700764"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To use some means of authentication to access the full functionality of a device or data.</descrip></descripGrp><ntig><termGrp><term id="2700296">unlock</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2700764">разблакіраваць</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="47921_2700297_2700763"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to being protected against cyber attack and cyber threats.</descrip></descripGrp><ntig><termGrp><term id="2700297">secure</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2700763">бяспечны</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="47923_2700684_2702060"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A visual representation of an object.</descrip></descripGrp><ntig><termGrp><term id="2700684">symbol</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2702060">сімвал</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="47926_2701271_2703132"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office 365 Security &amp; Compliance Center feature that allows admins to manage mobile device access to company data, manage data loss, helps them protect the company from inbound and outbound malicious software and spam, and that helps them determine if senders are maliciously spoofing accounts from their domain.</descrip></descripGrp><ntig><termGrp><term id="2701271">Threat management</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2703132">Кіраванне пагрозамі</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="47930_2701275_2703130"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An email whose purpose is to scam users, steal their data, or take control of their devices.</descrip></descripGrp><ntig><termGrp><term id="2701275">malicious mail</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2703130">шкоднае паведамленне</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech"