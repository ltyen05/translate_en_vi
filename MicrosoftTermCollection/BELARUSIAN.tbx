e><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20655_732027_1864741"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A button that replaces the File menu beginning with some 2007 Microsoft Office system programs.</descrip></descripGrp><ntig><termGrp><term id="732027">Microsoft Office Button</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1864741">кнопка Office</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20655_747784_1864736"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A button that replaces the File menu beginning with some 2007 Microsoft Office system programs.</descrip></descripGrp><ntig><termGrp><term id="747784">Office Button</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1864736">кнопка Microsoft Office</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20655_747784_1864741"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A button that replaces the File menu beginning with some 2007 Microsoft Office system programs.</descrip></descripGrp><ntig><termGrp><term id="747784">Office Button</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1864741">кнопка Office</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20659_739397_1816298"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A series of digital-media files that users can subscribe to online, that are sent to their computers or mobile devices and that can then be accessed on demand on the users' reader.</descrip></descripGrp><ntig><termGrp><term id="739397">podcast</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1816298">падкаст</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20673_741964_2296585"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mailbox that represents conference rooms and company equipment. Resource mailboxes can be included as resources in meeting requests, providing a simple and efficient way to utilize resources for an organization. The user account that is associated with a resource mailbox is disabled.</descrip></descripGrp><ntig><termGrp><term id="741964">resource mailbox</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296585">паштовая скрынка рэсурсу</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20675_743746_2296731"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To monitor an email conversation or newsgroup thread. The headers for messages in a watched conversation appear in a different color, which makes them easier to find in a message list.</descrip></descripGrp><ntig><termGrp><term id="743746">watch</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296731">сачыць</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20683_745706_1806377"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An option on the Views menu in File Explorer that shows the most appropriate details for the file type in a flexible layout rather than only showing the details associated with the column headers in the view.</descrip></descripGrp><ntig><termGrp><term id="745706">Content</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1806377">Змесціва</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20689_2356132_2359376"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature in Control Panel that provides the user with a single point of entry for tasks and notifications related to security and general PC software maintenance.</descrip></descripGrp><ntig><termGrp><term id="2356132">Security and Maintenance</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2359376">Бяспека і абслугоўванне</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20695_746372_1864737"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A gallery that allows users to create a quick rule to move mail to a selected folder based on the sender, recipients, or conversation of the currently selected email message without opening the full Create Rule dialog.</descrip></descripGrp><ntig><termGrp><term id="746372">Always Move gallery</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1864737">хуткае перамяшчэнне</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20697_777440_1573748"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of computers on a home network that can share pictures, music, videos, documents, and printers. A homegroup is created by using the HomeGroup feature; it is protected with a password.</descrip></descripGrp><ntig><termGrp><term id="777440">homegroup</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1573748">хатняя група</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20698_782774_1772758"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A password that helps prevent unauthorized access to homegroup files and printers.</descrip></descripGrp><ntig><termGrp><term id="782774">homegroup password</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1772758">пароль хатняй групы</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20703_746420_1573527"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An action that removes redundant messages from an email conversation to reduce information overload and improve readability.</descrip></descripGrp><ntig><termGrp><term id="746420">Clean Up</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1573527">Ачысціць</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20704_746421_1864738"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A fork within a conversation, where more than one reply was made to a single email and caused a split in the conversation.</descrip></descripGrp><ntig><termGrp><term id="746421">branch</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1864738">галіна</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20707_1805810_2057397"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An instant message session with multiple parties, exchanged via IM (not through your mobile operator).</descrip></descripGrp><ntig><termGrp><term id="1805810">group conversation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2057397">групавы чат</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20707_1805810_2057398"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An instant message session with multiple parties, exchanged via IM (not through your mobile operator).</descrip></descripGrp><ntig><termGrp><term id="1805810">group conversation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2057398">групавая размова</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20707_1805810_2057399"><langSe