ig><termGrp><term id="1791193">Прайграванне на прыладзе</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23601_2328434_2333429"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that allows users to stream music, images or videos to a specific device on their home network.</descrip></descripGrp><ntig><termGrp><term id="2328434">Cast to Device</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2333429">Вяшчанне на прыладу</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23618_1088724_1779921"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To enter information by means of the keyboard or other input method.</descrip></descripGrp><ntig><termGrp><term id="1088724">enter</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1779921">увесці</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2363_95503_1574002"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An attribute of an object that is used to define its state, appearance, or value.</descrip></descripGrp><ntig><termGrp><term id="95503">property</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1574002">уласцівасць</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23657_1088805_2296205"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In computer systems, a reduction in level of performance or service. Degradation in microcomputer performance is indicated by slow response times or frequent pauses for disk access because memory is insufficient to hold an entire program plus the data the program is using.</descrip></descripGrp><ntig><termGrp><term id="1088805">degradation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296205">дэградацыя</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2366_52839_2433193"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of adding depth to a two-dimensional shape to create a three-dimensional object.</descrip></descripGrp><ntig><termGrp><term id="52839">extrusion</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2433193">экструзія</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23692_1088842_2752329"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of test cases and their associated test configuration information and the iteration when it is planned to run these tests.</descrip></descripGrp><ntig><termGrp><term id="1088842">test plan</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2752329">план праверкі</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23692_2749693_2752329"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of test cases and their associated test configuration information and the iteration when it is planned to run these tests.</descrip></descripGrp><ntig><termGrp><term id="2749693">validation plan</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2752329">план праверкі</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23717_1088887_1864883"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of conditional formatting that is configured within Microsoft SQL Server Analysis Services.</descrip></descripGrp><ntig><termGrp><term id="1088887">data source formatting</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1864883">фарматаванне сервера OLAP</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23717_1089137_1864883"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of conditional formatting that is configured within Microsoft SQL Server Analysis Services.</descrip></descripGrp><ntig><termGrp><term id="1089137">OLAP server formatting</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1864883">фарматаванне сервера OLAP</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23727_1088926_1806385"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A site element that stores and displays a collection of data that team members and other site users can share.</descrip></descripGrp><ntig><termGrp><term id="1088926">SharePoint list</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1806385">спіс</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23727_1088926_2296627"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A site element that stores and displays a collection of data that team members and other site users can share.</descrip></descripGrp><ntig><termGrp><term id="1088926">SharePoint list</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296627">спіс SharePoint</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23727_1088927_1806385"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A site element that stores and displays a collection of data that team members and other site users can share.</descrip></descripGrp><ntig><termGrp><term id="1088927">list</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1806385">спіс</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23727_1088927_2296627"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A site element that stores and displays a collection of data that team members and other site users can share.</descrip></descripGrp><ntig><termGrp><term id="1088927">list</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296627">спіс SharePoint</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23766_1089518_2766681"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A computer, either physical or virtual, capable of processing information to produce a desired result.</descrip></descripGrp><ntig><termGrp><term id="1089518">machine</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2766681">камп'ютар</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2378_17347_2296091"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to, or characteristic of, a DNS server that hosts a primary or secondary copy of a DNS zone. When a DNS server is configured to host a zone, it is said to be authoritative for names within that zone.</descrip></descripGrp><ntig><termGrp><term id="17347">authoritative server</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296091">паўнамоцны сервер</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="238_41773_2296184"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Exchange 5.5 and earlier, a custom recipient is a user who is not hosted by Exchange. In Exchange 2003, such users can be added to Active Directory as contacts, Windows users, or users whose Windows accounts are disabled. In any case, they are mail-enabled, but not mailbox-enabled, because their mailboxes are hosted on another messaging system.</descrip></descripGrp><ntig><termGrp><term id="41773">custom recipient</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296184">знешні атрымальнік</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2382_231960_1864411"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method of summarizing values in the data area of a PivotTable report by using the values in other cells in the data area. Use the Show data as list on the PivotTable Field dialog for a data field to create custom calculations.</descrip></descripGrp><ntig><termGrp><term id="231960">custom calculation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1864411">налаждвальныя вылічэнні</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23840_1091236_1864884"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A video clip that has been inserted into another file or Web page.</descrip></descripGrp><ntig><termGrp><term id="1091236">embedded video clip</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1864884">укаранёны відэакліп</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23841_1091237_1864885"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An audio clip that has been inserted into another file or Web page.</descrip></descripGrp><ntig><termGrp><term id="1091237">embedded audio clip</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1864885">укаранёны аўдыёкліп</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23864_1091326_1971498"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A standard control that resembles a notebook and lets the user navigate different sections of information without leaving the current element on the screen.</descrip></descripGrp><ntig><termGrp><term id="1091326">tab control</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1971498">набор укладак</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23869_1091332_2816764"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In mathematics, an item that is multiplied in a multiplication problem; for example, 2 and 3 are factors in the problem 2 x 3. The prime factors of a number are a set of prime numbers that, when multiplied together, produce the number.</descrip></descripGrp><ntig><termGrp><term id="1091332">factor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2816764">множнік</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23871_1091334_2296035"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An ability to view data or navigate to or within a physical or virtual computer environment.</descrip></descripGrp><ntig><termGrp><term id="1091334">access</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296035">доступ</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23872_1091335_2296132"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An account holder who is a family member, but not a parent, and who has limited use of the Internet. Children can view their own settings, but they can't change them.</descrip></descripGrp><ntig><termGrp><term id="1091335">child</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296132">дзіця</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23874_1091337_2296294"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An account holder who is the primary administrator (parent) and the family members they manage.</descrip></descripGrp><ntig><termGrp><term id="1091337">family</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296294">сям'я</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23875_1091338_1573405"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To combine thereby increasing the quantity or size of something.</descrip></descripGrp><ntig><termGrp><term id="1091338">add</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1573405">дадаць</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23876_1091339_2296432"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To adjust the action or aspects of a group of items, typically done more than once.</descrip></descripGrp><ntig><termGrp><term id="1091339">manage</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296432">кіраваць</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2388_415516_1864587"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A name assigned to a cell or group of cells.</descrip></descripGrp><ntig><termGrp><term id="415516">range name</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1864587">імя дыяпазону</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="239_252121_1864512"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A combination of list formatting options identified by a style name.</descrip></descripGrp><ntig><termGrp><term id="252121">list style</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1864512">стыль спісу</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23919_1092267_1599392"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A “software-plus-services” platform and experience that enables PCs and other devices to “come alive” by making them aware of each other through the Internet, enabling individuals and organizations to manage, access, and share their files and applications seamlessly on the Web and across their world of devices.</descrip></descripGrp><ntig><termGrp><term id="1092267">Live Mesh</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1599392">Live Mesh</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23919_1379736_1599392"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A “software-plus-services” platform and experience that enables PCs and other devices to “come alive” by making them aware of each other through the Internet, enabling individuals and organizations to manage, access, and share their files and applications seamlessly on the Web and across their world of devices.</descrip></descripGrp><ntig><termGrp><term id="1379736">Windows Live Mesh</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1599392">Live Mesh</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23935_1092702_2296609"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The value that is to be searched for in a document or any collection of data.</descrip></descripGrp><ntig><termGrp><term id="1092702">search key</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296609">ключ пошуку</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23957_1092760_2851496"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In communications, a channel connecting two switching stations. A trunk usually carries a large number of calls at the same time.</descrip></descripGrp><ntig><termGrp><term id="1092760">trunk</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2851496">лінія сувязі</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23957_1092760_2851497"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In communications, a channel connecting two switching stations. A trunk usually carries a large number of calls at the same time.</descrip></descripGrp><ntig><termGrp><term id="1092760">trunk</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2851497">лінія галасавой сувязі</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23957_2843750_2851496"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In communications, a channel connecting two switching stations. A trunk usually carries a large number of calls at the same time.</descrip></descripGrp><ntig><termGrp><term id="2843750">voice trunk</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2851496">лінія сувязі</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">