partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2388119">бал</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2767_226561_2388119"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A value that is used in Microsoft Points to enable efficient micropayments and prepaid purchase for cash based consumers (including kids/teens, as well as emerging and developing markets) and provide a mechanism to directly reward loyal customers.</descrip></descripGrp><ntig><termGrp><term id="226561">p</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2388119">бал</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27686_1404155_2296144"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to operations that take place within the cloud.</descrip></descripGrp><ntig><termGrp><term id="1404155">cloud-based</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296144">воблачны</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2771_28634_1573507"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A directory of information about data sets, files, or a database. It usually describes where a data set, file or database entity is located and may also include other information, such as the type of device on which each data set or file is stored.</descrip></descripGrp><ntig><termGrp><term id="28634">catalog</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1573507">каталог</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27728_2027119_2032406"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A folder that's automatically added to OneDrive when photos are uploaded from Windows Phone.</descrip></descripGrp><ntig><termGrp><term id="2027119">OneDrive camera roll</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2032406">галерэя камеры OneDrive</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27742_1427142_2743695"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To share a PowerPoint presentation, where only the PowerPoint document is shown and only the presenter can edit the content being presented.</descrip></descripGrp><ntig><termGrp><term id="1427142">present</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><la