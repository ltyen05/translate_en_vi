></termEntry><termEntry id="11351_10952_1573420"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The consistent positioning of text, graphics, and other objects.</descrip></descripGrp><ntig><termGrp><term id="10952">alignment</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1573420">выраўноўванне</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11362_232517_1864456"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A virtual shape that contains default formatting properties for new shapes. Each presentation contains one default shape.</descrip></descripGrp><ntig><termGrp><term id="232517">default shape</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1864456">фігура па змаўчанні</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11363_359696_1770272"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The degree to which a product or service executes its specified function.</descrip></descripGrp><ntig><termGrp><term id="359696">performance</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1770272">прадукцыйнасць</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote ty