pe="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45585_2569600_2575599"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To remove association from two or more pieces of information.</descrip></descripGrp><ntig><termGrp><term id="2569600">unbind</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2575599">скасаваць прывязку</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45586_2569602_2583063"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft-owned company that has created the world's largest professional network on the Internet.</descrip></descripGrp><ntig><termGrp><term id="2569602">LinkedIn</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2583063">LinkedIn</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45587_2569603_2578593"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An effect that makes an image appear as if drawn with a pencil.</descrip></descripGrp><ntig><termGrp><term id="2569603">pencil effect</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNo