ermEntry><termEntry id="44227_2485133_2488196"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The trial version of Visio Pro for Office 365.</descrip></descripGrp><ntig><termGrp><term id="2485133">Visio Pro for Office 365 Trial</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2488196">Visio Pro для Office 365 (пробная версія)</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44236_2485603_2489742"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The email search client that provides autocomplete, spell correct, fuzzy name search and that provides relevance-based and time-ordered results.</descrip></descripGrp><ntig><termGrp><term id="2485603">Email Insights</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2489742">Email Insights</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44238_2485689_2488192"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of design components with a consistent aesthetic theme and with consistent patterns that convey meaning to users.</descrip></descripGrp><ntig><termGrp><term id="2485689">design language</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2488192">мова дызайну</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44239_2485690_2488193"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The design language used for all products in Office 365 and SharePoint.</descrip></descripGrp><ntig><termGrp><term id="2485690">Office Design Language</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2488193">мова дызайну Office</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44240_2485691_2486557"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The open-source, front-end framework, written in Fluent Design, for designing and building experiences that fit seamlessly into a broad range of Microsoft 365 products.</descrip></descripGrp><ntig><termGrp><term id="2485691">Office UI Fabric</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2486557">Office UI Fabric</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44241_2485693_2486558"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The front-end package that is part of Office UI Fabric and that contains the core building blocks of the Office Design Language.</descrip></descripGrp><ntig><termGrp><term id="2485693">Office UI Fabric Core</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2486558">Office UI Fabric Core</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44242_2485694_2486559"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The front-end package that is part of Office UI Fabric and that contains a set of React components.</descrip></descripGrp><ntig><termGrp><term id="2485694">Office UI Fabric React</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2486559">Office UI Fabric React</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44243_2485701_2488191"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The warning that Excel displays when a function cannot be executed because configuration or user settings block certain functionality, such as accessing data over the internet.</descrip></descripGrp><ntig><termGrp><term id="2485701">#BLOCKED!</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2488191">#ЗАБЛАКІРАВАНА!</term><termNote type="geographicalUsage">BLR</termNote><termNo