61_2542690"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The area within the Kinect sensor's field of view is able to detect a person or in which a player moves.</descrip></descripGrp><ntig><termGrp><term id="1991461">play space</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2542690">прастора для гульні</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34389_1991499_2542651"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The button on both the wireless controller and the console used to make a permanent attachment between the controller and console.</descrip></descripGrp><ntig><termGrp><term id="1991499">connect button</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2542651">кнопка падключэння</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34395_1991505_2542721"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Gameplay feedback produced by the controller motor. Do not use rumble.</descrip></descripGrp><ntig><termGrp><term id="1991505">vibration</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2542721">вібрацыя</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</term