term id="1637192">task path</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1865127">шлях задач</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32157_1637193_1865128"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A streamlined process for sharing Office documents with others.</descrip></descripGrp><ntig><termGrp><term id="1637193">simplified sharing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1865128">спрошчаны сумесны доступ</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32159_1637282_1865130"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A website that provides content and resources to help developers create custom solutions for SharePoint Foundation, SharePoint Server and SharePoint Designer.</descrip></descripGrp><ntig><termGrp><term id="1637282">SharePoint Developer Center</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1865130">Цэнтр распрацоўшчыка SharePoint</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32160_1637588_1865131"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process that converts a PDF file to flowing text and document elements that are native to the application being used.</descrip></descripGrp><ntig><termGrp><term id="1637588">PDF reflow</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1865131">Зваротнае пераўтварэнне PDF</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32161_1637594_1865132"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SharePoint shared service that aggregates tasks that systems such as SharePoint, Project Server, and Exchange assign to users.</descrip></descripGrp><ntig><termGrp><term id="1637594">Work Management Service</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1865132">Служба кiравання працай</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32162_1637597_1865133"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A component of the Work Management Service that synchronizes tasks with systems outside of SharePoint, such as an Exchange mailbox, to enable task management in Outlook.</descrip></descripGrp><ntig><termGrp><term id="1637597">Work Management Task Sync</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termG