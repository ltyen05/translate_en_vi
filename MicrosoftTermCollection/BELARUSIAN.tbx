igning data relative to the margin or indent. If you change the margin/indent, the text is realigned automatically.</descrip></descripGrp><ntig><termGrp><term id="1275408">alignment tab</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1864967">сімвал табуляцыі для выраўноўвання</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26508_1275542_2296103"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of logging available to capture information about mailbox searches that includes information about the search and who performed it.</descrip></descripGrp><ntig><termGrp><term id="1275542">basic logging</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296103">базавае вядзенне журнала</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26509_1275544_2296312"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of logging available to capture information about mailbox searches that includes information about all results that meet the search criteria.</descrip></descripGrp><ntig><termGrp><term id="1275544">full logging</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296312">поўнае вядзенне журнала</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26510_1275547_2296113"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A window that serves as an interface between the user and the browser.</descrip></descripGrp><ntig><termGrp><term id="1275547">browser window</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296113">акно браўзера</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26511_1275548_2296114"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A role group that ships by default as opposed to a customized role group that a admin would customize specifically for the needs of their organization</descrip></descripGrp><ntig><termGrp><term id="1275548">built-in role group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296114">убудаваная група роляў</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26513_1275552_2296333"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Identity Lifecycle Management (ILM) component that consists of properties, rules, and rule extensions that determine how an object is processed and that provides services to client computers or organizations that connect from remote locations.</descrip></descripGrp><ntig><termGrp><term id="1275552">hosted management agent</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296333">размешчаны агент кіравання</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26515_1275576_2296424"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An instance of a multi-mailbox search.</descrip></descripGrp><ntig><termGrp><term id="1275576">mailbox search</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296424">пошук у паштовых скрынках</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26522_1275648_2296499"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The messaging system that an administrator runs on their own servers in their own company as compared to a messaging system that is run in the cloud (hosted).</descrip></descripGrp><ntig><termGrp><term id="1275648">on-premises messaging system</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296499">лакальная сістэма абмену паведамленнямі</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26524_1275651_2296531"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An account that can receive mail using the POP3 protocol.</descrip></descripGrp><ntig><termGrp><term id="1275651">POP-enabled account</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296531">уліковы запіс з падтрымкай POP</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26525_1275652_2296538"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The email address that appears in the E-Mail Options section of the user's mailbox in the Web management interface for Outlook Live.</descrip></descripGrp><ntig><termGrp><term id="1275652">primary e-mail address</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296538">асноўны адрас электроннай пошты</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26526_1275654_2296567"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An object that represents a user or resource in Outlook, generally a mail message addressee.</descrip></descripGrp><ntig><termGrp><term id="1275654">recipient object</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termG