mNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1573819">Мова праграм, якія не падтрымліваюць Юнікод</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10799_212211_1573819"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Regional and Language Options setting that specifies the default code pages and associated bitmap font files for a specific computer that affects all of that computer's users. The default code pages and fonts enable a non-Unicode application written for one operating system language version to run correctly on another operating system language version.</descrip></descripGrp><ntig><termGrp><term id="212211">Language for non-Unicode programs</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1573819">Мова праграм, якія не падтрымліваюць Юнікод</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1082_27628_1573499"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A toggle key that, when on, shifts the alphabetic characters on the keyboard to uppercase.</descrip></descripGrp><ntig><termGrp><term id="27628">CAPS LOCK</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1573499">CAPS LOCK</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1082_27628_1573500"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A toggle key that, when on, shifts the alphabetic characters on the keyboard to uppercase.</descrip></descripGrp><ntig><termGrp><term id="27628">CAPS LOCK</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1573500">клавіша CAPS LOCK</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1082_27629_1573499"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A toggle key that, when on, shifts the alphabetic characters on the keyboard to uppercase.</descrip></descripGrp><ntig><termGrp><term id="27629">CAPS LOCK key</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1573499">CAPS LOCK</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1082_27629_1573500"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A toggle key that, when on, shifts the alphabetic characters on the keyboard to uppercase.</descrip></descripGrp><ntig><termGrp><term id="27629">CAPS LOCK key</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1573500">клавіша CAPS LOCK</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10824_139748_2072186"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The list of animation sequences for a slide. Items are listed in the order in which they are added, and include icons that indicate timing in relation to other animation events.</descrip></descripGrp><ntig><termGrp><term id="139748">Custom Animation list</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2072186">Спіс карыстальніцкай анімацыі</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10828_245217_1573415"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A monitoring option in real-time spyware protection that monitors various types and areas of software activity on your computer.</descrip></descripGrp><ntig><termGrp><term id="245217">agent</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1573415">агент</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10839_2108_1791640"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A row, column, or block of buttons or icons, usually displayed across the top of the screen, that represent tasks or commands within the program. The toolbar buttons provide shortcuts to common tasks frequently accessed from the menus.</descrip></descripGrp><ntig><termGrp><term id="2108">toolbar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1791640">панэль інструментаў</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10853_14662_1864085"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A formula that performs multiple calculations on one or more sets of values, and then returns either a single result or multiple results.</descrip></descripGrp><ntig><termGrp><term id="14662">array formula</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1864085">формула масіву</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10862_558778_2392163"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A digital image file that contains unprocessed data from the camera's sensors.</descrip></descripGrp><ntig><termGrp><term id="558778">RAW file</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2392163">raw-файл</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10864_141438_1864252"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A chart that is placed on a worksheet rather than on a separate chart sheet. Embedded charts are beneficial when you want to view or print a chart or a PivotChart report with its source data or other information in a worksheet.</descrip></descripGrp><ntig><termGrp><term id="141438">embedded chart</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1864252">укаранёная дыяграма</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10871_30752_1806181"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A graphic or diagram that displays data or the relationships between sets of data in pictorial rather than numeric form.</descrip></descripGrp><ntig><termGrp><term id="30752">chart</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1806181">дыяграма</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10894_225713_1790759"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A list that can be opened to reveal all choices for a given field.</descrip></descripGrp><ntig><termGrp><term id="225713">drop-down list</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1790759">выпадны спіс</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10894_475180_1790759"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A list that can be opened to reveal all choices for a given field.</descrip></descripGrp><ntig><termGrp><term id="475180">picklist</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1790759">выпадны спіс</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10894_721653_1790759"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A list that can be opened to reveal all choices for a given field.</descrip></descripGrp><ntig><termGrp><term id="721653">dropdown list</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1790759">выпадны спіс</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10903_334532_1573526"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A category of objects that share a common set of characteristics.</descrip></descripGrp><ntig><termGrp><term id="334532">class</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1573526">клас</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10903_86004_1573526"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A category of objects that share a common set of characteristics.</descrip></descripGrp><ntig><termGrp><term id="86004">object class</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1573526">клас</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10909_127144_1574213"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A quantity assigned to an element such as a variable, symbol, or label.</descrip></descripGrp><ntig><termGrp><term id="127144">value</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1574213">значэнне</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10916_338545_1772817"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To store data in such a way that it can be retrieved later by the same security support component, and only by that security support component.</descrip></descripGrp><ntig><termGrp><term id="338545">seal</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1772817">запячатаць</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10918_20790_2851476"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To measure the performance of something according to specified standards in order to improve it.</descrip></descripGrp><ntig><termGrp><term id="20790">benchmark</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2851476">праводзіць параўнаўчы тэст</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10928_359996_2296409"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A table, query, form, report, macro, or module that remains in the replica or Design Master where it was created. Neither the object nor changes to the object are copied to other members in the replica set.</descrip></descripGrp><ntig><termGrp><term id="359996">local object</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296409">лакальны аб'ект</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10934_237291_1864502"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An option that applies a read-only state to a document inside client applications.</descrip></descripGrp><ntig><termGrp><term id="237291">Mark as Final</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1864502">Пазначыць як канчатковы</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10935_54757_1573692"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To associate a flag with a message or other item.</descrip></descripGrp><ntig><termGrp><term id="54757">flag</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1573692">пазначыць</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10945_139125_1864220"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A software program that reduces a file's size for storage on a disk. If a compressed file is too large to fit onto a single disk, the compression utility copies it onto multiple disks.</descrip></descripGrp><ntig><termGrp><term id="139125">compression utility</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1864220">службовая праграма для сціску</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10947_320488_1573788"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Erroneous or unrecognizable because of a flaw in reasoning or an error in input. Invalid results, for example, might occur if the logic in a program is faulty.</descrip></descripGrp><ntig><termGrp><term id="320488">not valid</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1573788">памылковы</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10947_70460_1573788"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Erroneous or unrecognizable because of a flaw in reasoning or an error in input. Invalid results, for example, might occur if the logic in a program is faulty.</descrip></descripGrp><ntig><termGrp><term id="70460">invalid</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1573788">памылковы</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10950_375738_1864574"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A computational proof that Outlook applies to outgoing messages to help recipient messaging systems distinguish legitimate email from junk email.</descrip></descripGrp><ntig><termGrp><term id="375738">Outlook E-Mail Postmark</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1864574">Штэмпель электроннай пошты Outlook</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10963_306412_1791142"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A menu item in Internet Explorer that turns on the tool for Tablet PC users that allows the user to move the content of the page up and down, like a mouse scroll wheel.</descrip></descripGrp><ntig><termGrp><term id="306412">Panning Hand</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1791142">ручка зрушэння</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1097_347909_1573481"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user’s private information such as temporary files, history, passwords, web form entries, and cookies that captures Internet surfing and other online activities.</descrip></descripGrp><ntig><termGrp><term id="347909">browsing history</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1573481">гісторыя праглядаў</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10975_307444_2296521"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A directory that receives RFC-822 compliant files from the file system for the purpose of creating message objects that can be passed to the Submission queue.</descrip></descripGrp><ntig><termGrp><term id="307444">Pickup directory</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296521">каталог раскладкі</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10976_232529_1864462"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The pane in normal view in which you type notes that you want to accompany a slide. You print these notes as notes pages or have them display when you save a presentation as a Web page.</descrip></descripGrp><ntig><termGrp><term id="232529">notes pane</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1864462">панэль нататак</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10982_117719_1574155"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The activities and actions performed by customer service representatives to assist customers.</descrip></descripGrp><ntig><termGrp><term id="117719">support</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1574155">падтрымка</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10984_47577_1816181"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In the Internet and other networks, the highest subdivision of a domain name in a network address, which identifies the type of entity owning the address (for example, .com for commercial users or .edu for educational institutions) or the geographical location of the address (for example, .fr for France or .sg for Singapore). The domain is the last part of the address (for example, www.acm.org).</descrip></descripGrp><ntig><termGrp><term id="47577">domain</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1816181">дамен</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10984_47577_2296680"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In the Internet and other networks, the highest subdivision of a domain name in a network address, which identifies the type of entity owning the address (for example, .com for commercial users or .edu for educational institutions) or the geographical location of the address (for example, .fr for France or .sg for Singapore). The domain is the last part of the address (for example, www.acm.org).</descrip></descripGrp><ntig><termGrp><term id="47577">domain</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296680">дамен верхняга ўзроўню</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10984_543592_1816181"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In the Internet and other networks, the highest subdivision of a domain name in a network address, which identifies the type of entity owning the address (for example, .com for commercial users or .edu for educational institutions) or the geographical location of the address (for example, .fr for France or .sg for Singapore). The domain is the last part of the address (for example, www.acm.org).</descrip></descripGrp><ntig><termGrp><term id="543592">top-level domain</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1816181">дамен</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10984_543592_2296680"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In the Internet and other networks, the highest subdivision of a domain name in a network address, which identi