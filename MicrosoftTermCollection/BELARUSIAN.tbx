 input focus.</descrip></descripGrp><ntig><termGrp><term id="27974">insertion point</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1573776">месца ўстаўкі</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11291_27975_1573776"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The location where text or graphics will be inserted. Also used for text box controls to indicate input focus.</descrip></descripGrp><ntig><termGrp><term id="27975">system caret</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1573776">месца ўстаўкі</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11300_307440_2296505"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that allows a Unified Messaging-enabled user to access their Microsoft Exchange Server mailbox over the telephone and navigate through their mailboxes by using telephone-key or speech input.</descrip></descripGrp><ntig><termGrp><term id="307440">Outlook Voice Access</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296505">Галасавы доступ да Outlook</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="gra