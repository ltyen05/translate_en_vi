Usage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12222_146338_1864315"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A field that is assigned a series orientation in a PivotChart report. In a chart, series are represented in the legend.</descrip></descripGrp><ntig><termGrp><term id="146338">PivotChart series field</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1864315">поле шэрагаў зводнай дыяграмы</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1223_147636_1860248"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A link that uses a relative URL.</descrip></descripGrp><ntig><termGrp><term id="147636">relative link</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1860248">адносная спасылка</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12232_334511_1816279"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A status that indicates that an active telephone call has been temporarily suspended.</descrip></descripGrp><ntig><termGrp><term id="334511">on hold</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected