ng files and displaying information.</descrip></descripGrp><ntig><termGrp><term id="49644">application program interface</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296077">праграмны інтэрфейс</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1124_49645_1573428"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of routines that an application uses to request and carry out lower-level services performed by a computer's or device's operating system. These routines usually carry out maintenance tasks such as managing files and displaying information.</descrip></descripGrp><ntig><termGrp><term id="49645">application programming interface</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1573428">API</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1124_49645_2296077"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of routines that an application uses to request and carry out lower-level services performed by a computer's or device's operating system. These routines usually carry out maintenance tasks such as managing files and displaying information.</descrip></descripGrp><ntig><termGrp><term id="49645">application programming interface</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></te