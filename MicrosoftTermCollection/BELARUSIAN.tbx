ype="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2364811">сезонны абанемент</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40703_2360428_2364816"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A library that contains your video files.</descrip></descripGrp><ntig><termGrp><term id="2360428">video library</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2364816">відэатэка</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40705_2360433_2364812"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The collection title for songs that are in the top N% of sales.</descrip></descripGrp><ntig><termGrp><term id="2360433">Top-selling songs</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2364812">Самыя хадавыя кампазіцыі</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40706_2360434_2364807"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The category in Windows Store Movies &amp; TV section that shows the movies and TV shows purchased and rented by you as well as your videos in Movies &amp; TV app.</descrip></descripGrp><ntig><termGrp><term id="2360434">My movies &amp; TV</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2364807">Мае фільмы і тэлеперадачы</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40707_2360435_2364809"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To order an item that is currently not available.</descrip></descripGrp><ntig><termGrp><term id="2360435">pre-order</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2364809">зрабіць перадзаказ</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4071_120587_1574169"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A measurement used for high-capacity data storage. One terabyte equals 240, or 1,099,511,627,776, bytes, although it is commonly interpreted as simply one trillion bytes.</descrip></descripGrp><ntig><termGrp><term id="120587">terabyte</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1574169">ТБ</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4071_211565_1574169"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A measurement used for high-capacity data storage. One terabyte equals 240, or 1,099,511,627,776, bytes, although it is commonly interpreted as simply one trillion bytes.</descrip></descripGrp><ntig><termGrp><term id="211565">TB</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1574169">ТБ</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40745_2362004_2367757"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The area in a Lync meeting where content is presented.</descrip></descripGrp><ntig><termGrp><term id="2362004">content stage</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2367757">вобласць змесціва</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40746_2362005_2367758"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In a Lync desktop sharing session, the owner of the session can give everyone in the session control, which means that participants can then work together in the same file or desktop and see each other’s changes immediately. Participants can "request," "take," "release," and "give back" control. Only one person can be "in control" at a time.</descrip></descripGrp><ntig><termGrp><term id="2362005">control</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2367758">кіраванне</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40748_2362007_2367760"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A named collection of contacts in the Contacts list.</descrip></descripGrp><ntig><termGrp><term id="2362007">group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2367760">група</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40749_2362008_2367761"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To remove yourself from a conference call that will continue without you.</descrip></descripGrp><ntig><termGrp><term id="2362008">leave call</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2367761">пакінуць канферэнц-выклік</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40751_2362010_2367763"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To rejoin a window back into an original window which it had been popped out from previously.</descrip></descripGrp><ntig><termGrp><term id="2362010">pop in</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2367763">прымацаваць</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40752_2362011_2367764"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To separate an area of a UI into a new window.</descrip></descripGrp><ntig><termGrp><term id="2362011">pop out</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2367764">адмацаваць</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40753_2362012_2367765"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows someone to share documents or applications with others. The user may also choose to give another person control of an application or the user's computer.</descrip></descripGrp><ntig><termGrp><term id="2362012">program sharing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2367765">сумеснае карыстанне</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40755_2362014_2367767"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The team responsible for administering use of a multiuser computer system, communications system, or both. A system administrator performs such duties as assigning user accounts and passwords, establishing security access levels, allocating storage space, and watching for unauthorized access.</descrip></descripGrp><ntig><termGrp><term id="2362014">support team</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2367767">група падтрымкі</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40756_2362015_2367768"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to contacts who are currently Offline.</descrip></descripGrp><ntig><termGrp><term id="2362015">unavailable</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2367768">недаступны</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40757_2362016_2367769"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Viewing the presentation asynchronously from what the presenter is presenting (i.e. "Presenter View").</descrip></descripGrp><ntig><termGrp><term id="2362016">view privately</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2367769">прагледзець у прыватным рэжыме</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="408_181420_1806263"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A database instance that makes data available for replication to other servers.</descrip></descripGrp><ntig><termGrp><term id="181420">publisher</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1806263">Публікатар</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="408_359265_1806263"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A database instance that makes data available for replication to other servers.</descrip></descripGrp><ntig><termGrp><term id="359265">publisher database</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1806263">Публікатар</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4090_81456_1573886"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A keyboard key that, when pressed (and held), changes the actions of ordinary input.</descrip></descripGrp><ntig><termGrp><term id="81456">modifier key</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1573886">службовая клавіша</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4092_817_1755601"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To transfer a copy of a file from a remote device to a requesting device by means of a modem or network.</descrip></descripGrp><ntig><termGrp><term id="817">download</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1755601">спампаваць</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4095_135262_1864691"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The third axis in a three-dimensional coordinate system, used in computer graphics to represent depth.</descrip></descripGrp><ntig><termGrp><term id="135262">z-axis</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1864691">вось шэрагаў</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4095_135262_1864722"><langSet xml:lang="en-US"><descri