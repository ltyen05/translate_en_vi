ch">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1860374">Табліца дадзеных</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31794_1623978_1865051"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The categories of assignments for a given class, along with a percentage value that indicates how much each category weighs into the overall grade. Other factors, such as class participation, may also be considered.</descrip></descripGrp><ntig><termGrp><term id="1623978">evaluation criteria</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1865051">крытэрый ацэнкі</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31795_1623979_1865052"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of refining a search for information by filtering on individual properties or facets of the items being searched.</descrip></descripGrp><ntig><termGrp><term id="1623979">faceted navigation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1865052">фасетная навігація</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp><