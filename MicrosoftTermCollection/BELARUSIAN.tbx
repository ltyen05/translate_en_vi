 type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29760_1510117_2072572"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The text string displayed in the status bar for Call Progress, alternating with the callee's name, to prompt the user that he/she can tap the bar to return to the call.</descrip></descripGrp><ntig><termGrp><term id="1510117">tap to expand</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2072572">даткніцеся, каб паказаць выклік</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29761_1510119_2072611"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The text strings that appears in the status bar when the user can switch between the active call and the call on hold.</descrip></descripGrp><ntig><termGrp><term id="1510119">tap to swap</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2072611">даткніцеся, каб пераключыць выклік</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29762_1510121_2072612"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The text string displayed in the status bar during a held call, alternating with the held