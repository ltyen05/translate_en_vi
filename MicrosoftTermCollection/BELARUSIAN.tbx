rtcuts to various folders.</descrip></descripGrp><ntig><termGrp><term id="1508829">Places Bar</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1865010">Панэль месцазнаходжання</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16175_477172_1865010"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An area at the left side in some dialog boxes, such as Save As, Open, and Insert Picture that contains shortcuts to various folders.</descrip></descripGrp><ntig><termGrp><term id="477172">My Places bar</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1865010">Панэль месцазнаходжання</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16176_143109_1864267"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A margin setting that adds extra space to the side or top margin of a document you plan to bind. A gutter margin ensures that text isn't obscured by the binding.</descrip></descripGrp><ntig><termGrp><term id="143109">gutter margin</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1864267">знешняе поле для вокладкі</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote 