try><termEntry id="4565_31042_1770518"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of finalizing a purchase on a website. For example, when customers shop on your website, they may select several items and save them in their shopping basket. When they have finished shopping, they click on a checkout link or graphical button that takes them to an online form where they enter their name, billing address, payment type, and shipping information.</descrip></descripGrp><ntig><termGrp><term id="31042">checkout</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1770518">завяршэнне пакупкі</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4567_232422_1864452"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The container in a navigation pane that contains shortcuts and shortcut groups.</descrip></descripGrp><ntig><termGrp><term id="232422">Shortcuts Pane</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1864452">Вобласць ярлыкоў</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45684_2573934_2575388"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The service that enables Skype users to make calls to (and receive calls from) mobile phones and landlines and send and receive SMS messages.</descrip></descripGrp><ntig><termGrp><term i