"geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46301_2607760_2678646"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The storage of data for meeting regulatory and business data archival requirements.</descrip></descripGrp><ntig><termGrp><term id="2607760">data retention</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2678646">захоўванне дадзеных</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46301_2607760_2678652"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The storage of data for meeting regulatory and business data archival requirements.</descrip></descripGrp><ntig><termGrp><term id="2607760">data retention</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2678652">захоўванне</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46301_2676908_2678646"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The storage of data for meeting regulatory and business data archival requirements.</descrip></descripGrp><ntig><termGrp><term id="2676908">retention</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></ter