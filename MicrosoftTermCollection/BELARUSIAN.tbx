en marked with a note tag.</descrip></descripGrp><ntig><termGrp><term id="359689">tagged note</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1864567">нататка з тэгам</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13142_111591_1574096"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A configuration parameter that controls the behavior of a service, application, feature, function, or a run-time environment.</descrip></descripGrp><ntig><termGrp><term id="111591">setting</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1574096">налада</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13147_91099_1573950"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A route through a structured collection of information, as in a database, a program, or files stored on disk.</descrip></descripGrp><ntig><termGrp><term id="91099">path</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1573950">шлях</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13151_318116_1864556"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To align text along the right margin.</descrip></descripGrp><ntig><termGrp><term id="318116">right align</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1864556">выраўнаваць па правым краі</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13159_34845_1806183"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The area in each row of a database table that stores the data value for some attribute of the object modeled by the table.</descrip></descripGrp><ntig><termGrp><term id="34845">column</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1806183">слупок</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13166_262640_1806291"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A title animation in Windows Movie Maker.</descrip></descripGrp><ntig><termGrp><term id="262640">Stretch</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1806291">Выцягванне</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13169_525_1864071"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The protection of information assets through the use of technology, processes, and training.</descrip></descripGrp><ntig><termGrp><term id="525">computer security</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1864071">камп'ютэрная бяспека</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13173_89953_1864146"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The point at which one page ends and another begins.</descrip></descripGrp><ntig><termGrp><term id="89953">page break</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1864146">разрыў старонкі</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13177_6456_2296033"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The full Internet address of a page or other World Wide Web resource. The absolute URL includes a protocol, such as "http," network location, and optional path and file name — for example, http://example.microsoft.com/.</descrip></descripGrp><ntig><termGrp><term id="6456">absolute URL</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296033">абсалютны URL-адрас</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13180_268854_1864535"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method computers use to send and receive email messages. It allows you to access email without downloading it to your computer or device.</descrip></descripGrp><ntig><termGrp><term id="268854">Internet Message Access Protocol</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1864535">пратакол IMAP</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13180_268863_1864535"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method computers use to send and receive email messages. It allows you to access email without downloading it to your computer or device.</descrip></descripGrp><ntig><termGrp><term id="268863">IMAP</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1864535">пратакол IMAP</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13181_232398_1864436"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Microsoft Exchange mailbox that allocates a specific number of connections. The resource serves as a virtual room for your online meeting. You invite the resource to an online meeting just as you would reserve a room for a meeting.</descrip></descripGrp><ntig><termGrp><term id="232398">conference resource</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1864436">рэсурс канферэнц-сувязі</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13196_318732_1573898"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A menu choice or remote button that offers access to the user's video library.</descrip></descripGrp><ntig><termGrp><term id="318732">My Videos</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1573898">Мае відэа</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13210_262699_1806293"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A small, Internet Protocol (IP)-based network. It is usually used for short-range, ad-hoc communication between devices and computers. A PAN may also be used to enable connectivity to a larger Local Area Network (LAN), Wide-Area Network (WAN), or the Internet. Windows XP supports the Bluetooth PAN service so you can create Personal Area Networks using Bluetooth.</descrip></descripGrp><ntig><termGrp><term id="262699">Personal Area Network</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1806293">PAN</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13210_262700_1806293"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A small, Internet Protocol (IP)-based network. It is usually used for short-range, ad-hoc communication between devices and computers. A PAN may also be used to enable connectivity to a larger Local Area Network (LAN), Wide-Area Network (WAN), or the Internet. Windows XP supports the Bluetooth PAN service so you can create Personal Area Networks using Bluetooth.</descrip></descripGrp><ntig><termGrp><term id="262700">PAN</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1806293">PAN</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13219_3051_1573958"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Authorization to perform operations associated with a specific shared resource, such as a file, directory, or printer and that must be granted by the system administrator to individual user accounts or administrative groups.</descrip></descripGrp><ntig><termGrp><term id="3051">permissions</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1573958">дазволы</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13219_3051_1779849"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Authorization to perform operations associated with a specific shared resource, such as a file, directory, or printer and that must be granted by the system administrator to individual user accounts or administrative groups.</descrip></descripGrp><ntig><termGrp><term id="3051">permissions</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1779849">дазволы доступу</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13219_315150_1573958"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Authorization to perform operations associated with a specific shared resource, such as a file, directory, or printer and that must be granted by the system administrator to individual user accounts or administrative groups.</descrip></descripGrp><ntig><termGrp><term id="315150">access permissions</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1573958">дазволы</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13219_315150_1779849"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Authorization to perform operations associated with a specific shared resource, such as a file, directory, or printer and that must be granted by the system administrator to individual user accounts or administrative groups.</descrip></descripGrp><ntig><termGrp><term id="315150">access permissions</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1779849">дазволы доступу</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13220_210458_1864394"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An option that changes a 2-dimensional linear expression, such as 5^2, to a built-up (3-dimensional) format.</descrip></descripGrp><ntig><termGrp><term id="210458">linear expression</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1864394">лінейны выраз</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13221_50960_2296267"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ultimate user of a computer or computer application in its finished, marketable form.</descrip></descripGrp><ntig><termGrp><term id="50960">end user</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296267">канчатковы карыстальнік</term><termNote type="geographicalUsage">BLR</termNote><t