ion">A feature that allows various mathematical symbols to be entered using the keyboard.</descrip></descripGrp><ntig><termGrp><term id="184023">Math Autocorrect</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1864369">Аўтазамена матэматычнымі знакамі</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4113_237389_1864511"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A reusable piece of content, formatting information or other document parts that are stored in galleries.</descrip></descripGrp><ntig><termGrp><term id="237389">building block</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1864511">шаблон</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4113_545704_1864511"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A reusable piece of content, formatting information or other document parts that are stored in galleries.</descrip></descripGrp><ntig><termGrp><term id="545704">document element</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1864511">шаблон</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="gramma