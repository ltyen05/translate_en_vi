id="2144652">Start</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2182151">меню "Пуск"</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37590_2144846_2189622"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An effect that adds gradual dark shading at the edges of a photo.</descrip></descripGrp><ntig><termGrp><term id="2144846">vignette</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2189622">віньетка</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37592_2144861_2571470"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app in the operating system where the user can manage the builds in the Windows Insider Program.</descrip></descripGrp><ntig><termGrp><term id="2144861">Windows Insider Hub</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2571470">Асяродак Insider</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37592_2144861_2571473"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app in the operating system where the user can manage the builds in the Windows Insider Program.</descrip></descripGrp><ntig><termGrp><term id="2144861">Windows Insider Hub</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2571473">Асяродак Windows Insider</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37592_2144862_2571470"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app in the operating system where the user can manage the builds in the Windows Insider Program.</descrip></descripGrp><ntig><termGrp><term id="2144862">Insider Hub</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2571470">Асяродак Insider</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37592_2144862_2571473"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app in the operating system where the user can manage the builds in the Windows Insider Program.</descrip></descripGrp><ntig><termGrp><term id="2144862">Insider Hub</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2571473">Асяродак Windows Insider</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37612_2146201_2167319"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The full-screen pane in Office Universal Apps that shows a list of previous versions of the file that is currently open, and that provides the ability to preview and create a copy of an older versions or restore the current document to an older version.</descrip></descripGrp><ntig><termGrp><term id="2146201">History</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2167319">Гісторыя</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37619_2147250_2342391"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A dual-component app that can be installed on a user's mobile device for secure access to work and school accounts through account sign-in verification.</descrip></descripGrp><ntig><termGrp><term id="2147250">Azure Authenticator</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2342391">Azure Authenticator</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37637_2148953_2158178"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Books &amp; reference subcategory containing apps to help