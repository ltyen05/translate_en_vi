l:lang="en-US"><descripGrp><descrip type="definition">A root of a polynomial that is a rational number.</descrip></descripGrp><ntig><termGrp><term id="2753815">rational root</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2757554">рацыянальны корань</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48685_2753972_2757560"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The calculus rule that states that the integral of a sum of two functions is equal to the sum of their integrals.</descrip></descripGrp><ntig><termGrp><term id="2753972">Sum Rule</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2757560">Правіла складання</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48685_2753972_2757561"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The calculus rule that states that the integral of a sum of two functions is equal to the sum of their integrals.</descrip></descripGrp><ntig><termGrp><term id="2753972">Sum Rule</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2757561">правіла складання інтэгралаў</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48685_2753973_2757560"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The calculus rule that states that the integral of a sum of two functions is equal to the sum of their integrals.</descrip></descripGrp><ntig><termGrp><term id="2753973">sum rule in integration</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2757560">Правіла складання</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48685_2753973_2757561"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The calculus rule that states that the integral of a sum of two functions is equal to the sum of their integrals.</descrip></descripGrp><ntig><termGrp><term id="2753973">sum rule in integration</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2757561">правіла складання інтэгралаў</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48686_2753976_2757551"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An algebraic expression of the sum or the difference of two or more terms.</descrip></descripGrp><ntig><termGrp><term id="2753976">polynomial</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2757551">мнагачлен</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48687_2753977_2757542"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A calculation of a numerical value of a definite integral.</descrip></descripGrp><ntig><termGrp><term id="2753977">integration</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2757542">інтэграванне</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48688_2753978_2757552"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A number that can be expressed as a quotient of two integers.</descrip></descripGrp><ntig><termGrp><term id="2753978">rational number</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2757552">рацыянальны лік</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48689_2753982_2757559"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An individual who has access to their team's OneNote and libraries and who share an individual notebook with their staff leader.</descrip></descripGrp><ntig><termGrp><term id="2753982">staff member</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2757559">супрацоўнік</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48692_2754091_2758295"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A physical letter sent to a person requesting a number to verify that he/she resides in the same area where he/she would like to purchase a number.</descrip></descripGrp><ntig><termGrp><term id="2754091">verification letter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2758295">праверачны ліст</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48693_2754106_2760808"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A disabled user object that can be used to represent and assign resources within Azure, Office 365, and Skype.</descrip></descripGrp><ntig><termGrp><term id="2754106">resource account</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2760808">уліковы запіс рэсурсу</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48694_2754396_2758292"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Kaizala chat feature that allows users to send confidential information in a one-to-one chat more securely by not allowing message content to be forwarded or copied, by blocking messages from showing up in notifications, and by automatically deleting them after they are read.</descrip></descripGrp><ntig><termGrp><term id="2754396">Secret Chat</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2758292">Сакрэтны чат</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48695_2754398_2758294"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An individual who has been invited by their group admin to download and join Kaizala, but who hasn't.</descrip></descripGrp><ntig><termGrp><term id="2754398">unregistered user</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2758294">незарэгістраваны карыстальнік</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48697_2754411_2758290"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Diagnostic Data Viewer setting that allows users to view Office diagnostic data from a different machine.</descrip></descripGrp><ntig><termGrp><term id="2754411">Remote Office diagnostic data viewing</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2758290">Аддалены прагляд дадзеных дыягностыкі Office</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48698_2754414_2758288"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of diagnostic data that is collected and sent to Microsoft about Office client software being used on computers running Windows that is used to keep Office secure and up-to-date, detect, diagnose and remediate problems, as well as to make product improvements.</descrip></descripGrp><ntig><termGrp><term id="2754414">Office diagnostic data</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2758288">дадзеныя дыягностыкі Office</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="487_146725_2296540"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The "one" side of two related tables in a one-to-many relationship. A primary table should have a primary key and each record should be unique.</descrip></descripGrp><ntig><termGrp><term id="146725">primary table</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296540">галоўная табліца</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48703_2754422_2758289"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Diagnostic Data Viewer setting that allows users to see what Office diagnostic data is being collected.</descrip></descripGrp><ntig><termGrp><term id="2754422">Office diagnostic data viewing</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2758289">Прагляд дадзеных дыягностыкі Office</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48704_2754423_2758287"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A string that consists of the IP address of the user's Windows machine and the port number that the DDV app is listening on.</descrip></descripGrp><ntig><termGrp><term id="2754423">Office connection string</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2758287">радок падключэння Office</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48720_2754440_2758291"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A minimum amount of diagnostic data necessary to help keep Office secure, up-to-date, and performing as expected on the device it’s installed on.</descrip></descripGrp><ntig><termGrp><term id="2754440">required diagnostic data</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2758291">абавязковыя дадзеныя дыягностыкі</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48721_2754441_2758280"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Office experience that provides some of its essential functionality through the use of cloud-based services. Connected experiences are Office experiences that download online content for use in Office (such as templates, images or new fonts) and/or analyze Office content (such as to provide editing suggestions or design recommendations).</descrip></descripGrp><ntig><termGrp><term id="2754441">connected experience</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2758280">падключаны сэрвіс</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48722_2754443_2758277"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A connected experience that is not included in Office 365 ProPlus.</descrip></descripGrp><ntig><termGrp><term id="2754443">additional optional connected experience</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2758277">дадатковы неабавязковы падключаны сэрвіс</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48723_2754445_2758286"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of data that enables the delivery of cloud-based connected experiences and that helps make those experiences secure and perform as expected.</descrip></descripGrp><ntig><termGrp><term id="2754445">necessary service data</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2758286">неабходныя дадзеныя службаў</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48724_2754447_2758281"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of necessary service data that consists of content users create using Office, such as text typed in a Word document.</descrip></descripGrp><ntig><termGrp><term id="2754447">customer content</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2758281">карыстальніцкае змесціва</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48725_2754449_2758285"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of necessary service data needed by a connected experience to perform its task, such as configuration information about the app.</descrip></descripGrp><ntig><termGrp><term id="2754449">functional data</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2758285">функцыянальныя дадзеныя</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48726_2754450_2758293"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of necessary service data needed to keep the service secure, up to date, and performing as expected and is strictly related to a connected experience.</descrip></descripGrp><ntig><termGrp><term id="2754450">service diagnostic data</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2758293">дадзеныя дыягностыкі службы</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48727_2754452_2758284"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A service that needs to run and send data to Microsoft in order for Office to function properly.</descrip></descripGrp><ntig><termGrp><term id="2754452">essential service</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2758284">базавая служба</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48739_2755816_2760801"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to technology that is designed to be used without touch.</descrip></descripGrp><ntig><termGrp><term id="2755816">hands-free</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2760801">без рук</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48741_2756423_2760794"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of diagnostic data user can opt out of providing and that is used to make product improvements and provides enhanced information to help detect, diagnose, and remediate issues.</descrip></descripGrp><ntig><termGrp><term id="2756423">optional diagnostic data</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2760794">неабавязковыя дадзеныя дыягностыкі</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48742_2756424_2760799"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of optional diagnostic data that indicates installed products and their version, install and uninstall status, software add-ins and their settings, and installed products and version installation status and updates readiness.</descrip></descripGrp><ntig><termGrp><term id="2756424">software setup and inventory data</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2760799">дадзеныя аб наладах і інвентарызацыі праграмнага забеспячэння</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48743_2756425_2760797"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The optional diagnostic data that indicates successful app function that individual features or aspects of the application have triggered, the functioning of Office accessibility features, and privacy obligations.</descrip></descripGrp><ntig><termGrp><term id="2756425">product and service usage data</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2760797">дадзеныя аб выкарыстанні службы або прадукту</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48744_2756426_2760796"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of optional diagnostic data that indicates an unexpected application exit and the state of that application at the time, as well as poor response time or performance for different product use scenarios.</descrip></descripGrp><ntig><termGrp><term id="2756426">product and service performance data</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2760796">дадзеныя аб прадукцыйнасці службы або прадукту</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48745_2756428_2760784"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of optional diagnostic data that indicates the connection state and key device settings, such as memory.</descrip></descripGrp><ntig><termGrp><term id="2756428">device connectivity and configuration data</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2760784">дадзеныя канфігурацыі і магчымасці падключэння прылады</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48746_2756498_2760783"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of data that is owned by an organization rather than an individual.</descrip></descripGrp><ntig><termGrp><term id="2756498">company data</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2760783">дадзеныя кампаніі</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48748_2757079_2760806"><langSet xml:lang="en-US"><descripGrp><d