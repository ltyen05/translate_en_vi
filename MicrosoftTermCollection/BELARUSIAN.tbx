7_2457781_2463065"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Editor feature that detects errors in the capitalization of the months March and May and prompts the user to correct the errors.</descrip></descripGrp><ntig><termGrp><term id="2457781">Capitalization of March and May</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2463065">Назвы месяцаў March і May з вялікай літары</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43398_2457782_2463068"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A sequence of words that co-occur more frequently, in a particular language, than would happen by chance.</descrip></descripGrp><ntig><termGrp><term id="2457782">collocation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2463068">устойлівае словазлучэнне</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43399_2457783_2463073"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A modification of a word to express different grammatical categories.</descrip></descripGrp><ntig><termGrp><term id="2457783">inflection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2463073">канчатак</term><