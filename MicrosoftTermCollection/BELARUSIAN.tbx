Note type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1864715">неабавязковы ўдзельнік</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19381_1274287_1864716"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An initial value used to generate pseudorandom numbers.</descrip></descripGrp><ntig><termGrp><term id="1274287">seed number</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1864716">пачатковае значэнне</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19381_658409_1864716"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An initial value used to generate pseudorandom numbers.</descrip></descripGrp><ntig><termGrp><term id="658409">seed</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1864716">пачатковае значэнне</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19382_658448_1806370"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ability of one element to see or refer to another. For one element to send a message to another element, the latter must be visible to the former.</descrip></descripGrp><ntig><termGrp><term id="658448">visibility</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1806370">бачнасць</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19402_658527_1864717"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The primary address that is used in mail merges.</descrip></descripGrp><ntig><termGrp><term id="658527">mailing address</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1864717">паштовы адрас</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19408_1031397_2601565"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A computer simulation of a physical object in which length, width, and depth are real attributes: a model, with x-, y-, and z-axes, that can be rotated for viewing from different angles.</descrip></descripGrp><ntig><termGrp><term id="1031397">three-dimensional model</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2601565">3D-мадэль</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type