rmNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38712_2255107_2257751"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A keyboard layout in which the onscreen keyboard can be split into two halves, resulting into two halves of the keyboard towards the edge of the screen.</descrip></descripGrp><ntig><termGrp><term id="2255107">split keyboard mode</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2257751">рэжым падзеленай клавіятуры</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38713_2255108_2257748"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A keyboard layout in which the onscreen keyboard is attached to one edge of the window.</descrip></descripGrp><ntig><termGrp><term id="2255108">docked mode</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2257748">прыстыкаваны рэжым</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38714_2255109_2257747"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A keyboard layout in which the onscreen keyboard is centered.</descrip></descripGrp><ntig><termGrp><term id="2255109">centered mode</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be