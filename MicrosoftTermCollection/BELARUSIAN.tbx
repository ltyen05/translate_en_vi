ammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1860378">тэкставае поле</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2776_420864_2296504"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A defined set of values that Microsoft Office Outlook uses to keep track of user accounts.</descrip></descripGrp><ntig><termGrp><term id="420864">Outlook profile</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296504">профіль Outlook</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27769_1447396_2718875"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The status that indicates that a user has assigned this contact to the Blocked Contacts privacy relationship.</descrip></descripGrp><ntig><termGrp><term id="1447396">Blocked</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2718875">Заблакіраваны</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27772_1448163_2655457"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Rules by which one must agree to abide by in order to use a service. The accompanying Microsoft software includes computer software and may include associated media, printed materials, “online” or electronic documentation, and Internet-based services for use with a Microsoft software product (collectively, the “ADD-IN SOFTWARE”).</descrip></descripGrp><ntig><termGrp><term id="1448163">terms of service</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2655457">умовы аказання паслуг</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27793_1464067_1864991"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The combined schedule of a number of people or resources.</descrip></descripGrp><ntig><termGrp><term id="1464067">group schedule</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1864991">групавы графік</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27799_1464802_2840266"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A call center for answering emergency calls and providing emergency services.</descrip></descripGrp><ntig><termGrp><term id="1464802">Public Safety Answering Point</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2840266">PSAP</term><termNote type="geographicalUsage">BLR</