Note><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2791655">DPA</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49175_2785666_2791661"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process of researching the cause and scope of a potential problem (e.g. case, alert, incident) and determining its severity.</descrip></descripGrp><ntig><termGrp><term id="2785666">investigation</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2791661">даследаванне</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49176_2785667_2791656"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A network node that network traffic passes through to reach nodes outside of the network.</descrip></descripGrp><ntig><termGrp><term id="2785667">egress point</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2791656">пункт выхаду</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49177_2785668_2791652"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft 365 tool that allows admins to search for sensitive, malicious, or misplaced data across Office 365, investigate what happened, and take the appropriate actions to remediate the spillage.</descrip></descripGrp><ntig><termGrp><term id="2785668">Data Investigations (Preview)</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2791652">Даследаванні дадзеных (перадфінальная версія)</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49178_2785669_2791654"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A transfer of sensitive data to an unauthorized entity.</descrip></descripGrp><ntig><termGrp><term id="2785669">data spillage</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2791654">уцечка дадзеных</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49178_2785670_2791654"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A transfer of sensitive data to an unauthorized entity.</descrip></descripGrp><ntig><termGrp><term id="2785670">data spill</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2791654">уцечка дадзеных</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote typ