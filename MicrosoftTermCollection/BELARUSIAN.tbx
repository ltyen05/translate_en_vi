">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="724_6299_2737096"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An address of a cell in a worksheet that does not change when the address is copied to a new cell.</descrip></descripGrp><ntig><termGrp><term id="6299">absolute cell reference</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2737096">абсалютная спасылка</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="724_652439_1864079"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An address of a cell in a worksheet that does not change when the address is copied to a new cell.</descrip></descripGrp><ntig><termGrp><term id="652439">absolute reference</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1864079">абсалютная спасылка на ячэйку</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="724_652439_2737096"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An address of a cell in a worksheet that does not change when the address is copied to a new cell.</descrip></descripGrp><ntig><termGrp><term id="652439">absolute reference</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2737096">абсалютная спасылка</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7245_299913_1864550"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The folder that contains any .one files that have been sent to you as an email message attachment.</descrip></descripGrp><ntig><termGrp><term id="299913">Notes E-mailed To Me</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1864550">Атрыманыя нататкі</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7246_116666_1791632"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To transfer into a store or storage location.</descrip></descripGrp><ntig><termGrp><term id="116666">store</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1791632">захоўваць</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7248_54777_1659560"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Marked with a flag.</descrip></descripGrp><ntig><termGrp><term id="54777">flagged</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1659560">пазначаны</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7250_143242_1864270"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In 2-D line charts, lines that extend from the highest to the lowest value in each category. High-low lines are often used in stock charts.</descrip></descripGrp><ntig><termGrp><term id="143242">high-low lines</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1864270">калідор вагання</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7253_298012_1864546"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Any graphic you draw or insert, which can be changed and enhanced. Drawing objects include AutoShapes, curves, lines, and WordArt.</descrip></descripGrp><ntig><termGrp><term id="298012">drawing object</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1864546">аб'ект-малюнак</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7257_55937_1573703"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To prepare a disk for use by organizing its storage space into a collection of data "compartments", each of which can be located by the operating system so that data can be sorted and retrieved. When a previously used disk is formatted, any preexisting information on it is lost.</descrip></descripGrp><ntig><termGrp><term id="55937">format</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1573703">фарматаваць</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7258_147302_1864323"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A diagram that is used to show foundation-based relationships.</descrip></descripGrp><ntig><termGrp><term id="147302">pyramid diagram</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1864323">пірамідальная схема</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="726_116752_1574145"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Digital media that is delivered in a continuous flow across a network.</descrip></descripGrp><ntig><termGrp><term id="116752">stream</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1574145">плынь</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="726_116752_1816761"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Digital media that is delivered in a continuous flow across a network.</descrip></descripGrp><ntig><termGrp><term id="116752">stream</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1816761">паток</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7263_121042_1860274"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A symbolic value used instead of a real value which in this case is text.</descrip></descripGrp><ntig><termGrp><term id="121042">text placeholder</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1860274">замяшчальны тэкст</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="727_126759_2763187"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user account name (sometimes referred to as the user logon name) and a domain name identifying the domain in which the user account is located and which is the standard usage for logging on to a Windows domain.</descrip></descripGrp><ntig><termGrp><term id="126759">user principal name</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2763187">імя ўдзельніка-карыстальніка</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="727_126760_2763187"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user account name (sometimes referred to as the user logon name) and a domain name identifying the domain in which the user account is located and which is the standard usage for logging on to a Windows domain.</descrip></descripGrp><ntig><termGrp><term id="126760">UPN</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2763187">імя ўдзельніка-карыстальніка</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7271_170000_2772546"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To verify that your software product is a legal copy and is installed in compliance with the Microsoft Software License Terms.</descrip></descripGrp><ntig><termGrp><term id="170000">activate</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2772546">актываваць</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</te