ml:lang="en-US"><descripGrp><descrip type="definition">One of the pivots for a contact pinned to your Start screen, where you can find all your apps through which you can connect with that contact.</descrip></descripGrp><ntig><termGrp><term id="2067080">connect</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2080529">злучэнне</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35733_2258869_2259020"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature in Settings where the user can change the settings for the cellular connection and for the SIM card.</descrip></descripGrp><ntig><termGrp><term id="2258869">Cellular &amp; SIM</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2259020">SIM і мабільная сетка</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35734_2067082_2080515"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that provides quick access to settings and notifications specified by the user.</descrip></descripGrp><ntig><termGrp><term id="2067082">action center</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2080515">цэнтр дзеянняў</term><termNote type="geogr