scrip type="definition">An individual page in a topic series, or any page that is primarily search-driven.</descrip></descripGrp><ntig><termGrp><term id="1645771">dynamic landing page</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1865162">дынамічная мэтавая старонка</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32272_1645772_1865163"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A storage method in which a file is split into pieces that are stored and updated separately, and streamed together when a user requests the file.</descrip></descripGrp><ntig><termGrp><term id="1645772">Efficient File Storage</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1865163">эфектыўнае захоўванне файлаў</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32273_1645773_1865164"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables SharePoint customers to build their site navigation around a metadata term set, and that enables friendly URLs for pages in the navigation structure.</descrip></descripGrp><ntig><termGrp><term id="1645773">managed navigation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1865164">навігацыя з 