_2515425"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The web-based hosting service for version control using Git.</descrip></descripGrp><ntig><termGrp><term id="2394267">GitHub</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2515425">GitHub</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42317_2394284_2556355"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A formal approach used by organizations to orchestrate, prioritize and benefit from projects by examining the risk-reward of each project, the available funds, the likelihood of a project's duration, and the expected outcomes.</descrip></descripGrp><ntig><termGrp><term id="2394284">project portfolio management</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2556355">PPM</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42317_2394284_2556356"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A formal approach used by organizations to orchestrate, prioritize and benefit from projects by examining the risk-reward of each project, the available funds, the likelihood of a project's duration, and the expected outcomes.</descrip></descripGrp><ntig><termGrp><term id="2394284">project portfolio management</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2556356">кіраванне партфелямі праектаў</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42317_2394292_2556355"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A formal approach used by organizations to orchestrate, prioritize and benefit from projects by examining the risk-reward of each project, the available funds, the likelihood of a project's duration, and the expected outcomes.</descrip></descripGrp><ntig><termGrp><term id="2394292">PPM</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2556355">PPM</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42317_2394292_2556356"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A formal approach used by organizations to orchestrate, prioritize and benefit from projects by examining the risk-reward of each project, the available funds, the likelihood of a project's duration, and the expected outcomes.</descrip></descripGrp><ntig><termGrp><term id="2394292">PPM</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2556356">кіраванне партфелямі праектаў</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42326_2394553_2398380"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">After a build update, to load an app with domain data (such as data from a database, from the network, or from a file system), during the download process. Before this step, the app cannot be used.</descrip></descripGrp><ntig><termGrp><term id="2394553">hydrate</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2398380">серыялізаваць</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42327_2394727_2422401"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app for multi-factor authentication, device registration to Azure AD, and SSO/certificate-based authentication against Azure AD that generates a security code the user must enter to verify his/her identity or, for enterprise users, a QR code to scan.</descrip></descripGrp><ntig><termGrp><term id="2394727">Microsoft Authenticator</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2422401">Authenticator</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42327_2422386_2422401"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app for multi-factor authentication, device registration to Azure AD, and SSO/certificate-based authentication against Azure AD that generates a security code the user must enter to verify his/her identity or, for enterprise users, a QR code to scan.</descrip></descripGrp><ntig><termGrp><term id="2422386">Authenticator</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2422401">Authenticator</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42329_2395099_2469514"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office 365 Education feature that allows the user to view their progress or the progress of their students and create surveys, quizzes, questionnaires, and registration forms whose result can be exported to Excel and embedded in other Microsoft applications.</descrip></descripGrp><ntig><termGrp><term id="2395099">Microsoft Forms</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2469514">Forms</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42329_2395099_2469516"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office 365 Education feature that allows the user to view their progress or the progress of their students and create surveys, quizzes, questionnaires, and registration forms whose result can be exported to Excel and embedded in other Microsoft applications.</descrip></des