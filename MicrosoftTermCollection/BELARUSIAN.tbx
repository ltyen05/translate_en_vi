descripGrp><descrip type="definition">To use a session to put a file in a remote computer.</descrip></descripGrp><ntig><termGrp><term id="2735258">drop</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2738109">перамясціць</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48379_2735259_2738122"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A keyword that admins can add to a bookmark such that if it is used in a query, only that specific bookmark will display.</descrip></descripGrp><ntig><termGrp><term id="2735259">reserved keyword</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2738122">зарэзерваванае ключавое слова</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48388_2735720_2738115"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The view that allows users to hunt for security threats by reviewing suspicious email and accounts and by searching devices for harmful content.</descrip></descripGrp><ntig><termGrp><term id="2735720">Hunting</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2738115">Пошук пагроз</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNo