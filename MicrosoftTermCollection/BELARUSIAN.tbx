ipGrp><descrip type="definition">​​A site template that is designed to help developers to test the apps they are building and get feedback about their apps from others.</descrip></descripGrp><ntig><termGrp><term id="1637185">Developer Site</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1865122">Сайт распрацоўшчыка</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32152_1637188_1865123"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The menu option that becomes available when a user right-clicks a word. It opens the chosen definitions provider and displays information for the word selected.</descrip></descripGrp><ntig><termGrp><term id="1637188">Define</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1865123">Вызначыць значэнне</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32153_1637189_1865124"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An image that is bounded by a picture frame.</descrip></descripGrp><ntig><termGrp><term id="1637189">picture content</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1865124">змесціва малюнка</term><termNote type="geographicalUsage">BLR</termNote><ter