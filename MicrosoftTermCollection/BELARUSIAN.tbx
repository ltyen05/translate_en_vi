wobble correction</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1791658">карэкцыя эфекту "жэле"</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32436_1679577_1778280"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An image stabilization technique that's used to reduce the appearance of camera shake in a video image.</descrip></descripGrp><ntig><termGrp><term id="1679577">anti-shake</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1778280">нейтралізацыя трасяніны</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32436_1679577_2057375"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An image stabilization technique that's used to reduce the appearance of camera shake in a video image.</descrip></descripGrp><ntig><termGrp><term id="1679577">anti-shake</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2057375">функцыя стабілізацыі</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32436_1805606_1778280"><lang