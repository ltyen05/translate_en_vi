An Internet email security-oriented protocol that adds public key encryption and support for digital signatures to the widely used MIME email protocol.</descrip></descripGrp><ntig><termGrp><term id="106968">S/MIME</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296768">S/MIME</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2358_106968_2296770"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Internet email security-oriented protocol that adds public key encryption and support for digital signatures to the widely used MIME email protocol.</descrip></descripGrp><ntig><termGrp><term id="106968">S/MIME</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296770">абароненае мнагамэтавае паштовае пашырэнне Інтэрнэту (S/MIME)</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2358_106970_2296768"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Internet email security-oriented protocol that adds public key encryption and support for digital signatures to the widely used MIME email protocol.</descrip></descripGrp><ntig><termGrp><term id="106970">Secure/Multipurpose Internet Mail Extensions</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="229