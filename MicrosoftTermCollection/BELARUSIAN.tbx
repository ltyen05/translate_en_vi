erm><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2776609">плоскасць кантролю за бяспекай</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49067_2774961_2776601"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A means of controlling user access to resources.</descrip></descripGrp><ntig><termGrp><term id="2774961">security control plane</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2776601">плоскасць кантролю</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49067_2774961_2776609"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A means of controlling user access to resources.</descrip></descripGrp><ntig><termGrp><term id="2774961">security control plane</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2776609">плоскасць кантролю за бяспекай</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49068_2774962_2776614"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The offer of Skype for Business that partially runs on premises and partially in the cloud.</descrip></descripGrp><ntig><termGrp><term id="2774962">Skype for Business Hybrid</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2776614">Skype для бізнесу гібрыдны</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4907_231968_1864419"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A field that is assigned to a page orientation in a PivotTable or PivotChart report. You can either display a summary of all items in a page field, or display one item at a time, which filters out the data for all other items.</descrip></descripGrp><ntig><termGrp><term id="231968">page field</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1864419">поле старонкі</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49074_2775736_2778533"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A portion of a software program that controls the program and can respond to input from users as well as act on is its own when performing automated tasks.</descrip></descripGrp><ntig><termGrp><term id="2775736">control logic</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2778533">логіка кіравання</term>