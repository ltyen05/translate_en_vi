partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2740398">Палітыкі метак</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48423_2736699_2740416"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The view in the Microsoft 365 security center and the Microsoft 365 compliance center where users can view sensitive info types and their associated information.</descrip></descripGrp><ntig><termGrp><term id="2736699">Sensitivity info types</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2740416">Тыпы канфідэнцыяльнай інфармацыі</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48424_2736700_2740397"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The view in the Microsoft 365 security center and the Microsoft 365 compliance center where users can find information on how retention and sensitivity labels are being used to classify, retain, and protect their organization's content in the cloud.</descrip></descripGrp><ntig><termGrp><term id="2736700">Label analytics</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2740397">Аналітыка метак</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Pr