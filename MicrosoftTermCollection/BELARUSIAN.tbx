US"><descripGrp><descrip type="definition">The Windows Live universal roaming contact list that allows users to share their contact information and subscribe to others’ to automatically receive updates across Windows Live Messenger and Windows Live Spaces.</descrip></descripGrp><ntig><termGrp><term id="1136243">Windows Live Contacts</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1599444">Кантакты Windows Live</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24606_1136281_1599443"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Windows Live service that allows users to make computer-to-computer or computer-to-phone calls. Users must be signed in to Windows Live Messenger to use it.</descrip></descripGrp><ntig><termGrp><term id="1136281">Windows Live Call</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1599443">Тэлефон Windows Live</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24607_1136282_1599442"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Windows Live service that lets people and groups add, manage, and share event information.</descrip></descripGrp><ntig><termGrp><term id="1136282">Windows Live Calendar</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNo