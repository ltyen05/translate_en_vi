></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2080516">Будзільнікі</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35712_2065227_2080544"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A card storing currency that customers can use to buy apps and similar items from Microsoft digital Stores.</descrip></descripGrp><ntig><termGrp><term id="2065227">Microsoft gift card</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2080544">падарункавая карта Microsoft</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35713_2065228_2080586"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature or mode in the Windows Maps app that provides turn-by-turn directions with both audio and visual guidance that changes as the user travels along the route to their destination.</descrip></descripGrp><ntig><termGrp><term id="2065228">voice navigation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2080586">галасавая навігацыя</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35713_2065228_2461714"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature or mode in the Windows Maps app that provides turn-by-turn directions with both audio and visual guidance that changes as the user travels along the route to their destination.</descrip></descripGrp><ntig><termGrp><term id="2065228">voice navigation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2461714">навігацыя з указаннямі</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35713_2459049_2080586"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature or mode in the Windows Maps app that provides turn-by-turn directions with both audio and visual guidance that changes as the user travels along the route to their destination.</descrip></descripGrp><ntig><termGrp><term id="2459049">guided navigation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2080586">галасавая навігацыя</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35713_2459049_2461714"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature or mode in the Windows Maps app that provides turn-by-turn directions with both audio and visual guidance that changes as the user travels along the route to their destination.</descrip></descripGrp><ntig><termGrp><term id="2459049">guided navigation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2461714">навігацыя з указаннямі</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35715_2065925_2080573"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The sound the phone makes when the user receives a text message.</descrip></descripGrp><ntig><termGrp><term id="2065925">text tone</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2080573">мелодыя SMS</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35716_2065926_2080563"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature where users can add contacts that they call frequently so that they can get to their numbers quickly rather than going through the Contact list in People.</descrip></descripGrp><ntig><termGrp><term id="2065926">speed dial</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2080563">хуткі набор</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35718_2067023_2080553"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A list of contacts users can call (i.e. only shows contacts that have phone numbers associated with them).</descrip></descripGrp><ntig><termGrp><term id="2067023">phone book</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2080553">кантакты</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35719_2067024_2080592"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature on the phone to enroll in and manage a workplace account.</descrip></descripGrp><ntig><termGrp><term id="2067024">workplace</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2080592">працоўнае месца</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35720_2067025_2080593"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An account provided by a company that allows users to install apps or hubs provided by that company, and that governs the company policies applied to the phone.</descrip></descripGrp><ntig><termGrp><term id="2067025">workplace account</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2080593">уліковы запіс працоўнага месца</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</ter