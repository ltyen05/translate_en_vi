roject Server using global and category permissions.</descrip></descripGrp><ntig><termGrp><term id="1637811">Project Server permission model</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1865136">Мадэль дазволу Project Server</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32167_1637812_1865137"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A gallery of HTML code snippets for common components that can be customized and added to SharePoint designs.</descrip></descripGrp><ntig><termGrp><term id="1637812">Snippet Gallery</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1865137">Галерэя сніпетаў</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32168_1637813_1865138"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A callout that is invoked through contextual UI to display reference data, such as definitions and synonyms, for the word selected.</descrip></descripGrp><ntig><termGrp><term id="1637813">definitions callout</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1865138">выклік значэнняў</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammatica