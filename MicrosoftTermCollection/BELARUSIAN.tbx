389"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A 9-digit number used to identify an entity (company or person) for tax reporting purposes in the U.S. There are several different types of tax identification numbers, such as employer identification number (EIN), Social Security number (SSN), individual taxpayer identification number (ITIN), and adopted taxpayer identification number (ATIN).</descrip></descripGrp><ntig><termGrp><term id="2630701">tax ID</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2351389">УНП</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42205_2389315_2392159"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To use or play a product for a short time for free, without having to purchase it.</descrip></descripGrp><ntig><termGrp><term id="2389315">preview</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2392159">выканаць перадпрагляд</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42206_2389316_2392160"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A short display of a product for free without having to purchase it.</descrip></descripGrp><ntig><termGrp><term id="2389316">preview</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig><