ote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="800_879_2600044"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An electronic publication distributed primarily through the World Wide Web, rather than as an ink-on-paper magazine.</descrip></descripGrp><ntig><termGrp><term id="879">web magazine</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2600044">электронны часопіс</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="800_879_2600047"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An electronic publication distributed primarily through the World Wide Web, rather than as an ink-on-paper magazine.</descrip></descripGrp><ntig><termGrp><term id="879">web magazine</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2600047">часопіс</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8026_149177_1864342"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Any characteristic of text, such as font, size, style, color, or effect such as subscript or superscript.</descrip></descripGrp><ntig><termGrp><term id="149177">text attributes</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1864342">атрыбуты тэксту</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="803_44794_1573602"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The work area on a computer screen that simulates the top of an actual desk. The desktop contains the Recycle Bin and other icons (shortcuts to programs, files, folders, and various types of documents such as letters, reports, or pictures) that you can arrange on the electronic desktop just as you would arrange real objects on top of a desk.</descrip></descripGrp><ntig><termGrp><term id="44794">desktop</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1573602">працоўны стол</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8030_37385_1864099"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To join sequentially (for example, to combine the two strings "hello" and "there" into the single string "hello there").</descrip></descripGrp><ntig><termGrp><term id="37385">concatenate</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1864099">счапіць</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8036_116444_1574141"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A horizontal window at the bottom of a parent window in which an application can display various kinds of status information. The status bar can be divided into parts to display more than one type of information.</descrip></descripGrp><ntig><termGrp><term id="116444">status bar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1574141">панэль стану</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8040_149410_2296703"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A query that uses the UNION operator to combine the results of two or more select queries.</descrip></descripGrp><ntig><termGrp><term id="149410">union query</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296703">запыт аб'яднання</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8043_94462_1573987"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In word processors and other applications, the feature that formats a document for printing but displays it on the video monitor rather than sending it directly to the printer.</descrip></descripGrp><ntig><termGrp><term id="94462">preview</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1573987">папярэдні прагляд</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8051_109321_2296541"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Windows-based computers, an account (such as a user, security group, device, or computer) that can be granted or denied access to resources.</descrip></descripGrp><ntig><termGrp><term id="109321">security principal</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296541">суб'ект</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8051_109321_2296615"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Windows-based computers, an account (such as a user, security group, device, or computer) that can be granted or denied access to resources.</descrip></descripGrp><ntig><termGrp><term id="109321">security principal</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296615">суб'ект бяспекі</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8051_109322_2296541"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Windows-based computers, an account (such as a user, security group, device, or computer) that can be granted or denied access to resources.</descrip></descripGrp><ntig><termGrp><term id="109322">principal</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296541">суб'ект</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8051_109322_2296615"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Windows-based computers, an account (such as a user, security group, device, or computer) that can be granted or denied access to resources.</descrip></descripGrp><ntig><termGrp><term id="109322">principal</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296615">суб'ект бяспекі</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8058_125224_2296700"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The _ character.</descrip></descripGrp><ntig><termGrp><term id="125224">underscore</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296700">сімвал падкрэслівання</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8058_319169_2296700"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The _ character.</descrip></descripGrp><ntig><termGrp><term id="319169">LOW LINE</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296700">сімвал падкрэслівання</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="807_22891_1574137"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of starting or resetting a computer or a device. When first turned on (cold boot) or reset (warm boot), the computer runs the software that loads and starts the computer's operating system, which prepares it for use.</descrip></descripGrp><ntig><termGrp><term id="22891">bootstrap</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1574137">запуск</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="807_730299_1574137"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of starting or resetting a computer or a device. When first turned on (cold boot) or reset (warm boot), the computer runs the software that loads and starts the computer's operating system, which prepares it for use.</descrip></descripGrp><ntig><termGrp><term id="730299">startup</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1574137">запуск</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="808_264640_2072194"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A fraction that is written on a downward angle: the diagonal fraction bar is placed down and to the right of the numerator, and the denominator is slightly down and to the right of the fraction bar.</descrip></descripGrp><ntig><termGrp><term id="264640">skewed fraction</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2072194">дыяганальны просты дроб</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8085_262737_2743692"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An authentication protocol that provides a mechanism for mutual authentication between a client and a server, or between one server and another, before a network connection is opened between them.</descrip></descripGrp><ntig><termGrp><term id="262737">Kerberos</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2743692">Kerberos</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8085_636858_2743692"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An authentication protocol that provides a mechanism for mutual authentication between a client and a server, or between one server and another, before a network connection is opened between them.</descrip></descripGrp><ntig><termGrp><term id="636858">Kerberos authentication</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2743692">Kerberos</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8090_360150_1864569"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ActiveX Database Objects (ADO) object used to contain a result set. It also exhibits cursor behavior depending on the recordset properties set by an application. ADO recordsets are mapped to OLE DB rowsets.</descrip></descripGrp><ntig><termGrp><term id="360150">recordset</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1864569">набор запісаў</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8095_117241_1864168"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To send something in for consideration.</descrip></descripGrp><ntig><termGrp><term id="117241">submit</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1864168">адправіць</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8099_265320_1864532"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A folder where a collection of PowerPoint slides is shared.</descrip></descripGrp><ntig><termGrp><term id="265320">Slide Library</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1864532">Бібліятэка слайдаў</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8102_42162_1864103"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A short horizontal line used as a punctuation mark.</descrip></descripGrp><ntig><termGrp><term id="42162">dash</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1864103">працяжнік</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8115_66527_2296375"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A domain controller that holds the infrastructure operations master role in Active Directory. The infrastructure master updates the group-to-user reference whenever group memberships change and replicates these changes across the domain. At any time, the infrastructure master role can be assigned to only one domain controller in each domain.</descrip></descripGrp><ntig><termGrp><term id="66527">infrastructure master</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296375">кіраўнік інфраструктуры</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8120_375742_2296287"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of features that provides a programming interface for accessing Microsoft Exchange data through the Client Access server role by using Web services.</descrip></descripGrp><ntig><termGrp><term id="375742">Exchange Web Services</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296287">вэб-службы Exchange</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8123_234529_1573693"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A graphic that indicates follow-up action is required, or otherwise identifies an important item.</descrip></descripGrp><ntig><termGrp><term id="234529">flag</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1573693">пазнака</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8125_359995_2296396"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that uses a minimum amount of data to display the general layout of a report.</descrip></descripGrp><ntig><termGrp><term id="359995">Layout Preview</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296396">папярэдні прагляд макета</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8136_396927_2296239"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A World Wide Web Consortium specification that describes the structure of dynamic HTML and XML documents in a way that allows them to be manipulated through a Web browser.</descrip></descripGrp><ntig><termGrp><term id="396927">Document Object Model</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296239">Мадэль DOM</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8136_396928_2296239"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A World Wide Web Consortium specification that describes the structure of dynamic HTML and XML documents in a way that allows them to be manipulated through a Web browser.</descrip></descripGrp><ntig><termGrp><term id="396928">DOM</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296239">Мадэль DOM</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8150_212894_1574136"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A menu containing important and frequently used programs, folders, and utilities. To open the Start menu, click the Start button on the taskbar.</descrip></descripGrp><ntig><termGrp><term id="212894">Start menu</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1574136">меню "Пуск"</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8156_232394_1864433"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Appears to the left of a meeting or appointment (or all the way around the item when selected), indicating time status as free, tentative, busy, out of office, or no information available. Visible only in Day and Work Week view.</descrip></descripGrp><ntig><termGrp><term id="232394">availability indicator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1864433">індыкатар даступнасці</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8160_16016_1573440"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To include an external document, a file, or an executable program with a message.</descrip></descripGrp><ntig><termGrp><term id="16016">attach</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1573440">далучыць</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8163_32059_1573528"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To remove the data or settings currently present on an entity.</descrip></descripGrp><ntig><termGrp><term id="32059">clear</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1573528">ачысціць</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8180_319923_1791105"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To suppress the sound produced by a device or application.</descrip></descripGrp><ntig><termGrp><term id="319923">mute</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1791105">выключыць гук</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8180_319923_1816730"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To suppress the sound produced by a device or application.</descrip></descripGrp><ntig><termGrp><term id="319923">mute</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1816730">адключыць гук</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8188_46307_2296225"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A service that provides access to data and objects in a directory or network environment.</descrip></descripGrp><ntig><termGrp><term id="46307">directory service</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296225">служба каталогаў</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8196_146580_1806252"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A graphic file format that is supported by some World Wide Web browsers. PNG supports variable transparency of images (alpha channels) and control of image brightness on different computers (gamma correction). PNG files are compressed bitmaps.</descrip></descripGrp><ntig><termGrp><term id="146580">Portable Network Graphics</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1806252">PNG</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8196_146581_1806252"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A graphic file format that is supported by some World Wide Web browsers. PNG supports variable transparency of images (alpha channels) and control of image brightness on different computers (gamma correction). PNG files are compressed bitmaps.</descrip></descripGrp><ntig><termGrp><term id="146581">PNG</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1806252">PNG</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="820_210484_1864403"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To remove the digital signature added to the document.</descrip></descripGrp><ntig><termGrp><term id="210484">un-sign</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1864403">выдаліць подпіс</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8200_41830_2296185"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A toolbar that you create for your application.</descrip></descripGrp><ntig><termGrp><term id="41830">custom toolbar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296185">наладжвальная панэль інструментаў</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8206_346965_1573985"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Strength exerted; might.</descrip></descripGrp><ntig><termGrp><term id="346965">power</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1573985">магутнасць</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="821_39300_1780043"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Management of a computer and its processing abilities so as to maintain order as tasks and activities are carried out. Control applies to measures designed to ensure error-free actions carried out at the right time and in the right order relative to other data-handling or hardware-based activities.</descrip></descripGrp><ntig><termGrp><term id="39300">control</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1780043">кіраванне</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8218_231957_1864409"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The PivotTable report that supplies the source data to the PivotChart report. It is created automatically when you create a new PivotChart report. When you change the layout of either report, the other also changes.</descrip></descripGrp><ntig><termGrp><term id="231957">associated PivotTable report</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1864409">звязаная справаздача зводнай табліцы</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="823_144037_2296403"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of buttons representing hyperlinks to pages both within a Web site and to external sites.</descrip></descripGrp><ntig><termGrp><term id="144037">link bar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296403">панэль спасылак</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="824_129372_1574222"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Of or pertaining to a device or service that appears to the user as something it actually is not or that does not physically exist.</descrip></descripGrp><ntig><termGrp><term id="129372">virtual</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1574222">віртуальны</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8245_334528_1574084"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To add a check to a check box to specify a desired feature or option.</descrip></descripGrp><ntig><termGrp><term id="334528">select</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1574084">выбраць</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8250_211554_1780045"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A device that is added to the base computer system to increase functionality, such as audio, networking, graphics, or SCSI controller.</descrip></descripGrp><ntig><termGrp><term id="211554">add-on device</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1780045">дадатковы кампанент</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8250_5650_1780045"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A device that is added to the base computer system to increase functionality, such as audio, networking, graphics, or SCSI controller.</descrip></descripGrp><ntig><termGrp><term id="5650">add-on</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1780045">дадатковы кампанент</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8251_170244_2529765"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Microsoft program that invites customers to provide Microsoft with more detailed information about how the software is used including the type and frequency of errors, software and hardware performance, and feature usage. This information is anonymous and voluntary, and is used strictly for the purposes of software development.</descrip></descripGrp><ntig><termGrp><term id="170244">Customer Experience Improvement Program</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2529765">Праграма паляпшэння якасці праграмнага забеспячэння</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8251_170245_2529765"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Microsoft program that invites customers to provide Microsoft with more detailed information about how the software is used including the type and frequency of errors, software and hardware performance, and feature usage. This information is anonymous and voluntary, and is used strictly for the purposes of software development.</descrip></descripGrp><ntig><termGrp><term id="170245">CEIP</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2529765">Праграма паляпшэння якасці праграмнага забеспячэння</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8257_115925_2296646"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Of, pertaining to, or being a device that does not require support from another device or system, for example, a computer that is not connected to a network.</descrip></descripGrp><ntig><termGrp><term id="115925">stand-alone</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296646">ізаляваны</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8257_115926_2296646"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Of, pertaining to, or being a device that does not require support from another device or system, for example, a computer that is not connected to a network.</descrip></descripGrp><ntig><termGrp><term id="115926">standalone</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296646">ізаляваны</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8259_265157_1864529"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows users to preview, edit or delete building blocks in a variety of galleries, and insert them into the current document.</descrip></descripGrp><ntig><termGrp><term id="265157">Building Blocks Organizer</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1864529">Дыспетчар стандартных блокаў</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8275_143490_1864277"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A reference to a range of cells instead of a single cell that is calculated like a single cell. If cell C10 contains the formula =B5: B15*5, Excel multiplies the value in cell B10 by 5 because cells B10 and C10 are in the same row.</descrip></descripGrp><ntig><termGrp><term id="143490">implicit intersection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1864277">невідавочнае скрыжаванне</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="gr