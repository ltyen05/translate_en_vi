Number">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2821729">бот-дарадца для Teams</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49800_2816515_2821755"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of telephone number that is not linked to any specific locality.</descrip></descripGrp><ntig><termGrp><term id="2816515">non-geographic number</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2821755">негеаграфічны нумар</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49801_2816516_2821739"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of telephone number that is linked to a specific locality, such as with a country code.</descrip></descripGrp><ntig><termGrp><term id="2816516">geographic number</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2821739">геаграфічны нумар</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49802_2816517_2821730"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of backing up data to a remote, cloud-based server.</descrip></desc