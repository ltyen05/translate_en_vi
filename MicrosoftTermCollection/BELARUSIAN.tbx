rivate store</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2333439">прыватная крама</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40112_2330405_2333437"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A map downloaded to your PC, phone or tablet that can be used to get directions and search for places even when you are not connected to the Internet.</descrip></descripGrp><ntig><termGrp><term id="2330405">offline map</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2333437">пазасеткавая карта</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40116_2331304_2333436"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A person or business that makes line-of-business apps available to customers through an online market.</descrip></descripGrp><ntig><termGrp><term id="2331304">line-of-business publisher</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2333436">галіновы выдавец</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40116_2331305_2333436"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A person or business that makes line-of-business apps available to customers through an online market.</descrip></descripGrp><ntig><termGrp><term id="2331305">LOB publisher</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2333436">галіновы выдавец</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40118_2331575_2333441"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application that is licensed by a company in bulk for use by end users.</descrip></descripGrp><ntig><termGrp><term id="2331575">volume application</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2333441">праграма з карпаратыўным ліцэнзаваннем</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40121_2331937_2340728"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An automatically generated filter list in Wunderlist (e.g. Today, Week, Assigned to me, Starred, All, and Completed Smart List) that shows all tasks from across all your task lists that meet the specific criteria.</descrip></descripGrp><ntig><termGrp><term id="2331937">smart list</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><te