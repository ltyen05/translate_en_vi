term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296247">параметры дамена</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26531_1275663_2718845"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To transfer a call to a holding point instead of holding the call at the phone device.</descrip></descripGrp><ntig><termGrp><term id="1275663">park</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2718845">прыпыніць</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26535_1275693_2774636"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To answer a call by dialing the associated number on the network where it has been parked.</descrip></descripGrp><ntig><termGrp><term id="1275693">retrieve</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2774636">узнавіць</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26550_1275968_1864969"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The listing of contents created by bookmarking blocks of text and creating the table of contents of the bookmarked area.</descrip></descripGrp><ntig><termGrp><term id="1275968">ookmark TOC</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1864969">змест закладак</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26554_1276172_1864970"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The window that contains the user's workbook of tabbed sheets.</descrip></descripGrp><ntig><termGrp><term id="1276172">workbook window</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1864970">акно кнігі</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26555_1276173_1573715"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A prewritten formula that simplifies the process of entering calculations and enables the user to use formulas that might be difficult to build from scratch.</descrip></descripGrp><ntig><termGrp><term id="1276173">function</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1573715">функцыя</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26558_1276179_2052336"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of Human Interaction Proof challenge, which plays an audio file decipherable only by a person. The audio file might seem faint or mixed with background voices and noise. This is intentional to ensure a person, not an automated program, completes the HIP challenge.</descrip></descripGrp><ntig><termGrp><term id="1276179">audio challenge</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2052336">аўдыяправерка</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26571_1276626_1864971"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A range of cells in a worksheet that has been formatted as a table and can be managed independently from the data in other rows and columns on the worksheet.</descrip></descripGrp><ntig><termGrp><term id="1276626">Excel table</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1864971">Табліца Excel</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26581_1278354_1864972"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A typographical unit of measure that is equal in width to the point size of a particular font. For many fonts, this is equal to the width of a capita