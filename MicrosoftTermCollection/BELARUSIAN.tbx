Note type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2825045">вопыт працаўніка</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49865_2831277_2834837"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A section of the Productivity Score in Microsoft 365, which includes insights and recommendations about usage of Microsoft 365 products that are related to employee productivity, engagement, wellbeing, and related concepts.</descrip></descripGrp><ntig><termGrp><term id="2831277">Employee experience</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2834837">Вопыт працаўніка</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49866_2819444_2825095"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of Microsoft-recommended configuration settings along with an explanation of their security impact. These settings are based on feedback from Microsoft security engineering teams, product groups, partners, and customers.</descrip></descripGrp><ntig><termGrp><term id="2819444">security baseline</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2825095">базавы план бяспекі</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote ty