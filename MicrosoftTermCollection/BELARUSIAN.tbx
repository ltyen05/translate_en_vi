</langSet></termEntry><termEntry id="49804_2816519_2821758"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A connected experience that is optional, more precisely, it is not covered by the organization's license with Microsoft, but is instead licensed directly to the user.</descrip></descripGrp><ntig><termGrp><term id="2816519">cloud-backed service</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2821758">неабавязковая падключаная функцыя</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49804_2816520_2821732"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A connected experience that is optional, more precisely, it is not covered by the organization's license with Microsoft, but is instead licensed directly to the user.</descrip></descripGrp><ntig><termGrp><term id="2816520">optional connected experience</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2821732">воблачная служба</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49804_2816520_2821758"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A connected experience that is optional, more precisely, it is not covered by the organization's license with Microsoft, but is instead licensed directly to the user.</descrip></descripGrp><ntig><termGrp><term id="2816520">optional connected experience</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2821758">неабавязковая падключаная функцыя</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49805_2816521_2821748"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Measures of service quality of a network as seen by the customer.</descrip></descripGrp><ntig><termGrp><term id="2816521">network performance</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2821748">прадукцыйнасць сеткі</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49806_2816522_2821726"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature of Microsoft Teams that assesses the Office 365 tenant environment and identifies the most common configurations that may need to be updated or modified, and creates a Service management team with channels for each workload.</descrip></descripGrp><ntig><termGrp><term id="2816522">Advisor for Teams</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2821726">Дарадца</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49806_2816522_2821728"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature of Microsoft Teams that assesses the Office 365 tenant environment and identifies the most common configurations that may need to be updated or modified, and creates a Service management team with channels for each workload.</descrip></descripGrp><ntig><termGrp><term id="2816522">Advisor for Teams</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2821728">Дарадца для Teams</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49806_2816698_2821726"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature of Microsoft Teams that assesses the Office 365 tenant environment and identifies the most common configurations that may need to be updated or modified, and creates a Service management team with channels for each workload.</descrip></descripGrp><ntig><termGrp><term id="2816698">Advisor</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2821726">Дарадца</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49806_2816698_2821728"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature of Microsoft Teams that assesses the Office 365 tenant environment and identifies the most common configurations that may need to be updated or modified, and creates a Service management team with channels for each workload.</descrip></descripGrp><ntig><termGrp><term id="2816698">Advisor</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2821728">Дарадца для Teams</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49808_2816676_2821769"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Microsoft Teams, as part of Teams rollout done with Advisor for Teams, a workload is a set of features and settings that is used to deploy a specific collection of functions. Workloads are comprised of channels to complete the deployment of the functions.</descrip></descripGrp><ntig><termGrp><term id="2816676">workload</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2821769">рабочая нагрузка</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49810_2816681_2821767"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To convert a phone number to a different format, by using a set of rules.</descrip></descripGrp><ntig><termGrp><term id="2816681">translate</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2821767">пераўтварыць</term><termN