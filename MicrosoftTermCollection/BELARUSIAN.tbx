ech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2080511">рэкламны ID</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34595_1994025_1996254"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A name of a person as it is shown in a user interface.</descrip></descripGrp><ntig><termGrp><term id="1994025">display name</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1996254">бачнае імя</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34602_1994718_1998031"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The category of items that have recently become available.</descrip></descripGrp><ntig><termGrp><term id="1994718">New releases</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1998031">Навінкі</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34611_1995216_1998038"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app that allows users to connect remotely to a computer and access programs, files, and network resources as though they