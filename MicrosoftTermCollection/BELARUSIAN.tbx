rmEntry id="37135_2781058_2783789"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The offer for government organizations for OneDrive for Business that includes Office Online, and that is hosted in the commercial cloud environment.</descrip></descripGrp><ntig><termGrp><term id="2781058">OneDrive for Business with Office on the web (Government Pricing)</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2783789">вэб-версія OneDrive для бізнесу з пакетам Office (цана для дзяржаўных устаноў)</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37147_2108981_2110581"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Microsoft's portal site, offering news,  sports, weather, finance, autos, food &amp; drink, health &amp; fitness, autos, travel, weather,   music, videos,  TV, and entertainment &amp; celebrity gossip and shopping.</descrip></descripGrp><ntig><termGrp><term id="2108981">MSN Apps</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2110581">Прыкладанні MSN</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3715_39383_1573583"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A key that, when pressed in combination with another key, gives the other key an alternative meaning.</descrip></descripGrp><ntig><termGrp><term id="39383">Control key</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1573583">CTRL</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3715_39385_1573583"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A key that, when pressed in combination with another key, gives the other key an alternative meaning.</descrip></descripGrp><ntig><termGrp><term id="39385">CTRL</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1573583">CTRL</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3715_39387_1573583"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A key that, when pressed in combination with another key, gives the other key an alternative meaning.</descrip></descripGrp><ntig><termGrp><term id="39387">CTRL key</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1573583">CTRL</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37240_2113073_2140002"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The transient, contextual UI element that appears near to the user’s focus and appears as an ellipsis within a square.</descrip></descripGrp><ntig><termGrp><term id="2113073">Mini Toolbar Indicator</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2140002">Індыкатар міні-панэлі інструментаў</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37242_2113075_2140008"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A callout in a UI that contains help information for a new feature, is context-sensitive, and contains information in the form of text, graphics, or animations.</descrip></descripGrp><ntig><termGrp><term id="2113075">Teaching callout</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2140008">Інфармацыйная вынаска</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37244_2113077_2140003"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The filter in the context of a particular channel that shows only the videos uploaded or owned by the user who is currently logged in.</descrip></descripGrp><ntig><termGrp><term id="2113077">My videos</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2140003">Маё відэа</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37249_2113090_2214906"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user account and associated credentials that is used to access Microsoft’s and 3rd parties’ business services, such as Office 365. Work or school accounts are usually assigned to end users by their organization (work, school, non-profit) and managed by the admin. However, some business services like Yammer support work or school accounts that were created by end users, without IT involvement. We sometimes refer to these accounts as “viral” AAD accounts but we don’t use this term externally. Work or school accounts are stored in Azure Active Directory (AAD) and managed by Microsoft on behalf of the organization. One of the key difference with a Microsoft account is that users don’t own the account and will typically loose access to it if they leave the organization. Other aspects like password policies are imposed by admins.</descrip></descripGrp><ntig><termGrp><term id="2113090">work or school account</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2214906">Працоўны альбо школьны ўліковы запіс</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37250_2113091_2214905"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user account and associated credentials that is used to access Microsoft’s and 3rd parties’ business services, such as Office 365. Work or school accounts are usually assigned to end users by their organization (work, school, non-profit) and managed by the admin. However, some business services like Yammer support work or school accounts that were created by end users, without IT involvement. We sometimes refer to these accounts as “viral” AAD accounts but we don’t use this term externally. Work or school accounts are stored in Azure Active Directory (AAD) and managed by Microsoft on behalf of the organization. One of the key difference with a Microsoft account is that users don’t own the account and will typically loose access to it if they leave the organization. Other aspects like password policies are imposed by admins.</descrip></descripGrp><ntig><termGrp><term id="2113091">work account</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2214905">Працоўны ўліковы запіс</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37255_2113318_2182158"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Terminal Services session.</descrip></descripGrp><ntig><termGrp><term id="2113318">TS session</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2182158">TS-сеанс</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37255_2113319_2182158"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Terminal Services session.</descrip></descripG