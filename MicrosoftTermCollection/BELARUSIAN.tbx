posite directions (-&gt; &lt;- or &lt;- -&gt;).</descrip></descripGrp><ntig><termGrp><term id="766602">zoom</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2529789">маштабаванне</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21095_766604_1574057"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A multi-touch gesture that consists of two fingers moving around a center point or one finger moving around a finger that is not moving.</descrip></descripGrp><ntig><termGrp><term id="766604">rotation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1574057">паварочванне</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21098_1508790_1573784"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The worldwide collection of networks and gateways that use the TCP/IP suite of protocols to communicate with one another.</descrip></descripGrp><ntig><termGrp><term id="1508790">Internet</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1573784">Інтэрнэт</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">S