Grp><descrip type="definition">The prerelease build of Windows 10 for phones that was made available to Insiders.</descrip></descripGrp><ntig><termGrp><term id="2254283">Windows 10 Mobile Insider Preview</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2257743">Windows 10 Mobile Insider Preview</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38695_2254284_2257744"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The professional edition of Windows 10 Insider Preview released in April 2015 or later.</descrip></descripGrp><ntig><termGrp><term id="2254284">Windows 10 Pro Insider Preview</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2257744">Windows 10 Pro Insider Preview</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38696_2254285_2257746"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The prerelease build of the next version of Windows, made available to customers in Spring 2015 or later.</descrip></descripGrp><ntig><termGrp><term id="2254285">Windows Insider Preview</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2257746">Windows Insider Preview</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38698_2254352_2257732"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The set of features that seamlessly adapt and optimize the user interface for different devices, modes of working, hardware, or platforms.</descrip></descripGrp><ntig><termGrp><term id="2254352">Continuum</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2257732">Continuum</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38699_2254353_2257733"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The photo displayed at the top of an album, and used to represent the whole album when albums are shown in list view. It is also used to describe the representative photo in a stack (of near duplicate photos).</descrip></descripGrp><ntig><termGrp><term id="2254353">cover photo</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2257733">вокладка</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38699_2254353_2257734"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The photo displayed at the top of an album, and used to represent the whole album when al