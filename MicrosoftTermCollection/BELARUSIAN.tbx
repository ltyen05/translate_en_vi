term id="216700">broadband network</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1573478">шырокапалосная сетка</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27004_1362158_1599379"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A webpage link saved as a .url file in someone's "Favorites" folder on Windows OneDrive. Favorites can be created directly within OneDrive, or via the Windows Live Toolbar.</descrip></descripGrp><ntig><termGrp><term id="1362158">favorite</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1599379">абранае</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27007_1362193_2693519"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A service that manages media quality over a wide area network (WAN) connection by either rerouting traffic or by denying connection requests when bandwidth is approaching saturation.</descrip></descripGrp><ntig><termGrp><term id="1362193">call admission control</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2693519">кантроль дапушчальнасці выклікаў</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender