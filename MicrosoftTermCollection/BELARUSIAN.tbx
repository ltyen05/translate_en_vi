aining to the access level for Office Web Apps in which consumers who are not signed in with a license or can view existing documents, but can't edit them or create new documents.</descrip></descripGrp><ntig><termGrp><term id="2300132">view-only</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2308226">толькі для прагляду</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39488_2300148_2308219"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An ideogram originating in Japanese electronic messages or websites and used to express an idea, emotion, etc. in electronic communication.</descrip></descripGrp><ntig><termGrp><term id="2300148">emoji</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2308219">эмадзы</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39489_2300781_2308221"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A unit of measure for the workload of an employed person or a student that allows comparison to one full-time workload in the particular environment.</descrip></descripGrp><ntig><termGrp><term id="2300781">full-time equivalent</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2308221">ЭПЗ</t