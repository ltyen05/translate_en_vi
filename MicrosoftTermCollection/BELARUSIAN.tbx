rvice</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1962703">сэрвіс Windows</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33937_1954227_1962701"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To tap with two fingers on a touchpad or similar device at the same time and with a relatively short distance between each other.</descrip></descripGrp><ntig><termGrp><term id="1954227">tap two fingers</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1962701">даткнуцца двума пальцамі</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33938_1954263_1962702"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The search result that is most relevant to a user.</descrip></descripGrp><ntig><termGrp><term id="1954263">top result</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1962702">топ-вынік</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33940_1954750_2674097"><langSet xml:lang="en-US"><descripGrp><descrip typ