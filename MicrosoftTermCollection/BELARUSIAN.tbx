<term id="2349842">Velocity Ink</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40341_2345591_2346296"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To mark a location on a map by interacting directly with the map, instead of searching for an address or place name.</descrip></descripGrp><ntig><termGrp><term id="2345591">drop a pin</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2346296">прыкалоць шпільку</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40342_2345592_2346299"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A location marker that users can manually add to a map, so they can see it on the map and get additional location info and directions.</descrip></descripGrp><ntig><termGrp><term id="2345592">pin</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2346299">шпілька</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40343_2345593_2349834"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to the owner of a collection of content.</descrip></descripGrp><ntig><termGrp><term id="2345593">curated by</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2349834">адабраны</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40344_2345594_2349833"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To collect content and present it together.</descrip></descripGrp><ntig><termGrp><term id="2345594">curate</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2349833">адбіраць</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40345_2345596_2346301"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The place inside Microsoft Wallet where you store your credit cards, loyalty cards, coupons, boarding passes, and event tickets.</descrip></descripGrp><ntig><termGrp><term id="2345596">wallet</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2346301">кашалёк</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40353_2346147_2349835"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Excel worksheet function using nested if functions that test conditions in order and if passed, the result is returned.</descrip></descripGrp><ntig><termGrp><term id="2346147">IFS</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2349835">IFS</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40371_2346698_2349839"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A smaller activity within a task.</descrip></descripGrp><ntig><termGrp><term id="2346698">subtask</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2349839">падзадача</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40392_2347434_2349765"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A chart, resembling a funnel, that displays values as progressively decreasing proportions.</descrip></descripGrp><ntig><termGrp><term id="2347434">funnel chart</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2349765">лейкападобная дыяграма</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40398_2347587_2349770"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A chart that reflects fluctuation of data.</descrip></descripGrp><ntig><termGrp><term id="2347587">stock chart</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2349770">біржавая дыяграма</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40399_2347588_2349764"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Docs.com online portfolio on a user's profile site that displays resume content as rendered by Sway.</descrip></descripGrp><ntig><termGrp><term id="2347588">About</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2349764">Партфоліа</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4040_232554_2630918"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A procedure for determining the resource capacity requirements that meet the demand of future output during specific time periods.</descrip></descripGrp><ntig><termGrp><term id="232554">capacity planning</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2630918">планаванне магутнасці</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSp