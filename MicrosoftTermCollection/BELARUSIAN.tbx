><ntig><termGrp><term id="674572">horizontal axis</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1864724">гарызантальная вось</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10113_308303_1806300"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To publish or write entries for a blog.</descrip></descripGrp><ntig><termGrp><term id="308303">blog</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1806300">блог</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10114_115262_1574131"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ability to interpret vocal commands or convert spoken words into computer-readable text. Speech recognition programs enable you to control an application or enter text by speaking into a microphone, rather than by using a keyboard.</descrip></descripGrp><ntig><termGrp><term id="115262">speech recognition</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1574131">распазнаванне маўлення</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10114_115263_1574131"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ability to interpret vocal commands or convert spoken words into computer-readable text. Speech recognition programs enable you to control an application or enter text by speaking into a microphone, rather than by using a keyboard.</descrip></descripGrp><ntig><termGrp><term id="115263">voice recognition</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1574131">распазнаванне маўлення</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10127_38090_1816164"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ability of hardware devices or software packages to transmit data between other devices or packages.</descrip></descripGrp><ntig><termGrp><term id="38090">connectivity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1816164">магчымасць падключэння</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10128_100700_1574029"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To update displayed information with current data.</descrip></descripGrp><ntig><termGrp><term id="100700">refresh</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1574029">абнавіць</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10133_397206_2296552"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A string value that is used to identify a named property within a given property set. Note that property names and property IDs are mutually exclusive.</descrip></descripGrp><ntig><termGrp><term id="397206">property name</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296552">імя ўласцівасці</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1014_522495_1779880"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A software system that enables applications to interact with hardware and that manages software resources on a computer.</descrip></descripGrp><ntig><termGrp><term id="522495">OS</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1779880">аперацыйная сістэма</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1014_87933_1779880"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A software system that enables applications to interact with hardware and that manages software resources on a computer.</descrip></descripGrp><ntig><termGrp><term id="87933">operating system</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1779880">аперацыйная сістэма</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10140_168764_2296624"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A static image of a set of data, such as the records displayed as the result of a query.</descrip></descripGrp><ntig><termGrp><term id="168764">snapshot</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296624">ценявая копія</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10140_168764_2296634"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A static image of a set of data, such as the records displayed as the result of a query.</descrip></descripGrp><ntig><termGrp><term id="168764">snapshot</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296634">здымак</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10140_168765_2296624"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A static image of a set of data, such as the records displayed as the result of a query.</descrip></descripGrp><ntig><termGrp><term id="168765">shadow copy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296624">ценявая копія</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10140_168765_2296634"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A static image of a set of data, such as the records displayed as the result of a query.</descrip></descripGrp><ntig><termGrp><term id="168765">shadow copy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296634">здымак</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10153_101934_2801936"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A build promoted for use or deployment. A release can be internal and used for further testing or external and released or deployed.</descrip></descripGrp><ntig><termGrp><term id="101934">release</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2801936">выпуск</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10161_17417_2411854"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To grant a person, computer process, or device access to certain information, services or functionality.</descrip></descripGrp><ntig><termGrp><term id="17417">authorize</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2411854">аўтарызаваць</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10179_143328_1864274"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A bar marked off in units of measure (such as inches) that is displayed across the top of the document window.</descrip></descripGrp><ntig><termGrp><term id="143328">horizontal ruler</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1864274">гарызантальная лінейка</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1018_32207_1755586"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To press and release a mouse button once without moving the mouse, usually to select or deselect an item or to activate a program or program feature.</descrip></descripGrp><ntig><termGrp><term id="32207">click</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1755586">націснуць</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10180_131401_2072222"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An image that appears as the background to a document. Generally faded and transparent, so that text can be clearly read over it.</descrip></descripGrp><ntig><termGrp><term id="131401">watermark</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2072222">вадзяны знак</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10186_126193_2308215"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To remove oneself as a recipient on a mailing list.</descrip></descripGrp><ntig><termGrp><term id="126193">unsubscribe</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2308215">скасаваць падпіску</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10188_42237_1573589"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A representation of concepts such as facts or instructions in a formalized manner, suitable for communication, interpretation or processing.</descrip></descripGrp><ntig><termGrp><term id="42237">data</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1573589">дадзеныя</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10189_110172_1806227"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A line that separates groups of controls (on a surface) or commands (on a menu).</descrip></descripGrp><ntig><termGrp><term id="110172">separator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1806227">раздзяляльнік</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10189_722343_1806227"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A line that separates groups of controls (on a surface) or commands (on a menu).</descrip></descripGrp><ntig><termGrp><term id="722343">separator bar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1806227">раздзяляльнік</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1019_36322_1573547"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The degree to which a computer, an attached device, a data file, or a program can work with or understand the same commands, formats, or language as another. True compatibility means that any operational differences are invisible to people and programs alike.</descrip></descripGrp><ntig><termGrp><term id="36322">compatibility</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1573547">сумяшчальнасць</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10190_122191_2014550"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A command button used in a toolbar (or status bar).</descrip></descripGrp><ntig><termGrp><term id="122191">toolbar button</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2014550">кнопка панэлі інструментаў</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10206_718_1816176"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Any technology used to protect the interests of owners of digital content and services (such as copyright owners). Typically, authorized recipients or users must acquire a license in order to use the content.</descrip></descripGrp><ntig><termGrp><term id="718">digital rights management</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1816176">кіраванне лічбавымі правамі</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10206_719_1816176"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Any technology used to protect the interests of owners of digital content and services (such as copyright owners). Typically, authorized recipients or users must acquire a license in order to use the content.</descrip></descripGrp><ntig><termGrp><term id="719">DRM</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1816176">кіраванне лічбавымі правамі</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10208_413716_1864583"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A cell range that you consolidate in the destination area you specify.</descrip></descripGrp><ntig><termGrp><term id="413716">source area</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1864583">зыходная вобласць</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10218_358371_1574038"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A database object that prints information formatted and organized according to your specifications.</descrip></descripGrp><ntig><termGrp><term id="358371">report</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1574038">справаздача</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10221_321899_1573699"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">One or more lines of text in the bottom margin area of a page. A footer may contain elements such as the page number, the name of the file, or the date.</descrip></descripGrp><ntig><termGrp><term id="321899">running foot</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1573699">ніжні калонтытул</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10221_321901_1573699"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">One or more lines of text in the bottom margin area of a page. A footer may contain elements such as the page number, the name of the file, or the date.</descrip></descripGrp><ntig><termGrp><term id="321901">page footer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1573699">ніжні калонтытул</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10221_55459_1573699"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">One or more lines of text in the bottom margin area of a page. A footer may contain elements such as the page number, the name of the file, or the date.</descrip></descripGrp><ntig><termGrp><term id="55459">footer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1573699">ніжні калонтытул</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10231_147179_2296554"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A window used to view or modify the properties of various objects such as tables, queries, fields, forms, reports, data access pages, and controls.</descrip></descripGrp><ntig><termGrp><term id="147179">property sheet</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296554">старонка ўласцівасцей</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10241_232395_1864434"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A list that allows you to block a language encoding or character set in order to filter out unwanted international email messages that display in a language you don't understand.</descrip></descripGrp><ntig><termGrp><term id="232395">Blocked Encodings List</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1864434">Спіс заблакіраваных кадовак</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10245_35554_1772719"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A string of text written in the command language and passed to the command interpreter for execution.</descrip></descripGrp><ntig><termGrp><term id="35554">command line</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1772719">камандны радок</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10254_85648_1573909"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A short piece of content that is informative.</descrip></descripGrp><ntig><termGrp><term id="85648">note</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1573909">нататкі</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10261_125604_1574202"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">When referring to software, to remove program files and folders from the hard disk and remove related data from the registry so the software or solution is no longer available.</descrip></descripGrp><ntig><termGrp><term id="125604">uninstall</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1574202">выдаліць</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10261_736801_1574202"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">When referring to software, to remove program files and folders from the hard disk and remove related data from the registry so the software or solution is no longer available.</descrip></descripGrp><ntig><termGrp><term id="736801">deinstall</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1574202">выдаліць</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10265_234076_1864491"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The button that brings up an international list that allows users to block emails from those domains.</descrip></descripGrp><ntig><termGrp><term id="234076">Blocked Top-Level Domain List</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1864491">Спіс заблакіраваных даменаў верхняга ўзроўню</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10268_169412_1574027"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To do over again.</descrip></descripGrp><ntig><termGrp><term id="169412">redo</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1574027">вярнуць</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10275_6075_1864078"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of changing the values in cells to see how those changes affect the outcome of formulas on a worksheet. For example, varying the interest rate that is used in an amortization table to determine the amount of the payments.</descrip></descripGrp><ntig><termGrp><term id="6075">what-if analysis</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1864078">аналіз "што калі"</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10275_6076_1864078"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of changing the values in cells to see how those changes affect the outcome of formulas on a worksheet. For example, varying the interest rate that is used in an amortization table to determine the amount of the payments.</descrip></descripGrp><ntig><termGrp><term id="6076">"what-if" evaluation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1864078">аналіз "што калі"</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10276_232855_2296735"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An option that displays the Web page in a Web browser.</descrip></descripGrp><ntig><termGrp><term id="232855">Web Page Preview</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296735">Папярэдні прагляд вэб-старонкі</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10278_142089_2296301"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A technique in which you filter records in a form, datasheet, or data access page to retrieve only those records that don't contain the selected value.</descrip></descripGrp><ntig><termGrp><term id="142089">Filter Excluding Selection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296301">фільтраванне за выключэннем абранага</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1029_124235_1806305"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Existing in reference to two measures, such as height and width--for example, a two-dimensional model drawn with reference to an x-axis and a y-axis, or a two-dimensional array of numbers placed in rows and columns.</descrip></descripGrp><ntig><termGrp><term id="124235">two-dimensional</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1806305">2-D</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1029_320452_1806305"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Existing in reference to two measures, such as height and width--for example, a two-dimensional model drawn with reference to an x-axis and a y-axis, or a two-dimensional array of numbers placed in rows and columns.</descrip></descripGrp><ntig><termGrp><term id="320452">2-D</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1806305">2-D</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10290_81930_1864137"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A handle that is displayed on some objects such as toolbars, tables, or on indivi