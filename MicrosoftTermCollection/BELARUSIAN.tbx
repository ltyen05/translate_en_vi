ion">The first-party Windows app for playing commercial and homemade DVD-Video discs.</descrip></descripGrp><ntig><termGrp><term id="2259500">DVD Player</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2262978">DVD-прайгравальнік Windows</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38860_2259501_2262970"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The first-party Windows app for playing commercial and homemade DVD-Video discs.</descrip></descripGrp><ntig><termGrp><term id="2259501">Windows DVD Player</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2262970">DVD-прайгравальнік</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38860_2259501_2262978"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The first-party Windows app for playing commercial and homemade DVD-Video discs.</descrip></descripGrp><ntig><termGrp><term id="2259501">Windows DVD Player</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2262978">DVD-прайгравальнік Windows</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38866_2259535_2262980"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The variable default lock screen image that shows beautiful images on lock combined with hotspots containing fun facts, Windows tips/trick, and more. Users can switch from this default lock screen to a personal picture.</descrip></descripGrp><ntig><termGrp><term id="2259535">Windows spotlight</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2262980">Табло Windows</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38878_2259608_2262984"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A code used to remove Reset protection without having the Microsoft account credentials that were used to turn it on.</descrip></descripGrp><ntig><termGrp><term id="2259608">recovery key</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2262984">код аднаўлення</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38879_2259611_2436037"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To add a shortcut to an application or part of an application or contact by fixing its tile to the Start screen (the full screen view of Start) or Start menu.</descrip></descripGrp><ntig><termGrp><term id="2259611">pin to Start</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2436037">замацаваць на Экране запуску</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38879_2259611_2436038"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To add a shortcut to an application or part of an application or contact by fixing its tile to the Start screen (the full screen view of Start) or Start menu.</descrip></descripGrp><ntig><termGrp><term id="2259611">pin to Start</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2436038">замацаваць у меню "Пуск"</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3888_25223_1573485"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A communication line used for data transfer among the components of a computer system.</descrip></descripGrp><ntig><termGrp><term id="25223">bus</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1573485">шына</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38880_2259632_2262969"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In the Windows Store for Business and Education Store, to get apps and other digital goods into the hands of employees or students.</descrip></descripGrp><ntig><termGrp><term id="2259632">distribute</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2262969">размеркаваць</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38881_2259633_2262981"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mode that allows using one app on your mobile screen while using a different app on a second screen that you're projecting from the mobile device.</descrip></descripGrp><ntig><termGrp><term id="2259633">dual-screen mode</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2262981">рэжым двух экранаў</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38882_2259634_2262971"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that lets customers extend their gaming experience across multiple devices, play with other users, and show off scores and achievements.</descrip></descripGrp><ntig><termGrp><term id="2259634">game hub</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2262971">гульнявы асяродак</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38883_2259635_2262972"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The default browser in Windows 10, which provides a more interoperable, reliable, and discoverable experience with advanced features including the ability to annotate on web pages, a distraction-free reading experience, and integration of Cortana. Also available on iOS and Android.</descrip></descripGrp><ntig><termGrp><term id="2259635">Microsoft Edge</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2262972">Microsoft Edge</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38884_2259636_2262974"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The source location of files that are stored on OneDrive and not synced to the local device. This is different from other OneDrive files (just called "OneDrive"), where a copy is synced and stored locally as well as in the cloud.</descrip></descripGrp><ntig><termGrp><term id="2259636">OneDrive (cloud only)</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2262974">OneDrive (толькі воблака)</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">No