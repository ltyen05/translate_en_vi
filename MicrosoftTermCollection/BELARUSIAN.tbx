27"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A security feature that monitors programs on a computer to determine if they use system memory safely.</descrip></descripGrp><ntig><termGrp><term id="168226">Data Execution Prevention</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1772727">Прадухіленне выканання дадзеных</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11319_168226_2610729"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A security feature that monitors programs on a computer to determine if they use system memory safely.</descrip></descripGrp><ntig><termGrp><term id="168226">Data Execution Prevention</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2610729">DEP</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11319_168227_1772727"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A security feature that monitors programs on a computer to determine if they use system memory safely.</descrip></descripGrp><ntig><termGrp><term id="168227">DEP</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1772727">Прадухіленне выканання дадзеных</term><termNote type="geographicalUsage">BLR</termNote><termNote type="p