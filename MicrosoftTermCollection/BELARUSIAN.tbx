 id="26977_1361740_1599368"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The UI label in Messenger for the results list of a contacts search.</descrip></descripGrp><ntig><termGrp><term id="1361740">Contacts</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1599368">Кантакты</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26979_1361742_1599383"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The UI label for a permissions setting that indicates an item is being shared with (made available to) all of someone's friends.</descrip></descripGrp><ntig><termGrp><term id="1361742">Friends</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1599383">Сябры</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26982_1361745_1599428"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A presentation method in Messenger that allows someone to maintain multiple conversations in a tabbed view.</descrip></descripGrp><ntig><termGrp><term id="1361745">tabbed conversations</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1599428">размовы ва ўкладках</term><termNote type="geographicalUsage">BLR</termNote><termNote type="part