rip></descripGrp><ntig><termGrp><term id="2321515">mixtape</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2324975">мікс-стужка</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39012_2268334_2269646"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Cellular data that customers can buy from the Windows Store to connect to their Windows device.</descrip></descripGrp><ntig><termGrp><term id="2268334">paid cellular data</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2269646">платная мабільная перадача дадзеных</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39013_2268335_2269647"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Wi-Fi data or cellular data network that customers can connect to by buying minutes from the Windows Store.</descrip></descripGrp><ntig><termGrp><term id="2268335">paid data network</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2269647">платная сетка перадачы дадзеных</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39015_2268349_2269650"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An area in the Music app where recently played songs/albums and service-generated mixes are aggregated.</descrip></descripGrp><ntig><termGrp><term id="2268349">quick play</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2269650">хуткае прайграванне</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3902_139982_1864233"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A presentation within a presentation in which you group slides in an existing presentation so that you can show that section of the presentation to a particular audience.</descrip></descripGrp><ntig><termGrp><term id="139982">custom show</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1864233">адвольны паказ</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3906_30558_1806180"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A distance between characters in a line of text.</descrip></descripGrp><ntig><termGrp><term id="30558">character spacing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1806180">інтэрвал паміж сімваламі</term><termNote type="geographicalUsage"