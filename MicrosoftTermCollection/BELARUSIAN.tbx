ig><termGrp><term id="2556353">Multi-Geo Capabilities</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45210_2866055_2665965"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that allows customers to store their users’ Office 365 data in specific Office 365 geographical locations to fulfill regulatory data residency requirements.</descrip></descripGrp><ntig><termGrp><term id="2866055">Microsoft 365 Multi-Geo</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2665965">Multi-Geo</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45210_2866055_2760793"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that allows customers to store their users’ Office 365 data in specific Office 365 geographical locations to fulfill regulatory data residency requirements.</descrip></descripGrp><ntig><termGrp><term id="2866055">Microsoft 365 Multi-Geo</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2760793">Office 365 Multi-Geo</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45211_2579517_2581661"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The readiness reporting feature that is used to scan devices and Office documents to determine their readiness to support the Click-to-Run version of Office.</descrip></descripGrp><ntig><termGrp><term id="2579517">Readiness Toolkit for Office add-ins and VBA</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2581661">Readiness Toolkit for Office add-ins and VBA</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4523_146682_1864317"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows you to run a presentation over the Web. The presentation is saved in HTML format and can contain audio and video. It can also be recorded and saved to be viewed later.</descrip></descripGrp><ntig><termGrp><term id="146682">presentation broadcast</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1864317">вяшчанне прэзентацыі</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4525_5939_2296613"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The protocol that improves the security of data communication by using a combination of data encryption, digital certificates, and public key cryptography. SSL enables authentication and increases data integrity and privacy over networks. SSL does not provide authorization or nonrepudiation.</descrip></descripGrp><ntig><termGrp><term id="5939">Secure Sockets Layer</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296613">Узровень абароненых сокетаў (SSL)</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4525_5939_2296771"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The protocol that improves the security of data communication by using a combination of data encryption, digital certificates, and public key cryptography. SSL enables authentication and increases data integrity and privacy over networks. SSL does not provide authorization or nonrepudiation.</descrip></descripGrp><ntig><termGrp><term id="5939">Secure Sockets Layer</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296771">SSL</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4525_5940_2296613"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The protocol that improves the security of data communication by using a combination of data encryption, digital certificates, and public key cryptography. SSL enables authentication and increases data integrity and privacy over networks. SSL does not provide authorization or nonrepudiation.</descrip></descripGrp><ntig><termGrp><term id="5940">SSL</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296613">Узровень абароненых сокетаў (SSL)</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4525_5940_2296771"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The protocol that improves the security of data communication by using a combination of data encryption, digital certificates, and public key cryptography. SSL enables authentication and increases data integrity and privacy over networks. SSL does not provide authorization or nonrepudiation.</descrip></descripGrp><ntig><termGrp><term id="5940">SSL</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296771">SSL</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45253_2555759_2558528"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A unit of measurement used in traditional tabletop role-playing games and role-playing video games to quantify a player character's progression through the game. Experience points are awarded for the completion of quests, overcoming obstacles and opponents, and for successful role-playing.</descrip></descripGrp><ntig><termGrp><term id="2555759">XP</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2558528">XP</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45256_2555925_2558527"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The category in the Settings app where developers can configure their Xbox Live accounts in order to take advantage of the Xbox Live features and services.</descrip></descripGrp><ntig><termGrp><term id="2555925">Xbox Networking</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2558527">Сувязі Xbox</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45266_2556358_2751198"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of technologies brought together to provide a holistic view of an organization’s information technology (IT) security infrastructure.</descrip></descripGrp><ntig><termGrp><term id="2556358">Security Information and Event Management</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2751198">кіраванне інфармацыйнай бяспекай і падзеямі бяспекі</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45266_2556358_2751201"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of technologies brought together to provide a holistic view of an organization’s information technology (IT) security infrastructure.</descrip></descripGrp><ntig><termGrp><term id="2556358">Security Information and Event Management</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2751201">SIEM</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45266_2556359_2751198"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of technologies brought together to provide a holistic view of an organization’s information technology (IT) security infrastructure.</descrip></descripGrp><ntig><termGrp><term id="2556359">SIEM</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2751198">кіраванне інфармацыйнай бяспекай і падзеямі бяспекі</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45266_2556359_2751201"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of technologies brought together to provide a holistic view of an organization’s information technology (IT) security infrastructure.</descrip></descripGrp><ntig><termGrp><term id="2556359">SIEM</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2751201">SIEM</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45269_2556878_2562270"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A handle that allows users to scroll by touching the device's screen.</descrip></descripGrp><ntig><termGrp><term id="2556878">scroll handle</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2562270">маркер пракручвання</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45282_2556931_2562267"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ink effect in the colors of a rainbow.</descrip></descripGrp><ntig><termGrp><term id="2556931">rainbow</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2562267">вясёлка</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45283_2556932_2562264"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An effect applied to digital ink.</descrip></descripGrp><ntig><termGrp><term id="2556932">ink effect</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2562264">эфект рукапісанага ўводу</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45284_2556933_2562262"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ink effect that contains darker background colors and bright stars that appear to sparkle.</descrip></descripGrp><ntig><termGrp><term id="2556933">galaxy</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2562262">галактыка</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45285_2556934_2562263"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ink effect in the color of gold.</descrip></descripGrp><ntig><termGrp><term id="2556934">gold</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2562263">золата</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45286_2556935_2562271"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ink effect in the color of silver.</descrip></descripGrp><ntig><termGrp><term id="2556935">silver</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2562271">срэбра</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45289_2556938_2562260"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ink effect in the color of bronze.</descrip></descripGrp><ntig><termGrp><term id="2556938">bronze</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2562260">бронза</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45290_2556941_2562266"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ink effect in the color of the ocean.</descrip></descripGrp><ntig><termGrp><term id="2556941">ocean</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2562266">акіян</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45291_2556942_2562268"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ink effect in the color of rose gold.</descrip></descripGrp><ntig><termGrp><term id="2556942">rose gold</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2562268">ружовае золата</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45292_2556943_2562265"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ink effect that resembles the color and texture of lava.</descrip></descripGrp><ntig><termGrp><term id="2556943">lava</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2562265">лава</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45294_2556950_2562261"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature applied to an object on the screen to change its visual appearance often to cause a certain reaction.</descrip></descripGrp><ntig><termGrp><term id="2556950">effect</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2562261">эфект</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="453_346972_1573643"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Without difficulty.</descrip></descripGrp><ntig><termGrp><term id="346972">easily</term><termNote type="partOfSpeech">Adverb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1573643">проста</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Adverb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45305_2556986_2557283"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The name of the premium experience for mixed reality when used with PC hardware that can support higher resolution/quality graphics.</descrip></descripGrp><ntig><termGrp><term id="2556986">Windows Mixed Reality Ultra</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2557283">Windows Mixed Reality Ultra</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45308_2558356_2740390"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The service for administrators to detect anomalous or high-risk user activity, discover 3rd-party cloud apps that are being used in their organization that have similar functionality to Office 365, and block 3rd-party application's access to Office 365 information.</descrip></descripGrp><ntig><termGrp><term id="2558356">Office 365 Cloud App Security</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2740390">Cloud App Security</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45308_2558359_2740390"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The service for administrators to detect anomalous or high-risk user activity, discover 3rd-party cloud apps that are being used in their organization that have similar functionality to Office 365, and block 3rd-party application's access to Office 365 information.</descrip></descripGrp><ntig><termGrp><term id="2558359">Cloud App Security</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2740390">Cloud App Security</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4531_168151_1573424"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To add a special visual or sound effect to text or an object. For example, you can have your text bullet points fly in from the left, one word at a time, or hear the sound of applause when a picture is uncovered.</descrip></descripGrp><ntig><termGrp><term id="168151">animate</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1573424">анімаваць</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4544_140325_2296197"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A connection that specifies the name, type, location, and, optionally, other information about a database file or server.</descrip></descripGrp><ntig><termGrp><term id="140325">database connection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296197">падключэнне да базы дадзеных</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4544_683602_2296197"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A connection that specifies the name, type, location, and, optionally, other information about a database file or server.</descrip></descripGrp><ntig><termGrp><term id="683602">data connection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296197">падключэнне да базы дадзеных</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4548_30603_1864094"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A combination of any of the character formatting options identified by a style name.</descrip></descripGrp><ntig><termGrp><term id="30603">character style</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1864094">стыль знака</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45540_2567657_2568676"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An automatically downloaded add-on for the inbox Microsoft Photos app that provides additional content such as music tracks, special effects, and sample videos to use when creating videos in the Photos app.</descrip></descripGrp><ntig><termGrp><term id="2567657">Photos Add-on</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2568676">Дадатковы кампанент для «Фатаграфій»</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45541_2567793_2707914"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Threat management feature available from the Office 365 Security &amp; Compliance Center to simulate attacks, focusing on breaching accounts, data extraction, elevation of privilege, and data modification/deletion, to assess user practices related to security.</descrip></descripGrp><ntig><termGrp><term id="2567793">Attack Simulator</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2707914">Сімулятар атак</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45541_2702818_2707914"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Threat management feature available from the Office 365 Security &amp; Compliance Center to simulate attacks, focusing on breaching accounts, data extraction, elevation of privilege, and data modification/deletion, to assess user practices related to security.</descrip></descripGrp><ntig><termGrp><term id="2702818">Attack simulator</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2707914">Сімулятар атак</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45544_2567898_2568614"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that provides a view to focus on a specific line or set of lines of text for people using the Immersive Reader.</descrip></descripGrp><ntig><termGrp><term id="2567898">Line Focus</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2568614">Радковы фокус</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45559_2569039_2570639"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The use of software for collaboration between people in real-time.</descrip></descripGrp><ntig><termGrp><term id="2569039">real-time collaboration</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2570639">супрацоўніцтва ў рэальным часе</term><termNote type="geographicalUsage">BLR</te