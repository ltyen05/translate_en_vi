 SNMP agent software is also sometimes referred to as an agent.</descrip></descripGrp><ntig><termGrp><term id="10234">agent</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1573414">агент</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8801_1177095_1573511"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An optical storage medium for digital data.</descrip></descripGrp><ntig><termGrp><term id="1177095">optical disc</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1573511">CD</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8801_1177095_1765221"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An optical storage medium for digital data.</descrip></descripGrp><ntig><termGrp><term id="1177095">optical disc</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1765221">кампакт-дыск</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8801_28973_1573511"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An o