ig></langSet></termEntry><termEntry id="32212_1638657_1659933"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The boundary of a physical or rendered object, such as a display screen or window.</descrip></descripGrp><ntig><termGrp><term id="1638657">edge</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1659933">край</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32213_1638658_1769387"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To transfer data such as files to a device or an app.</descrip></descripGrp><ntig><termGrp><term id="1638658">send</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1769387">адправіць</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32219_1641030_1865141"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tool that is used to apply formatting to borders in a table.</descrip></descripGrp><ntig><termGrp><term id="1641030">Border Painter</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1865141">Рэдактар граніц</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32220_1641031_1865142"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tool used to collect the formatting of an existing table border so that it can be applied to another border.</descrip></descripGrp><ntig><termGrp><term id="1641031">Border Sampler</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1865142">Сродак фарміравання ўзораў граніц</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32221_1641032_1860285"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of APIs for SharePoint products. These APIs are based on the server object model, and can be called from clients such as desktop PCs and mobile devices.</descrip></descripGrp><ntig><termGrp><term id="1641032">client object model</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1860285">кліенцкая аб'ектная мадэль</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32221_1641033_1860285"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of APIs for SharePoint products. These APIs are based on the server object model, and can be called from clients such as desktop PCs and mobile devices.</descrip></descripGrp><ntig><termGrp><term id="1641033">CSOM</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1860285">кліенцкая аб'ектная мадэль</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32222_1641034_1865144"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The site template that is designed to create an online community where people come together to share ideas or get answers to their questions.</descrip></descripGrp><ntig><termGrp><term id="1641034">Community</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1865144">Супольнасць</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32223_1641035_2072191"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that extends AutoComplete functionality to show a live preview of suggested values for an entire range of cells based on what the user is typing.</descrip></descripGrp><ntig><termGrp><term id="1641035">Flash Fill</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2072191">Хуткае запаўненне</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32224_1641036_1865146"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Collections of proofing tools for different languages that that are available to users of Office applications.</descrip></descripGrp><ntig><termGrp><term id="1641036">Microsoft Office Proofing Tools</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1865146">Сродкі праверкі правапісу Microsoft Office</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32225_1718117_1865249"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of controls that helps users navigate directly to where they want to go in SharePoint, without having to navigate the hierarchy or edit the URL.</descrip></descripGrp><ntig><termGrp><term id="1718117">Search-Driven Navigation</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1865249">Навігацыя на аснове пошуку</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32226_1641038_1865147"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables subscription customers to launch Office rich client applications online from a computer on which those applications are not already installed.</descrip></descripGrp><ntig><termGrp><term id="1641038">Office on Demand</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1865147">Office па запыце</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32228_1641040_1865148"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables users to edit SharePoint list content directly without opening an edit window.</descrip></descripGrp><ntig><termGrp><term id="1641040">Quick Edit</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1865148">Хуткая праўка</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32229_1700971_1865235"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An integrated online storefront where site owners can purchase apps for SharePoint.</descrip></descripGrp><ntig><termGrp><term id="1700971">SharePoint Store</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1865235">Крама SharePoint</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32230_1641042_1865149"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An error log that contains errors and exceptions that occur when SharePoint tries to connect to external systems through Business Connectivity Services. It can be retrieved by tenant administrators.</descrip></descripGrp><ntig><termGrp><term id="1641042">tenant-level external data log</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1865149">гiсторыя знешнiх дадзеных на ўзроўнi клiента</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32232_1641044_1865150"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Outlook calendar feature that can be enabled to display the weather forecast for a selected location.</descrip></descripGrp><ntig><termGrp><term id="1641044">Weather Bar</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1865150">Панэль надвор'я</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32240_1641050_1865151"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A property grid that only displays the properties that appear in the sentence-level view of an action.</descrip></descripGrp><ntig><termGrp><term id="1641050">top-level property grid</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1865151">сетка уласцівасцяў верхняга ўзроўню</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32261_1644639_1865152"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A contextual summary of appointment or meeting information, which is displayed in a callout without opening the item.</descrip></descripGrp><ntig><termGrp><term id="1644639">calendar item peek</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1865152">кароткая зводка элементаў календара</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32262_1644650_1865153"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A contextual summary of the user's daily schedule, which is displayed in a callout without switching to the Calendar module.</descrip></descripGrp><ntig><termGrp><term id="1644650">Calendar peek</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1865153">Кароткая зводка календара</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32263_1644654_1865154"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A contextual summary of the user's task list, which is displayed in a callout without switching to the Tasks module.</descrip></descripGrp><ntig><termGrp><term id="1644654">Tasks peek</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1865154">Хуткі агляд задач</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32264_1707462_1865244"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tab in the Backstage view where users can manage their identities and services, view licensing details, and link to account management features.</descrip></descripGrp><ntig><termGrp><term id="1707462">Account</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1865244">Уліковы запіс</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32265_1644676_1865156"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Web Part that performs a search using a customizable query and presents the results in a custom view.</descrip></descripGrp><ntig><termGrp><term id="1644676">Content Search</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1865156">Пошук па змесціву</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32266_1644677_1865157"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A high-level view in Visual Designer that shows the stages of a SharePoint workflow, rather than individual actions or conditions.</descrip></descripGrp><ntig><termGrp><term id="1644677">stage view</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1865157">прагляд па этапах</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32267_1644678_1865158"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables Exchange users to see new email messages and up-to-date calendar items as soon as they open Outlook, without waiting for it to finish synchronizing.</descrip></descripGrp><ntig><termGrp><term id="1644678">Exchange Fast Access</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1865158">Хуткі доступ Exchange</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32268_1644693_1865159"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A web experience on Office.com that enables users to manage their Office licenses and subscriptions.</descrip></descripGrp><ntig><termGrp><term id="1644693">My Account</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termN