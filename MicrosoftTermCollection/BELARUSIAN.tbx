="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2731006">сумесная праца</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40273_2342387_2342613"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The security feature that uses virtualization-based security to isolate secrets so that only privileged system software can access them.</descrip></descripGrp><ntig><termGrp><term id="2342387">Credential Guard</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2342613">Credential Guard</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40284_2343496_2344419"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user role within Windows Store for Business that allows the user to manage the Windows Store for Business account settings and inventory.</descrip></descripGrp><ntig><termGrp><term id="2343496">admin</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2344419">адміністратар</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40285_2343497_2344420"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user role within Microsoft Store for Business that allows the user to directly provide apps to individuals and groups within the organization.</descrip></descripGrp><ntig><termGrp><term id="2343497">distributor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2344420">размеркавальнік</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40294_2343730_2344421"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A short video clip that can be downloaded from Skype in a package of similar video clips, and can be inserted into a chat conversation.​</descrip></descripGrp><ntig><termGrp><term id="2343730">Moji</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2344421">Моджы</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4030_145162_1864300"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A selection of two or more cells or ranges that don't touch each other.</descrip></descripGrp><ntig><termGrp><term id="145162">nonadjacent selection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1864300">выбар несумежных ячэек</term><termNote type="geographicalUsage">BLR</termNote>