d="346958">parental controls</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1573945">бацькоўскі кантроль</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13028_334517_2072446"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Combined earphone and microphone set that enables hands-free communication.</descrip></descripGrp><ntig><termGrp><term id="334517">headset</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2072446">гарнітура</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13038_232525_1864460"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The slide text on the slide master. The master text determines the format of text on all slides as well as the shape of text placeholders and their placement on slides.</descrip></descripGrp><ntig><termGrp><term id="232525">master text</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1864460">тыпавы тэкст</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13047_48461_1772739"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The naming convention for disk drives or partitions on most computers, consisting of an alphabetical letter followed by a colon.</descrip></descripGrp><ntig><termGrp><term id="48461">drive letter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1772739">літара дыска</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13049_30329_2296130"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A numeric value that corresponds to a particular character in a set.</descrip></descripGrp><ntig><termGrp><term id="30329">character code</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296130">код сімвала</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13049_641047_2296130"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A numeric value that corresponds to a particular character in a set.</descrip></descripGrp><ntig><termGrp><term id="641047">code point</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296130">код сімвала</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13054_144059_2296407"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A control on a form, that repeats as needed, into which users can enter text. The control can be formatted as a bulleted, numbered, or plain list.</descrip></descripGrp><ntig><termGrp><term id="144059">list control</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296407">элемент кіравання «Спіс»</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13067_138300_1864210"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An icon that designates a change made by a reviewer to a presentation.</descrip></descripGrp><ntig><termGrp><term id="138300">change marker</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1864210">маркёр змяненняў</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1307_319132_2296590"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to text that is aligned along the right margin.</descrip></descripGrp><ntig><termGrp><term id="319132">right-aligned</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296590">выраўнаваны па правым краі</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13073_232392_1864432"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A second calendar format selected by the user from within Outlook and visible in dual calendar view.</descrip></descripGrp><ntig><termGrp><term id="232392">alternate calendar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1864432">альтэрнатыўны каляндар</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13076_1486351_1772797"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A sequence of words or other text used to gain access to a network, program, or data. A passphrase is generally longer for added security.</descrip></descripGrp><ntig><termGrp><term id="1486351">pass phrase</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1772797">парольная фраза</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13076_269325_1772797"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A sequence of words or other text used to gain access to a network, program, or data. A passphrase is generally longer for added security.</descrip></descripGrp><ntig><termGrp><term id="269325">passphrase</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1772797">парольная фраза</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13078_397139_2296202"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A folder that exists by default in all users’ mailboxes. The Inbox, Outbox, Sent Items, Deleted Items, Calendar, and Contacts folders are default folders.</descrip></descripGrp><ntig><termGrp><term id="397139">default folder</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296202">папка па змаўчанні</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1308_232849_1864477"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A nonprinting mark you insert to show the end of a section.</descrip></descripGrp><ntig><termGrp><term id="232849">section break</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1864477">разрыў раздзела</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13082_186196_1864384"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A task pane with options that enable the user to send a Publisher file as personalized, individually addressed email to the recipients in the specified list.</descrip></descripGrp><ntig><termGrp><term id="186196">E-mail Merge</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1864384">Зліццё з электроннай поштай</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13089_102926_2296577"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process of copying content and/or configuration settings from one location, generally a server node, to another to ensure synchronization or fault tolerance.</descrip></descripGrp><ntig><termGrp><term id="102926">replication</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296577">рэплікацыя</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13099_375945_1806332"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A typographical unit of measure that is equal to one sixth of an inch.</descrip></descripGrp><ntig><termGrp><term id="375945">pica</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1806332">піка</term><termNote type="ge