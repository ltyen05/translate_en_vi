icalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2281930">Дэманстрацыя</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37533_2139466_2352672"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Sway feature that allows users to choose between different Layouts for the selected content.</descrip></descripGrp><ntig><termGrp><term id="2139466">Layout Gallery</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2352672">Калекцыя макетаў</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3754_240555_2737097"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The web page that serves as a starting point for exploring Business Contact Manager for Outlook.</descrip></descripGrp><ntig><termGrp><term id="240555">Business Contact Manager Home Page</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2737097">Хатняя старонка Дыспетчара кантактаў</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3756_415639_1864591"><langSet xml:lang="en-US"><descripGrp><descrip type="def