descrip type="definition">The program that lets gamers buy a game once and play it on both their Windows 10 PC and Xbox One console with shared progress, game saves and achievements.</descrip></descripGrp><ntig><termGrp><term id="2400154">Xbox Play Anywhere</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2400207">Xbox Play Anywhere</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42445_2404433_2409778"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office setting that will save a user's work automatically without him/her needing to use the save button or ctrl+s and that works across apps and across platforms.</descrip></descripGrp><ntig><termGrp><term id="2404433">AutoSave</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2409778">Аўтазахаванне</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42450_2405922_2409780"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A software component that is included in all Office products.</descrip></descripGrp><ntig><termGrp><term id="2405922">shared tool</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2409780">агульны інструмент</term><termNote type="geog