gSet><langSet xml:lang="be"><ntig><termGrp><term id="1864910">Сход</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24782_1162510_2371306"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A client organization that is served from a web service which serves other client organizations, where each organization’s data is stored in a separate database from the others.</descrip></descripGrp><ntig><termGrp><term id="1162510">tenant</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2371306">кліент</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24805_1162604_1864905"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A ribbon group that provides options for drawings created with pen and ink tools.</descrip></descripGrp><ntig><termGrp><term id="1162604">Ink Art</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1864905">Арт-майстэрня</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24823_1162689_2771601"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A graphical representation of the amount of work left and the period of time available.</descrip></descripGrp><ntig><termGrp><term id="1162689">burndown chart</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2771601">дыяграма згарання задач</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24825_1162703_2296040"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A scalable Web platform that enables users to publish an Access database application to a SharePoint site. Data in these databases can then be viewed and edited in a Web browser. This enables browser-based viewing and interaction with the databases on machines that do not have a database application installed.</descrip></descripGrp><ntig><termGrp><term id="1162703">Access Services</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296040">службы Access</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24825_1176677_2296040"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A scalable Web platform that enables users to publish an Access database application to a SharePoint site. Data in these databases can then be viewed and edited in a Web browser. This enables browser-based viewing and interaction with the databases on machines that do not have a database application installed.</descrip></descripGrp><ntig><termGrp><term id="1176677">Microsoft Access Services</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296040">службы Access</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24826_1162704_1864906"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A server technology enabling users to load, calculate, and display Excel workbooks on Microsoft Office SharePoint Server.</descrip></descripGrp><ntig><termGrp><term id="1162704">Excel Services</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1864906">Службы Excel</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24856_1162836_1864907"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A removable storage device that has been configured with Office applications using the Office To-Go Device Manager.</descrip></descripGrp><ntig><termGrp><term id="1162836">Office enabled device</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1864907">прылада з падтрымкай Office</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2486_143220_1864269"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that heightens the color contrast of some text and images on your screen, making those items more distinct and easier to identify.</descrip></descripGrp><ntig><termGrp><term id="143220">High Contrast</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1864269">Высокая кантрастнасць</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24868_1162904_1864908"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The portion of data distribution that is determined to be more or less than some critical value. For example, the far left and far right areas of a bell curve.</descrip></descripGrp><ntig><termGrp><term id="1162904">tail</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1864908">канцавы вузел</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24869_1162906_1860384"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A test in which the null hypothesis is rejected if the value of the test statistic falls into either tail of the probability distribution (i.e. is either less than a first critical value or greater than a second critical value).</descrip></descripGrp><ntig><termGrp><term id="1162906">two-tailed test</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1860384">тэст па двухбаковаму крытэрыю</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24869_1176836_1860384"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A test in which the null hypothesis is rejected if the value of the test statistic falls into either tail of the probability distribution (i.e. is either less than a first critical value or greater than a second critical value).</descrip></descripGrp><ntig><termGrp><term id="1176836">two-sided test</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1860384">тэст па двухбаковаму крытэрыю</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24889_1164971_2296337"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A product for managing the entire lifecycle of user identities and their associated credentials. It provides identity synchronization, certificate and password management, and user provisioning in a single solution that works across Microsoft Windows and other organizational systems.</descrip></descripGrp><ntig><termGrp><term id="1164971">Microsoft Identity Lifecycle Manager 2007</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296337">ILM</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24889_1164971_2296758"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A product for managing the entire lifecycle of user identities and their associated credentials. It provides identity synchronization, certificate and password management, and user provisioning in a single solution that works across Microsoft Windows and other organizational systems.</descrip></descripGrp><ntig><termGrp><term id="1164971">Microsoft Identity Lifecycle Manager 2007</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296758">Microsoft Identity Lifecycle Manager 2007</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24889_1275553_2296337"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A product for managing the entire lifecycle of user identities and their associated credentials. It provides identity synchronization, certificate and password management, and user provisioning in a single solution that works across Microsoft Windows and other organizational systems.</descrip></descripGrp><ntig><termGrp><term id="1275553">ILM</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296337">ILM</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24889_1275553_2296758"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A product for managing the entire lifecycle of user identities and their associated credentials. It provides identity synchronization, certificate and password management, and user provisioning in a single solution that works across Microsoft Windows and other organizational systems.</descrip></descripGrp><ntig><termGrp><term id="1275553">ILM</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296758">Microsoft Identity Lifecycle Manager 2007</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2490_1050717_1573620"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A reusable magnetic storage medium. The floppy disk used today is the rigid 3.5-inch microfloppy that holds 1.44 MB. It is called floppy because the first varieties were housed in bendable jackets.</descrip></descripGrp><ntig><termGrp><term id="1050717">magnetic disk</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1573620">дыск</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2490_1050717_1770051"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A reusable magnetic storage medium. The floppy disk used today is the rigid 3.5-inch microfloppy that holds 1.44 MB. It is called floppy because the first varieties were housed in bendable jackets.</descrip></descripGrp><ntig><termGrp><term id="1050717">magnetic disk</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1770051">гнуткі дыск</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2490_1470_1573620"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A reusable magnetic storage medium. The floppy disk used today is the rigid 3.5-inch microfloppy that holds 1.44 MB. It is called floppy because the first varieties were housed in bendable jackets.</descrip></descripGrp><ntig><termGrp><term id="1470">floppy disk</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1573620">дыск</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2490_1470_1770051"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A reusable magnetic storage medium. The floppy disk used today is the rigid 3.5-inch microfloppy that holds 1.44 MB. It is called floppy because the first varieties were housed in bendable jackets.</descrip></descripGrp><ntig><termGrp><term id="1470">floppy disk</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1770051">гнуткі дыск</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2490_339962_1573620"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A reusable magnetic storage medium. The floppy disk used today is the rigid 3.5-inch microfloppy that holds 1.44 MB. It is called floppy because the first varieties were housed in bendable jackets.</descrip></descripGrp><ntig><termGrp><term id="339962">disk</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1573620">дыск</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2490_339962_1770051"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A reusable magnetic storage medium. The floppy disk used today is the rigid 3.5-inch microfloppy that holds 1.44 MB. It is called floppy because the first varieties were housed in bendable jackets.</descrip></descripGrp><ntig><termGrp><term id="339962">disk</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1770051">гнуткі дыск</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24903_1165764_1574035"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An option that isolates the foreground portion of an image and make the background transparent.</descrip></descripGrp><ntig><termGrp><term id="1165764">Remove Background</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1574035">Выдаліць фон</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24913_1165825_2296168"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that lets users receive and send mail from other email accounts in Outlook Web App. They can add and delete those accounts, check their account synchronization status, and manage email from those accounts in their Inbox using Inbox rules.</descrip></descripGrp><ntig><termGrp><term id="1165825">Connected Accounts</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296168">Падлучаныя ўліковыя запісы</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24914_1165826_2296327"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A bubble that appears when a user clicks in a field or on a control in the user interface. The Help bubble contains information that helps the user know what to do.</descrip></descripGrp><ntig><termGrp><term id="1165826">Help bubble</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296327">усплывальная даведка</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24915_1165827_2296342"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A rule that is defined by an end-user using Outlook or Outlook Web App. When a message that meets the conditions of the rule is sent or received, the rule triggers an action that is performed automatically.</descrip></descripGrp><ntig><termGrp><term id="1165827">Inbox rule</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296342">правілы для папкі «Уваходныя»</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24917_1165829_2296465"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A company that provides text messaging services.</descrip></descripGrp><ntig><termGrp><term id="1165829">mobile service provider</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296465">аператар мабільнай сувязі</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24919_1165832_1864911"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A slider control where the maximum and minimum values of the range can be modified.</descrip></descripGrp><ntig><termGrp><term id="1165832">multi-stop slider</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1864911">паўзунок з некалькімі інтэравламі</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2492_397154_2296275"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An item that resides in a folder that uses an event sink. The item provides the store with information that includes what events will trigger the sink, the name of the sink, and options such as restrictions for when the event will fire.</descrip></descripGrp><ntig><termGrp><term id="397154">event registration</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296275">рэгістрацыя падзей</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24928_1165905_1864913"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that contains galleries where the user can create, store, and find reusable pieces of content, including AutoText, document properties, fields and building blocks.</descrip></descripGrp><ntig><termGrp><term id="1165905">Quick Parts</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1864913">Экспрэс-часткі</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24931_1165919_2296582"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To set again with a different value.</descrip></descripGrp><ntig><termGrp><term id="1165919">reset</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296582">задаць паўторна</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24935_1165946_2296583"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To obtain a new password when the old one is forgotten or expired.</descrip></descripGrp><ntig><termGrp><term id="1165946">reset</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296583">аднавіць</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2495_47034_2296234"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A fully qualified unique name, used to identify an object in a directory, that specifies the complete path to the object through the hierarchy of directory containers.</descrip></descripGrp><ntig><termGrp><term id="47034">distinguished name</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296234">адрознае імя</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24958_1166045_2321074"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The automatic measurement and transmission of data from remote sources by wired or wireless communication means. Telemetry technology is used in a wide variety of applications.</descrip></descripGrp><ntig><termGrp><term id="1166045">telemetry</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2321074">тэлеметрыя</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24966_1166067_2296410"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An intermediary between a software publisher and a certification authority (CA). The local registration authority can, for example, verify a publisher's credentials before sending them to the CA.</descrip></descripGrp><ntig><termGrp><term id="1166067">local registration authority</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296410">лакальны цэнтр рэгістрацыі</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24966_1166080_2296410"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An intermediary between a software publisher and a certification authority (CA). The local registration authority can, for example, verify a publisher's credentials before sending them to the CA.</descrip></descripGrp><ntig><termGrp><term id="1166080">LRA</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2296410">лакальны цэнтр рэгістрацыі</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24972_1166075_2630913"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To track changes in data as required.</descrip></descripGrp><ntig><termGrp><term id="1166075">audit</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2630913">інспектаваць</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24987_1166123_2072225"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A defined point in a workflow that is entered when specified conditions are met.</descrip></descripGrp><ntig><termGrp><term id="1166123">workflow stage</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term