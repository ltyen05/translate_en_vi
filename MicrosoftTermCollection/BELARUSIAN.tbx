Note type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2382868">малюнак</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6735_127914_2382868"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An image generated from a mathematical description that determines the position, length, and direction in which lines are drawn. A vector graphic is created as a collection of lines rather than as a pattern of individual dots or pixels.</descrip></descripGrp><ntig><termGrp><term id="127914">vector graphic</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2382868">малюнак</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6735_2376756_2382868"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An image generated from a mathematical description that determines the position, length, and direction in which lines are drawn. A vector graphic is created as a collection of lines rather than as a pattern of individual dots or pixels.</descrip></descripGrp><ntig><termGrp><term id="2376756">graphic</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2382868">малюнак</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNo