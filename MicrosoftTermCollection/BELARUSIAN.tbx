ектаў</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6939_48253_1806196"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A preliminary version.</descrip></descripGrp><ntig><termGrp><term id="48253">draft</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1806196">чарнавік</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6947_299917_1791044"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of using a tablet pen to create drawings or handwriting.</descrip></descripGrp><ntig><termGrp><term id="299917">inking</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1791044">рукапісны ўвод</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6948_4565_1764635"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A broadly released fix for a specific problem addressing a critical, non-security related bug.</descrip></descripGrp><ntig><termGrp><term id="4565">critical update</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><ter