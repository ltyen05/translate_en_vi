definition">An object that can contain one or more child objects.</descrip></descripGrp><ntig><termGrp><term id="659694">container</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2772554">кантэйнер</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19436_763338_2772554"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An object that can contain one or more child objects.</descrip></descripGrp><ntig><termGrp><term id="763338">container element</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2772554">кантэйнер</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1944_321903_1864559"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to an operation or feature that involves moving objects on the screen with a mouse, a similar input device or a eventually a finger.</descrip></descripGrp><ntig><termGrp><term id="321903">drag-and-drop</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1864559">перацягванне</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19488_659968_1864725"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An effect that applies a halo of color around the perimeter of an object.</descrip></descripGrp><ntig><termGrp><term id="659968">outer glow</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1864725">свячэнне</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19488_685377_1864725"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An effect that applies a halo of color around the perimeter of an object.</descrip></descripGrp><ntig><termGrp><term id="685377">glow effect</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1864725">свячэнне</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19488_685378_1864725"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An effect that applies a halo of color around the perimeter of an object.</descrip></descripGrp><ntig><termGrp><term id="685378">glow</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1864725">свячэнне</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19508_660023_1574105"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To display an object.</descrip></descripGrp><ntig><termGrp><term id="660023">show</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1574105">паказаць</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1951_169268_1864354"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A log backup taken from a possibly damaged database to capture the log that has not yet been backed up. A tail-log backup is taken after a failure in order to prevent work loss.</descrip></descripGrp><ntig><termGrp><term id="169268">tail-log backup</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1864354">рэзервовая копія заключнага фрагмента гiсторыi</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19526_660055_2418936"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To release objects that have been combined together as a single object.</descrip></descripGrp><ntig><termGrp><term id="660055">ungroup</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="2418936">разгрупаваць</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19538_660183_1806371"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file that stores an image as graphical objects (lines, circles, polygons) rather than as pixels. Metafiles preserve an image more accurately than pixels when the image is resized.</descrip></descripGrp><ntig><termGrp><term id="660183">metafile</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1806371">мэта-файл</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19542_660559_1806372"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A page that you can assign to another page to create multiple layers in a drawing.</descrip></descripGrp><ntig><termGrp><term id="660559">background page</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1806372">фон</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19542_660560_1806372"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A page that you can assign to another page to create multiple layers in a drawing.</descrip></descripGrp><ntig><termGrp><term id="660560">background</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1806372">фон</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1958_184137_1864373"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A control that allows users to digitally sign a form or document.</descrip></descripGrp><ntig><termGrp><term id="184137">signature line</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1864373">радок подпісу</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19686_670514_1864718"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The size of the finished page of a printed publication, after trimming.</descrip></descripGrp><ntig><termGrp><term id="670514">page size</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="be"><ntig><termGrp><term id="1864718">памер старонкі</term><termNote type="geographicalUsage">BLR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19687_670515_1573943"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The size of the sheet of paper on which you print the publication, before trimming.</de